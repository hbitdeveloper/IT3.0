        "feature_video_1": "https://cdn.shopify.com/videos/c/o/v/b4c985e0a54e4f348521244be8303c05.mp4",
        "feature_intro": "123 The Jackery Explorer 1000 Pro has a 1002Wh capacity to supply 1000W power using multiple output ports. So, you can use it to power up multiple devices simultaneously. That's perfect for power outages, outdoor adventures, and professional work.",
        "featured_text": "Featured Summary",
        "appliance_title": "<p>Large capacity supports <strong>90%</strong> of device</p>",
        "appliance_intro": "The rechargeable SG1000Pro can support up to 90% of appliances, like micro-wave oven, cpap, e-bike or even a sump pump. Also provide 2* USB-C & 2* 100W PD ports, delivering steady and quick chargingfor phones, iPads, laptops and so on.",
        "more_appliances_title": "",
        "more_appliances_subtitle": "",
        "running_title": "Running Time Simulator",
        "running_product": "To power with Explorer 1000 Pro",
        "running_tip": "Please enter the wattage of the appliance",
        "hour_desc": "Hrs",
        "running_expected": "Expected Running Time",
        "charge_title": "<p>3 simple ways to <em>charge quickly</em></p>",
        "charge_tips": "E1000Pro supports wall charger, car charger and solar charging. Fully charge at1.6 hours.  Want to use your devices while soalr charging? Pass-through charging techs ensure you no more waiting.",
        "safety_title_one": "",
        "safety_bg_video_one": "",
        "safety_desc_one": "",
        "life_title": "<p><em>Up to 10</em> Years battery life</p>",
        "anniversary": 10,
        "life_years_desc": "years",
        "life_years_desc_color": "#000000",
        "life_desc": "The working volume is at 30DB, even quieter than in a library(40DB).  Green renewal energy runs  no fume and no maintenance. It is an environment friendly power solution for home backup, off-grid living and outdoors.",
        "safety_title": "<p>All-round <em>safety protection</em></p>",
        "safety_bg_video": "",
        "safety_desc": "The Jackery Explorer 1000 Pro has a 1002Wh capacity to supply 1000W power using multiple output ports. So, you can use it to power up multiple devices simultaneously. That's perfect for power outages, outdoor adventures, and professional work.",
        "less_title": "<p><em>Less </em>to carry, <em>more </em> to explore</p>",
        "less_desc": "",
        "less_one_desc": "<p>The exclusive charging algorithm ensure 80% battery capacity after 1000 charges. Means you can go camping every week with E1000Pro for 10 years before it reaches the 80% capacity level. <br/><br/>In addition, with 100% capacity, it can stand by for more than 365 days making it a reliable emergency backup power supply.</p>",
        "less_two_desc": "<p>Don't forget about our Smart Screen,  you can easily find the remaining capacity, charging status and other information on the LCD panel. It can be set to open for 12 hours to prevent no-loading so that you can save more power.</p>",
        "sturdy_title": "<p><em>Sturdy </em>beyond imagination</p>",
        "sturdy_bg_video": "",
        "sturdy_desc": "Accidentally dropped the power station from the car? don't worry! With the TOP SHOCK-RESISTANT LEVEL 9 drop resistance, the product can work still even drop from 0.9 meters to any surface three times.",
        "Green_title": "<p>Go <em>green </em>in a quiet way</p>",
        "green_scene_intro": "The working volume is at 30dB, even quieter than in a library(40dB).  Green renewal energy runs  no fume and no maintenance. It is an environment friendly power solution for home backup, off-grid living and outdoors.",
        "guarantee_title": "<p><em>5 years </em>guarantee</p>",
        "anniversary_guarantee": 5,
        "guarantee_years_desc": "years",
        "guarantee_desc": "Our additional 5-year warranty gives you peace of mind. When you need it, Jackery will accompany you to explore farther and longer.",
        "tabs_video_title": "",
        "tabs_feature_video": "",
        "hide_help_choose": false,
        "help_choose_title": "How Many Solar Panels Do I Need",
        "help_choose_ip": "shopify://shop_images/ip.png",
        "recharging_icon": "shopify://shop_images/recharging_time.png",
        "energy_saving_icon": "shopify://shop_images/save_electricity.png",
        "need_title": "How to Connect Solar Panels to Power Station?",
        "need_heading": "Four SolarSaga 100 for the Explorer 1500",
        "need_desc": "<p>Four SolarSaga 100W solar panels can quickly charge the Explorer 1500 (not included).</p><p></p><p><strong>Solar recharging steps:</strong></p><p></p><p>1. Connect the first panel - find the \"DC interface\" on the back of SolarSaga 100 and plug it in solar power cable;<br/>2. Connect the second panel - follow step 1;<br/>3. Connect the solar panels and the solar power cable with the Explorer 1500's DC input.</p>"
      }
