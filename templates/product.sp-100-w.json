    "product-detail": {
      "type": "product-detail-sp",
      "blocks": {
        "c7bc191e-144f-4406-848a-31e429874714": {
          "type": "part_1_swiper",
          "settings": {
            "part_1_img": "shopify://shop_images/Jackery_SolarSaga_100W_Solar_Panel_for_Solar_Generator.webp",
            "part_1_text": "Made with monocrystalline solar cells, and a honeycomb light trapping design, the solar panels are equipped with adjustable stands, with solar panel efficiency reaching up to 24.3%. Make the most use of solar power, no matter if it's on sunny or cloudy days!"
          }
        },
        "2025a9a3-2270-4443-93b5-83c1eaae8b5a": {
          "type": "part_1_swiper",
          "disabled": true,
          "settings": {
            "part_1_text": "Applies IBC Solar technology, a technology with a rich 40 year history within the solar panel industry. This technology ensures that every solar module delivers with efficiency and longevity."
          }
        },
        "c7a4633e-8295-4a43-8ae1-e65bc05323c1": {
          "type": "part_1_swiper",
          "disabled": true,
          "settings": {
            "part_1_text": "Exceptional performance in hot and cold weather, with a working temperature range of -10-65°C (14-149°F). Each time the temperature rises by 1℃, the conversion efficiency still be 28.5% higher than alternatives on the market."
          }
        },
        "473b5a7a-13ef-4e20-869c-e69702ba1047": {
          "type": "part_2_swiper",
          "settings": {
            "part_2_img": "shopify://shop_images/Jackery_SolarSaga_100W_Foldable_Solar_Panel.webp",
            "part_2_text": "<p>Instant Set Up Solar Energy System. Within 60 seconds to set up, the solar panel stands firmly and can ensure optimum absorption of the sunlight thanks to its adjustable kickstands. It is the perfect companion for outdoor travel.</p>"
          }
        },
        "e4d7ca13-9f20-491d-9054-7ac2c5c9d851": {
          "type": "part_2_swiper",
          "settings": {
            "part_2_img": "shopify://shop_images/Jackery_SolarSaga_Foldable_and_Portable_Solar_Panel.webp",
            "part_2_text": "<p>Foldable design for easy transport. It's also compact and lightweight for carrying on your outdoor activities. Simply fold the solar panel in two, in seconds and you'll be good to go, with convenient solar at your fingertips in an instant.</p>"
          }
        },
        "f17becbb-8cf6-4991-88df-2f2c38477d96": {
          "type": "part_3_swiper",
          "settings": {
            "part_3_img": "shopify://shop_images/solar_panel_100W_31.png",
            "part_3_text": ""
          }
        }
      },
