        "custom_liquid_jWyhkR": {
          "type": "custom_liquid",
          "name": "折扣码卡片",
          "disabled": true,
          "settings": {
            "title": "折扣码卡片",
            "padding_top": 0,
            "padding_bottom": 0,
            "mb_padding_type": "default",
            "padding_top_mb": 24,
            "padding_bottom_mb": 24,
            "liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Promozione esclusiva Jackery</title>\n  <style>\n    /* ==========================================================================\n       0. 页面大框架控制\n       ========================================================================== */\n    .jackery-page-container {\n      max-width: 1000px; \n      margin: 30px auto; \n      padding: 0;        \n      box-sizing: border-box;\n    }\n\n    /* ==========================================================================\n       1. 优惠券条目样式\n       ========================================================================== */\n    .jackery-premium-promo {\n      display: flex;\n      flex-direction: column;\n      width: 100%;       \n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      box-sizing: border-box;\n    }\n\n    .promo-item {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      background-color: #F8F9FA;\n      border: 1px solid #E5E7EB;\n      border-radius: 8px;\n      padding: 16px 20px; \n      transition: all 0.25s ease-in-out;\n      box-sizing: border-box;\n      margin-bottom: 4px; \n      gap: 16px;\n      flex-wrap: nowrap; \n    }\n\n    .promo-item:hover {\n      border-color: #FD5000;\n      background-color: #FFFFFF;\n      box-shadow: 0 4px 12px rgba(253, 80, 0, 0.04);\n    }\n\n    /* 左侧信息流 */\n    .promo-info {\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 4px; \n      flex-shrink: 0; \n    }\n\n    .highlight-badge {\n      color: #242F20;\n      font-size: 20px;       \n      font-weight: 800;\n      letter-spacing: -0.3px;\n      white-space: nowrap;\n      line-height: 1.2;\n    }\n\n    .condition-text {\n      color: #242F20;\n      font-size: 14px;       \n      font-weight: 600;\n      white-space: nowrap;\n    }\n\n    /* 右侧行动流 */\n    .promo-action-wrapper {\n      display: flex;\n      flex-direction: column;\n      align-items: flex-end; \n      gap: 6px;              \n      flex-shrink: 1;\n      min-width: 0;\n    }\n\n    .inline-hint-text {\n      color: #FD5000;        \n      font-size: 16px;       \n      font-weight: 700;      \n      white-space: nowrap; \n    }\n\n    .button-row {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    /* 强锁高度优化：折扣码展示框 */\n    .code-display-box {\n      background-color: #242F20; \n      color: #FFFFFF;            \n      border: 1px solid #242F20;\n      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n      font-size: 13px;           \n      font-weight: 800;\n      letter-spacing: 0.5px;\n      height: 32px;\n      line-height: 30px; \n      padding: 0 12px;   \n      border-radius: 6px;\n      white-space: nowrap;\n      user-select: all; \n      min-width: 75px; \n      text-align: center;\n      box-sizing: border-box; \n    }\n\n    /* 强锁高度优化：右侧 Copy 按钮 */\n    .copy-trigger-btn {\n      background-color: #F8F9FA;\n      color: #242F20;\n      border: 1px solid #E5E7EB;\n      font-family: -apple-system, sans-serif;\n      font-size: 13px;           \n      font-weight: 700;\n      height: 32px;\n      line-height: 30px; \n      padding: 0 12px;   \n      border-radius: 6px; \n      cursor: pointer;\n      transition: all 0.2s ease;\n      outline: none;\n      white-space: nowrap;\n      min-width: 75px; \n      text-align: center;\n      box-sizing: border-box; \n    }\n\n    .copy-trigger-btn:hover {\n      background-color: #242F20; \n      color: #FFFFFF;\n      border-color: #242F20;\n    }\n\n    .copy-trigger-btn.copied-success {\n      background-color: #FD5000; \n      color: #FFFFFF;\n      border-color: #FD5000;\n    }\n\n    /* ==========================================================================\n       2. 倒计时板样式\n       ========================================================================== */\n    .promo-countdown-board {\n      margin-top: 4px;   \n      background-color: #242F20; \n      border-radius: 8px;\n      padding: 14px 20px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between; \n      gap: 12px;\n      box-shadow: 0 4px 20px rgba(36, 47, 32, 0.08);\n      box-sizing: border-box;\n      background: url('https://cdn.shopify.com/s/files/1/0970/9262/files/bg-product-detail.jpg?v=1782389033') no-repeat center center;\n      background-size: cover;\n    }\n\n    .countdown-text-side {\n      display: flex;\n      flex-direction: column;\n      min-width: 0; \n    }\n\n    .countdown-main-title {\n      color: #FFFFFF;\n      font-size: 20px;\n      font-weight: 700;\n    }\n\n    .countdown-slots-container {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      flex-shrink: 0; \n    }\n\n    .time-block-wrapper {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 4px;\n    }\n\n    .time-number-card {\n      background: #FD5000; \n      color: #FFFFFF;\n      font-size: 18px; \n      font-weight: 800;\n      font-family: ui-monospace, monospace;\n      font-variant-numeric: tabular-nums;\n      min-width: 38px;\n      height: 36px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 6px;\n      box-shadow: 0 2px 6px rgba(0,0,0,0.15);\n    }\n\n    .time-label-sub {\n      color: #E4E4E7;\n      font-size: 9px;\n      font-weight: 500;\n      text-transform: uppercase;\n      letter-spacing: 0.2px;\n    }\n\n    .time-colon-separator {\n      color: #FD5000;\n      font-size: 20px;\n      font-weight: 700;\n      margin-top: -12px;\n      animation: blink-colon 1s infinite steps(1, start);\n    }\n\n    @keyframes blink-colon {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.3; }\n    }\n\n    /* ==========================================================================\n       3. 移动端自适应 (🔥 专属优化：调大文案，继续压小气泡)\n       ========================================================================== */\n    @media (max-width: 767.99px) {\n      .promo-item {\n        padding: 14px 12px;\n        gap: 12px;\n        align-items: center; \n      }\n      \n      .promo-info { \n        gap: 2px; \n      }\n      \n      .highlight-badge { font-size: 16px; }\n      .condition-text { font-size: 11px; }\n      \n      .promo-action-wrapper { \n        align-items: flex-end;\n        gap: 4px;\n      }\n      \n      /* 🎯 手机端特别放大：字号提升至极为显眼的 14px */\n      .inline-hint-text { \n        font-size: 14px; \n        white-space: normal; \n        text-align: right;   \n        line-height: 1.3;\n        font-weight: 700;\n      } \n      \n      .button-row {\n        gap: 4px;\n        margin-top: 2px;\n      }\n      \n      /* 🎯 气泡进一步精致、轻量化：高度降至 21px，宽度缩减，完美衬托上方放大的文案 */\n      .code-display-box { \n        font-size: 10px; \n        min-width: 48px; \n        height: 21px; \n        line-height: 19px; \n        padding: 0 5px;\n        border-radius: 3px; \n        letter-spacing: 0px;\n      }\n      \n      .copy-trigger-btn { \n        font-size: 10px; \n        min-width: 44px; \n        height: 21px; \n        line-height: 19px; \n        padding: 0 5px;\n        border-radius: 3px; \n      }\n    }\n\n    @media (max-width: 639.99px) {\n      .jackery-page-container {\n        padding: 0;      \n      }\n\n      .promo-item {\n        border-radius: 0;   \n      }\n\n      .promo-countdown-board {\n        border-radius: 0;\n        padding: 12px 10px; \n        gap: 8px;\n        margin-top: 2px;\n        \n      }\n\n      .countdown-main-title {\n        font-size: 14px;\n      }\n\n      .time-number-card {\n        font-size: 15px;\n        min-width: 32px;\n        height: 30px;\n        border-radius: 4px;\n      }\n\n      .time-label-sub {\n        font-size: 8px;\n      }\n\n      .time-colon-separator {\n        font-size: 16px;\n        margin-top: -10px;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"jackery-page-container\">\n\n    <div class=\"jackery-premium-promo\">\n      \n  \n\n\n      <!-- 倒计时面板 -->\n      <div class=\"promo-countdown-board\" id=\"countdown-board-wrapper\">\n        <div class=\"countdown-text-side\">\n          <div class=\"countdown-main-title\">La promozione Jackery Prime termina presto</div>\n        </div>\n\n        <div class=\"countdown-slots-container\">\n          <div class=\"time-block-wrapper\" id=\"box-days-wrapper\" style=\"display:none;\">\n            <div class=\"time-number-card\" id=\"box-days\">00</div>\n            <span class=\"time-label-sub\">Giorni</span>\n          </div>\n          <div class=\"time-colon-separator\" id=\"box-days-colon\" style=\"display:none;\">:</div>\n\n          <div class=\"time-block-wrapper\">\n            <div class=\"time-number-card\" id=\"box-hours\">00</div>\n            <span class=\"time-label-sub\">Ore</span>\n          </div>\n          <div class=\"time-colon-separator\">:</div>\n\n          <div class=\"time-block-wrapper\">\n            <div class=\"time-number-card\" id=\"box-mins\">00</div>\n            <span class=\"time-label-sub\">Min</span>\n          </div>\n          <div class=\"time-colon-separator\">:</div>\n\n          <div class=\"time-block-wrapper\">\n            <div class=\"time-number-card\" id=\"box-secs\">00</div>\n            <span class=\"time-label-sub\">Sec</span>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n\n  <script>\n    // 1. 一键复制与原地文本切换功能\n    function executeCopy(codeId, btnElement) {\n      var targetText = document.getElementById(codeId).innerText.trim();\n      navigator.clipboard.writeText(targetText).then(function() {\n        \n        btnElement.classList.add(\"copied-success\");\n        btnElement.innerText = \"Copied!\";\n        \n        setTimeout(function() {\n          btnElement.classList.remove(\"copied-success\");\n          btnElement.innerText = \"Copy\";\n        }, 1200);\n\n      }).catch(function(err) {\n        alert(\"Codice: \" + targetText);\n      });\n    }\n\n    // 2. PST/PDT 严格时区同步倒计时\n    function startCountdown() {\n      const targetDate = new Date(\"2026-06-26T23:59:59-07:00\").getTime();\n      const boardWrapper = document.getElementById('countdown-board-wrapper');\n\n      const dBox = document.getElementById('box-days');\n      const dWrapper = document.getElementById('box-days-wrapper');\n      const dColon = document.getElementById('box-days-colon');\n      const hBox = document.getElementById('box-hours');\n      const mBox = document.getElementById('box-mins');\n      const sBox = document.getElementById('box-secs');\n\n      function updateTimer() {\n        const now = new Date().getTime();\n        const distance = targetDate - now;\n\n        if (distance < 0) {\n          boardWrapper.innerHTML = `\n            <div class=\"countdown-main-title\" style=\"color:#A1A1AA;\">⏳ Le offerte sono scadute.</div>`;\n          clearInterval(timerInterval);\n          return;\n        }\n\n        const days = Math.floor(distance / (1000 * 60 * 60 * 24));\n        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));\n        const seconds = Math.floor((distance % (1000 * 60)) / 1000);\n\n        const formatNum = (num) => num < 10 ? '0' + num : num;\n\n        if (days > 0) {\n          dWrapper.style.display = 'flex';\n          dColon.style.display = 'block';\n          dBox.innerText = formatNum(days);\n        } else {\n          dWrapper.style.display = 'none';\n          dColon.style.display = 'none';\n        }\n\n        hBox.innerText = formatNum(hours);\n        mBox.innerText = formatNum(minutes);\n        sBox.innerText = formatNum(seconds);\n      }\n\n      updateTimer();\n      const timerInterval = setInterval(updateTimer, 1000);\n    }\n\n    document.addEventListener('DOMContentLoaded', startCountdown);\n  </script>\n</body>\n</html>"
          }
        },
