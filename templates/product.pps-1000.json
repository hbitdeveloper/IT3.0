        "image_plate_title": "",
        "feature_video_1": "",
        "feature_video_poster": "shopify://shop_images/1000-2.png",
        "feature_intro": "Jackery Explorer 1000 Portable Power Station charges eight devices simultaneously. Featuring a battery capacity of 1002Wh, the portable power station is suitable for charging all devices during camping and power outages. Excellent features of the Explorer 1000 power station include three standard pure sine wave AC outlets, compact design, MPPT charge controller, and an industrial-grade quiet power station.",
        "featured_text": "Featured Summary",
        "summary_pc": "shopify://shop_images/Portable_Power_Stations_3_d4a29d3c-5f3f-48a0-a094-a4045819161e.png",
        "summary_m": "shopify://shop_images/Portable_Power_Stations_6c6404fd-715b-4e77-985b-44a5fac90869.png",
        "appliance_title": "<p><em><strong>Large</strong></em><em> </em>Battery Capacity Charging <em><strong>7</strong></em> Devices</p>",
        "appliance_bg": "shopify://shop_images/Portable_Power_Stations_9_79d26320-028f-4116-857c-a0191f2e4758.png",
        "appliance_intro": "Equipped with multiple ports, including two USB-C, two USB, two pure sine wave AC outlets, and one DC car port, the portable power station can charge appliances including  computers, cameras, CPAP machines, electric grills and more. The Explorer 1000 Portable Power Station offers immense solar power for home emergency backups or RV trips.",
        "more_appliances_title": "",
        "more_appliances_subtitle": "",
        "running_title": "Running Time Simulator",
        "running_product": "To power with Explorer 1000",
        "running_tip": "Please enter the wattage of the appliance",
        "hour_desc": "Hrs",
        "running_expected": "Expected Running Time",
        "charge_title": "<p><em>3 Ways</em> to Recharge Easily</p>",
        "charge_tips": "Jackery Explorer 1000 Portable Power Station supports different charging methods: wall charging, solar charging, and car outlet. The pass-through charging feature of the power station allows you to charge devices while plugging in the power station to the charging spot.",
        "safety_title_one": "",
        "safety_bg_video_one": "",
        "safety_desc_one": "",
        "life_title": "<p>Up to <em>5 Years</em> of Battery Life</p>",
        "anniversary": 0,
        "life_bg": "shopify://shop_images/Portable_Power_Stations_6_c2997646-1544-4086-8b6a-e442b0357a7c.png",
        "life_years_desc": "years",
        "life_years_desc_color": "#000000",
        "life_desc": "The exclusive recharging algorithm ensures that 80% of battery capacity remains, even after 800 charging cycles. That means you can enjoy clean and green energy for years to come.",
        "safety_title": "<p><em>All-Round</em> Safety with Excellent BMS</p>",
        "safety_bg": "shopify://shop_images/BMS.png",
        "safety_bg_video": "",
        "safety_desc": "The built-in intelligent battery management system technology provides protection against overvoltage, high temperature and short circuits. The first-rate lithium battery offers reliable charging to power multiple devices.",
        "less_title": "<p><em>Lightweight</em> and <em>Portable</em></p>",
        "less_bg": "shopify://shop_images/Portable_Power_Stations_5.png",
        "less_desc": "",
        "less_one_desc": "",
        "less_two_desc": "",
        "sturdy_title": "<p><em>Robust </em>and <em>Durable</em></p>",
        "sturdy_bg": "shopify://shop_images/Portable_Power_Stations_13_32114a71-789e-4537-820a-11bf7e81a7f9.png",
        "sturdy_bg_video": "",
        "sturdy_desc": "Besides the efficient solar charging capability of the solar power station, it is known for its high durability. Built with the best 94V-0 fire rating fireproof material, the product can sustain severe damage.",
        "Green_title": "<p>Environmental <em>Friendly</em></p>",
        "green_bg": "shopify://shop_images/Portable_Power_Stations_4_d4b78871-6942-4cc4-9d0d-53a8220c383f.png",
        "green_scene": "shopify://shop_images/Portable_Power_Stations_7.png",
        "green_scene_intro": "With Jackery Explorer 1000 Portable Power Station, you can access green renewable energy by teaming up with solar panels. It is a 100% clean energy source that emits no fumes or gas, making it ideal for indoors, outdoors, or off-grid living.",
        "guarantee_title": "<p><em>3 years </em>guarantee</p>",
        "anniversary_guarantee": 0,
        "guarantee_bg": "shopify://shop_images/Portable_Power_Stations_2_f04a3f47-4551-4e42-a396-212ac0e9d44b.png",
        "guarantee_bg_m": "shopify://shop_images/Portable_Power_Stations_2_f04a3f47-4551-4e42-a396-212ac0e9d44b.png",
        "guarantee_years_desc": "years",
        "guarantee_desc": "Jackery Explorer 1000 Portable Power Station comes with three years (two years and one year extended warranty) of warranty that offers extra peace of mind to the buyer.",
        "tabs_video_title": "",
        "tabs_feature_video": "",
        "hide_help_choose": false,
        "help_choose_title": "How Many Solar Panels Do I Need",
        "help_choose_ip": "shopify://shop_images/ip_223x_08bfbfad-7dc4-4cb2-aa1d-36959221ad35.png",
        "recharging_icon": "shopify://shop_images/recharging_time_90x_aec9aaaa-a49f-4ca6-a157-dd1266814f74.png",
        "energy_saving_icon": "shopify://shop_images/save_electricity_90x_9ed9d759-6275-42e5-88d6-ed70d74d0c00.png",
        "need_title": "How to Connect Solar Panels to Power Station?",
        "need_heading": "PREPARING YOUR SOLAR GENERATOR",
        "need_desc": "<p>The Explorer 1000 can be quickly fully recharged within 8 hours by connecting two SolarSaga 100W solar panels together with an adapter cable (package included).</p><p><strong>Solar recharging steps:</strong><br/><br/>1. Find the DC interface on the back of SolarSaga 100W;<br/><br/>2. Connect the DC interfaces of 2*SolarSaga 100W with the Y Parallel Cable;<br/><br/>3. Connect the Y Parallel Cable with the Anderson input of Explorer 1000</p>"
      }
