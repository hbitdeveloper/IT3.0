    "v5_story_hMNDkc": {
      "type": "v5-story",
      "blocks": {
        "story_jz8MaC": {
          "type": "story",
          "settings": {
            "tag": "RV",
            "title": "From Web Design to Wild Adventures",
            "des": "Jackery products are crucial for powering his devices, for both home and on-the-road life. This interview highlights Neil's important life choices, the impact of his work, and how Jackery's innovative solutions support his van life lifestyle.",
            "link": "https://uk.jackery.com/pages/from-web-design-to-wild-adventures-a-journey-beyond-the-screen"
          }
        },
        "story_KjX8mT": {
          "type": "story",
          "settings": {
            "tag": "Off-Grid",
            "title": "Circuits of the Everyday: How Jon Treby Powers a Life Off the Grid",
            "des": "UK teacher Jon Treby uses Jackery solar generators for home backup and camping, saving 10% on energy while teaching students about sustainability.",
            "link": "https://uk.jackery.com/pages/circuits-of-the-everyday-how-jon-treby-powers-a-life-off-the-grid"
          }
        },
        "story_bVPrC8": {
          "type": "story",
          "settings": {
            "tag": "Off-Grid Cabin",
            "title": "Power, Memory, and Music in a Wooden Hut: A Story from Carbeth’s Historic Hut Community",
            "des": "In Scotland’s Carbeth huts, a brother revives his late sibling’s cabin with Jackery portable power station restoring memories, nature, and off-grid life.",
            "link": "https://uk.jackery.com/pages/power-memory-and-music-in-a-wooden-hut"
          }
        },
        "story_NKA6Tp": {
          "type": "story",
          "settings": {
            "tag": "Off-Grid",
            "title": "Unveiling the Jackery Journey",
            "des": "Explore the Jackery journey with Robin, a UK tech director and photographer. Discover how from compact power banks to the Solar Explorer 2000 Plus, Jackery enhances outdoor experiences. Embrace green energy for continuous power amidst the Lake District's beauty.",
            "link": "https://uk.jackery.com/pages/unveil-the-journey-in-off-grid-green-energy-with-robin",
            "img_mb": "shopify://shop_images/11.webp"
          }
        },
        "story_xx8tKP": {
          "type": "story",
          "settings": {
            "tag": "Home Backup",
            "title": "Seamless Preparedness",
            "des": "Explore Michael's Jackery journey through power outages in his village. Discover the role of the Explorer 1000 Pro and Explorer 240 in maintaining connectivity and readiness. Experience the ease, setup speed, and self-sufficiency of Jackery's portable power stations.",
            "link": "https://uk.jackery.com/pages/seamless-preparedness-with-jackery"
          }
        }
      },
