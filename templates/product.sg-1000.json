      "settings": {
        "tabs_five_title": "",
        "is_show_reviews_tab": true,
        "image_plate_title": "",
        "feature_video_1": "",
        "feature_video_poster": "shopify://shop_images/SG1000_af4448b3-ecc7-4ffe-b146-c6c4f3c27bfb.png",
        "feature_intro": "Jackery Solar Generator 1000 is a solar solution that combines Jackery Explorer 1000 Portable Power Station with SolarSaga 100W solar panels. It converts sun energy captured by SolarSaga 100W solar panels into electrical power and then stores it in the Explorer 1000 Portable Power Station for later use. This solar generator is a reliable and clean power source for campers, RVs, or as an emergency backup if your power goes out.",
        "featured_text": "Features Summary",
        "summary_pc": "shopify://shop_images/solar_generator-1000_13.png",
        "summary_m": "shopify://shop_images/solar_generator-1000.png",
        "appliance_title": "<p>Power Outdoors and Great for Family Use</p>",
        "appliance_bg": "shopify://shop_images/solar_generator-1000_10.png",
        "appliance_intro": "Jackery Solar Generator 1000 is one of the best investments for your outdoor party. It's big enough to run approximately 85% of your essential outdoor appliances and electronics including blender, pellet smoker, ice shaver, radio, and projector. With multiple output ports, you can power up to 7 appliances at the same time.",
        "more_appliances_title": "",
        "more_appliances_subtitle": "",
        "running_title": "Running Time Simulator",
        "running_product": "To power with Explorer 1000  ( 1002Wh Capacity)",
        "running_tip": "Please enter the wattage of the appliance",
        "hour_desc": "Hrs",
        "running_expected": "Expected Running Time",
        "charge_title": "<p><em>3 Ways</em> to Recharging</p>",
        "charge_bg": "shopify://shop_images/solar_generator-1000_2.png",
        "bundels": "Current Bundles",
        "rechargin": "Recharging Time|(0-100%)",
        "charge_tips": "Professional MPPT technology provides faster solar recharging rates. You can also recharge the Explorer 1000 via wall charging and car charging. Jackery Solar Generator 1000 is your reliable backup power supply in any condition.",
        "safet_title_one": "",
        "safet_bg_video_one": "",
        "safet_desc_one": "",
        "safet_title": "<p>Safe BMS to Fully Protect You</p>",
        "safet_bg": "shopify://shop_images/solar_generator-1000_18.png",
        "safet_bg_video": "",
        "safet_desc": "The industry-leading BMS (Battery Management System) provides 12 layers of protection against short circuits, overvoltages, and more. The pure sine wave inverter delivers stable power to safeguard your appliances. Additionally, with the drop-proof feature, take the solar power station with your anywhere!",
        "life_title": "<p>Compact but Powerful</p>",
        "anniversary": 0,
        "life_bg": "shopify://shop_images/solar_generator-1000_17.png",
        "life_years_desc": "years",
        "life_years_desc_color": "#000000",
        "life_desc": "Same size as a basketball, the Explorer 1000 is easy to carry with its solid handle, making it a compact and reliable choice for camping, road-trips, RV, and home backup scenarios. The SolarSaga 100-watt solar panel weighs only 9.1 lbs; it's lightweight, foldable, and portable with an easy-carry handle.",
        "less_to_carry": "<p><em>Lightweight </em>and <em>Portable</em> Solar Generator</p>",
        "Carry_desc": "<p><strong>SolarSaga 100w solar panel</strong>: Foldable design and weighs only 9.1lbs. Convenient to carry it wherever you go. Adjust the angle with the built-in kickstand. <br/><br/><strong>Explorer 1000 Portable Power Station</strong>: Weighs only 22 lbs, and it is carry-friendly with an easy-carry handle. It also fits well in small spaces to transport during camping trips, RV, and over-landing adventures.</p>",
        "outdoors_title": "<p><em>Lightweight</em> and <em>Portable </em>Solar Generator</p>",
        "outdoors_scene_1": "shopify://shop_images/solar_generator-1000_23.png",
        "outdoors_scene_2": "shopify://shop_images/solar_generator-1000_4.png",
        "outdoors_scene_2_intro": "<p><strong>SolarSaga 100w solar panel</strong>: Foldable design and weighs only 9.1lbs. Convenient to carry it wherever you go. Adjust the angle with the built-in kickstand. <br/><br/><strong>Explorer 1000 Portable Power Station</strong>: Weighs only 22 lbs, and it is carry-friendly with an easy-carry handle. It also fits well in small spaces to transport during camping trips, RV, and over-landing adventures.</p>",
        "outdoors_scene_3": "shopify://shop_images/solar_generator-1000_1.png",
        "outdoors_scene_4": "shopify://shop_images/solar_generator-1000_6.png",
        "outdoors_scene_4_title": "Set up Solar Power System in 1 Minute",
        "outdoors_scene_4_intro": "Connect the solar panels to the power station in just 1 minute. Far more straightforward and more convenient than traditional generators. It is also equipped with pass-through charging, allowing you to power appliances whilst solar charging. The information on the screen is easy to ready and is fully intuitive.",
        "Green_title": "<p><em>Green</em> and <em>Quiet  </em>Solar Generator</p>",
        "green_bg": "shopify://shop_images/solar_generator-1000_22_149200b2-6f0a-46b2-8c5c-fa8a45c92dee.png",
        "green_scene": "shopify://shop_images/solar_generator-1000_5_16e4417b-9e92-481e-91e0-b79858d1fcbc.png",
        "green_scene_intro": "Jackery Solar Generator 1000 gives green solar power with zero emissions, and is nearly silent when in operation. Simply connect the solar panels to the power station, and you can enjoy reliable power when you go RV camping or fishing.",
        "tabs_video_title": "",
        "tabs_feature_video": "",
        "hide_help_choose": false,
        "help_choose_title": "How Many Solar Panels Do I Need",
        "help_choose_ip": "shopify://shop_images/ip_223x_08bfbfad-7dc4-4cb2-aa1d-36959221ad35.png",
        "recharging_icon": "shopify://shop_images/recharging_time_90x_aec9aaaa-a49f-4ca6-a157-dd1266814f74.png",
        "energy_saving_icon": "shopify://shop_images/save_electricity_90x_9ed9d759-6275-42e5-88d6-ed70d74d0c00.png",
        "need_title": "PREPARING YOUR SOLAR GENERATOR",
        "need_heading": "",
        "need_desc": "<p>The Explorer 1000 can be quickly fully recharged within 8 hours by connecting two SolarSaga 100W solar panels together with an adapter cable (package included).</p><p><strong>Solar recharging steps:</strong></p><p>1. Find the DC interface on the back of SolarSaga 100W;</p><p>2. Connect the DC interfaces of 2*SolarSaga 100W with the Y Parallel Cable;</p><p>3. Connect the Y Parallel Cable with the Anderson input of Explorer 1000</p>"
      }
    },
