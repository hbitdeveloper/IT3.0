  {% comment %} sb jp 15MB 的垃圾字体 {% endcomment %}
  @font-face {
    font-family: 'NotoSansCJKjp';
    src: url({{ 'NotoSansCJKjp-Regular.woff2' | asset_url }}) format('woff2'), url({{ 'NotoSansCJKjp-Regular.woff' | asset_url }}) format('woff');
    font-style: normal; font-display: swap;
  }

  * {
    font-family: 'Poppins';
  }


  {% comment %} 日本站字体特殊处理 {% endcomment %}
    html[lang=ja] body *:not(.iconfont, .jdgm-widget *, .shogun-icon, .shg-fa, .jackery-login__main *), html[lang=ja] *:not(.iconfont, .jdgm-widget *, .shogun-icon, .shg-fa, .jackery-login__main *) .gradient .content-for-layout *:not(.iconfont, .jdgm-widget *, .shogun-icon, .shg-fa, .jackery-login__main *) {
      font-family: 'NotoSansCJKjp';
      line-height: calc(100% + 10px);
    }
    html[lang=ja] {
      font-size: 14px;
    }
    html[lang=ja] strong, html[lang=ja] *[data-fontweight=600] {
      font-weight: 600;
    }
    html[lang=ja] .shg-theme-text-content p, html[lang=ja] .shg-rich-text p {
      margin-bottom: 20px;
    }

    html[lang=ja] .search-category-item[data-cate="support"] {
      display: none;
    }

    {% comment %} /** zendesk message pulgin style */ {% endcomment %}
    iframe[id="launcher"] {bottom: 75px !important;}
    iframe[style*="running launcherOnOpen"] {bottom: 16px !important;}
    @media screen and (max-width: 768px) {
      iframe[style*="running webSDKOnLoad"] {bottom: 130px !important;}
    }
    [data-wzb="BackToTop"], [data-wzb="SocialMobileTool"], .grecaptcha-badge, .J-shop-id, #powrIframeLoader {display: none !important; opacity: 0; visibility: hidden !important; pointer-events: none !important;}
    #launcher {bottom: 70px !important;}
    @media only screen and (max-width: 768px) {
      #launcher {bottom: 120px !important;}
    }
    {% comment %} /** zendesk message pulgin style */ {% endcomment %}


    {% comment %} fix shogun css bug {% endcomment %}
    .shg-c.header_meun {top: calc(var(--header-main) + 34px);}


    html[lang=ja] .jackery-invalid.sc-jackery-field-h .input-bottom.sc-jackery-field .error-text.sc-jackery-field {
      bottom: -5px;
    }
    {% comment %} fix shogun css bug {% endcomment %}

  @media screen and (max-width: 1024px) {
    html[lang=ja] body *:not(.iconfont, .jdgm-widget *, .shogun-icon, .shg-fa, .jackery-login__main *), html[lang=ja] *:not(.iconfont, .jdgm-widget *, .shogun-icon, .shg-fa, .jackery-login__main *) .gradient .content-for-layout *:not(.iconfont, .jdgm-widget *, .shogun-icon, .shg-fa, .jackery-login__main *) {
      line-height: calc(100% + 12px)!important;
    }
    html[lang=ja] .mb-menu-product-line span {
      font-size: 14px;
    }
  }
