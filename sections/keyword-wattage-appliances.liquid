<style>
  .section-keyword-wattage {
    margin-bottom: 6.3021vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }

  .keyword-wattage-panel {
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
    background: #f6f6f6;
    padding: 4.6875vw 2.8646vw;
  }

  .keyword-wattage-remark {
    font-size: 0.9375vw;
    font-weight: 400;
    color: #333333;
    padding-top: 3.3854vw;
  }

  .keyword-wattage-tabs {
    display: flex;
    gap: 1.0417vw 2.0833vw;
    flex-wrap: wrap;
    justify-content: center;
  }

  .keyword-wattage-tabs .tab-item {
    border: 0.0521vw solid #999999;
    display: flex;
    width: 15.625vw;
    font-size: 1.0417vw;
    font-weight: 600;
    color: #333333;
    height: 3.2292vw;
    justify-content: center;
    align-items: center;
    border-radius: var(--theme-btn-border-radius,0.4167vw);
    cursor: pointer;
    padding: 0.5208vw;
  }

  .keyword-wattage-tabs .tab-active {
    background: var(--primary-color);
    color: #ffffff;
  }

  .keyword-wattage-title {
    font-size: 1.875vw;
    font-weight: 600;
    color: #000000;
    padding-top: 2.8646vw;
    text-align: center;
  }

  .keyword-wattage-subtitle {
    color: #000000;
    padding-top: 2.2396vw;
    font-size: 1.3542vw;
    font-weight: 500;
    text-align: center;
  }

  .keyword-wattage-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 2.8646vw;
  }

  .keyword-wattage-wrap .unit {
    font-size: 1.875vw;
    font-weight: 500;
    color: #000000;
  }
  .keyword-wattage-wrap .time-input {
    width: 12.7604vw;
    height: 3.4375vw;
    line-height: 3.4375vw;
    text-align: center;
    background: #ffffff;
    border-radius: 1.7188vw;
    border: 0.0521vw solid #ddd;
    margin: 0 1.0417vw;
  }
  .keyword-wattage-error {
    font-size: 0.9375vw;
    font-weight: 500;
    color: var(--primary-color);
    margin-top: 0.7813vw;
    transition: all 0.3s ease;
    text-align: center;
    display: none;
  }

  .time-result {
    padding-top: 2.9688vw;
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
  }
  .time-result .result {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .time-result .result img {
    max-width: 100%;
  }
  .time-result .result .number {
    font-size: 2.3438vw;
    font-family: var(--jds-font-family);
    font-weight: 600;
    color: var(--jds-color-primary);
  }
  .time-result .result .unit {
    font-size: 1.25vw;
    font-weight: 500;
    color: #000000;
  }

  .time-result .expected {
    font-size: 1.25vw;
    font-weight: 500;
    color: #000000;
  }

  .keyword-wattage-notes {
    font-size: 1.0417vw;
    font-weight: 400;
    color: #333333;
    text-align: center;
    padding-top: 3.125vw;
  }

  @media screen and (max-width: 768px) {
    .section-keyword-wattage {
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .keyword-wattage-panel {
      max-width: 100%;
      padding: 5.6vw 3.4667vw;
    }

    .keyword-wattage-tabs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.6vw;
      margin-bottom: 6.2667vw;
      padding: 1.3333vw;
    }

    .keyword-wattage-tabs .tab-item {
      width: 100%;
      height: max-content;
      padding: 2vw 0;
      border-radius: var(--theme-btn-border-radius,1.0667vw);
      font-size: 3.2vw;
      font-weight: 600;
      text-align: center;
    }

    .keyword-wattage-title {
      font-size: 4.8vw;
    }

    .keyword-wattage-subtitle {
      padding-top: 2vw;
      font-size: 3.4667vw;
    }

    .keyword-wattage-wrap img {
      width: 5.4667vw;
      height: 6.6667vw;
    }

    .keyword-wattage-wrap .time-input {
      width: 29.3333vw;
      height: 8vw;
      border-radius: 4vw;
      margin: 0 4vw;
    }

    .keyword-wattage-wrap .unit {
      font-size: 4.8vw;
    }

    .time-result {
      padding-top: 6.4vw;
    }

    .time-result .result img {
      width: 12vw;
    }

    .time-result .result .number {
      font-size: 6vw;
    }

    .time-result .result .unit {
      font-size: 3.2vw;
    }

    .time-result .expected {
      padding-top: 2.9333vw;
      font-size: 3.2vw;
    }

    .keyword-wattage-notes {
      text-align: left;
      font-size: 2.6667vw;
    }

    .keyword-wattage-error {
      padding-top: 2vw;
      font-size: 3.4667vw;
    }
  }

  .keyword-wattage-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .keyword-wattage-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .keyword-wattage-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }
  }
</style>

<div class="keyword-wattage-panel J-keyword-wattage" anchor="{{ section.settings.anchor | escape }}">
  <div class="keyword-wattage-tabs">
    {% assign active_index = 0 %}
    {% for block in section.blocks %}
      {% assign capacity = block.settings.product.metafields.my_fields.wattage %}
      {%- if capacity -%}
        {% assign active_index = active_index | plus: 1 %}
        {% comment %} 产品最大功率，单位：W（瓦特） {% endcomment %}
        {% assign max_power = block.settings.product.metafields.custom.max_power %}

        {% assign efficiency = 0.8 %}
        {% assign ac_consumption = 0 %}
        {%- if capacity >= 100 and capacity < 1000 -%}
          {% assign efficiency = 0.82 %}
          {% assign ac_consumption = 10 %}
        {%- elsif capacity>= 1000 and capacity < 1200 -%}
          {% assign efficiency = 0.82 %}
          {% assign ac_consumption = 15 %}
        {%- elsif capacity>= 1200 and capacity < 2100 -%}
          {% assign efficiency = 0.82 %}
          {% assign ac_consumption = 18 %}
        {%- elsif capacity>= 2100 and capacity < 3050 -%}
          {% assign efficiency = 0.85 %}
          {% assign ac_consumption = 25 %}
        {%- elsif capacity>= 3050 and capacity < 5000 -%}
          {% assign efficiency = 0.85 %}
          {% assign ac_consumption = 22 %}
        {%- elsif capacity>= 5000 -%}
          {% assign efficiency = 0.85 %}
          {% assign ac_consumption = 50 %}
        {%- endif  -%}


        {% if block.settings.product.metafields.custom.efficiency != blank %}
          {% assign efficiency = block.settings.product.metafields.custom.efficiency %}
        {% endif %}

        {% if block.settings.product.metafields.custom.ac_consumption != blank %}
          {% assign ac_consumption = block.settings.product.metafields.custom.ac_consumption %}
        {% endif %}

        <h3
          data-capacity="{{capacity}}"
          data-maxpower="{{max_power}}"
          data-efficiency="{{efficiency}}"
          data-ac_consumption="{{ac_consumption}}"
          data-product_title="{{ block.settings.product_title }}"
          class="tab-item {% if active_index == 1 %} tab-active {%endif%}"
        >
          {{ block.settings.product_title | escape }}
        </h3>
      {% endif %}
    {% endfor %}
  </div>
  <h2 class="keyword-wattage-title" data-origin_title="{{ section.settings.title | escape }}"
  style="
--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
--pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
"
  >
    {{ section.settings.title | escape }}
  </h2>
  <div class="keyword-wattage-subtitle" data-origin_subtitle="{{ section.settings.subtitle | escape }}">
    {{ section.settings.subtitle | escape }}
  </div>
  <div class="keyword-wattage-wrap">
    <img
      src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_62deaa2a-2d30-4fd8-bbd3-3f5f7067c615.svg?v=1678865782"
      alt=""
      loading="lazy"
    >
    <input
      type="number"
      class="time-input"
      min="0"
      onkeyup="value=value.replace(/[^\d]/g,'')"
      onblur="value=value.replace(/[^\d]/g,'')"
    >
    <span class="unit">{{ section.settings.wattage_desc | escape }}</span>
  </div>
  <div class="keyword-wattage-error" data-origin_error_msg="{{ section.settings.error_msg | escape }}">
    {{ section.settings.error_msg | escape }}
  </div>
  <div class="time-result">
    <div class="result">
      <img
        src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_Expected_uptime.svg?v=1678864200"
        alt="time"
        loading="lazy"
      >
      <span>
        <b class="number">0</b>
        <i class="unit">{{ section.settings.hour_desc | escape }}</i>
      </span>
    </div>
    <div class="expected">{{ section.settings.expected_uptime | escape }}</div>
  </div>
  <div class="keyword-wattage-notes">
    {{ section.settings.remark | escape }}
  </div>
</div>

<script defer>
  function keywordWattageInit() {
    const tabItems = document.querySelectorAll('.keyword-wattage-tabs .tab-item');
    tabItems.forEach(function (tab) {
      tab.addEventListener('click', function (e) {
        tabItems.forEach(function (item) {
          item.classList.remove('tab-active');
        });
        e.target.classList.add('tab-active');

        formatProductWattage();
      });
    });

    const timeInput = document.querySelector('.J-keyword-wattage .time-input');
    timeInput.addEventListener('change', function () {
      formatProductWattage();
    });
  }

  function formatProductWattage() {
    const tabActive = document.querySelector('.J-keyword-wattage .tab-active');
    const product_title = tabActive.dataset.product_title;
    const capacity = tabActive.dataset.capacity;
    const maxcapacity = tabActive.dataset.maxpower;
    const efficiency = tabActive.dataset.efficiency;
    const acConsumption = tabActive.dataset.ac_consumption;

    const titleElement = document.querySelector('.keyword-wattage-title');
    const subtitleElement = document.querySelector('.keyword-wattage-subtitle');
    const errorElement = document.querySelector('.keyword-wattage-error');
    const timeInput = document.querySelector('.J-keyword-wattage .time-input');
    const value = timeInput.value;

    let title = titleElement.dataset.origin_title;
    let subtitle = subtitleElement.dataset.origin_subtitle;
    let error = errorElement.dataset.origin_error_msg;

    title = title.replace('{productTitle}', product_title);
    title = title.replace('{productWattage}', capacity);
    titleElement.textContent = title;
    subtitleElement.textContent = subtitle.replace('{productWattage}', maxcapacity);
    errorElement.textContent = error.replace('{productWattage}', maxcapacity);

    const numberElement = document.querySelector('.J-keyword-wattage .number');
    if (capacity && value) {
      if (maxcapacity && Number(value) > Number(maxcapacity)) {
        errorElement.style.display = 'block';
        numberElement.textContent = '0';
      } else {
        let result = window.Jackery.Utils.getRunningTime(Number(value), Number(capacity), Number(efficiency), Number(acConsumption));
        numberElement.textContent = result;
        errorElement.style.display = 'none';
      }
    } else {
      numberElement.textContent = '0';
      errorElement.style.display = 'none';
    }
  }

  window.addEventListener('DOMContentLoaded', function () {
    keywordWattageInit();
    formatProductWattage();
  });
</script>

{% schema %}
{
  "name": "Keyword Wattage",
  "class": "section-keyword-wattage",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },
    { "type": "text", "id": "title", "label": "Title {productTutle} and {productWattage}" },
    { "type": "text", "id": "subtitle", "label": "Tab Subtitle" },
    { "type": "text", "id": "wattage_desc", "label": "Wattage Description" },
    { "type": "text", "id": "hour_desc", "label": "Hour Description" },
    { "type": "text", "id": "expected_uptime", "label": "Expected uptime" },
    { "type": "text", "id": "error_msg", "label": "Expected Error Msg: {productWattage}" },
    { "type": "textarea", "id": "remark", "label": "Remark" },
    { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
    { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 40 },
    { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
    { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 }
  ],
  "blocks": [
    {
      "type": "wattage-item",
      "name": "Wattage Item",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "product_title", "label": "Product Title" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keyword Wattage",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
