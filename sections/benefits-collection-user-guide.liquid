<div class="py-[3rem] lg:py-[4.5rem]" style="background-color: {{ section.settings.outer_bg_color }}">
    <div class="section-container-lg" anchor-target="{{ section.settings.anchor | escape }}">
        <div style="background-color: {{ section.settings.inner_bg_color }}" class="w-[21.4375rem] rounded-[0.75rem] lg:w-[82rem] lg:rounded-xl flex justify-between items-center pt-[0.5rem] pb-[0.625rem] px-[0.75rem] lg:px-[2.625rem] lg:py-[1.25rem]">
            <p class="line-clamp-3 lg:line-clamp-2 w-[16.875rem] lg:w-[67.5rem] font-semibold text-[1rem] text-white leading-[1.5rem] lg:text-[1.125rem] lg:leading-[1.625rem]">{{ section.settings.title }}</p>
            {% if section.settings.link %}
                <a class="w-[2rem] h-[2rem] rounded-[1rem] lg:w-[2.9375rem] lg:h-12 bg-white lg:rounded-3xl flex items-center justify-center" href="{{ section.settings.link }}"
                   data-ga-event="promo_collection_user_clicks"
                   data-ga-action="click"
                   data-ga-params-module="TextBanner"
                   data-ga-params-position="{{ section.settings.title }}"
                   data-ga-params-button_name="ViewMore"
                >
                  {% render 'icon-arrow-right', color: section.settings.inner_bg_color, class: "w-full h-[0.8125rem] lg:h-[1.125rem]" %}
                </a>
            {% endif %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "BC User Guide",
  "presets": [
    {
      "name": "优惠集合-使用说明",
      "category": "优惠信息集合页"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "color",
      "id": "outer_bg_color",
      "label": "外层背景颜色",
      "default": "#fcedda"
    },
    {
      "type": "color",
      "id": "inner_bg_color",
      "label": "背景颜色",
      "default": "#fd5000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文案颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Your Guide to Jackery Rewards and Savings"
    },
    {
      "type": "url",
      "id": "link",
      "label": "跳转链接"
    }
  ]
}
{% endschema %}
