{% comment %} 11周年 Anniversary Gifts 组件{% endcomment %}
{% schema %}
{
  "name": "Anniversary Gifts",
  "tag": "section",
  "class": "anniversary-gifts-component",
  "settings": [
    {
      "type": "text",
      "id": "promotionDesc",
      "label": "Promotion Description"
    },
    {
      "type": "text",
      "id": "btnTxt",
      "label": "Button Text"
    },
    {
      "type": "image_picker",
      "id": "pcGiftImg",
      "label": "Gift Image (PC)"
    },
    {
      "type": "image_picker",
      "id": "mbGiftImg",
      "label": "Gift Image (Mobile)"
    }
  ]
}
{% endschema %}
<div class="anniversary-gifts-box section-container">
	{% if section.settings.promotionDesc != blank %}
		<div class="promotion-desc">{{ section.settings.promotionDesc }}</div>
	{% endif %}
	{% if section.settings.btnTxt != blank %}
		<button type="button" class="btn-gift z-button-big">{{ section.settings.btnTxt }}</button>
	{% endif %}

	{% render 'responsive-image',
			image: section.settings.pcGiftImg,
			mimage: section.settings.mbGiftImg,
			image_class: 'card-img'
	%}
</div>
<style>
	.anniversary-gifts-box {
		position: relative;
		padding-top: 48px;
		width: 100%;
		text-align: center;
		overflow: hidden;
		background-color: #fff;
		border-radius: 16px;
		box-sizing: border-box;
		display: flex;
		flex-wrap: nowrap;
		flex-direction: column;
		align-items: center;
	}

	.anniversary-gifts-box .promotion-desc {
		margin: 0 auto 24px;
		max-width: 800px;
		font-size: 28px;
		font-weight: 600;
		color: rgba(0,0,0,0.8);
		line-height: 1.29;
		word-break: break-word;
	}

	.anniversary-gifts-box .btn-gift {
		margin-bottom: 8px;
		word-break: break-word;
	}

	.anniversary-gifts-box .card-img {
		width: 877px;
		height: 350px;
	}
	@media screen and (max-width: 1440px) {
		.anniversary-gifts-box {
			padding-top: 2.5vw;
			border-radius: 0.8333vw;
		}

		.anniversary-gifts-box .promotion-desc {
			margin: 0 auto 1.25vw;
			max-width: 41.6667vw;
			font-size: 1.4583vw;
		}

		.anniversary-gifts-box .card-img {
			width: 45.6771vw;
			height: 18.2292vw;
		}
	}
	@media screen and (max-width: 1023px) {
		.anniversary-page .anniversary-gifts-box.section-container{
			width: 100%;
			height: auto;
			border-radius: 0;
			text-align: left;
			align-items: flex-start;
		}

		.anniversary-gifts-box .promotion-desc {
			margin: 0 8vw 5.3333vw;
			max-width: unset;
			font-size: 5.3333vw;
			line-height: 1.4;
		}

		.anniversary-gifts-box .btn-gift {
			margin-left: 8vw;
			margin-bottom: 2.6667vw;
		}

		.anniversary-gifts-box .card-img {
			width: 100vw;
			min-height: 100vw;
			height: auto;
		}
	}
</style>
