<style>
    .section-partner-form .newbee-form .form-row .field_error-tips {
        line-height: 1.25!important;
    }

    .section-partner-form .form-row__phone input {
        padding-left: 5rem!important;
    }
    .section-partner-form .form-row__phone .divider {
        display: block;
        height: 100%;
        width: 1px;
        background: var(--placeholder-color);
        margin: 0 0.75rem 0 0.5rem;
    }
    .section-partner-form .form-row .form-item input::placeholder {
        color: var(--placeholder-color);
    }
    .section-partner-form .section-container-lg {
        padding-top: 2.5rem;
        padding-bottom: 2.5rem;
    }
    @media screen and (max-width: 1024px) {
        .section-partner-form .newbee-form .form-row .field_error-tips.text-overflow-2 {
            -webkit-line-clamp: 1;
        }
    }
    @media screen and (min-width: 1024px) {
        .section-partner-form .section-container-lg {
            padding-top: 7.5rem;
        }
        .section-partner-form .jky-checkbox-input .jky-checkbox-original:checked~.jky-checkbox-inner:after {
            transform: rotate(45deg) scale(1) translate(-60%, -50%);
        }
    }

    .section-partner-form .form-row .form-item input {
        margin-top: 0;
        overflow: hidden !important;
        padding-right: 50px!important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        box-sizing: border-box;
    }
</style>

<div class="bg-white">
    <div class="section-container-lg">
        <h2 class="v5-font-oxm font-extrabold lg:text-5xl text-4xl mb-3 text-center">
            {{ section.settings.heading | replace: '\n', '<br>' | strip }}
        </h2>

        <p class="font-normal text-base text-center">
            {{ section.settings.description | replace: '\n', '<br>' | strip }}
        </p>

        <partner-form class="block lg:pt-12 pt-4">
            <jky-form
                jky-form-id="tob-contentS"
                class="subscribe-email footer-subscribe-box"
                id="partner-form"
            >
                <form data-action="/osconsumerapi/v1/service/dealer-application-eu">
                <div class="form-container newbee-form newbee-form_{{section.id}}">
                    <div class="flex gap-x-6 w-full flex-col lg:flex-row">
                        {% comment %} first name {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item required relative" data-field="input">
                                <input
                                    id="partner-firstName"
                                    name="partner-firstName"
                                    placeholder="{{ section.settings.fisrt_name_label | escape }}"
                                    data-error="{{ section.settings.fisrt_name_error | escape }}"
                                    data-value="firstName"
                                >
                            </div>
                        </div>

                        {% comment %} last name {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item required relative" data-field="input">
                                <input
                                    id="partner-lastName"
                                    name="partner-lastName"
                                    placeholder="{{ section.settings.last_name_label | escape }}"
                                    data-error="{{ section.settings.last_name_error | escape }}"
                                    data-value="lastName"
                                >
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-x-6 w-full flex-col lg:flex-row">
                        {% comment %} 邮箱 {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item required relative" data-field="input">
                                <input
                                    type="email"
                                    id="partner-email"
                                    name="partner-email"
                                    placeholder="{{'newsletter.email_placeholder' | t}}"
                                    data-error="{{'newsletter.email_empty_info' | t}}"
                                    data-value="email"
                                    data-reg="email"
                                    data-regerror="{{'newsletter.email_error_info' | t}}"
                                >
                            </div>
                        </div>

                        {% comment %} 国家 {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item relative required" data-field="dropmenu">
                                <jky-drop-menu data-error="{{ section.settings.country_error | escape }}" class="country-dropmenu">
                                    <label style="background: var(--input-bg);padding-left:var(--input-padding-x);margin-bottom: 0;border: 1px solid var(--input-border-color);" for="country" class="absolute pr-12 inset-0 flex items-center">{{ section.settings.country_label }}</label>
                                
                                    <details-disclosure>
                                        <details id="partner-form-country">
                                            <summary
                                                class="jky_drop_menu_field list-menu__item link focus-inset"
                                                role="button" aria-expanded="false"
                                            >
                                                <input
                                                    class="opacity-0"
                                                    type="text"
                                                    readonly
                                                    id="country"
                                                    name="country"
                                                    placeholder="Country*"
                                                    data-value="country"
                                                    style="margin-top: 0;"
                                                />
                                
                                                <svg 
                                                    focusable="false" class="jky_drop_menu_field_arrow absolute" data-icon="down" width="1em" height="1em" fill="#333" aria-hidden="true" viewBox="64 64 896 896"><path d="M884 256h-75c-5.1 0-9.9 2.5-12.9 6.6L512 654.2 227.9 262.6c-3-4.1-7.8-6.6-12.9-6.6h-75c-6.5 0-10.3 7.4-6.5 12.7l352.6 486.1c12.8 17.6 39 17.6 51.7 0l352.6-486.1c3.9-5.3.1-12.7-6.4-12.7z"></path>
                                                </svg>
                                            </summary>
                                
                                            <ul style="max-height: 300px;" class="list-menu--disclosure partner-country overflow-y-auto" tabindex="-1">
                                            </ul>
                                            <div class="jky-overlay" style="z-index: 2025;"></div>
                                        </details>
                                    </details-disclosure>
                                </jky-drop-menu>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-x-6 w-full flex-col lg:flex-row">
                        {% comment %} city {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item relative" data-field="input">
                                <input
                                    id="city"
                                    name="city"
                                    placeholder="{{ section.settings.city_label | escape }}"
                                    data-error=""
                                    data-value="city"
                                >
                            </div>
                        </div>

                        {% comment %} phone {% endcomment %}
                        <div class="form-row form-row__phone flex flex-1">
                            <div class="form-item required relative" data-field="input">
                                <div class="absolute top-0 bottom-0 left-0 w-20 py-3 flex items-center justify-center select-none">
                                    <span class="phone-code"></span>
                                    <span class="divider"></span>
                                </div>

                                <input
                                    type="tel"
                                    id="phoneNumber"
                                    name="phoneNumber"
                                    placeholder="{{ section.settings.phone_label | escape }}"
                                    data-error="{{ section.settings.phone_error | escape }}"
                                    data-value="phoneNumber"
                                >
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-x-6 w-full flex-col lg:flex-row">
                        {% comment %} 品类 {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item relative required" data-field="dropmenu">
                                <jky-drop-menu data-error="{{ section.settings.category_error | escape }}">
                                    <label for="consultingCategory" class=" hidden">{{ section.settings.category_label | escape }}</label>
                                
                                    <details-disclosure>
                                        <details id="partner-form-category">
                                            <summary
                                                class="jky_drop_menu_field list-menu__item link focus-inset"
                                                role="button" aria-expanded="false"
                                            >
                                                <input
                                                    type="text"
                                                    readonly
                                                    id="consultingCategory"
                                                    name="consultingCategory"
                                                    placeholder="{{ section.settings.category_label | escape }}"
                                                    data-value="consultingCategory"
                                                    style="margin-top: 0;"
                                                />
                                
                                                <svg focusable="false" class="jky_drop_menu_field_arrow absolute" data-icon="down" width="1em" height="1em" fill="#333" aria-hidden="true" viewBox="64 64 896 896"><path d="M884 256h-75c-5.1 0-9.9 2.5-12.9 6.6L512 654.2 227.9 262.6c-3-4.1-7.8-6.6-12.9-6.6h-75c-6.5 0-10.3 7.4-6.5 12.7l352.6 486.1c12.8 17.6 39 17.6 51.7 0l352.6-486.1c3.9-5.3.1-12.7-6.4-12.7z"></path></svg>
                                            </summary>
                                
                                            <ul style="max-height: 300px;" class="list-menu--disclosure partner-category overflow-y-auto" tabindex="-1">
                                                <li class="phone_select_category_item active" data-label="{{ section.settings.pps_label | escape }}" data-key="{{ section.settings.pps_label | escape }}">{{ section.settings.pps_label | escape }}</li>
                                                <li class="phone_select_category_item" data-label="{{ section.settings.sp_label | escape }}" data-key="{{ section.settings.sp_label | escape }}">{{ section.settings.sp_label | escape }}</li>
                                                <li class="phone_select_category_item" data-label="{{ section.settings.sg_label | escape }}" data-key="{{ section.settings.sg_label | escape }}">{{ section.settings.sg_label | escape }}</li>
                                            </ul>
                                            <div class="jky-overlay" style="z-index: 2025;"></div>
                                        </details>
                                    </details-disclosure>
                                </jky-drop-menu>
                            </div>
                        </div>

                        {% comment %} 职业 {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item relative required" data-field="dropmenu">
                                <jky-drop-menu data-error="{{ section.settings.job_error | escape }}">
                                    <label for="iam" class=" hidden">{{ section.settings.job_label | escape }}</label>
                                
                                    <details-disclosure>
                                        <details id="partner-form-job">
                                            <summary
                                                class="jky_drop_menu_field list-menu__item link focus-inset"
                                                role="button" aria-expanded="false"
                                            >
                                                <input
                                                    type="text"
                                                    readonly
                                                    id="iam"
                                                    name="iam"
                                                    placeholder="{{ section.settings.job_label | escape }}"
                                                    data-value="iam"
                                                    style="margin-top: 0;"
                                                    class="job-field"
                                                />
                                
                                                <svg focusable="false" class="jky_drop_menu_field_arrow absolute" data-icon="down" width="1em" height="1em" fill="#333" aria-hidden="true" viewBox="64 64 896 896"><path d="M884 256h-75c-5.1 0-9.9 2.5-12.9 6.6L512 654.2 227.9 262.6c-3-4.1-7.8-6.6-12.9-6.6h-75c-6.5 0-10.3 7.4-6.5 12.7l352.6 486.1c12.8 17.6 39 17.6 51.7 0l352.6-486.1c3.9-5.3.1-12.7-6.4-12.7z"></path></svg>
                                            </summary>
                                
                                            <ul style="max-height: 300px;" class="list-menu--disclosure partner-job overflow-y-auto" tabindex="-1">
                                                <li class="phone_select_job_item" data-label="{{ section.settings.distributor_label | escape }}" data-key="{{ section.settings.distributor_label | escape }}">{{ section.settings.distributor_label | escape }}</li>
                                                <li class="phone_select_job_item" data-label="{{ section.settings.wholesaler_label | escape }}" data-key="{{ section.settings.wholesaler_label | escape }}">{{ section.settings.wholesaler_label | escape }}</li>
                                                <li class="phone_select_job_item" data-label="{{ section.settings.retailer_label | escape }}" data-key="{{ section.settings.retailer_label | escape }}">{{ section.settings.retailer_label | escape }}</li>
                                                <li class="phone_select_job_item" data-label="{{ section.settings.commerce_eller_label | escape }}" data-key="{{ section.settings.commerce_eller_label | escape }}">{{ section.settings.commerce_eller_label | escape }}</li>
                                                <li class="phone_select_job_item" data-label="{{ section.settings.installer_label | escape }}" data-key="{{ section.settings.installer_label | escape }}">{{ section.settings.installer_label | escape }}</li>
                                                <li class="phone_select_job_item" data-label="{{ section.settings.electrician_label | escape }}" data-key="{{ section.settings.electrician_label | escape }}">{{ section.settings.electrician_label | escape }}</li>
                                                <li class="phone_select_job_item" data-label="{{ section.settings.system_integrator_label | escape }}" data-key="{{ section.settings.system_integrator_label | escape }}">{{ section.settings.system_integrator_label | escape }}</li>
                                                <li class="phone_select_job_item" data-label="Other" data-key="Other">{{ section.settings.other_label | escape }}</li>
                                            </ul>
                                            <div class="jky-overlay" style="z-index: 2025;"></div>
                                        </details>
                                    </details-disclosure>
                                </jky-drop-menu>
                            </div>
                        </div>
                    </div>

                    <div class="hidden gap-x-6 w-full other-job-wrapper">
                        {% comment %} 其它职业- 具体 {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item relative" data-field="input">
                                <input
                                    id="other_job"
                                    name="other_job"
                                    placeholder="{{ section.settings.other_job_label | escape }}"
                                    data-error=""
                                    data-value="other_job"
                                >
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-x-6 w-full flex-col lg:flex-row">
                        {% comment %} 你从哪里听说Jackery的 {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item relative required" data-field="dropmenu">
                                <jky-drop-menu data-error="{{ section.settings.hear_error | escape }}">
                                    <label for="hearThat" class=" hidden">{{ section.settings.hear_label | escape }}</label>
                                
                                    <details-disclosure>
                                        <details id="partner-form-hear">
                                            <summary
                                                class="jky_drop_menu_field list-menu__item link focus-inset"
                                                role="button" aria-expanded="false"
                                            >
                                                <input
                                                    type="text"
                                                    readonly
                                                    id="hearThat"
                                                    name="hearThat"
                                                    placeholder="{{ section.settings.hear_label | escape }}"
                                                    data-value="hearThat"
                                                    style="margin-top: 0;"
                                                    class="hear-field"
                                                />
                                
                                                <svg focusable="false" class="jky_drop_menu_field_arrow absolute" data-icon="down" width="1em" height="1em" fill="#333" aria-hidden="true" viewBox="64 64 896 896"><path d="M884 256h-75c-5.1 0-9.9 2.5-12.9 6.6L512 654.2 227.9 262.6c-3-4.1-7.8-6.6-12.9-6.6h-75c-6.5 0-10.3 7.4-6.5 12.7l352.6 486.1c12.8 17.6 39 17.6 51.7 0l352.6-486.1c3.9-5.3.1-12.7-6.4-12.7z"></path></svg>
                                            </summary>
                                
                                            <ul style="max-height: 300px;" class="list-menu--disclosure partner-hear overflow-y-auto" tabindex="-1">
                                                <li class="phone_select_hear_item active" data-label="{{ section.settings.events_label | escape }}" data-key="{{ section.settings.events_label | escape }}">{{ section.settings.events_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.articles_label | escape }}" data-key="{{ section.settings.articles_label | escape }}">{{ section.settings.articles_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.social_media_label | escape }}" data-key="{{ section.settings.social_media_label | escape }}">{{ section.settings.social_media_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.outdoor_label | escape }}" data-key="{{ section.settings.outdoor_label | escape }}">{{ section.settings.outdoor_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.tv_label | escape }}" data-key="{{ section.settings.tv_label | escape }}">{{ section.settings.tv_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.magazine_label | escape }}" data-key="{{ section.settings.magazine_label | escape }}">{{ section.settings.magazine_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.industry_label | escape }}" data-key="{{ section.settings.industry_label | escape }}">{{ section.settings.industry_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.ffficial_website_label | escape }}" data-key="{{ section.settings.ffficial_website_label | escape }}">{{ section.settings.ffficial_website_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.marketplaces_label | escape }}" data-key="{{ section.settings.marketplaces_label | escape }}">{{ section.settings.marketplaces_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.retail_stores_label | escape }}" data-key="{{ section.settings.retail_stores_label | escape }}">{{ section.settings.retail_stores_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="{{ section.settings.friends_label | escape }}" data-key="{{ section.settings.friends_label | escape }}">{{ section.settings.friends_label | escape }}</li>
                                                <li class="phone_select_hear_item" data-label="Other" data-key="Other">{{ section.settings.hear_other_label | escape }}</li>
                                            </ul>
                                            <div class="jky-overlay" style="z-index: 2025;"></div>
                                        </details>
                                    </details-disclosure>
                                </jky-drop-menu>
                            </div>
                        </div>
                    </div>

                    <div class="hidden gap-x-6 w-full other-hear-wrapper">
                        {% comment %} 其它渠道- 具体 {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item relative" data-field="input">
                                <input
                                    id="other_hear"
                                    name="other_hear"
                                    placeholder="{{ section.settings.other_hear_label | escape }}"
                                    data-error=""
                                    data-value="other_hear"
                                >
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-x-6 w-full">
                        {% comment %} company {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item required relative" maxlength="100" data-field="input" data-error="{{ section.settings.company_error | escape }}">
                                <input
                                    id="company_name"
                                    name="company_name"
                                    maxlength="101"
                                    placeholder="{{ section.settings.company_label | escape }}"
                                    data-error="{{ section.settings.company_error | escape }}"
                                    data-value="companyName"
                                >
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-x-6 w-full">
                        {% comment %} website {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item relative form-item-website" data-field="input">
                                <input
                                    id="website"
                                    name="website"
                                    placeholder="{{ section.settings.website_label | escape }}"
                                    data-error=""
                                    data-value="website"
                                    data-reg="url"
                                    data-regerror="{{ section.settings.website_error | escape }}"
                                >
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-x-6 w-full">
                        {% comment %} 市场区域 {% endcomment %}
                        <div class="form-row flex flex-1">
                            <div class="form-item relative" data-field="input">
                                <input
                                    id="partner-area"
                                    name="partner-area"
                                    placeholder="{{ section.settings.area_label | escape }}"
                                    data-error=""
                                    data-value="area"
                                >
                            </div>
                        </div>
                    </div>

                    {% comment %} 留言 {% endcomment %}
                    <div class="form-row flex full">
                        <div class="form-item required relative" data-field="input">
                            <div class="hidden">
                                <input
                                    type="hidden"
                                    id="partner-textareaBox"
                                    name="partner-comment"
                                    placeholder="{{section.settings.message_label | escape}}"
                                    data-error="{{section.settings.message_error | escape}}"
                                    data-value="yourMessage"
                                    value=""
                                >
                            </div>
                            
                            <textarea
                                class="p-3"
                                id="partner-comment"
                                name="partner-comment"
                                maxlength="2000"
                                rows="6"
                                placeholder="{{section.settings.message_label | escape}}"
                                data-error="{{section.settings.message_error | escape}}"
                                data-value="partner-comment"
                                style="background: var(--input-bg);border: 1px solid var(--input-border-color);"
                            ></textarea>
                            {% comment %} border-radius: var(--input-radius); {% endcomment %}
                        </div>
                    </div>

                    {% comment %} 隐私协议 {% endcomment %}
                    <div class="form-row privacy form-row_check_box flex full text-white">
                        <div
                            class="form-item required"
                            data-field="check_box"
                            data-error="{{'newsletter.policy_empty_info' | t}}"
                        >
                            {% render 'jky-formField-checkbox',
                            key: section.settings.privacy_policy,
                            value: 'agree_recevie'
                            %}
                        </div>
                    </div>

                    {% comment %} CR {% endcomment %}
                    {% assign iso_code = settings.shop_cr | default: localization.country.iso_code | default: 'US' %}
                    <div style="display: none;" class="form-row flex">
                        <div class="form-item form-item_const" data-field="input">
                            <input
                            type="text"
                            id="partner-cr"
                            name="partner-cr"
                            data-error=""
                            data-value="cr"
                            data-reg=""
                            value="{{ iso_code }}"
                            data-regerror=""
                            >
                        </div>
                    </div>

                    <div class="newbee-form_submit flex w-full" data-loading="{{section.settings.loading_btn}}">
                        <button class="form_sub_btn z-button-middle footer-new-submit w-full lg:h-12 h-10 flex items-center justify-center" data-success="{{'newsletter.success' | t}}">
                            <span class="line-clamp-1">{{ section.settings.submit_label | escape }}</span>
                        </button>
                    </div>
                </div>
                </form>
            </jky-form>
        </partner-form>
    </div>
</div>

<script>
    if (!customElements.get('partner-form')) {
        class PartnerForm extends HTMLElement {
            constructor() {
            super();
            }
            connectedCallback() {
                this.init();
            }
            init() {
                const that = this
                this.defaultCountry = null;
                this.otherJob = this.querySelector(".other-job-wrapper");
                this.jobWrapper = this.querySelector("#partner-form-job");

                this.cateWrapper = this.querySelector("#partner-form-category");

                this.otherHear = this.querySelector(".other-hear-wrapper");
                this.hearWrapper = this.querySelector("#partner-form-hear");

                this.websiteItem = this.querySelector(".form-item-website");
                this.websiteInput = this.querySelector(".form-item-website input");
                this.handleValidateUrl = this.handleValidateUrl.bind(this);

                this.form = this.querySelector("jky-form");
                this.content_field = this.querySelector("#partner-comment");
                this.content_input = this.querySelector("#partner-textareaBox");

                this.renderCountryList();
                this.jobWrapper.querySelectorAll("ul li").forEach(item => {
                    item.addEventListener("click", () => {
                        this.jobWrapper.querySelectorAll("ul li").forEach(node => {
                            if(node !== item) {
                                node.classList.remove('active');
                            }
                        });
                        item.classList.add("active");
                        if(item.getAttribute("data-key") === "Other") {
                            this.otheJobShow();
                        } else {
                            this.otheJobHide()
                        }
                    })
                })

                this.hearWrapper.querySelectorAll("ul li").forEach(item => {
                    item.addEventListener("click", () => {
                        this.hearWrapper.querySelectorAll("ul li").forEach(node => {
                            if(node !== item) {
                                node.classList.remove('active');
                            }
                        });
                        item.classList.add("active");
                        if(item.getAttribute("data-key") === "Other") {
                            this.otheHearShow();
                        } else {
                            this.otheHearHide();
                        }
                    })
                })

                this.cateWrapper.querySelectorAll("ul li").forEach(item => {
                    item.addEventListener("click", () => {
                        this.cateWrapper.querySelectorAll("ul li").forEach(node => {
                            if(node !== item) {
                                node.classList.remove('active');
                            }
                        });
                        item.classList.add("active");
                    })
                })

                this.websiteInput.addEventListener("input", this.handleValidateUrl)

                this.content_field.addEventListener('blur', function () {
                    that.content_input.value = that.content_field.value.trim();
                    that.form.formValidate();
                });

                this.form.afterFb = () => {
                    this.querySelector("#partner-comment").value = ''
                    if(this.form.defaultCountry) {
                        this.querySelector(`#partner-form-country .phone_select_country_item[data-iso="${this.form.defaultCountry.iso}"]`).click();
                        document.querySelector("partner-form").handleDefaultCountry(this.form.defaultCountry);
                    }
                }
            }
            async renderCountryList() {
                this.countryWrapper = this.querySelector(".partner-country");
                if(!this.countryWrapper) return;
                this.countries = await this.getGlobalISO();
                this.activeIso = Shopify?.country || "US";
                this.form.activeIso = this.activeIso;
                this.countryInput = this.querySelector("#country");
                this.phoneCodeText = this.querySelector(".phone-code");
                this.countryDropMenu = this.querySelector(".country-dropmenu");
                
                let list_dom = '';
                if (this.countries.length === 0) {
                    list_dom = `<div class="no-data text-center" data-code="" data-iso="" data-cr="">No Search Data</div>`
                } else {
                    this.countries.forEach(i => {
                        list_dom += `<li class="${this.activeIso === i.iso ? 'phone_select_country_item active':'phone_select_country_item'}" data-code="${i.code}" data-cr="${i.iso}" data-label="${i.country}" data-key="${i.country}" data-iso="${i.iso}">${i.country}</li>`
                        if(this.activeIso === i.iso) { // 设置默认值 = 当前站点对应的区域
                            this.handleDefaultCountry(i);
                            this.defaultCountry = i;
                            this.form.defaultCountry = i;
                        }
                    })
                }
                this.countryWrapper.innerHTML = list_dom;

                this.bindCountrySelected();
            }
            async getGlobalISO() {
                try {
                    const response = await fetch('https://cdn.shopify.com/s/files/1/0550/0524/9633/files/global_iso.json?v=1702862314');
                    if (!response.ok) {
                        throw new Error('请求失败');
                    }
                    const data = await response.json();
                    return data;
                } catch(error) {
                    console.error(error);
                    return [];
                }
            }
            bindCountrySelected() {
                const list = this.countryWrapper.querySelectorAll(".phone_select_country_item");
                list.forEach(item => {
                    item.addEventListener("click", e => {
                        list.forEach(node => {
                            if(node !== item) {
                                node.classList.remove('active');
                            }
                        });
                        item.classList.add("active");

                        const code = e.target.getAttribute("data-code");
                        this.phoneCodeText.textContent  = `+${code}`;


                        const disclosure = this.querySelector("#partner-form-country").closest("details-disclosure");

                        {% comment %} fix: 国家地区无法回显 {% endcomment %}
                        if(disclosure) {
                            disclosure.close();
                            this.querySelector("#country").value = e.target.getAttribute("data-iso");

                            this.handleDefaultCountry({
                                iso: e.target.getAttribute("data-iso"),
                                code: code,
                                country: e.target.getAttribute("data-label")})
                        }
                    })
                })
            }
            otheJobShow() {
                this.otherJob.classList.add("flex");
                this.otherJob.classList.remove("hidden");
            }
            otheJobHide() {
                this.otherJob.classList.add("hidden");
                this.otherJob.classList.remove("flex");
            }
            otheHearShow() {
                this.otherHear.classList.add("flex");
                this.otherHear.classList.remove("hidden");
            }
            otheHearHide() {
                this.otherHear.classList.add("hidden");
                this.otherHear.classList.remove("flex");
            }
            handleValidateUrl(e) {
                const url = e.target?.value || ''
                let res = true
                if(!url) {
                    res = true
                } else {
                    res = /^(?:(?:https?|ftp):\/\/)?(?:www\.)?[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*\.[a-zA-Z]{2,}(?::\d{1,5})?(?:\/[^\s]*)?$/.test(url);
                }

                if(res) {
                    this.websiteItem.classList.remove("error");
                    this.websiteItem.querySelectorAll(".field_error-tips").length > 0 && this.websiteItem.querySelectorAll(".field_error-tips").forEach(item => item.remove())
                } else {
                    this.websiteItem.classList.add("error");
                    if(!this.websiteItem.querySelector(".field_error-tips")) {
                        this.websiteItem.insertAdjacentHTML('beforeend', `<div class="field_error-tips text-overflow-2">${this.websiteInput.getAttribute("data-regerror")}</div>`);
                    }
                }
            }
            handleDefaultCountry(i) {
                this.countryInput.value = i.iso;
                this.phoneCodeText.textContent  = `+${i.code}`;
                this.countryDropMenu.setAttribute("data-value", i.iso);
                this.countryDropMenu.querySelector("label").textContent = i.country;
            }
        }
        customElements.define('partner-form', PartnerForm);
    }
</script>

