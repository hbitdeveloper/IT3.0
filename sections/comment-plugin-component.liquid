{% schema %}
{
  "name": "Comment Plugin Component",
  "tag": "section",
  "class": "comment-plugin-component layer-container section-container",
  "settings": [
    {
      "type": "text",
      "id": "sectionTitle",
      "label": "Section Title",
      "default": "Power Your Life with Jackery Solar"
    },
    {
      "type": "text",
      "id": "sectionSubtitle",
      "label": "Section Subtitle",
      "default": "Share with us how you use Jackery to win a Explorer 240(worth $219) Post"
    },
    {
      "type": "text",
      "id": "websiteID",
      "label": "Current Website ID With Hyvor Talk",
      "default": "8910"
    },
    {
      "type": "text",
      "id": "langCode",
      "label": "Current Website Language Code",
      "default": "en-us",
      "info": "Supported Languages: https://talk.hyvor.com/docs/language"
    }
  ]
}
{% endschema %}
<h2 class="section-title">{{ section.settings.sectionTitle }}</h2>
<p class="section-subtitle">{{ section.settings.sectionSubtitle }}</p>
<div class="comment-content">
  <div id="hyvor-talk-view"></div>
  <script type="text/javascript">
    var HYVOR_TALK_WEBSITE = "{{ section.settings.websiteID }}";
    var HYVOR_TALK_CONFIG = {
      url: false,
      id: false,
      language: "{{ section.settings.langCode }}"
    };
  </script>
  <script async type="text/javascript" src="//talk.hyvor.com/web-api/embed.js"></script>
</div>
<style>
  .comment-plugin-component {
    text-align: center;
  }

  .comment-plugin-component .section-subtitle {
    color: #2c2c2c;
  }

  @media screen and (min-width: 1024px) {
    .comment-plugin-component {
      padding-top: 4.1667vw;
      padding-bottom: 6.25vw;
    }

    .comment-plugin-component .section-title {
      margin-bottom: 1.0417vw;
      font-size: 2.2917vw;
      font-weight: 600;
      line-height: 1.27;
    }

  }

  @media screen and (max-width: 1023px) {
    .comment-plugin-component {
      max-width: 100%;
      padding: 13.3333vw 4vw 8vw;
    }

    .comment-plugin-component .section-title {
      margin-bottom: 8vw;
      font-size: 6vw;
      font-weight: 500;
      line-height: 1.47;
    }
  }
</style>
