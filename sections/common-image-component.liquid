{% comment %} 通用带有超链接图片配置组件 {% endcomment %}
{% schema %}
{
  "name": "Common Image Component",
  "tag": "section",
  "class": "common-img-component",
  "settings": [
    {
      "type": "image_picker",
      "id": "pcImg",
      "label": "PC Image"
    },
    {
      "type": "image_picker",
      "id": "mbImg",
      "label": "Mobile Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
{% if section.settings.pcImg != blank or section.settings.pcImg != blank %}
	<div class="common-img-box">
		<a href="{{ section.settings.link }}">
			{% render 'responsive-image',
					image: section.settings.pcImg,
					mimage: section.settings.mbImg,
					image_class: 'common-img'
			%}
		</a>
	</div>
{% endif %}
<style>
	.common-img-box {
		padding: 30px 0 60px;
		border-radius: 16px;
	}

	.common-img-box .common-img {
		width: auto;
		height: auto;
		border-radius: 16px;
	}
	@media screen and (max-width: 1440px) {
		.common-img-box {
			padding: 1.5625vw 0 3.125vw;
			border-radius: 0.8333vw;
		}
		.common-img-box .common-img {
			border-radius: 0.8333vw;
		}
	}
	@media screen and (max-width: 1023px) {
		.common-img-box {
			padding: 8vw 0;
		}

		.common-img-box .common-img {
			width: 100%;
			height: auto;
			border-radius: 0;
		}
	}
</style>
