<div style="display:none;">
  {% render "diy-tabs", %}
</div>


{%- for block in section.blocks -%}
  {%- assign blocks_type = block.type -%}
  {%- if blocks_type contains 'media_highlight' -%}
    {%- case block.type -%}
      {%- when 'media_highlight_scense' -%}
        <div style="width: 100vw;">
          {% render "diy-media-swiper", settings: block.settings %}
        </div>
    {%- endcase -%}
  {%- endif -%}
{%- endfor -%}

{% schema %}
