            { "type": "url", "id": "link_1", "label": "场景 1 跳转地址", "info": "跳转地址，非必填"},
            { "type": "image_picker", "id": "poster_1", "label": "场景 1 封面图片（PC）"},
            { "type": "image_picker", "id": "poster_mb_1", "label": "场景 1 封面图片（Mobile）"},
            { "type": "url", "id": "video_url_1", "label": "场景 1 视频地址（PC）", "info": "本地视频建议视频大小不超过10MB"},
