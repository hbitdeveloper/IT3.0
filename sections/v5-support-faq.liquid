
{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div class="v5-support-faq section-padding text-[#242F20] leading-[1.1] section-container-lg text-center" style="{{ style }}">
  <p class="text-2xl lg:text-[2.5rem] font-semibold mb-6 lg:mb-10">{{ section.settings.title }}</p>
  <div class="flex gap-3 lg:gap-4 lg:flex-row flex-col">
    {% for block in section.blocks %}
      <a class="border border-solid border-[#595959] flex justify-center items-center font-semibold text-base lg:text-xl h-12 lg:h-20 w-full" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
        {{ block.settings.title }}
      </a>
    {% endfor %}
  </div>
  {% if section.settings.link %}
    <jds-button class="mt-6 lg:mt-10" variant="text" kind="default" size="medium" iconposition="next" interaction="default" icon="arrow-right" href="{{ section.settings.link }}">
      {{ section.settings.button_text }}
    </jds-button>
  {% endif %}
</div>

{% schema %}
{
  "name": "V5-Support FAQ",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "PC边距" },
    { "type": "number", "id": "padding_top", "label": "上边距", "default": 32 },
    { "type": "number", "id": "padding_bottom", "label": "下边距", "default": 32 },
    { "type": "header", "content": "MB边距" },
    { "type": "text", "id": "mb_padding_type", "default": "custom", "label": "MB边距", "visible_if": "{{ false }}" },
    { "type": "number", "id": "padding_top_mb", "label": "上边距", "default": 24 },
    { "type": "number", "id": "padding_bottom_mb", "label": "下边距", "default": 24 },
    { "type": "text", "id": "title", "label": "Title", "default": "FAQ" },
    { "type": "text", "id": "button_text", "label": "View More", "default": "FAQ" },
    { "type": "url", "id": "link", "label": "跳转链接"}
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Product Related" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5-Support FAQ",
      "category": "V5.0 Support",
      "settings": {
        "title": "FAQ"
      },
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "title": "Product Related",
            "url": "https://faq.jackery.com/hc/en-us/categories/10461404723227-Product-Related"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "Order Related",
            "url": "https://faq.jackery.com/hc/en-us/categories/10493967564955-Order-Related"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "Shipping Related",
            "url": "https://faq.jackery.com/hc/en-us/categories/10463493295771-Shipping-Related"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "Warranty",
            "url": "https://faq.jackery.com/hc/en-us/categories/10587872635547-Warranty"
          }
        }
      ]
    }
  ]
}
{% endschema %}
