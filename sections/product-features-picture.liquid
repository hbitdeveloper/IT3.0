<figure {% if section.settings.anchor != blank %} data-anchor="{{section.settings.anchor}}" {% endif %} class="section-container product-b {% if section.settings.section_type %} product-p-t{% endif %}">
  <h2 class="product-title jky-text-2xl font-500">{{ section.settings.featured_text }}</h2>
  <picture>
      <source media="(min-width: 750px)" srcset="{{ section.settings.summary_pc | image_url: width: 1920 }}">
      <img src="{{ section.settings.summary_m | image_url: width: 750 }}" alt="{{ section.settings.featured_text }}" loading="lazy">
  </picture>
</figure>

{% schema %}
{
    "name": "product features picture", "class": "product-features-picture product-section-block", "tag": "div",
    "enabled_on": {
      "templates": ["page","product"]
    },
    "settings": [
        {
          "type": "checkbox",
          "id": "section_type",
          "default": true,
          "label": "是否为大版块？",
          "info": "大版块与上一个模块之间间距大，小版块与上一模块间距较小"
        },
        {
            "type": "select",
            "id": "anchor",
            "label": "锚点设置",
            "info": "非锚点section请清空此项",
            "options": [
                {
                "value": "",
                "label": "非锚点section"
                },
                {
                "value": "anchor__1",
                "label": "第一个section锚点"
                },
                {
                "value": "anchor__2",
                "label": "第二个section锚点"
                },
                {
                "value": "anchor__3",
                "label": "第三个section锚点"
                },
                {
                "value": "anchor__4",
                "label": "第四个section锚点"
                }
            ],
            "default": ""
        },
        {"type": "text", "id": "featured_text", "label": "Featured Title", "default": "Featured Summary"},
        {"type": "image_picker", "id": "summary_pc", "label": "PC Image"},
        {"type": "image_picker", "id": "summary_m", "label": "mobile Image"}
    ],
    "presets": [{
        "name": "product features picture"
    }]
}
{% endschema %}