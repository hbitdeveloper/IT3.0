{% comment %} 日本防灾日 dp-region-two组件 {% endcomment %}
{% schema %}
  {
    "name": "DP Region Two",
    "tag": "section",
    "class": "dp-region-two",
    "settings": [
      {
        "type": "image_picker",
        "id": "leftImage",
        "label": "Left Image"
      },
      {
        "type": "image_picker",
        "id": "rightImage",
        "label": "Right Image"
      },

      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "text",
        "id": "button",
        "label": "Button Label"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Button Link"
      }
    ]
  }
  {% endschema %}

  <div class="dp-region-two-box">
    <div class="region-section">
      <div class="content-box box-shadow">
        <div class="content-left dp-animation">
          <img
            class="scenes-img lazy"
            src="{{ section.settings.leftImage | image_url: width: 1260 }}"
            alt="{{ section.settings.leftImage.alt | escape }}"
          >
        </div>
        <div class="content-right">
          <div class="img-box dp-animation">
            <img
              class="scenes-img lazy"
              src="{{ section.settings.rightImage | image_url: width: 1260 }}"
              alt="{{ section.settings.rightImage.alt | escape }}"
            >
          </div>
          <div class="des dp-animation">{{ section.settings.title }}</div>
          <a
            class="btn dp-animation"
            href="{{section.settings.link}}"
          >
            <span>{{ section.settings.button }}</span>
            <div class="svg-box">
              <svg width="25" height="26" viewBox="0 0 25 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M11.2726 19.1626C11.7803 19.6703 12.6034 19.6702 13.1111 19.1626L21.3843 10.8894C21.8919 10.3817 21.8919 9.55862 21.3843 9.05094C20.8766 8.54326 20.0535 8.54326 19.5458 9.05094L12.1919 16.4049L4.83797 9.05095C4.33029 8.54327 3.50717 8.54327 2.99949 9.05095C2.49181 9.55863 2.49181 10.3817 2.99949 10.8894L11.2726 19.1626ZM23.9685 23.9135L23.9685 22.6135L23.9685 22.6135L23.9685 23.9135ZM10.8919 0.360352L10.8919 18.2433L13.4919 18.2433L13.4919 0.36035L10.8919 0.360352ZM0.415288 25.2135L23.9685 25.2135L23.9685 22.6135L0.415288 22.6135L0.415288 25.2135ZM23.9685 25.2135L24.8408 25.2135L24.8408 22.6135L23.9685 22.6135L23.9685 25.2135Z" fill="#FF5000"/>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
