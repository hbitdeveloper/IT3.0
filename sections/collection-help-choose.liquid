{{ 'collection-help-choose.css' | asset_url | stylesheet_tag }}
<style>
    .section-collection-how-choose .newcomer-find-power .find-right, .section-collection-how-choose .higher-right {display: none;}
    .section-collection-how-choose .higher-left, .section-collection-how-choose .find-left {margin-right: 0!important;}
    .section-collection-how-choose .newcomer-main-container {padding: 2rem 5rem 2.5rem 5rem;background: #ffffff;border-radius: 0.75rem;justify-content: space-between;}
    .section-collection-how-choose {background: #f5f5f5;padding: 4.5rem 0;}
    .collection-how-choose-main {justify-content: space-between;}
    .newcomer-calculator-container {background: linear-gradient( 180deg, #FFFFFF 0%, #F5F5F5 100%);}

    .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .product-selector .product-item .product-image {height: 100%;}

    .collection-how-choose-subtitle em, .collection-how-choose-title em {color: var(--jds-color-primary);}
    .collection-how-choose-subtitle em a, .collection-how-choose-title em a{color: var(--jds-color-primary);text-decoration: underline;text-decoration-color: var(--jds-color-primary);}
    .collection-how-choose-subtitle a em, .collection-how-choose-title a em{color: var(--jds-color-primary);text-decoration: underline;text-decoration-color: var(--jds-color-primary);}
    @media screen and (min-width: 1024px) {
        .collection-how-choose-main {gap: 1.5rem;}
        .section-collection-how-choose .newcomer-main-container {flex: 1;}
    }
    @media screen and (max-width: 1023px) {
        .section-collection-how-choose {padding: 2.25rem 0;}

        .section-collection-how-choose .collection-how-choose-subtitle {margin-bottom: 1.5rem;}
        .collection-how-choose-main {gap: 0.75rem;}
        .section-collection-how-choose .newcomer-calculator-container {margin-top: 0.75rem;}
        .section-collection-how-choose .newcomer-main-container {padding: 1rem 1rem 1.5rem 1rem;}
        .section-collection-how-choose .newcomer-find-power .find-power-content .find-left, .section-collection-how-choose .newcomer-higher-output .higher-output-content .higher-left, .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-left, .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right  {padding: 0;}
        .section-collection-how-choose .newcomer-find-power .find-power-content .find-btn-mb, .section-collection-how-choose .newcomer-higher-output .higher-output-content .higher-btn-mb {margin: 0;}
        .section-collection-how-choose .newcomer-find-power .find-power-content, .section-collection-how-choose .newcomer-higher-output .higher-output-content {gap: 0.75rem;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right {padding-top: 3.5rem;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom {margin-top: 1.5rem;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .wattage-input-area{padding-top: 0.625rem;margin-top: 0.625rem;gap: 1rem;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .wattage-input-area .wattage-icon {margin-right: 0;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .wattage-input-area .wattage-input {margin-right: 0;flex: 1;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .wattage-input-area .wattage-input .wattage-bottom .form-box .btn-enter {margin-left: 0;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .product-selector .product-item .product-info .product-name .selector-arrow {font-size: 1rem;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .wattage-input-area .wattage-input .wattage-bottom .form-box, .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .wattage-input-area .wattage-input .wattage-bottom .form-box .inp-box {flex: 1;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .wattage-input-area .wattage-input .wattage-bottom .form-box .inp-box input {width: 100%;border-width: 2px;}
        .section-collection-how-choose .newcomer-calculator .calculator-content .calculator-right .calculator-bottom .wattage-input-area .wattage-input .wattage-bottom .form-box {align-items: center;gap: 0.5rem;}

    }
    .section-collection-how-choose .newcomer-main-container:not(.newcomer-find-power, .newcomer-higher-output) {background: linear-gradient(180deg, #FFFFFF 0%, #F5F5F5 100%);}
    {% comment %} 5.0主题按钮 {% endcomment %}
    .jky-v5 .collection-block-help-choose .btn-choose {
        border-radius: var(--theme-btn-border-radius,0);
    }
</style>

<div>
    {%- if section.settings.heading != blank -%}
        <div class="section-container-lg jds-rte collection-how-choose-title mb-5 lg:px-0 px-2">{{section.settings.heading}}</div>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
        <div class="section-container-lg jds-rte collection-how-choose-subtitle mb-9 lg:px-0 px-2">{{section.settings.subheading}}</div>
    {%- endif -%}

    <div class="flex flex-col lg:flex-row section-container-lg collection-how-choose-main">
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {% when 'step_1' %}
                    {% render 'newcomer-find-power',settings: block.settings, index: 1, shopify_attributes: block.shopify_attributes %}
                {% when 'step_2' %}
                    {% render 'newcomer-higher-output',settings: block.settings, index: 2, shopify_attributes: block.shopify_attributes %}
            {%- endcase -%}
        {%- endfor -%}
    </div>

    <div class="section-container-lg newcomer-calculator-container mt-6 rounded-xl">
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {%- when 'newcomer-calculator' -%}
                    {% render 'newcomer-calculator', settings: block.settings, index: 3, shopify_attributes: block.shopify_attributes %}
            {%- endcase -%}
        {%- endfor -%}
    </div>

    <div class="section-container-lg collection-block-help-choose">
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {%- when 'help_choose' -%}
                    <div {{ block.shopify_attributes }} class="flex flex-col lg:flex-row gap-y-4 items-center justify-between lg:px-12 lg:py-6 px-4 pt-4 pb-6 rounded-xl bg-white">
                        <h3 class="text-base lg:text-2xl font-medium text-center lg:text-left lg:font-semibold text-[#1A1A1A]">{{block.settings.title | escape}}</h3>

                        <a
                            class="btn-choose text-base lg:text-lg py-3 w-full lg:w-fit lg:p-3 rounded lg:rounded-lg bg-[#FFEAE1] text-[var(--jds-color-primary)] font-semibold text-center"
                            data-ga-event="product_collection4.0_user_clicks"
                            data-ga-action="click"
                            data-ga-params-module="Text Block_B"
                            data-ga-params-position="{{block.settings.title | escape}}"
                            data-ga-params-button_name="{{block.settings.btn_title | escape}}"
                            data-ga-params-link="{{block.settings.help_link | escape}}"
                            {% if section.settings.open_new == true %}target="_blank" {% endif %} href="{{block.settings.help_link | escape}}">{{block.settings.btn_title | escape}}</a>
                    </div>
            {%- endcase -%}
        {%- endfor -%}
    </div>
</div>

<script defer src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/countUp.min.js?v=1752126972" data-cookieconsent="ignore"></script>
<script defer src="{{ 'collection-help-choose.js' | asset_url }}"></script>

{% schema %}
{
  "name": "产品系列-choose",
  "class": "section section-collection-how-choose",
  "enabled_on": {
        "templates": ["collection"]
  },
  "settings": [
    {
        "type": "richtext",
        "id": "heading",
        "label": "标题",
        "default": "<h2>How to choose a right portable power station</h2>"
    },
    {
        "type": "richtext",
        "id": "subheading",
        "label": "描述",
        "default": "<p>Remotely control the device, view battery level, power input/output, and available time in real-time, with user-customizable settings.</p>"
    }
  ],
  "blocks": [
        {
            "type": "step_1",
            "name": "电器设备功率",
            "limit": 1,
            "settings": [
                { "type": "header", "content": "Find Power" },
                { "type": "number", "id": "part_index", "label": "索引" },
                { "type": "richtext", "id": "part_title", "label": "标题" },
                { "type": "richtext", "id": "part_subtitle", "label": "副标题" },
                { "type": "richtext", "id": "button_title", "label": "按钮标题" },
                { "type": "richtext", "id": "table_title", "label": "表格标题" },
                { "type": "header", "content": "弹窗图片" },
                { "type": "richtext", "id": "table_description", "label": "弹窗备注" },
                { "type":"image_picker","id":"pop_image_pc","label":"PC弹窗图宽580px，高自动撑开" },
                { "type":"image_picker","id":"pop_image_mb","label":"MB弹窗图宽630px，高自动撑开" }
            ]
        },
        {
            "type": "step_2",
            "name": "设备储能",
            "limit": 1,
            "settings": [
                { "type": "header", "content": "Higher Output" },
                { "type": "collection", "id": "collection_shop", "label": "产品系列" },
                { "type": "number", "id": "part_index", "label": "索引" },
                { "type": "richtext", "id": "part_title", "label": "标题" },
                { "type": "richtext", "id": "part_subtitle", "label": "副标题" },
                { "type": "richtext", "id": "button_title", "label": "按钮标题" },
                { "type": "richtext", "id": "table_title", "label": "表格标题" },
                { "type": "text", "id": "table_col_title_1", "label": "表格第一列标题" },
                { "type": "text", "id": "table_col_title_2", "label": "表格第二列标题" },
                { "type": "text", "id": "table_col_title_3", "label": "表格第三列标题" },
                { "type": "image_picker", "id": "pc_pop_poster", "label": "PC弹窗图宽612px，高自动撑开" },
                { "type": "image_picker", "id": "mb_pop_poster", "label": "MB弹窗图宽750px，高自动撑开" }
            ]
        },
        {
            "type": "newcomer-calculator",
            "name": "储能估算",
            "limit": 1,
            "settings": [
                { "type": "header", "content": "Calculator" },
                { "type": "collection", "id": "collection_shop", "label": "产品系列" },
                { "type": "number", "id": "part_index", "label": "索引" },
                { "type": "richtext", "id": "part_title", "label": "标题" },
                { "type": "richtext", "id": "part_subtitle", "label": "副标题" },
                { "type": "richtext", "id": "table_description", "label": "备注" },
                { "type": "image_picker", "id": "select_poster", "label": "未选择时候icon图片" },
                { "type": "text", "id": "hour_text", "label": "小时数文案", "default": "Hrs"  },
                { "type": "text", "id": "expected_text", "label": "预期运行时常文案"  },
                { "type": "text", "id": "select_text", "label": "选择储能文案", "default": "select power station"  },
                {
                "type": "textarea",
                "id": "errorTips",
                "label": "错误提示",
                "default": "Input power does not exceed ${power}W.",
                "info": "${power}用于替换当前产品产品的最大功率，替换后示例：3000W;"
                },
                { "type": "text", "id": "w_text", "label": "瓦数名称", "default": "Wattage"  },
                { "type": "text", "id": "button_tip_text", "label": "按钮提示语", "default": "calculation", "info": "日站填充文案：計算する"  },
                { "type": "text", "id": "equipment", "label": "设备参数", "default": "Capacity ${capacity}, Output ${power}",
                "info": " 1. ${power}用于替换当前产品产品的最大功率，替换后示例：3000W; 2. ${Capacity}用于替换当前产品的电池容量，替换后示例：2000Wh"  }
            ]
        },
        {
            "type": "help_choose",
            "name": "智能选购",
            "limit": 1,
            "settings": [
                {"type": "text", "id": "title", "label": "Heading", "default": "Customized recommendations for you"},
                {"type": "text", "id": "btn_title", "label": "Button Heading", "default": "Help You Choose"},
                {"type": "url","id": "help_link", "label": "智能选购链接链接"}
            ]
        }
  ],
  "presets": [
    {
      "name": "产品系列-choose",
      "category": "产品系列",
      "blocks": [
          {
              "type": "step_1",
              "settings": {
                  "part_index": 1,
                  "part_title": "<p>Find Your Device’s Power Consumption</p>",
                  "part_subtitle": "<p>Check the wattage (W) on your appliances label or manual to determine its power needs.</p>",
                  "button_title": "<p>Check the Power of Electrical Appliances</p>",
                  "table_title": "<p>弹窗表格占位标题</p>",
                  "table_description": "<p>弹窗表格占位描述内容</p>"
              }
          },
          {
              "type": "step_2",
              "settings": {
                  "collection_shop": "all",
                  "part_index": 2,
                  "part_title": "<p>Choose a Jackery with Higher Output</p>",
                  "part_subtitle": "<p>Choose a Jackery power station with higher output than your appliance requires for stable operation.</p>",
                  "button_title": "<p>Learn About the Capacity and Power of Jackery Products</p>",
                  "table_title": "<p>弹窗表格占位标题</p>",
                  "table_col_title_1": "<p>表格第一列占位标题</p>",
                  "table_col_title_2": "<p>表格第二列占位标题</p>",
                  "table_col_title_3": "<p>表格第三列占位标题</p>"
              }
          },
          {
              "type": "newcomer-calculator",
              "settings": {
                  "collection_shop": "all",
                  "part_index": 3,
                  "part_title": "<p>Choose a Jackery to Estimate Runtime</p>",
                  "part_subtitle": "<p>Select a Jackery power station and enter your appliance’s wattage to estimate the running time.</p>",
                  "table_description": "<p>Note: This is a calculation for reference. Please take the actual use for accuracy</p>",
                  "expected_text": "Expected Running Time",
                  "select_text": "select power station"
              }
          },
          {
              "type": "help_choose"
          },
      ]
    }
  ]
}
{% endschema %}
