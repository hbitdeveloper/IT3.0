<style>
  .quality-btn {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  .quality-btn  .quality-center-container{
        display: flex;
        justify-content: center;
    }

    .quality-btn  .quality-center-container a{
        display: block;
        background: var(--jds-color-primary);
        border-radius: 28px;
        padding: 12px 93px;
        color: #fff;
        font-size: 18px;
        line-height: 1;
    }

  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .quality-btn {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }

    .quality-btn  .quality-center-container a{
        border-radius: 1.944444vw;
        padding: 0.8333333vw 6.458333vw;
        font-size: 1.25vw;
    }

  }
  @media screen and (max-width: 1023.98px) {
    .quality-btn {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }

    .quality-btn  .quality-center-container{
        width: 91.46vw;
    }
    .quality-btn  .quality-center-container a{
        border-radius: 6.533333vw;
        padding: 2.9333333vw 15.466666vw;
        font-size: 3.7333333vw;
    }
  }
</style>

{% if section.settings.btn != blank %}
    <div class="quality-btn"
    anchor="{{ section.settings.anchor | escape }}"
        style=" background: {{ section.settings.bg_color }};
        --pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
        --pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
        "
    >
        <div class="quality-center-container">
            <a href="{{ section.settings.link }}"
            target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}"
            data-ga-event="button_clicks"
            data-ga-action="click"
            data-ga-params-button_name="{{ section.settings.btn | strip_html }}"
            data-ga-params-link="{{ section.settings.link }}"
            >{{ section.settings.btn }}</a>
        </div>

    </div>
{% endif %}

{% schema %}
    {
      "name": "Quality Btn",
      "settings": [
        { "type": "text", "id": "anchor", "label": "二级标题定位锚点", "info": "搭配二级导航锚点定位未使用到定位则不配置" },
        { "type": "checkbox", "id": "new_window", "label": "新开标签页", "default": false },
        { "type": "color_background", "id": "bg_color", "label": "组件背景色"},
        { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
        { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC" },
        { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
        { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB" },
        { "type": "richtext", "id": "btn", "label": "按钮文案" },
        { "type": "url", "id": "link", "label": "按钮链接" }
      ],
      "presets": [
        {
          "name": "品质中心 - 按钮"
        }
      ]
    }
    {% endschema %}