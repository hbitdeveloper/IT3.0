<style>
     .v5-letter-banner .subscribe-blocks{
        margin: 0 auto;
      }
      .v5-letter-banner .subscribe-blocks .blocks-subscribe-banner-form{
        width: 100%;
      }

    @media screen and (min-width: 1920px) {
    .v5-letter-banner .block-common-banner .banner-img {
      height: 100%;
    }
  }

  @media screen and (min-width: 1440px) and (max-width: 1600px) {
    .v5-letter-banner .block-common-banner .swiper-wrapper{
       height: calc(var(--pc-banner-h, 470) * 1px);
      }
    .v5-letter-banner .block-common-banner .banner-img {
        height: calc(var(--pc-banner-h, 470) * 1px);
    }
  }

    .v5-letter-banner .block-common-banner .swiper{
      overflow: visible;
    }

    .v5-letter-banner .block-common-banner .swiper .swiper-slide{
      overflow: visible;
    }

    @media screen and (min-width: 1024px) {

      {% comment %} 上中下 {% endcomment %}
      .v5-letter-banner .block-common-banner .banner-info.vertical-top{
          top: 4rem;
      }
      .v5-letter-banner .block-common-banner .banner-info.vertical-center{
          top: 50%;
      }
      .v5-letter-banner .block-common-banner .banner-info.vertical-bottom{
          top: unset;
          bottom: 4rem;
          transform: translateX(-50%);
      }
    }

    @media screen and (max-width: 1023.98px) {
      {% comment %} 上中下 {% endcomment %}
      .v5-letter-banner .block-common-banner .banner-info.vertical-top-mb{
          top: 4rem;
      }
      .v5-letter-banner .block-common-banner .banner-info.vertical-center-mb{
        top: 50%;
        transform: translate(-50%, -50%);
      }
      .v5-letter-banner .block-common-banner .banner-info.vertical-bottom-mb{
          top: unset;
          bottom: 5rem;
          transform: translateX(-50%);
      }
      }
</style>

