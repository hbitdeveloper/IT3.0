<div>
    {%- for block in section.blocks -%}
        {%- case block.type -%}
            {%- when 'title' -%}
                {% render 'new-title', title: block.settings.title, type: block.settings.type, bgColor: block.settings.background, color: block.settings.color %}
            {%- when 'jky_ces_videos' -%}
                {%- render "jky-ces-videos", settings: block.settings, new_window: section.settings.new_window,index: forloop.index -%}
        {%- endcase -%}
    {% endfor %}
</div>

{% schema %}
    {
        "name": "JKY CES Videos",
        "settings": [
        ],
        "blocks": [
            {
                "type": "title",
                "name": "标题",
                "limit": 1,
                "settings": [
                    { "type": "text",  "id": "title", "label": "标题" },
                    { "type": "select", "id": "type", "label": "标题类型", "options": [
                        { "value": "1", "label": "小档" },
                        { "value": "2", "label": "大档" }
                    ], "default": "1"},
                    { "type": "color", "id": "color", "label": "文本颜色", "default": "#000"},
                    { "type": "color", "id": "background", "label": "Background", "default": "#fff" }
                ]
            },
            {
                "type": "jky_ces_videos",
                "name": "视频轮播列表",
                "limit": 1,
                "settings": [
                  { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#ffffff" },
                  {"type": "textarea", "id": "title", "label": "Title"},
                  {"type": "select", "id": "video_size", "label": "选择视频样式：", "default":"video_small", "options": [{"value": "video_small", "label": "竖屏"},{"value": "video_large", "label": "横屏"}]},
                  {"type": "checkbox", "id": "loop", "label": "循环播放？", "default": true},
                  {"type": "checkbox", "id": "controls", "label": "显示播放控件？", "default": true},
          
                  {"type": "header", "content": "视频信息 1 配置"},
                  {"type": "image_picker", "id": "poster_1", "label": "视频信息 1 封面图片"},
                  {"type": "url", "id": "video_url_1", "label": "视频信息 1 视频地址" },
          
                  {"type": "header", "content": "视频信息 2 配置"},
                  {"type": "image_picker", "id": "poster_2", "label": "视频信息 2 封面图片"},
                  {"type": "url", "id": "video_url_2", "label": "视频信息 2 视频地址" },
          
                  {"type": "header", "content": "视频信息 3 配置"},
                  {"type": "image_picker", "id": "poster_3", "label": "视频信息 3 封面图片"},
                  {"type": "url", "id": "video_url_3", "label": "视频信息 3 视频地址" },
          
                  {"type": "header", "content": "视频信息 4 配置"},
                  {"type": "image_picker", "id": "poster_4", "label": "视频信息 4 封面图片"},
                  {"type": "url", "id": "video_url_4", "label": "视频信息 4 视频地址" },
          
                  {"type": "header", "content": "视频信息 5 配置"},
                  {"type": "image_picker", "id": "poster_5", "label": "视频信息 5 封面图片"},
                  {"type": "url", "id": "video_url_5", "label": "视频信息 5 视频地址" },
          
