<div {% if section.settings.anchor != blank %} data-anchor="{{section.settings.anchor}}"{% endif %}>
  <div style='clear:both'></div>
  <div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget layer-container' data-id='{{ product.id }}'> {{ product.metafields.judgeme.widget }} </div>
</div>
{% schema %}
{
  "name": "product reviews", "class": "reviews", "tag": "div",
  "enabled_on": {
      "templates": ["product"]
  },
  "settings": [
    {
        "type": "select",
        "id": "anchor",
        "label": "锚点设置",
        "info": "非锚点section请清空此项",
        "options": [
            {
            "value": "",
            "label": "非锚点section"
            },
            {
            "value": "anchor__1",
            "label": "第一个section锚点"
            },
            {
            "value": "anchor__2",
            "label": "第二个section锚点"
            },
            {
            "value": "anchor__3",
            "label": "第三个section锚点"
            },
            {
            "value": "anchor__4",
            "label": "第四个section锚点"
            }
        ],
        "default": ""
    }
  ],
  "presets": [{
    "name": "product detail reviews"
    }]
}
{% endschema %}