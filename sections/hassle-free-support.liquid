{% schema %}
{
  "name": "Hassle Free Support",
  "tag": "section",
  "class": "hassle-free-support",
  "settings": [],
    "max_blocks": 5,
    "blocks": [
      {
        "name": "Items",
        "type": "slide",
        "settings": [
          {
            "type": "image_picker",
            "id": "pcItemImg",
            "label": "Item Image (PC)"
          },
          {
            "type": "image_picker",
            "id": "mbItemImg",
            "label": "Item Image (Mobile)"
          },
		  {
			"type": "select",
			"id": "features_style",
			"options": [
				{
					"value": "full",
					"label": "Row"
				},
				{
					"value": "half",
					"label": "1/2 Row"
				}
			],
			"default": "half",
			"label": "Image(Mobile) Style"
          }
        ]
      }
    ]
}
{% endschema %}
<div class="hassle-free-support">
	<div class="section-container">
		  <div class="five-box">
			<div class="swiper-wrapper">
			  {% for block in section.blocks %}
				<div class="swiper-slide 
					{% if block.settings.features_style == 'half' %}half{% else %}full{% endif %}
				">
				   {% render 'responsive-image',
					  image: block.settings.pcItemImg,
					  mimage: block.settings.mbItemImg,
					  image_class: 'swiper-img'
				  %}  
				</div>
			  {% endfor %}
			</div>
		  </div>
	</div>
</div>
