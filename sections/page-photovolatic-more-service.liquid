{% assign slides = section.blocks | where: 'type', 'icon_item' %}

<section class="w-full flex-center bg-#F5F5F5 px-40 pt-100 pb-160 lg:px-0 lg:j-pt-50 lg:j-pb-80 xl:a-pt-50 xl:a-pb-80">
  <nav class="flex-between items-start flex-col lg:flex-row w-full rounded-24 gap-y-30 lg:j-w-1280 lg:j-rounded-12 lg:j-pt-45 lg:j-pb-25 xl:a-w-1280 xl:a-rounded-12 xl:a-pt-45 xl:a-pb-25 lg:bg-white">
      {% for block in slides %}
        <a href="{{ block.settings.url }}" class="group flex-1 flex-center flex-row rounded-24 pl-40 pr-80 py-30 gap-x-30 lg:flex-col lg:j-px-20 lg:py-0 lg:j-gap-y-30 xl:a-px-20 xl:a-gap-y-30 bg-white relative">
          <img class="w-160 h-160 lg:j-w-92 lg:j-h-92 xl:a-w-92 xl:a-h-92" src="{{ block.settings.icon_img | image_url: width: 92 }}" alt="" loading="lazy">
          <p class="group-hover:text-primary transition-all duration-300 flex-1 font-400 text-left text-#1A1A1A lg:text-center text-44 leading-64 lg:j-text-24 lg:j-leading-36 xl:a-text-24 xl:a-leading-36 line-clamp-2">
            {{ block.settings.text | newline_to_br }}
          </p>
          <jds-icon name="arrow-right" class="block lg:hidden absolute right-20 top-1/2 -translate-y-1/2 iconfont jackery-icon-arrow-right text-#1A1A1A" style="font-size:32px;"></jds-icon>
        </a>
      {% endfor %}
  </nav>
</section>

{% schema %}
  {
    "name": "photovolatic Service",
    "class": "section-photovolatic section-photovolatic-service",
    "blocks": [
      {
        "type": "icon_item",
        "name": "Icon item",
        "limit": 5,
        "settings": [
          {
            "type": "image_picker",
            "id": "icon_img",
            "label": "Icon Img"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Url"
          }
        ]
      }
    ]
  }
{% endschema %}

