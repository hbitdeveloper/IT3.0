{% if section.settings.empty_box_handle != empty %}
    <div class="embed-component" data-handle="{{ section.settings.empty_box_handle }}">
{% endif %}

{% content_for 'blocks' %}

{% if section.settings.empty_box_handle != empty %}
    </div>
{% endif %}


{% # theme-check-disable %}
{% schema %}
{
  "name": "V-订阅组件",
  "class": "section-subscribe-form",
  "tag": "section",
   "settings": [
     {
       "type": "text", "id": "empty_box_handle", "label": "空盒子Handle",
       "info": "请在空盒子版块中填写该Handle以嵌入此组件"
     }
   ],
   "blocks": [{
      "type": "subscribe-form"
    }],
   "presets": [
       {
           "name": "V-订阅组件",
           "category": "功能业务",
           "blocks": [
               {
                   "type": "subscribe-form",
                   "blocks": [
                        {
                            "type": "_subscribe-banner-form",
                            "blocks": [
                                {
                                    "type": "v-heading-content",
                                    "blocks": [
                                        {
                                            "type": "_v-heading-content-subheading",
                                            "settings": {
                                                "heading": "<p>Subscribe now for sales updates!</p>",
                                                "mb_heading": "<p>Subscribe now for sales updates!</p>",
                                                "text_color": "#FFFFFF",
                                                "heading_size": "heading_6",
                                                "padding_top": 0,
                                                "padding_bottom": 16,
                                                "alignment": "left",
                                            }
                                        }
                                    ],
                                    "settings": {
                                        "padding_top": 0,
                                        "padding_bottom": 0,
                                        "page_width": "w-full"
                                    }
                                }
                            ],
                            "settings": {
                                "bg_color": "",
                                "has_blur": false,
                                "component_name": "V-订阅组件"
                            }
                        }
                    ]
               },
               {
                    "type": "_subscribe-banner-modal",
                    "static": true,
                    "id": "subscribe-banner-modal",
                    "settings": {
                        "is_show": "form"
                    }
                }
           ]
       }
   ]
}
{% endschema %}
{% # theme-check-enable %}
