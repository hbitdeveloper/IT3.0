{% comment %} 多语言 片段 {% endcomment %}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}
{%- liquid
  assign scenes_raw = shop.metafields.custom.smartshop_scene_main.value
  assign scenes_list = scenes_raw
  if scenes_raw != blank
    if scenes_raw.data != blank
      assign scenes_list = scenes_raw.data
    endif
  endif
-%}
<div class="section-padding" 
  style="background: {{section.settings.bg_color}};{{style}}"
  {{ section.shopify_attributes }}
  {% if section.settings.anchor != blank %}
    anchor-target="{{section.settings.anchor | escape}}"
  {% endif %}
>
{% comment %} 智能选购 web-component {% endcomment %}
  <v5-help-you-choose
    compare-id="{{ section.settings.compare_id }}"
    coupon-id="{{ section.settings.coupon_id }}"
    open-auto-discount-price="{{settings.open_auto_discount_price}}"
  >
    <help-you-choose-step-usage style="display: block;">
      <div class="w-full step-usage">
        <div class="w-[20.9375rem] lg:w-[82.5rem] mx-auto mb-8 lg:mb-10">
          <h3 class="text-2xl lg:text-[2rem] text-[#242F20] font-bold leading-[1.2] text-center mb-4 lg:mb-6 step-title">{{ 'smart_recommend_5.step_usage.title' | t }}</h3>
          <div class="text-[0.875rem] lg:text-[1rem] leading-[1.2] text-[#242F20] text-center mb-8 lg:mb-10 step-desc">{{ 'smart_recommend_5.step_usage.desc' | t }}</div>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 step-content">
            {%- if scenes_list != blank -%}
              {%- for item in scenes_list -%}
                {%- liquid
                  assign scene_id = item.sceneMainId 
                  assign scene_name = item.sceneMainName | strip
                  assign scene_img = item.sceneMainImagePc  | strip | replace: '`', ''

                  assign loading = 'lazy'
                  assign fetchpriority = 'auto'
                  if section.index == 1
                    assign loading = 'eager'
                    assign fetchpriority = 'high'
                  endif
                -%}
                {%- if scene_id != blank and scene_name != blank and scene_img != blank -%}
                  <div class="w-full flex items-center justify-start flex-col cursor-pointer bg-[#fff] border-solid border-[#FFFFFF] border-2 lg:hover:border-[var(--jds-color-primary)] p-2 lg:p-4 group lg:hover:shadow-lg usage-item" data-value="{{ scene_id | escape }}">
                    <div class="w-full h-[6.75rem] lg:h-[13.125rem] flex items-center justify-center mb-4 lg:mb-6 relative overflow-hidden">
                      <img src="{{ scene_img | escape }}" alt="{{ scene_name | escape }}" class="w-full h-full object-contain relative z-[1]" loading="{{ loading }}" fetchpriority="{{ fetchpriority }}" decoding="async" width="1" height="1">
                    </div>
                    <div class="scene-main-name text-sm lg:text-xl text-[#242F20] font-bold text-center">{{ scene_name }}</div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
        <div class="w-full bg-white h-[4.375rem] lg:h-[6.25rem] relative before:content-[''] before:absolute before:-top-[1px] before:left-0 before:w-1/3 before:h-1 before:bg-[#242F20]">
          <div class="w-[20.9375rem] lg:w-[82.5rem] h-full flex items-center justify-end mx-auto">
            <button class="px-[1.125rem] py-3 lg:px-10 lg:py-4 text-[0.875rem] lg:text-[1.25rem] leading-[1.2] text-[#ffffff] font-semibold bg-[#A4A4A4] cursor-not-allowed opacity-50 next-step" disabled>{{ 'smart_recommend_5.common.next_button_text' | t }}</button>
          </div>
        </div>
      </div>
    </help-you-choose-step-usage>
  </v5-help-you-choose>
</div>
{% render 'v5-help-you-choose-json' %}

<script src="{{ 'section-v5-help-you-choose.min.js' | asset_url }}" defer></script>
{%- if section.settings.compare_id != blank -%}
  <v5-app-compare-modal 
    id="compareModal" 
    data-open-auto-discount-price="{{settings.open_auto_discount_price}}"
  ></v5-app-compare-modal>
  <script src="{{ 'snippet-v5-app-compare-modal.min.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
  {
    "name": "V5 智能选购",
    "limit": 1,
    "settings": [
      { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
      { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#F5F5F5" },
      { "type": "header", "content": "PC边距" },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "上边距",
        "default": 96
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "下边距",
        "default": 96
      },
      {
        "type": "range",
        "id": "padding_left",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "左边距",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "右边距",
        "default": 0
      },
      { "type": "header", "content": "MB边距" },
      {
        "type": "select",
        "id": "mb_padding_type",
        "label": "MB边距",
        "options": [
          { "value": "default", "label": "与PC一致" },
          { "value": "custom", "label": "单独配置" }
        ],
        "default": "custom"
      },
      {
        "type": "range",
        "id": "padding_top_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "上边距",
        "default": 24,
        "visible_if": "{{section.settings.mb_padding_type == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding_bottom_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "下边距",
        "default": 64,
        "visible_if": "{{section.settings.mb_padding_type == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding_left_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "左边距",
        "default": 0,
        "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding_right_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "右边距",
        "default": 0,
        "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
      },
      { "type": "text",
        "id": "compare_id",
        "label": "产品对比ID",
        "info": "【第3步】，可能会涉及到产品对比功能，产品对比ID需要在这里配置。不配置则无法使用产品对比功能。"
      }
    ],
    "presets": [
      {
        "name": "V5 智能选购",
        "category": "V5.0"
      }
    ]
  }
{% endschema %}
  
