{% assign slides = section.blocks | where: 'type', 'slide_item' %}

<section class="photovolatic-for-balcony-wrap w-full bg-white lg:bg-#F5F3EF flex-center flex-col p-40 lg:px-0 lg:j-pt-80 lg:j-pb-108">
    <h2 class="w-full text-center font-600 text-black lg:j-w-1280 xl:a-w-1280 text-48 leading-68 mb-24 lg:j-text-40 lg:j-leading-64 lg:j-mb-20 xl:a-text-40 xl:a-leading-64 xl:a-mb-20">
      {{ section.settings.title | newline_to_br }}
    </h2>
    <h3 class="w-full text-center font-400 text-#626262 text-32 leading-48 -mt-20 mb-40 lg:j-text-18 lg:j-leading-26 -lg:j-mt-15 lg:j-mb-30 xl:a-text-18 xl:a-leading-26 -xl:a-mt-15 xl:a-mb-30">
      {{ section.settings.sub_title | newline_to_br }}
    </h3>

    {% comment %} PC 端 Product Swiper {% endcomment %}
    <div
      class="!hidden swiper-left-right-wrap flex items-start justify-start lg:j-w-1280 lg:j-gap-x-20 xl:a-w-1280 xl:a-gap-x-20"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-delay="{{ section.settings.autoplay_delay }}"
      data-size="{{ slides.size }}"
    >
        <div class="swiper-thumbs-small-images lg:j-w-185 lg:j-h-562 xl:a-w-185 xl:a-h-562">
            <div class="swiper-wrapper w-full flex-col lg:j-gap-y-14 xl:a-gap-y-14">
              {% for block in slides %}
                <div class="swiper-slide flex-center flex-col border-transparent border-solid !lg:j-w-185 !lg:j-h-130 lg:j-rounded-12 lg:j-border-3 lg:j-px-10 lg:j-pt-10 !xl:a-w-185 !xl:a-h-130 xl:a-rounded-12 xl:a-border-3 xl:a-pt-10 xl:a-px-10 bg-white cursor-pointer">
                  <img class="lg:j-w-92 lg:j-h-64 xl:a-w-92 xl:a-h-64" src="{{ block.settings.icon | image_url: width: 200 }}" loading="lazy"/>
                  <h2 class="font-400 text-#666 lg:j-text-18 lg:j-leading-40 xl:a-text-18 xl:a-leading-40">{{ block.settings.heading | escape }}</h2>
                </div>
              {% endfor %}
            </div>
        </div>
        <div class="swiper swiper-main-content-images flex-1 lg:j-rounded-12 xl:a-rounded-12 {% if section.settings.show_product %} lg:j-pb-80 lg:j-h-642 xl:a-pb-80 xl:a-h-642 {% else %} lg:j-h-562 xl:a-h-562 {% endif %}">
            <div class="swiper-wrapper">
              {% for block in slides %}
                <div class="swiper-slide relative">
                  <div class="w-full h-full rounded-24 lg:j-rounded-12 xl:a-rounded-12 overflow-hidden relative">
                    {% comment %} image {% endcomment %}
                    {% render 'responsive-image',
                      image: block.settings.pc_img,
                      mimage: block.settings.mb_img,
                      image_class: 'w-full h-full block object-cover'
                    %}
                    <div class="absolute lg:j-left-50 lg:j-top-50 lg:j-w-627 xl:a-left-50 xl:a-top-50 xl:a-w-627">
                      <h2 class="font-600 text-white/90 lg:j-text-32 lg:j-leading-40 lg:j-mb-10 xl:a-text-32 xl:a-leading-40 xl:a-mb-10">{{ block.settings.heading | escape }}</h2>
                      <p class="font-500 text-white lg:j-text-16 lg:j-leading-24 xl:a-text-16 xl:a-leading-24">{{ block.settings.description | newline_to_br }}</p>
                    </div>
                  </div>

                  {%- if section.settings.show_product and block.settings.product.available == true -%}
                    {% assign variants = block.settings.product.variants %}
                    {% assign image = block.settings.product.featured_image %}
                    {% assign title = block.settings.product.title %}
                    {% assign price = blank %}
                    {% assign href = blank %}

                    {%- for variant in variants -%}
                      {% if variant.sku == block.settings.skuId and block.settings.skuId != blank %}
                        {% assign price = variant.price %}
                        {% if variant.featured_image != blank %}
                          {% assign image = variant.featured_image %}
                        {% endif %}
                        {% if variant.title != 'Default Title' %}
                          {% assign title = variant.title %}
                        {% endif %}
                        {% if variant.url != blank %}
                          {% assign href = variant.url %}
                        {% endif %}
                      {% endif %}
                    {%- endfor -%}

                    {% if price == blank %}
                      {% assign variantfirst = block.settings.product.variants | first %}
                      {% assign price = variantfirst.price %}
                      {% if variantfirst.featured_image != blank %}
                        {% assign image = variantfirst.featured_image %}
                      {% else %}
                        {% assign image = block.settings.product.featured_image %}
                      {% endif %}

                      {% if variantfirst.title != 'Default Title' %}
                        {% assign title = variant.title %}
                      {% else %}
                        {% assign title = block.settings.product.title %}
                      {% endif %}

                      {% if variantfirst.url != blank %}
                        {% assign href = variantfirst.url %}
                      {% endif %}
                    {% endif %}

                    {% comment %} 如果有配置，以配置的为准 {% endcomment %}
                    {% if block.settings.product_img != blank %}
                      {% assign image = block.settings.product_img %}
                    {% endif %}
                    {% if block.settings.product_title != blank %}
                      {% assign title = block.settings.product_title %}
                    {% endif %}

                    <div data-product class="flex flex-col absolute text-left lg:j-right-45 -lg:j-bottom-80 lg:j-rounded-br-64 lg:j-w-300 lg:j-min-h-350 xl:a-w-300 xl:a-min-h-350 xl:a-right-45 -xl:a-bottom-80 xl:a-rounded-br-64" style="background: {{ block.settings.product_bg }}">
                      <img class="mx-auto lg:j-my-20 lg:j-w-257 lg:j-h-183 xl:a-my-20 xl:a-w-257 xl:a-h-183 object-contain" src="{{ image | img_url: 'medium' }}" alt="">
                      <h2 class="w-full font-600 text-white/90 lg:j-px-20 lg:j-text-20 lg:j-leading-24 xl:a-px-20 xl:a-text-20 xl:a-leading-24 line-clamp-2">{{ title | newline_to_br }}</h2>
                      {% if block.settings.show_product_price %}
                        <p class="w-full font-400 text-white/90 lg:j-pl-30 lg:j-text-24 lg:j-leading-28 lg:j-mt-15 xl:a-pl-30 xl:a-text-24 xl:a-leading-28 xl:a-mt-15">{{ price | money }}</p>
                      {% endif %}
                      {% if block.settings.product_button_text != blank %}
                        <a
                          href="{{ href }}"
                          class="appearance-none flex bg-transparent font-600 text-white/90 lg:j-my-20 lg:j-text-24 lg:j-leading-40 lg:j-pl-30 xl:a-my-20 xl:a-text-24 xl:a-leading-40 xl:a-pl-30"
                          data-for-balcony-link
                          data-section-title="{{ section.settings.title | escape }}"
                          data-product-title="{{ title | escape }}"
                          data-button-text="{{ block.settings.product_button_text | escape }}"
                          data-button-link="{{ href }}"
                        >
                          {{ block.settings.product_button_text | escape }}
                          <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right lg:j-text-24 lg:j-leading-40 xl:a-text-24 xl:a-leading-40"></jds-icon>
                        </a>
                      {% endif %}
                    </div>
                  {%-endif -%}
                </div>
              {% endfor %}
            </div>
        </div>
    </div>

    {% comment %} MB 端 Product Swiper {% endcomment %}
    <div class="hidden w-full swiper swiper-main-content-mb">
        <div class="swiper-wrapper">
          {% for block in slides %}
            <div class="swiper-slide">
                <div class="w-full {% if section.settings.show_product and block.settings.product.available == true %} h-760 {% else %} h-600 {% endif %} relative">
                    {% comment %} image {% endcomment %}
                    <picture>
                      <source media="(min-width:1024px)" srcset="{{ block.settings.pc_img | image_url: width: 1920 }}">
                      <img
                        class="w-full h-600 object-cover block"
                        src="{{ block.settings.mb_img | image_url: width: 750 }}"
                        alt=""
                        loading="lazy"
                      >
                    </picture>
                    {%- if section.settings.show_product and block.settings.product.available == true -%}
                      {% assign variants = block.settings.product.variants %}
                      {% assign image = block.settings.product.featured_image %}
                      {% assign title = block.settings.product.title %}
                      {% assign price = blank %}
                      {% assign href = blank %}

                      {%- for variant in variants -%}
                        {% if variant.sku == block.settings.skuId and block.settings.skuId != blank %}
                          {% assign price = variant.price %}
                          {% if variant.featured_image != blank %}
                            {% assign image = variant.featured_image %}
                          {% endif %}
                          {% if variant.title != 'Default Title' %}
                            {% assign title = variant.title %}
                          {% endif %}
                          {% if variant.url != blank %}
                            {% assign href = variant.url %}
                          {% endif %}
                        {% endif %}
                      {%- endfor -%}

                      {% if price == blank %}
                        {% assign variantfirst = block.settings.product.variants | first %}
                        {% assign price = variantfirst.price %}
                        {% if variantfirst.featured_image != blank %}
                          {% assign image = variantfirst.featured_image %}
                        {% else %}
                          {% assign image = block.settings.product.featured_image %}
                        {% endif %}

                        {% if variantfirst.title != 'Default Title' %}
                          {% assign title = variant.title %}
                        {% else %}
                          {% assign title = block.settings.product.title %}
                        {% endif %}

                        {% if variantfirst.url != blank %}
                          {% assign href = variantfirst.url %}
                        {% endif %}
                      {% endif %}

                      {% comment %} 如果有配置，以配置的为准 {% endcomment %}
                      {% if block.settings.product_img != blank %}
                        {% assign image = block.settings.product_img %}
                      {% endif %}
                      {% if block.settings.product_title != blank %}
                        {% assign title = block.settings.product_title %}
                      {% endif %}

                      <div class="w-full h-320 bg-primary absolute left-0 bottom-0 rounded-br-96 flex-start gap-x-60 pl-40 pr-20" style="background: {{ block.settings.product_bg }}">
                        <img class="w-236 h-254 object-contain" src="{{ image | img_url: 'medium' }}" alt="">
                        <div class="flex flex-col items-start">
                            <h2 class="font-600 text-left text-32 leading-40 text-white line-clamp-3">{{ title | newline_to_br }}</h2>
                            {% if block.settings.show_product_price %}
                              <p class="font-400 text-36 leading-80 text-white">{{ price | money }}</p>
                            {% endif %}
                            {% if block.settings.product_button_text != blank %}
                              <a
                                href="{{ href }}"
                                class="appearance-none flex bg-transparent font-600 text-40 leading-80 text-white"
                                data-for-balcony-link
                                data-section-title="{{ section.settings.title | escape }}"
                                data-product-title="{{ title | escape }}"
                                data-button-text="{{ block.settings.product_button_text | escape }}"
                                data-button-link="{{ href }}"
                              >
                                {{ block.settings.product_button_text | escape }}
                                <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-40 leading-80"></jds-icon>
                              </a>
                            {% endif %}
                        </div>
                      </div>
                    {%- endif -%}
                </div>
                <h2 class="font-bold text-40 leading-80 mt-30">{{ block.settings.heading | escape }}</h2>
                <p class="w-full text-32 leading-44 text-left">{{ block.settings.description | newline_to_br }}</p>
            </div>
          {% endfor %}
        </div>
        <div class="swiper-pagination swiper-photovolatic-pagination"></div>
        <div class="swiper-button-next swiper-photovolatic-button-next"></div>
        <div class="swiper-button-prev swiper-photovolatic-button-prev"></div>
    </div>
</section>

{% schema %}
  {
    "name": "photovolatic For Balcony",
    "class": "section-photovolatic section-photovolatic-for-balcony",
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "textarea",
        "id": "sub_title",
        "label": "Sub Title"
      },
      {
        "type": "checkbox",
        "id": "show_product",
        "label": "Show Product",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Auto Play",
        "default": true
      },
      {
        "type": "range",
        "id": "autoplay_delay",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "s",
        "label": "Auto Play Delay",
        "default": 3
      }
    ],
    "blocks": [
      {
        "type": "slide_item",
        "name": "Slide item",
        "limit": 4,
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon",
            "info": "请上传高亮颜色的 ICON"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description"
          },
          {
            "type": "image_picker",
            "id": "pc_img",
            "label": "PC Image"
          },
          {
            "type": "image_picker",
            "id": "mb_img",
            "label": "Mobile Image"
          },
          {
            "type": "color",
            "id": "product_bg",
            "label": "Product Background Color",
            "default": "#fd5000"
          },
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          },
          {
            "type": "text",
            "id": "skuId",
            "label": "Product Sku *"
          },
          {
            "type": "image_picker",
            "id": "product_img",
            "label": "Product Image"
          },
          {
            "type": "textarea",
            "id": "product_title",
            "label": "Product Title"
          },
          {
            "type": "checkbox",
            "id": "show_product_price",
            "label": "Show Product Price",
            "default": true
          },
          {
            "type": "text",
            "id": "product_button_text",
            "label": "Product Button Text"
          }
        ]
      }
    ]
  }
{% endschema %}
