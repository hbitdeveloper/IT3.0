{% comment %} 日本防灾日 dp-region-one组件 {% endcomment %}
{% schema %}
{
  "name": "DP Region One",
  "tag": "section",
  "class": "dp-region-one",
  "settings": [
    {
      "type": "image_picker",
      "id": "titleImgPC",
      "label": "Title Image(PC)"
    },
    {
      "type": "image_picker",
      "id": "titleImgMB",
      "label": "Title Image(MB)"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "name": "Region Item",
      "type": "slide",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "image_picker",
          "id": "imagePC",
          "label": "Image(PC)"
        },
        {
          "type": "image_picker",
          "id": "imageMB",
          "label": "Image(MB)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ]
}
{% endschema %}

<div class="dp-region-one-box">
  <div class="region-section">
    <div class="region-title  dp-animation">
      {% render 'responsive-image', image: section.settings.titleImgPC,width: 1000, mimage: section.settings.titleImgMB %}
    </div>
    <div class="dp-content  dp-animation">
      <div class="content-title  dp-animation">
        {% for block in section.blocks %}
          <div class="title box-shadow">{{ block.settings.title }}</div>
        {% endfor %}
      </div>
      <div class="content-img box-shadow">
        <div class="img-box  dp-animation">
          {% for block in section.blocks %}
            {% render 'responsive-image', image: block.settings.imagePC,width: 411, mimage: section.settings.imageMB %}
          {% endfor %}
        </div>
      </div>
      <div class="content-des  dp-animation">
        {% for block in section.blocks %}
          <div class="des-box">
            {{ block.settings.description }}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="region-section-mb">
    <div class="region-title  dp-animation">
      <img
        class="scenes-img lazy"
        src="{{ section.settings.titleImgMB | image_url: width: 750 }}"
        alt="{{ section.settings.titleImgMB.alt | escape }}"
      >
    </div>

    {% for block in section.blocks %}
      <div class="item-content  dp-animation">
        <div class="item-title box-shadow">{{ block.settings.title }}</div>
        <div class="item-box  box-shadow">
          <div class="item-img">
            <img
              class="scenes-img lazy"
              src="{{ block.settings.imageMB | image_url: width: 750 }}"
              alt="{{ block.settings.imageMB.alt | escape }}"
            >
          </div>
          <div class="item-des">
            {{ block.settings.description }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
