
<div {{ block.shopify_attributes }} class="section-container-lg mx-auto h-[3.25rem] px-2 lg:h-11 lg:px-0 flex items-center justify-start gap-2.5" collection="{{ collection.handle }}">
  <a href="/" class="text-[#242F20] text-xs lg:text-base underline-offset-4 hover:underline">{{ section.settings.home_text | escape }}</a><span>/</span>
  <a href="/collections/all" class="text-[#242F20] {% if collection.handle != 'all' %} underline-offset-4 hover:underline {% endif %} text-xs lg:text-base">{{ section.settings.all_product_text | escape }}</a>
  {% if collection.handle != 'all' %}<span>/</span><span class="text-[#242F20] text-xs lg:text-base">{{ collection.title }}</span>{% endif %}
</div>

{% schema %}
{
  "name": "V5-集合页-面包屑",
  "class": "section section-collection__breadcrumbs",
  "enabled_on": {
    "templates": ["collection"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "home_text",
      "label": "首页文案",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "all_product_text",
      "label": "所有产品文案",
      "default": "Shop All"
    }
  ],
  "presets": [
    {
      "name": "V5-集合页-面包屑"
    }
  ]
}
{% endschema %}
