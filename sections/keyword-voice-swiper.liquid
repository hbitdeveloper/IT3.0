{%- style -%}
  .section-keyword-voice {
    padding-bottom: 4.0625vw;
  }

  .index-voice {
    width: 100%;
    max-height: 720px;
    height: 44vw;
    padding: 5vw 0 0 39vw;
  }
  .voice-banner {
    background: #f0f0f0;
  }

  .index-voice .slideshow-pagination-item.active .pagination-separator {
    background: var(--primary-color);
  }
  .voice-banner .voice-image-swiper-container {
    height: 100%;
    width: 50%;
  }
  .index-voice-title {
    padding: 0 6.77vw 30px 14vw;
    background: transparent;
  }
  .voice-list-swiper-container .swiper-slide {
    padding-right: 1.35417vw;
    width: 25.2vw;
  }
  .voice-list-swiper-container .swiper-slide .container {
    background: #fff;
    padding: 1.904vw;
  }
  .voice-list-swiper-container .swiper-slide-active .container {
    background: var(--primary-color);
  }
  .voice-item-title {
    margin: 10px 0 12px 0;
    color: #333333;
  }

  .vocie-item-content {
    color: #333333;
    line-height: 1.04;
  }
  .voice-list-swiper-container {
    border-radius: 3.744vw 0px 0px 0px;
  }
  .voice-list-swiper-container .swiper-slide-active .vocie-item-content,
  .swiper-slide-active .voice-item-title {
    color: #fff;
  }
  .voice-list-swiper-container .vocie-item-content {
    -webkit-line-clamp: 5;
    line-height: 1.22;
  }

  .comments-all-active .vocie-item-content {
    -webkit-line-clamp: 9;
  }
  .voice-content-all {
    opacity: 0;
    pointer-events: none;
    margin: 6px 0;
  }
  .voice-content-all .jackery-icon-arrow-right {
    display: inline-block;
    transform: rotate(90deg);
    color: #fff;
    transition: all 0.3s;
    cursor: pointer;
    font-size: 22px;
  }
  .comments-all-active .voice-content-all .jackery-icon-arrow-right {
    transform: rotate(270deg);
  }
  .swiper-slide-active .voice-content-all {
    pointer-events: all;
    opacity: 1;
  }
  .voice-user .user-avator .renzheng {
    width: 18px;
    height: 18px;
  }
  .voice-user .user-avator .avator {
    height: 48px;
    width: 48px;
    object-fit: cover;
  }
  .voice-user .user-name {
    color: #333;
    margin-left: 0.67vw;
  }
  .swiper-slide-active .voice-user .user-name {
    color: #fff;
  }
  .index-voice .pagination-navigation {
    padding-left: 13vw;
    margin-top: 28px;
  }
  .slideshow-pagination-voice {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    transition: opacity 0.3s;
    width: max-content;
    z-index: 1;
  }
  .index-voice .pagination-navigation .slideshow-navigation-button {
    position: relative;
    opacity: 1;
  }
  .index-voice .pagination-navigation .slideshow-navigation-button.next {
    right: 0;
    margin-left: 2.4vw;
  }
  .index-voice .pagination-navigation .slideshow-navigation-button.prev {
    left: 0;
  }
  .index-voice .pagination-navigation .slideshow-navigation-button .iconfont {
    font-size: 2.5vw;
    width: 2.5vw;
    height: 2.5vw;
  }
  .index-voice .pagination-navigation .slideshow-navigation {
    margin-left: 8vw;
  }

  .vocie-banner {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .voice-pointer {
    left: 27.70833vw;
    // top: 32.03125vw;
  }
  .index-voice .voice-pointer-m {
    display: none;
  }
  .index-voice .voice-pointer-p {
    display: flex;
  }
  .voice-pointer img {
    width: 1.82292vw;
    height: 1.82292vw;
    margin-right: 0.78125vw;
  }
  .voice-pointer-title {
    line-height: 1.45833vw;
    color: #fff;
  }

  .clearfix:after {
    content: ' ';
    display: block;
    height: 0;
    font-size: 0;
    clear: both;
    visibility: hidden;
  }

  .rate {
    float: left;
    height: 1.4vw;
    line-height: 1.4vw;
  }

  .rate > label {
    color: #ccc;
    cursor: pointer;
    float: right;
    font-size: 1.4vw;
    margin-right: 0.52vw;
    overflow: hidden;
    white-space: nowrap;
    width: 1.4vw;
  }

  .rate > label::before {
    content: '\ea29';
    font-family: 'iconfont';
  }

  .rate > label.checked ~ label,
  .rate > label.checked {
    color: #ffc700;
  }

  .section-keyword-voice .swiper-thumbs .swiper-slide{
    padding-right: 0px !important;
  }

  .section-keyword-voice .swiper-thumbs .swiper-slide:last-child {
    padding-right: 0px !important;
  }

  .section-keyword-voice .swiper-thumbs {
    border-bottom: none;
    padding-bottom: 0px !important;
    margin-bottom: 0 !important;
  }
  @media screen and (max-width: 768px) {
    .section-keyword-voice{
      padding-bottom: 9.3333vw;
    }
    .index-voice {
      height: auto;
      margin-bottom: 14vw;
      padding: 78.26667vw 0 0 8vw;
    }
    .voice-banner {
      bottom: unset;
    }
    .index-voice-title {
      padding: 0;
      margin: 0 auto 5.66667vw auto;
      font-weight: 500;
    }
    .voice-banner .voice-image-swiper-container {
      height: 100%;
      width: 100%;
    }
    .voice-list-swiper-container .swiper-slide {
      padding-right: 3.2vw;
      width: 84.13333vw;
      box-shadow: 0px 1px 9px 5px rgba(98, 98, 98, 0.14);
    }
    .voice-list-swiper-container .swiper-slide-active {
      box-shadow: none;
    }
    .voice-list-swiper-container .swiper-slide .container {
      padding: 6.13333vw 4.26667vw;
    }
    .voice-item-title {
      margin: 1.33333vw 0 2.4vw 0;
    }
    .vocie-item-content {
      // min-height: 16.5vw;
    }

    .comments-all-active .vocie-item-content {
      -webkit-line-clamp: 99;
    }
    .voice-content-all {
      margin: 2.66667vw 0;
    }
    .voice-user .user-avator .renzheng {
      width: 3.2vw;
      height: 3.2vw;
    }
    .voice-user .user-avator .avator {
      height: 10.26667vw;
      width: 10.26667vw;
    }
    .voice-user .user-name {
      margin-left: 1.73333vw;
      font-weight: 500;
      font-size: 3.8vw;
    }
    .index-voice .pagination-navigation {
      padding-left: 0;
      margin-top: 8.66667vw;
      justify-content: center;
    }
    .index-voice .pagination-navigation .slideshow-navigation {
      display: none;
    }
    .voice-pointer {
      left: 27.70833vw;
      top: unset;
    }
    .voice-pointer img {
      width: 4vw;
      height: 4vw;
      margin-right: 1.73333vw;
    }
    .voice-pointer-title {
      line-height: 3.73333vw;
      color: #333;
    }
    .voice-list-swiper-container {
      border-radius: 12vw 0px 0px 0px;
    }
    .rate {
      height: 4vw;
      line-height: 4vw;
    }

    .rate > label {
      font-size: 4vw;
      margin-right: 1.33333vw;
      width: 4vw;
    }
    .index-voice .voice-pointer-m {
      display: flex;
      height: max-content;
    }
    .index-voice .voice-pointer-p {
      display: none;
    }
  }

  .index-voice-title {
    margin-top: calc(var(--pc-margin-top) * 1px);
    margin-bottom: calc(var(--pc-margin-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .index-voice-title {
      margin-top: calc(var(--pc-margin-top) * 100vw / 1440);
      margin-bottom: calc(var(--pc-margin-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .index-voice-title {
      margin-top: calc(var(--mb-margin-top) * 100vw / 750);
      margin-bottom: calc(var(--mb-margin-bottom) * 100vw / 750);
    }
  }
{%- endstyle -%}
<section class="index-voice-section" anchor="{{ section.settings.anchor | escape }}">
  <div class="index-voice-title jky-text-2xl text-center mobile-block">
    {{ section.settings.title | escape }}
  </div>

  <div class="index-voice relative">
    <div class="voice-banner absolute left-0 right-0 bottom-0 top-0 flex">
      <div class="voice-image-swiper-container" style="overflow-x: hidden;">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide relative">
              {% render 'responsive-image',
                image: block.settings.image,
                mimage: block.settings.image,
                image_class: 'vocie-banner'
              %}

              <a
                href="{{ block.settings.p_link }}"
                class="voice-pointer voice-pointer-p flex absolute items-center"
                style="bottom: {{ block.settings.pc_y }}vw;left: {{ block.settings.pc_x }}vw;"
              >
                <img
                  src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_2x_0cdd2b58-1c28-427e-af1b-b68c5f8df76d.png?v=1670312292"
                  alt="{{ block.settings.p_name }}" loading="lazy"
                >

                <div class="voice-pointer-title jky-text-sm font-300" style="color: {{block.settings.p_name_color}}">
                  {{ block.settings.p_name | newline_to_br }}
                </div>
              </a>

              <a
                href="{{ block.settings.p_link }}"
                class="voice-pointer voice-pointer-m flex absolute items-center"
                style="bottom: {{ block.settings.m_y }}vw;left: {{ block.settings.m_x }}vw;"
              >
                <img
                  src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_2x_0cdd2b58-1c28-427e-af1b-b68c5f8df76d.png?v=1670312292"
                  alt="{{block.settings.p_name}}" loading="lazy"
                >

                <div class="voice-pointer-title jky-text-sm font-300" style="color: {{block.settings.p_name_color}}">
                  {{ block.settings.p_name | newline_to_br }}
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="voice-list-container relative">
      <h2 class="index-voice-title jky-text-2xl pc-block text-overflow-1 font-bold"
      style="
      --pc-margin-bottom:{{ section.settings.pc_margin_bottom }};--mb-margin-bottom:{{ section.settings.mb_margin_bottom }};
      --pc-margin-top:{{ section.settings.pc_margin_top }};--mb-margin-top:{{ section.settings.mb_margin_top }};
      "
      >
        {{ section.settings.title | escape }}
      </h2>
      {%- if section.settings.sub != blank -%}
       <div class="keyword-voice-sub keyword-sub">{{ section.settings.sub }}</div>
      {%- endif -%}
      <div class="voice-list-swiper-container swiper">
        <div class="swiper-wrapper flex">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="container">
                <div class="clearfix">
                  <div class="rate">
                    <label
                      title="5.0"
                      rate="5"
                      {% if block.settings.rating == 5 %}
                        class="checked"
                      {% endif %}
                    ></label>
                    <label
                      title="4.0"
                      rate="4"
                      {% if block.settings.rating == 4 %}
                        class="checked"
                      {% endif %}
                    ></label>
                    <label
                      title="3.0"
                      rate="3"
                      {% if block.settings.rating == 3 %}
                        class="checked"
                      {% endif %}
                    ></label>
                    <label
                      title="2.0"
                      rate="2"
                      {% if block.settings.rating == 2 %}
                        class="checked"
                      {% endif %}
                    ></label>
                    <label
                      title="1.0"
                      rate="1"
                      {% if block.settings.rating == 1 %}
                        class="checked"
                      {% endif %}
                    ></label>
                  </div>
                </div>

                <div class="voice-item-title jky-text-sm font-400">{{ block.settings.review_title | escape }}</div>
                <div class="vocie-item-content jky-text-sm font-400 text-overflow-3">
                  {{ block.settings.user_comment | escape }}
                </div>

                <div class="voice-content-all text-center relative">
                  <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-sm font-400"></jds-icon>
                </div>

                <div class="voice-user flex items-center">
                  <div class="user-avator relative">
                    <img
                      src="{{block.settings.user_avator | image_url: width: 77}}"
                      alt="{{block.settings.user_name}}" loading="lazy"
                    >

                    <img
                      class="renzheng absolute bottom-0 right-0"
                      src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_1_2x_f1b3030c-8c66-4b42-bb45-620ff89a90a2.png?v=1670307826"
                      alt="renzheng" loading="lazy"
                    >
                  </div>
                  <div class="user-name jky-text-sm font-bold">{{ block.settings.user_name }}</div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="pagination-navigation flex">
        <div class="slideshow-pagination-voice"></div>

        <div class="slideshow-navigation flex">
          <div class="slideshow-navigation-button prev" style="z-index: 1;">
            {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
          </div>
          <div class="slideshow-navigation-button next" style="z-index: 1;">
            {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Voice swiper",
  "class": "section-keyword-voice",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },  
  { "type": "text", "id": "title", "label": "Section title", "default": "Voice from Our Custo" }, { "type": "richtext", "id": "sub", "label": "Section subtitle" },
  { "type": "number", "id": "pc_margin_top", "label": "上边距PC" },
  { "type": "number", "id": "pc_margin_bottom", "label": "下边距PC", "default": 40 },
  { "type": "number", "id": "mb_margin_top", "label": "上边距MB" },
  { "type": "number", "id": "mb_margin_bottom", "label": "下边距MB", "default": 48 }
],
  "blocks": [
    {
      "type": "image",
      "name": "Slide Voice",
      "settings": [
        { "type": "textarea", "id": "p_name", "label": "Product name" },
        { "type": "color", "id": "p_name_color", "label": "Product name color", "default": "#ffffff" },
        { "type": "url", "id": "p_link", "label": "Product link" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 4, "label": "Review Rating" },
        { "type": "textarea", "id": "review_title", "label": "Review title" },
        { "type": "textarea", "id": "user_comment", "label": "User comment" },
        { "type": "text", "id": "user_name", "label": "User name" },
        { "type": "image_picker", "id": "user_avator", "label": "User avator" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "pc_x", "min": 0, "max": 50, "step": 1, "default": 28, "label": "PC position x" },
        { "type": "range", "id": "pc_y", "min": 0, "max": 50, "step": 1, "default": 14, "label": "PC position y" },
        { "type": "range", "id": "m_x", "min": 0, "max": 100, "step": 1, "default": 63, "label": "Mobile position x" },
        { "type": "range", "id": "m_y", "min": 0, "max": 50, "step": 1, "default": 37, "label": "Mobile position y" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keyword Voice swiper",
      "category": "Keyword"
    }
  ]
}
{% endschema %}

<script type="module">
  class IndexVoiceSwiper {
    constructor(el) {
      this.DOM = {
        el: el.el,
        swiperContainer: el.swiperContainer,
        thumbs: el.thumbs,
      };
      this.init();
    }
    init() {
      const self = this;
      this.imgSwiper = new Swiper(this.DOM.thumbs, {
        loop: true,
        effect: 'fade',
        allowTouchMove: false,
      });
      this.swiper = new Swiper(this.DOM.swiperContainer, {
        slidesPerView: 'auto',
        spaceBetween: 0,
        loop: true,
        followFinger: false,
        on: {
          transitionEnd: function () {
            let slide = this.slides.eq(this.activeIndex);
            self.reSetCommentStatus();
          },
          resize: function () {
            setTimeout(() => {
              this.update();
            }, 500);
          },
        },
        navigation: {
          nextEl: `${this.DOM.el} .slideshow-navigation-button.next`,
          prevEl: `${this.DOM.el} .slideshow-navigation-button.prev`,
        },
        thumbs: {
          swiper: this.imgSwiper,
        },
        pagination: {
          el: `${this.DOM.el} .slideshow-pagination-voice`,
          clickable: true,
          bulletClass: 'slideshow-pagination-item',
          bulletActiveClass: 'active pagination-active',
          clickableClass: 'slideshow-pagination-clickable',
          modifierClass: 'slideshow-pagination-',
          renderBullet: function (index, className) {
            var slideIndex = index,
              number = index <= 8 ? '0' + (slideIndex + 1) : slideIndex + 1;

            var paginationItem = '<span class="slideshow-pagination-item">';
            paginationItem =
              index <= 8
                ? paginationItem +
                  '<span class="pagination-separator"><span class="pagination-separator-loader"></span></span>'
                : paginationItem;
            paginationItem += '</span>';
            return paginationItem;
          },
        },
      });

      this.initEvents();
    }
    initEvents() {
      const selectors = {
        slides: document.querySelectorAll(`${this.DOM.swiperContainer} .swiper-slide`),
      };

      selectors.slides.forEach((slide) => {
        const _btn = slide.querySelector('.voice-content-all');
        _btn.addEventListener('click', (e) => {
          e.stopPropagation();
          slide.classList.toggle('comments-all-active');
        });
      });
    }
    reSetCommentStatus() {
      const selectors = {
        slides: document.querySelectorAll(`${this.DOM.swiperContainer} .swiper-slide`),
      };
      selectors.slides.forEach((slide) => {
        slide.classList.remove('comments-all-active');
      });
    }
  }

  window.addEventListener('DOMContentLoaded', function () {
    new IndexVoiceSwiper({
      swiperContainer: '.voice-list-swiper-container',
      el: '.index-voice',
      thumbs: '.voice-image-swiper-container',
    });
  });
</script>
