
{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
  class="blocks-tabs-blocks"
  style="background: {{section.settings.bg_color | default: 'transparent' }};"
>
  <div class="section-padding {{section.settings.page_width}}" style="{{ style }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
  {
    "name": "V5品类教育页-家庭用电场景",
    "class": "section-v-tabs-blocks",
    "tag": "section",
    "settings": [
      { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
      {
        "type": "select",
        "id": "page_width",
        "options": [
          {
            "value": "section-container",
            "label": "版心/1200px"
          },
          {
            "value": "section-container-lg",
            "label": "大版心/1320px"
          },
          {
            "value": "w-full",
            "label": "铺满/100%"
          }
        ],
        "default": "w-full",
        "label": "组件宽度",
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#FFFFFF" },

      { "type": "header", "content": "PC边距", "visible_if": "{{ settings.customize_vcomponents == true }}" },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "上边距",
        "default": 36,
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "下边距",
        "default": 36,
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      {
        "type": "range",
        "id": "padding_left",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "左边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      {
        "type": "range",
        "id": "padding_right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "右边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },

      { "type": "header", "content": "MB边距", "visible_if": "{{ settings.customize_vcomponents == true }}" },
      {
        "type": "select",
        "id": "mb_padding_type",
        "options": [
          {
            "value": "default",
            "label": "默认"
          },
          {
            "value": "custom",
            "label": "自定义"
          }
        ],
        "default": "default",
        "label": "MB边距",
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      {
        "type": "range",
        "id": "padding_top_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "上边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true and section.settings.mb_padding_type == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding_bottom_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "下边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true and section.settings.mb_padding_type == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding_left_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "左边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true and section.settings.mb_padding_type == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding_right_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "右边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true and section.settings.mb_padding_type == 'custom' }}"
      }
    ],
    "blocks": [{ "type": "v-heading-content" }, { "type": "_tab-wrap" }],
    "presets": [
