<div class="olight-game" anchor="{{ section.settings.anchor | escape }}">
    {% render 'new-title',  class: 'sence-title game-title', title: section.settings.title, type: section.settings.type, bgColor: section.settings.background %}
    <div>{{ section.settings.liquid }}</div>
  </div>
  
  {% schema %}
  {
    "name": "Olight Game",
    "settings": [
      { "type": "text", "id": "anchor", "label": "二级标题定位锚点" },
      { "type": "text", "id": "title", "label": "标题" },
      { "type": "color", "id": "background", "label": "标题背景色", "default": "#DBEEF9" },
      { "type": "select", "id": "type", "label": "标题类型",
        "options": [
          { "value": "1", "label": "小档" },
          { "value": "2", "label": "大档" }
        ],
        "default": "1"
      },
      { "type": "liquid", "id": "liquid", "label": "自定义Liquid" }
    ]
  }
  {% endschema %}
  