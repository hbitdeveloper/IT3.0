<div class="index-scene-education" data-new-header="true" anchor="{{ section.settings.anchor | escape }}">
    <div class="new-main-container">
        <div class="scene-education">
            <div class="title"><span class="jky-slideup">{{ section.settings.module_title | escape }}</span></div>
            <div class="box">
                {% for item in section.blocks %}
                <a
                    data-ga-event="home_page_scenario_introduction4.0"
                    data-ga-action="click"
                    data-ga-params-module="{{ section.settings.module_title | escape }}"
                    data-ga-params-position="{{ item.settings.title | escape }}"
                    data-ga-params-link="{{ item.settings.url }}"
                    data-ga-params-type="Scenario Introduction"

                    class="content" target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ item.settings.url }}">
                    <div class="content-image" >
                        {%- render 'responsive-image' image: item.settings.image, width: 300, mwidth: 166 -%}
                        <div class="index-arrow">
                            <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                        <g transform="translate(672.000000, 286.000000)">
                                            <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                        </g>
                                    </g>
                                </g>
                            </svg>
                        </div>

                    </div>
                    <div class="content-title line-clamp-2">{{ item.settings.title | escape}}</div>
                </a>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "首页-场景教育",
        "disabled_on": {
            "templates": ["collection"]
        },
        "settings": [
            { "type": "text", "id": "anchor", "label": "二级标题定位锚点", "info": "搭配二级导航锚点定位未使用到定位则不配置" },
            { "type": "text", "id": "module_title", "label": "模块标题(必填)" },
            { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false }
        ],
        "blocks": [
            {
                "type": "block",
                "name": "场景教育",
                "settings": [
                    { "type": "text", "id": "title", "label": "标题(必填)" },
                    { "type": "url", "id": "url", "label": "跳转地址(必填)" },
                    { "type": "image_picker", "id": "image", "label": "图片(必填)", "info": "大小: 300x300"}
                ]
            }
        ],
        "presets": [
            {
                "name": "首页-场景教育",
                "settings": {
                    "module_title": "Explore Infinite Potential with Us",
                    "new_window": false
                },
                "blocks": [
                    {
                        "type": "block",
                        "settings": {
                            "title": "Camping"
                        }

                    }
                ]
            }
        ]
    }
{% endschema %}
