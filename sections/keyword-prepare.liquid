{%- style -%}
  .section-keyword-prepare {
    padding-bottom: 6.3021vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }
  .section-keyword-prepare .keyword-prepare-title {
    font-size: 2.3438vw;
    font-weight: 600;
    color: #000000;
    padding-bottom: 2.9688vw;
    display: flex;
    justify-content: center;
  }
  .section-keyword-prepare .keyword-prepare-tab {
    display: flex;
    justify-content: center;
    flex-direction: column;
  }

  .section-keyword-prepare .keyword-prepare-tab .children {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
  }

  .section-keyword-prepare .keyword-prepare-tab .children .tab {
    text-align: center;
    padding-top: 0.625vw;
    padding-bottom: 0.625vw;
    margin-right: 0.6771vw;
    cursor: pointer;
    font-size: 1.5625vw;
    font-weight: 500;
    color: #333333;
    border-bottom: 0.2604vw solid #e3e3e3;
  }

  .section-keyword-prepare .keyword-prepare-tab .children .tab-active {
    border-bottom: 0.2604vw solid var(--primary-color);
    color: var(--primary-color);
  }

  .section-keyword-prepare .keyword-prepare-tab .children .tab-with-3 {
    width: calc(33.333% - 0.6771vw);
  }

  .section-keyword-prepare .keyword-prepare-tab .children .tab-with-2 {
    width: calc(50% - 0.6771vw);
  }

  .section-keyword-prepare .keyword-prepare-tab .children .tab-with-4 {
    width: calc(25% - 0.6771vw);
  }

  .section-keyword-prepare .prepare-swiper-main {
    width: 74.7396vw;
  }

  .section-keyword-prepare .prepare-swiper-main .content {
    display: flex;
    margin-top: 2.6042vw;
    height: 26.0417vw;
  }

  .section-keyword-prepare .prepare-swiper-main .content div.title {
    display: flex;
    align-items: center;
    padding: 0 4.7396vw;
    font-size: 1.25vw;
    font-weight: 500;
    color: #ffffff;
    line-height: 2vw;
    width: 33.0729vw;
    word-break: break-word;
  }

  .section-keyword-prepare .prepare-swiper-main .content .image {
    display: flex;
    flex: 1;
  }

  .section-keyword-prepare .prepare-swiper-main .content .image img {
    width: 100%;
  }
  @media screen and (max-width: 768px) {
    .section-keyword-prepare {
      max-width: 100%;
      margin: 0;
    }

    .section-keyword-collection-anchor .sticky {
      display: block;
    }

    .section-keyword-prepare .keyword-prepare-title {
      font-size: 6vw;
    }

    .section-keyword-prepare .keyword-prepare-tab .children .tab {
      font-size: 3.2vw;
      padding-top: 1.3333vw;
      padding-right: 1.3333vw;
      font-weight: 600;
    }

    .section-keyword-prepare .keyword-prepare-tab .children .tab .red-line {
      margin-top: 1.8667vw;
    }

    .section-keyword-prepare .prepare-swiper-main {
      width: 100%;
    }

    .section-keyword-prepare .prepare-swiper-main .content {
      flex-direction: column;
      margin-top: 3.7333vw;
      height: 104.1333vw;
    }

    .section-keyword-prepare .prepare-swiper-main .content div.title {
      flex: 1;
      width: 100%;
      padding: 0 13.3333vw;
      font-size: 3.2vw;
      line-height: 4.8vw;
    }

    .section-keyword-prepare .prepare-swiper-main .content .image {
      flex: 0;
    }

    .section-keyword-prepare .prepare-swiper-main .content .image img {
      height: 60vw;
    }
  }

  .section-keyword-prepare .keyword-prepare-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .section-keyword-prepare .keyword-prepare-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .section-keyword-prepare .keyword-prepare-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }
  }
{%- endstyle -%}

<h2 class="keyword-prepare-title" id="benefits" anchor="{{ section.settings.anchor | escape }}"
style="
--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
--pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
"
>{{- section.settings.prepare_title | escape -}}</h2>
{%- if section.settings.sub != blank -%}
 <div class="keyword-prepare-sub keyword-sub">{{ section.settings.sub }}</div>
{%- endif -%}
<div class="keyword-prepare-tab">
  <div class="children">
    {% for block in section.blocks %}
      <h3 class="tab {% if forloop.index0 == 0 %} tab-active {%endif%} tab-with-{{ section.settings.line_tab_number | number }}">
        {{- block.settings.tab | escape -}}
      </h3>
    {% endfor %}
  </div>
</div>
<div class="swiper prepare-swiper-main">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      {% if block.settings.background_img %}
        <div
          class="swiper-slide swiper-no-swiping content"
          style="background:url('{{ block.settings.background_img | image_url: width: 2000 }}'); "
        >
          <div class="title" style="color: {{block.settings.font_color}}">{{ block.settings.content }}</div>
          <div class="image"><img src="{{ block.settings.content_img | image_url: width: 2000 }}" loading="lazy" alt="{{block.settings.content_img.alt}}"></div>
        </div>
      {% else %}
        <div
          class="swiper-slide swiper-no-swiping content"
          style="background-color: {{block.settings.background_color}}"
        >
          <div class="title" style="color: {{block.settings.font_color}}">{{ block.settings.content }}</div>
          <div class="image"><img src="{{ block.settings.content_img | image_url: width: 2000 }}" loading="lazy" alt="{{block.settings.content_img.alt}}"></div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script type="module">
  function keyWordPrepareInit() {
    var swiper = new Swiper('.prepare-swiper-main', {
      speed: {{ section.settings.carousel_speed }},
      autoplay: {
        delay: {{ section.settings.autoplay_delay }},
        disableOnInteraction: false,
      },
      autoHeight: true,
      effect: 'fade',
      fadeEffect: {
        crossFade: true,
      },
      on: {
        slideChangeTransitionEnd: function () {
          let activeIndex = this.activeIndex;
          const tabs = document.querySelectorAll('.keyword-prepare-tab .children .tab');
          tabs.forEach(function (val, i) {
            if (i == activeIndex) {
              val.classList.add('tab-active');
            } else {
              val.classList.remove('tab-active');
            }
          });
        },
      },
    });

    const tabs = document.querySelectorAll('.keyword-prepare-tab .children .tab');
    tabs.forEach(function (val, i) {
      val.addEventListener('click', function () {
        swiper.slideTo(i, 1000, false);

        window.dataLayer.push({ event_parameters: null });
        window.dataLayer.push({
          event: 'ga4Event',
          event_name: 'keyword_tab_change',
          event_parameters: {
            current_page: location.pathname,
            position: i + 1,
            title: val.textContent.trim(),
          },
        });
      });
    });

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function (e) {
        const activeTabs = document.querySelectorAll('.section-keyword-prepare .keyword-prepare-tab .children .tab-active');
        activeTabs.forEach(function (activeTab) {
          activeTab.classList.remove('tab-active');
        });
        e.target.classList.add('tab-active');
      });
    });
  }

  window.addEventListener('DOMContentLoaded', function () {
    keyWordPrepareInit();
  });
</script>
{% schema %}
{
  "name": "Keyword Prepare",
  "class": "section section-keyword-prepare",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },
    { "type": "text", "id": "prepare_title", "label": "keyword prepare title" },
    { "type": "richtext", "id": "sub", "label": "keyword prepare subtitle" },
    {
      "type": "number",
      "id": "carousel_speed",
      "label": "Carousel speed (unit:ms)",
      "default": 300,
      "info": "轮播图切换速度，默认300ms"
    },
    {
      "type": "number",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (unit:ms)",
      "default": 3000,
      "info": "轮播图自动切换的时间间隔，默认3000ms"
    },
    {
      "type": "select",
      "id": "line_tab_number",
      "label": "Line Tab Number",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
    { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 40 },
    { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
    { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 }
  ],
  "blocks": [
    {
      "type": "keyword-prepare-item",
      "name": "Keyword Prepare Item",
      "settings": [
        { "type": "text", "id": "tab", "label": "prepare tab" },
        { "type": "textarea", "id": "content", "label": "prepare content" },
        { "type": "image_picker", "id": "background_img", "label": "prepare background image" },
        { "type": "color", "id": "background_color", "label": "backgroud color", "default": "#dcd5c8" },
        { "type": "color", "id": "font_color", "label": "font color", "default": "#ffffff" },
        { "type": "image_picker", "id": "content_img", "label": "prepare content img" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keyword Prepare",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
