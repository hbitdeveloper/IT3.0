                <h3 class="jky-text-lg font-bold">{{ blockTech.settings.part_4_heading | escape }}</h3>
                <img
                  class="accordion-close active"
                  src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_4.svg?v=1678936033"
                  alt="accordion-icon"
                  loading="lazy"
                  height="28"
                  width="28"
                >
              </div>
              <div class="accordion-content accordion-content--with-notes">
                <div class="manual-item">
                  {%- if blockTech.settings.part_4_subheading -%}
                    <div class="sub_title jky-text-lg">{{ blockTech.settings.part_4_subheading | escape }}</div>
                  {%- endif -%}
                  <dl class="manual-list" type="{{blockTech.settings.page_type}}">
                    {%- if blockTech.settings.part_4_note != blank -%}
                      <dd class="not-manual">
                        {{ blockTech.settings.part_4_note | replace: '<p>', '<p class="item-box-content jky-text-sm">' }}
                      </dd>
                    {%- endif -%}

                    <dd class="dd--guide-swiper not-manual">
                      {%- if blockTech.settings.part_4_sub_2 != blank -%}
                        <div class="sub_title jky-text-lg">{{ blockTech.settings.part_4_sub_2 | escape }}</div>
                      {%- endif -%}
                      <div class="user-guide-swiper swiper" style="width:100%;">
                        <div class="swiper-wrapper">
                          {%- for i in (0..2) -%}
                            {% assign video_key_index = 'part_4_media_' | append: forloop.index %}
                            {% assign poster_key_index = 'part_4_manual_' | append: forloop.index %}
                            {% assign tips_key_index = 'part_4_tips_' | append: forloop.index %}

                            {%- if blockTech.settings[video_key_index] != blank
                              or blockTech.settings[poster_key_index] != blank
                            -%}
                              <div class="swiper-slide flex flex-col">
                                {%- render 'jky-video',
                                  video_url: blockTech.settings[video_key_index],
                                  poster: blockTech.settings[poster_key_index],
                                  title: product.title,
                                  class: '',
                                  autoplay: false,
                                  controls: true,
                                  loop: false
                                -%}

                                <div class="text jky-text-sm">{{ blockTech.settings[tips_key_index] | escape }}</div>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                        <div class="slideshow-pagination relative"></div>
                      </div>
                    </dd>
                  </dl>
                </div>
              </div>
            </div>
          </product-specs>
        </div>
        <script src="{{ 'product-specs.js' | asset_url }}" data-cookieconsent="ignore" defer></script>
      {%- when 'faq' -%}
        <style>
          .produc-detail--faq {
            padding: 60px 0;
          }

          .produc-detail--faq .faq-title {
            font-size: 40px;
            font-weight: 600;
            line-height: 48px;
            color: #191919;
            text-align: center;
            margin-bottom: 20px;
          }

          .produc-detail--faq ul>li:not(.rte li) {
            margin-top: 20px;
            border-bottom: 1px solid #ccc;
            padding-bottom: 20px;
          }

          .produc-detail--faq ul>li .faq-header {
            font-size: 18px;
            color: #666;
            font-weight: 500;
            line-height: 22px;
            justify-content: space-between;
            align-items: flex-start;
            cursor: pointer;
            transform: all 0.3s;
          }

          .produc-detail--faq ul li .faq-header span {
            flex: 1;
          }

          .produc-detail--faq ul li .faq-header .toggle_btn {
            position: relative;
            width: 18px;
            height: 18px;
            flex-shrink: 0;
          }

          .produc-detail--faq ul li .faq-header .toggle_btn::before {
            transition: 0.3s;
            content: '';
            width: 2px;
            height: 18px;
            background: var(--primary-color);
            position: absolute;
            left: 50%;
            top: 0;
            transform: translateX(-50%);
          }

          .produc-detail--faq ul li .faq-header .toggle_btn::after {
            content: '';
            width: 18px;
            height: 2px;
            background: var(--primary-color);
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
          }

          .produc-detail--faq ul li .faq-header.active .toggle_btn::before {
            transform: rotate(90deg);
          }

          .produc-detail--faq ul li .faq-content {
            display: none;
            padding-top: 20px;
            font-weight: 400;
            font-size: 16px;
            line-height: 24px;
          }

          .produc-detail--faq .faq--more {
            margin: 20px auto;
          }
          .produc-detail--faq .faq--more.active .icon-arrow-down {
              transform: rotate(180deg);
          }
          @media screen and (max-width: 1024px) {
            .produc-detail--faq {
              padding: 8vw 0;
            }

            .produc-detail--faq .faq-title {
              font-size: 20px;
              line-height: 1.14;
              margin-bottom: 2.4vw;
            }

            .produc-detail--faq ul>li {
              margin-top: 2.4vw;
              padding-bottom: 2.4vw;
            }

            .produc-detail--faq ul li .faq-header {
              font-size: 15px;
              line-height: 1.2;
            }

            .produc-detail--faq ul li .faq-header .toggle_btn {
              position: relative;
              width: 16px;
              height: 16px;
              flex-shrink: 0;
            }

            .produc-detail--faq ul li .faq-header .toggle_btn::before {
              height: 16px;
            }

            .produc-detail--faq ul li .faq-header .toggle_btn::after {
              width: 16px;
            }

            .produc-detail--faq ul li .faq-content {
              padding-top: 2.4vw;
              font-size: 16px;
              line-height: 1.2;
            }
          }
        </style>
        {%- assign blockFaq = block -%}
        {%- assign faq_num = 0 -%}
        {%- for item in product.metafields.custom.faq.value -%}
          {%- assign faq_num = faq_num | plus: 1 -%}
        {%- endfor -%}
        <product-faq class="produc-detail--contetn_item bg-deep">
          <div
            anchor="{{block.settings.block_id | url_decode | strip | replace: ' ', ''}}"
            class="produc-detail--faq section-container"
          >
            <div class="faq-title">{{ blockFaq.settings.title | escape }}</div>
            <ul>
              {%- for item in product.metafields.custom.faq.value -%}
                <li>
                  <div class="faq-header flex">
                    <span>{{ item.title | escape }}</span>
                    <div class="toggle_btn"></div>
                  </div>
                  <div class="faq-content rte">{% if item.answer_new != blank %} {{item.answer_new | metafield_tag }} {% else %} {{item.answer | escape}} {% endif %}</div>
                </li>
              {%- endfor -%}
            </ul>

            {%- if faq_num > 3 -%}
              <div class="z-button-fill-middle faq--more gap-2" style="display:flex;">
                <span>{{ 'general.action_text.view_more' | t }}</span>
                {% comment %} <i class="iconfont jackery-icon-arrowdown"></i> {% endcomment %}
                <jds-icon name="arrow-down" class="iconfont icon-arrow-down"></jds-icon>
              </div>
            {%- endif -%}
          </div>
        </product-faq>
        <script src="{{ 'product-faq.js' | asset_url }}" data-cookieconsent="ignore" defer></script>
      {%- when 'reviews' -%}
        <div
          anchor="{{block.settings.block_id | url_decode | strip | replace: ' ', ''}}"
          class="produc-detail--contetn_item produc-detail--contetn_item__app"
        >
          <div class="section-container">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
    {%- endcase -%}
  {%- endfor -%}
</div>
<script src="{{ 'product-detail-variants.js' | asset_url }}" defer></script>
