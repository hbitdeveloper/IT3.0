<style>
  /* Tabs Header */
  .variants-details-tabs {
    width: 100%;
    height: 60px;
    z-index: 8;
    position: sticky;
    top: 0;
    background: #fff;
  }
  .variants-details-tabs ul {
    height: 100%;
  }
  .variants-details-tabs ul>li {
    flex: 1;
    font-size: 24px;
    text-align: center;
    cursor: pointer;
    color: rgba(0, 0, 0, 0.6);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.3s;
  }
  .variants-details-tabs ul li:hover,
  .variants-details-tabs ul li.active {
    color: var(--primary-color);
  }
  .variants-details-tabs .product--detail-tabs_slider {
    height: 6px;
    width: 100%;
    bottom: 0;
    background: #c4c4c478;
    border-radius: 10px;
    overflow: hidden;
  }
  .variants-details-tabs .product--detail-tabs_slider .main-slider {
    transition: 0.3s;
    position: absolute;
    left: var(--translate-filters-slider);
    height: 6px;
    width: var(--translate-filters-w);
    background-color: var(--primary-color);
    border-radius: 10px;
    overflow: hidden;
  }
  /* Tabs Header */

  /* Text block */
  .detail-block-title {
    font-size: var(--bloct-title);
    line-height: var(--bloct-title-lh);
  }
  .product-text-wrap.product-text--block {
    margin-bottom: 36px;
  }
  .product-text-wrap .text-box {
    justify-content: space-between;
  }
  .product-text-wrap .text-box.text-box--center {
    justify-content: center;
  }
  .product-text-wrap .product-text-wrap-main {
    max-width: 80%;
    color: rgba(0, 0, 0, 1);
  }
  .product-text-wrap .product-text-wrap-main .text-box-title:not(.text-box-title.text-box-title--nointro) {
    padding-bottom: 16px;
  }
  .product-text-wrap .product-text-wrap-main .text-box-title em,
  .product-text-wrap .product-text-wrap-main .text-box-title strong,
  .product-text-wrap .product-text-wrap-main .text-box-title b {
    color: var(--primary-color);
  }
  .product-text-wrap .text-box .right-icon {
    align-self: flex-end;
  }
  /* Text block */

  /* IMG block */
  .product-block-distance.product-full-block {
    width: 100%;
  }
  .product-block-distance.product-full-block img {
    width: 100%;
    object-fit: cover;
  }
  .product-full-block--nm + .product-detail__textpic_block:not(.product-detail__textpic_block_empty),
  .product-full-block--nm + .devices-block:not(.product-detail__textpic_block_empty) {
    margin-top: calc(0px - var(--block-gap) - var(--block-pic-mt));
  }
  /* IMG block */

  /* PIC-CARD block */
  .product-detail__textpic_block {
    background: var(--block-bg-dark);
  }
  .product-detail__textpic_block:not(:last-child) {
    padding-bottom: 24px;
  }
  .product-detail__textpic_block .section-container {
    border-radius: var(--block-piccard-radius);
    overflow: hidden;
  }
  .product-detail__textpic_block .image-card {
    padding: var(--block-piccard-pd);
    font-size: var(--block-piccard-font);
    line-height: 1.15;
    display: flex;
    flex-direction: column;
    gap: var(--block-piccard-gap);
    background: #fff;
  }
  .product-detail__textpic_block .image-card .image-card-title {
    font-size: var(--block-piccard-title);
    line-height: 1.2;
    font-weight: 600;
  }

  .product-detail__textpic_block .section-container img {
    object-fit: cover;
    width: 100%;
    max-height: 360px;
  }
  .product-detail__textpic_block .top-img {
    display: flex;
    flex-direction: column;
  }
  .product-detail__textpic_block .left-img {
    display: flex;
    flex-direction: row;
  }
  .product-detail__textpic_block .left-img .image-card {
    width: 50%;
    min-height: 390px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .product-detail__textpic_block .left-img picture {
    width: 50%;
    min-height: 390px;
  }
  .product-detail__textpic_block .left-img img {
    min-height: 390px;
  }

  .product-detail__textpic_block .right-img {
    display: flex;
    flex-direction: row-reverse;
  }
  .product-detail__textpic_block .right-img .image-card {
    width: 50%;
    min-height: 390px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .product-detail__textpic_block .right-img picture {
    width: 50%;
    min-height: 390px;
  }
  .product-detail__textpic_block .right-img img {
    min-height: 390px;
  }
  /* PIC-CARD block */

  .produc-detail--contetn_item__app {
    background-color: #fff;
  }

  .produc-detail--content {
    --block-gap: 140px; /* 版块之间的距离 */
    --product-content-top: 68px; /* 上部padding */
    --bloct-title: 45px; /* 模块标题size */
    --bloct-title-lh: 66px; /* 模块标题line-height */
    --block-pic-mt: 80px; /* 背景模块重叠距离 */
    --block-piccard-radius: 30px; /* 背景模块重叠距离 */
    --block-piccard-pd: 20px 40px; /* 图文模块padding距离 */
    --block-piccard-font: 16px;
    --block-piccard-gap: 24px;
    --block-piccard-title: 30px;
    --block-bg-dark: #f5f5f5; /* 模块深色背景 */

    padding-top: var(--product-content-top);
    background-color: var(--block-bg-dark);
  }

  .product-block-distance:not(.product-text--block, .img-card-box) {
    margin-bottom: var(--block-gap);
  }

  @media (max-width: 1024px) {
    .produc-detail--content {
      --block-gap: 14vw; /* 版块之间的距离 */
      --product-content-top: 12vw; /* 上部padding */
      --bloct-title: 6vw; /* 模块标题size */
      --bloct-title-lh: 8.8vw; /* 模块标题line-height */
      --block-pic-mt: 80px; /* 背景模块重叠距离 */
      --block-piccard-radius: 2.4vw; /* 背景模块重叠距离 */
      --block-piccard-pd: 6.6666vw 3.2vw; /* 图文模块padding距离 */
      --block-piccard-font: 3.46666vw;
      --block-piccard-gap: 3.2vw;
      --block-piccard-title: 4.8vw;
      --block-bg-dark: #f5f5f5; /* 模块深色背景 */

      padding-top: var(--product-content-top);
      background-color: var(--block-bg-dark);
    }

    /* Tabs Header */
    .variants-details-tabs {
      height: 32px;
    }
    .variants-details-tabs ul>li {
      font-size: 14px;
    }
    .variants-details-tabs .product--detail-tabs_slider {
      height: 3px;
      border-radius: 5px;
    }
    .variants-details-tabs .product--detail-tabs_slider .main-slider {
      height: 3px;
      border-radius: 5px;
    }
    /* Tabs Header */

    /* Text block */
    .product-text-wrap.product-text--block {
      margin-bottom: 6vw;
    }
    .product-text-wrap .product-text-wrap-main {
      max-width: 100%;
    }
    .product-text-wrap .product-text-wrap-main .text-box-title:not(.text-box-title.text-box-title--nointro) {
      padding-bottom: 2vw;
    }
    .product-text-wrap .left-icon {
      width: 4.66vw;
      object-position: top;
    }
    .product-text-wrap .right-icon {
      width: 6.2666vw;
      object-position: bottom;
    }
    .product-text-wrap .text-box-intro {
      font-size: 3.46666vw;
      line-height: 5.2vw;
    }
    /* Text block */

    /* IMG block */
    .product-block-distance.product-full-block {
      max-width: 100%;
    }
    .product-full-block--nm + .product-detail__textpic_block:not(.product-detail__textpic_block_empty),
    .product-full-block--nm + .devices-block:not(.product-detail__textpic_block_empty) {
      margin-top: calc(0px - var(--block-gap) - var(--block-pic-mt));
    }
    /* IMG block */

    /* PIC-CARD block */
    .image-card-intro {
      font-size: 3.46666vw;
      line-height: 5.2vw;
    }
    .product-detail__textpic_block:not(:last-child) {
      padding-bottom: 0;
    }
    .product-detail__textpic_block .section-container {
      border-radius: var(--block-piccard-radius);
      overflow: hidden;
    }
    .product-detail__textpic_block .image-card {
      padding: var(--block-piccard-pd);
      background: #fff;
    }

    .product-detail__textpic_block .section-container img {
      object-fit: cover;
      width: 100%;
      max-height: 360px;
    }
    .product-detail__textpic_block .top-img {
      display: flex;
      flex-direction: column;
    }
    .product-detail__textpic_block .left-img {
      flex-direction: column;
    }
    .product-detail__textpic_block .left-img .image-card {
      width: 100%;
      min-height: unset;
      flex-direction: column;
    }
    .product-detail__textpic_block .left-img picture {
      width: 100%;
      min-height: unset;
    }
    .product-detail__textpic_block .left-img img {
      min-height: unset;
    }

    .product-detail__textpic_block .right-img {
      display: flex;
      flex-direction: column;
    }
    .product-detail__textpic_block .right-img .image-card {
      width: 100%;
      min-height: unset;
      display: flex;
    }
    .product-detail__textpic_block .right-img picture {
      width: 100%;
      min-height: unset;
    }
    .product-detail__textpic_block .right-img img {
      min-height: unset;
    }
    /* PIC-CARD block */
  }

  .variant_toggle_block:not(.variant_toggle_block.variant_toggle_block_hide) {display: none;}
  .variant_toggle_block .product-table-specs tr:first-of-type .table-row {border: 1px solid #eee;padding-top: 0;}
  .variant_toggle_block .product-table-specs .table-row {border-left: unset;border: 1px solid #eee;}
  .variant_toggle_block .product-table-specs .table-column:first-of-type, .variant_toggle_block .product-table-specs .table-row:first-of-type {border-left: 1px solid #eee;}
  .variant_toggle_block .product-table-specs .table-column {border: 1px solid #eee;}
  .variant_toggle_block .product-table-specs .table-row:first-of-type::after {background: transparent!important;}
</style>
<script src="{{ 'jquery-3.6.4.min.js' | asset_url }}" data-cookieconsent="ignore" defer></script>
{% comment %} Tab栏导航 {% endcomment %}
{%- assign tabs_num = 0 -%}
<div class="variants-details-tabs flex cal_scroll_target">
  {%- for block in section.blocks -%}
    {%- if block.settings.block_id != blank -%}
      {%- assign tabs_num = tabs_num | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign bar_tran_w = 100 | divided_by: tabs_num -%}
  <ul
    class="section-container J-tabs-point flex relative"
    style="--translate-filters-slider: 0%;--translate-filters-w: {{bar_tran_w}}%;"
  >
    {%- for block in section.blocks -%}
      {%- if block.settings.block_id != blank -%}
        <li data-id="{{block.settings.block_id | url_decode | strip | replace: ' ', ''}}">
          {{ block.settings.block_id | escape }}
        </li>
      {%- endif -%}
    {%- endfor -%}
    <div class="product--detail-tabs_slider absolute">
      <div class="main-slider"></div>
    </div>
  </ul>
</div>
{% comment %} Tab栏导航 {% endcomment %}

{% comment %} 当前变体id {% endcomment %}
{%- assign sid = product.selected_or_first_available_variant.id | append: '' -%}

{% comment %} 产品无变体标志 {% endcomment %}
{%- assign hasno_variant = product.has_only_default_variant -%}

<div class="produc-detail--content" section-id="{{section.id}}">
  {%- for block in section.blocks -%}
    {%- assign blocks_type = block.type -%}
    {%- case block.type -%}
      {%- when 'empty-block-box' -%}
        <div
          anchor="{{block.settings.block_id | url_decode | strip | replace: ' ', ''}}"
          class="variant_toggle_block {% if block.settings.variant_id == blank or sid == block.settings.variant_id %} variant_toggle_block_hide{% endif %}">
          {% render 'empty-block-box',settings: block.settings, anchorID: block.settings.anchor_id, handle: block.settings.sourceHandle, index: forloop.index %}
        </div>
      {%- when 'variants_video' -%}
        {%- assign video_block_url = blank -%}
        {%- assign video_block_pic = blank -%}

        {%- for i in (0..5) -%}
          {%- assign variant_id_index = 'variant_id_' | append: forloop.index -%}
          {%- assign feature_video_index = 'feature_video_' | append: forloop.index -%}
          {%- assign feature_video_poster_index = 'feature_video_poster_' | append: forloop.index -%}
          {%- if block.settings[feature_video_index] != blank or block.settings[feature_video_poster_index] != blank -%}
            {%- if hasno_variant == true or block.settings.need_variant_change == false -%}
              {% comment %} 无变体 {% endcomment %}
              {%- assign video_block_url = block.settings[feature_video_index] -%}
              {%- assign video_block_pic = block.settings[feature_video_poster_index] -%}
            {%- else -%}
              {% comment %} 多变体指定变体 {% endcomment %}
              {%- if sid == block.settings[variant_id_index] -%}
                {%- assign video_block_url = block.settings[feature_video_index] -%}
                {%- assign video_block_pic = block.settings[feature_video_poster_index] -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        <div
          anchor="{{block.settings.block_id | url_decode | strip | replace: ' ', ''}}"
          class="{%if block.settings.need_variant_change == true%} product-detail__variant_block{% endif %}"
        >
          {%- if video_block_url != blank or video_block_pic != blank -%}
            <div class="section-container relative product-block-distance {% if block.settings.section_type == false %} product-text-wrap product-text--block{% endif %}">
              {%- render 'jky-video',
                video_url: video_block_url,
                poster: video_block_pic,
                title: product.title,
                class: '',
                autoplay: block.settings.autoplay,
                controls: block.settings.controls,
                loop: block.settings.loop
              -%}
            </div>
          {%- endif -%}
        </div>
      {%- when 'variants_text' -%}
        {%- assign text_block_variant = blank -%}
        {%- assign text_block_title = blank -%}
        {%- assign text_block_intro = blank -%}

        {%- for i in (0..5) -%}
          {%- assign variant_id_index = 'variant_id_' | append: forloop.index -%}
          {%- assign feature_title_index = 'feature_title_' | append: forloop.index -%}
          {%- assign feature_intro_index = 'feature_intro_' | append: forloop.index -%}
          {%- if block.settings[feature_title_index] != blank or block.settings[feature_intro_index] != blank -%}
            {%- if hasno_variant == true or block.settings.need_variant_change == false -%}
              {% comment %} 无变体 {% endcomment %}
              {%- assign text_block_title = block.settings[feature_title_index] -%}
              {%- assign text_block_intro = block.settings[feature_intro_index] -%}
            {%- else -%}
              {% comment %} 多变体指定变体 {% endcomment %}
              {%- if sid == block.settings[variant_id_index] -%}
                {%- assign text_block_title = block.settings[feature_title_index] -%}
                {%- assign text_block_intro = block.settings[feature_intro_index] -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        <div
          anchor="{{block.settings.block_id | url_decode | strip | replace: ' ', ''}}"
          class="{%if block.settings.need_variant_change == true%} product-detail__variant_block{% endif %}"
        >
          {%- if text_block_title != blank or text_block_intro != blank -%}
            <div class="product-text-wrap product-block-distance section-container relative {% if block.settings.section_type == false %} product-text--block{% endif %}">
              <div class="text-box flex {% if block.settings.show_icon == false %}text-box--center{% endif %}">
                {%- if block.settings.show_icon == true -%}
                  <img
                    class="left-icon"
                    src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016"
                    alt="jackery symbol"
                    loading="lazy"
                    width="34"
                    height="54"
                  >
                {%- endif -%}
                <div class="jky-text-base product-text-wrap-main">
                  {%- if text_block_title != blank -%}
                    <h2 class="text-box-title {% if text_block_intro == blank %}text-box-title--nointro{% endif %}">
                      {{ text_block_title | replace: '<p>', '<p class="detail-block-title font-bold text-center">' }}
                    </h2>
                  {%- endif -%}

                  {%- if text_block_intro != blank -%}
                    <div class="text-box-intro">{{ text_block_intro | escape }}</div>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_icon == true -%}
                  <img
                    class="right-icon"
                    src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016"
                    alt="jackery symbol"
                    loading="lazy"
                    width="46"
                    height="66"
                  >
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- when 'variants_pic' -%}
        {%- assign text_block_variant = blank -%}
        {%- assign img_block = blank -%}
        {%- assign mb_img_block = blank -%}

        {%- for i in (0..5) -%}
          {%- assign variant_id_index = 'variant_id_' | append: forloop.index -%}
          {%- assign img_index = 'img_' | append: forloop.index -%}
          {%- assign mb_img_index = 'mb_img_' | append: forloop.index -%}
          {%- if block.settings[img_index] != blank -%}
            {%- if hasno_variant == true or block.settings.need_variant_change == false -%}
              {% comment %} 无变体 {% endcomment %}
              {%- assign img_block = block.settings[img_index] -%}
              {%- assign mb_img_block = block.settings[mb_img_index] -%}
            {%- else -%}
              {% comment %} 多变体指定变体 {% endcomment %}
              {%- if sid == block.settings[variant_id_index] -%}
                {%- assign img_block = block.settings[img_index] -%}
                {%- assign mb_img_block = block.settings[mb_img_index] -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        <div
          anchor="{{block.settings.block_id | url_decode | strip | replace: ' ', ''}}"
          class="{% if block.settings.is_full == true %}product-full-block--nm {% endif %} {%if block.settings.need_variant_change == true%} product-detail__variant_block{% endif %}"
        >
          {%- if img_block != blank -%}
            <div class="section-container product-block-distance {% if block.settings.section_type == false %} product-text-wrap product-text--block{% endif %} {% if block.settings.is_full == true %} product-full-block{% endif %}">
              <picture>
                <source media="(min-width: 750px)" srcset="{{ img_block | image_url: width: 1920 }}">
                <img
                  src="{%if mb_img_block != blank%}{{ mb_img_block | image_url: width: 1024 }}{% else %}{{ img_block | image_url: width: 1024 }}{% endif %}"
                  alt="{{ img_block.alt | escape }}"
                  loading="lazy"
                  width="{% if mb_img_block != blank %}{{ mb_img_block.width }}{% else %}{{ img_block.width }}{% endif %}"
                  height="{% if mb_img_block != blank %}{{ mb_img_block.height }}{% else %}{{ img_block.height }}{% endif %}"
                >
              </picture>
            </div>
          {%- endif -%}
        </div>
      {%- when 'variants_textpic' -%}
        {%- assign text_block_variant = blank -%}
        {%- assign img_block = blank -%}
        {%- assign title_block = blank -%}
        {%- assign subtitle_block = blank -%}
        {%- assign img_type = blank -%}

        {%- for i in (0..5) -%}
          {%- assign variant_id_index = 'variant_id_' | append: forloop.index -%}
          {%- assign img_index = 'img_' | append: forloop.index -%}
          {%- assign title_index = 'title_' | append: forloop.index -%}
          {%- assign subtitle_index = 'subtitle_' | append: forloop.index -%}
          {%- assign img_type_index = 'img_type_' | append: forloop.index -%}
          {%- if block.settings[img_index] != blank -%}
            {%- if hasno_variant == true or block.settings.need_variant_change == false -%}
              {% comment %} 无变体 {% endcomment %}
              {%- assign img_block = block.settings[img_index] -%}
              {%- assign title_block = block.settings[title_index] -%}
              {%- assign subtitle_block = block.settings[subtitle_index] -%}
              {%- assign img_type = block.settings[img_type_index] -%}
            {%- else -%}
              {% comment %} 多变体指定变体 {% endcomment %}
              {%- if sid == block.settings[variant_id_index] -%}
                {%- assign img_block = block.settings[img_index] -%}
                {%- assign title_block = block.settings[title_index] -%}
                {%- assign subtitle_block = block.settings[subtitle_index] -%}
                {%- assign img_type = block.settings[img_type_index] -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        <div
          anchor="{{block.settings.block_id | url_decode | strip | replace: ' ', ''}}"
          class="product-detail__textpic_block {%if block.settings.need_variant_change == true%} product-detail__variant_block{% endif %} {%if img_block == blank%} product-detail__textpic_block_empty{% endif %}"
        >
          {%- if img_block != blank -%}
            <div class="section-container product-block-distance {% if block.settings.section_type == false %} product-text-wrap product-text--block img-card-box {% endif %} {{ img_type}}">
              <picture>
                <source media="(min-width: 750px)" srcset="{{ img_block | image_url: width: 1920 }}">
                <img src="{{ img_block | image_url: width: 1024 }}" alt="{{ img_block.alt | escape }}" loading="lazy" width="{{ img_block.width }}" height="{{ img_block.height }}">
              </picture>

              <div class="image-card">
                {%- if title_block != blank -%}
                  <h2 class="image-card-title">{{ title_block | replace: '<p>', '<p class="title">' }}</h2>
                {%- endif -%}

                {%- if subtitle_block != blank -%}
                  <div class="image-card-intro">
                    {{ subtitle_block | replace: '<p>', '<p class="intro jky-text-base">' }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- when 'variants_simulator' -%}
        {% assign capacity = product.metafields.my_fields.wattage %}
        {%- if capacity -%}
          <style>
            .time-simulator-wrapper {
              background: var(--block-bg-dark);
            }
            .time-simulator-wrapper .section-container {
              background: #fff;
              border-radius: 30px;
              padding: 70px 20px;
              text-align: center;
