                        "mb_heading": "<p>Solar Generators for Home</p>",
                        "padding_top": 0,
                        "padding_bottom": 16,
                        "alignment": "left",
                        "alignment_mb": "left",
                        "text_color": "#ffffff"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
