<style>
    @media screen and (min-width: 1920px) {
    .v5-activity-subscribe .block-common-banner .banner-img {
      height: 100%;
    }
  }

  @media screen and (min-width: 1440px) and (max-width: 1600px) {
    .v5-activity-subscribe .block-common-banner .swiper-wrapper{
       height: calc(var(--pc-banner-h, 420) * 1px);
      }
    .v5-activity-subscribe .block-common-banner .banner-img {
        height: calc(var(--pc-banner-h, 420) * 1px);
    }
  }

    .v5-activity-subscribe .subscribe-blocks .blocks-subscribe-banner-form{
      width: 100%;
    }

    .v5-activity-subscribe .subscribe-blocks .subscribe-blocks-box input{
      border-radius: 0;
      border-color: rgba(255, 255, 255, 0.8);
      color: #242F20;
    }

    .v5-activity-subscribe .subscribe-blocks .field_error-tips{
      color: #F72626;
      line-height: 1.3;
    }
    .v5-activity-subscribe .subscribe-blocks jky-form form .group.form-item-group button{
      border-radius: 0;
    }
    .v5-activity-subscribe .subscribe-blocks .blocks-subscribe-banner-form{
      padding: 0;
    }

    .v5-activity-subscribe .subscribe-blocks .subscribe-blocks-box{
      height: unset;
    }

    .v5-activity-subscribe .form-item-group{
      margin-bottom: 0.75rem;
    }

  @media screen and (min-width: 1024px) {

    {% comment %} 上中下 {% endcomment %}
    .v5-activity-subscribe .block-common-banner .banner-info.vertical-top{
        top: 3.9rem;
    }
    .v5-activity-subscribe .block-common-banner .banner-info.vertical-center{
        top: 50%;
    }
    .v5-activity-subscribe .block-common-banner .banner-info.vertical-bottom{
        top: unset;
        bottom: 3.9rem; 
        transform: translateX(-50%);
    }


    .v5-activity-subscribe .subscribe-blocks .subscribe-blocks-box{
      height: unset;
      width: 25rem;
    }
    .v5-activity-subscribe .subscribe-blocks .subscribe-blocks-box::after{
       height: 3rem;
    }
    .v5-activity-subscribe .subscribe-blocks .subscribe-blocks-box input{
      height: 3rem;
    }
    .v5-activity-subscribe .subscribe-blocks .subscribe-blocks-box .field_error-tips::after{
     height: 3rem;
    }

      .v5-activity-subscribe .subscribe-blocks jky-form form .group.form-item-group button{
       height: 3rem;
      }
  }

  @media screen and (max-width: 1023.98px) {

    {% comment %} 上中下 {% endcomment %}
    .v5-activity-subscribe .block-common-banner .banner-info.vertical-top-mb{
        top: 2.5rem;
    }
    .v5-activity-subscribe .block-common-banner .banner-info.vertical-center-mb{
      top: 50%;
      transform: translate(-50%, -50%);
    }
    .v5-activity-subscribe .block-common-banner .banner-info.vertical-bottom-mb{
        top: unset;
        bottom: 2.5rem;
        transform: translateX(-50%);
    }

    .v5-activity-subscribe .subscribe-blocks .subscribe-blocks-box input{
      height: 2.5rem;
    }
    .v5-activity-subscribe .subscribe-blocks .subscribe-blocks-box::after{
        height: 2.5rem;
    }
    .v5-activity-subscribe .subscribe-blocks .subscribe-blocks-box .field_error-tips::after{
     height: 2.5rem;
    }


    .v5-activity-subscribe .subscribe-blocks jky-form form .group.form-item-group button{
      height: 2.5rem;
    }

    .v5-activity-subscribe .subscribe-blocks .field_error-tips{
     font-size: 0.75rem;
    }

    .v5-activity-subscribe .swiper-button-prev,
    .v5-activity-subscribe .swiper-button-next {
      display: none;
    }
  }
</style>

{% content_for 'blocks' %}

{% # theme-check-disable %}
{% schema %}
{
  "name": "V5-活动页-订阅倒计时Banner",
