{% comment %} 覆盖 插件的样式 {% endcomment %}
{% style %}
  .v5-pdp-reviews .jdgm-rev-widg {
    padding-top: 0 !important;
  }
  .v5-pdp-reviews .jdgm-rev-widg .jdgm-rev-widg__title {
    font-size: 44px;
    font-weight: 500;
    line-height: 1.2;
    color: #1A1A1A;
    text-align: center;
    padding-bottom: 40px;
    letter-spacing: -1px;
    margin-bottom: 0;
  }
  @media (max-width: 1024px) {
    .v5-pdp-reviews .jdgm-rev-widg .jdgm-rev-widg__title {
      width: 82.9333333333333vw;
      margin-left: 8.53333333333333vw;
      font-size: 8.53333333333333vw;
      line-height: 10.6666666666667vw;
      padding-bottom: 5.33333333333333vw;
      font-weight: 600;
      text-align: left;
    }
  }
{% endstyle %}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  {{ section.shopify_attributes }}
  class="v5-pdp-reviews section-padding"
  style="{{ style }}"
  {% if section.settings.anchor != blank %} anchor-target="{{section.settings.anchor | escape}}" {% endif %} 
>
  <div class="{{section.settings.page_width}} product-block-section">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "V5-PDP-评论插件容器",
  "class": "v5-pdp-reviews",
  "tag": "div",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    
    {
      "type": "select",
      "id": "style_type",
      "options": [
        {
          "value": "default",
          "label": "基础配置"
        },
        {
          "value": "custom",
          "label": "开发者配置"
        }
      ],
      "default": "default",
      "label": "配置类型"
    },
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    {
      "type": "select", 
      "id": "page_width",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1312px"
        },
        {
          "value": "w-full",
          "label": "铺满/100%"
        }
      ],
      "default": "section-container-lg",
      "label": "组件宽度",
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    { "type": "header", "content": "PC边距", "visible_if": "{{ section.settings.style_type == 'custom' }}" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },

    { "type": "header", "content": "MB边距", "visible_if": "{{ section.settings.style_type == 'custom' }}" },
    {
      "type": "select",
      "id": "mb_padding_type",
      "options": [
        {
          "value": "default",
          "label": "默认"
        },
        {
          "value": "custom",
          "label": "自定义"
        }
      ],
      "default": "default",
      "label": "MB边距",
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' and section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' and section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' and section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' and section.settings.mb_padding_type == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "limit": 1,
  "presets": [
    {
      "name": "V5-PDP-评论插件容器",
      "category": "V5.0"
    }
  ]
}
{% endschema %}
