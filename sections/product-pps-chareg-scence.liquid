<style>
    .product-pps-charge-wrapper em, .product-pps-charge-wrapper b,.product-pps-charge-wrapper strong{color:var(--primary-color);}
    .product-pps-charge-wrapper .img-box {width: 50%; object-fit: cover;max-height:820px;height: auto;}
    .product-pps-charge-wrapper .charg-box {width: 50%; padding: 64px 50px; background: var(--normal-color);  display: flex;flex-direction: column;justify-content: center;}
    .product-pps-charge-wrapper .table-box {margin-top: 0;}
    .product-pps-charge-wrapper .table-head {margin-bottom: 32px;}

    .product-pps-charge-wrapper .table-item:not(:last-child) {margin-bottom: 20px;}
    .product-pps-charge-wrapper .table-item {align-items: center;cursor:pointer;padding:16px 24px;    background: var(--gray-color);}
    .product-pps-charge-wrapper .img-box{width: 50%;object-fit: cover;}
    .product-pps-charge-wrapper .table-item span{padding-left: 20px;}
    .product-pps-charge-wrapper .table-item .iconfont{font-size: 54px;line-height: 80px;}
    .product-pps-charge-wrapper .table-item.active{color:var(--primary-color);}
    .product-pps-charge-wrapper .table-box:after {content: ""; display: inline-block; width: 100%; height: 1px; background: var(--text-disable-color); margin: 32px 0 12px;}

    .product-pps-charge-wrapper svg.icon-charge-scene{display:inline-block;width: 54px;height: 54px;vertical-align: middle;}
    @media screen and (max-width: 1024px) {
        .product-pps-charge-wrapper .mob-tabs{display:flex!important;margin-bottom: 18px;justify-content: flex-start;font-size: 14px;gap:10px;padding: 0 10px;flex-wrap: wrap;}
        .product-pps-charge-wrapper .mob-tabs li.active{color:var(--primary-color);border-bottom: 1px solid var(--primary-color);}
        .product-pps-charge-wrapper .title{line-height:1.1;margin-bottom: var(--content-distance);}
        .product-pps-charge-wrapper .table-box{margin-top: 0;display: none;}
        .product-pps-charge-wrapper .mob-items{display: flex!important;margin-top: -14.6667vw;justify-content: center;}
        .product-pps-charge-wrapper .table-item.active {color: var(--primary-color);border-bottom: none;line-height: normal;}
        .product-pps-charge-wrapper .table-item:not(:last-child) {margin-bottom: 0;}
        .product-pps-charge-wrapper .table-item{flex-direction: column;padding: 8px 12px;background: var(--normal-color);margin: 0 2.6667vw;text-align: center;    justify-content: space-between;}
        .product-pps-charge-wrapper .table-item .iconfont {font-size: 40px;line-height: 40px;}
        .product-pps-charge-wrapper .table-item span{padding-left: 0;}
        .product-pps-charge-wrapper svg.icon-charge-scene{width: 40px;height: 40px;}
        .product-pps-charge-wrapper .table-item {display:flex;flex-direction: column;flex: 1;margin: 0 6px;}


        .product-pps-charge-wrapper{margin-bottom: var(--content-distance);}
        .product-pps-charge-wrapper{flex-direction:column;}
        .product-pps-charge-wrapper .img-box {width: 100%; height: 75vw;max-height:unset;}
        .product-pps-charge-wrapper .charg-box {width: 100%;max-width:100vw;background: transparent;padding: 16px 30px;}
        .product-pps-charge-wrapper .table-head {margin-bottom: var(--gap);}
        .product-pps-charge-wrapper .table-box {margin-top: 0;}
        .product-pps-charge-wrapper .table-box:after {margin: 16px 0 0;}
        .product-pps-charge-wrapper .solar-wrap-tips {margin-top:15px;}
    }
</style>

<figure 
  {% if section.settings.anchor != blank %}
    data-anchor="{{section.settings.anchor}}"
  {% endif %}
  class="product-pps-charge-wrapper flex J-pps-charge-quickly product-b {% if section.settings.section_type %} product-p-t{% endif %}"
>
    {% assign simple_charge = section.blocks %}
    <figcaption class="title jky-text-2xl font-500 mobile-block text-center">
      {{ section.settings.charge_title | replace: '<em>', '<em style="color: var(--primary-color);">' | replace: '<b>', '<b style="color: var(--primary-color);">' | replace: '<b>', '<strong style="color: var(--primary-color);">'}}
    </figcaption>
    <ul class="mob-tabs mobile-block text-center">
      {%- for block in simple_charge -%}
        {%- assign active_class = '' -%}
        {%- if forloop.first == true -%}
          {%- assign active_class = 'active' -%}
        {%- endif -%}
        <li class="{{ active_class }}">{{ block.settings.charge_name }}</li>
      {%- endfor -%}
    </ul>

    {%- for block in simple_charge -%}
      {%- if forloop.first == true -%}
        <img class="img-box" src="{{ block.settings.charge_bg | image_url: width: 2000 }}" alt="{{block.settings.charge_bg.alt}}" width="{{ block.settings.charge_bg.width }}" height="{{ block.settings.charge_bg.height }}" loading="lazy">
      {%- endif -%}
    {%- endfor -%}

    <div class="charg-box">
      <div class="table-box pc-block">
        <h3 class="table-head jky-text-lg flex font-bold">
          {{ section.settings.charge_title | replace: '<em>', '<em style="color: var(--primary-color);">' | replace: '<b>', '<b style="color: var(--primary-color);">' | replace: '<b>', '<strong style="color: var(--primary-color);">' }}
        </h3>

        {%- for block in simple_charge -%}
          {%- assign active_class = '' -%}
          {%- if forloop.first == true -%}
            {%- assign active_class = 'active' -%}
          {%- endif -%}
          <div class="table-item {{ active_class }}" data-bg-img="{{ block.settings.charge_bg | image_url: width: 2000 }}">
            {% render 'icon-charge-scene', value: block.settings.charge_icon, class: 'icon-charge-scene' %}
            <span class="jky-text-base">{{ block.settings.charge_name }} {{ block.settings.duration }}</span>
          </div>
        {%- endfor -%}
      </div>
      <div class="mob-items mobile-block">
        {%- for block in simple_charge -%}
          {%- assign active_class = '' -%}
          {%- if forloop.first == true -%}
            {%- assign active_class = 'active' -%}
          {%- endif -%}
          <div class="table-item {{ active_class }}" data-bg-img="{{ block.settings.charge_bg | image_url: width: 2000 }}">

            {% render 'icon-charge-scene', value: block.settings.charge_icon, class: 'icon-charge-scene' %}
            <span class="jky-text-base">{{ block.settings.duration }}</span>
          </div>
        {%- endfor -%}
      </div>
      <div class="solar-wrap-tips jky-text-base">{{ section.settings.charge_tips }}</div>
    </div>
</figure>

<script type="module">
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.J-pps-charge-quickly');
    if (!container) return;

    const imgBox = container.querySelector('.img-box');
    const tableItems = container.querySelectorAll('.table-item');
    const mobTabs = container.querySelectorAll('.mob-tabs li');

    // 统一的切换逻辑函数
    const switchTab = (index) => {
        // 1. 获取目标数据
        const targetItem = tableItems[index];
        if (!targetItem) return;
        const src = targetItem.getAttribute('data-bg-img');

        // 2. 更新图片
        if (imgBox && src) imgBox.src = src;

        // 3. 更新 Table Items 状态
        tableItems.forEach((item, i) => {
            item.classList.toggle('active', i === index);
        });

        // 4. 更新 Mobile Tabs 状态
        mobTabs.forEach((tab, i) => {
            tab.classList.toggle('active', i === index);
        });
    };

    // 绑定 Table Items 点击事件
    tableItems.forEach((item, index) => {
        item.addEventListener('click', () => switchTab(index));
    });

    // 绑定 Mobile Tabs 点击事件
    mobTabs.forEach((tab, index) => {
        tab.addEventListener('click', () => switchTab(index));
    });
  });
</script>
{% schema %}
{
    "name": "product pps charge scene", "class": "product-pps-charge-scene product-section-block", "tag": "div",
    "enabled_on": {
      "templates": ["product"]
    },
    "settings": [
        {
          "type": "checkbox",
          "id": "section_type",
          "default": false,
          "label": "是否为大版块？",
          "info": "大版块与上一个模块之间间距大，小版块与上一模块间距较小"
        },
        {
            "type": "select",
            "id": "anchor",
            "label": "锚点设置",
            "info": "非锚点section请清空此项",
            "options": [
                {
                "value": "",
                "label": "非锚点section"
                },
                {
                "value": "anchor__1",
                "label": "第一个section锚点"
                },
                {
                "value": "anchor__2",
                "label": "第二个section锚点"
                },
                {
                "value": "anchor__3",
                "label": "第三个section锚点"
                },
                {
                "value": "anchor__4",
                "label": "第四个section锚点"
                }
            ],
            "default": ""
        },
        {
            "type": "richtext", "id": "charge_title", "label": "Charge Title",
            "default": "<p>3 simple ways to <em>charge quickly</em></p>"
        },
        {
            "type": "text", "id": "charge_tips", "label": "Charge Tips",
            "default": "The MPPT technology ensures 99% solar charging efficiency and to charge power station to full charge in 1.8 hours. Bonus: full wall charge in 1.6 hours, also support the car charging. Never worry about power outages anymore."
        }
    ],
    "blocks": [
        {
        "type": "simple_charge", "name": "Simple charge", "limit": 4,
            "settings": [
                {"type": "text", "id": "charge_name", "label": "Charge Name", "default": "Solar Charging"},
                {"type": "text", "id": "duration", "label": "Usage Duration", "default": "1.8 H"},
                {
                "type": "select",
                "id": "charge_icon",
                "label": "Charge Icon",
                "options": [
                    {
                    "value": "jackery-icon-icon-wall-charging",
                    "label": "wall-charging"
                    },
                    {
                    "value": "jackery-icon-icon-car-charging",
                    "label": "car-charging"
                    },
                    {
                    "value": "jackery-icon-icon-solar-charging",
                    "label": "solar-charging"
                    },
                    {
                    "value": "jackery-icon-a-QuickCharging",
                    "label": "quick-charging"
                    }
                ],
                "default": "jackery-icon-icon-wall-charging"
                },
                {"type": "image_picker", "id": "charge_bg", "label": "Charge Scene"}
            ]
        }
    ],
     "presets": [{
        "name": "product pps charge scene"
   }]
}
{% endschema %}
