{{ 'page-index.bundle.css' | asset_url | stylesheet_tag }}
<link
  rel="stylesheet"
  rel="preload"
  href="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/swiper-bundle.min.css?v=1670922528">
<link href="https://vjs.zencdn.net/7.20.3/video-js.css" rel="stylesheet" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/gsap.min.js"></script>
{{ 'swiper.js' | asset_url | script_tag }}
<script src="https://vjs.zencdn.net/7.20.3/video.min.js"></script>


{% assign VIDEO = section.blocks | where: 'type', 'VIDEO' %}

<div style="background:#F5F5F5;">
  <h2 class="text-center accessories-usage-title text-2xl">{{ section.settings.title }}</h2>

  <div class="swiper-container slideshow video-slideshow video-swiper">
    <div class="swiper-wrapper">
      {% for block in VIDEO limit: 5 %}
        {%- assign img_url = block.settings.video_pic | img_url: '750x' -%}
        <div
          class="swiper-slide"
          block-id="{{block.id}}"
          block-src="{{block.settings.video_url}}">
          <div>
            <h2 class="text-center relative" style="width:100%;height:210px;display:flex;align-items:center;justify-content:center;background:#FFF;">{{ block.settings.title }}</h2>
            <video
              data-dps-name="default_"
              name="media"
              muted=""
              loop=""
              class="slide-video pc-block"
              style="position:static;"
            >
              <source
                data-layzr-src="{{block.settings.video_url}}"
                type="video/mp4; codecs=&quot;avc1.4D401E, mp4a.40.2&quot;"
                src="{{block.settings.video_url}}">
            </video>
            <div class="slide-image mobile-block" style="background-image: url({{img_url}})"></div>
          </div>

          <div class="absolute mobile-block video-swiper-play" data-modal="#s{{block.id}}">
            <span class="iconfont jackery-icon-24gl-playCircle"></span>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="slideshow-pagination"></div>
    <div class="slideshow-navigation">
      <div class="slideshow-navigation-button prev">
        <span class="iconfont jackery-icon-Next"></span>
      </div>
      <div class="slideshow-navigation-button next">
        <span class="iconfont jackery-icon-Next"></span>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-center accessories-usage-view-more">
    <a class="a-button-fill blog-cate-link text-lg" href="{{section.settings.more_url}}">
      {{ section.settings.more_text }}
      <span class="iconfont jackery-icon-arrow-right text-lg"></span>
    </a>
  </div>
</div>

<div
  class="modal video-swiper-modal"
  data-modal-window
  id="">
  <video
    id="index-section-video"
    class="video-js video-modal-video vjs-modal"
    controls
    preload="auto"
    poster=""
    data-setup="">
    <source src="https://cdn.shopify.com/videos/c/o/v/b4c985e0a54e4f348521244be8303c05.mp4" type="video/mp4">
    <p class="vjs-no-js">
      To view this video please enable JavaScript, and consider upgrading to a web browser that
      <a href="https://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>
    </p>
  </video>
  <div class="video-modal-close" data-modal-close></div>
</div>

<script src="{{ 'video-swiper.bundle.js' | asset_url }}" defer="defer"></script>

{% schema %}
  {
    "name": "Usage Easily Video",
    "class": "layer layer-container manuals video",
    "tag": "div",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Usage Easily title",
        "default": "HOW TO USE ACCESSORIES EASILY"
      }, {
        "type": "text",
        "id": "more_url",
        "label": "View More Url"
      }, {
        "type": "text",
        "id": "more_text",
        "label": "View More Text",
        "default": "VIEW MORE"
      }
    ],
    "blocks": [
      {
        "type": "VIDEO",
        "name": "Usage Easily Video",
        "settings": [
          {
            "type": "textarea",
            "id": "title",
            "label": "heading"
          }, {
            "type": "url",
            "id": "link",
            "label": "Slide link"
          }, {
            "type": "url",
            "id": "video_url",
            "label": "Video url"
          }, {
            "type": "image_picker",
            "id": "video_pic",
            "label": "Mobile Image"
          }
        ]
      }
    ]
  }
{% endschema %}