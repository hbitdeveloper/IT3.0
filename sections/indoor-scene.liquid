
    <div class="scene-left scene-detail" data-id="{{section.settings.anchor_name | handle}}">
        <h2 class="scene-title font-bold jky-text-2xl text-center">{{section.settings.title}}</h2>
        <div class="scene-subtitle text-center jky-text-sm section-container">{{section.settings.subtitle | newline_to_br}}</div>
    </div>

    <div 
        class="scene-1 scene-main {{section.settings.title | handleize}}" 
        data-class="{{section.settings.title | handleize}}"
        data-autoplay="{{section.settings.autoplay}}" 
        data-speed="{{section.settings.autoplay_speed}}"
    >
        <div class="scene-container relative">
            <div class="scene-banner absolute left-0 right-0 bottom-0 top-0 flex">
                <div class="voice-image-swiper-container overflow-x-hidden">
                    <div class="swiper-wrapper">
                        {% for block in section.blocks %}
                            <div class="swiper-slide relative">
                                {% render 'responsive-image', image: block.settings.image, mimage: block.settings.m_image, image_class: 'vocie-banner' %}
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="scene-container-content mobile-block absolute">
                    <div class="scene-container-title h3 font-bold text-center"></div>
                    <div class="scene-container-subtitle section-container text-overflow-2"></div>
                    <div class="flex scene-container-textImgs justify-center">
                        <div class="scene-container-textImg-item flex flex-col items-center">
                            <img src="" alt="" loading="lazy">
                            <span class="text-center"></span>
                        </div>
                        <div class="scene-container-textImg-item flex flex-col items-center">
                            <img src="" alt="" loading="lazy">
                            <span class="text-center"></span>
                        </div>
                        <div class="scene-container-textImg-item flex flex-col items-center">
                            <img src="" alt="" loading="lazy">
                            <span class="text-center"></span>
                        </div>
                    </div>
                    <a class="z-button-big scene-container-btn" href="#"></a>
                </div>
            </div>
    
    
            <div class="voice-list-container relative flex flex-col ">
                <div class="scene-container-content pc-block">
                    <h3 class="scene-container-title pc-block jky-text-2xl font-bold"></h3>
                    <div class="scene-container-subtitle text-overflow-3 jky-text-sm font-300"></div>
                    <div class="flex scene-container-textImgs">
                        <div class="scene-container-textImg-item flex flex-col items-center">
                            <img src="" alt="" loading="lazy">
                            <span></span>
                        </div>
                        <div class="scene-container-textImg-item flex flex-col items-center">
                            <img src="" alt="" loading="lazy">
                            <span></span>
                        </div>
                        <div class="scene-container-textImg-item flex flex-col items-center">
                            <img src="" alt="" loading="lazy">
                            <span></span>
                        </div>
                    </div>
                    <a class="z-button-big scene-container-btn" href="#"></span></a>
                </div>
    
                <div class="thumb-page-container">
                    <div class="voice-list-swiper-container swiper" thumbsSlider="">
                        <div class="swiper-wrapper flex" data-sizes="{{section.blocks.size}}">
                            {% for block in section.blocks %}
                                <div 
                                    class="swiper-slide"
                                    data-title="{{block.settings.title}}"
                                    data-subtitle="{{block.settings.subtitle}}"
                                    data-icon1="{{block.settings.icon1 | image_url: width: 75}}"
                                    data-icon1_text="{{block.settings.icon1_text}}"
                                    data-icon2="{{block.settings.icon2 | image_url: width: 75}}"
                                    data-icon2_text="{{block.settings.icon2_text}}"
                                    data-icon3="{{block.settings.icon3 | image_url: width: 75}}"
                                    data-icon3_text="{{block.settings.icon3_text}}"
                                    data-btn_txt="{{section.settings.btn_txt}}"
                                    data-link="{{block.settings.link}}"
                                    data-bg="{{block.settings.bg}}"
                                >
                                    <div class="container relative">
                                        {%- 
                                            render 'responsive-image', 
                                            image: block.settings.image,
                                            width: 312,
                                            mwidth: 140
                                        -%}
                                        <div class="absolute flex top-0 left-0 right-0 bottom-0 items-center justify-center font-bold">{{block.settings.title}}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="pagination-navigation flex">
        
                        <div class="slideshow-navigation flex">
                            <div class="slideshow-navigation-button prev">
                                {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
                            </div>
                            <div class="slideshow-pagination-voice"></div>
                            <div class="slideshow-navigation-button next">
                                {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    {% schema %}
        {
            "name": "Scene",
            "tag": "section",
            "class": "section scene-section",
            "max_blocks": 7,
            "settings": [
                {"type": "text", "id": "title", "label": "Scene name"},
                {"type": "text", "id": "anchor_name", "label": "Scene anchor name"},
                {"type": "textarea", "id": "subtitle", "label": "Scene heading"},
                {"type": "text", "id": "btn_txt", "label": "Scene button text", "default": "EXPLORE MORE"},
                {"type": "checkbox", "id": "autoplay", "label": "Auto-change slides", "default": true},
                {"type": "range", "id": "autoplay_speed", "label": "Change images every", "default": 7, "min": 5, "max": 10, "step": 1, "unit": "s"}
            ],
            "blocks": [
                {
                    "type": "scene_block", "name": "Scene Block",
                    "settings": [
                        {"type": "text", "id": "title", "label": "Scene block title"},
                        {"type": "text", "id": "subtitle", "label": "Scene block Heading"},
                        {"type": "image_picker", "id": "icon1", "label": "Scene icon1"},
                        {"type": "text", "id": "icon1_text", "label": "Scene icon1 title"},
                        {"type": "image_picker", "id": "icon2", "label": "Scene icon2"},
                        {"type": "text", "id": "icon2_text", "label": "Scene icon2 title"},
                        {"type": "image_picker", "id": "icon3", "label": "Scene icon3"},
                        {"type": "text", "id": "icon3_text", "label": "Scene icon3 title"},

                        {"type": "image_picker", "id": "image", "label": "PC Scene banner"},
                        {"type": "image_picker", "id": "m_image", "label": "Mobile Scene banner"},
                        {"type": "url", "id": "link", "label": "Slide link"},
                        {
                            "type": "color",
                            "id": "bg",
                            "label": "Background Color",
                            "default": "#2A1B09"
                        }
                    ]
                }
            ]
        }
    {% endschema %}