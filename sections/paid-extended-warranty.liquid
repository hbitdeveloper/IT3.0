{% comment %} 付费延保页 {% endcomment %}
<div class="paid-extended-warranty indoor-and-outdoor " style="background: {{ section.settings.bgColor }}">
  <div class="activity--content_item">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'banner' -%}
          {% comment %} Banner版块 - 复用five-kwh-banner {% endcomment %}
          {% render 'five-kwh-banner', banner: block.settings, new_window: section.settings.new_window %}
        {%- when 'form' -%}
          {% comment %} Form版块 {% endcomment %}
          {% render 'paid-extended-warranty-form', form: block.settings, index: forloop.index %}
        {%- when 'faq' -%}
          {% comment %} FAQ版块 - 复用indoor-faq {% endcomment %}
          {% render 'indoor-faq', faq: block.settings, index: forloop.index %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

