<style>
    .legal-person-flyer{
        padding-bottom: calc(var(--pc-padding-bottom) * 1px);
    }
    @media screen and (min-width: 1024px) and (max-width: 1439.98px){
        .legal-person-flyer{
            padding-bottom: calc( var(--pc-padding-bottom)  * 100vw / 1440 );
        }
    }
    @media screen and (max-width: 1023.98px){
        .legal-person-flyer{
            padding-bottom: calc( var(--mb-padding-bottom) * 100vw / 750 );
        }
    }
</style>

<div
  class="olight-prnews legal-person legal-person-flyer jky-12th-promotion"
  anchor="{{ section.settings.anchor | escape }}"
  style="background: {{ section.settings.bg_color }};--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};"
>
  <div class="jky-12th-container">
    {%- if section.settings.module_title != blank -%}
      <div class="module-title">
        <div class="title text-overflow-3">{{ section.settings.module_title }}</div>
        {%- if section.settings.button_text != blank -%}
          <a
            data-ga-event="home_page_user_stories4.0"
            data-ga-action="click"
            data-ga-params-module="{{ section.settings.module_title | escape }}"
            data-ga-params-button_name="{{ section.settings.button_text | escape}}"
            data-ga-params-link="{{section.settings.url }}"
            data-ga-params-type="User stories"
            class="pc-block"
            target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}"
            href="{{ section.settings.url }}"
          >
            <button class="index-button">
              <span>{{ section.settings.button_text | escape }}</span>
              <div>
                <div class="arrow">
                  <svg class="prefix__line" width="20" height="15" xmlns="http://www.w3.org/2000/svg"><path d="M12.708 0H9.063L15 6.026H0v2.431h15l-5.937 6.026h3.645L20 7.294z" class="svg-arrow" fill="#FFF" fill-rule="nonzero"/></svg>
                </div>
              </div>
            </button>
          </a>
        {% endif %}
      </div>
    {%- endif -%}

    <div class="list-box">
      {% for block in section.blocks %}
        {% if block.settings.img != blank %}
          <div class="news-item">
            {% render 'responsive-image', image: block.settings.img, image_class: 'pr-img' %}
            <div class="bottom-box">
              <div class="text text-overflow-3">{{ block.settings.title }}</div>
              {%- if block.settings.link != blank -%}
                <a
                  target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}"
                  href="{{ block.settings.link }}"
                  data-ga-event="section_blog_user_clicks"
                  data-ga-action="click"
                  data-ga-params-module="Blog"
                  data-ga-params-position="{{ block.settings.title }}"
                  data-ga-params-button_name="Circle Button"
                  data-ga-params-link="{{ block.settings.link }}"
                >
                  <div class="link">
                    <svg class="prefix__line" width="20" height="15" xmlns="http://www.w3.org/2000/svg"><path d="M12.708 0H9.063L15 6.026H0v2.431h15l-5.937 6.026h3.645L20 7.294z" class="svg-arrow" fill="#FFF" fill-rule="nonzero"/></svg>
                  </div>
                </a>
              {%- endif -%}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {%- if section.settings.button_text_mb != blank -%}
      <a target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ section.settings.url }}">
        <div class="content mb-content">
          <div>
            <div class="link"> {{ section.settings.button_text_mb | escape}} </div>
          </div>
          <svg class="prefix__mobile-block mobile-block" width="20" height="15" xmlns="http://www.w3.org/2000/svg"><path d="M12.708 0H9.063L15 6.026H0v2.431h15l-5.937 6.026h3.645L20 7.294z" fill="var(--jds-color-primary)" fill-rule="nonzero"/></svg>
        </div>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Legal Person Flyer",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "二级标题定位锚点", "info": "搭配二级导航锚点定位未使用到定位则不配置" },
    { "type": "text", "id": "module_title", "label": "模块标题" },
    { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false },
    { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 72},
    { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 120},
    { "type": "text", "id": "button_text", "label": "按钮文案PC" },
    { "type": "text", "id": "button_text_mb", "label": "按钮文案MB" },
    { "type": "url", "id": "url", "label": "跳转地址" }
  ],
  "blocks": [
    {
      "name": "pr Item",
      "type": "slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "图片"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "按钮跳转链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Legal Person Flyer"
    }
  ]
}
{% endschema %}
