{%- style -%}
  .section-flow-swiper {
    margin: 96px 0;
  }
  .section-flow-swiper .flow-swiper {
    text-align: center;
  }
  .section-flow-swiper .title {
    font-weight: 600;
    color: #1A1A1A;
    line-height: 36px;
  }
  .section-flow-swiper .flow-swiper-wrap {
    margin-top: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
  }
  .section-flow-swiper .flow-swiper-wrap .item {
    width: 335px;
    height: 480px;
    position: relative;
  }
  .section-flow-swiper .slide-image {
    background-repeat: no-repeat;
    bottom: 0;
    height: 100%;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
  }
  .section-flow-swiper .flow-swiper-wrap .item span {
    width: 100%;
    display: inline-block;
    font-size: 1.67vw;
    line-height: 2.08vw;
    font-weight: 600;
    color: #070707;
    margin-top: 40px;
    padding: 0 12px;
    word-break: break-word;
    hyphens: auto;
  }
  @media screen and (max-width: 768px) {
    .section-flow-swiper {
      margin: 12.8vw 0;
    }
    .section-flow-swiper .title {
      line-height: 6.4vw;
    }
    .section-flow-swiper .flow-swiper-wrap {
      display: none !important;
    }
    .section-flow-swiper .mob-swiper-wrap {
      margin-top: 5.3333vw;
      padding: 0 3.6vw;
    }
    .section-flow-swiper .mob-swiper-wrap .item {
      width: 100%;
      height: 32vw;
      position: relative;
      margin-bottom: 2.6667vw;
      overflow: hidden;
    }
    .section-flow-swiper .mob-swiper-wrap .item:first-of-type {
      height: 66.6667vw;
    }
    .section-flow-swiper .mob-swiper-wrap .item span {
      width: 100%;
      display: inline-block;
      font-size: 5.3333vw;
      line-height: 6.4vw;
      font-weight: 600;
      color: #000000;
      margin-top: 5.3333vw;
      padding: 0 5.3333vw;
      text-align: left;
    }
    .section-flow-swiper .mob-swiper-wrap .mob-item-box {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0 2.6667vw;
      overflow-x: auto;
    }
    .section-flow-swiper .mob-swiper-wrap .mob-item-box .item {
      width: 61.3333vw;
      height: 32vw;
      overflow: hidden;
    }
  }
{%- endstyle -%}

<div class="flow-swiper" id="flow-swiper">
  <h2 class="title jky-text-2xl font-500">{{ section.settings.title | escape }}</h2>
  {%- if section.blocks.size > 2 -%}
    <div class="flow-swiper-wrap">
      {% for block in section.blocks %}
        {%- assign img_url = block.settings.item_image | image_url: width: 1920 -%}
        <div class="item">
          <a href="{{ block.settings.link }}" class="slide-image pc-block" style="background-image: url('{{ img_url }}');">
            <span style="{% if block.settings.color != blank %}color: {{block.settings.color}} {% endif %}">{{ block.settings.image_title | newline_to_br }}</span>
          </a>
        </div>
      {% endfor %}
    </div>
    <div class="mob-swiper-wrap mobile-block">
      {%- if section.blocks.size < 5 -%}
        {% for block in section.blocks %}
          {%- assign m_img_url = block.settings.item_image_m | image_url: width: 750 -%}
          <div class="item">
            <a href="{{ block.settings.link }}" class="slide-image mobile-block" style="background-image: url('{{ m_img_url }}');">
              <span style="{% if block.settings.mob_color != blank %}color: {{block.settings.mob_color}} {% endif %}">{{ block.settings.image_title | newline_to_br }}</span>
            </a>
          </div>
        {% endfor %}
      {%- endif -%}
      {%- if section.blocks.size == 5 -%}
        {% for block in section.blocks %}
          {%- assign m_img_url = block.settings.item_image_m | image_url: width: 750 -%}
          {%- if forloop.first -%}
            <div class="item">
              <a href="{{ block.settings.link }}" class="slide-image mobile-block" style="background-image: url('{{ m_img_url }}');">
                <span style="{% if block.settings.mob_color != blank %}color: {{block.settings.mob_color}} {% endif %}">{{ block.settings.image_title | newline_to_br }}</span>
              </a>
            </div>
          {%- endif -%}
        {% endfor %}
        <div class="mob-item-box">
          {% for block in section.blocks %}
            {%- assign m_img_url = block.settings.item_image_m | image_url: width: 750 -%}
            {% if forloop.first == false %}
              <div class="item">
                <a href="{{ block.settings.link }}" class="slide-image mobile-block" style="background-image: url('{{ m_img_url }}');">
                  <span style="{% if block.settings.mob_color != blank %}color: {{block.settings.mob_color}} {% endif %}">{{ block.settings.image_title | newline_to_br }}</span>
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Flow Swiper",
  "tag": "section",
  "class": "section-flow-swiper",
  "disabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    { "type": "text", "id": "title", "label": "Title" }
  ],
  "blocks": [
    {
      "type": "flow-image-item",
      "name": "Image Item",
      "limit": 5,
      "settings": [
        { "type": "color", "id": "color", "label": "Image Title Color", "default": "#070707" },
        { "type": "color", "id": "mob_color", "label": "Image Title Mob Color", "default": "#070707" },
        { "type": "textarea", "id": "image_title", "label": "Image Title" },
        { "type": "image_picker", "id": "item_image", "label": "Image" },
        { "type": "image_picker", "id": "item_image_m", "label": "Mobile Image" },
        { "type": "url", "id": "link", "label": "Image Link" } 
      ]
    }
  ],
  "presets": [{
      "name": "Flow Swiper"
  }]
}
{% endschema %}