<style>
.track-box{
  padding: 120px 0 128px;
}
.track-box-title{
  margin-bottom: 49px;
  font-size: 32px;
  line-height: 1.1;
  color: #242F20
}
.track-repair-form{
  width: 640px;
}
.track-form-field label{
  line-height: 24px;
  font-weight: 500;
}
.track-form-field label .required-mark,
.cancel-box-desc .required-mark{
  color: #F72626;
}
.track-repair-form-item input{
  line-height: 3rem;
  border: 1px solid #C6C7C8;
  color: rgba(36, 47, 32, 0.9);
}
.form_sub_btn {
  line-height: 3rem;
  background: #C6C7C8;
  color: #fff;
}
.form_sub_btn.active{
  background: #FF6727;
  cursor: pointer;
  pointer-events: auto;
}
.form_sub_btn.loading{
  position: relative;
  color: transparent;
  pointer-events: none;
  cursor: default;
}
.form_sub_btn.loading::after{
  content: "Loading...";
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20px;
}
.track-repair-form .track-repair-form-item.error input{
  border-color: #F72626;
}
.track-repair-form .field_error-tips{
  display: block;
  margin-top: 6px;
  line-height: 1.25;
  font-size: 14px;
  color: #F72626;
}
.track-repair-form .track-result{
  margin-top: 24px;
  padding: 16px;
  background: #F5F5F5;
  border-radius: 4px;
  font-size: 16px;
  line-height: 1.5;
  color: #242F20;
  word-break: break-all;
  white-space: pre-wrap;
}
.repair-order{
  padding: 96px 0; 
}
.repair-order-desc{
  line-height: 1.1875rem
}
.repair-request-id{
  line-height: 1;
  color: #242F20;
}
.repair-request-li{
  border: 1px solid rgba(0, 0, 0, 0.3)
}
.repair-request-main{
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
  padding: 10px 24px 22px; 
}
.repair-request-info{
  max-width: 45rem;
  flex: 1 1 auto;
  min-width: 0;
}
.repair-request-right{
  flex-shrink: 0;
  max-width: 25rem;
}
.repair-request-status{
  white-space: nowrap;
}
.rma-order{
  line-height: 24px;
  color: #FF8E56;
}
.repair-product-info{
  display: flex;
  flex-direction: column;           
  gap: 17px;
} 
.repair-product-title{
  line-height: 1.1;
  color: #242F20;
}
.repair-product-num{
  line-height: 1; 
}
.repair-request-right{
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 24px;
}
.repair-request-status{
  padding: 10.5px 12px;
  background: #F5F5F3;
  color: #FF6727;
}
.repair-request-li svg{
  color: #818181; 
}
.repair-request-arrow{
  cursor: pointer;
}
.mb-svg{ display: none }
.pc-svg{ display: block }
.repair-request-li.is-expanded .repair-request-arrow{
  transform: rotate(180deg);
}
.repair-cancel-btn{
  color: rgba(0, 0, 0, 0.65)
}
.repair-tips p{
  line-height: 1.875rem; 
  font-weight: 400;
  font-size: 1.25rem;
  color: rgba(0, 0, 0, 0.65) 
}
.repair-tips a{
  text-decoration: underline;
}
.repair-steps{
  padding: 32px 72px 36px; 
  width: 100%;
  height: auto;
  background: #F5F5F5;
}
.repair-request-li.is-expanded .repair-steps{
  display: block;
}
.repair-progress-list{
  display: flex;
  flex-direction: column;
}
.repair-progress-item{
  display: flex;
  align-items: stretch;
}
.repair-progress-left{
  position: relative;
  display: flex;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 18px;
  padding-top: 5px;
  width: 21px;
}
.repair-progress-dot{
  width: 9px;
  height: 9px;
  background: #FF6727;
  border-radius: 50%;
  position: relative;
  z-index: 1;
}
.repair-progress-item.is-latest .repair-progress-dot{
  width: 21px;
  height: 21px;
  background: linear-gradient(90deg, #FFD7C7, #FF8D5D);
  position: relative;
  z-index: 1;
  margin-top: -5px;
}
.repair-progress-item.is-latest .repair-progress-dot::after{
  content: '';
  width: 9px;
  height: 9px;
  background: #FF6727;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
/* 连接竖线：锚定在整条进度项（高度由内容决定、为确定值），
   从圆点中心向下贯穿到下一圆点；圆点（z-index:1）压在线之上，
   确保上下圆点被一条连续竖线连接 */
.repair-progress-item{
  position: relative;
}
.repair-progress-item:not(:last-child)::before{
  content: '';
  position: absolute;
  left: 10.5px;               /* 左列水平中心 = 21px / 2 */
  top: 9px;                   /* 约圆点中心，避免顶部多余线头 */
  bottom: -20px;              /* 向下延伸，覆盖到下一圆点（下一圆点约在 +9.5px 处） */
  width: 2px;
  transform: translateX(-50%);
  background: #FF6727;
}
.repair-progress-content{
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-bottom: 18px;
  flex: 1;
}
.repair-progress-time{
  margin-bottom: 6px;
  line-height: 17px;
  color: rgba(0, 0, 0, 0.65)
}
.repair-progress-step{
  line-height: 19px;
  color: #242F20;
}
#cancel-pop{
  display: none;
}
#cancel-pop.is-show{
  display: flex;
}
#cancel-repair-box{
  position: relative;
  width: 640px;
  height: auto;
  padding: 64px 32px 48px;
}
.cancel-box-title{
  line-height: 1;
  color: #242F20;
}
.cancel-box-desc{
  line-height: 1;
  color: rgba(0, 0, 0, 0.65);
}
.cancel-reason-field textarea{
  padding: 13px 16px;
  height: 112px;
  line-height: 16px;
  color: #242F20;
  border: 1px solid #C6C7C8;
}
.cancel-reason-field.error textarea{
  border-color: #F72626;
}
.cancel-btn{
  width: 180px;
  height: 48px;
  line-height: 48px;
  cursor: pointer;
}
.cancel-btn-cancel{
  border: 1px solid #FF6727;
  color: #FF6727
}
.cancel-btn-confirm{
  background: #FF6727;
  color: #fff
}
.cancel-btn-confirm.loading{
  position: relative;
  color: transparent;
  pointer-events: none;
}
.cancel-btn-confirm.loading::after{
  content: "Loading...";
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 14px;
}
@media screen and (max-width: 1024px){
  .track-repair-section .section-container {
    max-width: 100%;
  }
  .track-repair-form{ 
    width: 100% 
  }
}
@media screen and (max-width: 768px){
  .track-box,.repair-order{
    padding: 2rem 0 2rem;
    min-height: 33.75rem; 
  }
  .track-box-title{
    margin-bottom: 1.46875rem;
    font-size: 1.25rem;
    line-height: 1;
  }
  .track-repair-form{
    width: 100%;
  }
  .track-form-field label{
    line-height: 1.1875rem;
  }
  .track-repair-form-item input{
    margin-top: 0.5rem;
    line-height: 2.75rem;
  }
  .track-repair-form .field_error-tips{
    font-size: 0.75rem;
  }
  .track-repair-form .track-result{
    font-size: 0.875rem;
  }
  .form_sub_btn {
    line-height: 2.5rem;
  }
  .form_sub_btn.loading::after{
    font-size: 0.875rem;
  }
  .repair-request-main{
    padding: 0.125rem 0.75rem 1.5rem 1rem; 
    flex-direction: column-reverse;
    justify-content: initial;
    align-items: flex-end;
    gap: 0.375rem;
  }
  .repair-request-info {
    width: 100%;
    max-width: 100%;
    align-self: flex-start;
  }
  .mb-svg{ display: block }
  .pc-svg{ display: none }
  .rma-order{
    line-height: 1.1875rem;
  }
  .repair-request-right{
    max-width: 100%;
  }
  .repair-product-content{
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem
  }
  .repair-product-info{
    flex-direction: row;            
    flex-wrap: wrap;                
    align-items: baseline;          
    gap: 1rem;                     
  }
  .repair-product-title{
    margin-bottom: 0;
    flex: 1 1 auto;
    line-height: 1;
    font-size: 1rem;
  }
  .repair-product-num{
    white-space: nowrap;
    flex-shrink: 0;
    align-self: flex-start;
  }
  .repair-request-status{
    margin-right: -0.625rem;
    padding: 0.3125rem 0.5rem 0.4375rem;
    white-space: normal;
  }
  
  .repair-tips p{
    line-height: 1.5rem; 
    font-size: 1rem;
  }
  .repair-steps{
    padding: 1rem 1rem 1.5rem 0.625rem;
  }
  .repair-progress-left{
    margin-right: 1rem;
  }
  .repair-progress-content{
    padding-bottom: 18px;
  }
  #cancel-repair-box{
    width: 100%;
    height: auto;
    padding: 3.125rem 1rem 3rem;
  }
  textarea{
    padding: 0.75rem;
    height: 95px;
    line-height: 1rem;
  }
  .cancel-btn{
    width: 10.3125rem;
    height: 2.5rem;
    line-height: 2.5rem;
  }
}
</style>

<div class="track-repair-section" style="background: {{ section.settings.bg_color }}">
  <div class="section-container track-box">
    <h2 class="track-box-title font-semibold text-center">
      {{ section.settings.heading | replace: '\n', '<br>' | strip }}
    </h2>

    <track-form class="track-repair-form mx-auto block">
      {% comment %} Request ID or RMA ID {% endcomment %}
      <div class="track-form-field mb-4 lg:mb-6">
        <label for="track-rma-id" class="text-base lg:text-xl">
          {{ section.settings.rma_id_label }}
          <span class="required-mark">*</span>
        </label>
        <div class="track-repair-form-item required relative">
          <input
            type="text"
            id="track-rma-id"
            name="track-rma-id"
            placeholder="{{section.settings.rma_placeholder }}"
            class="pl-4 w-full h-11 md:h-12 font-normal text-base lg:text-xl mt-2"
          >
        </div>
      </div>

      {% comment %} Email {% endcomment %}
      <div class="track-form-field mb-6 lg:mb-12">
        <label for="track-email" class="text-base lg:text-x">
          {{ section.settings.email_label }}
          <span class="required-mark">*</span>
        </label>
        <div class="track-repair-form-item required relative">
          <input
            type="email"
            id="track-email"
            name="track-email"
            placeholder="{{section.settings.email_placeholder }}"
            data-regerror="{{section.settings.email_reg_error }}"
            class="pl-4 w-full h-11 md:h-12 font-normal text-base lg:text-xl mt-2"
          >
        </div>
      </div>

      {% comment %} Submit {% endcomment %}
      <button class="form_sub_btn w-full h-10 md:h-12 text-center font-normal text-base lg:text-xl cursor-not-allowed pointer-events-none" type="button">
        {{ section.settings.submit_label | escape }}
      </button>
    </track-form>
  </div>

  <div class="section-container repair-order hidden">
    <h2 class="track-box-title repair-order-title font-semibold text-center mb-4">
      {{ section.settings.repair_order_heading | replace: '\n', '<br>' | strip }}
    </h2>
    <p class="repair-order-desc text-base font-normal text-center mb-6 lg:mb-12 ">
      {{ section.settings.repair_order_desc | replace: '\n', '<br>' | strip }}
    </p>
    <div class="repair-request-id text-left font-semibold text-base lg:text-xl lg:text-center mb-4 lg:mb-6"></div>
    <ul class="repair-request-ul mb-6 lg:mb-8"></ul>
    <div class="repair-cancel-btn font-medium underline text-base lg:text-xl text-right mb-6 lg:mb-8 cursor-pointer" style="display: none;">{{ section.settings.cancel_text }}</div>
    <div class="repair-tips font-semibold text-base lg:text-xl">{{ section.settings.repair_tips  | replace: '\n', '<br>' | strip }}</div>
  </div>

  <div id="cancel-pop" class="fixed inset-0 flex justify-center items-end lg:items-center z-[9999999999] bg-black bg-opacity-70 overflow-hidden">
    <div id="cancel-repair-box" class="bg-white overflow-hidden">
      {% comment %} 关闭按钮 {% endcomment %}
      {% render 'icon-jds-dialog-close', class: 'icon cancel-pop-close absolute right-4 top-4 w-5 h-5 md:w-9 md:h-9 cursor-pointer z-20' %}
      <div class="cancel-box-title text-xl lg:text-2xl font-semibold mb-8">{{ section.settings.cancel_label }}</div>
      <div class="cancel-box-desc text-base font-medium mb-2">
        {{ section.settings.cancel_desc }}
        <span class="required-mark">*</span>
      </div>
      <div class="cancel-reason-field w-full mb-6 lg:mb-8">
        <textarea class="w-full text-base font-medium" name="invalidReason" rows="6" maxlength="300" placeholder="{{ section.settings.cancel_desc_placeholder }}"></textarea>
      </div>
      <div class="cancel-btn-box flex justify-between lg:justify-center items-center lg:gap-4">
        <div class="cancel-btn text-sm lg:text-base font-semibold text-center cancel-btn-cancel un-ja-text">{{ section.settings.cancel_btn_label }}</div>
        <div class="cancel-btn text-sm lg:text-base font-semibold text-center cancel-btn-confirm un-ja-text">{{ section.settings.confirm_btn_label }}</div>
      </div>
    </div>
  </div>
</div>
{% comment %} 状态文案多语言：通过 Liquid `t` 过滤器把翻译注入 JSON，供 JS 动态渲染接口数据使用 {% endcomment %}
<script type="application/json" id="track-repair-status-translations">
  {
    "status_0": {{ 'self_mail_repair.order_status.status_0' | t | json }},
    "status_1": {{ 'self_mail_repair.order_status.status_1' | t | json }},
    "status_2": {{ 'self_mail_repair.order_status.status_2' | t | json }},
    "status_3": {{ 'self_mail_repair.order_status.status_3' | t | json }},
    "status_4": {{ 'self_mail_repair.order_status.status_4' | t | json }},
    "status_-1": {{ 'self_mail_repair.order_status.status_-1' | t | json }},
    "status_not": {{ 'self_mail_repair.order_status.status_not' | t | json }},
    "no_repair": {{ 'self_mail_repair.api_error.no_repair' | t | json }},
    "operation_success": {{ 'self_mail_repair.api_error.operation_success' | t | json }},
    "order_too_long": {{ 'self_mail_repair.validation_error.order_too_long' | t | json }}
  }
</script>
<script>
  if (!customElements.get('track-form')) {
    class TrackForm extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        this.rmaInput = this.querySelector('#track-rma-id');
        this.emailInput = this.querySelector('#track-email');
        this.submitBtn = this.querySelector('.form_sub_btn');
        this.emailReg = /^(?=.{1,50}$)[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
        this.debounceTimer = null;
        this.isSubmitting = false;
        this.isCancelSubmitting = false;
        this.rmaAttemptedExceed = false;
        this.lastQueryParams = {};
        this.lastQueryData = {};

        const section = this.closest('.track-repair-section');
        this.section = section;
        this.cancelBtn = section?.querySelector('.repair-cancel-btn');
        this.cancelPop = section?.querySelector('#cancel-pop');
        this.cancelReasonField = section?.querySelector('.cancel-reason-field');
        this.cancelReasonInput = section?.querySelector('textarea[name="invalidReason"]');
        this.cancelConfirmBtn = section?.querySelector('.cancel-btn-confirm');
        this.cancelCancelBtn = section?.querySelector('.cancel-btn-cancel');
        this.cancelCloseBtn = section?.querySelector('.cancel-pop-close');

        this.bindEvents();
        this.updateSubmitButton();
        this.loadStatusTranslations();

        if (this.submitBtn) {
          this.submitBtn.addEventListener('click', () => {
            this.handleSubmit();
          });
        }

        if (section) {
          section.addEventListener('click', (e) => {
            const arrow = e.target.closest('.repair-request-arrow');
            if (!arrow) return;
            const li = arrow.closest('.repair-request-li');
            if (li) li.classList.toggle('is-expanded');
          });
        }
      }

      handleSubmit() {
        if (this.isSubmitting || !this.submitBtn.classList.contains('active')) return;

        const applyOrderNo = this.rmaInput.value.trim();
        const email = this.emailInput.value.trim();
        this.lastQueryParams = { applyOrderNo, email };

        this.queryRepairOrder(applyOrderNo, email);
      }

      queryRepairOrder(applyOrderNo, email) {
        const params = new URLSearchParams({ applyOrderNo, email });
        const shopId = window.pageInfo?.shopId || window.shopId || '';
        if (shopId) {
         params.append('shopifyShopId', shopId);
        }
        const baseUrl = window.pageInfo?.api || '';
        const url = `${baseUrl}/osconsumerapi/oms/self/repair/query-repair-apply?${params.toString()}`;

        this.isSubmitting = true;
        if (this.submitBtn) this.submitBtn.classList.add('loading');

        fetch(url, { method: 'GET', credentials: 'include' }).then(response => response.json()).then(data => {
          if (this.submitBtn) this.submitBtn.classList.remove('loading');
          this.isSubmitting = false;

          if (data && data.code === 200 ) {
            this.renderRepairOrder(data);
          } else {
            if (typeof pushErrorMessage === 'function') {
              pushErrorMessage(data && data.message ? data.message : 'Query failed.');
            }
          }
        }).catch(error => {
          if (this.submitBtn) this.submitBtn.classList.remove('loading');
          this.isSubmitting = false;
          if (typeof pushErrorMessage === 'function') {
            pushErrorMessage(error.message || 'Network error.');
          }
        });
      }

      renderRepairOrder(data) {
        const responseData = data && data.data ? data.data : {};
        const requestId = responseData.applyOrderNo || '';
        const list = responseData.applyInfos || [];

        if (!list.length) {
          if (typeof pushErrorMessage === 'function') {
            pushErrorMessage(this.statusTranslations.no_repair);
          }
          return;
        }

        // 保存最新查询结果，供作废接口使用
        this.lastQueryData = {
          applyOrderNo: responseData.applyOrderNo || '',
          systemOrderNo: responseData.systemOrderNo || '',
          status: responseData.status,
          email: this.lastQueryParams.email || ''
        };

        const section = this.closest('.track-repair-section');

        const requestIdEl = section?.querySelector('.repair-request-id');
        if (requestIdEl) {
          if (requestId) {
            requestIdEl.textContent = `Request ID：${requestId}`;
            requestIdEl.style.display = '';
          } else {
            requestIdEl.style.display = 'none';
          }
        }

        const ul = section?.querySelector('.repair-request-ul');
        if (ul) {
          ul.innerHTML = list.map(item => this.renderRepairItem(item, responseData.status)).join('');
        }

        // 仅在待审核（status === 0）时展示作废按钮
        this.toggleCancelBtn(responseData.status === 0);

        const trackBox = section?.querySelector('.track-box');
        const repairOrder = section?.querySelector('.repair-order');
        if (trackBox) trackBox.style.display = 'none';
        if (repairOrder) {
          repairOrder.classList.remove('hidden');
          repairOrder.style.display = 'block';
        }
      }

      toggleCancelBtn(show) {
        if (!this.cancelBtn) return;
        this.cancelBtn.style.display = show ? 'block' : 'none';
      }

      openCancelPop() {
        if (this.cancelPop) this.cancelPop.classList.add('is-show');
        if (this.cancelReasonInput) this.cancelReasonInput.value = '';
        this.clearCancelReasonError();
      }

      closeCancelPop() {
        if (this.cancelPop) this.cancelPop.classList.remove('is-show');
        if (this.cancelReasonInput) this.cancelReasonInput.value = '';
        this.clearCancelReasonError();
      }

      clearCancelReasonError() {
        if (this.cancelReasonField) this.cancelReasonField.classList.remove('error');
      }

      showCancelReasonError() {
        if (this.cancelReasonField) this.cancelReasonField.classList.add('error');
      }

      handleCancelConfirm() {
        if (this.isCancelSubmitting) return;

        const reason = this.cancelReasonInput?.value.trim() || '';
        if (!reason) {
          this.showCancelReasonError();
          return;
        }
        this.clearCancelReasonError();

        const { applyOrderNo, systemOrderNo, email } = this.lastQueryData || {};
        if (!applyOrderNo || !systemOrderNo || !email) {
          if (typeof pushErrorMessage === 'function') {
            pushErrorMessage('Missing required order information.');
          }
          return;
        }

        const baseUrl = window.pageInfo?.api || '';
        const url = `${baseUrl}/osconsumerapi/oms/self/repair/invalid-repair-apply`;
        const body = { systemOrderNo, applyOrderNo, email, invalidReason: reason };

        this.isCancelSubmitting = true;
        if (this.cancelConfirmBtn) this.cancelConfirmBtn.classList.add('loading');

        fetch(url, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        }).then(response => response.json()).then(data => {
          if (this.cancelConfirmBtn) this.cancelConfirmBtn.classList.remove('loading');
          this.isCancelSubmitting = false;

          if (data && data.code === 200) {
            if (typeof pushSuccessMessage === 'function') {
              pushSuccessMessage(this.statusTranslations.operation_success || data.message || 'Cancelled successfully.');
            }
            this.closeCancelPop();
            // 重新查询刷新状态
            this.queryRepairOrder(applyOrderNo, email);
          } else {
            if (typeof pushErrorMessage === 'function') {
              pushErrorMessage(data && data.message ? data.message : 'Cancel failed.');
            }
          }
        }).catch(error => {
          if (this.cancelConfirmBtn) this.cancelConfirmBtn.classList.remove('loading');
          this.isCancelSubmitting = false;
          if (typeof pushErrorMessage === 'function') {
            pushErrorMessage(error.message || 'Network error.');
          }
        });
      }

      renderRepairItem(item, topStatus) {
        const rmaId = this.escapeHtml(item.rmaCode || '');
        const status = this.formatStatus(topStatus);
        const products = (item.items || []).map(product => this.renderProductInfo(product)).join('');
        const progressNodes = item.progressNodes || [];
        const progressHtml = progressNodes.length ? this.renderProgressNodes(progressNodes) : '';
        const arrowSvg = `<svg class="repair-request-arrow mb-svg transition-transform duration-300 w-5 h-5" width="56" height="56" viewBox="0 0 56 56" xmlns="http://www.w3.org/2000/svg"><g fill="none" fill-rule="evenodd"><path d="M27.88 40.753a2.3 2.3 0 001.686-.734l19.487-20.07a2.22 2.22 0 00.68-1.62c0-.44-.1-.836-.302-1.19a2.228 2.228 0 00-.818-.835A2.265 2.265 0 0047.442 16c-.621 0-1.167.22-1.637.658L26.52 36.475h2.694L9.928 16.658A2.268 2.268 0 008.29 16c-.436 0-.827.101-1.17.304-.345.202-.617.48-.819.835-.201.354-.302.75-.302 1.19a2.287 2.287 0 00.68 1.645l19.487 20.045c.504.489 1.074.734 1.712.734z" fill="currentColor" fill-rule="nonzero"></path><path d="M0 0h56v56H0z"></path></g></svg>`;
        const arrowSvgDesktop = `<svg class="repair-request-arrow pc-svg block transition-transform duration-300 w-4 h-4" width="56" height="56" viewBox="0 0 56 56" xmlns="http://www.w3.org/2000/svg"><g fill="none" fill-rule="evenodd"><path d="M27.88 40.753a2.3 2.3 0 001.686-.734l19.487-20.07a2.22 2.22 0 00.68-1.62c0-.44-.1-.836-.302-1.19a2.228 2.228 0 00-.818-.835A2.265 2.265 0 0047.442 16c-.621 0-1.167.22-1.637.658L26.52 36.475h2.694L9.928 16.658A2.268 2.268 0 008.29 16c-.436 0-.827.101-1.17.304-.345.202-.617.48-.819.835-.201.354-.302.75-.302 1.19a2.287 2.287 0 00.68 1.645l19.487 20.045c.504.489 1.074.734 1.712.734z" fill="currentColor" fill-rule="nonzero"></path><path d="M0 0h56v56H0z"></path></g></svg>`;

        return `
          <li class="repair-request-li mb-6 ${progressNodes.length ? 'has-progress' : ''}">
            <div class="repair-request-main">
              <div class="repair-request-info">
                <div class="rma-order font-medium mb-2 text-base lg:text-xl">${rmaId}</div>
                <div class="repair-product-content">
                  ${products}
                  ${arrowSvg}
                </div>
              </div>
              <div class="repair-request-right">
                <div class="repair-request-status font-medium text-sm lg:text-xl">${status}</div>
                ${arrowSvgDesktop}
              </div>
            </div>
            <div class="repair-steps hidden">
              ${progressHtml}
            </div>
          </li>
        `;
      }

      renderProgressNodes(nodes) {
        const reversed = [...nodes].reverse();
        const items = reversed.map((node, index) => this.renderProgressItem(node, index === 0)).join('');
        return `
          <div class="repair-progress-list">
            ${items}
          </div>
        `;
      }

      renderProgressItem(node, isLatest) {
        const time = this.formatProgressTime(node.nodeTimeLong || node.nodeTime);
        const stepText = node.nodeName || node.step || this.formatStatus(node.node);
        const step = this.escapeHtml(stepText);
        return `
          <div class="repair-progress-item ${isLatest ? 'is-latest' : ''}">
            <div class="repair-progress-left">
              <div class="repair-progress-dot"></div>
            </div>
            <div class="repair-progress-content">
              <div class="repair-progress-time text-sm font-normal">${time}</div>
              <div class="repair-progress-step text-base font-semibold">${step}</div>
            </div>
          </div>
        `;
      }

      formatProgressTime(value) {
        if (!value) return '';
        const ms = String(value).length === 10 ? Number(value) * 1000 : Number(value);
        const date = new Date(ms);
        if (isNaN(date.getTime())) return String(value);
        return date.toLocaleString('en-US', {
          timeZone: 'America/Los_Angeles',
          month: 'short',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit',
          hour12: true
        }).replace(/,\s*/, ', ');
      }

      renderProductInfo(product) {
        const title = this.escapeHtml(product.productName || '');
        const quantity = product.quantity || 1;
        return `
          <div class="repair-product-info">
            <div class="repair-product-title text-base md:text-xl font-semibold">${title}</div>
            <div class="repair-product-num font-medium text-base">x${quantity}</div>
          </div>
        `; 
      }

      loadStatusTranslations() {
        this.statusTranslations = {};
        const el = document.getElementById('track-repair-status-translations');
        if (!el) return;
        try {
          this.statusTranslations = JSON.parse(el.textContent.trim()) || {};
        } catch (e) {
          this.statusTranslations = {};
        }
      }

      formatStatus(statusCode) {
        const key = statusCode !== undefined && statusCode !== null && statusCode !== ''
          ? `status_${statusCode}`
          : 'status_not';
        return this.statusTranslations[key] || this.statusTranslations.status_not || String(statusCode || '');
      }

      escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      bindEvents() {
        if (this.emailInput) {
          this.emailInput.addEventListener('input', () => {
            this.clearFieldError(this.emailInput);
            this.debounceValidateEmail();
            this.updateSubmitButton();
          });
          this.emailInput.addEventListener('blur', () => {
            clearTimeout(this.debounceTimer);
            this.validateEmail();
            this.updateSubmitButton();
          });
        }

        if (this.rmaInput) {
          this.rmaInput.addEventListener('beforeinput', (e) => {
            if (e.isComposing) return;
            const data = e.data || '';
            const start = this.rmaInput.selectionStart || 0;
            const end = this.rmaInput.selectionEnd || 0;
            const selectedLength = end - start;
            const newLength = this.rmaInput.value.length - selectedLength + data.length;
            if (newLength > 50) {
              e.preventDefault();
              this.rmaAttemptedExceed = true;
              this.showFieldError(this.rmaInput, this.statusTranslations.order_too_long || 'Order number is too long.');
            }
          });
          this.rmaInput.addEventListener('input', (e) => {
            if (!e.isComposing) {
              this.filterRmaValue();
            }
            this.updateSubmitButton();
          });
          this.rmaInput.addEventListener('compositionend', () => {
            this.filterRmaValue();
            this.updateSubmitButton();
          });
          this.rmaInput.addEventListener('blur', () => {
            this.rmaAttemptedExceed = false;
            this.filterRmaValue();
            this.updateSubmitButton();
          });
        }

        // 作废按钮：打开弹窗
        if (this.cancelBtn) {
          this.cancelBtn.addEventListener('click', () => this.openCancelPop());
        }

        // 弹窗关闭
        if (this.cancelCancelBtn) {
          this.cancelCancelBtn.addEventListener('click', () => this.closeCancelPop());
        }
        if (this.cancelCloseBtn) {
          this.cancelCloseBtn.addEventListener('click', () => this.closeCancelPop());
        }
        if (this.cancelPop) {
          this.cancelPop.addEventListener('click', (e) => {
            if (e.target === this.cancelPop) this.closeCancelPop();
          });
        }

        // 确认作废
        if (this.cancelConfirmBtn) {
          this.cancelConfirmBtn.addEventListener('click', () => this.handleCancelConfirm());
        }
      }

      debounceValidateEmail() {
        clearTimeout(this.debounceTimer);
        this.debounceTimer = setTimeout(() => {
          this.validateEmail();
          this.updateSubmitButton();
        }, 1000);
      }

      validateEmail() {
        const value = this.emailInput.value.trim();
        if (!value) {
          this.clearFieldError(this.emailInput);
          return false;
        }
        if (!this.emailReg.test(value)) {
          this.showFieldError(this.emailInput, this.emailInput.getAttribute('data-regerror'));
          return false;
        }
        this.clearFieldError(this.emailInput);
        return true;
      }

      validateRmaId() {
        const value = this.rmaInput.value.trim();
        if (!value) {
          this.clearFieldError(this.rmaInput);
          return false;
        }
        return true;
      }

      filterRmaValue() {
        const value = this.rmaInput.value;
        let cleaned = value.replace(/[\u4e00-\u9fa5]/g, '');

        if (cleaned.length > 50) {
          cleaned = cleaned.slice(0, 50);
          this.rmaAttemptedExceed = true;
        }

        if (cleaned !== value) {
          this.rmaInput.value = cleaned;
        }

        if (cleaned.length < 50) {
          this.rmaAttemptedExceed = false;
        }

        if (this.rmaAttemptedExceed) {
          this.showFieldError(this.rmaInput, this.statusTranslations.order_too_long || 'Order number is too long.');
        } else {
          this.clearFieldError(this.rmaInput);
        }
      }

      showFieldError(input, message) {
        const field = input.closest('.track-repair-form-item');
        if (!field || !message) return;
        field.classList.add('error');
        let errorTip = field.querySelector('.field_error-tips');
        if (!errorTip) {
          errorTip = document.createElement('div');
          errorTip.classList.add('field_error-tips', 'text-overflow-2');
          field.appendChild(errorTip);
        }
        errorTip.innerText = message;
      }

      clearFieldError(input) {
        const field = input.closest('.track-repair-form-item');
        if (!field) return;
        field.classList.remove('error');
        const errorTip = field.querySelector('.field_error-tips');
        if (errorTip) errorTip.remove();
      }

      updateSubmitButton() {
        const rmaValue = this.rmaInput?.value.trim() || '';
        const emailValue = this.emailInput?.value.trim() || '';
        const isEmailValid = this.emailReg.test(emailValue);
        const isValid = rmaValue && emailValue && isEmailValid;

        this.submitBtn?.classList.toggle('active', isValid);
        this.submitBtn?.classList.toggle('cursor-not-allowed', !isValid);
        this.submitBtn?.classList.toggle('pointer-events-none', !isValid);
      }
    }

    customElements.define('track-form', TrackForm);
  }
</script>

