<link
        rel="stylesheet"
        href="{{ 'sections-ehb-faq.css' | asset_url }}"
        media="print"
        onload="this.media='all'">
<noscript>
  {{ 'sections-ehb-faq.css' | asset_url | stylesheet_tag }}
</noscript>
{%- assign product = faq.product -%}
{%- assign faq_num = 0 -%}
{%- for item in product.metafields.custom.faq.value -%}
  {%- assign faq_num = faq_num | plus: 1 -%}
{%- endfor -%}

<div 
    class="section-container-lg"
    {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
>
    {% render 'indoor-faq', faq: section.settings, index: 1 %}
</div>
 
