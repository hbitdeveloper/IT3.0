{% comment %} 日本防灾日 banner组件 {% endcomment %}
{% schema %}
{
  "name": "DP Banner",
  "tag": "section",
  "class": "dp-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "imgPC",
      "label": "Image (PC)"
    },
    {
      "type": "image_picker",
      "id": "imgMB",
      "label": "Image (MB)"
    },
    {
      "type": "image_picker",
      "id": "smallImgPC",
      "label": "Small Image(PC)"
    },
    {
      "type": "image_picker",
      "id": "smallImgMB",
      "label": "Small Image(MB)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "btnAnchor",
      "label": "Anchor"
    }
  ]
}
{% endschema %}

<div class="dp-banner-box">
  {% render 'diff-end-img', pc_img: section.settings.imgPC, mb_img: section.settings.imgMB ,class:'dp-banner-img',load_scene: 'lcp' %}
  <div class="small-box">
    {% comment %} 输出超链接 {% endcomment %}
    {% if section.settings.link != blank %}
      {%- assign btnLink = section.settings.link -%}
      {%- assign gaLink = section.settings.link -%}
    {% endif %}
    {% comment %} 锚点按钮，则直接跳转当前页锚点即可，无需输出超链接 {% endcomment %}
    {% if section.settings.btnAnchor != blank %}
      {%- assign btnLink = 'javascript:void(0);' -%}
      {%- assign gaLink = section.settings.btnAnchor -%}
    {% endif %}

    <a
      data-ga-event="JP_bousai_user_clicks"
      data-ga-action="click"
      data-ga-params-module="TopBanner"
      data-ga-params-button_name="TriangleButton"
      data-ga-params-link="{{ gaLink }}"
      href="{{ btnLink }}"
      {% if section.settings.btnAnchor != blank %} data-anchor="{{ section.settings.btnAnchor }}" {% endif %}
      class="btn-link"
    >
      {% render 'responsive-image', image: section.settings.smallImgPC, mimage: section.settings.smallImgMB %}
    </a>
  </div>
</div>
