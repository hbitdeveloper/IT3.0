{% comment %} For Any Situation {% endcomment %}
<div class="batch-purchase--situation">
    <div class="batch-purchase-container">
        <div class="situation-text">
            <div class="title">{{ section.settings.situation_title | escape}}</div>
            <div class="sub-info">
                {{ section.settings.situation_sub_title | replace: '<em>', '<em class="special">' }}
            </div>
        </div>
        <div class="situation-block">
          {% for block in section.blocks %}
            <div class="situation-item">
                <div class="title">{{ block.settings.title | escape}}</div>
                {%- 
                  render 'responsive-image', 
                  image: block.settings.pc_image, 
                  mimage: block.settings.m_image, 
                  width: 280, 
                  mwidth: 220
                -%}
            </div>
          {% endfor %}
        </div>
    </div>
</div>

{% schema %}
  {
    "name": "Batch Purchase Situation",
    "tag": "div",
    "settings": [
      {
        "type": "text",
        "id": "situation_title",
        "label": "Situation Title",
        "default": "FOR ANY SITUATION"
      }, {
        "type": "richtext",
        "id": "situation_sub_title",
        "label": "Situation Sub Title"
      }
    ],
    "blocks": [
      {
        "name": "List Item",
        "type": "slide",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Section Title"
          }, {
            "type": "image_picker",
            "id": "pc_image",
            "label": "PC Image (394x435)"
          }, {
            "type": "image_picker",
            "id": "m_image",
            "label": "Mobile Image(280x310)"
          }
        ]
      }
    ]
  }
{% endschema %}