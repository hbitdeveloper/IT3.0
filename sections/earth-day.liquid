<!-- banner模块 -->
<div class="ed-banner">
  <img src="https://i.shgcdn.com/cc63bfa2-fa79-48af-8cbc-872056c3123f/-/format/auto/-/preview/3000x3000/-/quality/lighter/" alt="">
</div>

<!-- 意向减碳模块 -->
<div class="ed-lattice-content">
  <div class="ed-lattice-title earth-i18n" data-i18n="NineHouseLattice.FirstTitle"></div>
  <div class="ed-lattice-prompt">
    <p class="earth-i18n" data-i18n="NineHouseLattice.FirstPrompt1"></p>
    <p class="earth-i18n" data-i18n="NineHouseLattice.FirstPrompt2"></p>
  </div>
  <div class="ed-lattice"></div>
  <div class="ed-lattice-btn">
    <button class="earth-i18n" data-i18n="NineHouseLattice.FirstBtn"></button>
  </div>
  <div class="ed-lattice-vote earth-i18n ed-text-base ed-flex-center" data-i18n="NineHouseLattice.FirstSuccess" data-i18nHtml="true"></div>
</div>
<!--投票-->
<div class="ed-vote-content">
  <div class="ed-header">
    <h3 class="ed-header-title font-bold ed-text-5xl earth-i18n" data-i18n="VOTE.VOTETITLE"></h3>
    <div class="ex-header-desc-wrap">
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="VOTE.VOTEDESCIPTION"></p>
    </div>
  </div>
  <div class="ed-vote-center">
    <div class="ed-vote-main-wrap">
      <ul class="ed-vote-main">
        <li class="ed-vote-item" data-key="1" data-checked="0">
          <div class="ed-vote-item-name">
            <div class="ed-vote-item_logo">
              <img/>
            </div>
            <p class="ed-vote-item_maintitle earth-i18n" data-i18n="VOTE.VOTETREE"></p>
          </div>
          <div class="ed-vote-item-desc">
            <div class="ed-vote-item_logo">
              <img/>
            </div>
            <h3 class="ed-vote-item-desc_title  earth-i18n" data-i18n="VOTE.VOTEITEMTITLE1"></h3>
            <p class="earth-i18n"  data-i18n="VOTE.VOTEITEMDESCRIBE1"></p>
            <div class="ed-vote-item_logo">
              <img/>
            </div>
          </div>
          <div class="ed-vote-card-checked">
            <img src="./images/ed-vote-checked.png" />
            <span class="earth-i18n" data-i18n="VOTE.VOTEITEMCHECKED"></span>
          </div>
        </li>
        <li class="ed-vote-item" data-key="2" data-checked="0">
          <div class="ed-vote-item-name">
            <div class="ed-vote-item_logo">
              <img/>
            </div>
            <p class="ed-vote-item_maintitle earth-i18n" data-i18n="VOTE.VOTEEDUCATION"></p>
          </div>
          <div class="ed-vote-item-desc">
            <div class="ed-vote-item_logo">
              <img/>
            </div>
            <h3 class="ed-vote-item-desc_title  earth-i18n" data-i18n="VOTE.VOTEITEMTITLE2"></h3>
            <p class="earth-i18n"  data-i18n="VOTE.VOTEITEMDESCRIBE2"></p>
            <div class="ed-vote-item_logo">
              <img/>
            </div>
          </div>
          <div class="ed-vote-card-checked">
            <img src="./images/ed-vote-checked.png" />
            <span class="earth-i18n" data-i18n="VOTE.VOTEITEMCHECKED"></span>
          </div>
        </li>
        <li class="ed-vote-item" data-key="3" data-checked="0">
          <div class="ed-vote-item-name">
            <div class="ed-vote-item_logo">
              <img/>
            </div>
            <p class="ed-vote-item_maintitle earth-i18n" data-i18n="VOTE.VOTEPRODUCT"></p>
          </div>
          <div class="ed-vote-item-desc">
            <div class="ed-vote-item_logo">
              <img/>
            </div>
            <h3 class="ed-vote-item-desc_title  earth-i18n" data-i18n="VOTE.VOTEITEMTITLE3"></h3>
            <p class="earth-i18n"  data-i18n="VOTE.VOTEITEMDESCRIBE3"></p>
            <div class="ed-vote-item_logo">
              <img/>
            </div>
          </div>
          <div class="ed-vote-card-checked">
            <img src="./images/ed-vote-checked.png" />
            <span class="earth-i18n" data-i18n="VOTE.VOTEITEMCHECKED"></span>
          </div>
        </li>
        <li class="ed-vote-item" data-key="4" data-checked="0">
          <div class="ed-vote-item-name">
            <div class="ed-vote-item_logo">
              <img/>
            </div>
            <p class="ed-vote-item_maintitle earth-i18n" data-i18n="VOTE.VOTEANIMALS"></p>
          </div>
          <div class="ed-vote-item-desc">
            <div class="ed-vote-item_logo">
              <img/>
            </div>
            <h3 class="ed-vote-item-desc_title  earth-i18n" data-i18n="VOTE.VOTEITEMTITLE4"></h3>
            <p class="earth-i18n"  data-i18n="VOTE.VOTEITEMDESCRIBE4"></p>
            <div class="ed-vote-item_logo">
              <img/>
            </div>
          </div>
          <div class="ed-vote-card-checked">
            <img src="./images/ed-vote-checked.png" />
            <span class="earth-i18n" data-i18n="VOTE.VOTEITEMCHECKED"></span>
          </div>
        </li>
      </ul>
    </div>
  </div>
  <div class="ed-vote-submit">
    <div class="ed-vote-submit-wrap">
      <form class="ed-vote-form">
        <input class="ed-vote-input earth-i18n ed-text-xl font-400" type="text" id="email" data-i18n="VOTE.VOTEINPUTPLACEHOLDER" />
      </form>
      <div class="ed-vote-btn-wrap">
        <button class="ed-vote-submitbtn earth-i18n" data-i18n="NineHouseLattice.FirstBtn"></button>
        <span class="ed-vote-submit-icon"></span>
      </div>
    </div>
  </div>
  <div class="ed-vote-protocol">
    <div class="ed-vote-chekcobx">
      <span class="ed-vote-chekcobx-wrap is-checked">
        <input type="checkbox" class="ed-checkbox_input" />
      </span>
      <label class="ed-vote-chekcobx-label ed-text-base font-thin">
        <span class="earth-i18n" data-i18n="VOTE.VOTEPROTOCOLLABEL"></span>
      </label>
    </div>
  </div>
</div>
<!-- 奖品 -->
<div class="ed-prize">
  <div class="ed-header">
    <h3 class="ed-header-title font-bold ed-text-5xl earth-i18n" data-i18n="PRIZE.PRIZE_TITLE"></h3>
    <div class="ex-header-desc-wrap">
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="PRIZE.PRIZE_PROMPT1"></p>
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="PRIZE.PRIZE_PROMPT2"></p>
    </div>
  </div>
  <div class="ed-prize-content">
      <div class="ed-prize-content-l ed-flex-center">
          <img src="./images/ed-prize-l-bg.png" alt="">
      </div>
      <div class="ed-prize-content-r">
        <div class="ed-prize-content-r-text">
          <p class="font-bold ed-text-4xl earth-i18n" data-i18n="PRIZE.PRIZE_CONTENT_TITLE"></p>
        </div>
        <div class="ed-prize-content-r-display">
          <p class="ed-prize-content-r-display-title font-bold ed-text-3xl earth-i18n" data-i18n="PRIZE.PRIZE_DISPLAY_TITLE"></p>
          <div class="ed-prize-content-r-display-content ed-flex-between"></div>
          <div class="ed-prize-content-r-btn">
            <button class="ed-flex-center">
              <img src="./images/ed-checkbox.png" alt="">
              <span class="earth-i18n" data-i18n="PRIZE.PRIZE_DISPLAY_BTN"></span>
            </button>
            <div class="ed-share"></div>
          </div>
        </div>
      </div>
  </div>
</div>
<!-- rank -->
<div class="ed-rank-content">
  <div class="ed-header">
    <h3 class="ed-header-title font-bold ed-text-5xl earth-i18n" data-i18n="RANK.RANKTITLE"></h3>
    <div class="ex-header-desc-wrap">
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="RANK.RANKDESCIPTION"></p>
    </div>
  </div>
  <div class="ed-rank-center">
    <div class="ed-rank-center_l">
      <div class="ed-rank-module-header">
        <h3 class="ed-rank-header-title ed-text-3xl font-bold earth-i18n" data-i18n="RANK.RANKLEFTTITLE"></h3>
        <p id="supporters" class="ed-rank-header_desc ed-text-base font-400 earth-i18n" data-i18n="RANK.RANKLEFTDESC"></p>
      </div>
      <div class="ed-rank-list">

      </div>
    </div>
    <div class="ed-rank-center_r">
      <div class="ed-rank-module-header">
        <h3 class="ed-rank-header-title ed-text-3xl font-bold earth-i18n" data-i18n="RANK.RANKRIGHTTITLE"></h3>
        <p class="ed-rank-header_desc ed-text-base font-400 earth-i18n" data-i18n="RANK.RANKRIGHTDESC"></p>
      </div>
      <div class="ed-rank-prize"></div>
    </div>
  </div>
</div>
<!-- more way -->
<div class="ed-moreway-content">
  <div class="ed-header">
    <h3 class="ed-header-title font-bold ed-text-5xl earth-i18n" data-i18n="MOREWAY.MOREWAYTITLE"></h3>
  </div>
  <div class="ed-moreway-main">

  </div>
</div>

<!-- 智能选购 -->
{% render 'help-to-choose', chooseIpImage: section.settings.help_choose_ip, rechargingIcon: section.settings.recharging_icon, savingIcon: section.settings.energy_saving_icon, carbonIcon: section.settings.carbon_reduction_icon, %}

<!-- explore -->
<div class="ed-explore-content">
  <div class="ed-header">
    <h3 class="ed-header-title font-bold ed-text-5xl earth-i18n" data-i18n="EXPLORE.EXPLORETITLE"></h3>
  </div>
  <div class="ed-explore-main">

  </div>
</div>

{% schema %}
{
    "name": "Earth Day",
    "class": "section section-earth-day",
    "settings": [
        {"type": "image_picker", "id": "help_choose_ip", "label": "Help Choose IP Image"},
        {"type": "image_picker", "id": "recharging_icon", "label": "Recharging Icon Image"},
        {"type": "image_picker", "id": "energy_saving_icon", "label": "Energy Saving Icon Image"},
        {"type": "image_picker", "id": "carbon_reduction_icon", "label": "Carbon Reduction Icon Image"}
    ]
}
{% endschema %}
