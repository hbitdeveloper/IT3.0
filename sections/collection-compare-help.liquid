{%
    render 'help-to-choose',
    title: section.settings.help_choose_title,
    chooseIpImage: section.settings.help_choose_ip,
    rechargingIcon: section.settings.recharging_icon,
    savingIcon: section.settings.energy_saving_icon,
    des: section.settings.des
%}
{% comment %} Compare and Help Choose {% endcomment %}
<div class="lg:j-pt-120 bg-white">
    <ul class="w-full lg:j-w-1200 mx-auto grid grid-cols-1 lg:grid-cols-2 gap-y-65 lg:j-gap-x-20">
        <li class="bg-f5 relative ">
            <div class="w-full lg:j-pr-60 after:block after:absolute after:left-0 after:top-0 after:right-0 after:bottom-0 after:bg-black/50 after:lg:bg-transparent">
                {%- 
                    render 'responsive-image', 
                    image: section.settings.compare_img, 
                    mimage: section.settings.m_compare_img, 
                    width: 590, 
                    mwidth: 345,
                    image_class: "w-full h-auto object-cover"
                -%}
            </div>
            <div class="w-full absolute left-1/2 -translate-x-1/2 top-60 lg:static lg:!translate-x-0 flex-center flex-col lg:j-p-60">
                <h2 class="w-full text-36 leading-54 text-white lg:j-text-36 lg:j-leading-54 lg:text-black font-500 text-center mb-50 lg:j-mb-50">{{section.settings.compare_title | newline_to_br}}</h2>

                <a class="z-button-big font-600" style="margin:0 auto;" href="{{ section.settings.compare_link }}">{{section.settings.compare_btn | escape}}
                     <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
                    </a>
            </div>
        </li>
        <li class="bg-f5">
            <div class="w-full pr-60 lg:j-pr-60">
                {%- 
                    render 'responsive-image', 
                    image: section.settings.choose_img, 
                    mimage: section.settings.m_choose_img, 
                    width: 590, 
                    mwidth: 345,
                    image_class: "w-full h-auto object-cover"
                -%}
            </div>
            <div class="flex-center flex-col p-65 lg:j-p-60">
                <h2 class="text-36 leading-54 lg:j-text-32 lg:j-leading-54 text-black font-500 text-center mb-50 lg:j-mb-50">{{section.settings.choose_title | newline_to_br}}</h2>
                <a class="z-button-big font-600" style="margin: 0 auto;" href="{{ section.settings.choose_link }}">{{section.settings.choose_btn | escape}} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></a>
            </div>
        </li>
    </ul>
</div>
{% schema %}
{
    "name": "Compare And Help",
    "class": "section section-compare-and-help section-sp-pps-sg-collection",
    "settings": [
        {
            "type": "textarea",
            "id": "help_choose_title",
            "label": "Help To Choose Title",
            "default": "How Many Solar Panels Do I Need"
        },
        {"type": "image_picker", "id": "help_choose_ip", "label": "Help Choose IP Image"},
        {"type": "image_picker", "id": "recharging_icon", "label": "Recharging Icon Image"},
        {"type": "image_picker", "id": "energy_saving_icon", "label": "Energy Saving Icon Image"},

        {"type": "image_picker", "id": "compare_img", "label": "PC Compare Product image"},
        {"type": "image_picker", "id": "m_compare_img", "label": "Mobile Compare Product image"},
        {"type": "textarea", "id": "compare_title", "label": "Product Compare Heading", "default": "Want To Compare For\nA Decision"},
        {"type": "text", "id": "compare_btn", "label": "Product Compare Button text", "default": "PRODUCT COMPARE"},
        {"type": "url", "id": "compare_link", "label": "Compare Link"},

        {"type": "image_picker", "id": "choose_img", "label": "PC Choose Product image"},
        {"type": "image_picker", "id": "m_choose_img", "label": "Mobile Choose Product image"},
        {"type": "textarea", "id": "choose_title", "label": "Product Choose Heading", "default": "Find the Jackery products\nthat suit you best"},
        {"type": "text", "id": "choose_btn", "label": "Product Choose Button text", "default": "HELP YOU CHOOSE"},
        {"type": "url", "id": "choose_link","label": "Choose Link"},
        {"type": "text", "id": "des","label": "Description"}
    ]
}
{% endschema %}
