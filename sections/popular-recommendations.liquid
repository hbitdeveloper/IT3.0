

<style>
    .popular-title{
        line-height: 3.125rem;
        font-size: 2.5rem;
    }
    .popular-swiper-products .swiper-slide {
        width: 312px;
    }
    .mian-top{
       background-color: #FF864E;
    }
    .mian-top span{
        line-height: 40px!important;
        box-sizing: border-box;
    }
    .mian-top-ranking{
        padding-left: 27px;
        width: 110px;
        background-color: #FD5102;
        clip-path: polygon(0 0, 100% 0, 80% 100%, 0 100%);
    }
    .mian-top-capacity {
        padding-right: 16px;
        font-size: 18px
    }
    .popular-main-image{
        w1dth: 272px;
        height: 272px;
    }
    .popular-products-group .product-tag-text{
        top: 56px;
    }
    .popular-products-group .product-tag-text .product-label-tag-text{
        font-size: 18px;
    }
    .popular-products-group .product-tag-img{
        top: 45px;
        width: 176px;
    }
    .popular-content-info .title{
        height: 46px;
        line-height: 23px!important;
        font-size: 16px;
    }
    .popular-current-price{
        margin-right: 2px;
        line-height: 28px;
        font-size: 20px;
    }
    /*.popular-origin-price{
        margin-left: 9px
    }*/
    .popular-current-price,
    .suffix-text{
        color: var(--primary-color)
    }
    .suffix-text{
        margin-right: 9px;
    }
    .popular-swiper-navigation{
        position: absolute;
        top: 158px;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 48px;
        height: 48px;
        border: 2px solid rgba(255,255,255,0.4);
        background: rgba(102, 102, 102, 0.2);
        border-radius: 50%;
        box-sizing: border-box;
        z-index: 1;
        cursor: pointer;
    }
    .popular-product-prev{
        left: 0;
    }
    .popular-product-next{
        right: 0;
    }
