<style>
    @media screen and (min-width: 1024px) {
        .v5-5000plus-three-images .v-column-layout-container .blocks-heading-content {
            position: absolute;
            transform: translateY(var(--y-axis-position));
            transition: transform 0.3s ease;
        }

        .v5-5000plus-three-images .v-column-layout-container .blocks-heading-content .blocks-content-des {
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .v5-5000plus-three-images .v-column-layout-container .v-block-container:hover .blocks-heading-content {
            transform: translateY(calc(-35.3125rem + 40px));
        }

        .v5-5000plus-three-images .v-column-layout-container .v-block-container:hover .blocks-heading-content .blocks-content-des {
            opacity: 1;
        }
    }

    @media screen and (max-width: 1023.98px) {
      .v5-5000plus-three-images .v-column-layout-container .blocks-content-heading p {
        color: #242F20;
      }

      .v5-5000plus-three-images .v-column-layout-container .blocks-content-des p {
        color: #3a4437;
      }
    }
</style>

{% content_for 'blocks' %}

<script type="module">

    document.addEventListener('DOMContentLoaded', () => {
        const titles = document.querySelectorAll(".v5-5000plus-three-images .blocks-content-heading");
        titles.forEach(title => {
            const titleHeight = title.offsetHeight;
            const parentEle = title.parentElement;
            parentEle.style.bottom = `-${parentEle.offsetHeight}px`;
            parentEle.style.setProperty('--y-axis-position', `-${titleHeight}px`);
        })
    });

</script>

