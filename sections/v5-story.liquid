{{ 'sections-v5-story.css' | asset_url | stylesheet_tag }}
<div class="v5-story" {{ section.shopify_attributes }} anchor-target="{{section.settings.anchor | escape}}">
  <v5-stories>
    <div class="stories-section">
      {%- if section.settings.sub -%}
        <div class="stories-sub-title">{{ section.settings.sub }}</div>
      {%- endif -%}
      <div class="stories-title v5-font-oxm">{{ section.settings.title }}</div>
      <div class="swiper stories-swiper-v5">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {%- if block.settings.title != blank -%}
              <div class="swiper-slide">
                <div class="story-card">
                  <a
                    href="{{ block.settings.link }}"
                    class="img-box"
                    {% if section.settings.open_in_new_tab %}
                      target="_blank"
                    {% endif %}
                    data-ga-event="section_subscribe_banner_user_clicks"
                    data-ga-action="click"
                    data-ga-params-module="User Stories"
                    data-ga-params-position="{{ block.settings.title }}"
                    data-ga-params-button_name="pic"
                    data-ga-params-link="{{ block.settings.link }}"
                >
                    {% render 'diff-end-img',
                      pc_img: block.settings.img_pc,
                      mb_img: block.settings.img_mb,
                      pc_img_width: 420,
                      mb_img_width: 280,
                      class: 'story-img object-cover w-full h-full'
                    %}
                  </a>
                  <span class="tag">{{ block.settings.tag }}</span>
                  <div class="caption">
                    <div class="underline"></div>
                    <div class="headline text-overflow-2">{{ block.settings.title }}</div>
                    <div class="sub text-overflow-2">{{ block.settings.des }}</div>
                    <a
                      class="flex justify-center cursor-pointer cta"
                      {% if section.settings.open_in_new_tab %}
                        target="_blank"
                      {% endif %}
                      href="{{ block.settings.link }}"
                      data-ga-event="section_subscribe_banner_user_clicks"
                      data-ga-action="click"
                      data-ga-params-module="User Stories"
                      data-ga-params-position="{{ block.settings.title }}"
                      data-ga-params-button_name="{{ section.settings.btn }}"
                      data-ga-params-link="{{ block.settings.link }}"
                    >
                      <span>{{ section.settings.btn }}</span>&nbsp;<jds-icon name="arrow-right-long"></jds-icon>
                    </a>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {% endfor %}
        </div>

        <div class="swiper-button-prev stories-prev"></div>
        <div class="swiper-button-next stories-next"></div>
      </div>
    </div>
  </v5-stories>
</div>
<script src="{{ 'sections-v5-story.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5首页-用户故事",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "是否新开标签页", "default": false },
    { "type": "text", "id": "title", "label": "模块标题文案" },
    { "type": "text", "id": "sub", "label": "模块副标题文案" },
    { "type": "text", "id": "btn", "label": "按钮文案" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "用户故事",
      "settings": [
        { "type": "text", "id": "tag", "label": "场景标签文案" },
        { "type": "text", "id": "title", "label": "故事标题文案" },
        { "type": "text", "id": "des", "label": "描述文案" },
        { "type": "url", "id": "link", "label": "跳转地址" },
        { "type": "image_picker", "id": "img_pc", "label": "封面图PC", "info": "图片推荐尺寸：420*560" },
        { "type": "image_picker", "id": "img_mb", "label": "封面图MB", "info": "图片推荐尺寸：280*374" }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5首页-用户故事",
      "category": "内容展示",
      "settings": {}
    }
  ]
}
{% endschema %}
