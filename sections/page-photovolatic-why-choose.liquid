
{% assign slides = section.blocks | where: 'type', 'slide_item' %}

<section class="photovolatic-why-choose-wrap w-full flex-center flex-col bg-#333333 px-40 py-48 lg:px-0 lg:j-py-50 xl:a-py-50">
  <h2 class="w-full lg:j-w-1000 xl:a-w-1000 text-center font-600 text-white text-48 leading-60 mb-60 lg:j-text-40 lg:j-leading-48 lg:j-mb-35 xl:a-text-40 xl:a-leading-48 xl:a-mb-35">
    {{ section.settings.title | newline_to_br }}
  </h2>
  <div class="hidden lg:j-w-1200 xl:a-w-1200 relative">
      <ul class="{% if slides.size >= 3 %} flex-between {% else %} flex-center {% endif %} border-0 border-#C4C4C4/50 border-solid relative lg:j-w-1200 lg:j-border-b-3 lg:j-gap-x-60 xl:a-w-1200 xl:a-border-b-2 xl:a-gap-x-60">
        {% for block in slides %}
          <li class="text-center cursor-pointer font-600 text-white/80 transition-all duration-300 lg:j-text-18 lg:j-leading-27 lg:j-py-5 lg:j-max-w-190 xl:a-text-18 xl:a-leading-27 xl:a-py-5 xl:a-max-w-190" data-balcony-tab-vs-item>
            {{ block.settings.tab_name | escape }}
          </li>
        {% endfor %}
        <li class="text-center absolute left-0 bottom-0 bg-primary transition-all duration-300  lg:j-w-0 lg:j-h-3 -lg:j-bottom-3 xl:a-w-0 xl:a-h-2 -xl:a-bottom-2" data-balcony-tab-vs-deco></li>
      </ul>

      {% comment %} Swiper {% endcomment %}
      <div
        class="swiper swiper-balcony-tab-vs-pc overflow-hidden w-full lg:j-h-560 lg:j-mt-25 lg:j-rounded-12 xl:a-h-560 xl:a-mt-25 xl:a-rounded-12"
        data-autoplay="{{ section.settings.autoplay }}"
        data-autoplay-delay="{{ section.settings.autoplay_delay }}"
        data-size="{{ slides.size }}"
      >
          <div class="swiper-wrapper w-full lg:j-h-560 xl:a-h-560">
            {% for block in slides %}
              <div class="swiper-slide !lg:j-w-1200 lg:j-h-560 !xl:a-w-1200 xl:a-h-560">
                {% comment %} image {% endcomment %}
                {% render 'responsive-image',
                  image: block.settings.pc_slide_img,
                  mimage: block.settings.mb_slide_img,
                  image_class: 'w-full h-full block object-cover lg:j-rounded-12 xl:a-rounded-12'
                %}
              </div>
            {% endfor %}
          </div>
      </div>

      {% comment %} PC Navigation {% endcomment %}
      {% if slides.size > 1 %}
        <div class="hidden lg:flex swiper-button-next swiper-tab-vs-pc-button-next"></div>
        <div class="hidden lg:flex swiper-button-prev swiper-tab-vs-pc-button-prev"></div>
      {% endif %}
  </div>


  {% comment %} MB 端 Product Swiper {% endcomment %}
  <div class="hidden w-full swiper swiper-balcony-tab-vs-mb pb-142">
      <div class="swiper-wrapper">
        {% for block in slides %}
          <div class="swiper-slide flex-col bg-transparent">
            <h2 class="w-full text-left font-600 text-48 leading-56 mb-24 text-white">
              {{ block.settings.tab_name | escape }}
            </h2>
            <div class="w-full h-860 relative rounded-24 overflow-hidden">
              {% comment %} image {% endcomment %}
              {% render 'responsive-image',
                image: block.settings.pc_slide_img,
                mimage: block.settings.mb_slide_img,
                image_class: 'w-full h-860 object-cover rounded-24'
              %}
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination swiper-tab-pagination"></div>
      <div class="swiper-button-next swiper-tab-vs-button-next"></div>
      <div class="swiper-button-prev swiper-tab-vs-button-prev"></div>
  </div>
</section>

{% schema %}
  {
    "name": "photovolatic Why Choose",
    "class": "section-photovolatic section-photovolatic-why-choose",
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Section Title",
        "default": "Why Choose Jackery DIY Solar Generator for Home？"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Auto Play",
        "default": true
      },
      {
        "type": "range",
        "id": "autoplay_delay",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "s",
        "label": "Auto Play Delay",
        "default": 3
      }
    ],
    "blocks": [
      {
        "type": "slide_item",
        "name": "Slide item",
        "limit": 6,
        "settings": [
          {
            "type": "text",
            "id": "tab_name",
            "label": "Tab Name"
          },
          {
            "type": "image_picker",
            "id": "pc_slide_img",
            "label": "PC Image"
          },
          {
            "type": "image_picker",
            "id": "mb_slide_img",
            "label": "Mobile Image"
          }
        ]
      }
    ]
  }
{% endschema %}
