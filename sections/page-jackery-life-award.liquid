{% assign Rank_section_title = section.blocks | where: 'type', 'ranking_section_title' %}

{% for block in Rank_section_title %}
    {% if block.settings.choose_rank_section == 'first_section' %}
        {% assign First_section = block.settings %}
    {% elsif block.settings.choose_rank_section == 'second_to_five_section' %}
        {% assign Second_section = block.settings %}
    {% elsif block.settings.choose_rank_section == 'six_to_fifteenth_section' %}
        {% assign Third_section = block.settings %}
    {% elsif block.settings.choose_rank_section == 'award_video' %}
        {% assign Fourth_section = block.settings %}
    {% elsif block.settings.choose_rank_section == 'award_photography' %}
        {% assign Fifth_section = block.settings %}
    {% endif %}
{% endfor %}

{% assign Rank_first = section.blocks | where: 'type', "ranking_first" %}
{% assign Rank_second_to_five = section.blocks | where: 'type', "ranking_second_to_five" %}
{% assign Rank_six_to_fifteenth = section.blocks | where: 'type', "ranking_six_to_fifteenth" %}
{% assign Award_video = section.blocks | where: 'type', "award_video" %}
{% assign Award_photography = section.blocks | where: 'type', "award_photography" %}

<div id="page-life-award">
    <div class="pb-80 lg:j-pb-120">
        {% comment %} banner {% endcomment %}
        <a href="{{ section.settings.banner_link }}" class="block w-full lg:j-h-800 lg:j-mb-60">
            {% comment %} banner image {% endcomment %}
            <picture>
                <source media="(min-width:1024px)" srcset="{{ section.settings.banner_image_pc | image_url: width: 1920}}">
                <img class="w-full object-contain" src="{{ section.settings.banner_image_mb | image_url: width: 750}}" alt="" loading="lazy">
            </picture>
        </a>

        {% comment %} 第 1 名 {% endcomment %}
        <section class="px-40 lg:j-px-0 lg:j-w-1200 pt-80 lg:j-py-60 flex-center flex-col mx-auto">
            <div
                class="
                    w-full px-46 lg:w-auto lg:j-min-w-680 lg:j-px-90 inline-flex flex-col relative
                    before:block before:content-[''] before:bg-[url(https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/deco-gold.png?v=1685525758)] before:bg-no-repeat before:bg-contain before:w-46 before:h-92 before:lg:j-w-46 before:lg:j-h-92 before:absolute before:left-0 before:top-0 before:lg:-j-top-8
                    after:block after:content-[''] after:bg-[url(https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/deco-gold.png?v=1685525758)] after:bg-no-repeat after:bg-contain after:w-46 after:h-92 after:lg:j-w-46 after:lg:j-h-92 after:absolute after:right-0 after:top-0 after:lg:-j-top-8 after:rotate-y-180
                "
            >
                <h2 class="text-40 leading-48 lg:j-text-40 lg:j-leading-48 text-#333 font-bold text-center">{{First_section.rank_section_title | newline_to_br}}</h2>
                <p class="max-w-546 lg:j-max-w-auto text-28 leading-36 lg:j-text-22 lg:j-leading-28 text-#666 font-medium mt-12 lg:j-mt-6 text-center">{{First_section.rank_section_subtitle | newline_to_br}}</p>
                <p class="lg:j-text-18 lg:j-leading-28 text-#333 font-medium mt-20 mb-40 lg:j-mt-14 lg:j-mb-40 text-center">
                    {{First_section.rank_section_rank_from_number | escape}}<sup class="text-22 lg:j-text-14 lg:-top-[0.3em]">{{First_section.rank_section_rank_from_abbreviation | escape}}</sup>
                </p>
            </div>

            <div class="w-full lg:j-h-800">
                {% for block in Rank_first limit: 1 -%}
                    {% assign href = block.settings.rank_first_work_link | append: '&jfFrom=award'  %}
                    {% comment %} work image {% endcomment %}
                    <a href="{{ href }}" class="flex group w-full h-full overflow-hidden relative bg-[url(https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/VCG211353354500_58692473-6a4f-464a-8bd1-c3beacaa9aee.png?v=1686207725)] bg-contain bg-no-repeat">
                        <div class="w-full h-894 lg:w-1/2 lg:h-full overflow-hidden relative">
                            <picture>
                                <source media="(min-width:1024px)" srcset="{{block.settings.rank_first_work_img | image_url: width: 1200}}">
                                <img class="w-full h-full object-cover" src="{{block.settings.rank_first_work_img | image_url: width: 750}}" alt="" loading="lazy">
                            </picture>

                            <div class="block lg:hidden w-full p-22 absolute left-0 top-0">
                                <img class="w-50 h-50" src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/gold.svg" alt="" loading="lazy">
                            </div>
                        </div>

                        {% comment %} work title and author {% endcomment %}
                        <div class="hidden lg:flex w-full lg:w-1/2 h-full justify-end flex-col lg:j-pl-70 lg:j-pr-40 lg:j-pb-40">
                            <div class="flex w-full items-start flex-col text-black">
                                <img class="lg:j-w-66 lg:j-h-66 lg:-j-ml-4 lg:j-mb-15" src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/gold.svg" alt="" loading="lazy">
                                <h2 class="lg:j-text-32 lg:j-leading-45 lg:j-mb-8 text-main font-semibold">{{block.settings.rank_first_work_title | newline_to_br}}</h2>
                                <p class="w-full flex lg:j-text-18 lg:j-leading-20 lg:j-mb-16 text-main font-semibold">
                                    <span class="lg:j-mt-2 lg:j-mr-10">{{block.settings.rank_first_work_author | escape}}</span>
                                    <img class="lg:j-w-30 lg:j-h-30" src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/4_593ab259-dbad-430e-ba19-1f4fa548bd6f.png?v=1686207725" alt="" loading="lazy">
                                </p>
                                <p class="lg:j-text-18 lg:j-leading-26 text-sub font-medium">The solar setup from jackery has been supplying power for my vw bus for 2 years. An awesome setup and one of the best purchases I've made for the application.</p>
                            </div>
                        </div>
                    </a>
                    <div class="block lg:hidden w-full flex-start flex-col">
                        <h3 class="w-full text-start text-30 leading-30 font-semibold text-#222 mt-30 mb-20">{{block.settings.rank_first_work_title | newline_to_br}}</h3>
                        <p class="w-full text-start text-28 leading-39 font-medium text-#666 mb-50">
                            <span class="mt-2 mr-10">{{block.settings.rank_first_work_author | escape}}</span>
                            <img class="w-30 h-30 lg:j-w-30 lg:j-h-30" src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/4_593ab259-dbad-430e-ba19-1f4fa548bd6f.png?v=1686207725" alt="" loading="lazy">
                        </p>
                    </div>
                {% endfor %}
            </div>
        </section>

        {% comment %} mobile separator {% endcomment %}
        <div class="block lg:hidden w-full h-20 bg-#F6F5F5"></div>

        {% comment %} 第 2-5 名 {% endcomment %}
        <section class="px-40 lg:j-px-0 lg:j-w-1200 pt-80 lg:j-py-60 lg:flex-center lg:flex-col mx-auto">
            <div
                class="
                    w-full px-46 lg:w-auto lg:j-min-w-680 lg:j-px-90 inline-flex flex-col relative
                    before:block before:content-[''] before:bg-[url(https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/deco-silver.png?v=1685525758)] before:bg-no-repeat before:bg-contain before:w-46 before:h-92 before:lg:j-w-46 before:lg:j-h-92 before:absolute before:left-0 before:top-0 before:lg:-j-top-8
                    after:block after:content-[''] after:bg-[url(https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/deco-silver.png?v=1685525758)] after:bg-no-repeat after:bg-contain after:w-46 after:h-92 after:lg:j-w-46 after:lg:j-h-92 after:absolute after:right-0 after:top-0 after:lg:-j-top-8 after:rotate-y-180
                "
            >
                <h2 class="text-40 leading-48 lg:j-text-40 lg:j-leading-48 text-#333 font-bold text-center">{{Second_section.rank_section_title | newline_to_br}}</h2>
                <p class="max-w-546 lg:j-max-w-auto text-28 leading-36 lg:j-text-22 lg:j-leading-28 text-#666 font-medium mt-12 lg:j-mt-6 text-center">{{Second_section.rank_section_subtitle | newline_to_br}}</p>
                <p class="lg:j-text-18 lg:j-leading-28 text-#333 font-medium mt-20 mb-40 lg:j-mt-14 lg:j-mb-40 text-center">
                    {{Second_section.rank_section_rank_from_number | escape}}<sup class="text-22 lg:j-text-14 lg:-top-[0.3em]">{{Second_section.rank_section_rank_from_abbreviation | escape}}</sup>
                    <span> - </span>
                    {{Second_section.rank_section_rank_to_number | escape}}<sup class="text-22 lg:j-text-14 lg:-top-[0.3em]">{{Second_section.rank_section_rank_to_abbreviation | escape}}</sup>
                </p>
            </div>

            <div class="w-full lg:j-h-970 flex flex-wrap flex-col lg:j-gap-18">
                {% for block in Rank_second_to_five limit: 4 %}
                    {% assign href = block.settings.rank_second_to_five_work_link | append: '&jfFrom=award'  %}
                    <a href="{{ href }}" class="block group {% if block.settings.rank_column == 'first_column' %} lg:j-w-606 {% else %} lg:j-w-574 {% endif %} lg:h-auto overflow-hidden relative">
                        <picture>
                            <source media="(min-width:1024px)" srcset="{{ block.settings.rank_second_to_five_work_img | image_url: width: 606}}">
                            <img class="w-full h-auto lg:h-full object-contain" src="{{ block.settings.rank_second_to_five_work_img | image_url: width: 750}}" alt="" loading="lazy">
                        </picture>

                        {% comment %} work title and author {% endcomment %}
                        <div class="flex-between flex-col absolute left-0 top-0 right-0 bottom-0 z-1">
                            <div class="block lg:hidden w-full p-22">
                                <img class="w-50 h-50" src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/silver.svg?v=1685515286" alt="" loading="lazy">
                            </div>

                            <div class="w-full lg:h-50% bg-gradient-to-b from-black/30 to-transparent text-white opacity-0 transition duration-300 ease-in-out group-hover:lg:opacity-100">
                                <p class="w-full flex items-center lg:j-pl-15 lg:j-translate-y-0 group-hover:lg:j-translate-y-30 transition-all duration-300">
                                    <img class="lg:j-w-32 lg:j-h-32 lg:j-mr-10" src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/silver.svg?v=1685515286" alt="" loading="lazy">
                                    <span class="lg:j-text-18 lg:j-leading-21 text-white font-medium">{{ block.settings.rank_second_to_five_work_title | newline_to_br }}</span>
                                </p>
                            </div>
                            <div class="w-full lg:h-50% flex items-end bg-gradient-to-t from-black/30 to-transparent text-white opacity-0 transition duration-300 ease-in-out group-hover:lg:opacity-100">
                                <p class="w-full lg:j-text=16 lg:j-leading-19 text-white font-medium lg:j-pl-20 lg:j-translate-y-0 group-hover:lg:-j-translate-y-30 transition-all duration-300">{{ block.settings.rank_second_to_five_work_author | escape }}</p>
                            </div>
                        </div>
                    </a>
                    <div class="block lg:hidden w-full flex-start flex-col">
                        <h3 class="w-full text-start text-30 leading-30 font-semibold text-#222 mt-30 mb-20">{{ block.settings.rank_second_to_five_work_title | newline_to_br }}</h3>
                        <p class="w-full text-start text-28 leading-39 font-medium text-#666 mb-50">{{ block.settings.rank_second_to_five_work_author | escape }}</p>
                    </div>
                {% endfor %}
            </div>
        </section>

        {% comment %} mobile separator {% endcomment %}
        <div class="block lg:hidden w-full h-20 bg-#F6F5F5"></div>

        {% comment %} 第 6-15 名 {% endcomment %}
        {% if Rank_six_to_fifteenth.size > 0 %}
            <section class="px-40 lg:j-px-0 lg:j-w-1200 pt-80 lg:j-py-60 lg:flex-center lg:flex-col mx-auto overflow-hidden">
                <div
                    class="
                        w-full px-46 lg:w-auto lg:j-min-w-680 lg:j-px-90 inline-flex flex-col relative
                        before:block before:content-[''] before:bg-[url(https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/deco-copper.png?v=1685525757)] before:bg-no-repeat before:bg-contain before:w-46 before:h-92 before:lg:j-w-46 before:lg:j-h-92 before:absolute before:left-0 before:lg:-j-top-8
                        after:block after:content-[''] after:bg-[url(https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/deco-copper.png?v=1685525757)] after:bg-no-repeat after:bg-contain after:w-46 after:h-92 after:lg:j-w-46 after:lg:j-h-92 after:absolute after:right-0 after:top-0 after:lg:-j-top-8 after:rotate-y-180
                    "
                >
                    <h2 class="text-40 leading-48 lg:j-text-40 lg:j-leading-48 text-#333 font-bold text-center">{{Third_section.rank_section_title | newline_to_br}}</h2>
                    <p class="max-w-546 lg:j-max-w-auto text-28 leading-36 lg:j-text-22 lg:j-leading-28 text-#666 font-medium mt-12 lg:j-mt-6 text-center">{{Third_section.rank_section_subtitle | newline_to_br}}</p>
                    <p class="lg:j-text-18 lg:j-leading-28 text-#333 font-medium mt-20 mb-40 lg:j-mt-14 lg:j-mb-40 text-center">
                        {{Third_section.rank_section_rank_from_number | escape}}<sup class="text-22 lg:j-text-14 lg:-top-[0.3em]">{{Third_section.rank_section_rank_from_abbreviation | escape}}</sup>
                        <span> - </span>
                        {{Third_section.rank_section_rank_to_number | escape}}<sup class="text-22 lg:j-text-14 lg:-top-[0.3em]">{{Third_section.rank_section_rank_to_abbreviation | escape}}</sup>
                    </p>
                </div>

                <div class="lg:w-full swiper-container-copper overflow-hidden lg:overflow-visible relative">
                    <div class="w-full lg:j-h-1539 lg:flex lg:flex-wrap lg:flex-col lg:j-gap-18 swiper-wrapper">
                        {% for block in Rank_six_to_fifteenth limit: 10 %}
                            <div class="w-full h-950 lg:j-w-388 lg:h-auto swiper-slide">
                                {% assign href = block.settings.rank_six_to_fifteenth_work_link | append: '&jfFrom=award'  %}
                                <a href="{{ href }}" class="group w-full h-670 flex-center bg-#F6F5F5 lg:block lg:j-w-388 lg:h-auto overflow-hidden relative">
                                    <picture>
                                        <source media="(min-width:1024px)" srcset="{{ block.settings.rank_six_to_fifteenth_work_img | image_url: width: 388}}">
                                        <img class="w-full h-670 lg:h-full object-contain" src="{{ block.settings.rank_six_to_fifteenth_work_img | image_url: width: 750}}" alt="jackery" loading="lazy">
                                    </picture>

                                    {% comment %} work title and author {% endcomment %}
                                    <div class="flex-between flex-col absolute left-0 top-0 right-0 bottom-0 z-1">
                                        <div class="block lg:hidden w-full p-22">
                                            <img class="w-50 h-50" src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/copper.svg?v=1685515286" alt="jackery" loading="lazy">
                                        </div>

                                        <div class="w-full lg:h-50% bg-gradient-to-b from-black/30 to-transparent text-white opacity-0 transition duration-300 ease-in-out group-hover:lg:opacity-100">
                                            <p class="w-full flex items-center lg:j-pl-15 lg:j-translate-y-0 group-hover:lg:j-translate-y-30 transition-all duration-300">
                                                <img class="lg:j-w-32 lg:j-h-32 lg:j-mr-10" src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/copper.svg?v=1685515286" alt="" loading="lazy">
                                                <span class="lg:j-text-18 lg:j-leading-21 text-white font-medium">{{ block.settings.rank_six_to_fifteenth_work_title | newline_to_br }}</span>
                                            </p>
                                        </div>
                                        <div class="w-full lg:h-50% flex items-end bg-gradient-to-t from-black/30 to-transparent text-white opacity-0 transition duration-300 ease-in-out group-hover:lg:opacity-100">
                                            <p class="w-full lg:j-text=16 lg:j-leading-19 text-white font-medium lg:j-pl-20 lg:j-translate-y-0 group-hover:lg:-j-translate-y-30 transition-all duration-300">{{ block.settings.rank_six_to_fifteenth_work_author | escape }}</p>
                                        </div>
                                    </div>
                                </a>
                                <div class="block lg:hidden">
                                    <h3 class="w-full text-start text-30 leading-30 font-semibold text-#222 mt-30 mb-20">{{ block.settings.rank_six_to_fifteenth_work_title | newline_to_br }}</h3>
                                    <p class="w-full text-start text-28 leading-39 font-medium text-#666 mb-50">{{ block.settings.rank_six_to_fifteenth_work_author | escape }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {% comment %} swiper pagination {% endcomment %}
                    <div class="block lg:hidden swiper-pagination copper-pagination award-swiper-pagination"></div>
                </div>
            </section>

            {% comment %} mobile separator {% endcomment %}
            <div class="block lg:hidden w-full h-20 bg-#F6F5F5"></div>
        {% endif %}

        {% comment %} 获奖视频 {% endcomment %}
        {% if Award_video.size > 0 %}
            <section class="px-40 lg:j-px-0 lg:j-w-1200 pt-80 lg:j-py-60 lg:flex-center lg:flex-col mx-auto">
                <div class="flex-center flex-col">
                    <h2 class="text-40 leading-48 lg:j-text-40 lg:j-leading-48 text-#333 font-bold text-center">{{Fourth_section.rank_section_title | newline_to_br}}</h2>
                    <p class="w-full lg:j-max-w-auto text-28 leading-36 lg:j-text-22 lg:j-leading-28 text-#666 font-medium mt-12 lg:j-mt-6 text-center">{{Fourth_section.rank_section_subtitle | newline_to_br}}</p>
                    <p class="lg:j-text-18 lg:j-leading-28 text-#333 font-medium mt-20 mb-40 lg:j-mt-14 lg:j-mb-40 text-center">{{Fourth_section.rank_section_desc | escape}}</p>
                </div>

                <div class="lg:w-full swiper-container-video overflow-hidden lg:overflow-visible relative">
                    <div class="w-full lg:j-h-528 lg:flex lg:flex-wrap lg:flex-col lg:j-gap-18 swiper-wrapper">
                        {% for block in Award_video limit: 5 %}
                            {% assign index = forloop.index %}
                            <div class="w-full h-950 lg:j-w-388 lg:h-auto swiper-slide">
                                <div class="block group h-670 lg:j-w-388 {% if index == 3 %} lg:j-h-528 {% elsif index == 5 %} lg:j-h-293 {% else %} lg:h-auto {% endif %} overflow-hidden relative bg-#F6F5F5 bg-[url(https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/ff5587b3fa653dff6fc130c810c9cedd.png?v=1686207725)] bg-contain bg-no-repeat">
                                    <picture>
                                        <source media="(min-width:1024px)" srcset="{{ block.settings.video_cover | image_url: width: 388}}">
                                        <img class="w-full h-670 lg:h-auto object-contain" src="{{ block.settings.video_cover | image_url: width: 750}}" alt="jackery" loading="lazy">
                                    </picture>

                                    {% comment %} work title and author {% endcomment %}
                                    <div class="flex-between flex-col absolute left-0 top-0 right-0 bottom-0 z-1">
                                        <div class="w-full lg:h-50% bg-gradient-to-b from-black/30 to-transparent text-white opacity-0 transition duration-300 ease-in-out group-hover:lg:opacity-100">
                                            <p class="w-full flex items-center lg:j-pl-20 lg:j-translate-y-0 group-hover:lg:j-translate-y-30 transition-all duration-300">
                                                <span class="lg:j-text-18 lg:j-leading-21 text-white font-medium">{{ block.settings.video_work_title | newline_to_br }}</span>
                                            </p>
                                        </div>
                                        <div class="w-full lg:h-50% flex items-end bg-gradient-to-t from-black/30 to-transparent text-white opacity-0 transition duration-300 ease-in-out group-hover:lg:opacity-100">
                                            <p class="w-full lg:j-text=16 lg:j-leading-19 text-white font-medium lg:j-pl-20 lg:j-translate-y-0 group-hover:lg:-j-translate-y-30 transition-all duration-300">{{ block.settings.video_work_author | escape }}</p>
                                        </div>
                                    </div>

                                    {% comment %} play button {% endcomment %}
                                    {% assign href = block.settings.video_work_link | append: '&jfFrom=award'  %}
                                    <a href="{{ href }}" class="w-96 h-96 lg:j-w-60 lg:j-h-60 absolute left-1/2 top-1/2 -translate-1/2 bg-[url(https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/play.png?v=1685525758)] bg-center bg-no-repeat bg-contain cursor-pointer z-2"></a>
                                </div>
                                <div class="block lg:hidden w-full flex-start flex-col">
                                    <h3 class="w-full text-start text-30 leading-30 font-semibold text-#222 mt-30 mb-20">{{ block.settings.video_work_title | newline_to_br }}</h3>
                                    <p class="w-full text-start text-28 leading-39 font-medium text-#666 mb-50">{{ block.settings.video_work_author | escape }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {% comment %} swiper pagination {% endcomment %}
                    <div class="block lg:hidden swiper-pagination video-pagination award-swiper-pagination"></div>
                </div>
            </section>

            {% comment %} mobile separator {% endcomment %}
            <div class="block lg:hidden w-full h-20 bg-#F6F5F5"></div>
        {% endif %}

        {% comment %} 获奖摄影 {% endcomment %}
        {% if Award_photography.size > 0 %}
            <section class="px-40 lg:j-px-0 lg:j-w-1200 pt-40 lg:j-pt-60 lg:j-pb-25 lg:flex-center lg:flex-col mx-auto">
                <div class="flex-center flex-col">
                    <h2 class="text-40 leading-48 lg:j-text-40 lg:j-leading-48 text-#333 font-bold text-center">{{ Fifth_section.rank_section_title | newline_to_br }}</h2>
                    <p class="w-full lg:j-max-w-auto text-28 leading-36 lg:j-text-22 lg:j-leading-28 text-#666 font-medium mt-12 lg:j-mt-6 text-center">{{ Fifth_section.rank_section_subtitle | newline_to_br }}</p>
                    <p class="lg:j-text-18 lg:j-leading-28 text-#333 font-medium mt-20 mb-40 lg:j-mt-14 lg:j-mb-40 text-center">{{ Fifth_section.rank_section_desc | escape }}</p>
                </div>

                <div class="lg:w-full swiper-container-photography overflow-hidden lg:overflow-visible relative">
                    <div class="w-full lg:flex lg:flex-wrap lg:j-gap-18 swiper-wrapper">
                        {% for block in Award_photography limit: 3 %}
                            <div class="w-full h-950 lg:j-w-388 lg:j-h-350 swiper-slide">
                                {% assign href = block.settings.photography_work_link | append: '&jfFrom=award'  %}
                                <a href="{{ href }}" class="group w-full h-670 lg:h-full flex-center bg-#F6F5F5 lg:block overflow-hidden relative">
                                    <picture>
                                        <source media="(min-width:1024px)" srcset="{{ block.settings.photography_cover | image_url: width: 388}}">
                                        <img class="w-full h-auto lg:h-full object-cover" src="{{ block.settings.photography_cover | image_url: width: 750}}" alt="jackery" loading="lazy">
                                    </picture>

                                    {% comment %} work title and author {% endcomment %}
                                    <div class="flex-between flex-col absolute left-0 top-0 right-0 bottom-0 z-1">
                                        <div class="w-full lg:h-50% bg-gradient-to-b from-black/30 to-transparent text-white opacity-0 transition duration-300 ease-in-out group-hover:lg:opacity-100">
                                            <p class="w-full flex items-center lg:j-pl-20 lg:j-translate-y-0 group-hover:lg:j-translate-y-30 transition-all duration-300">
                                                <span class="lg:j-text-18 lg:j-leading-21 text-white font-medium">{{ block.settings.photography_work_title | newline_to_br }}</span>
                                            </p>
                                        </div>
                                        <div class="w-full lg:h-50% flex items-end bg-gradient-to-t from-black/30 to-transparent text-white opacity-0 transition duration-300 ease-in-out group-hover:lg:opacity-100">
                                            <p class="w-full lg:j-text=16 lg:j-leading-19 text-white font-medium lg:j-pl-20 lg:j-translate-y-0 group-hover:lg:-j-translate-y-30 transition-all duration-300">{{ block.settings.photography_work_author | escape }}</p>
                                        </div>
                                    </div>
                                </a>
                                <div class="block lg:hidden w-full flex-start flex-col">
                                    <h3 class="w-full text-start text-30 leading-30 font-semibold text-#222 mt-30 mb-20">{{ block.settings.photography_work_title | newline_to_br }}</h3>
                                    <p class="w-full text-start text-28 leading-39 font-medium text-#666 mb-50">{{ block.settings.photography_work_author | escape }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {% comment %} swiper pagination {% endcomment %}
                    <div class="block lg:hidden swiper-pagination photography-pagination award-swiper-pagination"></div>
                </div>
            </section>

            {% comment %} mobile separator {% endcomment %}
            <div class="block lg:hidden w-full h-20 bg-#F6F5F5"></div>
        {% endif %}
        

        {% if section.settings.jackery_reserves_right != blank %}
            <p class="px-40 py-40 text-28 leading-39 text-center text-#666 font-medium lg:px-0 lg:j-py-25 lg:j-text-16 lg:j-leading-20">
                <span>{{ section.settings.jackery_reserves_right | escape }}</span>
                <a href="{{ section.settings.view_activity_introduction_link }}" class="text-#666 underline underline-offset-4 hover:text-primary transition-all duration-300">{{ section.settings.view_activity_introduction_text | escape }}</a>
            </p>
        {% endif %}

        {% if section.settings.view_more_link != blank %}
            <div class="flex-center py-40 lg:j-py-25">
                <a
                    href="{{ section.settings.view_more_link }}"
                    class="
                        min-w-272 h-80 flex-center font-semibold border-2 border-solid border-primary rounded-full text-primary transition-all duration-300
                        lg:j-min-w-188 lg:j-h-48 lg:j-px-24 lg:j-text-20 lg:j-leading-22 lg:j-border-2 hover:bg-primary hover:text-white
                    "
                >{{ section.settings.view_more_text | escape }}</a>
            </div>
        {% endif %}
    </div>
</div>

{% schema %}
  {
    "name": "Page Jackery Life Award",
    "settings": [
        {"type": "image_picker", "id": "banner_image_pc", "label": "PC Banner Image"},
        {"type": "image_picker", "id": "banner_image_mb", "label": "Mobile Banner Image"},
        {"type": "url", "id": "banner_link", "label": "Banner Link"},
        {"type": "textarea", "id": "jackery_reserves_right", "label": "Jackery Reserves Right", "default": "*Jackery reserves the right of final interpretation for the event."},
        {"type": "textarea", "id": "view_activity_introduction_text", "label": "View Activity Introduction Text", "default": "Click here to view activity introduction."},
        {"type": "url", "id": "view_activity_introduction_link", "label": "View Activity Introduction Link"},
        {"type": "text", "id": "view_more_text", "label": "View More Text", "default": "View More"},
        {"type": "url", "id": "view_more_link", "label": "View More Link"}
    ],
    "blocks": [
        {
            "type": "ranking_section_title", "name": "Ranking Section Title",
            "settings": [
                {
                    "type": "select",
                    "id": "choose_rank_section",
                    "options": [
                        {
                            "value": "first_section",
                            "label": "First Award Section"
                        },
                        {
                            "value": "second_to_five_section",
                            "label": "Second To Five Award Section"
                        },
                        {
                            "value": "six_to_fifteenth_section",
                            "label": "Six To Fifteenth Award Section"
                        },
                        {
                            "value": "award_video",
                            "label": "Award Video"
                        },
                        {
                            "value": "award_photography",
                            "label": "Award Photography"
                        }
                    ],
                    "default": "first_section",
                    "label": "Choose Ranking Section"
                },
                {"type": "textarea", "id": "rank_section_title", "label": "Ranking Section Title"},
                {"type": "textarea", "id": "rank_section_subtitle", "label": "Ranking Section Description"},
                {"type": "text", "id": "rank_section_rank_from_number", "label": "Ranking Section Rank From Number"},
                {"type": "text", "id": "rank_section_rank_from_abbreviation", "label": "Ranking Section Rank From Abbreviation"},
                {"type": "text", "id": "rank_section_rank_to_number", "label": "Ranking Section Rank To Number"},
                {"type": "text", "id": "rank_section_rank_to_abbreviation", "label": "Ranking Section Rank To Abbreviation"},
                {"type": "text", "id": "rank_section_desc", "label": "Ranking Section Rank Description"}
            ]
        },
        {
            "type": "ranking_first", "name": "Ranking First",
            "settings": [
                {"type": "image_picker", "id": "rank_first_work_img", "label": "Work Image"},
                {"type": "url", "id": "rank_first_work_link", "label": "Work Link"},
                {"type": "textarea", "id": "rank_first_work_title", "label": "Work Title"},
                {"type": "text", "id": "rank_first_work_author", "label": "Work Author"}
            ]
        },
        {
            "type": "ranking_second_to_five", "name": "Ranking Second To Five",
            "settings": [
                {
                    "type": "select",
                    "id": "rank_column",
                    "options": [
                        {
                            "value": "first_column",
                            "label": "First Column"
                        },
                        {
                            "value": "second_column",
                            "label": "Second Column"
                        }
                    ],
                    "default": "first_column",
                    "label": "Choose Column"
                },
                {"type": "image_picker", "id": "rank_second_to_five_work_img", "label": "Work Image"},
                {"type": "url", "id": "rank_second_to_five_work_link", "label": "Work Link"},
                {"type": "textarea", "id": "rank_second_to_five_work_title", "label": "Work Title"},
                {"type": "text", "id": "rank_second_to_five_work_author", "label": "Work Author"}
            ]
        },
        {
            "type": "ranking_six_to_fifteenth", "name": "Ranking Six To Fifteenth",
            "settings": [
                {"type": "image_picker", "id": "rank_six_to_fifteenth_work_img", "label": "Work Image"},
                {"type": "url", "id": "rank_six_to_fifteenth_work_link", "label": "Work Link"},
                {"type": "textarea", "id": "rank_six_to_fifteenth_work_title", "label": "Work Title"},
                {"type": "text", "id": "rank_six_to_fifteenth_work_author", "label": "Work Author"}
            ]
        },
        {
            "type": "award_video", "name": "Award Video",
            "settings": [
                {"type": "image_picker", "id": "video_cover", "label": "Video Cover Picture"},
                {"type": "url", "id": "video_work_link", "label": "Work Link"},
                {"type": "textarea", "id": "video_work_title", "label": "Work Title"},
                {"type": "text", "id": "video_work_author", "label": "Work Author"}
            ]
        },
        {
            "type": "award_photography", "name": "Award Photography",
            "settings": [
                {"type": "image_picker", "id": "photography_cover", "label": "Photography Picture"},
                {"type": "url", "id": "photography_work_link", "label": "Work Link"},
                {"type": "textarea", "id": "photography_work_title", "label": "Work Title"},
                {"type": "text", "id": "photography_work_author", "label": "Work Author"}
            ]
        }
    ]
  }
{% endschema %}
