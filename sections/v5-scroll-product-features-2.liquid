{% comment %}
  V5-滚动产品特性-2
  1. 当前仅用于商详页，后续考虑放开，故需要判断pdp
  2. 当前默认图片地址在demo店铺-内容-文件中，待确认后迁移到美站

  PC端 - 全屏展示
    1. header:4.1666667vw 最大60px
    2. 产品二级导航:66px
    3. 吸底购物车：3.75rem
  移动端 - 按照设计稿高度展示
    1. header: 3.125rem
    2. 产品二级导航: 12.8vw
    3. 吸底购物车: 26.6666vw - 高度随内容动态变化

{% endcomment %}

{% style %}
  @media screen and (min-width: 1024px) {
    .v5-scroll-product-features-2 {
      height: calc(100vh - min(4.1666667vw, 60px));
    }

    .v5-scroll-product-features-2.in-pdp {
      height: calc(100vh - 66px - 3.75rem);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .v5-scroll-product-features-2 {
      min-height: 37.4375rem;
    }
  }
{% endstyle %}

{%- liquid
  # 产品页
  if template == 'product' or template contains 'product.'
    assign is_product_template = true
  endif

  assign mb_bg_height = section.settings.mb_bg_height | default: 341
  assign mb_bg_h_rem = mb_bg_height | divided_by: 16.0 | round: 4 | default: 21.3125
  assign wrapper_class = 'v5-scroll-product-features-2 relative w-full overflow-hidden'
  if is_product_template
    assign wrapper_class = wrapper_class | append: ' in-pdp'
  endif

  assign em_class = ' [&_em]:text-[var(--jds-color-primary)] [&_em]:inline-block'
  assign big_title1_class = 'text-center lg:text-right absolute top-[-22.5rem] lg:top-[-25vw] right-0 lg:right-[4.4444444444vw] z-10 w-full lg:w-[min(44.1666667vw,636px)] text-[2.5rem] lg:text-[clamp(12px,6.66667vw,96px)] leading-[1.2] lg:leading-[1.14583] font-semibold text-black/40 lg:text-black/60 tracking-[-0.5px] lg:tracking-[-1px]' | append: em_class
  assign big_title3_class = 'text-right hidden lg:block opacity-0 absolute top-[2rem] lg:top-[2.2222222vw] right-[4.4444444444vw] z-20 w-[min(52.2222vw,752px)] text-[clamp(12px,6.66667vw,96px)] leading-[1.14583] font-semibold text-[rgba(0, 0, 0, 0.9)] tracking-[-1px]' | append: em_class

  assign pc_bg_img = 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/v5-scroll-pf-2-bg.png?v=1758030886'
  if section.settings.pc_bg_img != blank
    assign pc_bg_img = section.settings.pc_bg_img | image_url: width: 1440
  endif

  assign mb_bg_img = 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/v5-scroll-pf-2-mb-bg-2x.png?v=1759204798'
  if section.settings.mb_bg_img != blank
    assign mb_bg_img = section.settings.mb_bg_img | image_url: width: 1440
  endif

  assign pc_screen_1_img = 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/v5-scroll-pf-2-screen1.png?v=1758108244'
  if section.settings.pc_screen_1_img != blank
    assign pc_screen_1_img = section.settings.pc_screen_1_img | image_url: width: 1140
  endif

  assign mb_screen_1_img = 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/v5-scroll-pf-2-mb-screen1-2x.png?v=1759204798'
  if section.settings.mb_screen_1_img != blank
    assign mb_screen_1_img = section.settings.mb_screen_1_img | image_url: width: 1140
  endif

  assign pc_screen_2_img = 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/v5-scroll-pf-2-screen2.png?v=1758108249'
  if section.settings.pc_screen_2_img != blank
    assign pc_screen_2_img = section.settings.pc_screen_2_img | image_url: width: 1140
  endif

  assign mb_screen_2_img = 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/v5-scroll-pf-2-mb-screen2-2x.png?v=1759204798'
  if section.settings.mb_screen_2_img != blank
    assign mb_screen_2_img = section.settings.mb_screen_2_img | image_url: width: 1140
  endif

  assign pc_screen_3_1_img = 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/v5-scroll-pf-2-screen3-1.png?v=1758158124'
  if section.settings.pc_screen_3_1_img != blank
    assign pc_screen_3_1_img = section.settings.pc_screen_3_1_img | image_url: width: 1140
  endif
  assign pc_screen_3_2_img = 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/v5-scroll-pf-2-screen3-2.png?v=1758108920'
  if section.settings.pc_screen_3_2_img != blank
    assign pc_screen_3_2_img = section.settings.pc_screen_3_2_img | image_url: width: 1140
  endif
  assign mb_screen_3_img = 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/v5-scroll-pf-2-mb-screen3-2x.png?v=1759204797'
  if section.settings.mb_screen_3_img != blank
    assign mb_screen_3_img = section.settings.mb_screen_3_img | image_url: width: 1140
  endif
%}

<div
  id="v5ScrollProductFeatures2"
  class="{{ wrapper_class }}"
  {{ section.shopify_attributes }}
  {% if section.settings.anchor != blank %}
    anchor-target="{{section.settings.anchor | escape}}"
  {% endif %}
>
{%- if mb_bg_h_rem != blank -%}
  <style>
    @media screen and (max-width: 1023.98px) {
      #v5ScrollProductFeatures2 .top-content {
        min-height: {{ mb_bg_h_rem }}rem;
      }
    }
  </style>
{%- endif -%}
  <div class="top-content w-full h-auto lg:h-full relative overflow-hidden">
    <div class="big-title1 {{ big_title1_class }}">{{ section.settings.big_title1 }}</div>
    {% render 'diff-end-img',
      picture_class:'w-full h-auto lg:h-full',
      class: 'bg-img relative lg:absolute lg:top-0 lg:left-0 lg:z-0 w-full h-auto lg:h-full lg:object-cover',
      style: '',
      anchor: '',
      pc_img: pc_bg_img,
      mb_img: mb_bg_img,
      pc_img_width: 1440,
      mb_img_width: 750,
      placeholder_name: 'hero-apparel-1',
      alt: 'Product Features Scroll Background Image'
    %}
    {% render 'diff-end-img',
      picture_class:'w-full h-auto lg:h-full',
      class: 'scroll-img-1 invisible absolute top-full left-0 z-20 w-full h-full',
      style: '',
      anchor: '',
      pc_img: pc_screen_1_img,
      mb_img: mb_screen_1_img,
      pc_img_width: 1440,
      mb_img_width: 750,
      placeholder_name: 'hero-apparel-1',
      alt: 'Product Features Scroll First Screen Image'
    %}
    {% render 'diff-end-img',
      picture_class:'w-full h-auto lg:h-full',
      class: 'scroll-img-2 invisible lg:visible lg:opacity-0 absolute top-0 left-0 z-20 w-full h-full',
      style: '',
      anchor: '',
      pc_img: pc_screen_2_img,
      mb_img: mb_screen_2_img,
      pc_img_width: 1440,
      mb_img_width: 750,
      placeholder_name: 'hero-apparel-1',
      alt: 'Product Features Scroll Second Screen Image'
    %}
    <picture class="block w-full h-auto lg:h-full">
      <source
        srcset="{{ pc_screen_3_1_img }}"
        media="(min-width: 1024px)"
      >
      <img
        class="scroll-img-3-1 opacity-0 absolute top-0 left-0 z-20 lg:z-30 w-full h-full hidden lg:block"
        src=""
        width="1440"
        height="702"
        loading="lazy"
        alt="{{ section.settings.pc_screen_3_1_img.alt }}"
      >
    </picture>
    {% render 'diff-end-img',
      picture_class:'w-full h-auto lg:h-full',
      class: 'scroll-img-3-2 opacity-0 lg:opacity-100 absolute top-full left-0 z-30 lg:z-20 w-full h-full',
      style: '',
      anchor: '',
      pc_img: pc_screen_3_2_img,
      mb_img: mb_screen_3_img,
      pc_img_width: 1440,
      mb_img_width: 750,
      placeholder_name: 'hero-apparel-1',
      alt: 'Product Features Scroll Third Screen Image'
    %}
    <div class="big-title3 {{ big_title3_class }}">{{ section.settings.big_title3 }}</div>
  </div>
  <div class="bottom-content block lg:hidden swiper h-[16.125rem] pb-[2rem] px-[1rem] bg-[#F9F7F3]">
    <div class="swiper-wrapper gap-x-[0.75rem]">
      <div class="swiper-slide bg-[#fff] rounded-lg p-[0.75rem] w-full h-full">
        <div class="item-title text-[1.25rem] font-semibold leading-[1.5] text-[rgba(0,0,0,0.9)]">
          {{ section.settings.title2 }}
        </div>
        <b class="block w-[7.5rem] h-[0.25rem] mt-[0.25rem] mb-[0.5rem] bg-[var(--jds-color-primary)] rounded-md"></b>
        <div class="item-desc text-[0.75rem] font-normal leading-[1.5] text-[rgba(0,0,0,0.6)] tracking-[-0.24px]">
            {{ section.settings.desc2}}
        </div>
      </div>
      <div class="swiper-slide bg-[#fff] rounded-lg p-[0.75rem] w-full h-full">
        <div class="item-title text-[1.25rem] font-semibold leading-[1.5] text-[rgba(0,0,0,0.9)]">
          {{ section.settings.title3 }}
        </div>
        <b class="block w-[7.5rem] h-[0.25rem] mt-[0.25rem] mb-[0.5rem] bg-[var(--jds-color-primary)] rounded-md"></b>
        <div class="item-desc text-[0.75rem] font-normal leading-[1.5] text-[rgba(0,0,0,0.6)] tracking-[-0.24px]">
          {{ section.settings.desc3}}
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'gsap.js' | asset_url }}" defer></script>
<script src="{{ 'scrollTrigger.js' | asset_url }}" defer></script>
<script src="{{ 'section-v5-scroll-pf-2.min.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5-滚动产品特性-2",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "组件介绍"
    },
    {
      "type": "paragraph",
      "content": "1. 仅用于商详页，且每页仅支持添加一个"
    },
    {
      "type": "paragraph",
      "content": "2. PC端覆盖屏幕可视区（除吸顶和吸底元素的区域），移动端按设计稿高度展示"
    },
    {
      "type": "paragraph",
      "content": "3. 默认图展示，可自定义配置更新"
    },
    {
      "type": "select",
      "id": "style_type",
      "options": [
        {
          "value": "default",
          "label": "默认"
        },
        {
          "value": "custom",
          "label": "自定义"
        }
      ],
      "default": "default",
      "label": "样式类型"
    },
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    {
      "type": "header",
      "content": "基础图片配置"
    },
    {
      "type": "image_picker",
      "id": "pc_bg_img",
      "label": "PC端背景图",
      "info": "建议尺寸: 1440x702px"
    },
    {
      "type": "image_picker",
      "id": "mb_bg_img",
      "label": "移动端背景图",
      "info": "建议尺寸: 375x341px"
    },
    {
      "type": "number",
      "id": "mb_bg_height",
      "label": "移动端背景图高度",
      "default": 341,
      "info": "单位：px，请以设计稿宽度375px为基准，进行高度计算"
    },
    {
      "type": "header",
      "content": "第1屏配置"
    },
    {
      "type": "richtext",
      "id": "big_title1",
      "label": "大标题",
      "default": "<p><em>4 Hour</em></p><p><em>Flash Charge</em></p>",
      "info": "提示：文案斜体将以品牌色显示"
    },
    {
      "type": "image_picker",
      "id": "pc_screen_1_img",
      "label": "PC端图",
      "info": "建议尺寸: 1440x702px"
    },
    {
      "type": "image_picker",
      "id": "mb_screen_1_img",
      "label": "移动端图",
      "info": "建议尺寸: 375x341px"
    },
    {
      "type": "header",
      "content": "第2屏配置"
    },
    {
      "type": "image_picker",
      "id": "pc_screen_2_img",
      "label": "PC端-文字介绍图",
      "info": "建议尺寸: 1440x702px"
    },
    {
      "type": "richtext",
      "id": "title2",
      "label": "移动端标题",
      "default": "<p>Paired with All-New 500X SolarSaga</p>"
    },
    {
      "type": "richtext",
      "id": "desc2",
      "label": "移动端描述",
      "default": "<p>500W TOPCon panel with 25% solar efficiency delivers fast 4-hour charging for enhanced energy security. The pioneering ‘M’-shaped design offers bifacial energy generation, eliminates front shading, and secures with rope-and-stake installation to withstand strong winds.</p>",
      "info": "提示：文案斜体将以品牌色显示"
    },
    {
      "type": "image_picker",
      "id": "mb_screen_2_img",
      "label": "移动端图",
      "info": "建议尺寸: 375x341px"
    },
    {
      "type": "header",
      "content": "第3屏配置"
    },
    {
      "type": "richtext",
      "id": "big_title3",
      "label": "PC端大标题",
      "default": "<p><em>Power That</em></p><p><em>Grows With You</em></p>",
      "info": "提示：文案斜体将以品牌色显示"
    },
    {
      "type": "image_picker",
      "id": "pc_screen_3_1_img",
      "label": "PC端-文字介绍图",
      "info": "建议尺寸: 1440x702px"
    },
    {
      "type": "image_picker",
      "id": "pc_screen_3_2_img",
      "label": "PC端-家电包图",
      "info": "建议尺寸: 1440x702px"
    },
    {
      "type": "image_picker",
      "id": "mb_screen_3_img",
      "label": "移动端-家电包图",
      "info": "建议尺寸: 375x341px"
    },
    {
      "type": "richtext",
      "id": "title3",
      "label": "移动端标题",
      "default": "<p>Uo to 22kwh of Backup Power</p>"
    },
    {
      "type": "richtext",
      "id": "desc3",
      "label": "移动端描述",
      "default": "<p>With modular expansion packs, Jackery grows into a massive 22kWh system — enough to power your whole home through extended blackouts.</p>"
    }
  ],
  "presets": [
    {
      "name": "V5-滚动产品特性-2",
      "category": "V5.0"
    }
  ]
}
{% endschema %}
