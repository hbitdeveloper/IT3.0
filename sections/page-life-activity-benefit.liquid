{% comment %} jackery-life 活动 benefit {% endcomment %}
{% assign Benefit_Slides = section.blocks | where: 'type', "benefit_item" %}

<section class="py-64 lg:j-pt-96 lg:j-pb-32 xl:a-pt-96 xl:a-pb-32 bg-white">
  <h2 class="life-activity-title mb-24 lg:j-mb-24 xl:a-mb-24">{{ section.settings.benefit_title | newline_to_br }}</h2>
  <p class="
    w-full mx-auto px-40 text-26 leading-34 text-center font-400 font-normal line-clamp-3
    lg:j-w-800 lg:j-px-0 lg:j-text-18 lg:j-leading-22
    xl:a-w-800 xl:a-px-0 xl:a-text-18 xl:a-leading-22
  ">{{ section.settings.benefit_description | newline_to_br }}</p>

  {% comment %} PC 轮播 {% endcomment %}
  <div class="hidden lg:block lg:j-mt-40 xl:a-mt-40 relative">
    <div class="lg:a-w-1200 lg:a-h-500 lg:a-px-90 mx-auto swiper life-activity-benefit-pc">
      <div class="swiper-wrapper">
        {% for block in Benefit_Slides %}
          <div class="swiper-slide lg:a-w-696 lg:a-h-450 relative">
            <div class="swiper-slide-mask lg:a-w-696 lg:a-h-450 lg:a-rounded-20"></div>
            <div class="lg:a-w-696 lg:a-h-450 relative benefit-item-pc">
              <div class="flex-between lg:a-px-30 lg:a-pt-40 lg:a-pb-30">
                <img
                  loading="lazy"
                  class="lg:a-w-340 lg:a-h-300 object-contain"
                  src="{{ block.settings.benefit_item_image | image_url: width: 600}}"
                  alt="" />
                <p class="lg:a-w-268 flex-center text-#C8C8C8 lg:a-text-14 lg:a-leading-22 font-medium line-clamp-13">{{ block.settings.benefit_item_description | newline_to_br }}</p>
              </div>
              <h3 class="w-full absolute left-0 lg:a-bottom-30 text-center lg:a-text-20 lg:a-leading-20 font-semibold text-#181818">{{ block.settings.benefit_item_title | newline_to_br }}</h3>
            </div>
          </div>
        {% endfor %}

      </div>
      <div class="swiper-pagination life-activity-benefit-pagination-pc"></div>
    </div>

    {% comment %} If we need navigation buttons {% endcomment %}
    <div class="swiper-button-prev benefit-pc-button-prev"></div>
    <div class="swiper-button-next benefit-pc-button-next"></div>
  </div>

  {% comment %} Mobile 轮播 {% endcomment %}
  <div class="block lg:hidden swiper life-activity-benefit-mb rounded-20">
    <ul class="swiper-wrapper w-full">
      {% for block in Benefit_Slides %}
        <li class="swiper-slide w-full flex-start flex-col px-40 py-60 min-h-720">
          <div class="w-670 h-470 pt-50 flex-start flex-col relative benefit-item-mb">
            <img
              loading="lazy"
              class="w-340 h-300 object-contain"
              src="{{ block.settings.benefit_item_image | image_url: width: 600}}"
              alt="">
            <h3 class="w-full absolute left-0 bottom-25 text-center text-30 leading-36 font-semibold text-#333">{{ block.settings.benefit_item_title | newline_to_br }}</h3>
          </div>
          <p class="text-#666 text-28 leading-36 font-normal mt-30 line-clamp-7">{{ block.settings.benefit_item_description | newline_to_br }}</p>
        </li>
      {% endfor %}
    </ul>

    {% comment %} swiper 分页 {% endcomment %}
    <div class="swiper-pagination life-activity-benefit-pagination-mb"></div>
  </div>
</section>

{% schema %}
  {
    "name": "Life Activity Benefit",
    "class": "section-life-activity section-life-activity-benefit",
    "settings": [
      {
        "type": "textarea",
        "id": "benefit_title",
        "label": "Activity Benefit Title",
        "default": "Activity Benefits"
      }, {
        "type": "textarea",
        "id": "benefit_description",
        "label": "Activity Benefit Description",
        "default": "Click to view the competition agreement and entry conditions more details."
      }
    ],
    "blocks": [
      {
        "type": "benefit_item",
        "name": "Benefit Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "benefit_item_image",
            "label": "Benefit Item Image"
          }, {
            "type": "textarea",
            "id": "benefit_item_title",
            "label": "Benefit Item Title"
          }, {
            "type": "textarea",
            "id": "benefit_item_description",
            "label": "Benefit Item Description"
          }
        ]
      }
    ]
  }
{% endschema %}