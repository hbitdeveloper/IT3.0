<div id="products-list" class="px-60 lg:j-px-0 relative">
    <ul class="w-full lg:j-w-1540 mx-auto flex flex-col gap-25 lg:j-gap-60">
        {% for block in section.blocks %}
            <li class="w-full flex flex-col lg:flex-row lg:j-gap-x-70 p-50 lg:j-px-115 lg:j-py-60 rounded-30 lg:j-rounded-30 bg-white">
                <h2 class="block lg:hidden jky-text-xl text-center text-black font-600 mb-35 text-overflow-2">{{block.settings.product.title | escape}}</h2>

                {% assign lo_index = forloop.index %}
                {% assign index_ = lo_index | modulo:2 %}

                <img
                    class="hidden lg:block order-1 {%if index_ == 0 %}lg:order-2{% endif %} w-525 h-390 lg:j-w-718 lg:j-h-580 mb-10"
                    src="{{block.settings.p_img | image_url: width: 700}}"
                    alt="{{block.settings.p_img.alt}}" loading="lazy"
                />
                <img
                    class="block lg:hidden order-1 {%if index_ == 0 %}lg:order-2{% endif %} w-525 h-390 lg:j-w-718 lg:j-h-580 mb-10"
                    src="{{block.settings.m_img | image_url: width: 700}}"
                    alt="{{block.settings.m_img.alt}}" loading="lazy"
                />
                <div class="lg:flex-1 order-2 {%if index_ == 0 %}lg:order-1{% endif %} flex flex-col items-center justify-center lg:items-start">
                    {% if block.settings.product.url %}
                        <h3 class="hidden lg:block jky-text-xl text-black font-600 mb-10 lg:j-mb-10 text-overflow-2">
                            <a class="text-black" href="{{block.settings.product.url}}">{{block.settings.product.title | escape}}</a>
                        </h3>
                    {% else %}
                        <h3 class="hidden lg:block jky-text-xl text-black font-600 mb-10 lg:j-mb-10 text-overflow-2">{{block.settings.product.title | escape}}</h3>
                    {% endif %}
                    <p class="text-24 leading-36 lg:j-text-24 lg:j-leading-36 text-center lg:text-left text-main font-500 mb-40 lg:j-mb-35">{{block.settings.p_subtitle | newline_to_br}}</p>
                    <dl class="de-grid-cols-2 w-full grid grid-cols-4 items-start gap-0 lg:j-gap-25 mb-15 lg:j-mb-15">
                        <dd class="flex items-center flex-col lg:j-w-120">
                            <img
                                class="w-80 h-80 lg:j-w-80 lg:j-h-80 object-contain"
                                src="{{block.settings.icon_1 | image_url: width: 90}}"
                                alt="{{block.settings.icon_1.alt}}" loading="lazy"
                            />
                            <span
                                class="text-center text-20 leading-30 scale-[0.83] lg:scale-100 lg:j-text-18 lg:j-leading-27 text-main font-300 mt-10 lg:j-mt-15"
                                style="word-break:keep-all;"
                            >{{block.settings.icon_t_1 | newline_to_br}}</span>
                        </dd>
                        <dd class="flex-center flex-col lg:j-w-120">
                            <img
                                class="w-80 h-80 lg:j-w-80 lg:j-h-80 object-contain"
                                src="{{block.settings.icon_2 | image_url: width: 90}}"
                                alt="{{block.settings.icon_2.alt}}" loading="lazy"
                            />
                            <span
                                class="text-center text-20 leading-30 scale-[0.83] lg:scale-100 lg:j-text-18 lg:j-leading-27 text-main font-300 mt-10 lg:j-mt-15"
                                style="word-break:keep-all;"
                            >{{block.settings.icon_t_2 | newline_to_br}}</span>
                        </dd>
                        <dd class="flex-center flex-col lg:j-w-120">
                            <img
                                class="w-80 h-80 lg:j-w-80 lg:j-h-80 object-contain"
                                src="{{block.settings.icon_3 | image_url: width: 90}}"
                                alt="{{block.settings.icon_3.alt}}" loading="lazy"
                            />
                            <span
                                class="text-center text-20 leading-30 scale-[0.83] lg:scale-100 lg:j-text-18 lg:j-leading-27 text-main font-300 mt-10 lg:j-mt-15"
                                style="word-break:keep-all;"
                            >{{block.settings.icon_t_3 | newline_to_br}}</span>
                        </dd>
                        <dd class="flex-center flex-col lg:j-w-120">
                            <img
                                class="w-80 h-80 lg:j-w-80 lg:j-h-80 object-contain"
                                src="{{block.settings.icon_4 | image_url: width: 90}}"
                                alt="{{block.settings.icon_4.alt}}" loading="lazy"
                            />
                            <span
                                class="text-center text-20 leading-30 scale-[0.83] lg:scale-100 lg:j-text-18 lg:j-leading-27 text-main font-300 mt-10 lg:j-mt-15"
                                style="word-break:keep-all;"
                            >{{block.settings.icon_t_4 | newline_to_br}}</span>
                        </dd>
                    </dl>
                    {% assign target = block.settings.product.selected_or_first_available_variant %}
                    {% assign compare_at_price = target.compare_at_price %}
                    {% assign price = target.price | default: 1999 %}
                    {% assign available = target.available | default: false %}
                    {% assign money_price = price | money %}
                    {% if target == block.settings.product and block.settings.product.price_varies %}
                        {% assign money_price = 'products.product.price.from_price_html' | t: price: money_price %}
                    {% endif %}

                    {% render 'product-sale-price', product: block.settings.product %}

                    <a class="z-button-fill-big-solid" href="{{block.settings.product.url}}" data-analytics-title="{{ block.settings.product.title | escape }}">{{ 'general.action_text.learn_more' | t }} 
                        <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
                    </a>
                </div>
            </li>
        {% endfor %}
    </ul>
</div>


{% schema %}
    {
      "name": "Products",
      "class": "section section-collection-products section-sp-pps-sg-collection",
      "settings": [],
      "blocks": [
          {
            "type": "product_collection",
            "name": "Collection Product",
            "settings": [
                {"type": "product", "id": "product", "label": "Product"},
                {"type": "image_picker", "id": "p_img", "label": "Product PC image"},
                {"type": "image_picker", "id": "m_img", "label": "Product Mobile image"},
                {"type": "textarea", "id": "p_subtitle", "label": "Product Heading"},
                {"type": "image_picker", "id": "icon_1", "label": "Product icon 1"},
                {"type": "textarea", "id": "icon_t_1", "label": "Product advantage 1"},
                {"type": "image_picker", "id": "icon_2", "label": "Product icon 2"},
                {"type": "textarea", "id": "icon_t_2", "label": "Product advantage 2"},
                {"type": "image_picker", "id": "icon_3", "label": "Product icon 3"},
                {"type": "textarea", "id": "icon_t_3", "label": "Product advantage 3"},
                {"type": "image_picker", "id": "icon_4", "label": "Product icon 4"},
                {"type": "textarea", "id": "icon_t_4", "label": "Product advantage 4"}
            ]
          }
        ]
    }
{% endschema %}
