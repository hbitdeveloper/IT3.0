{% comment %} 日本防灾日 dp-fit-scenes组件 {% endcomment %}
{% schema %}
  {
    "name": "DP Fit scenes",
    "tag": "section",
    "class": "dp-fit-scenes",
    "settings": [
      {
        "type": "image_picker",
        "id": "titleImgPC",
        "label": "Title Image (PC)"
      },
      {
        "type": "image_picker",
        "id": "titleImgMB",
        "label": "Title Image (MB)"
      }
    ],
    "max_blocks": 6,
    "blocks": [
      {
        "name": "Scenes Item",
        "type": "slide",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "image_picker",
            "id": "sceneImg",
            "label": "Scene Image"
          }
        ]
      }
    ]
  }
  {% endschema %}
  
  <div class="dp-fit-scenes-box">
    <div class="dp-title dp-animation">
      {%- 
        render 'responsive-image', 
        image: section.settings.titleImgPC, 
        mimage: section.settings.titleImgMB,
        width: 718,
        mwidth: 290
      -%}
    </div>
    <div class="ul-box">
      {% for block in section.blocks %}
        <div class="item-fit dp-animation">
          <div class="item-title">
            <p>{{block.settings.title}}</p>
          </div>
          <div class="item-img">
            {%- 
              render 'responsive-image', 
              image: block.settings.sceneImg, 
              image_class: 'scenes-img lazy',
              width: 424,
              mwidth: 160
            -%}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  