{% comment %}
两种UI版式：
1. Full Screen Regular UI（通屏普通版），默认UI
2. Centered And Concise UI（居中简洁版）
  A. 该版式下 隐藏了默认版式中 标题、 星级、文案展开更多下箭头、用户头像、图片上产品跳转锚点等内容
  B. 该版式下 新增了跳转右箭头，其链接数据 取自于 【Product link】
{% endcomment %}
<section class="index-voice-section {{ section.settings.componentStyle }}">
  {% comment %} Full Screen Regular UI（通屏普通版）{% endcomment %}
  {% if section.settings.componentStyle == 'full-screen-reg' or section.settings.componentStyle == blank %}
    {% if section.settings.title != blank %}
      <div class="index-voice-title jky-text-2xl text-center mobile-block">
        {{ section.settings.title | escape }}
      </div>
    {% endif %}
    <div class="index-voice relative">
      <div class="voice-banner absolute left-0 right-0 bottom-0 top-0 flex">
        <div class="voice-image-swiper-container" style="overflow-x: hidden;">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide relative">
                {% render 'responsive-image', image: block.settings.image, mimage: block.settings.image, image_class: 'vocie-banner', nolazy: 'yes' %}

                <a href="{{ block.settings.p_link }}" class="voice-pointer voice-pointer-p flex absolute items-center" style="bottom: {{ block.settings.pc_y }}vw;left: {{ block.settings.pc_x }}vw;">
                  <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_2x_0cdd2b58-1c28-427e-af1b-b68c5f8df76d.png?v=1670312292" alt="{{ block.settings.p_name }}">

                  <div class="voice-pointer-title jky-text-sm font-300" style="color: {{block.settings.p_name_color}}">{{ block.settings.p_name | newline_to_br }}</div>
                </a>

                <a href="{{ block.settings.p_link }}" class="voice-pointer voice-pointer-m flex absolute items-center" style="bottom: {{ block.settings.m_y }}vw;left: {{ block.settings.m_x }}vw;">
                  <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_2x_0cdd2b58-1c28-427e-af1b-b68c5f8df76d.png?v=1670312292" alt="{{block.settings.p_name}}">

                  <div class="voice-pointer-title jky-text-sm font-300" style="color: {{block.settings.p_name_color}}">{{ block.settings.p_name | newline_to_br }}</div>
                </a>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="voice-list-container relative">
        {% if section.settings.title != blank %}
          <h2 class="index-voice-title jky-text-2xl pc-block text-overflow-1 font-bold">
            {{ section.settings.title | escape }}
          </h2>
        {% endif %}

        <div class="voice-list-swiper-container swiper">
          <div class="swiper-wrapper flex">
            {% for block in section.blocks %}
              <div class="swiper-slide">
                <div class="container">
                  <div class="clearfix">
                    <div class="rate">
                      <label title="5.0" rate="5" {% if block.settings.rating == 5 %}class="checked"{% endif %}></label>
                      <label title="4.0" rate="4" {% if block.settings.rating == 4 %}class="checked"{% endif %}></label>
                      <label title="3.0" rate="3" {% if block.settings.rating == 3 %}class="checked"{% endif %}></label>
                      <label title="2.0" rate="2" {% if block.settings.rating == 2 %}class="checked"{% endif %}></label>
                      <label title="1.0" rate="1" {% if block.settings.rating == 1 %}class="checked"{% endif %}></label>
                    </div>
                  </div>

                  <div class="voice-item-title jky-text-sm font-400">{{ block.settings.review_title | escape }}</div>
                  <div class="vocie-item-content jky-text-sm font-400 text-overflow-3">
                    {{ block.settings.user_comment | escape }}
                  </div>

                  <div class="voice-content-all text-center relative">
                    <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-sm font-400"></jds-icon>
                  </div>

                  <div class="voice-user flex items-center">
                    <div class="user-avator relative">
                      <img class="avator" src="{{ block.settings.user_avator | image_url: width: 77 }}" alt="{{block.settings.user_name}}" loading="lazy">

                      <img class="renzheng absolute bottom-0 right-0" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_1_2x_f1b3030c-8c66-4b42-bb45-620ff89a90a2.png?v=1670307826" alt="renzheng" loading="lazy">
                    </div>
                    <div class="user-name jky-text-sm font-bold">{{ block.settings.user_name }}</div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="pagination-navigation flex">
          <div class="slideshow-pagination-voice"></div>

          <div class="slideshow-navigation flex">
            <div class="slideshow-navigation-button prev">
                {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
            </div>
            <div class="slideshow-navigation-button next">
                {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %} Centered And Concise UI（居中简洁版）{% endcomment %}
  {% if section.settings.componentStyle == 'center-concise' %}
    <div class="index-voice relative">
      <div class="voice-banner absolute left-0 right-0 bottom-0 top-0 flex">
        <div class="voice-image-swiper-container" style="overflow-x: hidden;">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide relative">
                {% render 'responsive-image', image: block.settings.image, mimage: block.settings.image, image_class: 'vocie-banner', nolazy: 'yes' %}
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="pagination-navigation flex">
          <div class="slideshow-navigation flex">
            <div class="slideshow-navigation-button prev">
                {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
            </div>
            <div class="slideshow-pagination-voice"></div>
            <div class="slideshow-navigation-button next">
                {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
            </div>
          </div>
        </div>
      </div>

      <div class="voice-list-container relative">
        <div class="voice-list-swiper-container swiper">
          <div class="swiper-wrapper flex">
            {% for block in section.blocks %}
              <div class="swiper-slide">
                <div class="container">
                  <div class="voice-content-box">
                    <div class="voice-item-title jky-text-sm font-400">{{ block.settings.review_title | escape }}</div>
                    <div class="vocie-item-content jky-text-sm font-400">
                      {{ block.settings.user_comment | escape }}
                    </div>
                  </div>

                  <div class="voice-user flex items-center relative">
                    <div class="user-name jky-text-sm font-bold">{{ block.settings.user_name }}</div>
                    <a href="{{ block.settings.p_link }}" class="link-arrow">
                      <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-sm"></jds-icon>
                    </a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.btnMoreTxt != blank %}
    <a class="btn-more z-button-big" href="{{ section.settings.btnMoreLink }}">{{ section.settings.btnMoreTxt }}</a>
  {% endif %}

</section>
{% schema %}
{
  "name": "Voice swiper",
  "settings": [
    {"type": "text", "id": "title", "label": "Section title", "default": "Voice from Our Customers"},
    {
      "type": "select",
      "id": "componentStyle",
      "label": "Component Style",
      "default": "full-screen-reg",
      "options": [
        {
          "value": "full-screen-reg",
          "label": "Full Screen Regular UI"
        },
        {
          "value": "center-concise",
          "label": "Centered And Concise UI"
        }
      ]
    },
    {
      "type": "text",
      "id": "btnMoreTxt",
      "label": "Button More Text"
    },
    {
      "type": "url",
      "id": "btnMoreLink",
      "label": "Button More Link"
    }
  ],
  "blocks": [{
    "type": "image", "name": "Slide Voice",
    "settings": [
      {"type": "textarea", "id": "p_name", "label": "Product name"},
      {"type": "color", "id": "p_name_color", "label": "Product name color", "default": "#ffffff"},
      {"type": "url", "id": "p_link", "label": "Product link"},
      {"type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 4, "label": "Review Rating"},
      {"type": "textarea", "id": "review_title", "label": "Review title"},
      {"type": "textarea", "id": "user_comment", "label": "User comment"},
      {"type": "text", "id": "user_name", "label": "User name"},
      {"type": "image_picker", "id": "user_avator", "label": "User avator"},
      {"type": "image_picker", "id": "image", "label": "Image"},
      {"type": "range", "id": "pc_x", "min": 0, "max": 50, "step": 1, "default": 28, "label": "PC position x"},
      {"type": "range", "id": "pc_y", "min": 0, "max": 50, "step": 1, "default": 14, "label": "PC position y"},
      {"type": "range", "id": "m_x", "min": 0, "max": 100, "step": 1, "default": 63, "label": "Mobile position x"},
      {"type": "range", "id": "m_y", "min": 0, "max": 50, "step": 1, "default": 37, "label": "Mobile position y"}
    ]
  }]
}
{% endschema %}
