{%- style -%}
  .image-swiper {background: #fff;padding: 0;height: 800px;}
  .image-container {width: 100%;height: 700px;}
  .image-container .swiper-slide {
    background: #ffffff;
    width: 1200px;
    transition: all 0.3s;
    height: 700px;
    max-width: 100%;
    padding: 0 25px;
  }
  .image-container .swiper-slide > img {
    max-height: 700px;
  }
  .image-container .swiper-slide .image-swiper-content::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 8px;
    background: transparent;
  }
  .image-container .swiper-slide-active .image-swiper-content::before {
    background: var(--primary-color);
  }
  .image-container .swiper-slide-active {
    padding: 0;
  }
  .image-swiper-content {
    padding: 28px 50px;
    flex: 1;
    box-shadow: 0 3px 11px 0 rgba(85, 85, 85, 0.2);
  }
  .image-swiper-name {
    margin-bottom: 20px;
    font-weight: 600;
    color: #333;
  }
  .image-swiper-des {
    max-width: 800px;
  }
  .image-swiper .slideshow-pagination {
    bottom: 50px;
  }
  .image-swiper .image-imgblock {
    overflow: hidden;
  }
  .image-swiper .ani-fade-img .image-imgblock img {
    animation: zoom-fade 2s cubic-bezier(0.26, 0.54, 0.32, 1) 0s forwards;
  }
  .image-swiper .image-imgblock img {
    height: 700px;
    width: 100%;
    object-fit: cover;
  }
  .image-swiper .image-imgblock img {
    transition: transform 0.5s ease;
  }
  .image-swiper .image-imgblock:hover img {
    transform: scale(1.05);
  }
  .category-product {
    width: 100%;
    padding-top: 120px;
    background-color: #fff;
  }
  .category-product h2 {
    width: 100%;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 50px;
  }
  .category-product h2 span {
    font-size: 45px;
    font-weight: 500;
    color: #000000;
    line-height: 66px;
  }
  .category-product h2 .icon-arrow-down {
    display: none;
    font-size: 22px;
    font-weight: 400;
    transition: transform 0.5s;
  }
  .category-product[data-active] h2 .icon-arrow-down {
    transform: rotate(-180deg);
  }
  .product-list {
    max-width: 1200px;
    margin: 10px auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .product-list li {
    background: #ffffff;
    box-shadow: 0 6px 20px 0 rgba(85, 85, 85, 0.2);
    padding: 40px 30px 20px;
    flex-direction: column;
    justify-content: space-between;
  }
  .product-info {
    flex-direction: column;
  }
  .product-info h3 {
    text-align: center;
    font-size: 24px;
    font-weight: 500;
    color: #333333;
    line-height: 36px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .product-info img {
    width: 280px;
    height: 280px;
    object-fit: cover;
    margin: 10px 0 20px;
  }
  .product-info .price em {
    font-size: 26px;
    font-weight: 500;
    color: var(--jds-color-primary);
    line-height: 39px;
  }
  .product-info .price del {
    font-size: 22px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.6);
    line-height: 33px;
    margin-left: 10px;
  }
  .product-info .text {
    width: 100%;
    text-align: center;
    font-size: 14px;
    font-weight: 400;
    color: #333333;
    line-height: 21px;
    margin: 8px 0 12px;
  }
  .product-chose {
    width: 100%;
    flex-wrap: wrap;
    gap: 10px;
  }
  .product-chose span {
    background: #f2f2f2;
    border-radius: 5px;
    border: 1px solid transparent;
    padding: 5px 10px;
    font-size: 14px;
    font-weight: 400;
    color: #000000;
    line-height: 21px;
    cursor: pointer;
  }
  .product-chose span.active {
    background: #fef7f6;
    border-color: var(--jds-color-primary);
  }
  .tips-words {
    height: 42px;
    font-size: 14px;
    font-weight: 400;
    color: #000000;
    line-height: 21px;
    margin: 20px 0;
  }
  .button-wrap {
  }

  .button-wrap .apg-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .button-wrap p {
    height: 21px;
    font-size: 14px;
    font-weight: 400;
    color: #999999;
    line-height: 21px;
    margin-top: 12px;
    text-align: center;
  }

  #bundles {
    padding-bottom: 120px;
  }

  .product-buy .a-button-fill {
    padding: 0.625vw 1.2vw;
  }

  @media only screen and (max-width: 768px) {
    .product-buy .a-button-fill {
      padding: 2.2vw 5vw !important;
    }
    .section-page-accessories-category {
      background-color: #f5f5f5;
    }
    .category-product {
      padding: 0;
      background-color: #f5f5f5;
    }
    .category-product:first-of-type {
      margin-top: 0;
    }
    .category-product h2 {
      width: 100%;
      justify-content: space-between;
      padding: 8vw;
      margin-bottom: 8.8vw;
    }
    .category-product h2 span {
      font-size: 4.266666666666667vw;
      line-height: 6.4vw;
    }
    .category-product h2 .icon-arrow-down {
      display: block;
    }
    .product-content {
      width: 100%;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.5s;
    }
    .product-list {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 4.8vw;
      padding: 0 8vw;
    }
    .category-product[data-active] .product-content {
      max-height: 1000vh;
    }
    .product-list li {
      box-shadow: none;
      padding: 6.666666666666667vw 5.333333333333333vw;
    }
    .product-list li:last-of-type {
      margin-bottom: 13.333333333333334vw;
    }
    .product-info h3 {
      font-size: 3.475935828877005vw;
      line-height: 5.333333333333333vw;
    }
    .product-info .price em {
      font-size: 4.8vw;
      font-weight: 600;
      line-height: 7.2vw;
    }
    .product-info .price del {
      font-size: 3.2vw;
      font-weight: 400;
      line-height: 4.8vw;
      margin-left: 1.0666666666666667vw;
    }
    .product-info .text {
      text-align: left;
      font-size: 3.2vw;
      font-weight: 400;
      line-height: 4.8vw;
      margin: 4.266666666666667vw 0 1.6vw;
    }
    .product-chose span {
      padding: 1.3333333333333333vw;
      font-size: 3.2vw;
      line-height: 4.8vw;
    }
    .tips-words {
      height: auto;
      font-size: 3.466666666666667vw;
      font-weight: 400;
      line-height: 4vw;
      margin: 4.266666666666667vw 0;
    }
    .button-wrap {
      gap: 4vw;
    }
    .button-wrap p {
      height: auto;
      font-size: 3.2vw;
      font-weight: 400;
      color: #cccccc;
      line-height: 4vw;
    }
    #bundles {
      padding-bottom: 0;
    }
  }
{%- endstyle -%}

{%- assign CR = localization.country.iso_code -%}
{%- assign account_url = "https://account.jackery.com" -%}
{% if shop.id == 55005249633 or shop.id == 56124375224 or shop.id == 64525172955 %}
    {%- assign account_url = "https://demo-account.jackery.com" -%}
{% elsif shop.id == 79611232554 or theme.role == "unpublished" %}
    {%- assign account_url = "https://account-uat.jackery.com" -%}
{% endif %}

{% comment %} 内容 {% endcomment %}
<div
  id="{{section.settings.product_type}}"
  class="category-product"
  data-active
>
  {% comment %} 标题 {% endcomment %}
  <h2>
    <span>{{ section.settings.group_title | newline_to_br }}</span>
    <jds-icon name="arrow-down" class="icon-arrow-down"></jds-icon>
  </h2>

  <div class="product-content">
    {% comment %} 图片轮播 {% endcomment %}
    {% render "accessories-banner-swiper", groupId: {{section.settings.product_type}}, blocks: section.blocks %}

    {% comment %} 产品列表 {% endcomment %}
    <ul class="product-list">
      {% for product in collections[section.settings.accessories_products].products
        limit: section.settings.products_to_show
      %}
        {% assign target = product.selected_or_first_available_variant %}
        {% assign apply_count = product.metafields.custom.apply.value | split: ',' | size %}
        {% assign compare_at_price = target.compare_at_price %}
        {% assign price = target.price | default: 1999 %}
        {% assign available = target.available | default: false %}
        {% assign money_price = price | money %}
        {% if target == product and product.price_varies %}
          {% assign money_price = 'products.product.price.from_price_html' | t: price: money_price %}
        {% endif %}

        <li class="flex">
          <div class="flex items-center product-info">
            <h3>{{ product.title | escape }}</h3>

            {%- 
              render 'responsive-image', 
              image: product.featured_image, 
              width: 280
            -%}
            <div class="flex items-center price">
              {% if available %}
                <em>{{ money_price }}</em>
                {%- if product.compare_at_price_varies > product.price %}
                  <span class="index-product-price-origin h3" style="text-decoration-line:line-through;">{{ compare_at_price | money }}</span>
                {%- endif -%}
              {% else %}
                <em>{{ section.settings.unavailable_text | escape }}</em>
              {% endif %}
            </div>
            <p class="text">{{ section.settings.apply_for_text | escape }}:</p>
            <div class="flex items-center product-chose {% if apply_count == 0 %} justify-center {% else %} justify-start {% endif %}">
              {% if apply_count == 0 %}
                <span class="active">{{ section.settings.for_all_text | escape }}</span>
              {% else %}
                {% for plan in product.metafields.custom.apply.value %}
                  <span class="{% if forloop.index0 == 0 %} active {% endif %}">
                    {% if plan.metafields.custom.shortname %}
                      {{ plan.metafields.custom.shortname }}
                    {% else %}
                      {{ plan.title }}
                    {% endif %}
                  </span>
                {% endfor %}
              {% endif %}
            </div>
          </div>
          <div class="product-buy">
            <div class="tips-words">
              {% if available == false %}
                {{ accessories.contact_info | t }}
              {% endif %}
            </div>
            <div class="flex button-wrap">
              <div class="flex-1">
                {% if available %}
                  <a class="a-button-fill blog-cate-link jky-text-xs" href="/products/{{product.handle}}">
                    {{ 'general.action_text.learn_more' | t }}
                    <jds-icon name="arrow-right" class="icon-arrow-right text-xs"></jds-icon>
                  </a>
                  <p></p>
                {% else %}
                  <a class="a-button-fill blog-cate-link jky-text-xs" href="/pages/contact">
                    {{ section.settings.contact_btn | escape }}
                    <jds-icon name="arrow-right" class="icon-arrow-right text-xs"></jds-icon>
                  </a>
                  <p>{{ section.settings.contact_tip | escape }}</p>
                {% endif %}
              </div>
              <div class="flex-1">
                {% if available %}
                  <button
                    class="a-button-fill blog-cate-link jky-text-xs"
                    data-id="{{product.variants[0].id}}"
                    data-add-to-cart
                  >
                    {{ section.settings.add_to_cart_btn | escape }}
                    <jds-icon name="arrow-right" class="icon-arrow-right text-xs"></jds-icon>
                  </button>
                  <p></p>
                {% else %}
                  <a class="a-button-fill blog-cate-link jky-text-xs" href="{{account_url | append: '/register' | append: "?cr=" | append: CR}}">
                    {{ section.settings.register_btn | escape }}
                    <jds-icon name="arrow-right" class="icon-arrow-right text-xs"></jds-icon>
                  </a>
                  <p>{{ section.settings.register_tip | escape }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        </li>
      {% endfor %}
      {% for block in section.blocks %}
        {% if block.type == 'not-sales-products' %}
          <li class="flex">
            <div class="flex items-center product-info">
              <h3>{{ block.settings.title | escape }}</h3>
              <img
                src="{{ block.settings.product_img | image_url: width: 600}}"
                alt="{{ block.settings.title }}" loading="lazy"
              >
              <div class="flex items-center price">
                <em>{{ block.settings.not_sales_text | escape }}</em>
              </div>
              <p class="text">Apply For:</p>
              <div class="flex items-center product-chose  justify-start ">
               {% assign apply_lists = block.settings.apply_lists | split: ',' %}
               {%for applyLabel in apply_lists%}
                <span class=""> {{ applyLabel }} </span>
                {%endfor%}
              </div>
            </div>
            <div class="product-buy">
              <div class="tips-words">{{ block.settings.product_tips | escape }}</div>
              <div class="flex button-wrap">
                <div class="flex-1 apg-btn">
                  <a
                    class="a-button-fill blog-cate-link jky-text-xs"
                    href="{{ block.settings.button_1_url }}"
                  >
                    {{ block.settings.button_1_text | escape }}
                    <jds-icon name="arrow-right" class="icon-arrow-right text-xs"></jds-icon>
                  </a>
                  <p>{{ block.settings.button_1_desc | escape }}</p>
                </div>
                <div class="flex-1 apg-btn">
                  <a
                    class="a-button-fill blog-cate-link jky-text-xs"
                    href="{{ block.settings.button_2_url }}"
                  >
                    {{ block.settings.button_2_text | escape }}
                    <jds-icon name="arrow-right" class="icon-arrow-right text-xs"></jds-icon>
                  </a>
                  <p>{{ block.settings.button_2_desc | escape }}</p>
                </div>
              </div>
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Products Group",
  "class": "section section-collection-products",
  "settings": [
    {
      "type": "textarea",
      "id": "group_title",
      "label": "Products Group title",
      "default": "PORTABLE POWER STATIONS ACCESSORIES"
    },
    {
      "type": "select",
      "id": "product_type",
      "label": "Product Type",
      "options": [
        {
          "value": "portable_power",
          "label": "Portable Power"
        },
        {
          "value": "solar_panels",
          "label": "Solar Panels"
        },
        {
          "value": "bundles",
          "label": "Bundles"
        }
      ],
      "default": "portable_power"
    },
    {
      "type": "collection",
      "id": "accessories_products",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Products show number",
      "default": 6
    },
    {
      "type": "text",
      "id": "unavailable_text",
      "label": "Unavailable text",
      "default": "Not for sale"
    },
    {
      "type": "text",
      "id": "apply_for_text",
      "label": "Apply For title",
      "default": "Apply For"
    },
    {
      "type": "text",
      "id": "for_all_text",
      "label": "For All Text",
      "default": "For All"
    },
    {
      "type": "text",
      "id": "add_to_cart_btn",
      "label": "Add To Cart text",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "contact_btn",
      "label": "Contact text",
      "default": "CONTACT"
    },
    {
      "type": "text",
      "id": "contact_tip",
      "label": "Contact tip",
      "default": "I have a member"
    },
    {
      "type": "text",
      "id": "register_btn",
      "label": "Register text",
      "default": "REGISTER NOW"
    },
    {
      "type": "text",
      "id": "register_tip",
      "label": "Register tip",
      "default": "I don't have a member"
    }
  ],
  "blocks": [
    {
      "type": "products-banner",
      "name": "Product Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_pc_img",
          "label": "Product PC Image"
        },
        {
          "type": "image_picker",
          "id": "product_mb_img",
          "label": "Product Mobile Image"
        }
      ]
    },
    {
      "type": "not-sales-products",
      "name": "Not Sales Product",
      "settings": [
        { "type": "text", "id": "title", "label": "Product Title" },
        { "type": "image_picker", "id": "product_img", "label": "Product Image" },
        { "type": "text", "id": "not_sales_text", "label": "Not Sales Text" },
        { "type": "text", "id": "apply_lists", "label": "Apply Content, as: xx,xx,xx" },
        { "type": "text", "id": "product_tips", "label": "Product Tips" },

        { "type": "text", "id": "button_1_text", "label": "Button 1 Text" },
        { "type": "url", "id": "button_1_url", "label": "Button 1 Url" },
        { "type": "text", "id": "button_1_desc", "label": "Button 1 Desc" },

        { "type": "text", "id": "button_2_text", "label": "Button 2 Text" },
        { "type": "url", "id": "button_2_url", "label": "Button 2 Url" },
        { "type": "text", "id": "button_2_desc", "label": "Button 2 Desc" }
      ]
    }
  ]
}
{% endschema %}
