
  {% style %}
    .subscribe-live-banner .field_error-tips {
      position: absolute;
      top: calc(100% + 1px);font-size: 12px;font-weight: 400;color: var(--error-color);
    }

    .subscribe-live-banner.type-subs_mode_pic .subs_mode_pic--show {
        display: block;
    }
    .subscribe-live-banner.type-subs_mode_color .subs_mode_color--show {
        display: block;
    }

    .subscribe-live-banner jky-checkbox {
      flex: unset;
    }

    .subscribe-live-banner .subscribe-banner-content .blocks-subscribe-banner-form {
      border: 2px solid #FFFFFF;
    }

    @media screen and (max-width: 1024px) {
      .subscribe-live-banner .subscribe-banner-content .blocks-subscribe-banner-form {
        display:none;
      }
    }
  {% endstyle %}

  {%- capture style -%}
    {% render 'spacing-padding', settings: section.settings %}
  {%- endcapture -%}
  <div
      {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
      class="subscribe-live-banner group blocks-subscribe-banner lg:h-[{{section.settings.pc_height | divided_by: 16.0}}rem] section-padding h-auto w-full type-subs_mode_pic-{{section.id}} type-subs_mode_pic
      relative flex justify-center items-center {% if settings.enable_animations_scroll %}scroll-trigger animate--slide-in{% endif %}"
      style="--desktop-height:{{section.settings.pc_height | divided_by: 16.0}}rem;--mobile-height:{{section.settings.mb_height | divided_by: 32.0}}rem;{{style}}"
  >

    {%- if section.settings.img_pc != blank -%}
      {%- assign mimage = section.settings.img_pc -%}
      {%- if section.settings.img_mb != blank -%}
          {%- assign mimage = section.settings.img_mb -%}
      {%- endif -%}
      {% render 'responsive-image', image: section.settings.img_pc, image_class: 'blocks-image-pic w-full h-[31.25rem] lg:h-full inset-0 absolute object-cover', mimage: mimage %}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full inset-0 absolute object-cover' }}
    {%- endif -%}

    <div class="subscribe-live-content flex justify-between items-center lg:flex-row flex-col section-container-lg lg:pr-[2.5rem]">
      <div class="subscribe-banner-content lg:w-[50rem] w-full relative z-2
        h-full lg:h-fit lg:pt-0 pb-[1.5rem] lg:pb-0 lg:justify-between flex flex-col subs-banner-top_mb justify-start">
        {% content_for 'blocks' %}
      </div>
      <div class="subscribe-live-video lg:w-[21rem] w-[20.4375rem] h-fit lg:h-[35rem]">
        {{ section.settings.custom_liquid }}
      </div>
    </div>
  </div>

