{% assign stepItems = section.blocks | where: 'type', 'step_item' %}

<section class="w-full flex-center flex-col py-60 lg:j-py-80 xl:a-py-80">
  {% if section.settings.title != blank %}
    <h2 class="w-full px-40 lg:px-0 lg:j-w-1000 xl:a-w-1000 text-left lg:text-center text-#191919 font-600 text-48 leading-58 mb-10 lg:j-text-40 lg:j-leading-48 lg:j-mb-10 xl:a-text-40 xl:a-leading-48 xl:a-mb-10">
      {{ section.settings.title | newline_to_br }}
    </h2>
  {% endif %}
  {% if section.settings.sub_title != blank %}
    <p class="w-full px-40 lg:px-0 lg:j-w-1200 xl:a-w-1200 text-left lg:text-center text-black/60 lg:text-#1A1A1A font-400 text-32 leading-39 mb-30 lg:j-text-18 lg:j-leading-32 lg:j-mb-30 xl:a-text-18 xl:a-leading-32 xl:a-mb-30">
      {{ section.settings.sub_title | newline_to_br }}
    </p>
  {% endif %}
  <ul class="w-full px-40 lg:px-0 flex-start flex-wrap gap-y-30 lg:j-w-1280 lg:j-gap-x-40 lg:j-gap-y-30 xl:a-w-1280 xl:a-gap-x-40 xl:a-gap-y-30">
    {% for block in stepItems %}
      <li class="w-full h-348 flex-center bg-white shadow-[5px_10px_16px_5px_#0000001A] overflow-hidden rounded-br-60 lg:j-w-620 lg:j-h-348 lg:j-rounded-br-60 xl:a-w-620 xl:a-h-348 xl:a-rounded-br-60">
          <p class="flex-1 font-400 px-30 text-24 leading-32 line-clamp-10 lg:j-px-30 lg:j-text-24 lg:j-leading-32 xl:a-px-30 xl:a-text-24 xl:a-leading-32">
            {{ block.settings.step_content | newline_to_br }}
          </p>
          {% comment %} image {% endcomment %}
          {% render 'responsive-image',
            image: block.settings.pc_step_img,
            mimage: block.settings.mb_step_img,
            image_class: 'w-350 h-348 lg:j-w-320 lg:j-h-348 xl:a-w-320 xl:a-h-348 object-cover'
          %}
      </li>
    {% endfor %}
  </ul>
</section>

{% schema %}
  {
    "name": "photovolatic Steps",
    "class": "section-photovolatic section-photovolatic-steps",
    "enabled_on": {
      "templates": ["page"]
    },
    "presets": [
      {
        "name": "photovolatic Steps",
        "category": "光伏安装"
      }
    ],
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Section Title",
        "default": "Only 4 Steps needed \n in installation for Jackery \n All-in-one Solar Generator for Home"
      },
      {
        "type": "textarea",
        "id": "sub_title",
        "label": "Section Sub Title",
        "default": "Novice users can complete the installation in 5 minutes with 4 steps（Integrated batteries and inverter + Flexible Solar Panels）"
      }
    ],
    "blocks": [
      {
        "type": "step_item",
        "name": "Step Item",
        "settings": [
          {
            "type": "textarea",
            "id": "step_content",
            "label": "Step Content"
          },
          {
            "type": "image_picker",
            "id": "pc_step_img",
            "label": "PC Step Image"
          },
          {
            "type": "image_picker",
            "id": "mb_step_img",
            "label": "Mobile Step Image"
          }
        ]
      }
    ]
  }
{% endschema %}
