<style>
  .legal-person-btns {
    margin: 20px auto 0;
  }

  .legal-person-btns .business-other-sites {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .legal-person-btns .title {
    margin-bottom: 24px;
    font-size: 32px;
    line-height: 40px;
    font-weight: 500;
  }
  .legal-person-btns .business-other-sites a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    border: solid 1px var(--jds-color-primary);
    color: var(--jds-color-primary);
    height: 100px;
    font-size: 16px;
    font-weight: 700;
    width: 100%;
  }
  .legal-person-btns .business-other-sites a:hover {
    color: #fff;
    background-color: var(--jds-color-primary);
  }

  .legal-person-btns .business-other-sites .btn-box .text-box .new-title{
    font-weight: 500;
    font-size: 32px;
    color: #1A1A1A;
    line-height: 40px;
  }

  .legal-person-btns .business-other-sites .btn-box .text-box.center{
    text-align: center;
  }

  .legal-person-btns .business-other-sites .btn-box .text-box .new-des{
    font-weight: 500;
    font-size: 16px;
    color: #1A1A1A;
    line-height: 26px;
    margin-top: 8px;
    margin-bottom: 20px;
  }

  .legal-person-btns .business-other-sites.four {
    grid-template-columns: repeat(4, 1fr);
  }

  .legal-person-btns .business-other-sites.one {
    grid-template-columns: repeat(1, 1fr);
  }

  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
  .legal-person-btns {
    margin: 1.38888889vw auto 0;
  }
  .legal-person-btns .business-other-sites {
    gap: 0.69444444vw;
  }
  .legal-person-btns .title {
    margin-bottom: 1.66666667vw;
    font-size: 2.22222222vw;
    line-height: 2.77777778vw;
  }
  .legal-person-btns .business-other-sites a {
    height: 6.94444444vw;
    font-size: 1.11111111vw;
  }

  .legal-person-btns .business-other-sites .btn-box .text-box .new-title{
    font-size: 2.222vw;
    line-height: 2.7777vw;
  }

  .legal-person-btns .business-other-sites .btn-box .text-box .new-des{
    font-size: 1.11vw;
    line-height: 1.8vw;
    margin-top: 0.555vw;
    margin-bottom: 1.388vw;
  }
}

  @media screen and (max-width: 1023.98px) {
    .legal-person-btns .business-other-sites {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      /* max-width: 1360px; */
      /* margin: 20px auto 40px; */
    }
    .legal-person-btns .title {
      margin-bottom: 6.4vw;
      font-size: 6.4vw;
      font-weight: 500;
      line-height: 8.533333vw;
    }

    .legal-person-btns .business-other-sites a {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      border: solid 1px var(--jds-color-primary);
      color: var(--jds-color-primary);
      height: auto;
      min-height: 13.3333vw;
      font-size: 4.266666vw;
      font-weight: 700;
    }

    .legal-person-btns .business-other-sites .btn-box .text-box .new-title{
      font-size: 8.533vw;
      line-height: 10.666vw;
    }

    .legal-person-btns .business-other-sites .btn-box .text-box .new-des{
      font-size: 4.26vw;
      line-height: 6.4vw;
      margin-top: 2.133vw;
      margin-bottom: 5.333vw;
    }
    .legal-person-btns .business-other-sites a:hover {
      color: #fff;
      background-color: var(--jds-color-primary);
    }
    .legal-person-btns .business-other-sites.four {
      grid-template-columns: repeat(2, 1fr);
    }
    .legal-person-btns .business-other-sites.three.mb-one{
       grid-template-columns: repeat(1, 1fr);
    }
  }

  .legal-person-btns{
        padding-bottom: calc(var(--pc-padding-bottom) * 1px);
    }
    @media screen and (min-width: 1024px) and (max-width: 1439.98px){
        .legal-person-btns{
            padding-bottom: calc( var(--pc-padding-bottom)  * 100vw / 1440 );
        }
    }
    @media screen and (max-width: 1023.98px){
        .legal-person-btns{
            padding-bottom: calc( var(--mb-padding-bottom) * 100vw / 750 );
        }
    }

</style>

<div class="legal-person-btns legal-person" anchor="{{ section.settings.anchor | escape }}"
style="--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};"
>
  <div class="jky-12th-container">
    <div class="title">
      {{ section.settings.title }}
    </div>

    {% assign has_title = false %}
    {% for block in section.blocks %}
      {% if block.settings.title != blank %}
        {% assign has_title = true %}
      {% endif %}
    {% endfor %}

    {%- if has_title -%}
    <div class="business-other-sites {{ section.settings.type }} {%- if has_title -%} mb-one {%- endif -%} ">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          {%- assign btnLink = block.settings.link | default: 'javascript:void(0);' -%}
          <div class="btn-box">
            {%- if section.settings.type == 'three' -%}
              <div class="text-box {{ section.settings.text_align }}">
                <div class="new-title">
                  {{ block.settings.title }}
                </div>
                <div class="new-des">
                  {{ block.settings.des }}
                </div>
              </div>
            {%- endif -%}

            <a
            class="business-other-sites-link"
            href="{{ btnLink }}"
            target="{% if section.settings.new_window and block.settings.link != blank %}_blank{% else %}_self{% endif %}"
            data-ga-event="jackery_corporation_user_clicks" 
            data-ga-action="click"
            data-ga-params-module="{{ section.settings.title }}"
            data-ga-params-link="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}null{% endif %}"
            data-ga-params-button_name="{{ block.settings.text }}"
          >
            {{- block.settings.text -}}
          </a>
          </div>

        {% endif %}
      {% endfor %}
    </div>
    {%- else -%}
      <div class="business-other-sites {{ section.settings.type }}">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          {%- assign btnLink = block.settings.link | default: 'javascript:void(0);' -%}
            <a
            class="business-other-sites-link"
            href="{{ btnLink }}"
            target="{% if section.settings.new_window and block.settings.link != blank %}_blank{% else %}_self{% endif %}"
            data-ga-event="jackery_corporation_user_clicks" 
            data-ga-action="click"
            data-ga-params-module="{{ section.settings.title }}"
            data-ga-params-link="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}null{% endif %}"
            data-ga-params-button_name="{{ block.settings.text }}"
          >
            {{- block.settings.text -}}
          </a>
        {% endif %}
      {% endfor %}
    </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Legal Person Btns",
  "class": "legal-person-btn-box",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "二级标题定位锚点", "info": "搭配二级导航锚点定位未使用到定位则不配置" },
    { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false },
    { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC"},
    { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB"},
    { "type": "text", "id": "title", "label": "标题文案"},
    {
      "type": "select",
      "id": "type",
      "label": "一行几个",
      "default": "three",
      "options": [
         {
          "value": "one",
          "label": "一行一个"
        },
        {
          "value": "three",
          "label": "一行三个"
        },
        {
          "value": "four",
          "label": "一行四个"
        }
      ]
    },
     {
      "type": "select",
      "id": "text_align",
      "label": "文案对齐方式",
      "default": "left",
      "info": "一行三个配文案使用",
      "options": [
         {
          "value": "left",
          "label": "居左"
        },
        {
          "value": "center",
          "label": "居中"
        }
      ]
    }
  ],
  "blocks": [
    {
      "name": "btn Item",
      "type": "slide",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "按钮文案"
        },
        {
          "type": "url",
          "id": "link",
          "label": "按钮跳转链接"
        },
         {
          "type": "richtext",
          "id": "title",
          "label": "按钮前大文案",
          "info": "一行三个专属配置"
        },
         {
          "type": "richtext",
          "id": "des",
          "label": "按钮前小文案",
          "info": "一行三个专属配置"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Legal Person Btns"
    }
  ]
}
{% endschema %}
