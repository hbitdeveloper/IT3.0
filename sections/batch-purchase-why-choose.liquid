<div class="batch-purchase--choose">
    <div class="batch-purchase-container">
        <div class="main-title">{{ section.settings.title | escape }}</div>
        <div class="choose-block">
            {% for block in section.blocks %}
            <div class="choose-item">
                <div>
                    {%- 
                      render 'responsive-image', 
                      image: block.settings.image, 
                      width: 72, 
                      mwidth: 50,
                      loading: 'lazy'
                    -%}
                    <div class="title">{{ block.settings.title | escape }}</div>
                </div>
                <div class="sub-info">{{ block.settings.info | newline_to_br }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
  {
    "name": "Why Choose",
    "tag": "div",
    "settings": [
      { "type": "text", "id": "title", "label": "Why Choose Jackery's Official Website", "default": "Why Choose Jackery's Official Website" }
    ],
    "blocks": [
      {
        "name": "Why Choose",
        "type": "why_choose",
        "settings": [
          { "type": "image_picker", "id": "image", "label": "Image (90 * 90)" }, 
          { "type": "text", "id": "alt", "label": "Image Alt", "default": "Image" }, 
          { "type": "text", "id": "title", "label": "Title", "default": "Buy Now Pay late" }, 
          { "type": "textarea", "id": "info", "label": "Info Text", "default": "Shop today, pay at your convenience, spreading costs without interest" }
        ],
        "limit": 4
      }
    ]
  }
{% endschema %}