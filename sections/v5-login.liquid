<div 
{{ section.shopify_attributes }}
{% if section.settings.anchor != blank %}
  anchor-target="{{section.settings.anchor | escape}}"
{% endif %}
class="w-[21.4375rem]  lg:w-[82.5rem] mx-auto flex flex-start gap-10 v5-login">
    {% if section.settings.pc_img != blank %}
        <div class="hidden lg:flex w-[40rem] h-[16.5625rem] items-center justify-center">
            {% render "diff-end-img", pc_img: section.settings.pc_img, pc_img_width: 640, class: 'w-full object-cover' %}
        </div>
    {% endif %}
    <div class="flex-1">
        {%- for block in section.blocks -%}
           {%- case block.type -%}
             {%- when '@app' -%}
               {% render block %}
           {%- endcase -%}
         {%- endfor -%}
    </div>
</div>
{% schema %}
{
    "name": "V5 - 免密登陆",
    "settings": [
        {
            "type": "header",
            "content": "当前仅支持 Jackery Login Landing"
        },
        {
            "type": "image_picker",
            "id": "pc_img",
            "label": "PC 端图片(640*265)"
        }
    ],
    "limit": 2,
    "blocks": [
        {
            "type": "@app"
        }
    ],
    "presets": [
        {
            "name": "V5 - 免密登陆",
            "category": "V5.0"
        }
    ]
}
{% endschema %}