{% style %}
  html[lang='ja'] .blog-v3-frame .font-medium {
    font-weight: 600;
  }
  @media screen and (min-width: 1024px) {
    .blog-v3-h2 {
      font: var(--jds-font-h5-medium);
      letter-spacing: var(--jds-h5-letter-spacing);
      color: var(--jds-color-text-l1);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .blog-v3-h2 {
      font: var(--jds-font-h4-medium);
      letter-spacing: var(--jds-h4-letter-spacing);
      color: var(--jds-color-text-l1);
    }
  }
{% endstyle %}

<div class="blog-v3-frame w-[21.4375rem] lg:w-[66.75rem] mx-auto">
  {% if section.settings.h1_title != blank and template == 'page.blog-v3-index' %}
    <h1 class="jds-h4 font-medium pt-8 lg:pt-[4.375rem] mx-auto text-center w-[20.4375rem] lg:w-[60rem]">
      {{ section.settings.h1_title }}
    </h1>
  {% endif %}

  <div class="relative flex flex-col lg:flex-row lg:flex-wrap mt-5 lg:mt-10">
    {% assign h1_title = section.settings.h1_title | default: 'BlogTab' %}
    {% content_for 'block', type: '_blog-v3-frame-left-top', id: 'blogV3FrameLeftTop', h1_title: h1_title %}
    {% content_for 'block', type: '_blog-v3-frame-right', id: 'blogV3FrameRight' %}
    {% content_for 'block', type: '_blog-v3-frame-left-bottom', id: 'blogV3FrameLeftBottom' %}
  </div>
</div>

{% schema %}
{
  "name": "V3博客-内容区框架",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "h1_title",
      "label": "页面H1标题",
      "info": "特别说明：当前仅博客集合页使用"
    }
  ],
  "presets": [
    {
      "name": "V3博客-内容区框架",
      "category": "Blog-V3",
      "settings": {
        "h1_title": "Blog H1 Title"
      }
    }
  ]
}
{% endschema %}
