<div class="smart-recommend" style="background: #F5F5F5">
    {% render 'smart-recommend-block', smart: section.settings %}
</div>

{% schema %}
  {
    "name": "Smart Recommend",
    "tag": "section",
    "settings": [
        { "type": "textarea", "id": "title", "label": "Title Text", "default": "Find Compatible Solar Panels" },
        {"type": "text", "id": "choose_solar", "label": "Choose One Type of Solar Panel Text", "default": "Choose One Type of Solar Panel"},
        {"type": "text", "id": "recharge_time", "label": "Recharging Time Text", "default": "Recharging Time"},
        {"type": "text", "id": "save_time", "label": "Municipal Electricity Saving Text", "default": "Municipal Electricity Saving"},
        {"type": "checkbox", "id": "show_result", "label": "Is Show Recommended Result", "default": true},
        {"type": "textarea", "id": "recommend_result", "label": "Recommended Result Text", "default": "Recommended Solar Generator Solution"},
        {"type": "text", "id": "access_text", "label": "Need Accessories Text", "default": "You Need These Accessories"},
        {"type": "text", "id": "hour", "label": "Hours Unit Text", "default": "Hrs"},
        {"type": "text", "id": "wh", "label": "WH Unit Text", "default": "wh"},
        {"type": "text", "id": "total", "label": "Total Text", "default": "Total:"},
        {"type": "text", "id": "cart", "label": "Add To Cart Text", "default": "Add To Cart"}
      
    ],
    "presets": [
      {
        "name": "产品搭配推荐-智能选购"
      }
    ]
  }
{% endschema %}
