{% comment %} points-redeem 插件样式 {% endcomment %}
{{ 'points-redeem.min.css' | asset_url | stylesheet_tag }}

{% comment %} 积分兑换 {% endcomment %}
<style>
  .section-points-redeem {
    --section-pc-xl-pt: {{ section.settings.section_pc_padding_top }}px;
    --section-pc-xl-pb: {{ section.settings.section_pc_padding_bottom }}px;
    --section-pc-lg-pt: {{ section.settings.section_pc_padding_top | divided_by: 14.4 }}vw;
    --section-pc-lg-pb: {{ section.settings.section_pc_padding_bottom | divided_by: 14.4 }}vw;
    --section-mb-pt: {{ section.settings.section_mb_padding_bottom | divided_by: 7.5 }}vw;
    --section-mb-pb: {{ section.settings.section_mb_padding_bottom | divided_by: 7.5 }}vw;
    background-color: {{ section.settings.section_background_color }};

    padding-top: var(--section-mb-pt);
    padding-bottom: var(--section-mb-pb);
  }
  /* 富文本样式重置 */
  .section-points-redeem p {
    margin-bottom: 0;
  }
  .section-points-redeem .title {
    width: 87.2vw;
    text-align: center;
    font-weight: 600;
    font-size: 5.86666666666667vw;
    color: #1A1A1A;
    line-height: 7.46666666666667vw;
    margin: 0 auto;
  }
  .section-points-redeem .sub-title {
    width: 87.2vw;
    text-align: center;
    font-weight: 500;
    font-size: 3.73333333333333vw;
    color: #666666;
    line-height: 1.3;
    margin: 4.26666666666667vw auto 0;
  }
  /* 插件最小高度 */
  .section-points-redeem .pr-plugin-wrap {
    min-height: 130.133333333333vw;
  }
  .section-points-redeem .button-wrap {
    width: 87.2vw;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  .section-points-redeem .more-button-link {
    width: max-content;
    text-align: center;
    font-weight: 500;
    font-size: 3.73333333333333vw;
    color: var(--jds-color-primary);
    line-height: 3.73333333333333vw;
  }
  .section-points-redeem .more-button-link:hover > span {
    text-decoration-line: underline;
    text-underline-offset: 0.8vw;
  }
  .section-points-redeem .more-button-link > svg {
    display: inline;
  }
  @media screen and (min-width: 1024px) {
    .section-points-redeem {
      padding-top: var(--section-pc-lg-pt);
      padding-bottom: var(--section-pc-lg-pb);
    }
    /* 插件最小高度 */
    .section-points-redeem .pr-plugin-wrap {
      min-height: 37.2222222222222vw;
    }
    .section-points-redeem .title {
      width: 83.3333333333333vw;
      text-align: center;
      font-weight: 600;
      font-size: 3.33333333333333vw;
      color: #333333;
      line-height: 3.88888888888889vw;
      margin: 0 auto;
    }
    .section-points-redeem.section_container_lg .title{
      width: 91.1111vw;
    }

    .section-points-redeem .sub-title {
      width: 83.3333333333333vw;
      text-align: center;
      font-weight: 500;
      font-size: 1.66666666666667vw;
      color: #666666;
      line-height: 2.22222222222222vw;
      margin: 1.66666666666667vw auto 0;
    }
    .section-points-redeem.section_container_lg .sub-title {
      width: 91.1111vw;
    }

    .section-points-redeem .button-wrap {
      width: 83.3333333333333vw;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
    }
    .section-points-redeem.section_container_lg .button-wrap {
      width: 91.1111vw;
    }
    .section-points-redeem .more-button-link {
      width: max-content;
      font-weight: 500;
      font-size: 1.25vw;
      line-height: 1.25vw;
    }
    .section-points-redeem .more-button-link:hover > span {
      text-underline-offset: 0.277777777777778vw;
    }
  }
  @media screen and (min-width: 1440px) {
    .section-points-redeem {
      padding-top: var(--section-pc-xl-pt);
      padding-bottom: var(--section-pc-xl-pb);
    }
    /* 插件最小高度 */
    .section-points-redeem .pr-plugin-wrap {
      min-height: 536px;
    }
    .section-points-redeem .title {
      width: 1200px;
      font-size: 48px;
      line-height: 56px;
    }
    .section-points-redeem.section_container_lg .title{
      width: 1312px;
    }

    .section-points-redeem .sub-title {
      width: 1200px;
      font-size: 24px;
      line-height: 32px;
      margin: 24px auto 0;
    }
    .section-points-redeem.section_container_lg .sub-title {
      width: 1312px;
    }

    .section-points-redeem .button-wrap {
      width: 1200px;
    }
    .section-points-redeem.section_container_lg .button-wrap {
      width: 1312px;
    }
    {% comment %} 本身有左右各100px {% endcomment %}
    .section-points-redeem.section_container_lg .redeem-wrap{
      width: 1512px;
    }

    .section-points-redeem .more-button-link {
      font-size: 18px;
      line-height: 18px;
    }
    .section-points-redeem .more-button-link:hover > span {
      text-underline-offset: 4px;
    }
  }
</style>

{% comment %} 版块 ID {% endcomment %}
{%- assign section_id = section.settings.section_id | escape -%}
<div id="{{ section_id }}" data-handle="{{ section_id }}" data-manual-handle="true" class="section-points-redeem {% if section.settings.type == 'embed' %} embed-component {% endif %} {{ section.settings.page_width }}">
  {% comment %} 主标题 {% endcomment %}
  {%- if section.settings.section_title != blank -%}
    {%- assign title_color = '<em style="color: ' | append: section.settings.section_title_main_color | append: '">' -%}
    <h2
      class="title"
      style="color:{{ section.settings.section_title_color }}"
    >{{ section.settings.section_title | newline_to_br | replace: '<em>', title_color }}</h2>
  {%- endif -%}
  {% comment %} 副标题 {% endcomment %}
  {%- if section.settings.section_sub_title != blank -%}
    {%- assign sub_title_color = '<em style="color: ' | append: section.settings.section_sub_title_main_color | append: '">' -%}
    <div
      class="sub-title"
      style="color:{{ section.settings.section_sub_title_color }}"
    >{{ section.settings.section_sub_title | newline_to_br | replace: '<em>', sub_title_color }}</div>
  {%- endif -%}

  {% comment %} 积分兑换插件 {% endcomment %}
  <div class="pr-plugin-wrap">
    {% comment %} 独立使用 {% endcomment %}
    {%- if section.settings.type == 'independent' -%}
      <points-redeem
        section-id="{{ section_id }}"
        bg-color="{{ section.settings.section_background_color }}"
        points-balance-text="{{ section.settings.section_points_title | escape }}"
        points-balance-text-color="{{ section.settings.section_points_title_color }}"
        tab-ids="{{ section.settings.benefit_ids }}"
        tab-text-color="{{ section.settings.tab_text_color }}"
        tab-active-text-color="{{ section.settings.tab_active_text_color }}"
        tab-border-color="{{ section.settings.tab_border_color }}"
        tab-active-border-color="{{ section.settings.tab_active_border_color }}"
        no-data-text="{{ section.settings.section_no_data_text | newline_to_br }}"
        no-data-image-url="{{ section.settings.section_no_data_img | image_url: width: section.settings.section_no_data_img.width }}"
      ></points-redeem>
    {%- endif -%}
  </div>

  {% comment %} 跳转链接 {% endcomment %}
  {%- if section.settings.button_text != blank -%}
    <div class="button-wrap">
      {% unless section.settings.btn_to_login and customer.id != blank %}
        <jds-button data-btn-to-login="{{ section.settings.btn_to_login }}" href="{{ section.settings.button_text_link }}"
                    style="--jds-btn-custom-color:{{ section.settings.button_bg_color }}; --jds-btn-primary-custom-text-color:{{ section.settings.button_text_color }}"
                    kind="custom">{{ section.settings.button_text | escape }}</jds-button>
      {% endunless %}
    </div>
  {%- endif -%}
</div>

{% comment %} points-redeem 插件脚本 {% endcomment %}
<script src="{{ 'points-redeem.min.js' | asset_url }}" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sectionId = '{{ section_id }}'

    // 获取对应的.empty-block-box 元素
    const emptyBlockBox = document.querySelector(`.empty-block-box[target="${sectionId}"`)
    // 获取对应的.embed-component 元素
    const sourceDOM = document.querySelector(`.embed-component[data-handle="${sectionId}"]`);

    if (emptyBlockBox && sourceDOM) {
      emptyBlockBox.style.display = 'block'
      sourceDOM.style.display = sourceDOM.getAttribute('data-display') || 'block';
      // let sourceComponent = sourceDOM.parentElement;
      emptyBlockBox.innerHTML = '';
      emptyBlockBox.appendChild(sourceDOM);

      // 初始化 积分兑换组件
      const pointsRedeem = document.createElement('points-redeem')
      // 使用对象映射设置属性，减少重复代码
      const attributes = {
        'section-id': "{{ section_id }}",
        'bg-color': "{{ section.settings.section_background_color }}",
        'points-balance-text': "{{ section.settings.section_points_title | escape }}",
        'points-balance-text-color': "{{ section.settings.section_points_title_color }}",
        'tab-ids': "{{ section.settings.benefit_ids }}",
        'tab-text-color': "{{ section.settings.tab_text_color }}",
        'tab-active-text-color': "{{ section.settings.tab_active_text_color }}",
        'tab-border-color': "{{ section.settings.tab_border_color }}",
        'tab-active-border-color': "{{ section.settings.tab_active_border_color }}",
        'no-data-text': "{{ section.settings.section_no_data_text | newline_to_br }}",
        'no-data-image-url': "{{ section.settings.section_no_data_img | image_url: width: section.settings.section_no_data_img.width }}",
      }
      // 遍历对象设置属性
      Object.entries(attributes).forEach(([key, value]) => pointsRedeem.setAttribute(key, value))

      // 插入 积分兑换组件
      emptyBlockBox.querySelector('.pr-plugin-wrap').appendChild(pointsRedeem)
    } else {
      emptyBlockBox && (emptyBlockBox.style.display = 'none')
    }

    document.addEventListener('click', function (e) {
      const targetButton = e.target.closest('.section-points-redeem jds-button[data-btn-to-login="true"]');
      if (targetButton) {
        e.preventDefault();
        e.stopPropagation();
        window.jackeryLoginApp && window.jackeryLoginApp.modalLogin({
          return_url: window.location.search ? `${window.location.href}#points_r_id=${sectionId}` : `${window.location.href}?points_r_id=${sectionId}`,
          "register_act": "Account-Register,JFDHCJ-Register"
        });
      }
    });
  })
</script>

{% schema %}
{
