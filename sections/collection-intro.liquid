{% if section.settings.intro_product_img != blank or section.settings.m_intro_product_img != blank %}
    {% comment %} Introducing Jackery Solar Generator 1500 Pro {% endcomment %}
    <div class="relative bg-f5 pb-65">
        <div class="w-full h-900 lg:j-h-680">
            {% comment %} image {% endcomment %}
            {%-liquid
                assign is_lcp = false
                if section.index < 2
                    assign is_lcp = true
                endif
            -%}
            {%- 
                render 'responsive-image', 
                image: section.settings.intro_product_img, 
                image_class: 'w-full object-cover', 
                mimage: section.settings.m_intro_product_img, 
                fcp: is_lcp
            -%}
        </div>
        <div class="w-full lg:j-w-1200 h-auto flex flex-col items-center lg:items-end absolute left-1/2 -translate-x-1/2 top-120 lg:j-top-58 px-60 z-1">
            {% if section.settings.intro_product_url %}
                <h2 class="w-full font-600 text-black text-45 leading-66 lg:j-text-40 lg:j-leading-48 text-center lg:text-right">
                    <a class="text-black" href="{{section.settings.intro_product_url}}">{{section.settings.intro_title | newline_to_br}}</a>
                </h2>
            {% else %}
                <h2 class="w-full font-600 text-black text-45 leading-66 lg:j-text-40 lg:j-leading-48 text-center lg:text-right">{{section.settings.intro_title | newline_to_br}}</h2>
            {% endif %}
            {% if section.settings.intro_product_url != blank %}
                <a class="z-button-fill-big-solid mt-60 lg:j-mt-50" href="{{section.settings.intro_product_url}}" data-analytics-title="{{ section.settings.intro_title | replace: '/n', '' }}">{{ 'general.action_text.learn_more' | t }} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></a>
            {% endif %}
        </div>
    </div>
{% endif %}

{% schema %}
    {
        "name": "Introducing",
        "class": "section section-collection-intro section-sp-pps-sg-collection",
        "settings": [
            {"type": "textarea", "id": "intro_title", "label": "Introduc Product title"},
            { "type": "url", "id": "intro_product_url", "label": "Introduc Product Url" },
            {"type": "image_picker", "id": "intro_product_img", "label": "Introduc Product Banner"},
            {"type": "image_picker", "id": "m_intro_product_img", "label": "Mobile Introduc Product Banner"}
        ]
    }
{% endschema %}
