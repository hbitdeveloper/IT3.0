{% comment %}
  名称：太阳能火星机器人-- 智能接口和多个输出端口 组件
  说明：https://alidocs.dingtalk.com/i/nodes/KGZLxjv9VG3MnwrwUm5PXD4nV6EDybno
{% endcomment %}
{% schema %}
{
  "name": "Interface Output Ports",
  "tag": "section",
  "class": "interface-output-ports",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Intelligent Interface and Multiple Output Ports"
    },
    {
      "type": "textarea",
      "id": "mb_title",
      "label": "MB Title"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "Clear and transparent electricity usage status. Suitable for various electrical devices and easy to meet the power demand of courtyard parties, outdoor travel and other scenes."
    },
    {
      "type": "video",
      "id": "pcVideoSrc",
      "label": "PC Video Src"
    },
    {
      "type": "image_picker",
      "id": "mbBgImg",
      "label": "Mobile Background Image"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "name": "Icon Item",
      "type": "slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "iconImg",
          "label": "Icon Image(Aspect ratio 1:1)"
        }
      ]
    }
  ]
}
{% endschema %}
<style>
  @media screen and (max-width: 1024px) {
    .hide-mb {
      display: none;
    }
    .hide-pc {
      display: initial!important;
    }
  }
  .hide-pc {
    display: none;
  }
</style>
<div class="card-container">
  <div class="card-item">
    <div class="info-box">
      <h2 class="title">
        {%- liquid
        assign mb_title = section.settings.title
        if section.settings.mb_title != blank
          assign mb_title = section.settings.mb_title
        endif
      -%}
      <span class="hide-mb">{{ section.settings.title | newline_to_br}}</span>
      <span class="hide-pc">{{ mb_title | newline_to_br}}</span>
      </h2>
      <div class="box-bottom">
        <ul class="icon-list">
          {% for block in section.blocks %}
            <li>
              {%- 
                render 'responsive-image', 
                image: block.settings.iconImg,
                width: 36,
                mwidth: 50,
                image_class: 'icon-img'
            -%}
            </li>
          {% endfor %}
        </ul>
        <p class="desc">{{ section.settings.desc }}</p>
      </div>
    </div>
    <div class="video-box">
      <svg class="icon-refresh" viewBox="0 0 90 90" xmlns="http://www.w3.org/2000/svg"
           xmlns:xlink="http://www.w3.org/1999/xlink">
        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
          <g>
            <circle fill="#000000" opacity="0.3" cx="45" cy="45" r="45"></circle>
