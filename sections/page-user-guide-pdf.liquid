<div
  class="layer layer-container manuals pdf minimum"
  data-download-text="{{ section.settings.download }}"
  data-more="{{'general.action_text.view_more' | t}}"
  data-less="{{  section.settings.view_less | escape }}"
>
  <h2 class="jky-text-2xl">{{ section.settings.title }}</h2>
  <div class="tab-container">
    <ul class="tab manuals-tab">
      {% if section.settings.collection_show_new %}
        {% if section.settings.new_tab_pin_1 and section.settings.new_tab_name != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name }}
          </li>
        {% endif %}

        {% if section.settings.new_tab_pin_2 and section.settings.new_tab_name_2 != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name_2 }}
          </li>
        {% endif %}

        {% if section.settings.new_tab_pin_3 and section.settings.new_tab_name_3 != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name_3 }}
          </li>
        {% endif %}

        {% if section.settings.new_tab_pin_4 and section.settings.new_tab_name_4 != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name_4 }}
          </li>
        {% endif %}

        {% if section.settings.new_tab_pin_5 and section.settings.new_tab_name_5 != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name_5 }}
          </li>
        {% endif %}
      {% endif %}

      {% if section.settings.collection_show_pps == true %}
        <li class="jky-text-lg underlines-btn" data-type="pps" data-handle="portable-power-stations">
          {{ 'collection.portable_power_station' | t }}
        </li>
      {% endif %}

      {% if section.settings.collection_show_sp == true %}
        <li class="jky-text-lg underlines-btn" data-type="sp" data-handle="solar-panels">
          {{ 'collection.solar_panel' | t }}
        </li>
      {% endif %}

      {% if section.settings.collection_show_accessories == true %}
        <li class="jky-text-lg underlines-btn" data-type="acc" data-handle="accessories">
          {{ 'collection.accessories' | t }}
        </li>
      {% endif %}

      {% if section.settings.collection_show_new %}
        {% if section.settings.new_tab_pin_1 == false and section.settings.new_tab_name != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name }}
          </li>
        {% endif %}

        {% if section.settings.new_tab_pin_2 == false and section.settings.new_tab_name_2 != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name_2 }}
          </li>
        {% endif %}

        {% if section.settings.new_tab_pin_3 == false and section.settings.new_tab_name_3 != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name_3 }}
          </li>
        {% endif %}

        {% if section.settings.new_tab_pin_4 == false and section.settings.new_tab_name_4 != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name_4 }}
          </li>
        {% endif %}

        {% if section.settings.new_tab_pin_5 == false and section.settings.new_tab_name_5 != blank %}
          <li class="jky-text-lg underlines-btn" data-type="new" data-json="{{ section.blocks }}">
            {{ section.settings.new_tab_name_5 }}
          </li>
        {% endif %}
      {% endif %}
    </ul>
  </div>

  <div class="search-box">
    <input type="text" placeholder="{{ section.settings.placeholder }}">
    <button type="button">{{ section.settings.button }}</button>
  </div>
  <div class="manuals-list"></div>

  <button class="more jky-text-sm">
    <span>{{ 'general.action_text.view_more' | t }}</span>
    {% comment %} <i class="iconfont jackery-icon-arrowdown jky-text-sm"></i> {% endcomment %}
    <jds-icon name="arrow-down" class="jackery-icon-arrowdown jky-text-sm align-middle"></jds-icon>
  </button>
</div>

<script defer>
  window.userGuideString = {
    noresults: `{{ 'templates.search.noresults' | t }}`
  }
</script>

<script type="application/ld+json" id="user-guide-json">
  [
     {% for block in section.blocks %}
       {"originName":"{{ block.settings.title }}","originTitle": "{{ block.settings.name}}" ,"introduceBookUrlDesc": "{{ block.settings.link }}"}{% if forloop.last != true %},{% endif %}
     {% endfor %}
   ]
</script>

{% schema %}
{
  "name": "user guide pdf",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "title", "default": "User Manuals" },
    { "type": "text", "id": "placeholder", "label": "search placeholder", "default": "Search Product Model" },
    { "type": "text", "id": "button", "label": "search button text", "default": "Search" },
    { "type": "text", "id": "download", "label": "download text", "default": "DOWNLOAD" },
    { "type": "text", "id": "view_less", "label": "VIEW LESS", "default": "VIEW LESS" },
    { "type": "checkbox", "id": "collection_show_pps", "label": "Portable Power Station Show PDF?", "default": true },
    { "type": "checkbox", "id": "collection_show_sp", "label": "Solar Panel Show PDF?", "default": true },
    { "type": "checkbox", "id": "collection_show_accessories", "label": "Accessories Show PDF?", "default": true },
    { "type": "checkbox", "id": "collection_show_new", "label": "New Tab Show PDF?", "default": true },
    { "type": "text", "id": "new_tab_name", "label": "New Tab Name" },
    { "type": "checkbox", "id": "new_tab_pin_1", "label": "New Tab Name是否置顶", "default": false },
    { "type": "text", "id": "new_tab_name_2", "label": "New Tab Name2" },
    { "type": "checkbox", "id": "new_tab_pin_2", "label": "New Tab Name2是否置顶", "default": false },
    { "type": "text", "id": "new_tab_name_3", "label": "New Tab Name3" },
    { "type": "checkbox", "id": "new_tab_pin_3", "label": "New Tab Name3是否置顶", "default": false },
    { "type": "text", "id": "new_tab_name_4", "label": "New Tab Name4" },
    { "type": "checkbox", "id": "new_tab_pin_4", "label": "New Tab Name4是否置顶", "default": false },
    { "type": "text", "id": "new_tab_name_5", "label": "New Tab Name5" },
    { "type": "checkbox", "id": "new_tab_pin_5", "label": "New Tab Name5是否置顶", "default": false }
  ],
  "blocks": [
    {
      "name": "Items",
      "type": "pdf-items",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "区分不同tab下的pdf"
        },
        {
          "type": "text",
          "id": "name",
          "label": "PDF Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "PDF Link"
        }
      ]
    }
  ]
}
{% endschema %}
