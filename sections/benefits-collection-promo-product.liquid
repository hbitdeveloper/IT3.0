
<style>

.benefits-collection-promo-product .product-label-tag.product-tag-text .product-label-tag-text {
  font-size: 1.125rem;
  line-height: 1rem;
}

.benefits-collection-promo-product .product-tag-img img {
    width: auto;
    height: 3rem;
}

@media (max-width: 1024px) {
  .benefits-collection-promo-product .product-tag-text {
    top: 0.5rem;
    right: 0.5rem;
  }

  .benefits-collection-promo-product .product-label-tag.product-tag-text .product-label-tag-text {
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--jds-color-primary);
    line-height: 0.5rem;
  }

  .benefits-collection-promo-product .product-label-tag:not(.product-media__box .product-label-tag, .gallery .product-label-tag, .collection-product-main .product-label-tag) {
    transform: initial;
  }

    .benefits-collection-promo-product .product-tag-img img {
        width: auto;
        height: 1.5rem;
    }
}

</style>

<div class="benefits-collection-promo-product py-[0.75rem] lg:py-[1.25rem]" style="background-color: {{ section.settings.bg_color }}">
  <div class="section-container-lg pb-[2.2rem] lg:pb-[2.6rem]" anchor-target="{{ section.settings.anchor | escape }}">

    <div class="product-flex__list flex lg:gap-5 flex-wrap gap-x-[0.495rem] gap-y-[0.75rem] min-h-[37.5rem] lg:min-h-[28rem]"
         data-product-categories="{{ section.settings.product_categories | escape }}"
         data-product-button-text="{{ section.settings.product_button_text | escape }}"
         data-auto-discount-price="{{ settings.open_auto_discount_price }}"
         data-discount-display-style="{{ settings.discount_percent_display_style }}"
         data-discount-amount-display-style="{{ settings.discount_amount_display_style }}"
         data-discount-tag-display-style="{{ settings.discount_tag_display_style }}"
         >
        {% content_for 'blocks' %}
    </div>

    {% if section.settings.button_link and section.settings.view_button_text != blank %}
        <div class="text-right mt-[1rem] lg:mt-[1.25rem]">
            <a class="font-medium text-[0.9375rem] leading-[0.875rem] lg:text-lg text-[var(--jds-color-primary)] lg:leading-[1.125rem]" href="{{ section.settings.button_link }}">{{ section.settings.view_button_text }} > </a>
        </div>
    {% endif %}
  </div>
</div>

<script>
(function () {
  "use strict";

  const sectionSelector = ".benefits-collection-promo-product";
  const eventNamespace = ".benefitsCollectionPromoProduct";
  const documentEventsBoundKey = "__benefitsCollectionPromoProductEventsBound";

  $(document)
    .off("click" + eventNamespace, sectionSelector + " jds-button")
    .on("click" + eventNamespace, sectionSelector + " jds-button", function (e) {
    const module = getModule($(this));
    const button_name = $(this).text();
    const link = location.origin + $(this).attr("href");
    window.dataLayer.push({ event_parameters: null });
    window.dataLayer.push({
      event: "ga4Event",
      event_name: "promo_collection_user_clicks",
      event_parameters: {
        current_page: window.location.href,
        module: module,
        button_name: button_name,
        link: link
      }
    });
  });

  $(document)
    .off("click" + eventNamespace, sectionSelector + " a")
    .on("click" + eventNamespace, sectionSelector + " a", function (e) {

    const module = getModule($(this));

    const link = $(this).attr("href");
    const position = $(this).closest(".flex__item").find('.product-title').text();

    let button_name = 'pic';
    if ($(this).parent().hasClass('product-content')) {
      button_name = $(this).closest('.product-flex__list').data('productButtonText') || "VIEW MORE";
    }

    window.dataLayer.push({ event_parameters: null });
    window.dataLayer.push({
      event: "ga4Event",
      event_name: "promo_collection_user_clicks",
      event_parameters: {
        current_page: window.location.href,
        module: module,
        position: position,
        button_name: button_name,
        link: link
      }
    });
  });

  function getModule($this) {
    const $prevSection = $this.closest(sectionSelector).parent().prev();
    let module = 'InstantDeals';
    if ($prevSection.attr('id').indexOf('benefits_collection_common_title') !== -1) {
      module = $prevSection.find(".title").text();
    }
    return module;
  }

  function initProducts() {
    const $productList = $(sectionSelector + " .product-flex__list");
    $productList.each(function () {
      const $this = $(this);
      if ($this.children().length == 0) {
        if ($this.data("productsLoaded") === true) return;
        if ($this.data("productsLoading") === true) return;
        $this.data("productsLoading", true);

        const url = "/osadminapi/v1/goods/get-sales-rank-goods-list?limit=4&shopifyShopId=" + window.shopId + "&categoryNumList=" + $this.data("productCategories");
        window.Jackery.Utils.get(url).then(function (res) {
          if (res && res.code === 200) {
            $this.data("productsLoaded", true);
            const product = {};
            const buttonText = $this.data("productButtonText") || "VIEW MORE";
            const autoDiscountPrice = $this.data("autoDiscountPrice");
            const discountDisplayStyle = $this.data("discountDisplayStyle");
            const discountAmountDisplayStyle = $this.data("discountAmountDisplayStyle");
            const discountTagDisplayStyle = $this.data("discountTagDisplayStyle");
            for (let i = 0; i < res.data.length; i++) {
              const product = res.data[i];
              const productUrl = location.origin + "/products/" + product.handle + "?variant=" + product.skuId;
              let productLabel = '';
              if (product.promotion) {
                productLabel = product.promotion
              } else {
                if (autoDiscountPrice && product.priceOff > 0) {
                    if (discountTagDisplayStyle === 'amount') {
                        const money = formatMoney(parseFloat(product.autoDiscountAmount)).split('.')[0];
                        productLabel = discountAmountDisplayStyle.replace('()', money);
                    } else {
                        productLabel = discountDisplayStyle.replace('()', product.priceOff);
                    }
                }
              }
              const price = product.price ? formatMoney(parseFloat(product.price)) : '';
              const originalPrice = product.originalPrice ? formatMoney(parseFloat(product.originalPrice)) : `<span class="opacity-0">&nbsp;</span>`;
              let domHtml =
                `<div class="flex__item h-[19.125rem] lg:h-[28rem] w-[10.47rem] lg:w-[19.5625rem]">
                  <div class="relative rounded-md lg:rounded-xl flex flex-col justify-between px-[0.5rem] lg:px-5 bg-white h-full">
                    <a href="${productUrl}">
                      <div class="product-img focus-zoom-container overflow-hidden pt-[0.25rem] lg:pt-0 w-[8.25rem] lg:w-[16.25rem] h-[8.25rem] lg:h-[16.25rem] mx-[0.625rem] lg:mx-[0.375rem]">
                        <img class="object-cover focus-zoom blur-up w-full" src="${product.image}" alt="${product.title}" loading="lazy">
                      </div>
                    </a>
                    <div class="product-content flex flex-col pt-[0.125rem] lg:pt-[0.5625rem]">
                      <div class="product-content-main flex flex-col justify-between">
                        <div class="product-title h-[2.6875rem] lg:h-[3.5rem] font-medium text-[0.875rem] leading-[1.375rem] lg:text-[1rem] text-[#1A1A1A] lg:leading-[1.625rem] text-overflow-2 mb-[0.78rem] lg:mb-4">
                          ${product.title}
                        </div>
                        <div class="product-prices flex flex-col lg:flex-row lg:items-center gap-[0.5rem] lg:gap-2">
                          <div class="price price--on-sale font-semibold text-[1.125rem] lg:text-2xl text-[var(--jds-color-primary)] leading-[1.5rem] lg:leading-8">
                            <div class="real-price">${price}</div>
                          </div>
                          <div class="origin-price font-400 origin-compare-price font-normal text-[0.875rem] lg:text-base text-[#999999] lg-[0.75rem] lg:leading-6 line-through">
                            ${originalPrice}
                          </div>
                        </div>
                      </div>
                      <a class="flex items-center justify-center w-full h-[2rem] lg:h-9 border rounded-[1.125rem] bg-[var(--jds-color-primary)] border-solid border-[var(--jds-color-primary)] mt-[0.5rem] mb-[1rem] lg:mt-[1rem] lg:mb-6
                                                font-medium lg:font-semibold lg:text-base text-[0.75rem] text-white leading-[1.25rem] lg:leading-4"
                         href="${productUrl}">${buttonText}</a>
                    </div>
                    <div class="product-label-tag product-tag-text">
                      <span class="product-label-tag-text">${productLabel}</span>
                    </div>
                    `;
              if (product.icon) {
                domHtml += `<div class="product-label-tag product-tag-img">
                              <img src="${product.icon}" alt="product tag image" loading="lazy">
                            </div>
                        </div></div>`;
              } else {
                domHtml += `</div></div>`;
              }
              $this.append(domHtml);
            }
          }
          $this.data("productsLoading", false);
        }).catch(function (err) {
            console.error("Get products failed:", err);
            $this.data("productsLoading", false);
        });
      }
    });
  }

  if (!window[documentEventsBoundKey]) {
    window[documentEventsBoundKey] = true;

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initProducts, {once: true});
    }

    document.addEventListener("shopify:section:load", initProducts);
  }

  if (document.readyState !== "loading") {
    initProducts();
  }

})();
</script>

