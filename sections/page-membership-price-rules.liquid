{% comment %} Rules {% endcomment %}
<section id="{{ section.settings.section_id | escape }}" class="w-full flex-center flex-col pt-100 pb-110 lg:j-pt-85 lg:j-pb-100 xl:a-pt-85 xl:a-pb-100" style="background-color: {{ section.settings.section_background_color }};" data-membership-rules-wrap>
  <div class="flex-center flex-col w-full px-40 lg:j-w-1200 lg:j-pb-40 lg:j-px-200 lg:j-rounded-8 xl:a-w-1200 xl:a-pb-60 xl:a-px-200 xl:a-rounded-8 lg:bg-white
    {{ section.settings.page_width }}
    ">
    {% if section.settings.section_title != blank %}
      <h2
        class="
          w-full text-center font-semibold text-44 leading-56
          lg:j-mt-48 lg:j-text-40 lg:j-leading-56 xl:a-mt-48 xl:a-text-40 xl:a-leading-56
        "
        style="color:{{ section.settings.section_title_color }}"
        data-animation-dom
      >{{ section.settings.section_title | newline_to_br }}</h2>
    {% endif %}
    <div
      class="
        expended w-full font-normal text-#333 text-26 leading-34 mt-28 max-h-880
        lg:j-text-16 lg:j-leading-24 lg:j-mt-36 lg:j-max-h-290
        xl:a-text-16 xl:a-leading-24 xl:a-mt-36 xl:a-max-h-290 overflow-hidden transition-all duration-300
      "
      data-membership-rules-content
      data-animation-dom
    >
      {{ section.settings.section_content | newline_to_br }}
    </div>
    <button
      class="
        hidden appearance-none bg-transparent font-medium text-primary mt-48 text-30
        lg:j-text-18 lg:j-px-20 lg:j-mt-24 xl:a-text-18 xl:a-px-20 xl:a-mt-24
      "
      data-membership-rules-expand-button
      data-view-more-text="{{ section.settings.section_view_more | escape }}"
      data-hide-text="{{ section.settings.section_hide | escape }}"
      data-ga-event="membership_price_user_clicks"
      data-ga-action="click"
      data-ga-params-module="{% if section.settings.section_title != blank %}{{ section.settings.section_title }}{% else %}Rules{% endif %}"
      data-ga-params-button_name="{{ section.settings.section_view_more | escape }}"
      data-ga-params-status="{% if customer.id != blank %}logged_in{% else %}tourist{% endif %}"
    >
      {{ section.settings.section_view_more | escape }}
      <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right inline-block text-base lg:text-xl -mt-3 -lg:j-mt-3 -xl:a-mt-3 rotate-90"></jds-icon>
    </button>
  </div>
</section>

{% schema %}
  {
    "name": "Membership Price Rules",
    "class": "section-membership-price section-membership-price-rules",
    "settings": [
       {
        "type": "select",
        "id": "page_width",
        "options": [
          {
            "value": "section_container",
            "label": "版心/1200px"
          },
          {
            "value": "section_container_lg",
            "label": "大版心/1312px"
          }
        ],
        "default": "section_container",
        "label": "组件宽度"
      },
      {
        "type": "color_background",
        "id": "section_background_color",
        "label": "Section Background Color",
        "default": "#FCF7F1"
      },
      {
        "type": "text",
        "id": "section_id",
        "label": "Section ID",
        "info": "和关联的 Anchor ID 保持一致"
      },
      {
        "type": "textarea",
        "id": "section_title",
        "label": "Section Title",
        "default": "Event Rules"
      },
      {
        "type": "color",
        "id": "section_title_color",
        "label": "Section Title Color",
        "default": "#F3702E"
      },
      {
        "type": "richtext",
        "id": "section_content",
        "label": "Section Content"
      }, {
        "type": "text",
        "id": "section_view_more",
        "label": "View More Text（多语言）",
        "default": "View More"
      }, {
        "type": "text",
        "id": "section_hide",
        "label": "Hide Text（多语言）",
        "default": "Hide"
      }
    ]
  }
{% endschema %}
