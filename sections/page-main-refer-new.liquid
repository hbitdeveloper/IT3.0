<div class="refer-banner">
    {% render 'responsive-image', image: section.settings.image, image_class: '', mimage: section.settings.m_image %}
</div>

<div class="refer-main">
    <div class="refer-container">
        <div class="refer-form">
            <div class="font-bold text-center jky-text-2xl form-title">A Gift From Your Friend – 15% OFF Coupon！</div>
        </div>

        <div class="form-subtitle text-base">Enter your email and get 15% OFF your next purchase on jackery.com. After you complete a purchase, your referrer will receive a 15% OFF coupon. You both have a chance to save more than $500！</div>

        <form id="new-friend-form" class="flex flex-col justify-between">
          <div class="flex two-inline">
            <div class="form-item">
              <input
                class="text-base font-400"
                type="text" name="first_name"
                placeholder="Enter Your First Name*" autocorrect="off" autocapitalize="off"
                data-required="true"
                data-describedby="first_name-description"
                data-description="first_name"
              >
              <div id="first_name-description" class="form-item-error text-xs font-400"></div>
            </div>

            <div class="form-item">
              <input
                class="text-base font-400"
                type="text" name="last_name"
                placeholder="Enter Your Last Name*" autocorrect="off" autocapitalize="off"
                data-required="true"
                data-describedby="last_name-description"
                data-description="last_name"
              >
              <div id="last_name-description" class="form-item-error text-xs font-400"></div>
            </div>
          </div>

          <div class="form-item">
            <input
              class="text-base font-400"
              type="email" name="email"
              placeholder="{{'newsletter.email_placeholder' | t}}" autocorrect="off" autocapitalize="off"
              data-required="true"
              data-pattern="@"
              data-describedby="r_email-description"
              data-description="r_email"
            >
            <div id="r_email-description" class="form-item-error text-xs font-400"></div>
          </div>

          <div class="form-item form-item-checkbox">
              <label class="dji-checkbox">
                <span class="dji-checkbox-input">
                  <input
                    type="checkbox"
                    class="dji-checkbox-original"
                    name="is_subscribe"
                    data-required="true"
                    data-describedby="refer_policy-description"
                    data-description="refer_policy"
                  >
                  <span class="dji-checkbox-inner">
                    <jds-icon name="check" class="jackery-icon-checkbox"></jds-icon>
                  </span>
                </span>

                <span class="dji-checkbox-label">
                  <span class="dji-agree">
                    <span class="mr-1">Please agree to the <a href="https://www.jackery.com/policies/terms-of-service">Terms of Service</a> and <a href="https://www.jackery.com/policies/privacy-policy">Privacy policy</a>.</span>
                  </span>
                </span>
              </label>
              <div id="refer_policy-description" class="form-item-error text-xs font-400"></div>
          </div>

          <button name="commit" type="submit" class="z-button-middle">Submit</button>
        </form>

        <h2 class="faq-title font-bold text-center text-lg">Notice</h2>
        {% render 'accordion-menu', blocks: section.blocks %}
    </div>
</div>


{% schema %}
    {
        "name": "Page referNewFriend main",
        "class": "section section-referNewFriend-main",
        "settings": [
            {"type": "image_picker", "id": "image", "label": "PC banner Image"},
            {"type": "image_picker", "id": "m_image", "label": "Mobile banner Image"}
        ],
        "blocks": [
            {
                "type": "faq_item", "name": "FAQ Item",
                "settings": [
                    {"type": "text", "id": "title", "label": "FAQ name"},
                    {"type": "textarea", "id": "faq_content", "label": "FAQ answer"}
                ]
            }
        ]
    }
{% endschema %}
