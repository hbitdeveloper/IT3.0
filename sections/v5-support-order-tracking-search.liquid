{{ 'sections-v5-support-order-tracking-search.css' | asset_url | stylesheet_tag }}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  class="v5-order-tracking-search section-padding"
  id="v5-order-tracking-search-{{ section.id }}"
  style="{{ style }}"
  data-detail-page-base-url="{{ section.settings.detail_page_base_url.url | escape }}"
  data-forget-order-text="{{ section.settings.forget_order_text | escape }}"
  data-resend-code-text="{{ section.settings.resend_code_text | escape }}"
  data-invalid-email-text="{{ section.settings.invalid_email_text | escape }}"
  data-email-empty-text="{{ section.settings.email_empty_text | escape }}"
  data-code-empty-text="{{ section.settings.code_empty_text | escape }}"
  data-order-empty-text="{{ section.settings.order_empty_text | escape }}"
  data-code-send-success-text="{{ section.settings.code_send_success_text | escape }}"
  data-request-failed-text="{{ section.settings.request_failed_text | escape }}"
  data-order-number-label="{{ section.settings.order_number_label | escape }}"
  data-order-status-label="{{ section.settings.order_status_label | escape }}"
  data-track-number-label="{{ section.settings.track_number_label | escape }}"
  data-support-email="{{ section.settings.support_email | escape }}"
  data-order-status-shipping-text="{{ section.settings.order_status_shipping_text | escape }}"
  data-order-status-completed-text="{{ section.settings.order_status_completed_text | escape }}"
  data-order-status-processing-text="{{ section.settings.order_status_processing_text | escape }}"
  data-order-status-archived-text="{{ section.settings.order_status_archived_text | escape }}"
  data-order-status-canceled-text="{{ section.settings.order_status_canceled_text | escape }}"
  data-order-status-unpaid-text="{{ section.settings.order_status_unpaid_text | escape }}"
>
  <div class="v5-order-tracking-search__loading js-ots-loading" hidden>
    <span class="v5-order-tracking-search__loading-spinner" aria-hidden="true"></span>
    <div class="v5-order-tracking-search__loading-text">{{ section.settings.loading_text }}</div>
  </div>

  <div class="v5-order-tracking-search__search js-ots-search-panel">
    <div class="v5-order-tracking-search__search-form main-container">
      <h2 class="v5-order-tracking-search__title">{{ section.settings.page_title }}</h2>
      <form class="js-ots-form" novalidate>
        <div class="v5-order-tracking-search__field">
          <input class="v5-order-tracking-search__input js-ots-email" type="email" inputmode="email" autocomplete="email" placeholder="{{ section.settings.email_placeholder | escape }}">
          <div class="v5-order-tracking-search__field-error js-ots-email-error" hidden></div>
        </div>
        <div class="v5-order-tracking-search__field js-ots-order-wrap">
          <input class="v5-order-tracking-search__input js-ots-order" type="text" placeholder="{{ section.settings.order_placeholder | escape }}">
        </div>
        <div class="v5-order-tracking-search__field js-ots-code-wrap" hidden>
          <input class="v5-order-tracking-search__input js-ots-code" type="text" placeholder="{{ section.settings.code_placeholder | escape }}">
        </div>
        <div class="v5-order-tracking-search__form-action">
          <span class="v5-order-tracking-search__timer js-ots-timer" role="button" tabindex="0">{{ section.settings.forget_order_text }}</span>
        </div>
        <div class="v5-order-tracking-search__alert js-ots-alert" hidden></div>
        <div class="v5-order-tracking-search__submit-wrap">
          <jds-button type="submit" class="js-ots-submit w-full">{{ section.settings.search_button_text }}</jds-button>
        </div>
      </form>
    </div>
  </div>

  <div class="v5-order-tracking-search__list main-container js-ots-list-panel" hidden>
    <h2 class="v5-order-tracking-search__list-title">{{ section.settings.page_title }}</h2>
    <table class="v5-order-tracking-search__table js-ots-table">
      <thead class="v5-order-tracking-search__table-head">
        <tr>
          <th>{{ section.settings.order_number_label }}</th>
          <th>{{ section.settings.order_status_label }}</th>
          <th>{{ section.settings.track_number_label }}</th>
        </tr>
      </thead>
      <tbody class="js-ots-table-body"></tbody>
    </table>
    <div class="v5-order-tracking-search__mobile-list js-ots-mobile-list"></div>
  </div>

  <div class="v5-order-tracking-search__no-data js-ots-no-data" hidden>
    {% if section.settings.empty_image != blank %}
      <img src="{{ section.settings.empty_image | escape }}" alt="{{ section.settings.empty_image_alt | escape }}">
    {% endif %}
    <p class="v5-order-tracking-search__no-data-text js-ots-empty-text" data-template="{{ section.settings.empty_message | escape }}">{{ section.settings.empty_message }}</p>
    <jds-button class="js-ots-back" type="button" variant="secondary">{{ section.settings.back_button_text }}</jds-button>
  </div>
</div>

<script src="{{ 'sections-v5-support-order-tracking-search.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5-Support Order Search",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Desktop Spacing" },
    { "type": "number", "id": "padding_top", "label": "Padding top", "default": 50 },
    { "type": "number", "id": "padding_bottom", "label": "Padding bottom", "default": 50 },
    { "type": "header", "content": "Mobile Spacing" },
    { "type": "text", "id": "mb_padding_type", "default": "custom", "label": "Mobile spacing mode", "visible_if": "{{ false }}" },
    { "type": "number", "id": "padding_top_mb", "label": "Padding top", "default": 40 },
    { "type": "number", "id": "padding_bottom_mb", "label": "Padding bottom", "default": 40 },
    { "type": "text", "id": "page_title", "label": "Page title", "default": "Track Your Order" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Email" },
    { "type": "text", "id": "order_placeholder", "label": "Order number placeholder", "default": "Order Number" },
    { "type": "text", "id": "code_placeholder", "label": "Code placeholder", "default": "Code" },
    { "type": "text", "id": "forget_order_text", "label": "Forget order text", "default": "Forget order number?" },
    { "type": "text", "id": "resend_code_text", "label": "Resend code text", "default": "Resend code" },
    { "type": "text", "id": "search_button_text", "label": "Search button text", "default": "Search" },
    { "type": "text", "id": "order_number_label", "label": "Order number label", "default": "Order Number" },
    { "type": "text", "id": "order_status_label", "label": "Order status label", "default": "Order Status" },
    { "type": "text", "id": "track_number_label", "label": "Track number label", "default": "Tracking Number" },
    { "type": "text", "id": "order_status_shipping_text", "label": "Order status shipping text", "default": "Shipped" },
    { "type": "text", "id": "order_status_completed_text", "label": "Order status completed text", "default": "Completed" },
    { "type": "text", "id": "order_status_processing_text", "label": "Order status processing text", "default": "Processing" },
    { "type": "text", "id": "order_status_archived_text", "label": "Order status archived text", "default": "Shipped" },
    { "type": "text", "id": "order_status_canceled_text", "label": "Order status canceled text", "default": "Canceled" },
    { "type": "text", "id": "order_status_unpaid_text", "label": "Order status unpaid text", "default": "Unpaid" },
    { "type": "text", "id": "email_empty_text", "label": "Empty email error", "default": "Email address cannot be empty." },
    { "type": "text", "id": "invalid_email_text", "label": "Invalid email error", "default": "Please enter a valid email address" },
    { "type": "text", "id": "order_empty_text", "label": "Empty order number error", "default": "Please enter your order number." },
    { "type": "text", "id": "code_empty_text", "label": "Empty code error", "default": "Please enter your code." },
    { "type": "text", "id": "code_send_success_text", "label": "Code sent success text", "default": "The verification code has been sent successfully." },
    { "type": "text", "id": "loading_text", "label": "Loading text", "default": "Loading..." },
    { "type": "text", "id": "request_failed_text", "label": "Request failed fallback text", "default": "Request failed. Please try again later." },
    { "type": "page", "id": "detail_page_base_url", "label": "Detail page base URL" },
    { "type": "text", "id": "empty_image", "label": "Empty image URL", "default": "https://cdn.shopify.com/s/files/1/0970/9262/files/a98ad624a1bd89a26b980f77c5f52e80.png?v=1658221357_270x" },
    { "type": "text", "id": "empty_image_alt", "label": "Empty image alt", "default": "track-order not found" },
    { "type": "textarea", "id": "empty_message", "label": "Empty message", "default": "We could not find your order. Please contact [email]." },
    { "type": "text", "id": "back_button_text", "label": "Back button text", "default": "Back" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "hello@jackery.com" }
  ],
  "presets": [
    {
      "name": "V5-Support Order Search",
      "category": "V5.0 Support"
    }
  ]
}
{% endschema %}
