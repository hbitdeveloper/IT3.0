{% comment %} 11周年Our Jackery 组件 {% endcomment %}
{% schema %}
{
  "name": "Our Jackery Component",
  "tag": "section",
  "class": "our-jackery-component",
  "settings": [
    {
      "type": "text",
      "id": "tabBrandConcept",
      "label": "Tab - Brand Concept"
    },
    {
      "type": "text",
      "id": "tabSocialResponsibility",
      "label": "Tab - Social Responsibility"
    },
    {
      "type": "text",
      "id": "tabAwardsAndCertifications",
      "label": "Tab - Awards and Certifications"
    },
    {
      "type": "image_picker",
      "id": "pcBrandConceptImg",
      "label": "Brand Concept Image (PC)"
    },
    {
      "type": "image_picker",
      "id": "mbBrandConceptImg",
      "label": "Brand Concept Image (Mobile)"
    }
  ]
}
{% endschema %}
<div class="our-jackery-box">
	<ul class="tab-list">
		{% if section.settings.tabBrandConcept != blank %}
			<li class="active" data-type="brand-concept">{{ section.settings.tabBrandConcept }}</li>
		{% endif %}
		{% if section.settings.tabSocialResponsibility != blank %}
			<li data-type="social-responsibility">{{ section.settings.tabSocialResponsibility }}</li>
		{% endif %}
		{% if section.settings.tabAwardsAndCertifications != blank %}
			<li data-type="awards-and-certifications">{{ section.settings.tabAwardsAndCertifications }}</li>
		{% endif %}
	</ul>
	<div class="tab-content tab-brand-concept">
		{% render 'responsive-image',
				image: section.settings.pcBrandConceptImg,
				mimage: section.settings.mbBrandConceptImg,
				image_class: 'brand-concept-img'
		%}
	</div>

</div>
