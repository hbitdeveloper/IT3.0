<link
        rel="stylesheet"
        href="{{ 'sections-ehb-text-pic.css' | asset_url }}"
        media="print"
        onload="this.media='all'">
<noscript>
  {{ 'sections-ehb-text-pic.css' | asset_url | stylesheet_tag }}
</noscript>


<div
    class="section-container-lg ehb-scroll-textpic-main"
    {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
>
    {%- render "diy-scroll-textpic", settings: section.settings, unscroll: true, mb_spaceBetween: 30 -%}
</div>

{% schema %}
{
    "name": "EHB 滚动图文",
    "tag": "section",
    "class": "ehb-scroll-textpic",
    "enabled_on": {
      "templates": ["page"]
    },
    "settings": [
        { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
        {
            "type": "select",
            "id": "page_width",
            "options": [
                {
                "value": "section-container",
                "label": "版心/1200px"
                },
                {
                "value": "section-container-lg",
                "label": "大版心/1312px"
                },
                {
                "value": "w-full",
                "label": "铺满/100%"
                }
            ],
            "default": "section-container-lg",
            "label": "PC的组件宽度",
            "info": "MB端组件宽度固定和设计稿一致，不可修改"
        },

        { "type": "textarea", "id": "title", "label": "Title"},
        { "type": "number", "id": "title_font", "label": "Title MB 字体大小","default":80 },

        {"type": "header", "content": "场景 1 配置"},
        { "type": "text", "id": "heading_1", "label": "场景 1 Heading" },
        { "type": "textarea", "id": "description_1", "label": "场景 1 Description" },
        { "type": "image_picker", "id": "pc_img_1", "label": "场景 1 PC Image" },
        { "type": "image_picker", "id": "mb_img_1", "label": "场景 1 Mobile Image"},

        {"type": "header", "content": "场景 2 配置"},
        { "type": "text", "id": "heading_2", "label": "场景 2 Heading" },
        { "type": "textarea", "id": "description_2", "label": "场景 2 Description" },
        { "type": "image_picker", "id": "pc_img_2", "label": "场景 2 PC Image" },
        { "type": "image_picker", "id": "mb_img_2", "label": "场景 2 Mobile Image"},

        {"type": "header", "content": "场景 3 配置"},
        { "type": "text", "id": "heading_3", "label": "场景 3 Heading" },
        { "type": "textarea", "id": "description_3", "label": "场景 3 Description" },
        { "type": "image_picker", "id": "pc_img_3", "label": "场景 3 PC Image" },
        { "type": "image_picker", "id": "mb_img_3", "label": "场景 3 Mobile Image"},

        {"type": "header", "content": "场景 4 配置"},
        { "type": "text", "id": "heading_4", "label": "场景 4 Heading" },
        { "type": "textarea", "id": "description_4", "label": "场景 4 Description" },
        { "type": "image_picker", "id": "pc_img_4", "label": "场景 4 PC Image" },
        { "type": "image_picker", "id": "mb_img_4", "label": "场景 4 Mobile Image"},

        {"type": "header", "content": "场景 5 配置"},
        { "type": "text", "id": "heading_5", "label": "场景 5 Heading" },
        { "type": "textarea", "id": "description_5", "label": "场景 5 Description" },
        { "type": "image_picker", "id": "pc_img_5", "label": "场景 5 PC Image" },
        { "type": "image_picker", "id": "mb_img_5", "label": "场景 5 Mobile Image"},

        {"type": "header", "content": "场景 6 配置"},
        { "type": "text", "id": "heading_6", "label": "场景 6 Heading" },
        { "type": "textarea", "id": "description_6", "label": "场景 6 Description" },
        { "type": "image_picker", "id": "pc_img_6", "label": "场景 6 PC Image" },
        { "type": "image_picker", "id": "mb_img_6", "label": "场景 6 Mobile Image"}
    ],
    "presets": [
        {
            "name": "EHB 滚动图文",
            "category": "EHB页面",
            "settings": {}
        }
    ]
}
{% endschema %}

