        <style>
            .index-news-container {background: #f5f5f5;padding: 110px 0;}
            .index-news-container .title {margin-bottom: 44px;}
            .index-news-container .index-news-ul {padding: 58px 78px;border-radius: 75px 0px 0px 0px;overflow-y: scroll;max-height: 560px;background: #fff;}
            .index-news-container .index-news-ul .index-news-li {margin-bottom: 38px;color: #333;}
            .index-news-container .index-news-ul .index-news-li .news-date {width: 190px;}
            .index-news-container .index-news-ul .index-news-li .news-type {width: 120px;line-height: 26px;}
            .index-news-container .index-news-ul .index-news-li .news-link {margin-left: 10px;color: #333;max-width: 600px;transition: color 0.25s;line-height: 26px;}
            .index-news-container .index-news-ul .index-news-li .news-link p a {color: #333;}
            .index-news-container .index-news-ul .index-news-li .news-link:hover, .index-news-container .index-news-ul .index-news-li .news-link:hover p a {color: var(--primary-color);}
    
            @media (min-width: 1024px) and (max-width: 1360px) {
            .index-news-container {padding: 5.72917vw 0;}
            .index-news-container .title {margin-bottom: 2.29167vw;}
            .index-news-container .index-news-ul {padding: 3.02083vw 4.0625vw;border-radius: 3.90625vw 0px 0px 0px;max-height: 29.16667vw;}
            .index-news-container .index-news-ul .index-news-li {margin-bottom: 1.97917vw;}
            .index-news-container .index-news-ul .index-news-li .news-date {width: 180px;}
            .index-news-container .index-news-ul .index-news-li .news-type {width: 110px;}
            .index-news-container .index-news-ul .index-news-li .news-link {margin-left: 8px;max-width: 560px;}
            }
            @media (max-width: 1024px) {
            .index-news-container {padding: 55px 0;}
            .index-news-container .title {margin-bottom: 22px;}
            .index-news-container .index-news-ul {padding: 38px 18px;border-radius: 40px 0px 0px 0px;max-height: 500px;}
            .index-news-container .index-news-ul .index-news-li {margin-bottom: 32px;flex-wrap: wrap;}
            .index-news-container .index-news-ul .index-news-li .news-date {width: 170px;}
            .index-news-container .index-news-ul .index-news-li .news-type {width: 100px;}
            .index-news-container .index-news-ul .index-news-li .news-link {margin-left: 0; max-width: 100%;padding-top: 4px;}
            }
        </style>

        <div class="section-container">
            <h2 class="title jky-text-2xl font-bold text-center">{{section.settings.title}}</h2>
            <div class="index-news-ul">
                {% for block in section.blocks %}
                <div class="index-news-li flex">
                    <span class="news-date text-overflow-1">{{block.settings.news_date}}</span>
                    <span class="news-type text-overflow-1">{{block.settings.news_type}}</span>
                    <div class="news-link text-overflow-1">{{block.settings.news_link | newline_to_br}}</div>
                </div>
                {% endfor %}

                <div class="index-news_more flex justify-center">
                    <a href="{{section.settings.more_link}}" class="jky-text-sm font-500 z-button-fill-middle">{{section.settings.news_btn_txt}}</a>
                </div>
            </div>
        </div>
{% schema %}
  {
    "name": "Index News section",
    "tag": "section",
    "class": "section index-news-container",
    "disabled_on": {
      "templates": ["collection"]
    },
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "News"
      }, {
        "type": "text",
        "id": "news_btn_txt",
        "label": "link text",
        "default": "VIEW MORE"
      },
      {
        "type": "url",
        "id": "more_link",
        "label": "News all link"
      }
    ],
    "blocks": [{
        "type": "news_item",
        "name": "News Item",
        "settings": [
          {
            "type": "text",
            "id": "news_date",
            "label": "News Date"
          }, {
            "type": "text",
            "id": "news_type",
            "label": "News Type"
          }, {
            "type": "richtext",
            "id": "news_link",
            "label": "News"
          }
        ]
      }],
    "presets": [{
        "name": "Index News Section"
    }]
  }
{% endschema %}