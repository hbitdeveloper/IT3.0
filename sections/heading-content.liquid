<div style="--section-text-bg: {{section.settings.bg_color}};background:var(--section-text-bg, rgba(255,255,255,0));">{% content_for "block", type: "v-heading-content", id: "heading-content-01" %}
</div>
{% # theme-check-disable %}
{% schema %}
{
  "name": "V-文本组",
  "tag": "section",
   "settings": [
       { "type": "color_background", "id": "bg_color", "label": "背景颜色" },
   ],
   "presets": [
       {
           "name": "V-文本组",
           "blocks": [{
               "type": "v-heading-content", 
               "static": true,
               "id": "heading-content-01",
               "settings": {
                   "content_width": "content_small",
                   "padding_top": 36,
                   "padding_bottom": 36,
                   "padding_left": 0,
                   "padding_right": 0
               },
               "blocks": [
                   {
                       "type": "_v-heading-content-heading",
                       "settings": {
                           "heading": "<p>PC 默认标题内容</p>",
                           "mb_heading": "<p>MB 默认标题内容</p>",
                           "padding_top": 0,
                           "padding_bottom": 16,
                           "heading_size": "heading_2"
                       }
                   },
                   {
                       "type": "_v-heading-content-subheading",
                       "settings": {
                           "heading": "<p>PC 默认副标题内容</p>",
                           "mb_heading": "<p>MB 默认副标题内容</p>",
                           "padding_top": 0,
                           "padding_bottom": 40
                       }
                   },
                   {
                       "type": "_v-heading-content-des",
                       "settings": {
                           "heading": "<p>PC 默认描述文案内容</p>",
                           "mb_heading": "<p>PC 默认描述文案内容</p>",
                           "padding_top": 0,
                           "padding_bottom": 0
                       }
                   },
               ]
           }]
       }
   ]
}
{% endschema %}
{% # theme-check-enable %}