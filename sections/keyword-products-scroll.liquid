{%- style -%}
  .section-keyword-products-scroll {
    background: #ffffff;
    margin-bottom: 3.125vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }

  .keyword-products-scroll-title {
    font-size: 2.3438vw;
    font-weight: 600;
    color: #000000;
    text-align: center;
  }

  .keyword-products-scroll-content {
    max-width: 75vw;
    margin-top: 2.5521vw;
    margin-left: auto;
    margin-right: auto;
  }

  .keyword-product-scroll-item {
    display: flex;
    border-radius: 1.5625vw;
    background: #f6f6f6;
  }
  .keyword-product-scroll-item .item-content {
    padding: 2.5vw;
  }
  .keyword-product-scroll-item .item-image {
    display: block;
    max-width: 37.5vw;
  }

  .keyword-product-scroll-item .item-image-m {
    display: none;
  }

  .keyword-product-scroll-item .item-content .item-price {
    padding: 2.6042vw 0;
  }

  .keyword-product-scroll-item .item-content .item-price .kwd-price {
    font-size: 1.875vw;
    font-weight: 600;
    color: var(--primary-color);
    padding-right: 1.5625vw;
  }

  .keyword-product-scroll-item .item-content .item-price .kwd-old-price {
    text-decoration: line-through;
    font-size: 1.25vw;
    color: #666666;
  }

  .keyword-product-scroll-item .item-content .kwd-product-button {
    position: relative;
    align-items: center;
    background: var(--primary-color);
    cursor: pointer;
    display: flex;
    text-decoration: none;
    justify-content: center;
    width: 15.625vw;
    height: 3.4375vw;
    color: #ffffff;
    font-weight: 600;
    font-size: 1.25vw;
    border-radius: 1.7188vw;
  }

  .keyword-product-scroll-item .item-content .content-title {
    font-size: 1.875vw;
    font-weight: 600;
    color: #000000;
    padding-bottom: 1.4063vw;
  }
  .keyword-product-scroll-item .item-content .content-subtitle {
    font-size: 1.25vw;
    font-weight: 500;
    color: #333333;
    padding-bottom: 1.25vw;
    line-height: 1.875vw;
  }
  .keyword-product-scroll-item .item-content .content-p-image {
    max-width: 21.7188vw;
    max-height: 9.2708vw;
  }
  .keyword-product-scroll-item .item-content .content-icons {
    display: grid;
  }
  .keyword-product-scroll-item .item-content .content-icons-gcol-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5521vw;
  }
  .keyword-product-scroll-item .item-content .content-icons-gcol-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5521vw 7.0833vw;
  }
  .keyword-product-scroll-item .item-content .content-icons .content-icons-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .keyword-product-scroll-item .item-content .content-icons .content-icons-item .icons-item-img {
    width: 5.2083vw;
    height: 5.2083vw;
  }
  .keyword-product-scroll-item .item-content .content-icons .content-icons-item .icon-item-subtitle {
    text-align: center;
    font-size: 0.9375vw;
    font-weight: 500;
    color: #333333;
    margin-top: 0.5208vw;
  }

  .kpw-swiper-pagination {
    display: flex;
    justify-content: center;
    padding-top: 2.0833vw;
    align-items: center;
  }
  .kpw-swiper-pagination .kpw-swiper-pagination-customs {
    width: 2.0833vw;
    height: 0.1042vw;
    background: #cccccc;
    margin-right: 0.5208vw;
    cursor: pointer;
  }
  .kpw-swiper-pagination .kpw-swiper-pagination-customs-active {
    width: 5.2083vw;
    height: 0.2083vw;
    background: var(--primary-color);
  }
  @media screen and (max-width: 768px) {
    .section-keyword-products-scroll {
      margin-bottom: 13.7333vw;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .keyword-products-scroll-title {
      font-size: 6vw;
      font-weight: 600;
      color: #000000;
      line-height: 8.8vw;
      padding: 0 14.6667vw 6.5333vw 14.6667vw;
    }

    .keyword-products-scroll-content {
      max-width: 100%;
      padding: 0 8vw;
    }

    .keyword-product-scroll-item {
      flex-direction: column;
      border-radius: 0;
    }

    .keyword-product-scroll-item .item-image {
      display: none;
    }

    .keyword-product-scroll-item .item-image-m {
      order: 1;
      display: block;
      width: 100%;
    }

    .keyword-product-scroll-item .item-content {
      order: 2;
      padding: 2.9333vw;
    }

    .keyword-product-scroll-item .item-content .content-title {
      font-size: 4.8vw;
      font-weight: 600;
      color: #000000;
      line-height: 7.2vw;
      padding-bottom: 3.2vw;
    }

    .keyword-product-scroll-item .item-content .content-subtitle {
      font-size: 3.2vw;
      font-weight: 500;
      color: #333333;
      line-height: 4.8vw;
      padding-bottom: 2.9333vw;
    }
    .keyword-product-scroll-item .item-content .content-p-image {
      width: 54.6667vw;
      height: 25.3333vw;
    }

    .keyword-product-scroll-item .item-content .content-icons {
      padding-top: 1.6vw;
      padding-bottom: 4.6667vw;
    }

    .keyword-product-scroll-item .item-content .content-icons-gcol-4 {
      gap: 6.6667vw;
    }

    .keyword-product-scroll-item .item-content .content-icons-gcol-3 {
      gap: 6.6667vw;
    }

    .keyword-product-scroll-item .item-content .content-icons .content-icons-item .icons-item-img {
      width: 13.3333vw;
      height: 13.3333vw;
    }

    .keyword-product-scroll-item .item-content .content-icons .content-icons-item .icon-item-subtitle {
      margin-top: 0.6667vw;
      font-size: 2.4vw;
      font-weight: 400;
      color: #333333;
      line-height: 3.6vw;
    }

    .keyword-product-scroll-item .item-content .item-price {
      padding: 0 0 37px 0;
    }

    .keyword-product-scroll-item .item-content .item-price .kwd-price {
      font-size: 4.8vw;
      font-weight: 600;
      line-height: 3.6vw;
    }
    .keyword-product-scroll-item .item-content .item-price .kwd-old-price {
      text-decoration: line-through;
      font-size: 3.2vw;
      font-weight: 400;
      line-height: 3.6vw;
    }

    .keyword-product-scroll-item .item-content .kwd-product-button {
      width: 40vw;
      height: 8.8vw;
      border-radius: 4.4vw;
      font-size: 3.2vw;
    }
  }

  .keyword-products-scroll-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .keyword-products-scroll-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .keyword-products-scroll-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }
  }
{%- endstyle -%}

<h2 class="keyword-products-scroll-title" anchor="{{ section.settings.anchor | escape }}"
style="
--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
--pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
"
>{{ section.settings.title | escape }}</h2>
{%- if section.settings.sub != blank -%}
 <div class="keyword-scroll-sub keyword-sub">{{ section.settings.sub }}</div>
{%- endif -%}
<div class="swiper kps-swiper-main" >
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="keyword-products-scroll-content swiper-slide">
        <div class="keyword-product-scroll-item">
          <div class="item-content">
            <h3 class="content-title">{{ block.settings.product.title | escape }}</h3>
            <div class="content-subtitle">
              {{ block.settings.p_subtitle | newline_to_br }}
            </div>
            <img
              src="{{ block.settings.p_img | image_url: width: 800 }}"
              alt="{{ block.settings.p_img.alt }}"
              class="content-p-image" loading="lazy"
            >
            <dl class="content-icons {%if block.settings.line_icon_number == "4" %} content-icons-gcol-4 {%endif %} {%if block.settings.line_icon_number == "3" %} content-icons-gcol-3 {%endif %}">
              {% if block.settings.icon_1 %}
                <dd class="content-icons-item">
                  <img
                    src="{{ block.settings.icon_1 | image_url: width: 100 }}"
                    alt="{{ block.settings.icon_1.alt }}"
                    class="icons-item-img" loading="lazy"
                  >
                  <span class="icon-item-subtitle">{{ block.settings.icon_t_1 | newline_to_br }}</span>
                </dd>
              {% endif %}
              {% if block.settings.icon_2 %}
                <dd class="content-icons-item">
                  <img
                    src="{{ block.settings.icon_2 | image_url: width: 100 }}"
                    alt="{{ block.settings.icon_2.alt }}"
                    class="icons-item-img" loading="lazy"
                  >
                  <span class="icon-item-subtitle">{{ block.settings.icon_t_2 | newline_to_br }}</span>
                </dd>
              {% endif %}
              {% if block.settings.icon_3 %}
                <dd class="content-icons-item">
                  <img
                    src="{{ block.settings.icon_3 | image_url: width: 100 }}"
                    alt="{{ block.settings.icon_3.alt }}"
                    class="icons-item-img" loading="lazy"
                  >
                  <span class="icon-item-subtitle">{{ block.settings.icon_t_3 | newline_to_br }}</span>
                </dd>
              {% endif %}
              {% if block.settings.icon_4 %}
                <dd class="content-icons-item">
                  <img
                    src="{{ block.settings.icon_4 | image_url: width: 100 }}"
                    alt="{{ block.settings.icon_4.alt }}"
                    class="icons-item-img" loading="lazy"
                  >
                  <span class="icon-item-subtitle">{{ block.settings.icon_t_4 | newline_to_br }}</span>
                </dd>
              {% endif %}
              {% if block.settings.icon_5 %}
                <dd class="content-icons-item">
                  <img
                    src="{{ block.settings.icon_5 | image_url: width: 100 }}"
                    alt="{{ block.settings.icon_5.alt }}"
                    class="icons-item-img" loading="lazy"
                  >
                  <span class="icon-item-subtitle">{{ block.settings.icon_t_5 | newline_to_br }}</span>
                </dd>
              {% endif %}
              {% if block.settings.icon_6 %}
                <dd class="content-icons-item">
                  <img
                    src="{{ block.settings.icon_6 | image_url: width: 100 }}"
                    alt="{{ block.settings.icon_6.alt }}"
                    class="icons-item-img" loading="lazy"
                  >
                  <span class="icon-item-subtitle">{{ block.settings.icon_t_6 | newline_to_br }}</span>
                </dd>
              {% endif %}
              {% if block.settings.icon_7 %}
                <dd class="content-icons-item">
                  <img
                    src="{{ block.settings.icon_7 | image_url: width: 100 }}"
                    alt="{{ block.settings.icon_7.alt }}"
                    class="icons-item-img" loading="lazy"
                  >
                  <span class="icon-item-subtitle">{{ block.settings.icon_t_7 | newline_to_br }}</span>
                </dd>
              {% endif %}
              {% if block.settings.icon_8 %}
                <dd class="content-icons-item">
                  <img
                    src="{{ block.settings.icon_8 | image_url: width: 100 }}"
                    alt="{{ block.settings.icon_8.alt }}"
                    class="icons-item-img" loading="lazy"
                  >
                  <span class="icon-item-subtitle">{{ block.settings.icon_t_8 | newline_to_br }}</span>
                </dd>
              {% endif %}
            </dl>
            {% assign target = block.settings.product.selected_or_first_available_variant %}
            {% assign compare_at_price = target.compare_at_price %}
            {% assign price = target.price | default: 1999 %}
            {% assign money_price = price | money %}
            {% if target == block.settings.product and block.settings.product.price_varies %}
              {% assign money_price = 'products.product.price.from_price_html' | t: price: money_price %}
            {% endif %}
            <div class="item-price">
              {% render 'product-sale-price', product: block.settings.product %}
            </div>

            <a class="kwd-product-button" data-href="{{block.settings.product.url}}" data-title="{{ block.settings.product.title }}" data-price="{{ money_price }}" data-compare_at_price="{{ compare_at_price | money }}">
              {{- 'general.action_text.learn_more' | t }}
              <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
            </a>
          </div>
          <img
            src="{{ block.settings.p_banner_img | image_url: width: 300 }}"
            alt="{{ block.settings.p_banner_img.alt }}"
            class="item-image" loading="lazy"
          >
          <img
            src="{{ block.settings.m_banner_img | image_url: width: 300 }}"
            alt="{{ block.settings.m_banner_img.alt }}"
            class="item-image-m" loading="lazy"
          >
        </div>
      </div>
    {% endfor %}
  </div>
</div>
<div id="custom_kwp_swiper_page" class="kpw-swiper-pagination"></div>
<script type="module">
  function keywordProductScrollInit() {
    const scrollItems = document.querySelectorAll('.keyword-product-scroll-item');
    let scrollItemLength = scrollItems.length;
    let isLoop = scrollItemLength == 1 ? false : true;

    let swiper = new Swiper('.kps-swiper-main', {
      autoHeight: true,
      autoplay: true,
      loop: isLoop,
      effect: 'fade',
      fadeEffect: {
        crossFade: true,
      },
      pagination: {
        el: '#custom_kwp_swiper_page',
        clickable: true,
        type: 'custom',
        renderCustom: function (swiper, current, total) {
          var paginationHtml = '';
          for (var i = 1; i <= total; i++) {
            // 判断是否是激活焦点，是的话添加active类，不是就只添加基本样式类
            if (i === current) {
              paginationHtml +=
                '<span class="kpw-swiper-pagination-customs kpw-swiper-pagination-customs-active"></span>';
            } else {
              paginationHtml += '<span class="kpw-swiper-pagination-customs"></span>';
            }
          }
          return paginationHtml;
        },
      },
    });

    const paginationContainer = document.getElementById('custom_kwp_swiper_page');
    if (scrollItemLength == 1) {
      paginationContainer.style.display = 'none';
    }

    paginationContainer.addEventListener('click', function (e) {
      const target = e.target;
      if (target.classList.contains('kpw-swiper-pagination-customs')) {
        const siblings = Array.from(target.parentElement.children);
        const index = siblings.indexOf(target) + 1;
        swiper.slideTo(index, 1000, false); //切换到对应的slide，速度为1秒
      }
    });

    const buttons = document.querySelectorAll('.kwd-product-button');
    buttons.forEach(function (button) {
      button.addEventListener('click', function (e) {
        let targetDom;
        if (e.target.localName == 'span') {
          targetDom = e.target.offsetParent;
        } else {
          targetDom = e.target;
        }

        let href = targetDom.dataset.href;
        let title = targetDom.dataset.title;
        let price = targetDom.dataset.price;
        let compare_at_price = targetDom.dataset.compare_at_price;

        window.dataLayer.push({ event_parameters: null });
        window.dataLayer.push({
          event: 'ga4Event',
          event_name: 'best_small_generator_learn more',
          event_parameters: {
            current_page: location.pathname,
            title: title,
            price: price,
            origin_price: compare_at_price,
            currency: window.Shopify.currency.active,
            product_url: href,
          },
        });
        window.open(href, "_blank");
      });
    });
  }

  window.addEventListener('DOMContentLoaded', function () {
    keywordProductScrollInit();
  });
</script>

{% schema %}
{
  "name": "Keyword Products Scroll",
  "class": "section-keyword-products-scroll",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },  
  { "type": "text", "id": "title", "label": "Title" },{ "type": "richtext", "id": "sub", "label": "SubTitle" }],
  "blocks": [
    {
      "type": "products-item",
      "name": "Products Item",
      "settings": [
        { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
        { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 40 },
        { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
        { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "p_banner_img", "label": "Product PC banner image" },
        { "type": "image_picker", "id": "m_banner_img", "label": "Product Mobile banner image" },
        { "type": "textarea", "id": "p_subtitle", "label": "Product Subtitle" },
        { "type": "image_picker", "id": "p_img", "label": "Product image" },
        {
          "type": "select",
          "id": "line_icon_number",
          "label": "Icon Quantity Per Row",
          "options": [
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" }
          ]
        },

        { "type": "image_picker", "id": "icon_1", "label": "Product icon 1" },
        { "type": "textarea", "id": "icon_t_1", "label": "Product advantage 1" },

        { "type": "image_picker", "id": "icon_2", "label": "Product icon 2" },
        { "type": "textarea", "id": "icon_t_2", "label": "Product advantage 2" },

        { "type": "image_picker", "id": "icon_3", "label": "Product icon 3" },
        { "type": "textarea", "id": "icon_t_3", "label": "Product advantage 3" },

        { "type": "image_picker", "id": "icon_4", "label": "Product icon 4" },
        { "type": "textarea", "id": "icon_t_4", "label": "Product advantage 4" },

        { "type": "image_picker", "id": "icon_5", "label": "Product icon 5" },
        { "type": "textarea", "id": "icon_t_5", "label": "Product advantage 5" },

        { "type": "image_picker", "id": "icon_6", "label": "Product icon 6" },
        { "type": "textarea", "id": "icon_t_6", "label": "Product advantage 6" },

        { "type": "image_picker", "id": "icon_7", "label": "Product icon 7" },
        { "type": "textarea", "id": "icon_t_7", "label": "Product advantage 7" },

        { "type": "image_picker", "id": "icon_8", "label": "Product icon 8" },
        { "type": "textarea", "id": "icon_t_8", "label": "Product advantage 8" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keyword Products Scroll",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
