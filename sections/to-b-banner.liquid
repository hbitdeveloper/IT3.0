
{% comment %} t0-b各子版块 开始 {% endcomment %}
<div anchor="{{ section.settings.anchor | escape }}">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'to_b_banner' -%}
        {% comment %} banner版块 {% endcomment %}
        {% render 'five-kwh-banner', banner: block.settings, new_window: section.settings.new_window%}
      {%- when 'to_b_subscribe' -%}
        {% comment %} 订阅版块 {% endcomment %}
        {% render 'five-kwh-subscribe', subscribe: block.settings, index: forloop.index %}
      {%- when 'to_b_letter' -%}
        {% comment %} 信任状 {% endcomment %}
        {% render 'five-kwh-letter', letter: block.settings, index: forloop.index %}
      {%- when 'media_highlight_space' -%}
        <div class=" product-media_highlight--block product-block-section">
          {%- render "diy-scroll-textpic", settings: block.settings -%}
        </div>
        {%- when 'to_b_text' -%}
        {% comment %} 图文 {% endcomment %}
        {% render 'indoor-img-text', imgtext: block.settings, index: forloop.index %}
    {%- endcase -%}
  {%- endfor -%}
</div>
