<style>
.sign-up-wrap {
  width: 100%;
  height: 450px;
  background-image: url('{{section.settings.sign_up_image | img_url: "master"}}');
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  padding-top: 90px;
}
.sign-up-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sign-up-content h2 {
  font-size: 45px;
  font-family: Gilroy-Medium, Gilroy;
  font-weight: 500;
  color: #000000;
  line-height: 66px;
  margin-bottom: 40px;
}
.sign-up {
  display: flex;
  align-items: center;
  position: relative;
}
.sign-up input {
  width: 540px;
  height: 46px;
  background: #ffffff;
  border-radius: 23px;
  border: 2px solid #dddddd;
  padding: 10px 20px;
  font-size: 18px;
  font-family: Gilroy-Regular, Gilroy;
  padding: 10px 150px 10px 20px;
  line-height: 27px;
}
.sign-up button {
  height: 46px;
  background: #fd5000;
  border-radius: 23px;
  border: 1px solid #fd5000;
  font-size: 18px;
  font-family: Gilroy-Medium, Gilroy;
  font-weight: 500;
  color: #ffffff;
  line-height: 27px;
  padding: 10px 30px;
  position: absolute;
  right: 0;
  top: 0;
}
.sign-up-content p {
  font-size: 18px;
  font-family: Gilroy-Light, Gilroy;
  font-weight: 300;
  color: #000000;
  line-height: 33px;
  margin-top: 14px;
}

@media only screen and (max-width: 768px) {
  .sign-up-wrap {
    height: 113.87vw;
    background-image: url('{{section.settings.sign_up_m_image | img_url: "master"}}');
    padding-top: 8vw;
  }
  .sign-up-content h2 {
    font-size: 7.2vw;
    line-height: 8.8vw;
    margin-bottom: 3.2vw;
    text-align: center;
    padding: 0 8vw;
  }
  .sign-up {
    width: 100%;
    max-width: 106.67vw;
    padding: 0 8vw;
  }
  .sign-up input {
    width: 100%;
    height: 9.0666666667vw;
    border-radius: 4.533333333333333vw;
    border: 1px solid #dddddd;
    font-size: 3.2vw;
    line-height: 5.33333333vw;
    padding: 1.6vw 20.333333333332vw 1.6vw 2.6666666667vw;
  }
  .sign-up button {
    height: 9.0666666667vw;
    padding: 1.8666666667vw 5.33333333vw;
    border-radius: 4.53333333333vw;
    font-size: 3.466666666667vw;
    line-height: 5.33333333vw;
    right: 8vw;
  }
  .sign-up-content p {
    font-size: 3.2vw;
    line-height: 4vw;
    margin-top: 3.2vw;
  }
}

</style>

<div class="sign-up-wrap">
    <div class="sign-up-content">
        <h2>{{section.settings.sign_up_title}}</h2>
        <div class="sign-up">
            <input type="email" placeholder="{{section.settings.email_placeholder}}" />
            <button>{{section.settings.sign_up_text}}</button>
        </div>
        <p>{{section.settings.abstract}}</p>
    </div>
</div>


{% schema %}
  {
    "name": "Sign Up",
    "class": "layer layer-container",
    "tag": "div",
    "settings": [
      {"type": "textarea", "id": "sign_up_title", "label": "Heading", "default": "DON'T MISS OUT ON JACKERY DEALS"},
      {"type": "textarea", "id": "abstract", "label": "Abstract", "default": "Enter your email to get Jackery's fantastic news and offers"},
      {"type": "text", "id": "email_placeholder", "label": "Email Placeholder","default": "Enter your Email Address"},
      {"type": "text", "id": "sign_up_text", "label": "Sign up text", "default": "SIGN UP"},
      {"type": "image_picker", "id": "sign_up_image", "label": "Image"},
      {"type": "image_picker", "id": "sign_up_m_image", "label": "Mobile Image"}
    ]
  }
{% endschema %}