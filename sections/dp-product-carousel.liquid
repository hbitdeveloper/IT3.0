{% comment %} 日本防灾日 产品轮播组件 {% endcomment %}
{% schema %}
{
  "name": "DP Product Carousel",
  "tag": "section",
  "class": "dp-product-carousel",
  "settings": [
    {
      "type": "image_picker",
      "id": "productImg",
      "label": "Product Image(580*540)"
    },
    {
      "type": "image_picker",
      "id": "titleImg",
      "label": "Title Image"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Jackeryポータブル電源は自然放電が少なく、フル充電すれば3ヶ月経過しても80％以上の電池残量を保持できます。"
    }
  ],
  "blocks": [
    {
      "name": "Tab Item",
      "type": "slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "titleImg",
          "label": "Title Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Desc"
        },
        {
          "type": "image_picker",
          "id": "img",
          "label": "Image(580*540)"
        }
      ]
    }
  ]
}
{% endschema %}
<div class="dp-product-carousel-box">
	<picture>
		<source media="(min-width:1024px)" srcset="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/dp-product-carousel-bg-pc.png?v=1721698567">
		<img src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/dp-product-carousel-bg-mb.png?v=1721698567" class="rg-bg-img" alt="jackery" loading="lazy">
	</picture>
	<div class="section-container relative">
		<div class="top-box flex dp-animation">
			<div class="img-box box-shadow">
        {%- 
          render 'responsive-image', 
          image: section.settings.productImg,
          width: 580,
          mwidth: 150,
          image_class: 'product-img radius-20'
        -%}
			</div>
			<div class="content-box">
        {%- 
          render 'responsive-image', 
          image: section.settings.titleImg,
          width: 600,
          mwidth: 300,
          image_class: 'title-img'
        -%}
				<p class="desc">{{ section.settings.description }}</p>
			</div>
		</div>
		{% assign total = section.blocks | size %}
		<div class="bottom-box pc-swiper dp-animation" data-total="{{ total }}">
			<div class="swiper-wrapper">
				{% for block in section.blocks %}
					<div class="swiper-slide">
						<div class="slide-box flex">
							<div class="content-box ">
                {%- 
                  render 'responsive-image', 
                  image: block.settings.titleImg,
                  width: 600,
                  mwidth: 300,
                  image_class: 'title-img'
                -%}
								<div class="title">{{ block.settings.title }}</div>
								<div class="desc">{{ block.settings.desc }}</div>
							</div>
							<div class="img-box box-shadow pc-show">
                {%- 
                  render 'responsive-image', 
                  image: block.settings.img,
                  width: 580,
                  mwidth: 200,
                  image_class: 'swiper-img lazy radius-20'
                -%}
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>

		{% if total > 1 %}
			<div class="swiper-arrow">
				<div class="dp-animation">
					<svg class="arrow-item swiper-arrow-prev" width="64" height="64" viewBox="0 0 64 64" fill="none"
							 xmlns="http://www.w3.org/2000/svg">
						<g>
							<circle cx="31.746" cy="31.746" r="30.746" transform="matrix(-1 0 0 1 63.4922 0)" stroke="#FF5000"
											stroke-width="2"/>
							<path
									d="M19.257 32.8068C18.6712 32.221 18.6712 31.2712 19.257 30.6854L28.8029 21.1395C29.3887 20.5537 30.3385 20.5537 30.9243 21.1395C31.5101 21.7253 31.5101 22.675 30.9243 23.2608L22.439 31.7461L30.9243 40.2314C31.5101 40.8172 31.5101 41.7669 30.9243 42.3527C30.3385 42.9385 29.3887 42.9385 28.8029 42.3527L19.257 32.8068ZM43.1748 33.2461L20.3177 33.2461V30.2461L43.1748 30.2461V33.2461Z"
									fill="#FF5000"/>
						</g>
					</svg>
					<svg class="arrow-item swiper-arrow-next" width="64" height="64" viewBox="0 0 64 64" fill="none"
							 xmlns="http://www.w3.org/2000/svg">
						<g>
							<circle cx="32.2541" cy="31.746" r="30.746" stroke="#FF5000" stroke-width="2"/>
							<path
									d="M44.3219 32.8068C44.9077 32.221 44.9077 31.2712 44.3219 30.6854L34.776 21.1395C34.1902 20.5537 33.2405 20.5537 32.6547 21.1395C32.0689 21.7253 32.0689 22.675 32.6547 23.2608L41.14 31.7461L32.6547 40.2314C32.0689 40.8172 32.0689 41.7669 32.6547 42.3527C33.2405 42.9385 34.1902 42.9385 34.776 42.3527L44.3219 32.8068ZM20.8254 33.2461L43.2613 33.2461L43.2613 30.2461L20.8254 30.2461L20.8254 33.2461Z"
									fill="#FF5000"/>
						</g>
					</svg>
				</div>
			</div>
		{% endif %}

		<div class="dp-animation">
			<div class="mb-bottom-box mb-show box-shadow">
				<div class="mb-swiper swiper">
					<div class="swiper-wrapper">
						{% for block in section.blocks %}
							<div class="swiper-slide">
								<div class="slide-box">
                  {%- 
                    render 'responsive-image', 
                    image: block.settings.img,
                    width: 580,
                    mwidth: 200,
                    image_class: 'swiper-img lazy radius-20'
                  -%}
								</div>
							</div>
						{% endfor %}
					</div>
				</div>
				{% if total > 1 %}
					<div class="swiper-pagination slideshow-pagination"></div>
				{% endif %}
			</div>
		</div>

	</div>
</div>
<script>
  (function () {
    const initCarousel = function () {
      const pcSwiperEl = document.querySelector('.dp-product-carousel-box .pc-swiper');
      const slideTotal = Number(pcSwiperEl?.dataset.total || 0);
      let topSwiper = {
        oldRealIndex: '',
        direction: ''
      }
      const dpPCSwiper = new window.Swiper('.dp-product-carousel-box .pc-swiper', {
        loop: true,
        effect: "fade",
        centeredSlides: true,
        followFinger: false,
        navigation: {
          nextEl: `.dp-product-carousel-box .swiper-arrow-next`,
          prevEl: `.dp-product-carousel-box .swiper-arrow-prev`,
        },
        on: {
          slideChange: function () {
            if (topSwiper.oldRealIndex == this.realIndex) {
              return;
            }
            topSwiper.oldRealIndex = this.realIndex;

            if (this.realIndex > this.previousIndex || this.activeIndex < this.previousIndex) {
              topSwiper.direction = 'prev';
            } else {
              topSwiper.direction = 'next';
            }
          }
        }
      })

			if(window.innerWidth < 1024){
        const dpMBSwiper = new window.Swiper('.dp-product-carousel-box .mb-swiper', {
          loop: true,
          slidesPerView: 2,
          centeredSlides: true,
          followFinger: false,
          watchSlidesProgress: true,
          navigation: {
            nextEl: `.dp-product-carousel-box .swiper-arrow-next`,
            prevEl: `.dp-product-carousel-box .swiper-arrow-prev`,
          },
          pagination: {
            el: `.dp-product-carousel-box .slideshow-pagination`,
            clickable: true,
            bulletClass: 'slideshow-pagination-item',
            bulletActiveClass: 'active pagination-active',
            clickableClass: 'slideshow-pagination-clickable',
            modifierClass: 'slideshow-pagination-',
            renderBullet: function (index) {
              var paginationItem = '<span class="slideshow-pagination-item">';
              paginationItem = (index <= slideTotal) ? paginationItem +
                '<span class="pagination-separator"><span class="pagination-separator-loader"></span></span>' :
                paginationItem;
              paginationItem += '</span>';
              return paginationItem;
            },
          },
          on: {
            init: function () {
              let slide = this.slides.eq(0);
              slide.addClass('ani-slide-top');
            },
            transitionStart: function () {
              for (let i = 0; i < this.slides.length; i++) {
                let slide = this.slides.eq(i);
                slide.removeClass('ani-slide-top');
              }
            },
            transitionEnd: function () {
              let slide = this.slides.eq(this.activeIndex);
              slide.addClass('ani-slide-top');
            },
            setTranslate: function () {
              const slides = this.slides
              for (let i = 0; i < slides.length; i++) {
                const slide = slides.eq(i)
                const progress = slides[i].progress
                slide.transform('');
                slide.transform('scale(' + (1 - Math.abs(progress) / 3) + ')');
              }
            },
            setTransition: function (transition) {
              for (let i = 0; i < this.slides.length; i++) {
                const slide = this.slides.eq(i)
                slide.transition(transition);
              }
            }
          }
        })

        // 上下两个Swiper切换联动
        let topSwiperCount = 0; // 上部Swiper切换次数计数
        let bottomSwiperCount = 0; // 下部Swiper切换次数计数
        dpPCSwiper.on('slideChange', function () {
          if (bottomSwiperCount > 0) {
            return;
          }
          topSwiperCount++;
          if (topSwiperCount === 1) {
            if (topSwiper.direction === 'prev') {
              dpMBSwiper.slidePrev();
            } else if (topSwiper.direction === 'next') {
              dpMBSwiper.slideNext();
            }
          }
          topSwiperCount = 0;
        })

        dpMBSwiper.on('slideChange', function () {
          if (topSwiperCount > 0) {
            return;
          }
          bottomSwiperCount++
          if (bottomSwiperCount === 1) {
            dpPCSwiper.slideToLoop(dpMBSwiper.realIndex);
          }
          bottomSwiperCount = 0;
        })
			}
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCarousel);
    } else {
      initCarousel();
    }
  })();
</script>
