<style>
    .ces_steps_container {
        position: relative;
        height: 43.59375vw;
        background: rgb(255, 255, 255);
        align-items: center;
        justify-content: center;
    }
    .ces_steps_container img {
        position: absolute;
    }
    .ces_step_lt {
        width: 25.416666vw;
        top: 3.958vw;
        left: 0;
    }
    .ces_step_lb {
        left: 0;
        width: 36.40625vw;
        top: 18.33333vw;
    }
    .ces_step_rt {
        width: 21.19791vw;
        top: 2.6302vw;
        right: 0;
    }
    .ces_step_rb {
        width: 23.385vw;
        right: 0;
        top: 16.6354vw;
    }

    .ces_step_main {
        width: 30.88541666vw;
        position: relative;
    }
    .ces_step_main_line {
        gap: 2.0833333vw;
    }
    .ces_step_main_item {
        flex: 1;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        text-align: center;
        padding: 0 0.83333vw;
    }
    .ces_step_main_item img {
        width: 4.270833vw;
        height: 4.270833vw;
        position: relative;
        margin-bottom: 2px;
    }
    .ces_step_main_item h3 {
        color: rgb(71, 71, 71);
        font-weight: 600;
        font-size: 0.83333vw;
        margin-bottom: 0.4vw;
    }
    .ces_step_main_item .z-button-middle {
        background: rgb(80, 173, 92);
        font-size: 0.78125vw;
        height: 1.875vw;
        padding: 0.625vw 0.6vw;
    }
    .ces_step_main_item p:not(.p p) {
        font-weight: 400;
        color: rgb(71, 71, 71);
        font-size: 12px;
        margin-bottom: 0.4vw;
    }
    .ces_step_main_item h2 {
        font-weight: 600;
        font-size: 2.083333vw;
        line-height: 2.8645833vw;
        color: rgb(82, 82, 82);
        max-width: 8.8vw;
        word-break: normal!important;
        display: flex;
        justify-content: center;
    }
    .ces_step_main_arror {
         flex: 1;
         align-items: center;
         justify-content: center;
    }
    .ces_step_main_arror_t {
        transform: translateY(50%);
    }
    .ces_step_main_arror_l {
        transform: translateX(50%) rotate(-90deg);
    }
    .ces_step_main_arror_r {
        transform: translateX(-50%) rotate(90deg);
    }
    .ces_step_main_arror_b {
        transform: translateY(-50%) rotate(180deg);
    }
    .ces_step_main_arror svg {
        width: 7.291666vw;
        height: 2.03125vw;
    }


    /* modal */
    details-disclosure .ces_step_modal summary {
        height: auto;
    }
    details-disclosure.ces_step_modal_m {
        height: auto;
    }
    details-disclosure.ces_step_modal_m>details {
        position: unset;
    }
    details-disclosure.ces_step_modal_m .list-menu--disclosure {
        top: 0;
        min-height: 100%;
        right: 0;
        left: 0;
        transform: unset;
        z-index: 9;
        opacity: 0;
        transition: all .3s ease;
        border-radius: 1.041666vw;
        overflow: hidden;
    }
    details-disclosure.ces_step_modal_m details[open] .list-menu--disclosure {
        opacity: 1;
        flex-direction: column;
    }
    details-disclosure.ces_step_modal_m .list-menu--disclosure img {
        width: 100%;
        height: 50%;
        flex:1;
        object-fit: cover;
        position: relative;
    }
    details-disclosure.ces_step_modal_m .list-menu--disclosure .p li::marker {
        color: var(--primary-color);
    }
    details-disclosure.ces_step_modal_m .list-menu--disclosure .p li {
        list-style: disc;
    }
    details-disclosure.ces_step_modal_m .list-menu--disclosure .p {
        padding: 1.875vw 2.08333vw 0 2.083333vw;
        font-size: 1.041666vw;
        line-height: 1.5625vw;
        color: rgb(82, 82, 82);
        flex:1;
        text-align: left;
    }
    details-disclosure.ces_step_modal_m .list-menu--disclosure span:not(.anticon-close) {
        padding: 40px 2.08333vw 20px 2.083333vw;
        font-size: 12px;
        line-height: 1.1;
        color: #A3A3A3;
        flex:1;
        text-align: left;
    }


    @media screen and (max-width: 1024px) {
        details-disclosure.ces_step_modal_m .list-menu--disclosure .p ul {
            padding-left: 16px;
        }
        .ces_steps_container {
            height: auto;
        }
        .ces_step_lt, .ces_step_lb, .ces_step_rt, .ces_step_rb {display: none;}

        .ces_step_main {
            width: 88vw;
        }
        .ces_step_main_line {
            gap: 4px;
        }
        .ces_step_main_item {
            flex: unset;
            align-items: flex-start;
            text-align: left;
            justify-content: space-between;
            padding: 2.34558vw 1.86vw;
            background: rgb(80, 173, 92);
            border-radius: 4.65116vw;
            width: 34.8vw;
        }
        .ces_step_main_item img {
            width: 12.093vw;
            height: 12.093vw;
        }
        .ces_step_main_item h3 {
            color: #ffffff;
            font-size: 14px;
            margin-bottom: 2px;
        }
        .ces_step_main_item .z-button-middle {
            background: #ffffff;
            padding: 0;
            position: relative;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            font-size: 0;
        }
        .ces_step_main_item .z-button-middle::before {
            position: absolute;
            content: "";
            height: 14px;
            width: 3px;
            background: rgb(80, 173, 92);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        .ces_step_main_item .z-button-middle::after {
            content: "";
            position: absolute;
            width: 14px;
            height: 3px;
            background: rgb(80, 173, 92);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        .ces_step_main_item p:not(.p p) {
            color: #ffffff;
            font-size: 12px;
        }
        .ces_step_main_item h2 {
            font-size: 5.116vw;
            line-height: 1.1;
        }
        .ces_step_main_arror {
            flex: 1;
            align-items: flex-end;
            justify-content: center;
        }
        .ces_step_main_arror svg {
            width: 12.3255vw;
            height: auto;
        }
        .ces_step_main_line_middle {
            height: 20vw;
        }
        .ces_step_main_item_center {
            background: #fff;
            width: 26.465vw;
            justify-content: center;
            align-items: center;
            text-align: center;
            font-size: 5.116vw;
        }
        .ces_step_main_arror_t {
            transform: translateY(-200%);
        }
        .ces_step_main_arror_l {
            transform: translateX(0%) rotate(-90deg);
        }
        .ces_step_main_arror_r {
            transform: translateX(0%) rotate(90deg);
        }
        .ces_step_main_arror__b {
            align-items: flex-start;
        }
        .ces_step_main_arror_b {
            transform: translateY(200%) rotate(180deg);
        }

        details-disclosure.ces_step_modal_m>details, details-disclosure.ces_step_modal_m {
            width: 100%;
        }
        details-disclosure .ces_step_modal summary {
            width: 100%;
            justify-content: flex-end;
        }
        details-disclosure.ces_step_modal_m .list-menu--disclosure .p {
            padding: 6px;
            font-size: 14px;
            line-height: 1.15;
            flex:1;
        }

        details-disclosure.ces_step_modal_m .list-menu--disclosure span:not(.anticon-close) {
            padding: 20px 2.08333vw 10px 2.083333vw;
            font-size: 2.325vw;
        }
    }
</style>

