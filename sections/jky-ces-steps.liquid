                                    <button style="position: absolute;display: flex; top: 20px;right: 20px;" class="jky-image-preview-close absolute"><span style="line-height: 0;" role="img" aria-label="close" class="anticon anticon-close"><svg fill-rule="evenodd" viewBox="64 64 896 896" focusable="false" data-icon="close" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path d="M799.86 166.31c.02 0 .04.02.08.06l57.69 57.7c.04.03.05.05.06.08a.12.12 0 010 .06c0 .03-.02.05-.06.09L569.93 512l287.7 287.7c.04.04.05.06.06.09a.12.12 0 010 .07c0 .02-.02.04-.06.08l-57.7 57.69c-.03.04-.05.05-.07.06a.12.12 0 01-.07 0c-.03 0-.05-.02-.09-.06L512 569.93l-287.7 287.7c-.04.04-.06.05-.09.06a.12.12 0 01-.07 0c-.02 0-.04-.02-.08-.06l-57.69-57.7c-.04-.03-.05-.05-.06-.07a.12.12 0 010-.07c0-.03.02-.05.06-.09L454.07 512l-287.7-287.7c-.04-.04-.05-.06-.06-.09a.12.12 0 010-.07c0-.02.02-.04.06-.08l57.7-57.69c.03-.04.05-.05.07-.06a.12.12 0 01.07 0c.03 0 .05.02.09.06L512 454.07l287.7-287.7c.04-.04.06-.05.09-.06a.12.12 0 01.07 0z"></path></svg></span></button>
                                    <img src="{{item.settings.bg_img | image_url: width: 1180}}" alt="{{item.settings.bg_img.alt}}" loading="lazy" width="593" height="262" />
                                    <div class="p">{{item.settings.des}}</div>

                                    <span>{{item.settings.tips}}</span>
                                </ul>
                            </details>
                        </details-disclosure>
                    </div>
                {% endif %}
            </div>
    </div>
</div>

<script async>
    (function () {
      function initCesSteps() {
        function _scrollToTop(element, distance = 150) {
            if(!element) return;
            const rect = element.getBoundingClientRect();
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            const targetPosition = rect.top + scrollTop - distance;
            window.scrollTo({ top: targetPosition, behavior: 'smooth' });
        }
        document.querySelectorAll(".ces_step_modal_m .z-button-middle").forEach((btn) => {
          btn.addEventListener('click', function () {
            _scrollToTop(document.querySelector(".ces_step_main"), 120)
          })
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCesSteps);
      } else {
        initCesSteps();
      }
      document.querySelectorAll(".ces_step_modal_m .jky-image-preview-close").forEach((btn) => {
        btn.addEventListener('click', function () {
          const details = btn.closest('details');
          if (details) details.removeAttribute('open');
        });
      });
    })();
</script>

{% schema %}
  {
    "name": "JKY CES STEPS",
    "class": "section jky-ces-steps jky-ces-pre",
    "enabled_on": {
      "templates": ["page"]
    },
    "settings": [
        {"type": "text", "id": "title", "label": "Heading"},
        {"type": "image_picker", "id": "lt_img", "label": "Background 左上"},
        {"type": "image_picker", "id": "lb_img", "label": "Background 左下"},
        {"type": "image_picker", "id": "rb_img", "label": "Background 右下"},
        {"type": "image_picker", "id": "rt_img", "label": "Background 右上"}
    ],
    "blocks": [{
        "type": "steps", "name": "CES step", "limit": 4,
        "settings": [
            {"type": "text", "id": "title", "label": "Heading"},
            {"type": "textarea", "id": "subtitle", "label": "Sub heading"},
            {"type": "textarea", "id": "tips", "label": "Tips"},
            {"type": "text", "id": "linktext", "label": "Link text", "default": "Learn More"},
            {"type": "image_picker", "id": "bg_img", "label": "Background IMG"},
            {"type": "richtext", "id": "des", "label": "Details"}
        ]
    }],
    "presets": [{
        "name": "CES steps"
    }]
  }
{% endschema %}
