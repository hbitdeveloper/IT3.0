
<div class="benefits-collection-registration-benefits jky-12th-membership !pb-0" anchor-target="{{ section.settings.anchor | escape }}"  style="background-color: {{ section.settings.outer_bg_color }};">
    <div class="section-container-lg py-[0.78rem] lg:py-[1.25rem]">
        <div class="membership rounded-[0.75rem] lg:rounded-xl" style="background: {{ section.settings.bg_color }};">
            <div style="color: {{ section.settings.text_color }};" class="bc-title mx-auto w-[19.9375rem] lg:w-[76.5rem] font-medium text-[1.25rem] leading-[1.75rem] lg:text-[2rem] lg:leading-10 text-{{ section.settings.alignment }} pt-[1.25rem] lg:pt-[2.375rem] mb-[0.5rem] lg:mb-2">{{ section.settings.title | escape }}</div>
            <div style="color: {{ section.settings.text_color }};"  class="bc-subtitle mx-auto w-[19.9375rem] lg:w-[76.5rem] mb-[1.5rem] lg:mb-0 font-medium lg:font-normal text-[0.875rem] leading-[1.375rem] lg:text-lg lg:leading-[1.625rem] text-{{ section.settings.alignment }}">{{ section.settings.sub_title | escape }}</div>
            <div class="jky-up content !justify-start !p-0 " style="background: {{ section.settings.bg_color }};">
                <div class="pc-list ">
                    <div class="icons lg:px-[1.375rem]">
                      <div class="icon-list">
                        {% for item in section.blocks %}
                            <div class="icon-item">
                                {%- assign val = forloop.index  | modulo: 2 -%}
                                {% assign color = '<em style="color: ' | append: item.settings.color | append: '">' %}
                                {% assign info_color = '<em style="color: ' | append: item.settings.info_color | append: '">' %}
                                {% if val == 0  %}
                                    {% render "benefits-collection-registration-benefits-text", settings: item.settings, emphasis_color: color, emphasis_info_color: info_color, text_color: section.settings.text_color %}
                                {% else %}
                                    {% render 'responsive-image', image_class: 'icon', image: item.settings.icon %}
                                {% endif %}
                                <img class="gift" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/gift_d5a1a9e5-acf9-4212-9d5a-9ca57ea086c2.png?v=1726740645" alt="">
                            </div>
                        {% endfor %}
                      </div>
                      <div class="icon-list second-list">
                        {% for item in section.blocks %}
                            <div class="icon-item">
                                {%- assign val = forloop.index | modulo: 2 -%}
                                {% assign color = '<em style="color: ' | append: item.settings.color | append: '">' %}
                                {% assign info_color = '<em style="color: ' | append: item.settings.info_color | append: '">' %}
                                {% if val == 0  %}
                                    {% render 'responsive-image', image_class: 'icon', image: item.settings.icon %}
                                {% else %}
                                    {% render "benefits-collection-registration-benefits-text", settings: item.settings, emphasis_color: color, emphasis_info_color: info_color, text_color: section.settings.text_color %}
                                {% endif %}
                            </div>
                        {% endfor %}
                      </div>
                    </div>
                </div>
                <div class="mobile-list">
                    <div class="icons">
                        {% for item in section.blocks %}
                        <div class="icon-item">
                            <div class="img-list">
                                {% render 'responsive-image', image_class: 'icon', image: item.settings.icon %}
                                <img class="gift" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/gift_d5a1a9e5-acf9-4212-9d5a-9ca57ea086c2.png?v=1726740645" alt="GIFT">
                            </div>
                            {% assign color = '<em style="color: ' | append: item.settings.color | append: '">' %}
                            {% assign info_color = '<em style="color: ' | append: item.settings.info_color | append: '">' %}
                            {% render "benefits-collection-registration-benefits-text", settings: item.settings, emphasis_color: color, emphasis_info_color: info_color, text_color: section.settings.text_color %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {%- unless customer.id -%}
                    <button class="jky-12th-btn bg-[var(--jds-color-primary)] mb-[1.5rem] lg:mb-[2.5rem]"
                        data-ga-event="promo_collection_user_clicks"
                        data-ga-action="click"
                        data-ga-params-module="LoginSection"
                        data-ga-params-position="{{ section.settings.title }}"
                        data-ga-params-button_name="{{ section.settings.button_text }}"
                    ><span>{{ section.settings.button_text | escape }}</span></button>
                {%- endunless -%}

            </div>
        </div>
    </div>
</div>

{% schema %}
{
