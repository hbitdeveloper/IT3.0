            "description": "<p>Get $200 Discount upon your first registration</p>"
          }
        },
        {
          "type": "benefit-scene",
          "settings":{
            "icon": "shopify://shop_images/12_39ec0f88-7d29-4268-a15a-eee50a64111a.png",
            "description": "<p>Get $200 Discount upon your first registration</p>"
          }
        },
        {
          "type": "benefit-scene",
          "settings":{
            "icon": "shopify://shop_images/12_39ec0f88-7d29-4268-a15a-eee50a64111a.png",
            "description": "<p>Get $200 Discount upon your first registration</p>"
          }
        }
      ]
