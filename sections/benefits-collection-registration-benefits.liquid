    },
    {
      "type": "color",
      "id": "outer_bg_color",
      "label": "外层背景颜色",
      "default": "#fcedda"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "背景颜色",
      "default": "linear-gradient(#2B2A2A 0%, #2F2E2E 100%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文案颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Registration Benefit"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "小标题",
      "default": "Register as Jackery's membership,unlock premium benefits."
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "标题对齐方式",
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文案",
      "default": "Login/Register"
    }
  ],
  "blocks": [
    {
      "type": "benefit-scene",
      "name": "福利场景",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "图标",
          "info": "大小: 100*100"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "标题",
          "info": "请精简文案，最多不可超过130个字符"
        },
        {
          "type": "color",
          "id": "color",
          "label": "标题高亮颜色",
          "info": "斜体高亮",
          "default": "#fd5000"
        },
        {
          "type": "richtext",
          "id": "info_text",
          "label": "说明文案"
        },
        {
          "type": "color",
          "id": "info_color",
          "label": "说明文案高亮颜色",
          "info": "斜体高亮",
          "default": "#fd5000"
        }
      ]
    }
  ]
}
{% endschema %}
