<style>
  {% if section.settings.slide_height == 'fixed_height' %}
    .shopify-section.slide-swiper .slide-swiper-container {
      height: 33.3333333333333vw;
    }
    @media screen and (min-width: 1024px) {
      .shopify-section.slide-swiper .slide-swiper-container .slide-image {
        background-size: contain;
      }
    }
  {% endif %}
  @media screen and (max-width: 1024px) {
    {% if section.settings.mb_slide_height == 'fixed_height' %}
      .shopify-section.slide-swiper .slide-swiper-container {
        height: 107vw;
      }
    }
  {% endif %}
</style>

<div
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
  class="swiper-container slideshow slide-swiper-container">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      {%- assign img_url = block.settings.image | image_url: width: 2000 -%}
      {%- assign m_img_url = block.settings.m_image | image_url: width: 750 -%}
      {%- assign banner_icon = block.settings.banner_icon | image_url: width: 200 -%}

      {%- assign isshow = true -%}
      {%- if block.settings.begin_time != blank or block.settings.begin_time != '' -%}
        {%- assign time_now = 'now' | date: '%s' -%}
        {%- assign begin_time_str = block.settings.begin_time | date: '%s' -%}
        {%- if begin_time_str > time_now -%}
          {%- assign isshow = false -%}
        {%- endif -%}
      {%- endif -%}

      {%- if isshow == true -%}
      <div class="swiper-slide slide btn-link cursor-pointer" data-index="{{ forloop.index }}" data-link="{{block.settings.link}}" data-new="{{block.settings.open_new}}">
        {% if forloop.index == 1 %}
          <picture>
            <source media="(min-width: 1024px)" srcset="{{img_url}}">
            <img class="slide-image absolute fade-slide" src="{{m_img_url}}" alt="{{ block.settings.title}}">
          </picture>
        {% else %}
          <picture>
            <source media="(min-width: 1024px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                    data-srcset="{{img_url}}">
            <img class="slide-image absolute fade-slide swiper-lazy" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                 data-src="{{m_img_url}}" alt="{{ block.settings.title}}">
          </picture>
        {% endif %}

        <div class="index-container absolute btn-link cursor-pointer" data-index="{{ forloop.index }}" data-new="{{block.settings.open_new}}" data-link="{{block.settings.link}}">
          <div class="slide-content absolute {{ block.settings.desktop_content_position }}">
            <div class="text-wrapper">
              {% comment %} SEO需求让如此处理(需求链接：http://192.168.30.126:8080/zentao/task-view-425.html)，有问题找产品(余姿璇or熊杰) {% endcomment %}
              {% if block.settings.hide_button != true and block.settings.link %}
                <a class="slide-title jky-text-3xl text-inner font-bold {% if settings.jky_theme_version != 'v4' %}v5-font-oxm{% endif %}" {% if block.settings.heading_color != blank %}style="color: {{block.settings.heading_color}}"{% endif %}href="{{ block.settings.link }}" {% if block.settings.open_new %} target="_blank"{% endif %}>{{ block.settings.title | newline_to_br }}</a>
              {% else %}
                <span class="slide-title jky-text-3xl text-inner font-bold {% if settings.jky_theme_version != 'v4' %}v5-font-oxm{% endif %}" {% if block.settings.heading_color != blank %}style="color: {{block.settings.heading_color}}"{% endif %}>{{ block.settings.title | newline_to_br }}</span>
              {% endif %}
              {% if block.settings.subtitle != blank %}
                <div class="sub-heading jky-text-lg font-400 text-inner" {% if block.settings.heading_color != blank %}style="color: {{block.settings.heading_color}}"{% endif %}>{{ block.settings.subtitle | newline_to_br }}</div>
              {% endif %}
            </div>

            {% if block.settings.hide_button != true %}
              <div class="text-wrapper">
                <a
                  class="z-button-big text-inner btn-view-more"
                  data-link="{{ block.settings.link }}"
                  data-type="btn-view-more"
                  data-index="{{ forloop.index }}"
                  data-new="{{block.settings.open_new}}"
                  data-analytics-title="{{ block.settings.title | replace: '/n', '' }}">{{ 'general.action_text.view_more' | t }}
                  <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
                </a>
              </div>
            {% endif %}
          </div>

          {% if block.settings.banner_icon != blank %}
            {% render 'responsive-image', image: block.settings.banner_icon, mimage: block.settings.banner_icon, image_class: 'banner-icon absolute left-0 bottom-0' %}
          {% endif %}
        </div>
      </div>
      {%- endif -%}
    {% endfor %}
  </div>

  <div class="slideshow-pagination"></div>


  {% if section.settings.xinren_icon != blank %}
    <style>
      .shopify-section.slide-swiper .slide-swiper-container {
        {% if section.settings.slide_height == 'fixed_height' %}
          height: calc(33.3333333333333vw + 100px) !important;
        {% else %}
          height: calc(100vw * 890 / 1920 + 100px);
        {% endif %}
      }
      .shopify-section.slide-swiper .swiper-wrapper {
        height: calc(100% - 100px);
      }
      .shopify-section.slide-swiper .slideshow-pagination {
        bottom: 127px;
      }

      .bottom__icon {
        height: 100px;
      }
      .bottom__icon picture {
        height: 68px;
        text-align: center;
        max-width: 90%;
      }
      .bottom__icon img {
        height: 68px;
        object-fit: contain;
      }

      @media screen and (max-width: 1024px) {
        .shopify-section.slide-swiper .slide-swiper-container {

          {% if section.settings.mb_slide_height == 'fixed_height' %}
            height: calc(100px + 107vw) !important;
          {% else %}
            height: calc(160vw + 100px);
          {% endif %}
        }
        .shopify-section.slide-swiper .swiper-wrapper {
          height: calc(100% - 100px);
        }
        .shopify-section.slide-swiper .slideshow-pagination {
          bottom: calc(9.5vw + 100px);
        }
        {% comment %}
          .bottom__icon {
            height: 50px;
          }
          .bottom__icon img {
            height: 34px;
          }
        {% endcomment %}
      }
    </style>

    <div class="bottom__icon flex justify-center items-center">
      {% render 'responsive-image', image: section.settings.xinren_icon, mimage: section.settings.m_xinren_icon, width: 580 %}
    </div>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Slide swiper",
    "tag": "section",
    "class": "section slide-swiper",
    "settings": [
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Auto-change slides",
        "default": true
      },
      {
        "type": "range",
        "id": "autoplay_speed",
        "label": "Change images every",
        "default": 7,
        "min": 5,
        "max": 10,
        "step": 1,
        "unit": "s"
      },
      {
        "type": "select",
        "id": "slide_height",
        "label": "PC Slide Height",
        "options": [
          {
            "value": "full_height",
            "label": "Full Height"
          }, {
            "value": "fixed_height",
            "label": "640px Height"
          }
        ],
        "default": "full_height"
      },
      {
        "type": "select",
        "id": "mb_slide_height",
        "label": "MB Slide Height",
        "options": [
          {
            "value": "full_height",
            "label": "Full Height"
          }, {
            "value": "fixed_height",
            "label": "800px Height"
          }
        ],
        "default": "full_height"
      }, {
        "type": "image_picker",
        "id": "xinren_icon",
        "label": "底部信任状"
      }, {
        "type": "image_picker",
        "id": "m_xinren_icon",
        "label": "mobile底部信任状"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Slide Banner",
        "settings": [
          {
            "type": "textarea",
            "id": "title",
            "label": "Heading",
            "default": "Two line\nslide title."
          },
          {
            "type": "textarea",
            "id": "subtitle",
            "label": "SubHeading",
            "default": "Sub heading"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Slide link"
          },
          {
            "type": "checkbox",
            "id": "open_new",
            "label": "新开标签？？",
            "default": false
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }, {
            "type": "image_picker",
            "id": "m_image",
            "label": "Mobile Image"
          }, {
            "type": "image_picker",
            "id": "banner_icon",
            "label": "Banner Icon Image"
          }, {
            "type": "color",
            "id": "heading_color",
            "label": "Heading color",
            "default": "#333333"
          }, {
            "type": "checkbox",
            "id": "hide_button",
            "default": false,
            "label": "隐藏按钮?"
          }, {
            "type": "select",
            "id": "desktop_content_position",
            "options": [
              {
                "value": "top-left",
                "label": "t:sections.image-banner.settings.desktop_content_position.options__1.label"
              },
              {
                "value": "top-center",
                "label": "t:sections.image-banner.settings.desktop_content_position.options__2.label"
              },
              {
                "value": "top-right",
                "label": "t:sections.image-banner.settings.desktop_content_position.options__3.label"
              },
              {
                "value": "middle-left",
                "label": "t:sections.image-banner.settings.desktop_content_position.options__4.label"
              }, {
                "value": "middle-center",
                "label": "t:sections.image-banner.settings.desktop_content_position.options__5.label"
              }, {
                "value": "middle-right",
                "label": "t:sections.image-banner.settings.desktop_content_position.options__6.label"
              }, {
                "value": "bottom-left",
                "label": "t:sections.image-banner.settings.desktop_content_position.options__7.label"
              }, {
                "value": "bottom-center",
                "label": "t:sections.image-banner.settings.desktop_content_position.options__8.label"
              }, {
                "value": "bottom-right",
                "label": "t:sections.image-banner.settings.desktop_content_position.options__9.label"
              }
            ],
            "default": "top-right",
            "label": "Heading position"
          }, {
              "type": "text", "id": "begin_time", "label": "开始时间",
              "info": "rules is matter, YYYY/MM/DD hh:mm:ss, such as: 2022/05/06 00:00:00; 不设置即立即生效"
          }
        ]
      }
    ]
  }
{% endschema %}
