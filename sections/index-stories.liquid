<div class="index-stories {% if section.settings.types == 'embed' %}embed-component{% endif %}" data-handle="{{ section.settings.handle }}">
    <div class="new-main-container">
        <div class="stories">
            <div class="module-title">
                <div class="title"> <span class="jky-slideup">{{ section.settings.module_title | escape}}</span></div>
                <div class="right-button-box">
                    {% if section.settings.share_button_text != blank and section.settings.share_url != blank %}
                        <a href="{{ section.settings.share_url }}" target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" class="pc-block share-btn">
                            <button class="index-button">
                                <span>{{ section.settings.share_button_text | escape}}</span>
                                <div>
                                    <div class="arrow">
                                        <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                <g class="svg-arrow" transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                                    <g transform="translate(672.000000, 286.000000)">
                                                        <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                                    </g>
                                                </g>
                                            </g>
                                        </svg>
                                    </div>
                                </div>
                            </button>
                        </a>
                    {% endif %}
                    {%- if section.settings.button_text != blank -%}
                        <a
                          data-ga-event="home_page_user_stories4.0"
                          data-ga-action="click"
                          data-ga-params-module="{{ section.settings.module_title | escape }}"
                          data-ga-params-button_name="{{ section.settings.button_text | escape}}"
                          data-ga-params-link="{{section.settings.url }}"
                          data-ga-params-type="User stories"
                          class="pc-block" target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ section.settings.url }}">
                            <button class="index-button">
                                <span>{{ section.settings.button_text | escape}}</span>
                                <div>
                                    <div class="arrow">
                                        <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                <g class="svg-arrow" transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                                    <g transform="translate(672.000000, 286.000000)">
                                                        <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                                    </g>
                                                </g>
                                            </g>
                                        </svg>
                                    </div>
                                </div>
                            </button>
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="swiper stories-swiper">
                <div class="swiper-wrapper">
                    {% for item in section.blocks %}
                        <div class="swiper-slide">
                            <a
                              data-ga-event="home_page_user_stories4.0"
                              data-ga-action="click"
                              data-ga-params-module="{{ section.settings.module_title | escape }}"
                              data-ga-params-position="{{item.settings.title}}"
                              data-ga-params-link="{{ item.settings.url }}"
                              data-ga-params-type="User stories"
                              target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ item.settings.url }}">
                                <div class="content">
                                    <div class="image">
                                        {% render 'responsive-image',image_class:'story-item-img', image: item.settings.pc_image,width: 256, mimage: item.settings.mb_image,mwidth:600 %}
                                        {%- if item.settings.label != blank -%}
                                            <div class="label">
                                                <div>{{ item.settings.label | escape }}</div>
                                            </div>
                                        {%- endif -%}

                                    </div>
                                    <div class="info">
                                        <div class="writer ellipsis">{{ item.settings.author | escape }}</div>
                                        <div class="title text-overflow-2">{{ item.settings.title | escape }}</div>
                                        <div class="sub-title text-overflow-2">{{ item.settings.sub_title }}</div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    {% endfor %}
                </div>
                <div class="mb-pagination stories-pagination"></div>
            </div>
            <div class="view-more">
                {% if section.settings.share_button_text != blank and section.settings.share_url != blank %}
                    <a class="mobile-block" target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ section.settings.share_url }}">
                        <button class="index-button" >
                            <span>{{ section.settings.share_button_text | escape}}</span>
                        </button>
                    </a>
                {%- endif -%}
                {%- if section.settings.button_text != blank -%}
                    <a
                      data-ga-event="home_page_user_stories4.0"
                      data-ga-action="click"
                      data-ga-params-module="{{ section.settings.module_title | escape }}"
                      data-ga-params-button_name="{{ section.settings.button_text | escape}}"
                      data-ga-params-link="{{section.settings.url }}"
                      data-ga-params-type="User stories"
                      class="mobile-block" target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ section.settings.url }}">
                        <button class="index-button" >
                            <span>{{ section.settings.button_text | escape}}</span>
                        </button>
                    </a>
                {%- endif -%}
            </div>
        </div>
    </div>
</div>


{% schema %}
{
    "name": "首页-用户故事",
    "disabled_on": {
        "templates": ["collection"]
    },
    "settings": [
        {"type": "select", "id": "types", "label": "类型", "default": "independent",
            "options": [
                {
                "value": "embed",
                "label": "内嵌使用"
                },
                {
                "value": "independent",
                "label": "独立使用"
                }
            ]
        },
        { "type": "text", "id": "handle","label": "Handle（当前页面唯一的handle）", "default": "embed-component-01" },
        { "type": "text", "id": "module_title", "label": "模块标题(必填)" },
        { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false },
        { "type": "text", "id": "button_text", "label": "按钮文案" },
        { "type": "url", "id": "url", "label": "跳转地址" },
        { "type": "text", "id": "share_button_text", "label": "分享按钮文案" },
        { "type": "url", "id": "share_url", "label": "分享跳转地址" }
    ],

    "blocks": [
        {
            "type": "block",
            "name": "用户故事",
            "settings": [
                { "type": "text", "id": "label", "label": "场景标签" },
                { "type": "text", "id": "author", "label": "作者(必填)" },
                { "type": "text", "id": "title", "label": "故事标题(必填)", "info": "不超过20字符" },
                { "type": "textarea", "id": "sub_title", "label": "描述(必填)", "info": "不超过60字符" },
                { "type": "url", "id": "url", "label": "跳转地址(必填)" },
                { "type": "image_picker", "id": "pc_image", "label": "PC 图片(必填)", "info": "大小: 256*332"},
                { "type": "image_picker", "id": "mb_image", "label": "MB 图片(必填)", "info": "大小: 600*640" }
            ]
        }
    ],
    "max_blocks": 5,
    "presets": [
        {
            "name": "首页-用户故事",
            "settings": {
                "module_title": "Jackery Stories",
                "new_window": false,
                "button_text": "View More Stories"
            },
            "blocks": [
                {
                    "type": "block",
                    "settings": {
                        "label": "Camping",
                        "author": "Joe Sener",
                        "title": "Never run out of Power",
                        "sub_title": "Harness solar energy and power up your devices even while campin"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
