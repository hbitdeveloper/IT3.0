{% comment %} about-jackery-component component of About-Us {% endcomment %}
{% schema %}
{
  "name": "About Jackery Component",
  "tag": "section",
  "class": "about-jackery-component",
  "settings": [
    {
      "type": "text",
      "id": "aboutTitle",
      "label": "About Jackery Title"
    },{
      "type": "html",
      "id": "aboutSubtitle",
      "label": "About Jackery Subtitle"
    },{
      "type": "image_picker",
      "id": "pcAboutImg",
      "label": "About Jackery Image (PC)"
    },
    {
      "type": "image_picker",
      "id": "mbAboutImg",
      "label": "About Jackery Image (Mobile)"
    }
  ]
}
{% endschema %}
<div class="about-jackery-box section-container">
    {% if section.settings.aboutTitle != blank%}
        <div class="about-jackery-title">{{ section.settings.aboutTitle }}</div>
    {% endif %}
    {% if section.settings.aboutSubtitle != blank%}
        <div class="about-jackery-subtitle">{{ section.settings.aboutSubtitle }}</div>
    {% endif %}
    {% render 'responsive-image',
            image: section.settings.pcAboutImg,
            mimage: section.settings.mbAboutImg,
            image_class: 'about-bottom-img'
    %}
</div>

