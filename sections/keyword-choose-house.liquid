{%- style -%}
  .section-keyword-choose-house {
    background: #ffffff;
    margin-bottom: 3.125vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }

  .keyword-choose-house-title {
    font-size: 2.3438vw;
    font-weight: 600;
    color: #000000;
    padding-bottom: 3.3854vw;
    text-align: center;
  }

  .keyword-choose-house-tabs {
    display: flex;
    justify-content: center;
  }

  .keyword-choose-house-tabs .tab-item {
    display: flex;
    margin-right: 0.2604vw;
    font-size: 1.25vw;
    font-weight: 500;
    color: #333333;
    height: 3.2292vw;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    background: #f5f5f5;
    flex: 1;
  }

  .keyword-choose-house-tabs .tab-active {
    background: var(--primary-color);
    color: #ffffff;
  }

  .keyword-choose-house-content {
    background: #f5f5f5;
    padding-left: 7.2917vw;
    margin-top: 0.3125vw;
  }
  .keyword-choose-house-content .kchc-subtitle {
    padding-top: 2.8646vw;
    padding-right: 3.9063vw;
    padding-bottom: 3.9063vw;
    font-size: 1.25vw;
    font-weight: 500;
    color: #333333;
    line-height: 1.875vw;
    word-wrap: break-word;
  }
  .keyword-choose-house-content .kchc-image {
    display: block;
    max-width: 100%;
  }

  .keyword-choose-house-content .kchc-image-m {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .section-keyword-choose-house {
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      padding-bottom: 11.3333vw;
    }

    .keyword-choose-house-title {
      font-size: 6vw;
      padding: 0 5.8667vw 5.3333vw 5.8667vw;
    }

    .keyword-choose-house-tabs {
      max-width: max-content;
      display: flex;
      flex-wrap: wrap;
    }

    .keyword-choose-house-tabs .tab-item {
      padding: 2.9333vw 9.0667vw;
      margin-right: 0.6667vw;
      margin-bottom: 0.6667vw;
      font-size: 3.4667vw;
      height: 100%;
      display: flex;
      flex: auto;
      max-width: -webkit-fill-available;
    }

    .keyword-choose-house-content .kchc-subtitle {
      padding: 5.0667vw 5.6vw 5.4667vw 5.4667vw;
      font-size: 3.2vw;
      line-height: 4.8vw;
      word-wrap: break-word;
    }

    .keyword-choose-house-content {
      padding-left: 0;
    }

    .keyword-choose-house-content .kchc-image {
      display: none;
    }

    .keyword-choose-house-content .kchc-image-m {
      max-width: 100%;
      display: block;
    }
  }

  .keyword-choose-house-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .keyword-choose-house-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .keyword-choose-house-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }
  }
{%- endstyle -%}
<h2 class="keyword-choose-house-title {% if template contains 'product' %} section-container{% endif %}" anchor="{{ section.settings.anchor | escape }}"
  style="
  --pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
  --pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
  "
  >{{ section.settings.title | escape }}</h2>
{%- if section.settings.sub != blank -%}
  <div class="keyword-house-sub keyword-sub">{{ section.settings.sub }}</div>
{%- endif -%}
<div class="keyword-choose-house-tabs {% if template contains 'product' %} section-container{% endif %}">
  {% for block in section.blocks %}
    <h3 class="tab-item {% if forloop.index0 == 0 %} tab-active {%endif%}">
      {{ block.settings.tab_title | escape }}
    </h3>
  {% endfor %}
</div>
<div class="swiper choose-house-swiper-main {% if template contains 'product' %} section-container{% endif %}">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="swiper-slide swiper-no-swiping keyword-choose-house-content">
        <div class="kchc-subtitle pc-block">
          {{ block.settings.content }}
        </div>

        <div class="kchc-subtitle mobile-block">
          {% if block.settings.content_mb != blank %}
            {{ block.settings.content_mb }}
          {% else %}
            {{ block.settings.content }}
          {% endif %}
        </div>

        <img
          class="kchc-image"
          src="{{ block.settings.image | image_url: width: 3000 }}"
          alt="{{ block.settings.image.alt }}" loading="lazy"
        >
        <img
          class="kchc-image-m"
          src="{{ block.settings.m_image | image_url: width: 750 }}"
          alt="{{ block.settings.m_image.alt }}" loading="lazy"
        >
      </div>
    {% endfor %}
  </div>
</div>
<script type="module">
  function keywordChooseHouseInit() {
    const swiperContainer = document.querySelector('.choose-house-swiper-main');
    var swiper = new Swiper(swiperContainer, {
      autoHeight: true,
    });
    const tabItems = document.querySelectorAll('.keyword-choose-house-tabs .tab-item');
    tabItems.forEach(function (val, i) {
      val.addEventListener('click', function () {
        swiper.slideTo(i, 1000, false);
      });
    });

    tabItems.forEach(function (tabItem) {
      tabItem.addEventListener('click', function (e) {
        tabItems.forEach(function (item) {
          item.classList.remove('tab-active');
        });
        e.target.classList.add('tab-active');
      });
    });
  }

  window.addEventListener('DOMContentLoaded', function () {
    keywordChooseHouseInit();
  });
</script>
{% schema %}
{
  "name": "Keyword Choose House",
  "class": "section-keyword-choose-house",
  "disabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },  
  { "type": "text", "id": "title", "label": "Title" }, { "type": "richtext", "id": "sub", "label": "SubTitle" },
  { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
  { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 40 },
  { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
  { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 }
  ],
  "blocks": [
    {
      "type": "choose-item",
      "name": "Choose Item",
      "settings": [
        { "type": "text", "id": "tab_title", "label": "Tab Title" },
        { "type": "richtext", "id": "content", "label": "Tab Content(PC)" },
        { "type": "richtext", "id": "content_mb", "label": "Tab Content(MB)" },
        { "type": "image_picker", "id": "image", "label": "Content image" },
        { "type": "image_picker", "id": "m_image", "label": "Content Mobile image" }
      ]
    }
  ],
  "presets": [{
      "name": "Keyword Choose House",
      "category": "Keyword"
  }]
}
{% endschema %}
