
<style>
  jky-smart-recommend:not(:defined) {
    opacity: 0;
    display: inline-block;
    min-height: 124.933333333333vw; /* 预估高度 */
  }
  @media screen and (min-width: 1024px) {
    jky-smart-recommend:not(:defined) {
      min-height: 45.5555555555556vw; /* 预估高度 */
    }
  }
  @media screen and (min-width: 1440px) {
    jky-smart-recommend:not(:defined) {
      min-height: 656px; /* 预估高度 */
    }
  }

  @media screen and (min-width: 1024px) {
    .product-compare-modal.modal-container.modal .modal-content{
      width: 66.6666666666667vw;
    }
  }
  @media screen and (min-width: 1440px) {
    .product-compare-modal.modal-container.modal .modal-content{
      width: 960px;
    }
  }
</style>

{% comment %} 加载 弹窗的样式 {% endcomment %}
<link rel="stylesheet" href="{{ 'section-jky-smart-recommend.min.css' | asset_url }}">

{% comment %} 多语言 片段 {% endcomment %}
{% render 'smart-recommend-4-json' %}
{% render 'user-feedback-json' %}

{% comment %} 智能选购 web-component {% endcomment %}
<jky-smart-recommend
  compare-id="{{ section.settings.compare_id }}"
  coupon-id="{{ section.settings.coupon_id }}"
  data-open-auto-discount-price="{{settings.open_auto_discount_price}}"
></jky-smart-recommend>

<script src="{{ 'section-jky-smart-recommend.min.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "Smart Recommend Plugin",
    "limit": 1,
    "settings": [
      {
        "type": "text",
        "id": "compare_id",
        "label": "产品对比ID",
        "info": "【第3步】，可能会涉及到产品对比功能，产品对比ID需要在这里配置。不配置则无法使用产品对比功能。"
      },
      {
        "type": "text",
        "id": "coupon_id",
        "label": "优惠券ID",
        "info": "【第5步】，Get My Offer功能，会发邮件，邮件内的优惠券ID需要在这里配置。如果邮件不需要优惠券，可以不配置"
      }
    ],
    "presets": [
      {
        "name": "Smart Recommend Plugin"
      }
    ]
  }
{% endschema %}
  