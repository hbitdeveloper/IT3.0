<style>
  .keyword-letter .five-main-container{
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }

  .keyword-letter .trust-letter-box .type-text{
    padding: 51px 0 74px;
  }
  .keyword-letter .trust-letter-box .type-img {
    padding: 51px 0 74px;
  }
  .keyword-letter .trust-letter-box .title {
    max-width: 1312px;
  }

  .keyword-letter .trust-letter-box .sec-title {
    max-width: 1312px;
  }

  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .keyword-letter .trust-letter-box .type-text{
      padding: 3.5416vw 0 5.13888vw;
    }

    .keyword-letter .trust-letter-box .type-img {
      padding: 3.5416vw 0 5.13888vw;
    }

    .keyword-letter .trust-letter-box .title {
      max-width:91.11111vw;
    }

    .keyword-letter .trust-letter-box .sec-title {
      max-width:91.11111vw;
    }
  }

  @media screen and (max-width: 1023.98px) {
    .keyword-letter .five-main-container{
      max-width: 91.466666vw;
    }

    .keyword-letter .trust-letter-box .title {
      max-width: unset;
    }

    .keyword-letter .trust-letter-box .sec-title {
      max-width: unset;
    }

    .keyword-letter .trust-letter-box .type-text{
      padding-top: 10.6666vw;
      padding-bottom: 10.6666vw;
    }

    .keyword-letter .trust-letter-box .type-img{
      padding-top: 10.6666vw;
      padding-bottom: 10.6666vw;
    }
  }
</style>

<div class="keyword-letter">
  {% render 'five-kwh-letter', letter: section.settings %}
</div>

{% schema %}
{
  "name": "Keyword Letter",
  "settings": [
    { "type": "color_background", "id": "bg-color", "label": "Background" },
    {
      "type": "select",
      "id": "letter-type",
      "label": "Letter Type",
      "default": "text",
      "options": [
        {
          "value": "text",
          "label": "text"
        },
        {
          "value": "img",
          "label": "image"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "pc-title",
      "label": "PC Title(必填)"
    },
    {
      "type": "richtext",
      "id": "mb-title",
      "label": "MB Title(必填)"
    },

    {
      "type": "text",
      "id": "sec-title1",
      "label": "Second Title1"
    },
    {
      "type": "text",
      "id": "sec-title2",
      "label": "Second Title2"
    },

    {
      "type": "color",
      "id": "title-color",
      "label": "Title Color",
      "default": "#fd5000"
    },

    {
      "type": "richtext",
      "id": "sub-title",
      "label": "SubTitle"
    },

    {
      "type": "color",
      "id": "sub-title-color",
      "label": "SubTitle Color"
    },

    {
      "type": "image_picker",
      "id": "pc-letter-img",
      "label": "PC Letter Image",
      "info": "大小: 1440x68"
    },
    {
      "type": "image_picker",
      "id": "mb-letter-img",
      "label": "MB Letter Image",
      "info": "大小: 675x144"
    }
  ],

  "presets": [
    {
      "name": "Keyword Letter",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
