{%- if section.settings.tabs_feature_video != blank or section.settings.tabs_video_poster != blank -%}
    <div  class="tabs-five-video section-container relative">
        <h2 class="product-title jky-text-2xl font-500">{{ section.settings.tabs_video_title }}</h2>
        {%- render 'jky-video', video_url: section.settings.tabs_feature_video, poster: section.settings.tabs_video_poster, title: product.title, class: section.id, autoplay: false, controls: true, loop: false -%}
    </div>
{%- endif -%}

{% schema %}
{
    "name": "product video tabs", "class": "tabs-five-video product-section-block", "tag": "div",
    "enabled_on": {
      "templates": ["product"]
    },
    "settings": [
        {"type": "text", "id": "tabs_video_title", "label": "Tabs Video title"},
        {"type": "url", "id": "tabs_feature_video", "label": "feature main video"},
        {"type": "image_picker", "id": "tabs_video_poster", "label": "feature video poster","info": "尺寸建议16：9 按照视频比例"}
    ],
    "presets": [{
        "name": "product video tabs"
    }]
}
{% endschema %}