{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

{% style %}
  .v5-story-comment .stories-post-comment .success-message {
    background: rgba(83, 196, 26, 0.1);
    border: 1px solid #53C41A;
    font-weight: 400;
    font-size: 1.25rem;
    color: #53C41A;
    line-height: 1.75rem;
    padding: 0.625rem 1rem;
    margin-top: 2.5rem;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .invalid .error-message {
    display: block !important;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .invalid input,
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .invalid textarea {
    border: 1px solid var(--jds-color-primary) !important;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group input::placeholder,
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group textarea::placeholder {
    color: rgba(0, 0, 0, 0.65);
  }
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group .required-box .required-star {
    color: var(--primary-color);
    font-weight: 400;
    font-size: 1.75rem;
    position: absolute;
    left: 0.875rem;
    top: 0;
    height: 3rem;
    line-height: 3.625rem;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group .field_error-tips {
    color: var(--jds-color-primary);
    font-weight: 500;
    margin-top: 0.25rem;
    font-size: 0.875rem;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group.error input,
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group.error textarea {
    border-color: #FF6B00;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group.error .error-message {
    display: block;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .form-item {
    min-height: 4.875rem;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .form-item input {
    border-radius: 0;
    border: 1px solid #C6C7C8;
    height: 3rem;
    padding: 0.75rem 0.75rem 0.75rem 2.25rem;
    font-size: 1rem;
    line-height: 1.5rem;
    color: #242F20;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .form-item textarea {
    border-radius: 0;
    border: 1px solid #C6C7C8;
    height: 10.1875rem;
    padding: 0.75rem 0.75rem 0.75rem 1rem;
    font-size: 1rem;
    line-height: 1.5rem;
    color: #242F20;
    overflow-y: auto;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .form-note,
  .v5-story-comment .stories-post-comment .post-comment-form .captcha-note {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: #242F20;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .captcha-note a {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .post-button::part(button) {
    border-radius: 0;
    background-color: #242F20;
    color: #FFF;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form .success-message {
    display: none;
    background: #E8F5E9;
    color: #2E7D32;
    padding: 0.75rem;
    margin-top: 1rem;
    font-size: 0.875rem;
  }
  .v5-story-comment .stories-post-comment .post-comment-form .comment-form.success .success-message {
    display: block;
  }
  .v5-story-comment .stories-comment {
    display: none;
    padding-top: 2rem;
    border-top: 1px solid #C6C7C8;
  }
  .v5-story-comment .stories-comment .comment-title {
    font-weight: 600;
    font-size: 2rem;
    color: #242F20;
    line-height: 2.25rem;
    text-align: left;
    margin-bottom: 2.5rem;
  }
  .v5-story-comment .stories-comment .comment-body {
    max-height: 30rem;
    height: fit-content;
    overflow-y: auto;
  }
  .v5-story-comment .stories-comment .comment-body .comment-items {
    display: flex;
    flex-direction: column;
    row-gap: 2.25rem;
  }
  .v5-story-comment .stories-comment .comment-body .comment-items .comment-item-left .comment-name {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    font-weight: 400;
    font-size: 1rem;
    color: #242F20;
    line-height: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .v5-story-comment .stories-comment .comment-body .comment-items .comment-item-left .comment-time {
    font-weight: 400;
    font-size: 1rem;
    color: rgba(0,0,0,0.65);
    line-height: 1.5rem;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  .v5-story-comment .stories-comment .comment-body .comment-items .comment-item-right {
    width: 100%;
    height: fit-content;
    font-weight: 400;
    font-size: 1rem;
    color: #242F20;
    line-height: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #C6C7C8;
  }
  @media screen and (max-width: 1023.98px) {
    .v5-story-comment .stories-comment {
      padding-top: 1rem;
      border-top: none;
    }
    .v5-story-comment .stories-comment .comment-title {
      font-size: 1.25rem;
      line-height: 1.875rem;
      margin-bottom: 1.5rem;
    }
    .v5-story-comment .stories-comment .comment-body {
      max-height: 26.5rem;
    }
    .v5-story-comment .stories-comment .comment-body .comment-items {
      display: flex;
      flex-direction: column;
      row-gap: 1rem;
    }
    .v5-story-comment .stories-comment .comment-body .comment-items .comment-item-left .comment-name {
      font-size: 0.875rem;
      line-height: 1.25rem;
      margin-bottom: 0.5rem;
    }
    .v5-story-comment .stories-comment .comment-body .comment-items .comment-item-left .comment-time {
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
    .v5-story-comment .stories-comment .comment-body .comment-items .comment-item-right {
      font-size: 0.875rem;
      line-height: 1.25rem;
      padding-bottom: 1.5rem;
      border-bottom: none;
    }
    .v5-story-comment .stories-post-comment .post-comment-title {
      font-size: 1.25rem;
      line-height: 1.875rem;
      margin: 1.875rem 0 1.25rem;
    }
    .v5-story-comment .stories-post-comment .success-message {
      padding: 10.25rem 0.75rem;
      font-weight: 400;
      font-size: 20.25rem;
      line-height: 1.375rem;
      margin: 0.75rem 0 1.25rem;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form .invalid .error-message {
      display: block !important;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form .invalid input,
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form .invalid textarea {
      border: 1px solid var(--jds-color-primary) !important;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group .required-box .required-star {
      font-size: 1.5rem;
      position: absolute;
      left: 0.875rem;
      top: 0;
      height: 2.5rem;
      line-height: 3rem;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group .field_error-tips {
      color: var(--jds-color-primary);
      margin-top: 0.125rem;
      font-size: 0.75rem;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group.error input,
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group.error textarea {
      border-color: #FF6B00;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form .form-group.error .error-message {
      display: block;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .form-item {
      min-height: 3.5rem;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .form-item input {
      height: 2.5rem;
      padding: 0.5rem 0.5rem 0.5rem 2.25rem;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .form-item textarea {
      height: 8.1875rem;
      padding: 0.5rem 0.75rem;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .form-note,
    .v5-story-comment .stories-post-comment .post-comment-form .captcha-note {
      font-size: 0.75rem;
      line-height: 1rem;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form .success-message {
      display: none;
      background: #E8F5E9;
      color: #2E7D32;
      padding: 0.375rem;
      border-radius: 4px;
      margin-top: 0.5rem;
      font-size: 0.4375rem;
    }
    .v5-story-comment .stories-post-comment .post-comment-form .comment-form.success .success-message {
      display: block;
    }
  }
{% endstyle %}

<div class="v5-story-comment jackery-stories-comment w-full section-padding flex flex-col gap-y-9 lg:gap-y-[3.5rem]" style="background-color:{{ section.settings.bg_color | default: '#FFFFFF' }};{{ style }}">
  <div class="section-container-lg stories-post-comment">
    <div class="w-full text-center text-2xl lg:text-5xl text-[#242F20] font-semibold mb-10 lg:mb-16 leading-[1.1]">{{ 'stories.comments.title' | t }}</div>
    <div class="w-full post-comment-form">
      <jky-form class="w-full" data-success-msg="{{ 'stories.comments.post_success' | t }}">
        <form data-action="/osconsumerapi/v1/comment/stories/add" class="w-full comment-form">
          <div class="hidden">
            <div class="form-item form-item_const" data-field="input">
              <input type="hidden" name="titleId" data-value="titleId" value="{{ page.id }}">
            </div>
            <div class="form-item form-item_const" data-field="input">
              <input type="hidden" name="titleName" class="titleName" data-value="titleName" value="{{ page.title | escape }}">
            </div>
          </div>
          <div class="flex flex-col lg:flex-row items-start justify-between gap-x-4">
            <div class="w-full flex-1 form-group form-item required relative" data-field="input">
              <input
                type="text"
                id="name"
                name="name"
                placeholder="{{ 'stories.comments.name_placeholder' | t }}"
                data-error="{{ 'stories.comments.name_error' | t }}"
                data-value="name"
                data-reg="name"
                data-regerror="{{ 'stories.comments.name_error' | t }}"
              >
              <div class="required-box">
                <div class="required-star">*</div>
              </div>
            </div>

            <div class="w-full flex-1 form-group form-item required relative" data-field="input">
              <input
                type="email"
                id="email"
                name="email"
                placeholder="{{ 'stories.comments.email_placeholder' | t }}"
                data-error="{{ 'stories.comments.email_error' | t }}"
                data-value="email"
                data-reg="email"
                data-regerror="{{ 'stories.comments.email_error' | t }}"
              >
              <div class="required-box">
                <div class="required-star">*</div>
              </div>
            </div>
          </div>

          <div class="form-group form-item required relative mb-2 lg:mb-3" data-field="textarea" data-value="comment" data-error="{{ 'stories.comments.message_error' | t }}">
            <textarea
              id="comment"
              name="comment"
              maxlength="2000"
              placeholder="{{ 'stories.comments.message_placeholder' | t }}"
            ></textarea>
          </div>
          
          <div class="flex flex-col gap-y-2">
            <div class="form-note">{{ 'stories.comments.moderated' | t }}</div>
            <div class="captcha-note">
              {% capture service_text %}
                {{ 'stories.comments.service_privacy' | t: service_link: settings.terms_url, privacy_link: settings.policy_url }}
              {% endcapture %}
              {{ service_text | strip | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" }}
            </div>
            <div class="w-full flex justify-end mt-4">
              <jds-button class="w-fit post-button form_sub_btn">{{ 'stories.comments.post_button' | t }}</jds-button>
            </div>
          </div>
        </form>
      </jky-form>
    </div>
  </div>
  <div class="section-container-lg stories-comment">
    <div class="comment-title" {% unless section.settings.show_comment_total %}style="display:none;"{% endunless %}>
      <span class="comment-num"></span>
      <span class="comment-name">{{ 'stories.comments.comment' | t }}</span>
    </div>
    <div class="comment-body flex flex-col gap-y-4 lg:gap-y-9" data-title-id="{{ page.id }}"></div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const titleName = document.querySelector("input[name='titleName']");
    titleName.value = document.querySelector("h2[data-story-title]")?.textContent?.trim?.() || '{{ page.title | escape }}';
  })
</script>
<script src="{{ 'section-stories-comment.min.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5-故事详情-评论",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    { "type": "header", "content": "PC边距" },
    { "type": "number", "id": "padding_top", "label": "PC上边距", "default": 96 },
    { "type": "number", "id": "padding_bottom", "label": "PC下边距", "default": 96 },

    { "type": "header", "content": "MB边距" },
    {
      "type": "select",
      "id": "mb_padding_type",
      "options": [
        {
          "value": "default",
          "label": "默认"
        },
        {
          "value": "custom",
          "label": "自定义"
        }
      ],
      "default": "default",
      "label": "MB边距"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 64,
      "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 64,
      "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
    },

    { "type": "header", "content": "基础设置" },
    { "type": "color_background", "id": "bg_color", "label": "版块背景色", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "show_comment_total", "label": "显示评论总数", "default": true }
  ],
  "presets": [
    {
      "name": "V5-故事详情-评论"
    }
  ]
}
{% endschema %}
