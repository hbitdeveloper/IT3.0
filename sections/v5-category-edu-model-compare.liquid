<style>
    .v5-category-edu-model-compare {
        hyphens: auto;
        overflow-wrap: anywhere;
    }
</style>

{%- capture style -%}
    {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div {% if section.settings.anchor != blank %}anchor-target="{{ section.settings.anchor | escape }}"{% endif %} style="{{ style }}" class="section-padding">
    <div class="section-container-lg">
        <div class="hidden lg:block">
            <div class="rounded-none bg-white px-[4.5625rem]">
                <div class="grid grid-cols-[18.34rem_18.34rem_18.34rem_18.34rem] items-start">
                    <div></div>
                    {%- for index in (0..2) -%}
                        {%- assign product = section.blocks[index] -%}
                        {% if product != null %}
                            <div class="flex flex-col items-start">
                                <div class="mb-[1.4375rem] h-[5.5rem] w-[5.5rem]">
                                    {%- assign pcimage = product.settings.pcimage -%}
                                    {%- assign mimage = product.settings.mimage -%}
                                    {% assign img_alt = product.settings.title | strip_html | default: pcimage.alt | default: 'image alt' %}
                                    {%- render 'diff-end-img',
                                      pc_img: pcimage,
                                      mb_img: mimage,
                                      pc_img_width: 88,
                                      mb_img_width: 88,
                                      class: 'h-[5.5rem] w-[5.5rem] object-cover',
                                      alt: img_alt
                                    -%}
                                </div>
                                <div class="pr-4 text-left text-xl font-semibold leading-[1.6875rem] text-black" style="color: {{ product.settings.title_color }};">
                                    {% if product.settings.link != blank %}
                                      <a href="{{ product.settings.link }}">
                                   {% endif %}
                                     {{ product.settings.title }}
                                   {% if product.settings.link != blank %}
                                      </a>
                                   {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    {%- endfor -%}
                </div>

                <div class="mt-[2.625rem]">
                    <div class="grid grid-cols-[18.34rem_18.34rem_18.34rem_18.34rem]">
                        {%- for i in (1..20) -%}
                            {%- assign label_key = 'label_' | append: i -%}
                            {%- assign value_key = 'value_' | append: i -%}
                            {%- assign label_value = section.settings[label_key] | strip -%}
                            {% assign isOdd = i | modulo: 2 %}
                            {% liquid
                                assign bgClass = 'bg-[#efefef]'
                                if isOdd == 0
                                  assign bgClass = "bg-white"
                                endif
                             %}
                            {% if label_value != blank %}
                                <div class="{{ bgClass }} lg:py-5 lg:leading-[1.2] pl-11 pr-4 flex items-center text-left text-base font-medium leading-[3.3125rem] text-black">{{ label_value }}</div>
                                {%- for index in (0..2) -%}
                                    {%- assign product = section.blocks[index] -%}
                                    <div class="{{ bgClass }} lg:py-5 lg:leading-[1.2] pl-[0.3125rem] pr-4 flex items-center text-left text-base font-medium leading-[3.3125rem] text-black">{{ product.settings[value_key] }}</div>
                                {%- endfor -%}
                            {% endif %}
                        {%- endfor -%}
                    </div>
                </div>
            </div>

            <div class="mx-auto mt-10 w-[69.25rem] text-left text-base font-medium leading-[1.6875rem] text-[rgba(0,0,0,0.3)]">
                {{ section.settings.footnote }}
            </div>
        </div>


        <div class="lg:hidden">
            <div class="">
                <div class="grid grid-cols-[4.98rem_4.98rem_4.98rem_4.98rem] items-start gap-x-2">
                    <div></div>
                    {%- for index in (0..2) -%}
                        {%- assign product = section.blocks[index] -%}
                        {% if product != null %}
                            <div class="flex flex-col items-start">
                                <div class="mb-2.5 h-11 w-11">
                                    {%- assign pcimage = product.settings.pcimage -%}
                                    {%- assign mimage = product.settings.mimage -%}
                                    {% assign img_alt = product.settings.title | strip_html | default: pcimage.alt | default: 'image alt' %}
                                    {%- render 'diff-end-img',
                                      pc_img: pcimage,
                                      mb_img: mimage,
                                      pc_img_width: 44,
                                      mb_img_width: 44,
                                      class: 'h-11 w-11 object-cover',
                                      alt: img_alt
                                    -%}
                                </div>
                                <div class="min-h-6 w-full text-left text-[0.625rem] font-semibold leading-[0.84375rem]" style="color: {{ product.settings.title_color }};">
                                  {% if product.settings.link != blank %}
                                    <a href="{{ product.settings.link }}">
                                 {% endif %}
                                   {{ product.settings.title }}
                                 {% if product.settings.link != blank %}
                                    </a>
                                 {% endif %}
                              </div>
                            </div>
                        {% endif %}
                    {%- endfor -%}
                </div>

                <div class="mt-[0.65625rem]">
                    {%- for i in (1..20) -%}
                      {%- assign label_key = 'label_' | append: i -%}
                      {%- assign value_key = 'value_' | append: i -%}
                      {%- assign label_value = section.settings[label_key] | strip -%}
                      {% assign isOdd = i | modulo: 2 %}
                        {% liquid
                            assign bgClass = 'bg-[#efefef]'
                            if isOdd == 0
                              assign bgClass = "bg-white"
                            endif
                         %}
                        {% if label_value != blank %}
                          <div class="grid grid-cols-[4.98rem_4.98rem_4.98rem_4.98rem] gap-x-2 py-2.5 {{ bgClass }}">
                                  <div class="flex items-center px-[0.4375rem] text-left text-[0.625rem] font-medium leading-[0.84375rem] text-black"> {{ label_value }} </div>
                                  {%- for index in (0..2) -%}
                                    {%- assign product = section.blocks[index] -%}
                                    <div class="flex items-center px-[0.4375rem] text-left text-[0.625rem] font-medium leading-[0.84375rem] text-black"> {{ product.settings[value_key] }} </div>
                                  {%- endfor -%}
                          </div>
                        {% endif %}
                  {%- endfor -%}
                </div>
            </div>

            <div class="mt-[1.8125rem] w-full text-center text-[0.625rem] font-medium leading-[0.84375rem] text-[rgba(0,0,0,0.3)]">
                {{ section.settings.footnote }}
            </div>
        </div>
    </div>

</div>

{% schema %}
{
  "name": "V5品类教育页-三款型号对比",
  "tag": "section",
  "class": "v5-category-edu-model-compare",
  "max_blocks": 3,
  "settings": [
    {"type":"text","id":"anchor","label":"锚点定位ID(确保唯一性,禁止空格和-符号)"},
    {"type":"number","id":"padding_top","label":"PC上边距","default":96},
    {"type":"number","id":"padding_bottom","label":"PC下边距","default":64},
    {"type":"text","id":"mb_padding_type","default":"custom","label":"MB边距类型","visible_if":"{{ false }}"},
    {"type":"number","id":"padding_top_mb","label":"MB上边距","default":38},
    {"type":"number","id":"padding_bottom_mb","label":"MB下边距","default":32},
    {"type":"header","content":"参数名称"},
    {"type":"text","id":"label_1","label":"参数1名称","default":"Gewicht"},
    {"type":"text","id":"label_2","label":"参数2名称","default":"Abmessungen (HxBxT)"},
    {"type":"text","id":"label_3","label":"参数3名称","default":"Netzeinspeiseleistung (AC)"},
    {"type":"text","id":"label_4","label":"参数4名称","default":"MPPT-Tracker"},
    {"type":"text","id":"label_5","label":"参数5名称","default":"PV-Eingangsleistung"},
    {"type":"text","id":"label_6","label":"参数6名称","default":"Kapazitat"},
    {"type":"text","id":"label_7","label":"参数7名称","default":"Netzbezug (AC)"},
    {"type":"text","id":"label_8","label":"参数8名称","default":"Inselnetz-Leistung (AC)"},
    {"type":"text","id":"label_9","label":"参数9名称","default":"Jahrl. Stromersparnis*"},
    {"type":"text","id":"label_10","label":"参数10名称"},
    {"type":"text","id":"label_11","label":"参数11名称"},
    {"type":"text","id":"label_12","label":"参数12名称"},
    {"type":"text","id":"label_13","label":"参数13名称"},
    {"type":"text","id":"label_14","label":"参数14名称"},
    {"type":"text","id":"label_15","label":"参数15名称"},
    {"type":"text","id":"label_16","label":"参数16名称"},
    {"type":"text","id":"label_17","label":"参数17名称"},
    {"type":"text","id":"label_18","label":"参数18名称"},
    {"type":"text","id":"label_19","label":"参数19名称"},
    {"type":"text","id":"label_20","label":"参数20名称"},
    {"type":"textarea","id":"footnote","label":"底部说明","default":"*Die Stromersparnis dient als Referenzwert und hangt von den individuellen Nutzungsbedingungen ab."}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 3,
      "settings": [
        {"type":"image_picker","id":"pcimage","label":"PC图片", "info":"推荐图片尺寸: 88x88"},
        {"type":"image_picker","id":"mimage","label":"MB图片", "info":"推荐图片尺寸: 88x88"},
        {"type":"text","id":"title","label":"产品标题","default":"SolarVault 3 Pro"},
        { "type": "color", "id": "title_color", "label": "产品名称颜色" },
        { "type": "url", "id": "link", "label": "产品名称跳转链接" },
        {"type":"text","id":"value_1","label":"参数1值","default":"26 kg"},
        {"type":"text","id":"value_2","label":"参数2值","default":"485 x 235 x 282 mm"},
        {"type":"text","id":"value_3","label":"参数3值","default":"1.200 W"},
        {"type":"text","id":"value_4","label":"参数4值","default":"4"},
        {"type":"text","id":"value_5","label":"参数5值","default":"4.000 W"},
        {"type":"text","id":"value_6","label":"参数6值","default":"2.520 Wh"},
        {"type":"text","id":"value_7","label":"参数7值","default":"1.200 W"},
        {"type":"text","id":"value_8","label":"参数8值","default":"1.200 W"},
        {"type":"text","id":"value_9","label":"参数9值","default":"1.766 EUR"},
        {"type":"text","id":"value_10","label":"参数10值"},
        {"type":"text","id":"value_11","label":"参数11值"},
        {"type":"text","id":"value_12","label":"参数12值"},
        {"type":"text","id":"value_13","label":"参数13值"},
        {"type":"text","id":"value_14","label":"参数14值"},
        {"type":"text","id":"value_15","label":"参数15值"},
        {"type":"text","id":"value_16","label":"参数16值"},
        {"type":"text","id":"value_17","label":"参数17值"},
        {"type":"text","id":"value_18","label":"参数18值"},
        {"type":"text","id":"value_19","label":"参数19值"},
        {"type":"text","id":"value_20","label":"参数20值"}
      ]
    }
  ],
  "presets": [
    {
      "category": "V5.0",
      "name": "V5品类教育页-三款型号对比",
      "blocks": [
        {"type":"product","settings":{"title":"SolarVault 3 Pro","value_1":"26 kg","value_2":"485 x 235 x 282 mm","value_3":"1.200 W","value_4":"4","value_5":"4.000 W","value_6":"2.520 Wh","value_7":"1.200 W","value_8":"1.200 W","value_9":"1.766 EUR"}},
        {"type":"product","settings":{"title":"SolarVault 3 Pro Max","value_1":"27 kg","value_2":"485 x 248 x 282 mm","value_3":"2.500 W","value_4":"4","value_5":"4.000 W","value_6":"2.520 Wh","value_7":"2.500 W","value_8":"2.500 W","value_9":"1.766 EUR"}},
        {"type":"product","settings":{"title":"SolarVault 3 Pro Max AC","value_1":"26 kg","value_2":"485 x 248 x 282 mm","value_3":"2.500 W","value_4":"entfallt","value_5":"entfallt","value_6":"2.520 Wh","value_7":"2.500 W","value_8":"2.500 W","value_9":"1.200 EUR"}}
      ]
    }
  ]
}
{% endschema %}
