  /* ces swiper */
    .ces-swiper {
      position: relative; margin: 0 auto;
      padding-bottom: var(--ces-swiper-pd);
    }

    .ces-swiper .swiper { width: 100%; }

    .ces-swiper .swiper-pagination-bullet,
    .ces-swiper .swiper-pagination-bullet-active {
      background: #fff;
    }

    .ces-swiper .swiper-pagination {
      bottom: var(--ces-swiper-pagination-bottom) !important;
    }

    .ces-swiper .swiper-slide {
      width: var(--ces-swiper-slide-w);
      height: var(--ces-swiper-slide-h);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-radius: var(--theme-btn-border-radius, var(--ces-swiper-slide-radius));
      padding: var(--ces-swiper-slide-padding);
      color: var(--ces-swiper-slide-color);
    }

    .swiper-slide .slide-title:not(.section.slide-swiper .swiper-slide .slide-title) {
      font-weight: 600;
      font-size: var(--ces-swiper-title-size);
      line-height: 1.1;
      text-transform: uppercase;
    }

    .swiper-slide_bottom {
        text-align: center; display: flex;
        flex-direction: column; align-items: center;
        transition: all .3s ease;
        opacity: 0; pointer-events: none;
    }
    .swiper-slide_bottom h3 {
        font-size: var(--ces-swiper-subtitle-size);
        line-height: 1.1;
        font-weight: 600;
        margin-bottom: var(--ces-swiper-subtitle-mb);
    }
    .swiper-slide_bottom .z-button-middle {
        background: var(--ces-swiper-btn-bg);
        color: var(--primary-color);
    }

    .swiper-slide-active .swiper-slide_bottom {
        opacity: 1;
        pointer-events: all;
    }
    .swiper-button_navigation {
        position: absolute;
        top: 50%; z-index: 9;
        transform: translateY(-50%);
        right: var(--ces-swiper-navigation-pos);
        width: var(--ces-swiper-navigation-w);
        height: var(--ces-swiper-navigation-w);
        border-radius: var(--theme-btn-border-radius,50%);
        background: rgb(196, 196, 196, .5);
        display: flex; align-items: center;
        justify-content: center; cursor: pointer;
        transition: all .3s ease;
    }
    .swiper-button_prev {
        left: var(--ces-swiper-navigation-pos);
    }
    .swiper-button_next svg {
        transform: rotate(180deg);
    }
    .swiper-button_navigation:hover,.swiper-button_navigation:active {
      background: rgb(196, 196, 196, .8);
    }

    .swiper-pagination .swiper-pagination-bullet {
        height: var(--ces-swiper-pagination-h);
        width: var(--ces-swiper-pagination-w);
        background: rgb(196, 196, 196);
        border-radius: 0; opacity: 1;
        margin: var(--ces-swiper-pagination-margin);
        transition: all .3s ease;
    }
    .swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
        background: var(--primary-color);
        width: var(--ces-swiper-pagination-active-w);
    }
    @media screen and (max-width: 1024px) {
      .ces-swiper {
        padding-top: 12px;
      }
      .ces-swiper .z-button-middle {
        font-weight: 600;
      }
    }
  /* swiper */



  /* section-actives */
    .section-main_3 {
      background: var(--section-actives-bg);
    }
    .ces-site-actives {
      flex-wrap: wrap;
      gap: var(--section-active-gap);
    }
    .ces-active-item {
      width: var(--section-active-w);
      border-radius: var(--theme-btn-border-radius,var(--section-active-radius));
      overflow: hidden;
    }
    .ces-active-item_img {
      height: var(--section-active-img-h);
      width: 100%; object-fit: cover;
    }
    .ces-active-item_title {
      height: var(--section-active-content-h);
      background: var(--section-active-content-bg);
      justify-content: center; align-items: center;
      padding: var(--section-active-content-pd);
      text-align:center; font-weight:bold;
      font-size: var(--section-active-content-size);
    }
    .ces-active-item_title p {
      -webkit-box-orient: vertical;
      display: -webkit-box;
      -webkit-line-clamp: 9;
      overflow: hidden;
    }
    @media screen and (max-width: 1024px) {
      .ces-active-item_title {
        justify-content: flex-start;
        text-align: left;
        -webkit-line-clamp: 3;
      }
      .ces-active_signle .ces-active-item:last-child {
        width: 100%;
        display: flex;
        flex-direction: row-reverse;
      }
      .ces-active_signle .ces-active-item:last-child .ces-active-item_title {
        width: 40%;
        height: 100%;
        border-radius: var(--theme-btn-border-radius,var(--section-active-radius)) 0 0 var(--theme-btn-border-radius,var(--section-active-radius));
      }
      .ces-active_signle .ces-active-item:last-child picture {flex:1;}
      .ces-active_signle .ces-active-item:last-child .ces-active-item_img {
        height: var(--section-active-img-h);
        width: 100%;
      }
    }
  /* section-actives */



  /* section video */
    .section-main_4 video {
      width: 100%;
      object-fit: cover;
      aspect-ratio: 16 / 9;
    }
    .ces_actions {
      position: absolute;
      left: 0; top: 0;
      width: 100%; height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .ces-video_playbtn {
      font-size: var(--section-video-btn);
      color: #fff; cursor: pointer;
      position: absolute; z-index: 10;
      transition: transform .3s ease;
    }
    .ces-video_playbtn:hover,.ces-video_playbtn:active {
      transform: scale(1.1);
    }
    .ces-videos_video.playing + .ces_actions .ces-video_playbtn {
      opacity: 0;
    }
  /* section video */


  /* form tabs */
    .form-tabs {
      padding: var(--form-tabitem-pd);
      background: var(--section-actives-bg);
    }
    .form_tabs_container {
      padding: var(--form-tab-pd);
      justify-content: center;
    }
    .form_tab-item {
      flex: 1;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      font-size: var(--form-tab-size);
      font-weight: 600;
      transition: all .3s ease;
      cursor: pointer; position: relative;
    }
    .form_tab-item::after {
      content: ''; position: absolute;
      width: var(--form-tab-border-w);
      height: var(--form-tab-border-h);
      background: var(--form-tab-border-color);
      right: 0; top: 50%;
      transform: translateY(-50%);
    }
    .form_tab-item:last-child::after {
      display: none;
    }
    .form_tab-item.active {
      color: var(--primary-color);
    }
    .form_tab-item.active svg {
      fill: var(--primary-color);
    }
    .form_tab-item img {
      width: var(--form-tab-img-w);
      margin-bottom: var(--form-tab-img-mb);
    }
    .form_tab_title {
      flex-direction: column; align-items: center;
    }
    .form_tab_title svg {
      margin-top: var(--form-tab-arror-mt);
      transition: all .3s ease;
    }
    .form_tab-item.active svg {
      transform: rotate(180deg);
    }


    .ces_form_modal_main_signle .form_left_main .ces_i .ces_content_title {
      font-size: 32px;
      font-weight: 600;
    }
    @media (max-width: 1024px) {
      .form_tabs_container {
        flex-wrap: wrap;
        gap: var(--form-tab-gap);
      }
      .form-tabs {
        padding: var(--form-tabitem-pd);
        background: var(--section-actives-bg);
      }
      .form_tab-item {
        flex: unset;
        width: calc(50% - 10px);
        font-weight: 600;
        box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
        border-radius: var(--theme-btn-border-radius,12px);
        padding: 16px 8px;
        text-align: center;
      }
      .form_tab-item::after {
        display: none;
      }


      .ces_form_modal_main_signle .form_left_main {
          border-right: none;
          border-bottom: none;
          text-align: center;
      }
      .ces_form_modal_main_signle .form_left_main .ces_i {
        justify-content: center;
      }
      .ces_form_modal_main_signle .form_left_main .ces_i .ces_content_title {
        font-size: 22px;
      }
    }


    /* form 联动 */
    jky-form:not(footer jky-form) {
      display: none;
    }
    jky-form.active {
      display: block;
    }
    /* form 联动 */
  /* form tabs */

  {% comment %} .ces_form_modal_content .ces_code_des button, .ces_form_modal_content .ces_code_des_tt button {% endcomment %}

  .tmp_datatable .ces_form_modal_content .ces_code_des button.loading::after {
    display: none!important;
  }
  .tmp_datatable .ces_form_modal_content .ces_code_des button.loading {
    opacity: 1;
  }
</style>

<style>
  .ces-highlights {
    display: grid;
    grid-template-rows: repeat(2,minmax(0,1fr));
    grid-auto-flow: column;
    gap: 24px;
    height: 462px;
  }
  .highlight-item {
    place-content: center;
    border-radius: var(--theme-btn-border-radius,15px);
    overflow: hidden;
    grid-template-rows: 1fr;
    grid-template-columns: 1fr;
    position: relative;
  }
  .highlight-item .jackery-icon-playCircle {
    color: #000;
    font-size: 60px;
    font-weight: 600;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }
  .highlight-item .jackery-icon-playCircle:hover {
      color: #4d4d4d;
  }
  .highlight-item img, .highlight-item video {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 1024px) {
    .ces-highlights {
      gap: 2.32558vw;
      height: 51.162vw;
    }
    .highlight-item {
      border-radius: var(--theme-btn-border-radius,12px);
    }
    .highlight-item .jackery-icon-playCircle {
      font-size: 40px;
    }
    .scroll-container {
      width: 100vw;
      overflow-x: scroll;
    }

    .scroll-container .ces-highlights {
      width: 128vw;
      padding: 0 7.5vw;
      max-width: unset;
    }


  }
</style>

<script src="https://afarkas.github.io/lazysizes/plugins/unveilhooks/ls.unveilhooks.min.js" data-cookieconsent="ignore" defer></script>

{% if section.settings.show_pos_section == true %}
  <div class="section-main section-main_1">
    {% if section.settings.section_title_1 != blank %}
      <div class="section-container section-title jky-text-3xl font-bold">{{section.settings.section_title_1}}</div>
    {% endif %}

    <div class="where-find-content flex">
      {% render "responsive-image", mimage: section.settings.section_where, image: section.settings.section_where, width: 3840, mwidth: 1024, image_class: "where-find-img" %}

      <div class="where-find-msg">
        <div class="m_flex">
          <div class="where-find-top_t where-find-top_big">{{section.settings.pos_big}}</div>
          <div class="where-find-top_t where-find-top_middle">{{section.settings.pos_middle}}</div>
          <div class="where-find-top_t_box">
            <div class="where-find-top_t where-find-top_small">{{section.settings.pos_small_top}}</div><span><br></span>
            <div class="where-find-top_t where-find-top_small">{{section.settings.pos_small_bottom}}</div>
          </div>
        </div>

        <div class="where-find-b_t">{{section.settings.pos_time}}</div>
      </div>
    </div>
  </div>
{% endif %}

{% if section.settings.show_actives_swiper == true %}
  <div class="section-container ces-swiper">
      {% if section.settings.section_title_2 != blank %}
        <div class="section-container section-title jky-text-3xl font-bold">{{section.settings.section_title_2}}</div>
      {% endif %}

      <div class="swiper">
        <div class="swiper-wrapper">
          {% assign sliders = section.blocks | where: 'type', "swiper_ces" %}
          {% for item in sliders %}
            <div class="swiper-slide" style="background: linear-gradient(-36.87deg, rgb(255, 80, 0) 0.711%,rgba(196, 196, 196, 0) 28.028%),linear-gradient(180.00deg, rgb(255, 80, 0) -5%,rgba(196, 196, 196, 0) 22%),
      url({{item.settings.ces_img | image_url: width: 780}}) no-repeat 50% 50% / cover;">
              <h2 class="slide-title">{{item.settings.title}}</h2>
              <div class="swiper-slide_bottom">
                <h3>{{item.settings.subtitle}}</h3>
                <a class="z-button-middle" href="{{item.settings.link}}">{{item.settings.btn_text}}</a>
              </div>
            </div>
          {% endfor %}
        </div>


        <div class="swiper-button_next swiper-button_navigation">
          <svg width="19.422241" height="19.422241" viewBox="0 0 19.4222 19.4222" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
            <desc>
                Created with Pixso.
            </desc>
            <defs/>
            <path id="矢量 1 (边框)" d="M5.53073 11.1691L11.9213 16.9275C12.562 17.5048 12.562 18.412 11.9213 18.9893C11.2806 19.5665 10.2738 19.5665 9.63312 18.9893L0.48053 10.7421C-0.160156 10.1647 -0.160156 9.25757 0.48053 8.68018L9.63312 0.432983C10.2738 -0.144287 11.2806 -0.144287 11.9213 0.432983C12.562 1.01025 12.562 1.91748 11.9213 2.49475L5.53073 8.25317L17.8043 8.25317C18.7103 8.25317 19.4222 8.89465 19.4222 9.71118C19.4222 10.5276 18.7103 11.1691 17.8043 11.1691L5.53073 11.1691Z" fill-rule="evenodd" fill="#000000"/>
          </svg>
        </div>

        <div class="swiper-button_prev swiper-button_navigation">
