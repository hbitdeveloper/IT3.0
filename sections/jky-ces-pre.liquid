<script src="{{ 'jquery-3.6.4.min.js' | asset_url }}" data-cookieconsent="ignore" defer></script>
<script type="module">
    {% if section.settings.show_pos_section == true %}
      var cesswiper = new Swiper(".ces-swiper .swiper", {
        effect: "coverflow",
        grabCursor: true,
        centeredSlides: true,
        coverflowEffect: {
          rotate: 0,
          stretch: 0,
          depth: 359,
          modifier: 1,
          scale: 0.9,
          slideShadows: true
        },
        loop: true,
        pagination: {
          el: ".ces-swiper .swiper-pagination",
          clickable: true
        },
        navigation: {
          nextEl: ".ces-swiper .swiper-button_next",
          prevEl: ".ces-swiper .swiper-button_prev",
        },
        breakpoints: {
          315: {
            slidesPerView: 1,
            effect: "slide",
            spaceBetween: 16
          },
          1024: {
            slidesPerView: 3
          },
          1560: {
            slidesPerView: 3
          }
        }
      });
    {% endif %}

    {% if section.settings.show_video_block %}
      const ces_videos_btn = $(".ces_actions");
      const ces_video = $(".ces_actions").siblings()[0];
      // 视频播放
      ces_videos_btn.click(() => {
        if(ces_video) {
          if(ces_video.paused) {
            ces_video.play();
            ces_video.classList.add("playing")
            ces_video.classList.remove("paused")
          } else {
            ces_video.pause();
            ces_video.classList.remove("playing")
            ces_video.classList.add("paused")
          }
        }
      })

      $(ces_video).on("pause", function() {
        ces_video.classList.remove("playing");
        ces_video.classList.add("paused");
      })
    {% endif %}

    {% if section.settings.show_form_tabs %}
      const tabs = document.querySelectorAll(".form_tab-item");

      function scrollToTop(element, distance = 150) {
        if(!element) return;
        const rect = element.getBoundingClientRect();
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const targetPosition = rect.top + scrollTop - distance;
        window.scrollTo({ top: targetPosition, behavior: 'smooth' });
      }

      function activeForm(tab) {
          const id = tab.getAttribute("id");
          const target_form = document.querySelector(`jky-form[jky-form-id=${tab.id}]`);
          try {
            const phone_field = target_form?.querySelector("jky-phoneselect");
            phone_field && phone_field.updateInputPaddingLeft();
            setTimeout(() => {
              phone_field && phone_field.updateInputPaddingLeft();
            }, 160)
          } catch (error) {
            console.error("Error scrolling to form:", error);
          }
          if(tab.classList.contains("active")){
            tab.classList.remove("active");
            if(target_form) target_form.classList.remove("active");
            history.pushState('', document.title, window.location.pathname + window.location.search);
            return
          }

          document.querySelectorAll("jky-form").forEach(i => i.classList.remove("active"));
          tabs.forEach(i => i.classList.remove("active"));
          tab.classList.add("active");
          if(target_form) target_form.classList.add("active");

          const _t_h = $(".form-tabs .section-title").outerHeight() || 0
          const _icon_h = $(".form-tabs .form_tab_img").outerHeight() || 0
          const _header_h = $("header,header-v5").outerHeight() || 0
          scrollToTop(tab, _t_h + _icon_h + _header_h + 30);

          history.pushState(null, null, `#${tab.id}`);
      }

      for(let i = 0; i < tabs.length; i++) {
        const tab = tabs[i];
        $(tab).on("click", function(e) {
          activeForm(tab)
        })
      }

      // copy
      function copyString(value, cb) {
        const textarea = document.createElement('textarea')
        textarea.readOnly = 'readonly'
        textarea.style.position = 'absolute'
        textarea.style.left = '-9999px'
        textarea.value = value
        document.body.appendChild(textarea)
        textarea.select()
        const result = document.execCommand('Copy')
        document.body.removeChild(textarea)
        if (result && cb) { cb() }
      }

      // ces modal
      function generateCESmodal(data) {
        const {
          benefitTitle, benefitImage, benefitImageTitle, benefitDesc, benefitButtonDesc,
          couponTitle, couponCode, couponImage, couponLimit, couponDate, couponDesc, couponUrl, couponButtonDesc,
          popupWindowTitle
        } = data;

        var isB2B =true
        if($('.jky-ces-pre .form-tabs #b2b-buyer').length >0 && $('.jky-ces-pre .form-tabs #b2b-buyer').hasClass('active')){
            isB2B = false
        }
        if($('.jky-ces-pre .form-tabs #media-cooperation').length >0 && $('.jky-ces-pre .form-tabs #media-cooperation').hasClass('active')){
            isB2B = false
        }

        const gift_dom = benefitTitle ? `<div class="form_left_main ces_form_modal_content flex">
                <div class="ces_i" id="ces_l_code_pic_main">
                    <div class="ces_content_title">${benefitTitle}</div>
                    <div class="ces_code"></div>
                    <img alt="${benefitTitle}" class="ces_code_img" src="${benefitImage}">
                    <div class="ces_code_des flex text-center">
                        <div class="ces_code_pic ${!isB2B ?"mart10":''}">${benefitImageTitle}</div>
                        ${isB2B && benefitButtonDesc ? `<button class="z-button-middle">${benefitButtonDesc}</button>`:''}
                    </div>
                    <p class="ces_b_des">${benefitDesc}</p>
                </div>
                ${benefitButtonDesc ? `<button class="z-button-middle hidden-m">${benefitButtonDesc}</button>`:''}
            </div>` : '';

          const coupon_dom = couponTitle ? `<div class="form_right_main ces_form_modal_content flex">
                <div class="ces_i">
                    <div class="ces_content_title">${couponTitle}</div>
                    <div class="ces_code">${couponLimit}</div>
                    <img alt="${couponTitle}" class="ces_code_img" src="${couponImage}">

                    <div class="ces_code_des_tt flex text-center">
                        <div class="ces_code_pic">${couponLimit}</div>
                        <a href="${couponUrl}" class="z-button-middle">${couponButtonDesc}</a>
                    </div>

                    <div class="ces_code_des flex text-center">
                        <span>${couponCode}</span>
                        <span>${couponDate}</span>
                    </div>
                    <p class="ces_b_des">${couponDesc}</p>
                </div>
                <a href="${couponUrl}" class="z-button-middle hidden-m">${couponButtonDesc}</a>
            </div>` : "";

        return `<h3 class="ces_form_modal_title text-center">${popupWindowTitle}</h3>
        <div class="ces_form_modal_main flex  ${benefitTitle && couponTitle ? 'ces_form_modal_main_both':'ces_form_modal_main_signle'}">
            ${gift_dom}

            ${coupon_dom}
        </div>`
      }

      // saveSVGtoPNG
      function saveImage(url, name = '', benefitButtonTips, classname = '.ces-gift') {
        const blobToUrl = (blob) => {
            return new Promise((resolve, reject) => {
                let reader = new FileReader()
                reader.onload = evt => {
                    resolve(evt.target.result)
                }
                reader.onerror = err => {
                    reject(err)
                }
                reader.readAsDataURL(blob)
            })
        }

        const downloadFile = (file, fileName) => {
          let a = document.createElement('a')
          a.style.display = 'none';
          a.href =  window.URL.createObjectURL(new Blob([file]),{type: 'image/jpeg'});
          a.download = fileName
          document.body.appendChild(a);
          a.click()
          document.body.removeChild(a);
          window.URL.revokeObjectURL(a.href);
        }

        const drawToCanvas = (svgUrl) => {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.setAttribute('crossOrigin', 'anonymous'); // 跨域图片需要添加这个属性，否则画布被污染了无法导出图片
                img.onload = async () => {
                    try {
                        let canvas = document.createElement('canvas')
                        canvas.width = img.width
                        canvas.height = img.height
                        let ctx = canvas.getContext('2d')
                        ctx.drawImage(img, 0, 0, img.width, img.height)
                        resolve(canvas.toDataURL())
                    } catch (error) {
                        reject(error)
                    }
                }
                img.onerror = e => {
                    reject(e)
                }
                img.src = svgUrl
            })
        }

        const svgToPng = async (svgStr) => {
            let blob = new Blob([svgStr], { // 转换成blob数据
                type: 'image/svg+xml'
            })

            let svgUrl = await blobToUrl(blob) // 转换成data:url数据
            let imgData = await drawToCanvas(svgUrl) // 绘制到canvas上
            downloadFile(imgData, '图片.png') // 下载
        }


        fetch(url).then(response => response.blob())
        .then(blob => {
            // <tspan class="st5 ces-gift" font-size="18">Exclusive to zzl leo</tspan>
              if(benefitButtonTips){
                pushSuccessMessage(benefitButtonTips);
              }
              downloadFile(blob, 'jackery.jpg')
            // const htmlString = data;
            // const targetClass = classname;
            // const newText = name;

            // const div = document.createElement('div');
            // div.innerHTML = htmlString;
            // div.querySelector(targetClass).innerHTML = newText;
            // const replacedHtmlString = div.innerHTML;
            // svgToPng(replacedHtmlString)
        })
        .catch(error => {
            console.error('请求发生错误:', error);
        });
      }

      // form cb
      function ces__form__cb(params) {
        if(!params || !params.firstName || !params.lastName) return

        const _ces_modal_html = window.generateCESmodal(params.response.data);
        const data = params.response.data;

        const parser = new DOMParser();
        const doc = parser.parseFromString(_ces_modal_html, 'text/html');
        const divElement = doc.querySelector(".ces_code_pic");
        divElement.innerText = divElement.innerText.replace("xxx", params.firstName + params.lastName);

        ZModle.getInstance(doc.querySelector("body").innerHTML, {
          id: `ces-success-modal_${Date.now()}`,
          class: "ces_submitted_modal",
          cb: (el, close) => {
              if(!window._aclose) { window._aclose = close }
              $(el).find(".form_right_main button, .form_right_main a") && $(el).find(".form_right_main button, .form_right_main a").click((e) => {
                e.preventDefault();
                copyString(data.couponCode.replace("Code: ", ""));
                let copyMsg =$(".jky-ces-pre .form-tabs").data('copy-success-tip') || 'Copy Success'
                pushSuccessMessage(copyMsg);
                e.target.href && setTimeout(() => {
                  window.location.href = e.target.href;
                }, 3000);
              })

              $(el).find(".form_left_main button") && $(el).find(".form_left_main button").click(() => {
                saveImage(data.benefitDownloadImage, params.firstName, data.benefitButtonTips);
              })
          }
        });
      }

      function handleHash() { // 处理url带hash进入
        const hash = location.hash.replace("#", "");
        if(!location.hash) return;
        const tab = document.querySelector(location.hash);
        if(tab) {
          activeForm(tab);
        }

        // fix: 集锦页面FK 近期和结束定位？？？？？？？？？？
        const list_tab = document.querySelector(`.exhibition--list-tabs li[data-cate="${hash}"]`)
        list_tab && setTimeout(() => {
          $(list_tab).trigger('click');
        }, 200)
      }

      window.generateCESmodal = generateCESmodal;
      window.ces__form__cb = ces__form__cb;

      $(document).ready(function() {
        // 经销商表单域动态切换
        const jxsbulk_form = $("jky-form[jky-form-id='bulk-purchaser']");

        const jxs_form = $("jky-form[jky-form-id='b2b-buyer']");
        const jsx_RETAILER = $(jxs_form).find("input[name='address'],input[name='weburl']").parent().parent();
        const jsx_DISTRIBUTOR = $(jxs_form).find("input[name='company'],input[name='deliverablerange'],input[name='maincustomers']").parent().parent();

        jsx_DISTRIBUTOR.hide();
        jsx_DISTRIBUTOR.find(".form-item").addClass("remove-form");
        jsx_RETAILER.show();
        jsx_RETAILER.find(".form-item").removeClass("remove-form");

        $(jxs_form).find(".form-row_radio").change(event => {
          // RETAILER     // DISTRIBUTOR
          const type = event.target.value;
          if(type === 'RETAILER') {
            jsx_DISTRIBUTOR.hide();
            jsx_DISTRIBUTOR.find(".form-item").addClass("remove-form");

            jsx_RETAILER.show();
            jsx_RETAILER.find(".form-item").removeClass("remove-form");
          } else {
            jsx_DISTRIBUTOR.show();
            jsx_DISTRIBUTOR.find(".form-item").removeClass("remove-form");

            jsx_RETAILER.hide();
            jsx_RETAILER.find(".form-item").addClass("remove-form");
          }
        })

        $(jxsbulk_form).find("jky-drop-menu ul li").click(function() { // 选择other要输入框？
          const label = $(this).attr("data-label");

          if(label === 'Other') {
            const newElement = document.createElement('div');
            newElement.classList.add("form-row");newElement.classList.add("flex");newElement.classList.add("half-full");
            newElement.classList.add("other___item");
            newElement.innerHTML = `<div class="form-item remove-form" data-field="input">
                <label for="other_input">Other Purpose</label>
                <input type="text" id="other_input" name="company" placeholder="Other Purpose" data-error="" data-value="company" data-reg="default" data-regerror="">
            </div>`;
            newElement.querySelector("#other_input").addEventListener("input", () => {
              $(jxsbulk_form).find("jky-drop-menu").attr("data-value", newElement.querySelector("#other_input").value)
            })

            $(".form-item[data-field='dropmenu']").parent().after($(newElement));
          } else {
            $(".other___item").remove();
          }
        })

        handleHash();
      })

      // window.onpopstate = function() { handleHash(); };

      window.addEventListener(
        "hashchange",
        () => {
          handleHash()
        },
        false
      );
    {% endif %}
</script>

{% schema %}
  {
    "name": "JKY CES prepare",
    "class": "section jky-ces-pre",
    "settings": [
      {"type": "header", "content": "section-1 位置地点版块配置"},
      {"type": "checkbox", "id": "show_pos_section", "default": true, "label": "是否显示该版块"},
      {"type": "text", "id": "section_title_1", "label": "Section 1 Heading"},
      {"type": "image_picker", "id": "section_where", "label": "Position Image"},
      {"type": "text", "id": "pos_big", "label": "Position big text", "default": "BOOTH"},
      {"type": "text", "id": "pos_middle", "label": "Position middle text", "default": "9815,"},
      {"type": "text", "id": "pos_small_top", "label": "Position small top text", "default": "NORTH HALL"},
      {"type": "text", "id": "pos_small_bottom", "label": "Position small bottom text", "default": "LVCC"},
      {"type": "text", "id": "pos_time", "label": "Position time", "default": "Jan 9-12, 2024 | Las Vegas"},
      {"type": "header", "content": "section-2 活动轮播图配置"},
      {"type": "checkbox", "id": "show_actives_swiper", "default": true, "label": "是否显示该版块"},
      {"type": "text", "id": "section_title_2", "label": "Section 2 Heading"},

      {"type": "header", "content": "section-3 网站活动版块配置"},
      {"type": "checkbox", "id": "show_actives_site", "default": true, "label": "是否显示该版块"},
      {"type": "text", "id": "section_title_3", "label": "Section 3 Heading"},

      {"type": "header", "content": "section-4 video版块配置"},
      {"type": "checkbox", "id": "show_video_block", "default": true, "label": "是否显示该版块"},
      {"type": "text", "id": "section_title_4", "label": "Section 4 Heading"},
      {"type": "image_picker", "id": "video_poster", "label": "poster Image"},
      {"type": "url", "id": "video_link", "label": "Video Link"},

      {"type": "header", "content": "section-5 Form tab配置"},
      {"type": "checkbox", "id": "show_form_tabs", "default": true, "label": "是否显示该版块"},
      {"type": "text", "id": "section_title_5", "label": "Section 5 Heading"},

      {"type": "header", "content": "section-6 Highlights配置"},
      {"type": "checkbox", "id": "show_highlight_block", "default": false, "label": "是否显示该版块"},
      {"type": "text", "id": "section_title_6", "label": "Highlights Heading"}
    ],
    "blocks": [
      {
          "type": "swiper_ces", "name": "CES Swiper item",
          "settings": [
              {"type": "text", "id": "title", "label": "Heading"},
              {"type": "text", "id": "subtitle", "label": "Product title"},
              {"type": "image_picker", "id": "ces_img", "label": "Background IMG"},
              {"type": "text", "id": "btn_text", "label": "Button text"},
              {"type": "url", "id": "link", "label": "Slide link"}
          ]
      },
      {
          "type": "site_active", "name": "Activitie item",
