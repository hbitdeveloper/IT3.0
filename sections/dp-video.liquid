{% comment %} 日本防灾日 video组件 {% endcomment %}
{% schema %}
  {
    "name": "DP Video",
    "tag": "section",
    "class": "dp-video",
    "settings": [
      {
        "type": "url",
        "id": "videoPC",
        "label": "Video url(PC)"
      },
      {
        "type": "url",
        "id": "videoMB",
        "label": "Video url(MB)"
      },
      {
        "type": "image_picker",
        "id": "imgPC",
        "label": "Video Poster (PC)"
      },
      {
        "type": "image_picker",
        "id": "imgMB",
        "label": "Video Poster (MB)"
      }
     
    ]
  }
  {% endschema %}

  <div class="dp-video-box">
    <div class="left-img">
        <img src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/dp-banner-left.png?v=1721739495" alt="">
    </div>
    <div class="video-box">

        {% if section.settings.videoPC != blank %}
          <div class="video-img-box pc-block">
                {%- render 'jky-video', video_url: section.settings.videoPC, poster: section.settings.imgPC, class: "features-media", autoplay: true, controls: controls, loop: true -%}
          </div>
        {% endif %}
        {% if section.settings.videoMB != blank%}
          <div class="video-img-box mb-block">
            {%- render 'jky-video', video_url: section.settings.videoMB, 
            poster: section.settings.imgMB, 
            class: "features-media", autoplay: true, controls: controls, loop: true -%}
          </div>
          {%- elsif section.settings.videoPC != blank-%}
          <div class="video-img-box mb-block">
            {%- render 'jky-video', video_url: section.settings.videoPC, 
            poster: section.settings.imgPC, 
            class: "features-media", autoplay: true, controls: controls, loop: true -%}
          </div>
        {% endif %}
        
    </div>
    <div class="right-img">
        <img src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/dp-video-right.png?v=1722914373" alt="">
    </div>
  </div>
  