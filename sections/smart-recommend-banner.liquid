{% comment %} 智能选购 banner {% endcomment %}
 <style>
  .smart-recommend-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 60vw;
  }
  .smart-recommend-banner picture {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .smart-recommend-banner .banner-content {
    width: 87.2vw;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    row-gap: 0.533333333333333vw;
    color: white;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    padding-top: 10.6666666666667vw;
  }
  .smart-recommend-banner .banner-content .banner-title {
    font-weight: 600;
    text-align: center;
    font-size: 8.53333333333333vw;
    line-height: 10.9333333333333vw;
    -webkit-box-orient: vertical;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .smart-recommend-banner .banner-content .banner-description {
    font-weight: 500;
    text-align: center;
    font-size: 4.26666666666667vw;
    line-height: 6.4vw;
    -webkit-box-orient: vertical;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }
  
  @media screen and (min-width: 1024px) {
    .smart-recommend-banner {
      height: 22.2222222222222vw;
    }
    .smart-recommend-banner .banner-content {
      width: 66.6666666666667vw;
      row-gap: 1.11111111111111vw;
      color: white;
      padding-top: 7.63888888888889vw;
    }
    .smart-recommend-banner .banner-content .banner-title {
      width: 100%;
      font-weight: 600;
      font-size: 3.88888888888889vw;
      line-height: 5vw;
      -webkit-box-orient: vertical;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      overflow: hidden;
    }
    .smart-recommend-banner .banner-content .banner-description {
      width: 100%;
      font-weight: 500;
      font-size: 1.25vw;
      line-height: 24px;
      -webkit-box-orient: vertical;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
  }
  @media screen and (min-width: 1440px) {
    .smart-recommend-banner {
      height: 320px;
    }
    .smart-recommend-banner .banner-content {
      width: 960px;
      row-gap: 16px;
      padding-top: 110px;
    }
    .smart-recommend-banner .banner-content .banner-title {
      font-size: 56px;
      line-height: 72px;
    }
    .smart-recommend-banner .banner-content .banner-description {
      font-size: 18px;
      line-height: 24px;
    }
  }
</style>

{% if section.settings.recommend_banner_pc_img != blank or section.settings.recommend_banner_mb_img != blank %}
  <section class="smart-recommend-banner">
    {% render 'responsive-image',
      image: section.settings.recommend_banner_pc_img,
      mimage: section.settings.recommend_banner_mb_img,
      image_class: 'w-full h-full object-cover'
    %}
    <div class="banner-content">
      <h2 class="banner-title" style="color:{{section.settings.title_color}}">{{section.settings.title | newline_to_br}}</h2>
      <p class="banner-description" style="color:{{section.settings.description_color}}">{{section.settings.description | newline_to_br}}</p>
    </div>
  </section>
{% endif %}

{% schema %}
  {
    "name": "Smart Recommend Banner",
    "class": "section-smart-recommend-banner",
    "settings": [
      {
        "type": "image_picker",
        "id": "recommend_banner_pc_img",
        "label": "PC Image"
      },
      {
        "type": "image_picker",
        "id": "recommend_banner_mb_img",
        "label": "Mobile Image"
      },
      {
        "type": "textarea",
        "id": "title",
        "label": "Title",
        "default": "Help You Choose"
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Title Color",
        "default": "#FFFFFF"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Customized recommendations based on your needs"
      },
      {
        "type": "color",
        "id": "description_color",
        "label": "description Color",
        "default": "#FFFFFF"
      }
    ]
  }
{% endschema %}
