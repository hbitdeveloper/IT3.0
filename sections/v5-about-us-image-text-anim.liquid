<style>
    .section-v5-about-us-image-text-anim .v-column-layout-container {
        border-top: 1px solid #e2e3e3;
        border-bottom: 1px solid #e2e3e3;
    }

    .section-v5-about-us-image-text-anim .tile > .v-block-container jds-button::part(button) {
        height: auto;
        padding: 0;
        text-decoration: underline;
    }

    .section-v5-about-us-image-text-anim .tile > .v-block-container jds-button::part(label)::after {
        height: 0;
        width: 0;
    }

    @media screen and (min-width: 1024px) {

        .section-v5-about-us-image-text-anim .tile > .v-block-container:first-child {
            flex: 1;
            border-right: 1px solid #C6C7C8;
        }

        .section-v5-about-us-image-text-anim .tile > .v-block-container:last-child {
            width: 33.5rem;
            transition: width 0.2s;
        }

        .section-v5-about-us-image-text-anim .tile > .v-block-container:last-child .blocks-image-wrap img {
            object-fit: contain;

        }

        .section-v5-about-us-image-text-anim .tile > .v-block-container:last-child:hover {
            width: 49rem;
        }

    }

    @media screen and (max-width: 1023.98px) {
        .section-v5-about-us-image-text-anim .tile > .v-block-container:first-child {
            border-bottom: 1px solid #C6C7C8;
        }

        .section-v5-about-us-image-text-anim .tile > .v-block-container:last-child {
            width: 100%;
        }

        .section-v5-about-us-image-text-anim .tile > .v-block-container:last-child:hover {
            width: 100%;
        }
    }
</style>

