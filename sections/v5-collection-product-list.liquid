{{ 'section-v5-collection-product-list.min.css' | asset_url | stylesheet_tag }}

{%- assign show_compare = false -%}
{%- if collection.metafields.custom.show_compare == true -%}
  {%- assign show_compare = true -%}
{%- endif -%}

<div
  class="collection-wrapper pb-5 pt-0 lg:pt-6 lg:pb-[3.75rem] bg-[#F5F5F3]" 
  data-open="{{section.settings.open_new}}"
  data-show_compare="{{show_compare}}"
  data-handle="{{ collection.handle }}"
  data-open-auto-discount-price="{{settings.open_auto_discount_price}}"
  data-discount-tag-display-style="{{settings.discount_tag_display_style}}"
  data-discount-amount-display-style="{{settings.discount_amount_display_style}}"
  data-discount-percent-display-style="{{settings.discount_percent_display_style}}"
>
  <div class="section-container-lg flex lg:gap-x-6 mx-auto">
    <div class="filters--overlay block lg:hidden"></div>
    <div class="filters-container w-auto lg:w-[19.5rem]">
      <div class="filters-top flex items-center justify-between font-semibold text-[#242F20] text-base pl-4 pr-2.5 py-3 lg:p-0">
        <div class="h-6 flex items-center gap-x-2.5 lg:h-12 lg:gap-x-3 lg:mb-6">
          <svg class="text-[#1F1F1F] lg:text-black/65 max-lg:hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.2787 17.5V16H13.7115V17.5H10.2787ZM6.404 12.75V11.25H17.5865V12.75H6.404ZM3.5 8V6.5H20.5V8H3.5Z" fill="currentColor"/>
          </svg>
          <span class="text-[#242F20] lg:text-black/65 text-base font-semibold lg:font-normal">{{ 'sections.collection_template.filters' | t }}</span>
        </div>

        <svg class="filters--btn-close block lg:hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6.40043 18.6552L5.34668 17.6014L10.9467 12.0014L5.34668 6.40141L6.40043 5.34766L12.0004 10.9477L17.6004 5.34766L18.6542 6.40141L13.0542 12.0014L18.6542 17.6014L17.6004 18.6552L12.0004 13.0552L6.40043 18.6552Z" fill="#1F1F1F"/>
        </svg>
      </div>

      <div class="selected-filters--mb !hidden lg:hidden pt-3 lg:pt-4 pb-4 lg:pb-6 lg:gap-4 gap-3 flex-wrap">
        <div class="selected-filters-clear text-primary text-sm cursor-pointer flex items-center whitespace-nowrap h-8">{{ section.settings.clear_all | escape }}</div>
      </div>

      <div class="filters-toolbar--skeleton px-4 lg:px-0">
        {%- for i in (0..4) -%}
          <div class="filters-toolbar--skeleton-item">
            <div class="skeleton h-6 my-3"></div>
          </div>
        {%- endfor -%}
      </div>
      <div class="filters-group-container flex-1 flex flex-col overflow-y-auto lg:gap-y-6 lg:pr-8">
        <div class="filters-group-container-sort flex flex-col lg:hidden px-4 py-2.5 lg:p-0 border-0 border-solid border-b-[1px] border-[#C3C3BE]">
          <span class="flex items-center text-base text-[#242F20] font-semibold">{{ 'sections.collection_template.sort_by' | t }}</span>
          <div class="mt-2.5">
            <div class="zc-checkbox checkbox-label-alignment-start mb-2">
              <label class="checkbox-wrapper flex items-center justify-between">
                <div class="label-text-wrapper" part="label">
                  <span class="text-[#242F20] text-sm">{{ 'sections.collection_template.sort_popularity'  | t }}</span>
                </div>
                <input 
                  data-ga-event="product_collection4.0_user_clicks" 
                  data-ga-action="change"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_popularity' | t }}"
                  data-ga-params-button_name="{{ 'sections.collection_template.sort_popularity' | t }}"
                  type="checkbox"
                  checked
                  data-mb-value="Popularity"
                >
                <div class="native-wrapper">
                  <svg class="checkbox-icon" viewBox="0 0 24 24" part="container">
                    <path d="M1.73,12.91 8.1,19.28 22.79,4.59" part="mark"></path>
                  </svg>
                </div>
              </label>
            </div>
            <div class="zc-checkbox checkbox-label-alignment-start mb-2">
              <label class="checkbox-wrapper flex items-center justify-between">
                <div class="label-text-wrapper" part="label">
                  <span class="text-[#242F20] text-sm">{{ 'sections.collection_template.sort_newest'  | t }}</span>
                </div>
                <input 
                  data-ga-event="product_collection4.0_user_clicks" 
                  data-ga-action="change"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_newest' | t }}"
                  data-ga-params-button_name="{{ 'sections.collection_template.sort_newest' | t }}"
                  type="checkbox"
                  data-mb-value="Newest"
                >
                <div class="native-wrapper">
                  <svg class="checkbox-icon" viewBox="0 0 24 24" part="container">
                    <path d="M1.73,12.91 8.1,19.28 22.79,4.59" part="mark"></path>
                  </svg>
                </div>
              </label>
            </div>
            <div class="zc-checkbox checkbox-label-alignment-start mb-2">
              <label class="checkbox-wrapper flex items-center justify-between">
                <div class="label-text-wrapper" part="label">
                  <span class="text-[#242F20] text-sm">{{ 'sections.collection_template.sort_oldest'  | t }}</span>
                </div>
                <input 
                  data-ga-event="product_collection4.0_user_clicks" 
                  data-ga-action="change"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_oldest' | t }}"
                  data-ga-params-button_name="{{ 'sections.collection_template.sort_oldest' | t }}"
                  type="checkbox"
                  data-mb-value="Oldest"
                >
                <div class="native-wrapper">
                  <svg class="checkbox-icon" viewBox="0 0 24 24" part="container">
                    <path d="M1.73,12.91 8.1,19.28 22.79,4.59" part="mark"></path>
                  </svg>
                </div>
              </label>
            </div>
            <div class="zc-checkbox checkbox-label-alignment-start mb-2">
              <label class="checkbox-wrapper flex items-center justify-between">
                <div class="label-text-wrapper" part="label">
                  <span class="text-[#242F20] text-sm">{{ 'sections.collection_template.sort_highest_price'  | t }}</span>
                </div>
                <input 
                  data-ga-event="product_collection4.0_user_clicks" 
                  data-ga-action="change"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_highest_price' | t }}"
                  data-ga-params-button_name="{{ 'sections.collection_template.sort_highest_price' | t }}"
                  type="checkbox"
                  data-mb-value="HighestPrice"
                >
                <div class="native-wrapper">
                  <svg class="checkbox-icon" viewBox="0 0 24 24" part="container">
                    <path d="M1.73,12.91 8.1,19.28 22.79,4.59" part="mark"></path>
                  </svg>
                </div>
              </label>
            </div>
            <div class="zc-checkbox checkbox-label-alignment-start mb-2">
              <label class="checkbox-wrapper flex items-center justify-between">
                <div class="label-text-wrapper" part="label">
                  <span class="text-[#242F20] text-sm">{{ 'sections.collection_template.sort_lowest_price'  | t }}</span>
                </div>
                <input 
                  data-ga-event="product_collection4.0_user_clicks" 
                  data-ga-action="change"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_lowest_price' | t }}"
                  data-ga-params-button_name="{{ 'sections.collection_template.sort_lowest_price' | t }}"
                  type="checkbox"
                  data-mb-value="LowestPrice"
                >
                <div class="native-wrapper">
                  <svg class="checkbox-icon" viewBox="0 0 24 24" part="container">
                    <path d="M1.73,12.91 8.1,19.28 22.79,4.59" part="mark"></path>
                  </svg>
                </div>
              </label>
            </div>
          </div>
        </div>
        <div class="filters-group-container-filter flex-1 flex flex-col lg:gap-y-6"></div>
      </div>
    </div>

    <div class="product-with-result flex-1 w-full min-h-[60vh]">
      <div class="result-toolbar flex justify-between">
        <div class="filters-toolbar--top result-toolbar--text hidden lg:flex items-center text-black/65 font-normal lg:text-base mb-4 lg:h-12 lg:mb-6">
          <div class="skeleton result-toolbar--skeleton"></div>
          <span>{{ 'sections.collection_template.use_amount_filters_html' | t: mount: 0 }}</span>
        </div>
        <div class="filters-toolbar--top filters-toolbar-dropdown w-full lg:w-fit flex gap-2.5 py-4 bg-[#F5F5F3] lg:h-10 lg:leading-10 lg:py-0 lg:mb-4">
          <div class="filters-trigger flex lg:hidden flex-1 items-center text-sm text-[#242F20] gap-x-2.5 pl-4">
            <svg class="text-[#1F1F1F] lg:text-black/65" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10.2787 17.5V16H13.7115V17.5H10.2787ZM6.404 12.75V11.25H17.5865V12.75H6.404ZM3.5 8V6.5H20.5V8H3.5Z" fill="currentColor"/>
            </svg>
            <span class="flex">{{ 'sections.collection_template.filters' | t }}<span class="filters-num flex w-fit ml-1 lg:hidden"></span></span>
          </div>
          <div class="filters-toolbar--top result-toolbar--text flex lg:hidden w-fit items-center text-black/65 font-normal text-sm pr-4">
            <div class="skeleton result-toolbar--skeleton"></div>
            <span>{{ 'sections.collection_template.use_amount_filters_html' | t: mount: 0 }}</span>
          </div>


          <span class="hidden lg:flex items-center text-base text-black/65 lg:h-12">{{ 'sections.collection_template.sort_by' | t }}</span>

          <collection-drop-down data-key="sort" class="hidden lg:block filters-toolbar-dropdown_main">
            <div trigger>
              <div class="trigger--summery flex items-center justify-between bg-white border border-solid border-[#E8E8E5] text-[#242F20] lg:h-12 lg:px-3 lg:text-sm">
                <span class="inline lg:hidden">{{ 'sections.collection_template.sort_by' | t }} </span>
                <span class="text-overflow-1">{{ 'sections.collection_template.sort_popularity' | t }}</span>
                <svg class="" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                  <path d="M818.07039273 512L329.94971923 23.87932647l-111.86098796 101.69180708L604.51759771 512 218.08873127 898.42886645 329.94971923 1010.28985441z" fill="#1a1a1a"></path>
                </svg>
              </div>
            </div>

            <div trigger-content>
              <div class="trigger--detail">
                <div
                  data-ga-event="product_collection4.0_user_clicks" data-ga-action="click"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_popularity'  | t }}"
                  data-pc-value="Popularity"
                  class="trigger--detail-item text-overflow-5 active">{{ 'sections.collection_template.sort_popularity'  | t }}</div>
                <div
                  data-ga-event="product_collection4.0_user_clicks" data-ga-action="click"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_newest'  | t }}"
                  data-pc-value="Newest" class="trigger--detail-item text-overflow-5">{{ 'sections.collection_template.sort_newest' | t }}</div>
                <div
                  data-ga-event="product_collection4.0_user_clicks" data-ga-action="click"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_oldest'  | t }}"
                  data-pc-value="Oldest" class="trigger--detail-item text-overflow-5">{{ 'sections.collection_template.sort_oldest' | t }}</div>
                <div
                  data-ga-event="product_collection4.0_user_clicks" data-ga-action="click"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_highest_price'  | t }}"
                  data-pc-value="HighestPrice" class="trigger--detail-item text-overflow-5">{{ 'sections.collection_template.sort_highest_price' | t }}</div>
                <div
                  data-ga-event="product_collection4.0_user_clicks" data-ga-action="click"
                  data-ga-params-module="Sort"
                  data-ga-params-position="{{ 'sections.collection_template.sort_lowest_price'  | t }}"
                  data-pc-value="LowestPrice" class="trigger--detail-item text-overflow-5">{{ 'sections.collection_template.sort_lowest_price' | t }}</div>
              </div>
            </div>
          </collection-drop-down>
        </div>
      </div>

      <div class="selected-filters hide-scroll-bar !hidden flex items-center h-10 mb-4 lg:h-auto lg:mb-6 gap-x-3 flex-nowrap overflow-x-auto lg:gap-4 lg:flex-wrap">
        <div class="selected-filters-clear text-primary text-sm cursor-pointer whitespace-nowrap flex items-center">{{ section.settings.clear_all | escape }}</div>
      </div>

      <div class="collection_search--skeleton grid grid-cols-3 max-lg:grid-cols-1 gap-x-6 gap-y-6 max-lg:gap-x-0 relative overflow-hidden"> 
        {%- for i in (0..11) -%}
          <div class="collection--skeleton-item p-4 px-3 bg-white overflow-hidden">
            <div class="skeleton w-full h-[13.4375rem] mb-2.5 lg:h-[14.625rem] lg:mb-3"></div>
            <div class="skeleton h-12 mb-2"></div>
            <div class="skeleton h-[2.875rem] mb-3"></div>
            <div class="skeleton h-[1.625rem] mb-5"></div>
            <div class="skeleton h-9 w-[8.75rem]"></div>
          </div>
        {%- endfor -%}
      </div>

      <div class="result-product-grid grid grid-cols-3 max-lg:grid-cols-1 gap-x-6 gap-y-6 max-lg:gap-x-0 relative"></div>

      <div class="flex collection-pagination-wrapper--mb justify-center items-center !hidden lg:hidden text-primary font-medium pt-5 text-sm gap-3">
        <span>{{section.settings.view_more_text}}</span>
        {% render 'icon-arrow', class: 'collection-pagination-wrapper--mb-icon rotate-90', width: 16, height: 16, color: 'var(--jds-color-primary)' %}
      </div>
      {% comment %} 分页 {% endcomment %}

      {% comment %} 无搜索结果状态 {% endcomment %}
      <div class="no_data_main hidden pt-20 pb-20 pr-6 pl-4 lg:pt-28 lg:pb-14 lg:pr-32 lg:pl-32 gap-4 lg:gap-6 text-center justify-center flex-col items-center">
        <span class="no_data_heading text-base font-medium text-[#242F20]">{{ 'sections.collection_template.no_product_found' | t }}  </span>
        <div class="zc_button h-10 w-max bg-[#242F20] border-2 border-[#242F20] text-white flex justify-center items-center cursor-pointer font-medium px-4 text-base transition-all duration-300 hover:opacity-90 active:bg-[#242F20] active:text-white outline-none">{{ 'sections.collection_template.clear_filters' | t }}</div>
      </div>
    </div>

    {% comment %} 底部产品对比 {% endcomment %}
    {% content_for 'block', type: 'v5-collection-sticky-bottom-compare', id: 'v5-product-collection-sticky-bottom-compare' %}
  </div>

  {% comment %} 分页 {% endcomment %}
  <collection-pagination id="pager" total="1" current="1"></collection-pagination>
</div>

<script src="{{ 'section-v5-collection-product-list.min.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5-集合页-产品列表",
  "class": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "limit": 1,
  "settings": [
    { "type": "text", "id": "clear_all", "label": "清除搜索条件文案", "default": "Clear All"},
    { "type": "text", "id": "view_more_text", "label": "移动端分页加载文案", "default": "View More"},

    { "type": "header", "content": "产品卡片设置" },
    { "type": "checkbox", "id": "open_new", "label": "链接点击是否新开标签","default": false}
  ],
  "blocks": [{ "type": "v5-collection-sticky-bottom-compare" }],
  "presets": [
    {
      "name": "V5-集合页-产品列表",
      "blocks": [
        {
          "id": "v5-product-collection-sticky-bottom-compare",
          "type": "v5-collection-sticky-bottom-compare",
          "static": true,
          "settings": {
            "collection_wrapper_selector": ".collection-wrapper",
            "product_compare_selector": ".collection-product--compare"
          }
        }
      ]
    }
  ]
}
{% endschema %}
