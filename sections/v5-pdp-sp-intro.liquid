    {
      "type": "number",
      "id": "mb_height",
      "label": "MB图片高度",
      "default": 516
    }
  ],
  "blocks": [
    {
      "type": "swiper-item",
      "name": "Tab Item",
      "limit": 3,
      "settings": [
        {
          "type": "inline_richtext",
          "info": "需要换行，请使用 \\n ",
          "id": "title",
          "label": "标题",
          "default": "Transfer Energy"
        },
        {
          "type": "inline_richtext",
          "info": "需要换行，请使用 \\n ",
          "id": "description",
          "label": "描述",
          "default": "Lorem ipsum dolor sit amet consectetur. Mattis sed ultrices ullamcorper at"
        },
        { "type": "color", "id": "text_color", "label": "文本颜色", "default": "#242F20" },
        { "type": "image_picker", "id": "image_pc", "label": "PC图片地址", "info":"推荐图片宽度: 1320"},
        { "type": "image_picker", "id": "image_mb", "label": "MB图片地址", "info":"推荐图片宽度: 686"}
      ]
    }
  ],
  "presets": [
    {
      "name": "V5-SP介绍Tabs",
      "category": "V5.0",
      "blocks": [
        {
          "type": "swiper-item"
        },
        {
          "type": "swiper-item"
        },
        {
          "type": "swiper-item"
        }
      ]
    }
  ]
}
{% endschema %}
