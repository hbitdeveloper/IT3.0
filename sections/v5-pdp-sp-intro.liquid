    {
      "type": "number",
      "id": "padding_top_mb",
      "label": "MB上边距",
      "default": 128
    },
    {
      "type": "number",
      "id": "padding_bottom_mb",
      "label": "MB下边距",
      "default": 128
    },
    { "type": "color", "id": "text_color", "label": "文本颜色", "default": "#242F20" },
    {
      "type": "inline_richtext",
      "info": "需要换行，请使用 \\n ",
      "id": "title",
      "label": "标题",
      "default": "Power & Save money"
    },
    {
      "type": "inline_richtext",
      "info": "需要换行，请使用 \\n ",
