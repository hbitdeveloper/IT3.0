      .how-to-play{padding-top:130px;padding-bottom:100px}.how-to-play-main__terms .how-to-play{padding-top:68px;padding-bottom:80px}.how-to-play .title{color:#000;font-size:32px;font-weight:700;line-height:1.45;margin-bottom:16px}.how-to-play li{color:#000;font-size:24px;font-weight:400;line-height:1.45;word-break:keep-all}ul,li{list-style:none;padding:0;margin:0}@media only screen and (max-width:1024px){.how-to-play{padding-top:100px;margin-top:130px;padding-bottom:20px}.how-to-play-main__terms .how-to-play{padding-top:40px;padding-bottom:40px;margin-top:0}.how-to-play .title{font-size:16px;margin-bottom:10px}.how-to-play li{font-size:13px}.how-to-play-main{background-repeat:no-repeat;background-size:contain;background-position:top center}}.image-banner{overflow:hidden}.image-banner-bg{width:100%;height:auto;object-fit:cover;animation-name:scale-in;animation-duration:2s;max-height:760px}.image-banner .image-banner-content{left:50%;transform:translateX(-50%);top:140px;bottom:130px}.image-banner-title{color:#fff}.image-banner-subtitle{max-width:800px;color:#fff;margin:9px 0 15px 0;font-weight: 400}.image-banner-subtitle span{color:var(--jds-color-primary);font-family:var(--jds-font-family);font-size:38px;font-style:normal;font-weight:700;line-height:1.3}.image-banner-content.top-right{align-items:flex-end;text-align:right}.image-banner-content.top-left{align-items:flex-start;text-align:left}.image-banner-content.top-center{align-items:center;text-align:center}.image-banner-content.middle-center{align-items:center;justify-content:center;text-align:center}.image-banner-content.middle-right{align-items:flex-end;justify-content:center;text-align:right}.image-banner-content.middle-left{align-items:flex-start;justify-content:center;text-align:left}.image-banner-content.bottom-center{align-items:center;justify-content:end;text-align:center}.image-banner-content.bottom-left{align-items:flex-start;justify-content:end;text-align:left}.image-banner-content.bottom-right{align-items:flex-end;justify-content:end;text-align:right}@media screen and (max-width:1920px){.image-banner .image-banner-content{top:7.3vw;bottom:7.3vw}}@media screen and (max-width:768px){.image-banner .image-banner-content{top:15vw;bottom:15vw}.image-banner-subtitle{max-width:100%;margin:5.8vw 0 3.5vw}.image-banner-content.top-right,.image-banner-content.top-left{align-items:center;text-align:center}.image-banner-content.middle-right,.image-banner-content.middle-left{align-items:center;justify-content:center;text-align:center}.image-banner-content.bottom-center,.image-banner-content.bottom-left,.image-banner-content.bottom-right{align-items:center;justify-content:end;text-align:center}}body.overflow-hidden{overflow:auto}
      .crossword-main {zoom: 0.9;}
      .footer_gameend {justify-content: center;}
      @media only screen and (max-width:1024px){.crossword-main {zoom: 1;}.hide__mobile{display: none;}}

      .crossword_subscribe_container h3 p {
        padding: 0;
        margin: 0;
      }
      .crossword_subscribe_container h3 strong {
        color: #EB8D21;
        font-size: 36px;
        font-weight: 600;
      }

      .coupon_gameend .coupone_info .coupone_info_des p {
        padding: 0;
        margin: 0;
      }
      .coupon_gameend .coupone_info .coupone_info_des p strong {
        color: #EB8D21; font-weight: 500;
      }

      .coupon_gameend .coupone_info .coupone_info_des p strong {
        color: #EB8D21; font-weight: 500;
      }

      .footer_gameend p {
        margin: 0;
        padding: 0;
      }


      .crossword-section .completed.issubscribeModal {
        top: 50%;z-index:10!important;
      }
      .crossword-section .curtain {
        background: var(--section-bg, linear-gradient(180deg,#f4f4f4 0,#f4f4f4 100%));
      }
      @media only screen and (max-width:1024px){
        .crossword-section .completed.issubscribeModal {
          top: min(50%,40em);
        }
        .crossword-main .title_gameend {
          font-size:18px!important;
        }
        .crossword-main .footer_gameend p {font-size:13px!important;}
        .section-crossword-main.section-padding {
           padding-top: {{section.settings.m_padding_top}}px;
          padding-bottom: {{section.settings.m_padding_bottom}}px;
        }
      }
      .title-block a {color: initial;}
    </style>

    <div
      data-handle="{{ section.settings.handle }}"
      {% if section.settings.anchor != blank %} data-anchor="{{section.settings.anchor}}" {% endif %}
      class="{% if section.settings.type == 'embed' %} embed-component {% endif %} section-padding section-bg section-crossword-main" style="--section-padding-top:{{section.settings.padding_top}};--section-padding-bottom:{{section.settings.padding_bottom}};{% if section.settings.bg_color != blank %}--section-bg: {{section.settings.bg_color}};{% endif %}">
      <div class="title-block">
        <div class="game-title">{{section.settings.heading_title | escape}}</div>
        <div class="game-subtitle" dd="{{section.settings.subheading_title | newline_to_br | escape }}">
          {{section.settings.subheading_title | newline_to_br}}
        </div>
      </div>

      {%- for block in section.blocks -%}
          {%- case block.type -%}
              {%- when '@app' -%}
                  {% render block %}
          {%- endcase -%}
      {%- endfor -%}


      {% assign howplay = section.blocks | where: 'type', "how_play" %}
      {%- if howplay.size > 0 or section.settings.how_to_paly_title != blank -%}
        <div class="how-to-play-main">
          <div class="how-to-play container">
            <div class="title">{{section.settings.how_to_paly_title | escape}}</div>

            {%- if howplay.size > 0 -%}
              <ul>
                {%- for item in howplay -%}
                  <li>{{item.settings.how_item}}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.image != blank -%}
      <div class="image-banner relative image-banner-section">
          {% render 'responsive-image', image: section.settings.image, image_class: 'image-banner-bg', mimage: section.settings.m_image %}

          <div class="section-container image-banner-content absolute flex flex-col {{ section.settings.desktop_content_position }}">
              {% if section.settings.sbtitle != blank %}
                <div class="sbtitle">{{section.settings.sbtitle}}</div>
              {% endif %}
              <h2 class="image-banner-title font-bold jky-text-3xl" style="{% if section.settings.color != blank %}color: {{section.settings.color}} {% endif %}">{{section.settings.title | newline_to_br}}</h2>

              {% if section.settings.subtitle != blank %}
                  <h2 class="image-banner-subtitle jky-text-sm" style="{% if section.settings.color != blank %}color: {{section.settings.color}} {% endif %}">{{section.settings.subtitle}}</h2>
              {% endif %}

              {% if section.settings.banner_link != blank %}
                  <a class="a-button-fill active" href="{{section.settings.banner_link}}">{{section.settings.banner_link_text}} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-base"></jds-icon></a>
              {% endif %}
          </div>
      </div>
      {%- endif -%}


      {% assign termslist = section.blocks | where: 'type', "terms_item" %}
      {%- if termslist.size > 0 or section.settings.terms_title != blank -%}
        <div class="how-to-play-main how-to-play-main__terms">
          <div class="how-to-play container">
            {%- if section.settings.terms_title != blank -%}
              <div class="title">{{section.settings.terms_title}}</div>
            {%- endif -%}

            {%- if termslist.size > 0 -%}
              <ul>
                {%- for item in termslist -%}
                  <li>{{item.settings.terms_item}}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

{% schema %}
  {
    "name": "填词小游戏",
    "class": "section crossword-section",
    "enabled_on": {
      "templates": ["page"]
    },
    "settings": [
      {
        "type": "select",
        "id": "type",
        "label": "类型",
        "default": "independent",
        "options": [
          {
            "value": "embed",
            "label": "内嵌使用"
          },
          {
            "value": "independent",
            "label": "独立使用"
          }
        ]
      },
      {
        "type": "text",
        "id": "handle",
        "label": "Handle（当前页面唯一的handle）",
        "default": "crossword_game-01"
      },
      {"type": "text", "id": "heading_title", "label": "Heading", "default": "LIGHTING FESTIVE JOY"},
      {
        "type": "select",
        "id": "anchor",
        "label": "锚点设置",
        "info": "非锚点section请清空此项",
        "options": [
            {
            "value": "",
            "label": "非锚点section"
            },
            {
            "value": "anchor__1",
            "label": "第一个section锚点"
            },
            {
            "value": "anchor__2",
            "label": "第二个section锚点"
            },
            {
            "value": "anchor__3",
            "label": "第三个section锚点"
            },
            {
            "value": "anchor__4",
            "label": "第四个section锚点"
            }
        ],
        "default": ""
      },
      {"type": "richtext", "id": "subheading_title", "label": "Sub Heading", "info": "加粗放大部分的文案在富文本中选用strong加粗标记即可"},
      {"type": "text", "id": "how_to_paly_title", "label": "How to play title", "default": "How to Play"},
      {"type": "text", "id": "terms_title", "label": "条款标题", "default": "Terms & Conditions"},
      {
        "type": "select",
        "id": "desktop_content_position",
        "options": [
          {
            "value": "top-left",
            "label": "t:sections.image-banner.settings.desktop_content_position.options__1.label"
          },
          {
            "value": "top-center",
            "label": "t:sections.image-banner.settings.desktop_content_position.options__2.label"
          },
          {
            "value": "top-right",
            "label": "t:sections.image-banner.settings.desktop_content_position.options__3.label"
          },
          {
            "value": "middle-left",
            "label": "t:sections.image-banner.settings.desktop_content_position.options__4.label"
          },
          {
            "value": "middle-center",
            "label": "t:sections.image-banner.settings.desktop_content_position.options__5.label"
          },
          {
            "value": "middle-right",
            "label": "t:sections.image-banner.settings.desktop_content_position.options__6.label"
          },
          {
            "value": "bottom-left",
            "label": "t:sections.image-banner.settings.desktop_content_position.options__7.label"
          },
          {
            "value": "bottom-center",
            "label": "t:sections.image-banner.settings.desktop_content_position.options__8.label"
          },
          {
            "value": "bottom-right",
            "label": "t:sections.image-banner.settings.desktop_content_position.options__9.label"
          }
        ],
        "default": "top-right",
        "label": "t:sections.image-banner.settings.desktop_content_position.label"
      },
      {"type": "image_picker", "id": "image", "label": "PC Image banner"},
      {"type": "image_picker", "id": "m_image", "label": "Mobile Image banner"},
      {"type": "text", "id": "sbtitle", "label": "Title"},
      {"type": "textarea", "id": "title", "label": "Banner title", "default": "Indoor backup"},
      {"type": "textarea", "id": "subtitle", "label": "Banner Heading", "default": "Adapters, cables, connectors, carrying case\nbags- all the Jackery accessories you want are here!"},
      { "type": "color", "id": "color", "label": "Banner text color", "default": "#ffffff" },
      {
        "type": "url",
        "id": "banner_link",
        "label": "Banner Link"
      },
      {"type": "text", "id": "banner_link_text", "label": "Banner Link Text", "default": "VIEW MORE"},

      {
        "type": "header",
        "content": "边距"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "上边距",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "下边距",
        "default": 36
      },
      {
        "type": "range",
        "id": "m_padding_top",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "移动端上边距！",
        "default": 30
      },
      {
        "type": "range",
        "id": "m_padding_bottom",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "移动端下边距！",
        "default": 30
      },
    { "type": "color", "id": "bg_color", "label": "背景颜色" }
    ],
    "blocks": [{
       "type": "how_play",
       "name": "How to play",
       "settings": [
           {"type": "text", "id": "how_item", "label": "玩法规则"}
       ]
    },{
       "type": "terms_item",
       "name": "Terms_item",
       "settings": [
           {"type": "richtext", "id": "terms_item", "label": "条款"}
       ]
    },{"type": "@app"}],
    "presets": [
      {
        "name": "填词小游戏"
      }
    ]
  }
{% endschema %}
