                                assign begin_time = block.settings.begin_time | date: '%s'
                            endif

                            assign end_time = 0
                            if block.settings.end_time != blank
                                assign end_time = block.settings.end_time | date: '%s'
                            endif

                            if begin_time == 0 and end_time == 0
                                assign is_show = true
                            elsif begin_time != 0 and end_time == 0 and begin_time < time_now
                                assign is_show = true
                            elsif begin_time == 0 and end_time != 0 and end_time > time_now
                                assign is_show = true
