<link rel="stylesheet" href="{{ 'common-header.min.css' | asset_url }}">
{% style %}
    {%- if section.settings.header_bg != blank -%}
    jky-header header {
        background-image: url({{section.settings.header_bg | image_url: width: section.settings.header_bg.width}});
    }
    {%- endif -%}
    @media (max-width: 1024px) {
        {%- if section.settings.m_header_bg != blank -%}
        jky-header header {
            background-image: url({{section.settings.m_header_bg | image_url: width: section.settings.m_header_bg.width}});
        }
        {%- endif -%}
    }

    .header--pic {display: block;}
    .header--pic img {width: 100%;height: 100%;object-fit: contain;}
    .header--pic.header-m-pic {width: 170px;}
    .header-container {line-height: 1.25;}

    /* 日站字体样式适配 修复-颜色在safari显示差异 */
    html[lang="ja"] jky-header header .header-container .menu-list--mb .m-menu-item.m-menu-item--simpletext .content .m-simpletext-item .m-simpletext-item--title {
    color: rgba(0, 0, 0, 0.2);
    }

    @media screen and (max-width: 1024px) {
    html[lang="ja"] jky-header header .header-container .menu-list--mb .m-menu-item.m-menu-item--shop .m-shop-child .m-shop-child--content {
        height: auto;
    }
    }

    @media screen and (min-width: 1024px) {
        .grid-product-list .grid-product-item .grid-product-item--title {

        }
    }

    header .product-label-tag-text--p {display:none;}
{% endstyle %}

{%- liquid
    assign time_now = 'now' | date: '%s'

    assign is_jp = false
    if shop.id == 10015375438 or shop.id == 56124375224
        assign is_jp = true
    endif

    assign is_legal_person = false
    if template == "page.legal-person"
        assign is_legal_person = true
    endif

    assign CR = settings.shop_cr | default: localization.country.iso_code | default: 'US'

    assign account_url = "https://account.jackery.com"
    if shop.id == 55005249633 or shop.id == 56124375224 or shop.id == 64525172955 or shop.id == 75730714917
        assign account_url = "https://demo-account.jackery.com"
    elsif shop.id == 79611232554 or theme.role == "unpublished"
        assign account_url = "https://account-uat.jackery.com"
    endif
-%}

<jky-header class="block">
    {% comment %} app {% endcomment %}
    {%- for block in section.blocks -%}
        {%- case block.type -%}
            {%- when '@app' -%}
                {% render block %}
        {%- endcase -%}
    {%- endfor -%}

    {% comment %} 定位 {% endcomment %}
    {%- if section.settings.show_locale_switcher -%}
        {% render 'locale-switcher-new' %}
    {%- endif -%}
    {% comment %} 通知栏 {% endcomment %}
    {% assign announce_bar_list = section.blocks | where: 'type', "announcement_bars" %}
    {%- if section.settings.show_announcement_bar and announce_bar_list.size > 0 -%}
        {% render 'announcement-bar-new',
            announceList: announce_bar_list,
            speed: section.settings.speed,
            days: section.settings.days,
            hrs: section.settings.hours,
            mins: section.settings.mins,
            secs: section.settings.secs
        %}
    {%- endif -%}
    <header style="--t-color:{{section.settings.header_t_color}};--header-bg:{{section.settings.header_bg_color}};">
        <div class="header-container flex">
        <a href="/" data-ga-event="top_brand_logo4.0" data-ga-action="click" aria-label="index link" data-ga-params-link="{{request.host}}" class="logo">{%- render 'icon-logo', width: 240, height: 27 -%}</a>

        <div class="menu-list flex">
                {% if is_legal_person == true and shop.id == 10015375438 or is_legal_person == true and shop.id == 56124375224 %}{% else %}
                     <div class="header-sub--icon">
                        {%- if section.settings.icon_sub_img != blank -%}
                            {%- render 'responsive-image', image: section.settings.icon_sub_img, mimage: section.settings.icon_sub_img, width: 40, mwidth: 20 -%}
                        {%- endif -%}
                    </div>
                {% endif %}

            {%- if is_legal_person == true -%}
                {% comment %} 判断是日站 {% endcomment %}
                {%- if is_jp == true -%}
                    <div class="legal-text">{{ section.settings.legal_text }}</div>
                {%- endif -%}
            {%- endif -%}

            {%- for block in section.blocks -%}
                {%- case block.type -%}
                    {%- when 'sales_menu' -%}
                        {% comment %} sales菜单-双列 {% endcomment %}
                        {%- liquid
                            assign is_show = false
                            assign begin_time = 0
                            if block.settings.begin_time != blank
                                assign begin_time = block.settings.begin_time | date: '%s'
                            endif

                            assign end_time = 0
                            if block.settings.end_time != blank
                                assign end_time = block.settings.end_time | date: '%s'
                            endif

                            if begin_time == 0 and end_time == 0
                                assign is_show = true
                            elsif begin_time != 0 and end_time == 0 and begin_time < time_now
                                assign is_show = true
                            elsif begin_time == 0 and end_time != 0 and end_time > time_now
                                assign is_show = true
                            elsif begin_time != 0 and end_time != 0 and end_time > time_now and begin_time < time_now
                                assign is_show = true
                            endif

                            assign textColor = '<em style="color: ' | append: block.settings.pc_highlight_color | append: '">'
                        -%}
                        {%- if is_show == true -%}
                            <div class="menu-item flex menu-item-sales">
                                <div class="menu-item--title relative cursor-pointer flex items-center h-full" data-ga-event="top_first_nav4.0" data-ga-action="mouseenter" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-position="">
                                    {{block.settings.m_title}}
                                </div>
                                <div class="menu-item--content menu-item-text menu-item-text--sales">
                                    <div class="container header-container">
                                    <div class="menu-close">
                                        {%- render 'icon-close', width: 20, height: 20, color: '#888888'  -%}
                                    </div>
                                    {%- if block.settings.left_img != blank -%}
                                        <div class="sales-item relative" style="--sales-text-color: {{block.settings.left_color}};--sales-text-sub-color: {{ block.settings.left_sub_color | default: block.settings.left_color }};--sales-text-color-mb:{{block.settings.mb_left_color}};--sales-text-sub-color-mb: {{ block.settings.mb_left_sub_color | default: block.settings.mb_left_color }};--sales-subtext-color: {{block.settings.right_des_color}};--sales-subtext-color-mb: {{block.settings.mb_right_des_color}};" data-ga-event="top_second_nav4.0" data-ga-action="click" data-ga-params-first_nav="{{block.settings.m_title | escape}}" data-ga-params-second_nav="{{block.settings.left_title | escape}}" data-ga-params-type="saleban_double_menu" data-ga-params-link="{{block.settings.left_link}}">
                                            <img
                                                srcset="
                                                    {{ settings.favicon | image_url: width: 32, height: 32 }} 0w,
                                                    {%- if block.settings.left_img.width >= 462 -%}{{ block.settings.left_img | image_url: width: 462 }} 462w,{%- endif -%}
                                                    {%- if block.settings.left_img.width >= 643 -%}{{ block.settings.left_img | image_url: width: 643 }} 643w,{%- endif -%}
                                                    {%- if block.settings.left_img.width >= 1286 -%}{{ block.settings.left_img | image_url: width: 1286 }} 1286w,{%- endif -%}
                                                "
                                                src="{{ block.settings.left_img | image_url: width: 643 }}"
                                                sizes="(min-width: 1920px) 1286px,(min-width: 1440px) 643px, (min-width: 1024) 33.4895vw, 0px"
                                                alt="{{ block.settings.left_img.alt | escape }}"
                                                loading="lazy"
                                                width="{{ block.settings.left_img.width }}"
                                                height="{{ block.settings.left_img.height }}"
                                                class="bg"
                                            />

                                            <div href="{{block.settings.left_link}}" class="sales-item--content">
                                            {%- if block.settings.left_title != blank -%}
                                                <div class="title text-overflow-1">{{block.settings.left_title | replace: '<em>', textColor}}</div>
                                            {%- endif -%}
                                            {%- if block.settings.left_subtitle != blank -%}
                                                <div class="subtitle text-overflow-1">{{block.settings.left_subtitle | replace: '<em>', textColor}}</div>
                                            {%- endif -%}

                                            {%- if block.settings.left_des != blank -%}
                                                <div class="des text-overflow-1" style="color:{{block.settings.left_des_color}};">{{block.settings.left_des | replace: '<em>', textColor}}</div>
                                            {%- endif -%}
                                            {%- if block.settings.left_btn_txt != blank and block.settings.left_link != blank -%}
                                                <jds-button href="{{block.settings.left_link}}" class="jds-animate has-text-button" icon="arrow-right-long" icon-mode="capsule">{{ block.settings.left_btn_txt | escape }}</jds-button>
                                            {%- endif -%}
                                            </div>
                                            <a class="sale-link-box" style="z-index:1;" href="{{block.settings.left_link}}" aria-label="sales menu link"></a>
                                        </div>
                                    {%- endif -%}

                                    {%- if block.settings.right_img != blank -%}
                                        <div class="sales-item relative" style="--sales-text-color: {{block.settings.right_color}};--sales-text-sub-color: {{ block.settings.right_sub_color | default: block.settings.right_color }};--sales-text-color-mb: {{block.settings.mb_right_color}};--sales-text-sub-color-mb:{{block.settings.mb_right_sub_color | default: block.settings.mb_right_color}};--sales-subtext-color: {{block.settings.right_des_color}};--sales-subtext-color-mb: {{block.settings.mb_right_des_color}};" data-ga-event="top_second_nav4.0" data-ga-action="click" data-ga-params-first_nav="{{block.settings.m_title | escape}}" data-ga-params-second_nav="{{block.settings.right_title | escape}}" data-ga-params-type="saleban_double_menu" data-ga-params-link="{{block.settings.right_link}}">
                                            <img
                                                srcset="
                                                    {{ settings.favicon | image_url: width: 32, height: 32 }} 0w,
                                                    {%- if block.settings.right_img.width >= 462 -%}{{ block.settings.right_img | image_url: width: 462 }} 462w,{%- endif -%}
                                                    {%- if block.settings.right_img.width >= 643 -%}{{ block.settings.right_img | image_url: width: 643 }} 643w,{%- endif -%}
                                                    {%- if block.settings.right_img.width >= 1286 -%}{{ block.settings.right_img | image_url: width: 1286 }} 1286w,{%- endif -%}
                                                "
                                                src="{{ block.settings.right_img | image_url: width: 643 }}"
                                                sizes="(min-width: 1920px) 1286px,(min-width: 1440px) 643px, (min-width: 1024) 33.4895vw, 0px"
                                                alt="{{ block.settings.right_img.alt | escape }}"
                                                loading="lazy"
                                                width="{{ block.settings.right_img.width }}"
                                                height="{{ block.settings.right_img.height }}"
                                                class="bg"
                                            />

                                            <div href="{{block.settings.right_link}}" class="sales-item--content">
                                                {%- if block.settings.right_title != blank -%}
                                                    <div class="title text-overflow-1">{{block.settings.right_title | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
                                                {%- if block.settings.right_subtitle != blank -%}
                                                    <div class="subtitle text-overflow-1">{{block.settings.right_subtitle | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
                                                {%- if block.settings.right_des != blank -%}
                                                    <div class="des text-overflow-1" style="color:{{block.settings.right_des_color}};">{{block.settings.right_des | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
                                                {%- if block.settings.right_btn_txt != blank and block.settings.right_link != blank -%}
                                                    <jds-button href="{{block.settings.right_link}}" class="jds-animate has-text-button" icon="arrow-right-long" icon-mode="capsule">{{ block.settings.right_btn_txt | escape }}</jds-button>
                                                {%- endif -%}
                                            </div>
                                            <a class="sale-link-box" style="z-index:1;" href="{{block.settings.right_link}}" aria-label="sales menu link"></a>
                                        </div>
                                    {%- endif -%}
                                    </div>
                                </div>
                            </div>
                        {%- endif -%}
                    {%- when 'sales_menu_full' -%}
                        {%- liquid
                            assign is_show = false
                            assign begin_time = 0
                            if block.settings.begin_time != blank
                                assign begin_time = block.settings.begin_time | date: '%s'
                            endif

                            assign end_time = 0
                            if block.settings.end_time != blank
                                assign end_time = block.settings.end_time | date: '%s'
                            endif

                            if begin_time == 0 and end_time == 0
                                assign is_show = true
                            elsif begin_time != 0 and end_time == 0 and begin_time < time_now
                                assign is_show = true
                            elsif begin_time == 0 and end_time != 0 and end_time > time_now
                                assign is_show = true
                            elsif begin_time != 0 and end_time != 0 and end_time > time_now and        begin_time < time_now
                                assign is_show = true
                            endif

                            assign textColor = '<em style="color: ' | append: block.settings.pc_highlight_color | append: '">'
                        -%}
                        {%- if is_show == true -%}
                            <div class="menu-item flex menu-item-sales menu-item-sales--full">
                                <div class="menu-item--title relative cursor-pointer flex items-center h-full" data-ga-event="top_first_nav4.0" data-ga-action="mouseenter" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-position="">{{block.settings.m_title}}</div>
                                <div class="menu-item--content menu-item-text menu-item-text--sales menu-item-text--sales--full" style="--sales-text-color: {{block.settings.pc_color}};--sales-text-sub-color: {{ block.settings.pc_sub_color | default: block.settings.pc_color}};--sales-text-color-mb: {{block.settings.mb_color}};--sales-text-sub-color-mb: {{ block.settings.mb_sub_color | default: block.settings.mb_color }};--sales-subtext-color: {{block.settings.des_color}};--sales-subtext-color-mb: {{block.settings.mb_des_color}};">
                                    <div class="container header-container">
                                        <div class="sales-item relative" data-ga-event="top_second_nav4.0" data-ga-action="click" data-ga-params-first_nav="{{block.settings.m_title | escape}}" data-ga-params-second_nav="{{block.settings.title | escape}}" data-ga-params-type="saleban_full_menu" data-ga-params-link="{{block.settings.link}}">

                                            <img
                                                srcset="
                                                    {{ settings.favicon | image_url: width: 32, height: 32 }} 0w,
                                                    {%- if block.settings.img.width >= 1380 -%}{{ block.settings.img | image_url: width: 1380 }} 1380w,{%- endif -%}
                                                    {%- if block.settings.img.width >= 1920 -%}{{ block.settings.img | image_url: width: 1920 }} 1920w,{%- endif -%}
                                                    {%- if block.settings.img.width >= 3840 -%}{{ block.settings.img | image_url: width: 3840 }} 3840w,{%- endif -%}
                                                "
                                                src="{{ block.settings.img | image_url: width: 643 }}"
                                                sizes="(min-width: 1920px) 3840px,(min-width: 1440px) 1920px, (min-width: 1024px) 1380px, 0px"
                                                alt="{{ block.settings.img.alt | escape }}"
                                                loading="lazy"
                                                width="{{ block.settings.img.width }}"
                                                height="{{ block.settings.img.height }}"
                                                class="bg"
                                            />

                                            <div class="sales-item--content header-container">
                                                <div class="menu-close">
                                                    {%- render 'icon-close', width: 20, height: 20, color: '#888888'  -%}
                                                </div>
                                                <div class="title text-overflow-3">{{block.settings.title | replace: '<em>', textColor}}</div>
                                                {%- if block.settings.subtitle != blank -%}
                                                    <div class="subtitle text-overflow-3">{{block.settings.subtitle | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
                                                {%- if block.settings.des != blank -%}
                                                    <div class="des text-overflow-3">{{block.settings.des | replace: '<em>', textColor}}</div>
                                                {%- endif -%}

                                                {%- if block.settings.btn_txt != blank -%}
                                                <a class="fk-btn" style="z-index:9;" href="{{block.settings.link}}">
                                                    <span>{{block.settings.btn_txt | escape}}</span>
                                                    <div class="fk-btn--icon">
                                                        <svg class="svg-arrow-line" viewBox="0 0 1024 1024" width="10" height="10"><path d="M604.17061386 93.0426665l402.19903979 402.1990398-402.19903979 410.57818814L512 813.64928061l259.66975621-259.75354784H9.2511995V428.208533h754.03940987L512 176.83413201l92.17061386-83.79146551z" fill="#1a1a1a"></path></svg>
                                                    </div>
                                                </a>
                                                {%- endif -%}
                                            </div>

                                            <a class="sale-link-box" style="z-index:1;" href="{{block.settings.link}}" aria-label="sales menu link"></a>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        {%- endif -%}
                    {%- when 'text_menu' -%}
                        {%- if block.settings.menu_list != blank -%}
                            {%- liquid
                                assign has_child = false
                                assign child_num = 0

                                for link in block.settings.menu_list.links
                                    if link.links != blank
                                        assign has_child = true
                                    endif
                                endfor

                                if has_child
                                    assign child_num = block.settings.menu_list.links.size
                                endif
                            -%}

                            {% comment %} 文本菜单-单列 {% endcomment %}
                            {%- unless has_child -%}
                                <div class="menu-item flex menu-item-simpletext">
                                    <div class="menu-item--title menu-item--title--no-modal relative cursor-pointer flex items-center h-full" data-ga-event="top_first_nav4.0" data-ga-action="mouseenter" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-position>{{block.settings.m_title}}</div>
                                    <div class="menu-item--content menu-item-text menu-item-text--simple">
                                        <div class="container">
                                            <div class="menu-item-text--simple_item">
                                                {%- for link in block.settings.menu_list.links -%}
                                                    <a aria-label="menu link" href="{{ link.url }}" class="text--simple_sub-child relative" data-ga-event="top_second_nav4.0" data-ga-action="click" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-second_nav="{{link.title | escape}}" data-ga-params-type="text_menu" data-ga-params-link="{{link.url}}">
                                                        <span class="text-overflow-1">{{ link.title }}</span>
                                                    </a>
                                                {%- endfor -%}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {%- endunless -%}

                            {% comment %} 文本菜单-双列 {% endcomment %}
                            {%- if has_child == true and child_num == 2 -%}
                                <div class="menu-item flex menu-item-simpletext">
                                    <div class="menu-item--title menu-item--title--no-modal relative cursor-pointer flex items-center h-full" data-ga-event="top_first_nav4.0" data-ga-action="mouseenter" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-position>{{block.settings.m_title}}</div>
                                    <div class="menu-item--content menu-item-text menu-item-text--simple">
                                        <div class="container">
                                            {%- for link in block.settings.menu_list.links -%}
                                                <div class="menu-item-text--simple_item">
                                                    <div class="text--simple_sub-child text--simple_cate relative">
                                                        <div class="text-overflow-1">{{link.title}}</div>
                                                    </div>

                                                    {%- for childlink in link.links -%}
                                                        <a class="text--simple_sub-child relative" aria-label="menu link" href="{{childlink.url }}" data-ga-event="top_second_nav4.0" data-ga-action="click" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-second_nav="{{childlink.title | escape}}" data-ga-params-type="text_menu" data-ga-params-link="{{childlink.url}}" data-ga-params-title="{{link.title | escape}}">
                                                            <span class="text-overflow-1">{{childlink.title}}</span>
                                                        </a>
                                                    {%- endfor -%}
                                                </div>
                                            {%- endfor -%}
                                        </div>
                                    </div>
                                </div>
                            {%- endif -%}

                            {% comment %} 文本菜单-3/4列 {% endcomment %}
                            {%- if has_child == true -%}
                                {%- if child_num == 3 or child_num == 4 -%}
                                    <div class="menu-item flex menu-item-simpletext menu-item-middletext">
                                        <div class="menu-item--title relative cursor-pointer flex items-center h-full" data-ga-event="top_first_nav4.0" data-ga-action="mouseenter" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-position="">{{block.settings.m_title}}</div>
                                        <div class="menu-item--content menu-item-text menu-item-text--simple menu-item-text--middle">
                                            <div class="container header-container" style="align-items: flex-start;">
                                                <div class="menu-close">
                                                    {%- render 'icon-close', width: 20, height: 20, color: '#888888'  -%}
                                                </div>

                                                {%- for link in block.settings.menu_list.links -%}
                                                    <div class="menu-item-text--simple_item">
                                                        <div class="text--simple_sub-child text--simple_cate relative">
                                                        <div class="text-overflow-1">{{link.title}}</div>
                                                        </div>
                                                        {%- for childlink in link.links -%}
                                                            <a aria-label="menu link" href="{{childlink.url }}" class="text--simple_sub-child relative" data-ga-event="top_second_nav4.0" data-ga-action="click" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-second_nav="{{childlink.title | escape}}" data-ga-params-type="text_menu" data-ga-params-link="{{childlink.url}}" data-ga-params-title="{{link.title | escape}}">
                                                                <span class="text-overflow-1">{{childlink.title}}</span>
                                                            </a>
                                                        {%- endfor -%}
                                                    </div>
                                                {%- endfor -%}
                                            </div>
                                        </div>
                                    </div>
                                {%- endif -%}
                            {%- endif -%}

                            {% comment %} 文本菜单-5/5+列 {% endcomment %}
                            {%- if has_child == true and child_num > 4 -%}
                                <div class="menu-item flex menu-item-simpletext menu-item-bigtext">
                                    <div class="menu-item--title relative cursor-pointer flex items-center h-full" data-ga-event="top_first_nav4.0" data-ga-action="mouseenter" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-position="">{{block.settings.m_title}}</div>
                                    <div class="menu-item--content menu-item-text menu-item-text--simple menu-item-text--big">
                                        <div class="container header-container" style="align-items: flex-start;">
                                            <div class="menu-close">
                                                {%- render 'icon-close', width: 20, height: 20, color: '#888888'  -%}
                                            </div>
                                            {%- for link in block.settings.menu_list.links limit: 6 -%}
                                                <div class="menu-item-text--simple_item">
                                                    <div class="text--simple_sub-child text--simple_cate relative">
                                                        <div class="text-overflow-1 relative">{{link.title}}</div>
                                                    </div>

                                                    {%- for childlink in link.links -%}
                                                        <a aria-label="menu link" href="{{childlink.url }}" class="text--simple_sub-child relative" data-ga-event="top_second_nav4.0" data-ga-action="click" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-second_nav="{{childlink.title | escape}}" data-ga-params-type="text_menu" data-ga-params-link="{{childlink.url}}" data-ga-params-title="{{link.title | escape}}">
                                                            <span class="text-overflow-1">{{childlink.title}}</span>
                                                        </a>
                                                    {%- endfor -%}
                                                </div>
                                            {%- endfor -%}
                                        </div>
                                    </div>
                                </div>
                            {%- endif -%}
                        {%- endif -%}
                    {%- when 'pictext_menu' -%}
