                                                {%- if block.settings.left_title != blank -%}
                                                <div class="m-sales--title">{{block.settings.left_title | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
                                                {%- if block.settings.left_subtitle != blank -%}
                                                <div class="m-sales--subtitle">{{block.settings.left_subtitle | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
                                                {%- if block.settings.left_des != blank -%}
                                                <div class="m-sales--des">{{block.settings.left_des | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
