                                                {%- endif -%}
                                                {%- if block.settings.subtitle != blank -%}
                                                <div class="m-sales--subtitle">{{block.settings.subtitle | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
                                                {%- if block.settings.des != blank -%}
                                                <div class="m-sales--des">{{block.settings.des | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
