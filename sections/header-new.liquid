                                                {%- endif -%}
                                                {%- if block.settings.right_subtitle != blank -%}
                                                <div class="m-sales--subtitle">{{block.settings.right_subtitle | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
                                                {%- if block.settings.right_des != blank -%}
                                                <div class="m-sales--des">{{block.settings.right_des | replace: '<em>', textColor}}</div>
                                                {%- endif -%}
