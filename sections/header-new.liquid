                        {% assign textColor = '<em style="color: ' | append: block.settings.mb_highlight_color | append: '">' %}
                        {%- if is_show == true -%}
                            <div class="m-menu-item m-menu-item--sales m-menu-item--sales--full">
                                <div class="title" data-ga-event="top_first_nav4.0" data-ga-action="click" data-ga-params-first_nav="{{block.settings.m_title | strip_html}}" data-ga-params-position="">
                                    <span class="relative">{{block.settings.m_title}}</span>
                                    {%- render 'icon-arrow', width: 16, height: 16, color:'rgba(0,0,0,0.9)' -%}
