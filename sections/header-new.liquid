                <div class="header-actions-item header-actions--user" role="button" tabindex="0" aria-label="User Center">
                    <div data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="account">{%- render 'icon-user', class: 'icon-user', width: 22, height: 22, color: '#000000' -%}</div>
                    <div class="absolute header-user--menu-bg"></div>
                    <div class="header-user--menu">
                        <div class="header-user--content">
                        {%- if section.settings.user_menu_title != blank -%}
                            <div class="title">{{section.settings.user_menu_title | escape}}</div>
                        {%- endif -%}
                        <ul class="des-list">
                            {%- for i in (0..4) -%}
                                {% assign user_info_index = 'user_menu_info_' | append: forloop.index %}
                                {%- if section.settings[user_info_index] != blank -%}
                                    <li class="des">{{section.settings[user_info_index] | escape}}</li>
                                {%- endif -%}
                            {%- endfor -%}
                        </ul>

                        <div class="btns">
                            {%- if customer -%}
                                {% comment %} 跳转用户中心 {% endcomment %}
                                <a role="link" aria-label="Account center" href="{{account_url | append: "?cr=" | append: CR}}" class="user--btn text-overflow-1" data-ga-event="top_function4.0" data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="account" data-ga-params-title="{{section.settings.user_menu_title | escape}}" data-ga-params-button_name="{{ 'customer.account.title' | t }}">{{ 'customer.account.title' | t }}</a>
                                {% comment %} 退出登录 {% endcomment %}
                                <a role="link" data-ga-event="top_function4.0" aria-label="{{ 'customer.log_out' | t }}" href="/account/logout?return_url={{request.path}}" class="user--btn text-overflow-1 header-user-logout" data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="account" data-ga-params-title="{{section.settings.user_menu_title | escape}}" data-ga-params-button_name="{{ 'customer.log_out' | t }}">{{ 'customer.log_out' | t }}</a>
                            {%- else -%}
                                {% comment %} 快捷登录 {% endcomment %}
                                {%- if settings.quick_login == true -%}
                                <a role="button" aria-label="{{'sections.header.free_password_login' | t}}" href="javascript:void(0);" class="user--btn header-user--pop-login text-overflow-1 {%if section.settings.pop_login_main==true%}user--btn-main{% endif %}" data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="account" data-ga-params-title="{{section.settings.user_menu_title | escape}}" data-ga-params-button_name="{{'sections.header.free_password_login' | t}}">{{'sections.header.free_password_login' | t}}</a>
                                {%- endif -%}
                                {% comment %} 跳转account登录 {% endcomment %}
                                <a role="link" aria-label="{{ 'customer.log_in' | t }}" href='{{ account_url | append: "/login?cr=" | append: CR | append: "&redirect_url=" | append: account_url | append: "/account/overview" }}' class="user--btn text-overflow-1" data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="account" data-ga-params-title="{{section.settings.user_menu_title | escape}}" data-ga-params-button_name="{{'customer.log_in' | t}}">{{ 'customer.log_in' | t }}</a>
                                {% comment %} 跳转account注册 {% endcomment %}
                                <a role="link" aria-label="{{ 'customer.register.title' | t }}" href='{{ account_url | append: "/register?cr=" | append: CR }}' class="user--btn text-overflow-1 header-user--register" data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="account" data-ga-params-title="{{section.settings.user_menu_title | escape}}" data-ga-params-button_name="{{'customer.register.title' | t}}">{{ 'customer.register.title' | t }}</a>
                            {%- endif -%}
                        </div>
                        </div>
                    </div>
                </div>
            {%- endunless -%}

            {%- unless settings.hide_cart_icon -%}
                {% if settings.cart_type == 'page' %}
                    <a href="/cart" class="header-actions-item header-actions--cart relative" id="cart-icon-bubble" data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="cart">
                {% else %}
                    <div class="header-actions-item header-actions--cart relative" id="cart-icon-bubble" data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="cart">
                {% endif %}
                    {%- render 'icon-cart', width: 29, height: 22, color: '#000000' -%}
                    {%- if cart != empty -%}
                        <div class="cart-count-bubble">
                            {%- if cart.item_count < 100 -%}
                                <span aria-hidden="true">{{ cart.item_count }}</span>
                            {%- else -%}
                                <span aria-hidden="true">99+</span>
                            {%- endif -%}
                            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
                        </div>
                    {%- endif -%}
                        {%- if is_legal_person == true -%}
                            {% comment %} 判断是日站 {% endcomment %}
                            {%- if is_jp == true -%}
                                <div class="legal-text mobile-block">{{ section.settings.legal_text }}</div>
                            {%- endif -%}
                        {%- endif -%}
                {% if settings.cart_type == 'page' %}
                    </a>
                {% else %}
                    </div>
                {% endif %}
            {%- endunless -%}


            <div class="header-actions-item header-actions--global {%if section.settings.locale_header_mb == false%} header-actions--global--hide{% endif %}" data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="atlas">
                <div class="header-actions--global_content">
                    {%- render 'icon-global', width: 22, height: 22, color: '#000000' -%}
                    {% render 'iso-code' %}
                </div>
            </div>

            <div class="header-actions-item header-toggle-btn--m" data-ga-event="top_function4.0" data-ga-action="click" data-ga-params-module="menu">
            <div class="toggle-btn--content">
                <span></span>
                <span></span>
                <span></span>
            </div>
            </div>

        </div>
        </div>

        {% assign aftersales_list = section.blocks | where: 'type', "after_sale_item" %}
        {% render 'header-after-sales', list: aftersales_list, isShow: section.settings.show_after_sales %}
    </header>
    <div class="modal-bg"></div>
</jky-header>

{% comment %} 全局推荐搜索词列表 {% endcomment %}
{% if settings.predictive_search_enable_recommend %}
  {% assign recommend_search_list = section.blocks | where: 'type', "recommend_search_terms" %}
  <script id="recommend-search-data" type="application/json">
    {
      "title": {{ 'templates.search.recommend_search' | t | json }},
      "list": [
        {% for item in recommend_search_list %}
          {
          "title": {{ item.settings.recommend_title | json }},
          "link": {{ item.settings.recommend_link | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

