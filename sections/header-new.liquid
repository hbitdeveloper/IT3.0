                                                {%- endif -%}
                                            </div>
                                        </div>
                                        {%- endif -%}
                                    </div>
                                </a>
                            </div>
                        {%- endif -%}
                    {%- when 'text_menu' -%}
                        {%- if block.settings.menu_list != blank -%}
                            {%- liquid
                                assign has_child = false
                                assign child_num = 0

                                for link in block.settings.menu_list.links
                                    if link.links != blank
                                        assign has_child = true
                                    endif
