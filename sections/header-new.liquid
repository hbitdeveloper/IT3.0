                                                                                            {%- assign p_img = first_variant.featured_image -%}
                                                                                        {%- else -%}
                                                                                            {%- assign p_img = product.featured_image -%}
                                                                                        {%- endif -%}
    
                                                                                        <picture class="header-m-pic header--pic">
                                                                                            <source srcset="{{ p_img | image_url: width: 120 }}, {{ p_img | image_url: width: 240 }} 2x" media="(max-width:320px)">
                                                                                            <source srcset="{{ p_img | image_url: width: 240 }}, {{ p_img | image_url: width: 480 }} 2x" media="(max-width:1023px)">
                                                                                            <source srcset="{{ p_img | image_url: width: 170 }}, {{ p_img | image_url: width: 340 }} 2x" media="(min-width:1023px)">
                                                                                            <img
                                                                                                loading="lazy"
                                                                                                src="{{ p_img | image_url: width: 170 }}"
