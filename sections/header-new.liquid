                                                    <jds-button href="{{block.settings.right_link}}" size="medium" class="has-text-button">{{ block.settings.right_btn_txt | escape }}</jds-button>
                                                {%- endif -%}
                                            </div>
                                        </a>
                                        {%- endif -%}
                                    </div>
                                </div>
                            </div>
                        {%- endif -%}
                    {%- when 'sales_menu_full' -%}
