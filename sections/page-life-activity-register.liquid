{% comment %} jackery-life 活动 register {% endcomment %}
<section class="w-full bg-white pt-64 lg:j-pt-96 xl:a-pt-96">
  <h2 class="life-activity-title mb-60 lg:j-mb-120 xl:a-mb-120">{{ section.settings.activity_register_title | newline_to_br }}</h2>

  {% comment %} 步骤 {% endcomment %}
  {% comment %} 后端接口获取 {% endcomment %}
  <ul class="w-full lg:j-w-1200 xl:a-w-1200 mx-auto grid grid-cols-3 pb-64 lg:j-pb-96 xl:a-pb-96" data-registration-wrap>
    <li class="flex-center flex-col px-20 lg:j-px-20 xl:a-px-20 registration-step-3">
      <div class="w-80 h-80 bg-[#EEE]/50 lg:j-w-80 lg:j-h-80 xl:a-w-80 xl:a-h-80 skeleton"></div>
      <div class="w-200 h-32 mt-32 mb-20 bg-[#EEE]/50 lg:j-w-200 lg:j-h-32 lg:j-mt-48 lg:j-mb-20 xl:a-w-200 xl:a-h-32 xl:a-mt-48 xl:a-mb-20 skeleton"></div>
      <div class="w-150 h-32 bg-[#EEE]/50 lg:j-w-100 lg:j-h-24 xl:a-w-100 xl:a-h-24 skeleton"></div>
    </li>
    <li class="flex-center flex-col px-20 lg:j-px-20 xl:a-px-20 registration-step-3">
      <div class="w-80 h-80 bg-[#EEE]/50 lg:j-w-80 lg:j-h-80 xl:a-w-80 xl:a-h-80 skeleton"></div>
      <div class="w-200 h-32 mt-32 mb-20 bg-[#EEE]/50 lg:j-w-200 lg:j-h-32 lg:j-mt-48 lg:j-mb-20 xl:a-w-200 xl:a-h-32 xl:a-mt-48 xl:a-mb-20 skeleton"></div>
      <div class="w-150 h-32 bg-[#EEE]/50 lg:j-w-100 lg:j-h-24 xl:a-w-100 xl:a-h-24 skeleton"></div>
    </li>
    <li class="flex-center flex-col px-20 lg:j-px-20 xl:a-px-20 registration-step-3">
      <div class="w-80 h-80 bg-[#EEE]/50 lg:j-w-80 lg:j-h-80 xl:a-w-80 xl:a-h-80 skeleton"></div>
      <div class="w-200 h-32 mt-32 mb-20 bg-[#EEE]/50 lg:j-w-200 lg:j-h-32 lg:j-mt-48 lg:j-mb-20 xl:a-w-200 xl:a-h-32 xl:a-mt-48 xl:a-mb-20 skeleton"></div>
      <div class="w-150 h-32 bg-[#EEE]/50 lg:j-w-100 lg:j-h-24 xl:a-w-100 xl:a-h-24 skeleton"></div>
    </li>
  </ul>
</section>

{% schema %}
  {
    "name": "Life Activity Register",
    "class": "section-life-activity section-life-activity-register",
    "settings": [
      {
        "type": "textarea",
        "id": "activity_register_title",
        "label": "Activity Register Title",
        "default": "Registration Time"
      }
    ]
  }
{% endschema %}