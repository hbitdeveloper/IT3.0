
  {% render 'pages-banner', blocks: section.blocks, autoplay_speed: section.settings.autoplay_speed, autoplay: section.settings.autoplay %}

    <style>
        @supports (content-visibility: auto) {
            .section-page-blog .blog-cate-list > .blog-cate-main {
                content-visibility: auto;
                contain-intrinsic-size: 1px 1200px;
            }

            .section-page-blog .blog-cate-list > .blog-cate-main:first-child {
                content-visibility: visible;
                contain-intrinsic-size: auto;
            }
        }
    </style>

    <div class="blogs-bg" id="anchor-all">
        <div class="blog-cate cal_scroll_target">
            <div class="section-container flex justify-between items-center">
                <div class="blog-cate-wrapper scroll-wrapper">
                    <div class="scroll-content" style="overflow-x:auto;width:100%;scrollbar-width:none;">
                        <div class="scroll-item active">
                            <div data-anchor="all" class="jky-text-lg">{{ 'general.action_text.all' | t }}</div>
                        </div>
                        {% for link in linklists.blog-list.links %}
                            {% assign blog = link.object %}
                            <div class="scroll-item">
                                <div
                                    {% if blog.handle != blank %}
                                        data-anchor="{{blog.handle}}"
                                    {% endif %}
                                    class="jky-text-lg"
                                >{{link.title}}</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <details-modal class="header__search">
                                <details>
                                    <summary
                                        class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
                                        aria-haspopup="dialog" aria-label="Search" role="button">
                                        <jds-icon name="search" class="icon-search" data-type="blog-search-toggle"></jds-icon>
                                    </summary>
                                    <div class="search-modal modal__content" role="dialog" aria-modal="true"
                                        aria-label="Search">
                                        <div class="modal-overlay"></div>
                                        <div class="search-modal__content search-modal__content-bottom index-container relative" tabindex="-1">
                                            <search-suggest
                                                class="search-modal__form"
                                                data-loading-text="Loading..."
                                            >
                                                <form
                                                    action="{{ routes.search_url }}"
                                                    method="get"
                                                    role="search"
                                                    class="search search-modal__form"
                                                >
                                                    <div class="field">
                                                        <input
                                                            class="search__input field__input"
                                                            id="Search-In-Modal"
                                                            type="search" name="q" value=""
                                                            placeholder="Enter your keywords"
                                                            role="combobox"
                                                            aria-expanded="false"
                                                            aria-owns="predictive-search-results-list"
                                                            aria-controls="predictive-search-results-list"
                                                            aria-haspopup="listbox"
                                                            aria-autocomplete="list"
                                                            autocorrect="off"
                                                            autocomplete="off"
                                                            autocapitalize="off"
                                                            spellcheck="false"
                                                            aria-activedescendant=""
                                                        >
                                                        <input type="hidden" name="options[prefix]" value="last">
                                                        <input type="hidden" name="type" value="article">
                                                        <button class="search__button field__button"
                                                            aria-label="Search">
                                                            <jds-icon name="search" class="icon-search"></jds-icon>
                                                        </button>

                                                        <button
                                                            type="button"
                                                            class="search-modal__close-button modal__close-button link link--text focus-inset"
                                                            aria-label="Close"
                                                        >
                                                            <jds-icon name="close" class="iconfont icon-close text-xl"></jds-icon>
                                                        </button>
                                                    </div>

                                                    <div
                                                        class="predictive-search predictive-search--suggest"
                                                        tabindex="-1"
                                                        data-predictive-search
                                                    >
                                                        <div class="predictive-search__loading-state">
                                                            <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66">
                                                                <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                                                            </svg>
                                                        </div>
                                                    </div>
                                                    <span class="predictive-search-status visually-hidden" role="status"
                                                        aria-hidden="true">
                                                    </span>
                                                </form>
                                            </search-suggest>
                                        </div>
                                    </div>
                                </details>
                </details-modal>
            </div>
        </div>

        <div class="blog-cate-list">
            {% for link in linklists.blog-list.links %}
                {% assign blog = link.object %}
                <div class="blog-cate-main section-container" {% if blog.handle != blank %} data-anchor="{{blog.handle}}" {% endif %}>
                    <h2 class="blog-cate-title text-center jky-text-2xl font-bold">{{blog.title}}</h2>

                    <div class="blog-cards">
                        {% for article in blog.articles limit: 6 %}

                                {% render 'article-card',
                                    main: false,
                                    article: article,
                                    lazy_load: true
                                %}
                        {% endfor %}
                    </div>
                    {% if blog.articles.size > 6 %}
                        <a class="z-button-big" href="{{blog.url}}">
                            {{ 'general.action_text.explore_more' | t }}
                            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
{% schema %}
{
    "name": "Page Blog main",
    "class": "section-page-blog",
    "settings": [
        {"type": "checkbox", "id": "autoplay", "label": "Auto-change slides", "default": true},
        {"type": "range", "id": "autoplay_speed", "label": "Change images every", "default": 7, "min": 5, "max": 10, "step": 1, "unit": "s"}
    ],
    "blocks": [
        {
            "type": "page_banner", "name": "Page Banner",
            "settings": [
                {"type": "textarea", "id": "title", "label": "Heading", "default": "Explore Further\nwith Jackery Solar"},
                {"type": "url", "id": "link", "label": "Slide link"},
                {"type": "image_picker", "id": "image", "label": "Image"},
                {"type": "image_picker", "id": "m_image", "label": "Mobile Image"},
                {"type": "image_picker", "id": "banner_icon", "label": "Banner Icon Image"}
            ]
        }
    ]
}
{% endschema %}
