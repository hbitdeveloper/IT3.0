<link rel="stylesheet" href="{{ 'pdp-v4-detail-scene.css' | asset_url }}">
{% comment %} 场景 blocks {% endcomment %}
{% assign scene_items = section.blocks | where: 'type', 'scene_usage_time' %}
<style>
  .scene--img {width: var(--img-w);height: var(--img-h);}
</style>
{% assign type = section.settings.type %}
<jky-pdp-v4-detail-scene
  class="w-full {% if type == 'embed' %} embed-component {% endif %}"
  data-handle="{{ section.settings.handle }}"
>
  {% comment %} PC 端，左文右图  {% endcomment %}
  <div class="{{section.settings.page_width}} hidden lg:block">
    <div class="flex items-start justify-between lg:j-gap-x-86 lg:j-my-80 xl:a-gap-x-86 xl:a-my-80">

      <div class="left flex-1 flex flex-col lg:j-gap-y-8 xl:a-gap-y-8  opacity-100">
        {% for block in scene_items %}
          {% comment %} 配置不为空 {% endcomment %}
          {% if
            block.settings.scene_title != blank or
            block.settings.scene_description != blank or
            block.settings.equipment_icon_1 != blank or
            block.settings.equipment_name_1 != blank or
            block.settings.equipment_time_1 != blank
          %}
            <div
              class="w-full opacity-30 {% if forloop.index == 1 %} opacity-100 {% else %} lg:j-mt-50 xl:a-mt-50 {% endif %} transition-opacity duration-300"
              data-index="{{ forloop.index }}"
              data-text-item
            >
              {% if block.settings.scene_title != blank %}
                {%- assign titleColor = '<em style="color: ' | append: block.settings.scene_title_main_color | append: '">' -%}
                <h3 class="font-semibold text-#1A1A1AE6 lg:j-text-28 lg:j-leading-40 xl:a-text-28 xl:a-leading-40">
                  {{ block.settings.scene_title | replace: '<em>', titleColor }}
                </h3>
              {% endif %}
              {% if block.settings.scene_description != blank %}
                {% assign descriptionColor = '<em style="color: ' | append: block.settings.scene_description_main_color | append: '">' %}
                <div class="font-medium text-#1A1A1A99 lg:j-text-16 lg:j-leading-24 lg:j-mt-12 xl:a-text-16 xl:a-leading-24 xl:a-mt-12">
                  {{ block.settings.scene_description | replace: '<em>', descriptionColor }}
                </div>
              {% endif %}

              {%- assign greyTextColor = '<em style="color:rgba(0,0,0,0.4)">' -%}
              <ul class="w-full lg:j-mt-32 xl:a-mt-32">
                {% if block.settings.equipment_icon_1 != blank or block.settings.equipment_name_1 != blank or block.settings.equipment_time_1 != blank %}
                  <li class="w-full flex items-start justify-between border-solid border-0 !border-t-[1px] border-[rgba(0,0,0,0.08)] lg:j-pt-16 lg:j-pb-32 xl:a-pt-16 xl:a-pb-32">
                    <div class="flex lg:j-gap-x-24 xl:a-gap-x-24">
                      <img class="lg:j-w-50 lg:j-h-50 xl:a-w-50 xl:a-h-50" src="{{ block.settings.equipment_icon_1 | image_url: width: 100 }}" alt="{{ block.settings.equipment_icon_1.alt | escape_once }}" loading="lazy">
                      <div class="equipment-name font-medium lg:j-text-18 lg:j-leading-28 xl:a-text-18 xl:a-leading-28 text-#000000CC">{{ block.settings.equipment_name_1 | replace: '<em>', greyTextColor }}</div>
                    </div>
                    <span class="equipment-time font-semibold text-primary whitespace-nowrap lg:j-text-24 xl:a-text-24">{{ block.settings.equipment_time_1 }}</span>
                  </li>
                {% endif %}
                {% if block.settings.equipment_icon_2 != blank or block.settings.equipment_name_2 != blank or block.settings.equipment_time_2 != blank %}
                  <li class="w-full flex items-start justify-between border-solid border-0 !border-t-[1px] border-[rgba(0,0,0,0.08)] lg:j-pt-16 lg:j-pb-32 xl:a-pt-16 xl:a-pb-32">
                    <div class="flex lg:j-gap-x-24 xl:a-gap-x-24">
                      <img class="lg:j-w-50 lg:j-h-50 xl:a-w-50 xl:a-h-50" src="{{ block.settings.equipment_icon_2 | image_url: width: 100 }}" alt="{{ block.settings.equipment_icon_2 | escape_once }}" loading="lazy">
                      <div class="equipment-name font-medium lg:j-text-18 lg:j-leading-28 xl:a-text-18 xl:a-leading-28 text-#000000CC">{{ block.settings.equipment_name_2 | replace: '<em>', greyTextColor }}</div>
                    </div>
                    <span class="equipment-time font-semibold text-primary whitespace-nowrap lg:j-text-24 xl:a-text-24">{{ block.settings.equipment_time_2 }}</span>
                  </li>
                {% endif %}
                {% if block.settings.equipment_icon_3 != blank or block.settings.equipment_name_3 != blank or block.settings.equipment_time_3 != blank %}
                  <li class="w-full flex items-start justify-between border-solid border-0 !border-t-[1px] border-[rgba(0,0,0,0.08)] lg:j-pt-16 lg:j-pb-32 xl:a-pt-16 xl:a-pb-32">
                    <div class="flex lg:j-gap-x-24 xl:a-gap-x-24">
                      <img class="lg:j-w-50 lg:j-h-50 xl:a-w-50 xl:a-h-50" src="{{ block.settings.equipment_icon_3 | image_url: width: 100 }}" alt="{{ block.settings.equipment_icon_3.alt | escape_once }}" loading="lazy" >
                      <div class="equipment-name font-medium lg:j-text-18 lg:j-leading-28 xl:a-text-18 xl:a-leading-28 text-#000000CC">{{ block.settings.equipment_name_3 | replace: '<em>', greyTextColor }}</div>
                    </div>
                    <span class="equipment-time font-semibold text-primary whitespace-nowrap lg:j-text-24 xl:a-text-24">{{ block.settings.equipment_time_3 }}</span>
                  </li>
                {% endif %}
                {% if block.settings.equipment_icon_4 != blank or block.settings.equipment_name_4 != blank or block.settings.equipment_time_4 != blank %}
                  <li class="w-full flex items-start justify-between border-solid border-0 !border-t-[1px] border-[rgba(0,0,0,0.08)] lg:j-pt-16 lg:j-pb-32 xl:a-pt-16 xl:a-pb-32">
                    <div class="flex lg:j-gap-x-24 xl:a-gap-x-24">
                      <img class="lg:j-w-50 lg:j-h-50 xl:a-w-50 xl:a-h-50" src="{{ block.settings.equipment_icon_4 | image_url: width: 100 }}" alt="{{ block.settings.equipment_icon_4.alt | escape_once }}" loading="lazy">
                      <div class="equipment-name font-medium lg:j-text-18 lg:j-leading-28 xl:a-text-18 xl:a-leading-28 text-#000000CC">{{ block.settings.equipment_name_4 | replace: '<em>', greyTextColor }}</div>
                    </div>
                    <span class="equipment-time font-semibold text-primary whitespace-nowrap lg:j-text-24 xl:a-text-24">{{ block.settings.equipment_time_4 }}</span>
                  </li>
                {% endif %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div
        {% if section.settings.page_width == 'section-container' %}style="width: 45rem;height: 38.25rem;top: var(--jky-header-h, 80px);--img-w: 45rem;--img-h: 38.25rem;"{% endif %}
        class="{% if section.settings.page_width != 'section-container' %}lg:j-w-800 lg:j-h-680 xl:a-w-800 xl:a-h-680 lg:j-top-80 xl:a-top-80{% endif %} right sticky">
        {% assign lock_index = false %}
        {% comment %} image {% endcomment %}
        {% for block in scene_items %}

          {% assign index = 0 %}
          {% if block.settings.pcImg != blank and lock_index == false %}
            {% assign index = forloop.index %}
            {% assign lock_index = true %}
          {% endif %}

          <div
            data-image-item
            data-index="{{ forloop.index }}"
            {% if block.settings.pcImg != blank %}
              data-image-config="true"
            {% endif %}
            class="{% if block.settings.pcImg != blank and index == forloop.index %}opacity-100{% else %}opacity-0{% endif %} absolute left-0 top-0 transition-opacity duration-300"
          >
            {%- assign class_img = '' -%}
            {%- if section.settings.page_width == "section-container" -%}
              {%- assign class_img = 'scene--img lg:j-rounded-16 xl:a-rounded-16 object-cover' -%}
            {% else %}
              {%- assign class_img = 'lg:j-w-800 lg:j-h-680 xl:a-w-800 xl:a-h-680 lg:j-rounded-16 xl:a-rounded-16 object-cover' -%}
            {% endif %}
            {% render 'responsive-image',
              image: block.settings.pcImg,
              mimage: block.settings.mbImg,
              image_class: class_img
            %}
          </div>

        {% endfor %}
      </div>

    </div>
  </div>

  {% comment %} Mobile 端，平铺展开 {% endcomment %}
  <ul class="w-full block lg:hidden">
    {% for block in scene_items %}
      <li class="w-full px-32 my-48">
        {% comment %} image {% endcomment %}
        {%- if block.settings.mbImg != blank -%}
          {% render 'responsive-image',
            image: block.settings.pcImg,
            mimage: block.settings.mbImg,
            image_class: 'w-full h-400 rounded-24 object-cover'
          %}
        {%- endif -%}
        <div class="px-32 {% if block.settings.mbImg != blank %} pt-56 {% else %} pt-0 {% endif %}">
          {% if block.settings.scene_title != blank %}
            {% assign titleColor = '<em style="color: ' | append: block.settings.scene_title_main_color | append: '">' %}
            <h2 class="font-semibold text-48 leading-64 text-#1A1A1AE6">
              {{ block.settings.scene_title | replace: '<em>', titleColor }}
            </h2>
          {% endif %}
          {% if block.settings.scene_description != blank %}
            {% assign descriptionColor = '<em style="color: ' | append: block.settings.scene_description_main_color | append: '">' %}
            <div class="font-medium text-24 leading-40 text-#1A1A1A99 mt-12">
              {{ block.settings.scene_description | replace: '<em>', descriptionColor }}
            </div>
          {% endif %}

          {%- assign greyTextColor = '<em style="color:rgba(0,0,0,0.4)">' -%}
          <ul class="w-full mt-48">
            {% if block.settings.equipment_icon_1 != blank or block.settings.equipment_name_1 != blank or block.settings.equipment_time_1 != blank %}
              <li class="w-full flex items-start justify-between border-solid border-0 !border-t-[1px] border-[rgba(0,0,0,0.08)] pt-20 pb-48">
                <div class="flex gap-x-45">
                  <img class="w-80 h-64 mt-12" src="{{ block.settings.equipment_icon_1 | image_url: width: 80 }}" alt="">
                  <div class="equipment-name font-medium text-28 leading-44 text-#000000CC">{{ block.settings.equipment_name_1 | replace: '<em>', greyTextColor }}</div>
                </div>
                <span class="equipment-time font-semibold text-primary text-40 leading-56 whitespace-nowrap">{{ block.settings.equipment_time_1 }}</span>
              </li>
            {% endif %}

            {% if block.settings.equipment_icon_2 != blank or block.settings.equipment_name_2 != blank or block.settings.equipment_time_2 != blank %}
              <li class="w-full flex items-start justify-between border-solid border-0 !border-t-[1px] border-[rgba(0,0,0,0.08)] pt-20 pb-48">
                <div class="flex gap-x-45">
                  <img class="w-80 h-64 mt-12" src="{{ block.settings.equipment_icon_2 | image_url: width: 80 }}" alt="">
                  <div class="equipment-name font-medium text-28 leading-44 text-#000000CC">{{ block.settings.equipment_name_2 | replace: '<em>', greyTextColor }}</div>
                </div>
                <span class="equipment-time font-semibold text-primary text-40 leading-56 whitespace-nowrap">{{ block.settings.equipment_time_2 }}</span>
              </li>
            {% endif %}

            {% if block.settings.equipment_icon_3 != blank or block.settings.equipment_name_3 != blank or block.settings.equipment_time_3 != blank %}
              <li class="w-full flex items-start justify-between border-solid border-0 !border-t-[1px] border-[rgba(0,0,0,0.08)] pt-20 pb-48">
                <div class="flex gap-x-45">
                  <img class="w-80 h-64 mt-12" src="{{ block.settings.equipment_icon_3 | image_url: width: 80 }}" alt="">
                  <div class="equipment-name font-medium text-28 leading-44 text-#000000CC">{{ block.settings.equipment_name_3 | replace: '<em>', greyTextColor }}</div>
                </div>
                <span class="equipment-time font-semibold text-primary text-40 leading-56 whitespace-nowrap">{{ block.settings.equipment_time_3 }}</span>
              </li>
            {% endif %}

            {% if block.settings.equipment_icon_4 != blank or block.settings.equipment_name_4 != blank or block.settings.equipment_time_4 != blank %}
              <li class="w-full flex items-start justify-between border-solid border-0 !border-t-[1px] border-[rgba(0,0,0,0.08)] pt-20 pb-48">
                <div class="flex gap-x-45">
                  <img class="w-80 h-64 mt-12" src="{{ block.settings.equipment_icon_4 | image_url: width: 80 }}" alt="">
                  <div class="equipment-name font-medium text-28 leading-44 text-#000000CC">{{ block.settings.equipment_name_4 | replace: '<em>', greyTextColor }}</div>
                </div>
                <span class="equipment-time font-semibold text-primary text-40 leading-56 whitespace-nowrap">{{ block.settings.equipment_time_4 }}</span>
              </li>
            {% endif %}
          </ul>
        </div>
      </li>
    {% endfor %}
  </ul>
</jky-pdp-v4-detail-scene>

<script src="{{ 'pdp-v4-detail-scene.js' | asset_url }}" defer></script>
{% schema %}
  {
    "name": "左文右图（使用场景+设备时长）",
    "tag": "section",
    "class": "pdp-v4-detail-scene overflow-visible",
    "disabled_on": {
      "templates": ["collection"]
    },
    "settings": [
      {
        "type": "select",
        "id": "type",
        "label": "类型",
        "default": "embed",
        "options": [
          {
            "value": "embed",
            "label": "内嵌使用"
          },
          {
            "value": "independent",
            "label": "独立使用"
          }
        ]
      },
      {
        "type": "text",
        "id": "handle",
        "label": "Handle（当前页面唯一的handle）",
        "default": "left-text-right-image-sticky-01"
      },
      {
        "type": "select",
        "id": "page_width",
        "options": [
          {
            "value": "section-container",
            "label": "版心/1200px"
          },
          {
            "value": "section-container-lg",
            "label": "大版心/1312px"
          }
        ],
        "default": "section-container-lg",
        "label": "组件宽度"
      }
    ],
    "blocks": [
      {
        "name": "scene and usage",
        "type": "scene_usage_time",
        "settings": [
          {"type": "richtext", "id": "scene_title", "label": "使用场景标题【斜体=文案突出】"},
          { "type": "color", "id": "scene_title_main_color", "label": "突出文案颜色", "default": "#fd5000" },
          {"type": "richtext", "id": "scene_description", "label": "描述【斜体=文案突出】"},
          { "type": "color", "id": "scene_description_main_color", "label": "突出文案颜色", "default": "#fd5000" },
          {"type": "image_picker", "id": "pcImg", "label": "PC图片（800*680）"},
          {"type": "image_picker", "id": "mbImg", "label": "移动端图片（686*400）"},

          {"type": "header", "content":"设备一配置"},
          {"type": "image_picker", "id": "equipment_icon_1", "label": "设备图标"},
          {"type": "richtext", "id": "equipment_name_1", "label": "设备名称（瓦数）【斜体=置灰】"},
          {"type": "text", "id": "equipment_time_1", "label": "供电时长"},

          {"type": "header", "content":"设备二配置"},
          {"type": "image_picker", "id": "equipment_icon_2", "label": "设备图标"},
          {"type": "richtext", "id": "equipment_name_2", "label": "设备名称（瓦数）【斜体=置灰】"},
          {"type": "text", "id": "equipment_time_2", "label": "供电时长"},

          {"type": "header", "content":"设备三配置"},
          {"type": "image_picker", "id": "equipment_icon_3", "label": "设备图标"},
          {"type": "richtext", "id": "equipment_name_3", "label": "设备名称（瓦数）【斜体=置灰】"},
          {"type": "text", "id": "equipment_time_3", "label": "供电时长"},

          {"type": "header", "content":"设备四配置"},
          {"type": "image_picker", "id": "equipment_icon_4", "label": "设备图标"},
          {"type": "richtext", "id": "equipment_name_4", "label": "设备名称（瓦数）【斜体=置灰】"},
          {"type": "text", "id": "equipment_time_4", "label": "供电时长"}
        ]
      }
    ],
    "presets": [
      {
        "name": "左文右图（使用场景+设备时长）",
        "category": "产品详情"
      }
    ]
  }
{% endschema %}