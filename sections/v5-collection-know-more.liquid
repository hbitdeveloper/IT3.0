<style>
    #shopify-section-{{ section.id }} {
        background: {{ section.settings.bg_color }};
    }

    @media only screen and (max-width: 1023.98px) {
        #shopify-section-{{ section.id }} .section-container-lg {
            width: 22.4375rem;
            margin-left: 1rem;
        }
    }
</style>

{%- capture style -%}
    {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

{%- assign s = section.settings -%}
<v5-collection-know-more
  data-view-size="{{ s.view_size | default: 3 }}"
  data-blocks-size="{{ section.blocks.size }}"
  id="mfj-{{ section.id }}"
  {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %} style="{{ style }}" class="section-padding block section-container-lg">
    <p class="title mr-4 lg:mr-0 font-semibold lg:text-5xl text-[1.75rem] text-[#242F20] text-center whitespace-pre-wrap lg:mb-16 mb-10">{{ s.heading | escape }}</p>
    <div class="flex flex-col gap-6 items-start justify-center w-full -mr-4 lg:mr-0">
        <div class="relative w-full">
            <div class="swiper overflow-hidden w-full" data-mfj-swiper>
                <div class="swiper-wrapper">
                    {%- for block in section.blocks -%}
                        {%- assign b = block.settings -%}

                        <div class="swiper-slide h-[22.5rem] lg:h-[33.5rem] w-[16.875rem] lg:w-auto overflow-hidden relative shrink-0" {{ block.shopify_attributes }}>
                            {%- if b.pcimage != blank or b.mimage != blank -%}
                                {% assign img_alt = b.title | default: b.pcimage.alt | default: 'image alt' %}
                                {% render 'diff-end-img', pc_img: b.pcimage, mb_img: b.mimage,
                                      pc_img_width: 424,
                                      mb_img_width: 270,
                                      class: 'w-full h-full max-w-none object-cover object-center',
                                      alt: img_alt %}
                            {%- else -%}
                                {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-full h-full' }}
                            {%- endif -%}

                            <div class="absolute lg:left-8 left-3.5 lg:bottom-8 bottom-6 lg:w-[85%] w-[14.5rem]">
                                <div class=" flex items-center justify-start gap-3">
                                    <div class="bg-primary w-[0.1197rem] self-stretch"></div>
                                    <div class="flex flex-col lg:gap-2 gap-4" style="color: {{ b.text_color | default: '#ffffff' }}">
                                        <p class="sub-title font-semibold text-xl lg:text-[1.75rem] leading-[1.1] whitespace-pre-wrap line-clamp-2">{{ b.title | escape }}</p>
                                        <p class="font-normal text-xs lg:text-sm leading-normal whitespace-pre-wrap lg:line-clamp-4 line-clamp-2">{{ b.description | escape }}</p>
                                    </div>
                                </div>

                                {%- if b.learn_more_label != blank and b.learn_more_url != blank -%}
                                    <a class="border border-solid border-white flex items-center justify-center lg:h-12 lg:w-48
                                        w-[8.625rem] h-10 px-8 py-3 lg:mt-[2.875rem] mt-[3.125rem]"
                                       style="border-color: {{ b.text_color | default: '#ffffff' }}; color: {{ b.text_color | default: '#ffffff' }};"
                                       href="{{ b.learn_more_url | default: '#' }}" aria-label="{{ b.learn_more_label | escape }}">
                                        <span class="font-semibold text-base lg:text-xl leading-normal whitespace-nowrap">{{ b.learn_more_label | escape }}</span>
                                    </a>
                                {%- endif -%}
                            </div>
                        </div>
                    {%- endfor -%}
                </div>
            </div>
            {% comment %} PC 轮播按钮（移动端隐藏） {% endcomment %}
            <div class="mfj-navs hidden items-center justify-center gap-10 px-[3.75rem] w-full pt-6">
                <div class="rounded-[2.75rem] w-10 h-10 cursor-pointer"
                        type="button" data-mfj-prev aria-label="上一张">
                    {% render 'v5-icon-arrow-left' %}
                </div>
                <div class="rounded-[2.75rem] w-10 h-10 cursor-pointer"
                        type="button" data-mfj-next aria-label="下一张">
                    {% render 'v5-icon-arrow-right' %}
                </div>
            </div>
        </div>
    </div>
</v5-collection-know-more>

<script src="{{ 'sections-v5-collection-know-more.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5品类聚合页-了解更多产品",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "PC上边距",
      "default": 96
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "PC下边距",
      "default": 96
    },
    {
      "type": "text",
      "id": "mb_padding_type",
      "default": "custom",
      "label": "MB边距",
      "visible_if": "{{ false }}"
    },
    {
      "type": "number",
      "id": "padding_top_mb",
      "label": "MB上边距",
      "default": 128
    },
    {
      "type": "number",
      "id": "padding_bottom_mb",
      "label": "MB下边距",
      "default": 64
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题文案",
      "default": "More From Jackery"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "背景颜色"
    },
    {
      "type": "select",
      "id": "view_size",
      "label": "PC显示个数",
      "visible_if": "{{ false }}",
      "options": [
        {
          "value": "3",
          "label": "3个"
        },
        {
          "value": "4",
          "label": "4个"
        }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "轮播卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "pcimage",
          "info": "建议图片尺寸：424 x 536",
          "label": "PC图片"
        },
        {
          "type": "image_picker",
          "id": "mimage",
          "info": "建议图片尺寸：540 x 720",
          "label": "MB图片"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "文案颜色",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Solar Generation"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "描述文案",
          "default": "Perfect for camping, RV trips, emergencies, and home backup."
        },
        {
          "type": "text",
          "id": "learn_more_label",
          "label": "Learn More 文案",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "learn_more_url",
          "label": "Learn More 链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5品类聚合页-了解更多产品",
      "category": "V5.0",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
