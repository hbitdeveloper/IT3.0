{{ 'sections-v5-letter.css' | asset_url | stylesheet_tag }}
<div class="v5-letter" {{ section.shopify_attributes }}>
  <div class="top-letter">
    <div class="letter-inner">
      <div class="letter-left">
        <img
          sizes="(max-width: 1023.98px) 39.2vw, 198px"
          srcset="{{section.settings.letter_img | image_url: width: 150 }} 150w, {{section.settings.letter_img | image_url: width: 198 }} 198w, {{section.settings.letter_img | image_url: width: 300 }} 300w, {{section.settings.letter_img | image_url: width: 400 }} 400w"
          fetchpriority="high"
          class="logo"
          width="198"
          height="100%"
          src="{{section.settings.letter_img | image_url: width: 10 }}"
          alt="{{section.settings.letter_img.alt}}"
        >
      </div>
      <div class="letter-line"></div>

      <div class="mobile-box">
        {%- assign textColor = '<em style="color: ' | append: section.settings.text_one_color | append: '">' -%}
        <div class="letter-center">{{ section.settings.text_one | replace: '<em>', textColor }}</div>

        <div class="letter-line-mini pc-block"></div>

         {%- assign textColorTwo = '<em style="color: ' | append: section.settings.text_two_color | append: '">' -%}
        <div class="letter-right">
          {{ section.settings.text_two | replace: '<em>', textColorTwo }}

          <span class="info-icon"
              data-ga-event="section_subscribe_banner_user_clicks"
              data-ga-action="mouseenter"
              data-ga-params-module="Trust Badges"
              data-ga-params-button_name="InfoIcon"
            >i
            <div class="tooltip-letter">
              {{ section.settings.text_icon }}
            </div>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "V5首页-信任状",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "letter_img",
      "label": "左侧品牌logo图片"
    },
    {
      "type": "richtext",
      "id": "text_one",
      "label": "信任状文本一",
      "info": "提示：选中文本设置斜体可标记品牌色。",
    },
     {
      "type": "color",
      "id": "text_one_color",
      "label": "信任状文本一文案突出颜色",
      "default": "#fd5000"
    },
    {
      "type": "richtext",
      "id": "text_two",
      "label": "信任状文本二",
      "info": "提示：选中文本设置斜体可标记品牌色。"
    },
     {
      "type": "color",
      "id": "text_two_color",
      "label": "信任状文本二文案突出颜色",
      "default": "#fd5000"
    },
    {
      "type": "text",
      "id": "text_icon",
      "label": "icon文本"
    }
  ],
  "presets": [
    {
      "name": "V5首页-信任状",
      "category": "内容展示",
      "settings": {}
    }
  ]
}
{% endschema %}
