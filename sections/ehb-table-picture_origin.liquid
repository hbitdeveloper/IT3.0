<style>
    .ehb-fixed-header .product-table .table-container {
        max-height: 68vh;
        overflow-y: auto;
    }
    .ehb-fixed-header .product-table .table-column {
        position: sticky;
        top: 0;
        z-index: 8;
    }

    .ehb-fixed-header .product-table .table-container {
        overflow-x: auto;
    }
    .ehb-fixed-header .product-table .table-column:first-child {
        position: sticky;
        left: 0;
        z-index: 9; 
    }
    .ehb-fixed-header .product-table tbody tr .table-row:first-child {
        position: sticky;
        left: 0;
        background-color: #ffffff; 
        z-index: 7; 
    }


    .ehb-fixed-table .product-table table {
        border-radius: 2rem 2rem 0 0;
    }
    .ehb-fixed-table .product-table thead {
        overflow: hidden;
    }
    .ehb-fixed-table .product-table .table-column {
        padding: 0 1rem;
        height: 6.125rem;
        background-color: var(--jds-color-primary);
        font-size: 1.875rem;
        color: #ffffff;
    }
    .ehb-fixed-table .product-table .table-row p {
        font-size: 1.125rem;
        line-height: 1.375rem;
        padding: 0 1rem;
        min-width: 10rem;
    }
    .ehb-fixed-table .product-table .table-row div {
        padding: 0.5rem 0;
        min-height: 4.5rem;
        font-size: 1.125rem;
        line-height: 1.375rem;
        color: #000000;
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
    }
    .ehb-fixed-table .product-table .table-row div em {
        color: var(--jds-color-primary);
    }

    .ehb-fixed-table .product-table .table-row div h6 {
        font-size: 0.625rem;
        color: rgba(0,0,0,0.4);
        line-height: 1.5;
    }

    @media screen and (max-width: 1024px) {
        .ehb-fixed-table .product-table table {
            border-radius: 1.4rem 1.4rem 0 0;
        }
        .ehb-fixed-table .product-table .table-column {
            padding: 0 0.5rem;
            height: 3.75rem;
            font-size: 1rem;
        }
        .ehb-fixed-table .product-table .table-row p {
            font-size: 0.75rem;
            line-height: 1.5;
            padding: 0 0.5rem;
            min-width: 8rem;
        }
        .ehb-fixed-table .product-table .table-row div {
            padding: 0.2rem 0;
            font-size: 0.75rem;
            line-height: 1.5;
            color: #000000;
        }
    }
</style>

<div class="ehb-fixed-table {% if section.settings.fixed_head == true %}ehb-fixed-header{% endif %}">
    {% content_for 'blocks' %}
</div>

{% schema %}
{
    "name": "EHB table",
    "class": "ehb-table-picture",
    "enabled_on": {
      "templates": ["page"]
    },
    "settings": [
        { 
            "type": "checkbox", 
            "id": "fixed_head", 
            "label": "表头固定", 
            "default": true 
        }
    ],
    "blocks": [{
      "type": "product-table"
    }]
}
{% endschema %}