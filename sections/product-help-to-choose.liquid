{%- render 'fix-v5-product-style' -%}
<div class="tabs-header flex cal_scroll_target" data-sticky-ready="false">
  <ul class="section-container J-tabs-point">
    <li class="active" data-point="features">{{ 'products.product.feature' | t }}</li>
    {% if section.settings.tabs_five_title != blank%}
        <li data-point="video">{{ section.settings.tabs_five_title }}</li>
      {% endif %}
    <li data-point="specs">{{ 'products.product.specs' | t }}</li>
    <li data-point="faq">{{ 'products.product.faq' | t }}</li>
    <li data-point="reviews">{{ 'products.product.review' | t }}</li>
  </ul>
</div>
{% if section.settings.hide_section == "true" %}
    <style>
        .product-help-choose-wrapper {padding-bottom:var(--content-distance);border-radius: var(--g-radius);}
        .product-help-choose-wrapper .layer-container {padding: 70px 36px;background:#fff;border-radius: var(--g-radius);}
        .product-help-choose-wrapper .help-to-choose>.px-60  {padding: 0;}
        .content-for-layout .product-title {
            margin-bottom: var(--content-distance);
            text-align: center;
        }
        .product-help-to-choose{var(--p-top) 0;}
        .power-station .header{text-align: center;}
        .power-station .header>img{float: right;margin-top: 12px;cursor: pointer;}
        .power-station .content{margin-top: 80px;}
        .power-station .content .image{flex: 50% 0 0;}
        .power-station .content .text{margin-left: 45px;flex: auto;}
        @media screen and (max-width: 1024px) {
            .product-help-choose-wrapper {padding: var(--content-distance) var(--gap);}
            .power-station .header{display:flex;flex-direction:column;align-items: center;}
            .power-station .header > img {width: 14px;height: 14px;}
            .power-station .content{flex-direction: column;}
            .power-station .content{margin-top:20px;}
            .power-station .content .image{flex: 100% 0 0;margin-bottom:20px;}
            .product-help-choose-wrapper {padding-bottom: 0;}
        }

        .product-contrast {
            --contrast-gap: 30px; --param-top: 24px; --select: 48px; --repeat: repeat(3, 1fr);
            margin-top: var(--content-distance);
            display: none;
        }
        .product-contrast .display-none {display: none;}
        .contrast-wrap {display: flex; grid-template-columns: var(--repeat); grid-gap: var(--gap); justify-content: center;}
        .contrast-product {background: var(--normal-color);display: flex;flex-direction: column;}
        .contrast-wrap .main-pdt { padding-top: 98px; }
        .contrast-wrap li {width: 33%; background: var(--normal-color); text-align: center; padding: var(--contrast-gap) var(--gap);}
        .contrast-wrap li .name {font-size: 24px; line-height: 39px; font-weight: 500; color: var(--text-main-color); padding: 0 var(--contrast-gap);}
        .contrast-wrap li .name a {color: var(--text-main-color);}
        .contrast-wrap .param {
            padding: 0 var(--contrast-gap); margin-top: var(--param-top); color: var(--text-black);
            display: flex; flex-direction: column; align-items: center;
        }
        .contrast-wrap .select-product {width: 100%; height: var(--select); margin-bottom: var(--gap);}
        .contrast-wrap select.select-product {
            border-radius: var(--radius); border: 1px solid var(--primary-color); padding: 0 var(--contrast-gap) 0 var(--gap);
            -webkit-appearance: none; -moz-appearance: none; appearance: none; text-overflow: ellipsis;
            background: #FFF8F6 url("https://cdn.shopify.com/s/files/1/0550/0524/9633/files/arrow-down.png?v=1679535875") no-repeat right 14px center;
            background-size: 16px;
        }
        .contrast-wrap .more {margin: var(--contrast-gap) auto;}
        .contrast-wrap .more a {color: var(--primary-color);}
        .contrast-wrap .more a:hover {color: var(--normal-color);}
        @media screen and (max-width: 1024px) {
            .product-contrast {
                --param-top: 6px; --repeat: 1fr; --gap: 20px;
            }
        .contrast-wrap {display: block;}
        .contrast-wrap li {width: 100%; margin-bottom: var(--gap);}
            .contrast-wrap li .name {font-size: 18px; line-height: 28px;}
        .contrast-wrap .main-pdt { padding-top: 10px; }
        .contrast-product:nth-child(3) {display: none;}
        }
    </style>
    <link rel="stylesheet" href="{{ 'pdp-v3-content.min.css' | asset_url }}">

    <div {% if section.settings.anchor != blank %} data-anchor="{{section.settings.anchor}}" {% endif %} class="product-help-choose-wrapper section-container relative product-b {% if section.settings.section_type %} product-p-t{% endif %}">
        {% comment %} 智能选购模块接入 {% endcomment %}
        {% render 'help-to-choose', title: section.settings.help_choose_title, chooseIpImage: section.settings.help_choose_ip, rechargingIcon: section.settings.recharging_icon, savingIcon: section.settings.energy_saving_icon, %}

        {% if section.settings.need_image != blank and section.settings.need_heading != blank and section.settings.need_desc != blank %}
        <div class="power-station layer-container">
        <div class="header jky-text-xl font-500">
            <span>{{ section.settings.need_title }}</span>
            <img loading="lazy" class="J-header-slide slide-up" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033" alt="{{section.settings.need_title}}">
        </div>
        <div class="content flex">
            <div class="image">
            <img src="{{ section.settings.need_image | image_url: width: 2000 }}" alt="{{section.settings.need_image.alt}}" loading="lazy">
            </div>
            <div class="text">
            <p class="subtitle jky-text-lg font-500">{{ section.settings.need_heading }}</p>
            <div class="desc jky-text-base">
                {{ section.settings.need_desc }}
            </div>
            </div>
        </div>
        </div>
        {% endif %}
    </div>

    <div class="product-contrast J-product-contrast section-container" style="overflow: hidden;">
    <h2 class="product-title jky-text-2xl section-container">{{'products.product.product_comparison' | t}}</h2>
    <ul class="contrast-wrap"></ul>
    </div>
{% endif %}

<script src="{{ 'pdp-v3-content.min.js' | asset_url }}" defer></script>
{%- assign current_variant = product.selected_or_first_available_variant -%}
<script type="module">
    document.addEventListener('DOMContentLoaded', function() {
        const productContrastInfo = new ProductContrast({
            currentVariant: {
                "id": {{ current_variant.id | json }},
                "sku": {{ current_variant.sku | json }},
                "availability" : {{ current_variant.available | json }},
                "price" : "{{ current_variant.price | money }}",
                "compare_at_price" : "{{ current_variant.compare_at_price | money }}",
                {% if  product.variants.size > 0  %}
                    "batteryInfos": {{current_variant.metafields.custom.batteryInfos.value | json}}
                {% else %}
                    "batteryInfos": {{product.metafields.custom.batteryInfos.value | json}}
                {% endif %}
            },
            productVariants: {
                {%- for variant in product.variants -%}
                "{{ variant.id }}": {
                    "id": {{ variant.id | json }},
                    "sku": {{ variant.sku | json }},
                    "availability" : {{ variant.available | json }},
                    "price" : "{{ variant.price | money }}",
                    "compare_at_price" : "{{ variant.compare_at_price | money }}",
                    {% if  product.variants.size > 0  %}
                    "batteryInfos": {{variant.metafields.custom.batteryInfos.value | json}}
                    {% else %}
                    "batteryInfos": {{product.metafields.custom.batteryInfos.value | json}}
                    {% endif %}
                }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
            },
            helpToChoose: {pageType: "{{section.settings.page_type}}", hideRecommended: {{section.settings.hide_recommended}}}
        })
    })
</script>

{% schema %}
{
    "name": "product help to choose",
    "class": "product-help-to-choose product-section-block",
    "tag": "div",
    "enabled_on": {
      "templates": ["product"]
    },
    "settings": [
        {
          "type": "checkbox",
          "id": "section_type",
          "default": false,
          "label": "是否为大版块？",
          "info": "大版块与上一个模块之间间距大，小版块与上一模块间距较小"
        },
        {"type": "text", "id": "tabs_five_title", "label": "Tabs title"},
        {
            "type": "select",
            "id": "anchor",
            "label": "锚点设置",
            "info": "非锚点section请清空此项",
            "options": [
                {
                "value": "",
                "label": "非锚点section"
                },
                {
                "value": "anchor__1",
                "label": "第一个section锚点"
                },
                {
                "value": "anchor__2",
                "label": "第二个section锚点"
                },
                {
                "value": "anchor__3",
                "label": "第三个section锚点"
                },
                {
                "value": "anchor__4",
                "label": "第四个section锚点"
                }
            ],
            "default": ""
        },
        {
            "type": "select",
            "id": "hide_section",
            "options": [
                {
                    "value": "false",
                    "label": "隐藏版块"
                },
                {
                    "value": "true",
                    "label": "显示版块"
                }
            ],
            "default": "false",
            "label": "显示隐藏该版块？",
            "info": "不要直接隐藏整个版块-section小眼睛那儿"
        },
        {
            "type": "select",
            "id": "page_type",
            "options": [
                {
                    "value": "pps_detail",
                    "label": "pps系列"
                },
                {
                    "value": "sp_gather",
                    "label": "sp系列"
                },
                {
                    "value": "sg_gather",
                    "label": "sg系列"
                }
            ],
            "default": "sg_gather",
            "label": "产品类型【pps/sg/sp】"
        },
        {
            "type": "checkbox",
            "id": "hide_recommended",
            "default": false,
            "label": "是否隐藏推荐？"
        },
        {"type": "textarea", "id": "help_choose_title", "label": "Help To Choose Title", "default": "How Many Solar Panels Do I Need"},
        {"type": "image_picker", "id": "help_choose_ip", "label": "Help Choose IP Image"},
        {"type": "image_picker", "id": "recharging_icon", "label": "Recharging Icon Image"},
        {"type": "image_picker", "id": "energy_saving_icon", "label": "Energy Saving Icon Image"},
        {
        "type": "text", "id": "need_title", "label": "title",
        "default": "How to Connect Solar Panels to Power Station?"
        },
        {"type": "image_picker", "id": "need_image", "label": "need image"},
        {
        "type": "text", "id": "need_heading", "label": "heading",
        "default": "Four SolarSaga 100 for the Explorer 1500"
        },
        {
        "type": "richtext", "id": "need_desc", "label": "need desc",
        "default": "<p>...</p>"
        }
    ],
    "presets": [{
        "name": "product help choose"
    }]
}
{% endschema %}