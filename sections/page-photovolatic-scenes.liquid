
{% assign tabItems = section.blocks | where: 'type', 'tab_item' %}
{% comment %} Tab Swiper Three {% endcomment %}
<section class="w-full flex-center flex-col bg-#333333 px-40 pt-48 pb-80 lg:px-0 lg:j-py-50 xl:a-py-50">
  {% if section.settings.title != blank %}
    <h2 class="w-full lg:j-w-1000 xl:a-w-1000 text-center font-600 text-white text-48 leading-60 mb-60 lg:j-text-40 lg:j-leading-48 lg:j-mb-35 xl:a-text-40 xl:a-leading-48 xl:a-mb-35">
      {{ section.settings.title | newline_to_br }}
    </h2>
  {% endif %}
  {% if section.settings.sub_title != blank %}
    <h3 class="w-full lg:j-w-1000 xl:a-w-1000 text-center font-400 text-white text-32 leading-48 -mt-40 mb-60 lg:j-text-18 lg:j-leading-26 -lg:j-mt-15 lg:j-mb-40 xl:a-text-18 xl:a-leading-26 -xl:a-mt-15 xl:a-mb-40">
      {{ section.settings.sub_title | newline_to_br }}
    </h3>
  {% endif %}
  <div class="hidden w-full flex-center flex-col relative">
    <ul class="swiper-balcony-tab-wrap-pc flex-between border-0 border-#C4C4C4/50 border-solid relative lg:j-w-1100 lg:j-border-b-3 lg:j-gap-x-80 xl:a-w-1100 xl:a-border-b-2 xl:a-gap-50">
      {% for block in tabItems %}
        <li
          class="text-center cursor-pointer font-600 text-white/80 lg:j-text-36 lg:j-leading-48 lg:j-py-5 lg:j-max-w-250 xl:a-text-36 xl:a-leading-48 xl:a-py-5 xl:a-max-w-250 lg:line-clamp-2"
          data-balcony-tab-item
          data-video-url="{{ block.settings.video_url }}"
          data-pc-image-url="{{ block.settings.poster }}"
          data-mb-image-url="{{ block.settings.mbPoster }}"
        >
          {{ block.settings.scene_name | escape }}
        </li>
      {% endfor %}
      <li class="text-center absolute left-0 bottom-0 bg-white transition-all duration-300 lg:j-w-0 lg:j-h-6 -lg:j-bottom-4 xl:a-w-0 xl:a-h-4 -xl:a-bottom-3" data-balcony-tab-deco></li>
    </ul>

    {% comment %} PC 端 Swiper {% endcomment %}
    <div class="swiper swiper-balcony-tab-content-pc w-full lg:j-min-h-560 lg:j-mt-25 xl:a-min-h-560 xl:a-mt-25">
        <div class="swiper-wrapper w-full lg:j-min-h-560 xl:a-min-h-560">
            {% for block in tabItems %}
              <div
                class="swiper-slide !lg:j-w-1100 !xl:a-w-1100"
                data-video-url="{{ block.settings.video_url }}"
                data-index="{{ forloop.index0 }}"
                data-pc-image-url="{{ block.settings.poster }}"
                data-mb-image-url="{{ block.settings.mbPoster }}"
              >
                <p class="font-400 text-white lg:flex-1 lg:j-text-20 lg:j-leading-32 lg:j-mb-24 xl:a-text-20 xl:a-leading-32 xl:a-mb-24 lg:line-clamp-3">
                  {{ block.settings.scene_description | newline_to_br }}
                </p>
                <div class="overflow-hidden !lg:j-w-1100 lg:j-h-560 lg:j-rounded-12 !xl:a-w-1100 xl:a-h-560 xl:a-rounded-12">
                  {% if block.settings.video_url != blank %}
                    {%
                      render 'jky-video',
                        poster: block.settings.poster,
                        mbPoster: block.settings.mbPoster,
                        video_url: block.settings.video_url,
                        autoplay: false,
                        loop: block.settings.loop,
                        controls: block.settings.controls
                    %}
                  {% else %}
                    {% comment %} image {% endcomment %}
                    {% render 'responsive-image',
                      image: block.settings.poster,
                      mimage: block.settings.mbPoster,
                      image_class: 'w-full h-full object-cover'
                    %}
                  {% endif %}
                </div>
              </div>
            {% endfor %}
        </div>

        {% comment %} PC Navigation {% endcomment %}
        <div class="flex swiper-button-next swiper-tab-pc-button-next"></div>
        <div class="flex swiper-button-prev swiper-tab-pc-button-prev"></div>
    </div>
  </div>

  {% comment %} MB 端 {% endcomment %}
  {% comment %} 展开 {% endcomment %}
  {% if section.settings.mobile_expand_all %}
    <div class="hidden w-full swiper-balcony-tab-content-mb" data-expand="{{ section.settings.mobile_expand_all }}">
      <ul class="w-full flex flex-col gap-y-40">
        {% for block in tabItems %}
          <li class="w-full">
              <h2 class="font-600 text-48 leading-96 text-white">{{ block.settings.scene_name | escape }}</h2>
              <p class="font-400 text-32 leading-44 mt-16 mb-30 text-white/80">
                {{ block.settings.scene_description | newline_to_br }}
              </p>
              <div
                class="w-full h-600 rounded-24 overflow-hidden"
                data-video-url="{{ block.settings.video_url }}"
                data-index="{{ forloop.index0 }}"
                data-pc-image-url="{{ block.settings.poster }}"
                data-mb-image-url="{{ block.settings.mbPoster }}"
              >
                {% if block.settings.video_url != blank %}
                  {%
                    render 'jky-video',
                      poster: block.settings.poster,
                      mbPoster: block.settings.mbPoster,
                      video_url: block.settings.video_url,
                      autoplay: false,
                      loop: block.settings.loop,
                      controls: block.settings.controls
                  %}
                {% else %}
                  {% comment %} image {% endcomment %}
                  {% render 'responsive-image',
                    image: block.settings.poster,
                    mimage: block.settings.mbPoster,
                    image_class: 'w-full h-full object-cover rounded-24'
                  %}
                {% endif %}
              </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% else %}
    <div class="hidden w-full swiper swiper-balcony-tab-content-mb pb-142" data-expend="{{ section.settings.mobile_expand_all }}">
      <div class="swiper-wrapper">
        {% for block in tabItems %}
          <div
            class="swiper-slide flex-col bg-transparent"
            data-video-url="{{ block.settings.video_url }}"
            data-index="{{ forloop.index0 }}"
            data-pc-image-url="{{ block.settings.poster }}"
            data-mb-image-url="{{ block.settings.mbPoster }}"
          >
              <h2 class="w-full text-left font-600 text-48 leading-56 mb-24 text-white">{{ block.settings.scene_name | escape }}</h2>
              <p class="font-400 text-32 leading-44 mt-16 mb-30 text-white/80">
                {{ block.settings.scene_description | newline_to_br }}
              </p>
              <div class="w-full h-384 relative rounded-24 overflow-hidden" data-url="{{ block.settings.video_url }}">
                {% if block.settings.video_url != blank %}
                  {%-
                    render 'jky-video',
                      poster: block.settings.poster,
                      mbPoster: block.settings.mbPoster,
                      video_url: block.settings.video_url,
                      autoplay: false,
                      loop: block.settings.loop,
                      controls: block.settings.controls
                  -%}
                {% else %}
                  {% comment %} image {% endcomment %}
                  <picture class="w-full h-full">
                    <source media="(min-width:1024px)" srcset="{{ block.settings.poster | image_url: width: 1920 }}">
                    <img
                      class="w-full h-full object-cover"
                      src="{{ block.settings.poster | image_url: width: 750 }}"
                      alt="{{ block.settings.poster.alt }}"
                      loading="lazy"
                      width="{{ block.settings.poster.width }}"
                      height="{{ block.settings.poster.height }}"
                    >
                  </picture>
                {% endif %}
              </div>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination swiper-tab-pagination"></div>
      <div class="swiper-button-next swiper-balcony-tab-button-next"></div>
      <div class="swiper-button-prev swiper-balcony-tab-button-prev"></div>
    </div>
  {% endif %}
</section>

{% comment %} 单个图片 {% endcomment %}
{% if section.settings.pc_more_img != blank %}
  <section class="w-full bg-white flex-center px-40 my-80 lg:px-0 lg:j-mt-80 lg:j-mb-108 xl:a-mt-80 xl:a-mb-108">
    {% comment %} image {% endcomment %}
    <picture class="w-full h-1960 rounded-24 lg:j-w-1280 lg:j-h-778 lg:j-rounded-12 xl:a-w-1280 xl:a-h-778 xl:a-rounded-12 overflow-hidden">
      <source media="(min-width:1024px)" srcset="{{ section.settings.pc_more_img | image_url: width: 1920 }}">
      <img
        class="w-full h-full object-cover"
        src="{{ section.settings.mb_more_img | image_url: width: 750 }}"
        alt=""
        loading="lazy"
      >
    </picture>
  </section>
{% endif %}

{% schema %}
  {
    "name": "photovolatic Scenes",
    "class": "section-photovolatic section-photovolatic-scenes",
    "presets": [
      {
        "name": "photovolatic Scenes",
        "category": "光伏安装"
      }
    ],
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "textarea",
        "id": "sub_title",
        "label": "Sub Title"
      },
      {
        "type": "image_picker",
        "id": "pc_more_img",
        "label": "PC More Image"
      },
      {
        "type": "image_picker",
        "id": "mb_more_img",
        "label": "Mobile More Image"
      },
      {
        "type": "checkbox",
        "id": "mobile_expand_all",
        "label": "Mobile 平铺展开全部",
        "default": true,
        "info": "关闭后，Mobile端显示，类似于PC端，需要左右切换"
      }
    ],
    "blocks": [
      {
        "type": "tab_item",
        "name": "Tab item",
        "limit": 4,
        "settings": [
          {
            "type": "text",
            "id": "scene_name",
            "label": "Scene Name"
          },
          {
            "type": "textarea",
            "id": "scene_description",
            "label": "Scene Description"
          },
          {
            "type": "image_picker",
            "id": "poster",
            "label": "PC 封面图片"
          },
          {
            "type": "image_picker",
            "id": "mbPoster",
            "label": "Mobile 封面图片"
          },
          {
            "type": "url",
            "id": "video_url",
            "label": "视频地址",
            "info": "本地视频建议视频大小不超过20MB"
          },
          {
            "type": "checkbox",
            "id": "loop",
            "label": "循环播放？",
            "default": false,
            "info": "开启后，按顺序播放功能将失效"
          },
          {
            "type": "checkbox",
            "id": "controls",
            "label": "显示播放控件？",
            "default": true
          }
        ]
      }
    ]
  }
{% endschema %}
