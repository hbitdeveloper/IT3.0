        { "type": "text", "id": "button_front_text", "label": "活动文案【斜线=文案突出】"},
        { "type": "color", "id": "button_front_text_color", "label": "活动文案突出颜色", "default": "#FFFFFF" },
        { "type": "color_background", "id": "activity_button_color", "label": "活动按钮背景色", "default": "#FFFFFF" }
      ]
    }
