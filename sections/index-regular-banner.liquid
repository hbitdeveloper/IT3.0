
<div
  class="index-regular-banner"
  data-autoplay="{{section.settings.autoplay}}"
  data-delay="{{section.settings.swiperInterval}}"
>
  <section class="w-screen">
    <div class="swiper-container autoplay-{{section.settings.autoplay}}">
      <div class="swiper-wrapper">
        {% comment %} 遍历 {% endcomment %}
        {% for block in section.blocks %}
          {% if block.type == 'general' %}
            <div class="swiper-slide overflow-hidden">
              <div class="slide-inner flex ">
                {% assign general = block | where: 'type', 'general' | first %}
                {% render 'index-general-banner', general: general, new_window: section.settings.new_window, index: forloop.index %}
              </div>
            </div>
          {% else %}
            <div class="swiper-slide overflow-hidden">
              <div class="slide-inner flex ">
                {% assign activity = block | where: 'type', 'activity' | first %}
                {% render 'index-activity-banner', activity: activity, new_window: section.settings.new_window, index: forloop.index%}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="swiper-arrow swiper-button-next"></div>
        <div class="swiper-arrow swiper-button-prev"></div>
      {% endif %}
      <div class="slideshow-pagination"></div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "首页-常规Banner",
  "disabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto Play",
      "default": false
    },
    {
      "type": "range",
      "id": "swiperInterval",
      "label": "Swiper Interval (Unit: s)",
      "default": 5,
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s"
    },

    { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false }
  ],
  "blocks": [
    {
      "type": "general",
      "name": "普通",
      "settings": [
        { "type": "image_picker", "id": "pc_image", "label": "PC图片(必填)", "info": "大小: 1920*800" },
        { "type": "image_picker", "id": "mb_image", "label": "MB图片(必填)", "info": "大小: 750x1000" },
        {
          "type": "header",
          "content": "图片加载场景配置"
        },
        {
          "type": "select",
          "id": "load_scene",
          "label": "图片加载场景",
          "options": [
            { "value": "lcp", "label": "首屏关键图（LCP）" },
            { "value": "default", "label": "普通图（默认）" },
            { "value": "defer", "label": "次要/延后图" }
