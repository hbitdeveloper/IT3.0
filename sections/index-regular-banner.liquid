            { "value": "left-top", "label": "左上" },
            { "value": "center-top", "label": "中上" },
            { "value": "right-top", "label": "右上" },
            { "value": "left-center", "label": "左中" },
            { "value": "right-center", "label": "右中" }
          ],
          "default": "left-top"
        },
        {
          "type": "select",
          "id": "mb_position",
          "label": "移动端文案位置",
          "options": [
            { "value": "left", "label": "左中" },
            { "value": "center", "label": "中" },
            { "value": "right", "label": "右中" }
          ],
          "default": "left"
        },
        { "type": "url", "id": "link", "label": "跳转地址(必填)" },
        { "type": "richtext", "id": "title", "label": "PC主标题【斜线=文案突出】"},
        { "type": "color", "id": "pc_main_color", "label": "PC主标题文案颜色", "default": "#FFFFFF"},
        { "type": "richtext", "id": "title-mb", "label": "MB主标题【斜线=文案突出】"},
        { "type": "color", "id": "mb_main_color", "label": "MB主标题文案颜色", "default": "#FFFFFF"},
        { "type": "color", "id": "title_main_color", "label": "主标题突出文案颜色"},
        { "type": "richtext", "id": "sub_title", "label": "PC副标题【斜线=文案突出】"},
        { "type": "color", "id": "pc_sub_main_color", "label": "PC副标题文案颜色", "default": "#FFFFFF" },
        { "type": "richtext", "id": "mb_sub_title", "label": "MB副标题【斜线=文案突出】"},
        { "type": "color", "id": "mb_sub_main_color", "label": "MB副标题文案颜色", "default": "#FFFFFF" },
        { "type": "color", "id": "sub_title_main_color", "label": "副标题突出文案颜色", "default": "#FFFFFF" },
        { "type": "text", "id": "button_text", "label": "按钮文案" },
        { "type": "color", "id": "button_color", "label": "按钮颜色", "default": "#fd5000" }
