{{ 'section-stories-recruit-button.min.css' | asset_url | stylesheet_tag }}
<div class="stories-button">
  <div class="stories-button-body">
    <div class="button-title">{{ section.settings.recruit_button }}</div>
    <div class="button-icon">
      <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 34" fill="none">
        <g fill="#F5F5F5" fill-rule="nonzero">
          <path
            d="M25.972 34H5.23C2.393 34 0 31.58 0 28.8V8.001c0-2.869 2.305-5.2 5.23-5.2h12.853c.71 0 1.33.628 1.33 1.345 0 .718-.62 1.345-1.33 1.345H5.23c-1.418 0-2.66 1.166-2.66 2.6V28.89c0 1.345 1.242 2.6 2.66 2.6h20.654c1.418 0 2.659-1.166 2.659-2.6V13.11c0-.717.62-1.344 1.33-1.344.709 0 1.33.627 1.33 1.344v15.69c-.09 2.868-2.394 5.199-5.23 5.199z"/>
          <path
            d="M24.731 28.531H6.648c-.709 0-1.33-.627-1.33-1.344 0-.718.621-1.345 1.33-1.345h18.083c.71 0 1.33.627 1.33 1.345 0 .717-.62 1.344-1.33 1.344zm2.482-17.571l-6.205-6.186 3.457-3.496c1.685-1.704 4.521-1.704 6.205 0C31.557 2.084 32 3.16 32 4.326c0 1.165-.443 2.24-1.33 3.137l-3.457 3.497zm-2.482-6.276l2.482 2.51 1.685-1.613c.265-.359.443-.717.443-1.255 0-.538-.178-.897-.532-1.255a1.805 1.805 0 00-2.57 0L24.73 4.684z"/>
          <path
            d="M10.46 24.049c-.71 0-1.33-.27-1.773-.807-.62-.628-.886-1.614-.62-2.42l.886-3.497c.089-.269.266-.717.62-1.076L22.87 2.891l6.205 6.186L15.69 22.525c-.355.358-.71.538-1.064.627h-.089l-3.457.807c-.266.09-.443.09-.62.09zm.886-5.917l-.798 3.317 3.369-.807L25.44 9.167l-2.482-2.51-11.612 11.475z"/>
          <path d="M12.41 16.07l3.546 3.496-1.596 1.524-3.546-3.496z"/>
        </g>
      </svg>

    </div>
  </div>
  <jds-icon name="close" class="mb-close-icon"></jds-icon>
</div>
<div class="stories-main-pop">
  <div class="higher-output-box">
    <jds-icon name="close-line" class="pop-close-icon"></jds-icon>
    {% comment %} 购买意向表单 {% endcomment %}
    {% render 'stories-recruit-form' %}
  </div>
</div>

<script src="{{ 'section-stories-recruit-button.min.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Jackery Strories Button",
  "class": "section-jackery-stories-button",
  "settings": [
    {
      "type": "textarea",
      "id": "recruit_button",
      "default": "SHARE YOUR STORY",
      "label": "招募表按钮"
    }
  ],
  "presets": [
    {
      "name": "Stories Button"
    }
  ]
}
{% endschema %}
