</style>


{%- assign countdown_title = section.settings.countdown_title -%}
{%- assign endTime = section.settings.end_time_str | escape -%}

{% comment %} 黑五倒计时 {% endcomment %}
{% if countdown_title != blank and endTime != blank %}
    <section id="black-friday-countdown">
        <div class="w-full min-h-800 px-64 py-135 lg:j-min-h-400 lg:j-px-0 lg:j-py-85 xl:a-min-h-400 xl:a-px-0 xl:a-py-85 flex-center flex-col bg-#0F0F0F">
            <h2 class="w-full text-center font-bold text-white text-110 leading-126 lg:j-max-w-800 lg:j-text-72 lg:j-leading-80 xl:a-max-w-800 xl:a-text-72 xl:a-leading-80">
                {{ countdown_title | newline_to_br }}
            </h2>
            <div class="w-full flex-center flex-col mt-40 lg:j-max-w-800 lg:j-mt-24 xl:a-max-w-800 xl:a-mt-24">
                {% comment %} 倒计时 {% endcomment %}
                <div class="w-full flex-center flex-col text-center" data-countdown-main>
                    <h3 class="font-bold text-white/60 text-32 leading-48 lg:j-text-20 lg:j-leading-28 xl:a-text-20 xl:a-leading-28">
                        {{ section.settings.countdown_subtitle | newline_to_br }}
                    </h3>
                    <div
                        class="times flex gap-x-45 mt-24 mb-18 lg:j-gap-x-26 lg:j-mt-8 lg:j-mb-12 xl:a-gap-x-26 xl:a-mt-8 xl:a-mb-12"
                        data-countdown-time
                    ></div>
                    <div
                        class="labels flex gap-x-45 lg:j-gap-x-26 xl:a-gap-x-26"
                        data-countdown-label="{{ section.settings.countdown_labels | escape }}"
                    ></div>
                </div>

                {% comment %} 倒计时结束文案 {% endcomment %}
                {%- assign endText = section.settings.countdown_end_text -%}
                {% if endText != blank %}
                    <div
                        class="
                            hidden w-full min-h-234 text-center text-32 leading-48 mt-40
                            lg:j-min-h-126 lg:j-text-20 lg:j-leading-28 lg:j-mt-16
                            xl:a-min-h-126 xl:a-text-20 xl:a-leading-28 xl:a-mt-16
                        "
                        data-countdown-end
                    >
                        <p class="font-medium text-white/90 mb-40 lg:j-mb-24 xl:a-mb-24">
                            {{ endText | newline_to_br }}
                        </p>
                        {% if section.settings.end_viewmore_url != blank and section.settings.end_viewmore != blank %}
                            <p class="flex-center">
                                <a class="end-view-more" href="{{ section.settings.end_viewmore_url }}">{{ section.settings.end_viewmore | escape }}</a>
                                <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
                            </p>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <script defer>
        const CountdownConfig = {
            showSeconds: "{{ section.settings.countdown_show_seconds }}",
            endTime: "{{ endTime }}",
        }
    </script>
    <script src="{{ 'countdown.bundle.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
    {
        "name": "Countdown Section",
        "settings": [
            {"type": "textarea", "id": "countdown_title", "label": "Countdown Title", "default": "BLACK FRIDAY"},
            {"type": "textarea", "id": "countdown_subtitle", "label": "Countdown Subtitle", "default": "Sale Countdown"},

            {"type": "text", "id": "end_time_str", "label": "Countdown End Time", "info": "rules is matter, YYYY/MM/DD hh:mm:ss, such as: 2023/01/01 00:00:00"},
            {"type": "textarea", "id": "countdown_labels", "label": "Countdown Labels", "default": "Days,Hrs,Mins,Secs", "info": "请用英文逗号,隔开"},
            {"type": "checkbox", "id": "countdown_show_seconds", "label": "Countdown Show Seconds", "default": true},

            {"type": "textarea", "id": "countdown_end_text", "label": "Countdown End Text"},
            {"type": "text", "id": "end_viewmore", "label": "View More Button Text", "default": "VIEW MORE"},
            {"type": "url", "id": "end_viewmore_url", "label": "View More Button Url"}
       ]
    }
{% endschema %}
