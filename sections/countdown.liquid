        transition-duration: 500ms;
        border-bottom-width: 1px;
    }

    #black-friday-countdown a.end-view-more::after {
        position: absolute;
        display: block;
        width: 95%;
        transform-origin: left;
        transform: scale(0);
        border-color: var(--primary-color);
        border-style: solid;
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 150ms;
        transition-duration: 500ms;
        content: '';
        bottom: -1px;
        left: 0vw;
        border-bottom-width: 1px;
        border-top-width: 0;
    }

    #black-friday-countdown a.end-view-more:hover::after {
        transform: scale(1);
        border-color: rgba(227, 71, 0, 1);
    }

