<style>
  {% comment %} drop-down [trigger-content] {
      max-height: calc(100vh - 30rem);
  } {% endcomment %}
  drop-down [trigger-content] {
      display: none;
      opacity: 0;
      transform: translateY(-0.5rem);
      will-change: height, opacity, transform;
      transition: height 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  drop-down[open='true']>.pdp-v5-specs-item_trigger>.trigger--summery svg {
      transform: rotate(180deg);
  }

  .section-pdp-specs-v5 .pdp-v5-specs-item_header {
      box-sizing: border-box;
      height: 4.5rem;
      padding-right: 1rem;
      padding-left: 1rem;
      z-index: 1;
      transform: translateZ(0);
      backface-visibility: hidden;
  }

  .section-pdp-specs-v5 .pdp-v5-specs-item_trigger {
      -webkit-tap-highlight-color: transparent;
      user-select: none;
  }

  .section-pdp-specs-v5 .pdp-v5-specs-item_header:not(.pdp-specs-v5-content .pdp-v5-specs-item_header) {
    background: #f2f4f5;
    transition: background 0.3s ease-in-out;
  }

  .section-pdp-specs-v5 .pdp-v5-specs-item_header:not(.pdp-specs-v5-content .pdp-v5-specs-item_header):hover {
    background: #e8eced;
  }

  .pdp-v5-specs-item_header h3 {
      color: #242F20;
      flex: 1 1 auto;
      min-width: 0;
      line-height: 1.2;
      margin: 0;
  }

  .pdp-v5-specs-item_header svg {
      display: block;
      flex: none;
      transform-origin: center;
      will-change: transform;
      backface-visibility: hidden;
  }

  .pdp-v5-specs-item_header .trigger--summery__underline {
      height: 1px;
      background: #C6C7C8;
  }

  .pdp-v5-specs-item__content .pdp-v5-specs-item__unit:last-child {
      margin-bottom: 0;
  }

  .section-pdp-specs-v5 .pdp-specs-v5_heading {
      color: #242F20;
      font-size: 5.25rem;
      line-height: 1.1;
  }

  @media (max-width: 1024px) {
      .section-pdp-specs-v5 .pdp-specs-v5_heading {
          font-size: 2.25rem;
      }

      .pdp-v5-specs-item_header {
          height: 3rem;
      }

      .section-pdp-specs-v5 .pdp-v5-specs-item_header {
        height: 3.5rem;
        padding-right: 0.75rem;
        padding-left: 0.75rem;
    }
  }
</style>

<div
  class="lg:pt-24 pt-12 lg:pb-16 pb-6 section-container-lg"
  {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
>
  {%- if section.settings.heading != blank -%}
    <h2 class="pdp-specs-v5_heading v5-font-oxm font-extrabold lg:text-center text-left lg:mb-8 mb-4 mx-auto">{{ section.settings.heading | replace: "\n", "<br>" | strip}}</h2>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- liquid
      assign item_heading = ''
      if block.type == 'pdp_specs'
        assign item_heading = block.settings.part_heading
      elsif block.type == 'pdp_product'
        assign item_heading = block.settings.part_1_heading
      elsif block.type == 'what_in_the_box'
        assign item_heading = block.settings.part_3_heading
      elsif block.type == 'product_manual'
        assign item_heading = block.settings.part_4_heading
      endif
    -%}

    <drop-down init="open" doc="false" class="block">
      <div 
        data-ga-event="5.0_products_details_page_user_clicks"
        data-ga-action="click" 
        data-ga-params-product_spu_name="{{ product.title | escape }}"
        data-ga-params-module="Parameter"
        data-ga-params-position="{{ item_heading | escape }}"
        data-ga-params-type="fold"
        trigger class="cursor-pointer bg-white pdp-v5-specs-item_trigger list-none relative"
      >
        <div class="pdp-v5-specs-item_header trigger--summery flex items-center justify-between relative">
          <h3 class="text-overflow-1 lg:text-xl text-base font-semibold">{{ item_heading }}</h3>
          <svg class="lg:w-6 w-4 lg:h-6 h-4 transition-all duration-300 ease-in-out" width="22" height="12" viewBox="0 0 22 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.6875 0.726563L10.6875 10.2266L20.6875 0.726563" stroke="black" stroke-opacity="0.65" stroke-width="2"/>
          </svg>
          {%- unless forloop.first -%}
          <div class="trigger--summery__underline absolute top-0 w-full left-0 lg:right-6 right-4"></div>
          {%- endunless -%}
        </div>
      </div>
      <div trigger-content class="hide-scroll-bar w-full overflow-y-auto overflow-x-hidden">
        {%- case block.type -%}
          {%- when 'pdp_specs' -%}
            {% if block.settings.version == '5' %}
              {%- render "v5-specs-variant", settings: block.settings -%}
            {% else %}
                {%- render "v5-specs-variant-5-plus", settings: block.settings, product: product -%}
            {% endif %}
          {%- when 'pdp_product' -%}
            {%- render "v5-specs-product", settings: block.settings -%}
          {%- when 'what_in_the_box' -%}
            {% if block.settings.version == '5' %}
                {%- render "v5-pdp-what-box", settings: block.settings, product: product -%}
            {% else %}
                {%- render "v5-pdp-what-box-5-plus", settings: block.settings, product: product -%}
            {% endif %}
          {%- when 'product_manual' -%}
            {%- render "v5-pdp-product-manual", settings: block.settings, product: product -%}
        {%- endcase -%}
      </div>
    </drop-down>
  {%- endfor -%}
</div>

<script>
  if (!customElements.get("drop-down")) {
    class DropDown extends HTMLElement {
      constructor() {
        super();
        this.animationDuration = 300;
        this.animationTimer = null;
        this.trigger = this.querySelector("[trigger]");
        this.content = this.querySelector("[trigger-content]");
        this.unDocClickAble = this.getAttribute("doc") === "false";
        this.init_open = this.getAttribute("init") === "open";

        if (this.trigger && this.content) {
          this.initClickTrigger();
          if (!this.unDocClickAble) {
            {% comment %} 避免重复绑定 {% endcomment %}
            this.handleDocClick = this.docClick.bind(this);
            document.addEventListener("click", this.handleDocClick);
          }
        }
      }

      connectedCallback() {
        if (this.init_open) {
          setTimeout(() => {
            this.open(true);
          }, 5000);
        } else {
          this.close(true);
        }
      }

      disconnectedCallback() {
        this.trigger.removeEventListener("click", this.handleClick);
        clearTimeout(this.animationTimer);
        if (!this.unDocClickAble) {
          document.removeEventListener("click", this.handleDocClick);
        }
      }

      handleClick = (e) => {
        e.preventDefault();
        this.hasAttribute("open") ? this.close() : this.open();
      };

      initClickTrigger() {
        this.trigger.addEventListener("click", this.handleClick);
      }

      docClick(e) {
        if (!this.contains(e.target)) {
          this.close();
        }
      }

      open(isInit = false) {
        if (this.classList.contains("closing") || this.classList.contains("opening")) return;

        this.classList.add("opening");
        this.setAttribute("open", "true");
        this.setAttribute("aria-expanded", "true");

        this.content.style.display = "block";
        this.content.style.overflow = "hidden";
        clearTimeout(this.animationTimer);

        const height = this.content.scrollHeight;

        if (isInit) {
          this.content.style.transition = "none";
          this.content.style.height = "auto";
          this.content.style.overflow = "visible";
          this.content.style.opacity = "1";
          this.content.style.transform = "translateY(0)";
          this.classList.remove("opening");
        } else {
          this.content.style.transition = "";
          this.content.style.height = "0px";
          this.content.style.opacity = "0";
          this.content.style.transform = "translateY(-0.5rem)";
          this.content.offsetHeight;
          requestAnimationFrame(() => {
            this.content.style.height = `${height}px`;
            this.content.style.opacity = "1";
            this.content.style.transform = "translateY(0)";
          });

          this.animationTimer = setTimeout(() => {
            this.content.style.height = "auto";
            this.content.style.overflow = "visible";
            this.classList.remove("opening");
          }, this.animationDuration);
        }

        this.trigger.setAttribute("data-ga-params-type", "open");
      }

      close(isInit = false) {
        if (this.classList.contains("opening") || this.classList.contains("closing")) return;

        this.classList.add("closing");
        this.setAttribute("aria-expanded", "false");
        clearTimeout(this.animationTimer);

        const height = this.content.scrollHeight;
        this.content.style.display = "block";
        this.content.style.overflow = "hidden";
        this.content.style.transition = isInit ? "none" : "";
        this.content.style.height = `${height}px`;
        this.content.style.opacity = "1";
        this.content.style.transform = "translateY(0)";
        this.content.offsetHeight;

        this.removeAttribute("open");

        if (isInit) {
          this.content.style.height = "0px";
          this.content.style.opacity = "0";
          this.content.style.transform = "translateY(-0.5rem)";
          this.content.style.display = "none";
          this.classList.remove("closing");
        } else {
          requestAnimationFrame(() => {
            this.content.style.height = "0px";
            this.content.style.opacity = "0";
            this.content.style.transform = "translateY(-0.5rem)";
          });

          this.animationTimer = setTimeout(() => {
            this.content.style.display = "none";
            this.classList.remove("closing");
          }, this.animationDuration);
        }

        this.trigger.setAttribute("data-ga-params-type", "fold");
      }
    }

    customElements.define("drop-down", DropDown);
  }
</script>

