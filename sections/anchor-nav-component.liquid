{% comment %} 11周年 锚点导航 组件 {% endcomment %}
{% schema %}
{
  "name": "Anchor Nav Component",
  "tag": "section",
  "class": "anchor-nav-component cal_scroll_target",
  "blocks": [
    {
      "name": "Items",
      "type": "slide",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "anchorID",
          "label": "Anchor ID"
        }
      ]
    }
  ]
}
{% endschema %}
{% assign total = section.blocks | size %}
<ul class="anchor-nav-box section-container" data-total="{{ total }}">
	{% for block in section.blocks %}
		<li {% if forloop.index == 1 %}
			class="active"
		{% endif %} data-index="{{ forloop.index }}" data-anchor-id="{{ block.settings.anchorID }}">{{ block.settings.title }}</li>
	{% endfor %}
</ul>
<style>
	.overflow-unset,
	[lang="ja"] .theme-v2.overflow-unset .page-container{
		overflow: unset;
	}
	.v2-ip-hide{
		position: relative;
		z-index: -1;
	}
	.anchor-nav-component{
		position: sticky;
		top: 0;
		z-index: 9;
		background-color: #fff;
		overflow-x: auto;
	}
	.anchor-nav-component::-webkit-scrollbar{
		display: none;
	}
	.anchor-nav-box{
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: nowrap;
		height: 50px;
	}
	.anchor-nav-box li{
		margin-right: 80px;
		font-size: 16px;
		font-weight: 600;
		color: rgba(0,0,0,0.5);
		line-height: 1.69;
		cursor: pointer;
		word-break: normal !important;
	}

	.anchor-nav-box li:last-child{
		margin-right: 0;
	}
	.anchor-nav-box li.active{
		color: var(--jds-color-primary);
		border-bottom: 2px solid var(--jds-color-primary);
	}
	@media screen and (max-width: 1440px){
		.anchor-nav-box{
			height: 2.6042vw;
		}
		.anchor-nav-box li{
			margin-right: 4.1667vw;
			font-size: 0.8333vw;
		}
	}
	@media screen and (max-width: 1023px){
		.anniversary-page .anchor-nav-component .section-container{
			padding:0 5.3333vw;
			max-width: none;
			width: max-content;
		}
		.anchor-nav-box{
			height: 12vw;
		}
		.anchor-nav-box li{
			margin-right: 10.6667vw;
			font-size: 4vw;
			color: #333;
			line-height: 1.19;
		}
	}
</style>
