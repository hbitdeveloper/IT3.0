<style>
  .specs-pictures {
    --spec-h: 62px; --spec-gap: 40px; --spec-row-gap: 40px; --circle: 30px;
    margin-top: var(--content-distance);
  }
  .specs-pictures .layer-container {width: 100%;}
  .specs-pictures .header {
    height: var(--spec-h); background: var(--input-border-color); padding: 0 var(--spec-gap); font-weight: 600; color: var(--text-main-color);
    display: flex; align-items: center; justify-content: space-between;
  }
  .specs-pictures .header img {cursor: pointer;}
  .specs-pictures .content {padding: var(--spec-gap);}
  .specs-pictures .content.specs-content {padding: 0;}

  .usual-box figcaption {color: var(--text-main-color); text-align: center; margin-bottom: var(--gap);}
  .usual-box {background: var(--gray-color);}

  .usual-box .item:not(:last-child):after {
    content: ""; width: 100%; height: 1px; background: var(--text-disable-color); margin: var(--spec-row-gap) 0; display: block;
  }
  .usual-box .item-info {display: flex; justify-content: center;}
  .usual-box .item-info img {object-fit:contain;max-width: 750px;min-width: 500px;}
  .usual-box .item-info .info-item {max-width: 55%; text-align: center;}
  .usual-box .item-info .info-item img {max-width: 100%;object-fit:contain;}
  .usual-box .item-info .info-item:not(:first-child) {margin-left: var(--spec-gap);}
  .usual-box .item-info ul {
    margin-left: 8%; counter-reset: li;
    display: flex; flex-direction: column; justify-content: center;
  }
  .usual-box .item-info ul li {line-height: var(--circle); padding-left: 44px; position: relative;}
  .usual-box .item-info ul li:not(:last-child) {margin-bottom: var(--circle);}
  .usual-box .item-info ul li::before {
    counter-increment: li; content: counter(li);
    width: var(--circle); height: var(--circle); line-height: var(--circle); color: var(--normal-color); text-align: center;
    background: var(--primary-color); border-radius: 15px; display: inline-block;
    position: absolute; left: 0; top: 0;
  }
  @media screen and (max-width: 768px) {
    .specs-pictures {
      --spec-h: 50px; --spec-gap: 30px; --spec-row-gap: 30px; --circle: 15px;
    }
    .specs-pictures .header img {width: 14px; height: 14px;}
    .usual-box .item-info {flex-wrap: wrap;}
    .usual-box .item-info .info-item:not(:first-child) {margin-left: 0;}
    .usual-box .item-info img {width: 100%; max-width: none; margin-bottom: var(--circle);min-width: unset;}
    .usual-box .item-info ul {margin-left: 0;}
    .usual-box .item-info ul li {padding-left: 25px;}
  }


  .specs-box {margin-top: var(--content-distance);}
  .specs-box >.header {display: flex; align-items: center; justify-content: space-between; height: 63px; background: #ddd; font-size: 26px; font-weight: 600; color: var(--text-main-color);}
  .specs-box .header img {cursor: pointer;}
  .specs-box .content {background: var(--gray-color);}
  .specs-box .content .item-box .header {display: flex; align-items: center; justify-content: space-between; height: 63px; background: #EEEEEE; font-size: 24px; font-weight: 500; color: var(--text-main-color);}
  .specs-box .content .item-box .item-box-content {padding: var(--spec-gap);}
  .specs-box .content .item-box .specs-row:not(:last-of-type) {margin-bottom: 40px;}
  .specs-box .content .item-box .specs-row .title {font-size: 26px; font-weight: 600; color: var(--text-main-color); line-height: 39px; margin-bottom: 16px;text-align: left;}
  .specs-box .content .item-box .specs-row .specs-wrap {display: grid; grid-template-columns: repeat(3,1fr); grid-row-gap: 12px;}
  .specs-box .content .item-box .specs-row .specs-item {display: flex; flex-direction: column; font-size: 18px; font-weight: 400; color: var(--text-black); line-height: 27px; padding-right: 10px;}
  .specs-box .content .item-box .specs-row .specs-item .value {color: #666;}
  @media screen and (max-width: 768px) {
    .specs-box .content .item-box .header {
      /* padding: 0 4vw; */
      height: 13.3333vw; font-size: 4.8vw;
    }
    .specs-box .content .item-box .header span {white-space: nowrap; text-overflow: ellipsis; overflow: hidden;}
    .specs-box .content .item-box .item-box-content {padding-top: 2.6667vw; padding-bottom: 2.6667vw;}
    .specs-box .content .item-box .specs-row:not(:last-of-type) {margin-bottom: 6.6667vw;}
    .specs-box .content .item-box .specs-row .title {font-size: 4.2667vw; color: #666; line-height: 6.4vw; margin-bottom: 2.6667vw; text-align: left;}
    .specs-box .content .item-box .specs-row .specs-wrap {display: block;}
    .specs-box .content .item-box .specs-row .specs-item {flex-direction: row; font-size: 2.8vw; line-height: 5.3333vw;}
    .specs-box .content .item-box .specs-row .specs-item .key {font-weight: 600;text-align: left;}
    .specs-box .content .item-box .specs-row .specs-item .value {color: var(--text-black);margin-left: 0.6667vw;}
  }


  .what-in-box {margin-top: var(--content-distance);}
  .what-in-box .notes {color: var(--text-sub-color); margin-top: 30px;}


  .user-manual {
    --manual-gap: 20px; --pdf: 44px; --media: 580px;
    margin-top: var(--content-distance);
  }
  .user-manual .content {background: var(--gray-color);}
  .user-manual .sub_title {font-weight: 600; margin-bottom: var(--manual-gap);}
  .user-manual .list {border-bottom: var(--border-grey); padding-bottom: var(--content-distance); margin-bottom: var(--content-distance);}
  .user-manual .list dd {width: 100%; margin-top: var(--manual-gap); display: flex; align-items: center; justify-content: space-between;}
  .user-manual .list .icon-pdf {font-size: var(--pdf); margin-right: var(--manual-gap);}
  .user-manual .notice:after {content: ""; display: inline-block; width: 100%; height: 1px; background: var(--text-disable-color); margin: 50px 0;}
  .user-manual .notice .sub_title {display: flex; align-items: center; justify-content: space-between;}
  .user-manual .notice .sub_title > img {cursor: pointer;}
  .user-manual .notice .item-box-content {color: var(--text-main-color);}
  @media screen and (max-width: 768px) {
    .user-manual {
      --media: 54vw;
    }
    .user-manual .list {display: grid; grid-template-columns: repeat(2, 1fr); grid-row-gap: var(-gap);}
    .user-manual .list dd {text-align: center; flex-direction: column;}
    .user-manual .list .icon-pdf {display: block; margin: var(--manual-gap) auto;}
    .user-manual .list dd button {margin-top: var(--manual-gap);}
    .notice .sub_title > img {width: 14px;}
  }


  .user-guide-swiper .slideshow-pagination {position: static; margin-top: var(--content-distance);}
  .user-guide-swiper .swiper-slide {height: fit-content; border-radius: var(--g-radius); overflow: hidden;}
  .user-guide-swiper .swiper-wrapper {height: auto;}
  .user-guide-swiper video, .user-guide-swiper img {width: 100%; height: var(--media); object-fit: cover;}
  .user-guide-swiper .text {width: 100%; background: var(--normal-color); padding: 26px; text-align: center;}
  .guide-video-box {max-width: 100%; height: var(--media); overflow: hidden;}
  .guide-video-box .vjs-big-play-button {top: 50%; left: 50%; transform: translate(-50%,-50%);}
</style>

<div class="specs-pictures" id="specs" {% if section.settings.anchor != blank %} data-anchor="{{section.settings.anchor}}"{% endif %}>
  <h2 class="product-title jky-text-2xl font-500 layer-container">{{ section.settings.title }}</h2>

  <div class="usual-box layer-container {% if section.settings.part_1_heading == blank %}hidden{% endif %}" style="{% if section.settings.part_1_heading == blank %}display: none;{% endif %}">
    <div class="header">
      <h3 class="jky-text-lg font-bold">{{ section.settings.part_1_heading }}</h3>
      <img class="J-header-slide slide-up" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033" alt="usual" loading="lazy">
    </div>

    <div class="content">
      {% if section.settings.part_1_img %}
      <figure class="item">
        <figcaption class="jky-text-xl font-500">{{ section.settings.part_1_sub }}</figcaption>
        <div class="item-info">
          {% if section.settings.part_1_img != blank %}
            {% render 'responsive-image', image: section.settings.part_1_img %}
          {% endif %}
          {% assign part_1_desc = section.blocks | where: 'type', "part_1_desc" %}
          <ul>
            {% for block in part_1_desc %}<li class="jky-text-base">{{ block.settings.desc }}</li>{% endfor %}
          </ul>
        </div>
      </figure>
      {% endif %}

      {% assign part_1_item = section.blocks | where: 'type', "part_1_item" %}
      {% for block in part_1_item %}
      <figure class="item">
        {% unless block.settings.suit_1_title != blank and block.settings.suit_2_title != blank %}
        <figcaption class="jky-text-xl font-500">{{ block.settings.suit_title }}</figcaption>
        {% endunless %}
        <div class="item-info">
          {% if block.settings.suit_1 %}
          <div class="info-item">
            {% if block.settings.suit_1_title %}<p class="jky-text-xl font-500">{{ block.settings.suit_1_title }}</p>{% endif %}
              {% render 'responsive-image', image: block.settings.suit_1 %}

            <span class="jky-text-sm">{{ block.settings.suit_1_name }}</span>
          </div>
          {% endif %}
          {% if block.settings.suit_2 %}
          <div class="info-item">
            {% if block.settings.suit_2_title %}<p class="jky-text-xl font-500">{{ block.settings.suit_2_title }}</p>{% endif %}
              {% render 'responsive-image', image: block.settings.suit_2 %}
            <span class="jky-text-sm">{{ block.settings.suit_2_name }}</span>
          </div>
          {% endif %}
        </div>
      </figure>
      {% endfor %}
    </div>
  </div>

  <div class="specs-box layer-container J-specs-box {% if section.settings.part_2_heading == blank %}hidden J-specs-box--hide{% endif %}" style="{% if section.settings.part_2_heading == blank %}display: none;{% endif %}">
    <div class="header">
      <h3 class="jky-text-lg font-bold">{{ section.settings.part_2_heading }}</h3>
      <img class="J-header-slide slide-up" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033" alt="specs" loading="lazy">
    </div>
    <div class="content specs-content"></div>
  </div>

  {% if section.settings.part_3_img %}
  <div class="usual-box what-in-box layer-container {% if section.settings.part_3_heading == blank %}hidden{% endif %}" style="{% if section.settings.part_3_heading == blank %}display: none;{% endif %}">
    <div class="header">
      <h3 class="jky-text-lg font-bold">{{ section.settings.part_3_heading }}</h3>
      <img class="J-header-slide slide-up" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033" alt="usual" loading="lazy">
    </div>
    <div class="content">
      <figure class="item">
        <div class="item-info">
          <img src="{{ section.settings.part_3_img | image_url: width: 2000 }}" alt="jackery" loading="lazy">
          {% assign part_3_desc = section.blocks | where: 'type', "part_3_desc" %}
          <ul>
            {% for block in part_3_desc %}<li class="jky-text-xs">{{ block.settings.desc }}</li>{% endfor %}
          </ul>
        </div>
      </figure>
      {{ section.settings.part_3_note | replace: '<p>', '<p class="notes jky-text-base">' }}
    </div>
  </div>
  {% endif %}

  <div class="user-manual layer-container {% if section.settings.part_4_heading == blank %}hidden{% endif %}" style="{% if section.settings.part_4_heading == blank %}display: none;{% endif %}">
    <div class="header text-left">
      <h3 class="jky-text-lg font-bold">{{ section.settings.part_4_heading }}</h3>
      <img class="J-header-slide slide-up" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033" alt="usual" loading="lazy">
    </div>
    <div class="content">
      <span class="sub_title jky-text-lg">{{ section.settings.part_4_sub }}</span>
      {% comment %} 说明书 {% endcomment %}
      <dl class="list manual-list">
        <dt class="sr-only not-manual">{{ section.settings.part_4_heading | default: 'User Manual' }}</dt>
        <dd class="sr-only not-manual">{{ section.settings.part_4_sub | default: 'Manual download list' }}</dd>
      </dl>
      {%- if section.settings.part_4_notice != blank -%}
      <div class="notice">
        <div class="sub_title">
          <span class="jky-text-lg">{{ section.settings.part_4_notice }}</span>
          <img class="J-header-item-slide slide-up" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033" alt="notice" loading="lazy">
        </div>
        {{ section.settings.part_4_note | replace: '<p>', '<p class="item-box-content jky-text-sm">' }}
      </div>
      {%- endif -%}

      <div class="video-swiper">
        <div class="sub_title jky-text-lg">{{ section.settings.part_4_sub_2 }}</div>
        <div class="user-guide-swiper swiper relative">
          <div class="swiper-wrapper">
            {% assign part_4_swiper = section.blocks | where: 'type', "part_4_swiper" %}
            {% for block in part_4_swiper %}
              <div class="swiper-slide flex flex-col">
                {% if block.settings.part_4_media %}
                  {% assign video_swiper_index = "video-swiper-" | append: forloop.index0 %}
                  {%- render 'jky-video', video_url: block.settings.part_4_media, poster: block.settings.part_4_manual, title: product.title, class: video_swiper_index, autoplay: false, controls: true, loop: false -%}
                {% else %}
                  <img src="{{ block.settings.part_4_manual | image_url: width: 2000 }}" alt="jackery" loading="lazy">
                {% endif %}
                <div class="text jky-text-sm">{{ block.settings.part_4_tips }}</div>
              </div>
            {% endfor %}
          </div>
          <div class="slideshow-pagination relative"></div>
        </div>
      </div>
    </div>
  </div>
</div>

  {%- if template == 'product.for-sale' -%}
  <script src="{{ 'pdp-v3-content.min.js' | asset_url }}" defer></script>
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  <script defer>
    (function () {
      function initProductDetailSpecs() {
      if(!(document.querySelector(".product-help-choose-wrapper") || document.querySelector('.help-to-choose'))) {
        const productContrastInfo = new ProductContrast({
          currentVariant: {
            "id": {{ current_variant.id | json }},
            "sku": {{ current_variant.sku | json }},
            "availability" : {{ current_variant.available | json }},
            "price" : "{{ current_variant.price | money }}",
            "compare_at_price" : "{{ current_variant.compare_at_price | money }}"
          },
          productVariants: {
            {%- for variant in product.variants -%}
            "{{ variant.id }}": {
              "id": {{ variant.id | json }},
              "sku": {{ variant.sku | json }},
              "availability" : {{ variant.available | json }},
              "price" : "{{ variant.price | money }}",
              "compare_at_price" : "{{ variant.compare_at_price | money }}"
            }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          },
          helpToChoose: {pageType: ''}
        })
      }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProductDetailSpecs);
      } else {
        initProductDetailSpecs();
      }
    })();
  </script>
{%- endif -%}



{% schema %}
{
  "name": "product details specs", "class": "specs", "tag": "section",
  "settings": [
    {
            "type": "select",
            "id": "anchor",
            "label": "锚点设置",
            "info": "非锚点section请清空此项",
            "options": [
                {
                "value": "",
                "label": "非锚点section"
                },
                {
                "value": "anchor__1",
                "label": "第一个section锚点"
                },
                {
                "value": "anchor__2",
                "label": "第二个section锚点"
                },
                {
                "value": "anchor__3",
                "label": "第三个section锚点"
                },
                {
                "value": "anchor__4",
                "label": "第四个section锚点"
                }
            ],
            "default": ""
    },
    {"type": "header", "content": "Part 1"},
    {"type": "text", "id": "title", "label": "title", "default": "Product Details"},
    {"type": "text", "id": "part_1_heading", "label": "Part 1 heading", "default": "Specs in Pictures"},
    {"type": "text", "id": "part_1_sub", "label": "Part 1 subtitle", "default": "Explorer 1000 Pro"},
    {"type": "image_picker", "id": "part_1_img", "label": "Part 1 image"},

    {"type": "header", "content": "Part 2"},
    {"type": "text", "id": "part_2_heading", "label": "Part 2 heading", "default": "Specs"},

    {"type": "header", "content": "Part 3"},
    {"type": "text", "id": "part_3_heading", "label": "Part 3 heading", "default": "What's in The Box"},
    {"type": "image_picker", "id": "part_3_img", "label": "Part 3 image"},
    {
      "type": "richtext", "id": "part_3_note", "label": "Part 3 Notes",
      "default": "<p>Notes: <br />1. Solar panel types and quantity depends on your purchase. <br />2. Buy 2 SolarSoga, get 1*Solar Panel Connectors. <br />3. Buy 4 or 6 SolarSoga, get 2*Solar Panel Connectors.</p>"
    },

    {"type": "header", "content": "Part 4"},
    {"type": "text", "id": "part_4_heading", "label": "Part 4 heading", "default": "User Manual"},
    {"type": "text", "id": "part_4_sub", "label": "Part 4 subtitle", "default": "BATTERY INFO"},
    {"type": "text", "id": "part_4_notice", "label": "Part 4 notice", "default": "Notice"},
    {
      "type": "richtext", "id": "part_4_note", "label": "Part 4 Notes",
      "default": "<p>* This product (portable power supply) can supply power to your device in the temperature range of -10 to 40 degrees Celsius (-10 to 65 degrees Celsius for solar panels). If the operating temperature is outside the above range, this product may not work.<br /></p>"
    },
    {"type": "text", "id": "part_4_sub_2", "label": "Part 4 subtitle 2", "default": "User Guide Videos / Pictures"},
    {"type": "url", "id": "part_4_video", "label": "feature main video"}
  ],
  "blocks": [
    {
      "type": "part_1_desc", "name": "Part 1 Describe", "limit": 8, "settings": [
        {"type": "text", "id": "desc", "label": "Description", "default": "LED Light"}
      ]
    },
    {
      "type": "part_1_item", "name": "Part 1 Suit", "settings": [
        {"type": "text", "id": "suit_title", "label": "Suit Title", "default": "SolarSaga 200W"},
        {"type": "image_picker", "id": "suit_1", "label": "Suit 1"},
        {"type": "text", "id": "suit_1_title", "label": "Suit Title 1"},
        {"type": "text", "id": "suit_1_name", "label": "Suit Name 1", "default": "Dimensions (unfolded): 21.3 x 91.3 x 1 in"},
        {"type": "image_picker", "id": "suit_2", "label": "Suit 2"},
        {"type": "text", "id": "suit_2_title", "label": "Suit Title 2"},
        {"type": "text", "id": "suit_2_name", "label": "Suit Name 2", "default": "Dimensions (folded): 21.3 x 24.2 x 1.6 in"}
      ]
    },
    {
      "type": "part_3_desc", "name": "Part 3 Describe", "limit": 8, "settings": [
        {"type": "text", "id": "desc", "label": "Description", "default": "LED Light"}
      ]
    },
    {
      "type": "part_4_swiper", "name": "Videos / Pictures", "limit": 3, "settings": [
        {"type": "image_picker", "id": "part_4_manual", "label": "User Guide Pictures"},
        {"type": "url", "id": "part_4_media", "label": "User Guide Videos"},
        {"type": "text", "id": "part_4_tips", "label": "Description", "default": "Explorer 1000 Pro User Manual"}
      ]
    }
  ],
  "presets": [{
    "name": "product details specs"
    }]
}
{% endschema %}
