<style>
    #shopify-section-{{ section.id }} {
        background: {{ section.settings.bg_color }};
    }

    .v5-brand-certification .card-container {
        border-top-width: 1px;
        border-bottom-width: 1px;
        border-style: solid;
        border-color: #c6c7c8;
    }

    .v5-brand-certification .tooltip-letter::before {
        content: '';
        position: absolute;
        bottom: -0.375rem;
        width: 0;
        height: 0;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid #f5f5f3;
    }

    .v5-brand-certification .letter-right:hover .tooltip-letter {
        display: block;
    }

    @media only screen and (min-width: 1024px) {
        .v5-brand-certification .cards .card:not(:last-child) {
            border-right: 1px solid #c6c7c8;
            padding-right: 5.2813rem;
        }
        .v5-brand-certification .cards .card:last-child .letter-right {
            right: -1.75rem;
        }
        .v5-brand-certification .tooltip-letter::before {
            right: 1.125rem;
        }
    }

    @media only screen and (max-width: 1023.98px) {
        .v5-brand-certification .cards .card {
            padding-right: 1.9375rem;
            padding-left: 0.75rem;
        }

        .v5-brand-certification .cards .card:nth-child(1) {
            border-right: 1px solid #c6c7c8;
        }
        .v5-brand-certification .cards .card:nth-child(4) {
            border-right: 1px solid #c6c7c8;
        }
        .v5-brand-certification .tooltip-letter::before {
            left: 7.375rem;
        }
    }

</style>

{%- liquid
    assign style = section.settings.pc_height | default: 220 | divided_by: 16.0 | append: 'rem;' | prepend: ' --pc-img-height:'
    assign mb_style = section.settings.mb_height | default: 128 | times: 2 | divided_by: 32.0 | append: 'rem;' | prepend: ' --mb-img-height:'
    assign style = style | append: mb_style
-%}

<div class="v5-brand-certification w-full lg:py-24 py-8">
    {% if section.settings.title != blank %}
        <div class="section-container-lg v5-font-oxm text-ink jds-display-1 text-center lg:mb-10 mb-7">{{ section.settings.title }}</div>
    {% endif %}
    <div class="card-container">
      {% comment %} my-4 lg:my-16 flex flex-wrap gap-y-4 gap-x-0 lg:gap-[3.7813rem] {% endcomment %}
        <div class="cards section-container-lg my-4 lg:my-16 flex flex-wrap gap-y-4 gap-x-0 lg:gap-[3.7813rem]">
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'certification' %}
                        <div class="card relative" style="{{ style }}" >
                            {% if block.settings.image_pc != blank or block.settings.image_mb != blank %}
                                {% assign block_desc = block.settings.description | strip_html | replace: "\n", "<br>" %}
                                {% assign img_alt = block_desc | default: block.settings.image_pc.alt | default: 'image alt' %}
                                {% render 'diff-end-img', pc_img: block.settings.image_pc, mb_img: block.settings.image_mb, class: 'w-32 lg:w-[13.75rem] h-[var(--mb-img-height)] lg:h-[var(--pc-img-height)]', pc_img_width: 220, mb_img_width: 130, alt: img_alt %}
                              {% else %}
                                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder w-32 lg:w-[13.75rem] h-[var(--mb-img-height)] lg:h-[var(--pc-img-height)]' }}
                            {% endif %}
                            {% if block.settings.description != blank %}
                                <div
                                    class="letter-right absolute lg:right-[3.625rem] right-3 top-0" data-index="{{ forloop.index }}"
                                    data-ga-action="mouseenter"
                                    data-ga-event="5.0_homepage_user_clicks"
                                    data-ga-params-position="{{ forloop.index }}"
                                    data-ga-params-button_name="InfoIcon"
                                    data-ga-params-title="{{ section.settings.title }}"
                                    data-ga-params-module="Brand Certifications"
                                >
                                  <div class="info-icon w-[1.125rem] h-[1.125rem] lg:w-6 lg:h-6 text-[#A9AAAC]">
                                      <svg class="cursor-pointer" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                          <path d="M9 7H11V5H9M10 18C5.59 18 2 14.41 2 10C2 5.59 5.59 2 10 2C14.41 2 18 5.59 18 10C18 14.41 14.41 18 10 18ZM10 0C8.68678 0 7.38642 0.258658 6.17317 0.761205C4.95991 1.26375 3.85752 2.00035 2.92893 2.92893C1.05357 4.8043 0 7.34784 0 10C0 12.6522 1.05357 15.1957 2.92893 17.0711C3.85752 17.9997 4.95991 18.7362 6.17317 19.2388C7.38642 19.7413 8.68678 20 10 20C12.6522 20 15.1957 18.9464 17.0711 17.0711C18.9464 15.1957 20 12.6522 20 10C20 8.68678 19.7413 7.38642 19.2388 6.17317C18.7362 4.95991 17.9997 3.85752 17.0711 2.92893C16.1425 2.00035 15.0401 1.26375 13.8268 0.761205C12.6136 0.258658 11.3132 0 10 0ZM9 15H11V9H9V15Z" fill="#A9AAAC"/>
                                      </svg>
                                      <div class="hidden tooltip-letter font-normal absolute bottom-7 lg:bottom-[2.125rem] -right-4 lg:-right-2.5 w-[9.25rem] lg:w-60 lg:p-4 p-2.5 text-[rgba(0,0,0,0.65)] lg:text-sm/none text-xs/none z-[2]" style="background-color: #f5f5f3;">
                                        {{ block.settings.description | replace: "\n", "<br>" }}
                                    </div>
                                  </div>
                                </div>
                            {% endif %}
                        </div>
                        {% if forloop.index == 2 %}
                            <div class="lg:hidden w-full h-px" style="background-color: #c6c7c8;"></div>
                        {% endif %}
                {% endcase %}
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "V5-产品&品牌认证",
  "settings": [
    {
      "type": "color_background",
      "id": "bg_color",
      "default": "#ffffff",
      "label": "背景颜色"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "PRODUCTS WIN AWARDS"
    },
    {
      "type": "number",
      "id": "pc_height",
      "label": "PC图片高度",
      "default": 220
    },
    {
      "type": "number",
      "id": "mb_height",
      "label": "MB图片高度",
      "default": 128
    }
  ],
  "blocks": [
    {
      "type": "certification",
      "name": "认证项",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image_pc", "label": "PC图片地址", "info":"推荐图片宽度: 220"},
        { "type": "image_picker", "id": "image_mb", "label": "MB图片地址", "info":"推荐图片宽度: 256"},
        {
          "type": "inline_richtext",
          "info": "需要换行，请使用 \\n ",
          "id": "description",
          "label": "icon文案",
          "default": "Lorem ipsum dolor sit amet consectetur. Mattis sed ultrices ullamcorper at"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5-产品&品牌认证",
      "category": "V5.0",
      "blocks": [
        {
          "type": "certification"
        },
        {
          "type": "certification"
        },
        {
          "type": "certification"
        },
        {
          "type": "certification"
        }
      ]
    }
  ]
}
{% endschema %}
