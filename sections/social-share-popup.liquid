{% schema %}
{
  "name": "社交分享弹窗",
  "tag": "section",
  "class": "social-share-popup",
  "settings": [
    {
      "type": "header",
      "content": "右下角分享icon"
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "图片Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "image_picker",
      "id": "pageShareIcon",
      "label": "Icon",
      "info": "图片Size设置为Small，icon尺寸建议为48*48，图片Size设置为Medium，icon建议为64*64，图片Size设置为Large，icon建议为80*80"
    },
    {
      "type": "number",
      "id": "pcBottom",
      "label": "PC端Icon距离底部定位（px）",
      "default": 156,
    },
    {
      "type": "number",
      "id": "mbBottom",
      "label": "移动端Icon距离底部定位（px）",
      "default": 156,
      "info": "以响应式规范进行等比换算"
    },
    {
      "type": "textarea",
      "id": "icon_note",
      "label": "注意：",
      "default": "Chatbot如果设置为small，那么当前icon距离底部建议设置为156，\n Chatbot如果设置为Medium，那么当icon距离底部建议设置为188，\n Chatbot如果设置为Large，那么当前icon距离底部建议设置为240"
    },
    {
      "type": "header",
      "content": "分享弹窗"
    },
    {
      "type": "text",
      "id": "popupTitle",
      "label": "弹窗标题",
      "default": "Share"
    },
    {
      "type": "text",
      "id": "insShareSuccessText",
      "label": "Ins分享成功提示语",
      "default": "Copy successfully,open Instagram to post!"
    },
    {
      "type": "text",
      "id": "copySuccessText",
      "label": "复制链接成功提示语",
      "default": "Copy successfully!"
    }
  ],
  "blocks": [
    {
      "name": "社交平台",
      "type": "slide",
      "settings": [
        {
          "type": "select",
          "id": "type",
          "label": "类型",
          "default": "facebook",
          "options": [
            {
              "label": "Facebook",
              "value": "facebook"
            },
            {
              "label": "Twitter",
              "value": "twitter"
            },
            {
              "label": "Instagram",
              "value": "instagram"
            },
            {
              "label": "WhatsApp",
              "value": "whatsapp"
            },
            {
              "label": "Line",
              "value": "line"
            },
            {
              "label": "Copy Link",
              "value": "copy-link"
            },
            {
              "label": "Refer A Friend",
              "value": "refer-a-friend"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题"
        },
        {
          "type": "url",
          "id": "link",
          "label": "'Refer A Friend' 超链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "页面社交分享弹窗"
    }
  ]
}
{% endschema %}

{{ 'section-social-share-popup.min.css' | asset_url | stylesheet_tag }}

{% assign icon_size = 48 %}
{% assign share_icon_width  = '3rem' %}
{% assign share_icon_height = '3rem' %}

{% if section.settings.icon_type == 'medium' %}
  {% assign icon_size = 64 %}
  {% assign share_icon_width  = '4rem' %}
  {% assign share_icon_height = '4rem' %}
{% elsif section.settings.icon_type == 'large' %}
  {% assign icon_size = 80 %}
  {% assign share_icon_width  = '5rem' %}
  {% assign share_icon_height = '5rem' %}
{% endif %}

{% assign icon_url_width = icon_size | times: 2 %}

{% if section.settings.pcBottom == blank %}
  {% assign share_icon_pc_bottom = '156px' %}
{% else %}
  {% assign share_icon_pc_bottom = section.settings.pcBottom | append: 'px' %}
{% endif %}

{% comment %} 移动端以750px分辨率为基准进行等比换算 {% endcomment %}
{% if section.settings.mbBottom == blank %}
  {% assign share_icon_mb_bottom = 156 | divided_by: 16.0 | append: 'rem' %}
{% else %}
  {% assign share_icon_mb_bottom = section.settings.mbBottom | divided_by: 16.0 | append: 'rem' %}
{% endif %}

<div
  class="popup-wrapper"
  style="
    --share-icon-pc-bottom:{{ share_icon_pc_bottom }};
    --share-icon-pc-medium-bottom:{{ share_icon_pc_medium_bottom }};
    --share-icon-mb-bottom:{{ share_icon_mb_bottom }};
    --share-icon-width:{{ share_icon_width }};
    --share-icon-height:{{ share_icon_height }}"
>
  {% comment %} 右下角分享icon {% endcomment %}
  {% if section.settings.pageShareIcon %}
    {% render 'responsive-image', image: section.settings.pageShareIcon,width: icon_url_width,mwidth: icon_url_width, image_class: 'page-share-icon object-cover object-center' %}
  {% else %}
