      		d="M28.5275 31.6739C28.1207 31.6739 27.7433 31.5171 27.4541 31.2279C27.1753 30.9504 27.0154 30.5754 27.0081 30.1821C27.0008 29.7888 27.1466 29.4081 27.4149 29.1204L27.4247 29.1106L40.3441 16.1912L40.349 16.1863C40.6284 15.9217 40.9959 15.7795 41.3831 15.7795C41.7899 15.7795 42.1673 15.9364 42.4565 16.2255C42.7352 16.5031 42.8952 16.8781 42.9025 17.2714C42.9098 17.6646 42.7639 18.0453 42.4957 18.333L42.4859 18.3428L29.5665 31.2622L29.5616 31.2671C29.2822 31.5269 28.9146 31.6739 28.5275 31.6739ZM27.9687 29.6399C27.6943 29.9438 27.6992 30.4045 27.9932 30.6937C28.1354 30.8358 28.3265 30.9191 28.5324 30.9191C28.7235 30.9191 28.9048 30.8456 29.047 30.7182L41.9517 17.8135C42.2261 17.5096 42.2212 17.0489 41.9272 16.7598C41.785 16.6176 41.5939 16.5343 41.388 16.5343C41.1969 16.5343 41.0155 16.6078 40.8734 16.7353L27.9687 29.6399Z"
      		fill="white"></path>
    </svg>
  {% endif %}

  {% comment %} 页面社交分享弹窗 {% endcomment %}
  <div
    class="dialog-wrapper"
    data-ins-success-txt="{{ section.settings.insShareSuccessText }}"
    data-copy-success-txt="{{ section.settings.copySuccessText }}"
  >
    <div class="overlay"></div>
    <div class="content">
      <p class="title">{{ section.settings.popupTitle }}</p>
      {% render 'icon-close', class: 'icon-close ', width: 22, height: 22, color: '#121212' %}
      <ul>
        {% for block in section.blocks %}
          <li class="social-item item-{{ block.settings.type }}" data-type="{{ block.settings.type }}">
            {% if block.settings.type == 'refer-a-friend' %}
              <a href="{{ block.settings.link }}">
                <img
                  src="{{ block.settings.icon | image_url: width: 88 }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy"
                  width="44"
                  height="44"
                  loading="lazy"
                >
                <p>{{ block.settings.title }}</p>
              </a>
            {% else %}
              <img
                src="{{ block.settings.icon | image_url: width: 88 }}"
                alt="{{ block.settings.title }}"
                loading="lazy"
                width="44"
                height="44"
                loading="lazy"
              >
              <p>{{ block.settings.title }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

<script src="{{ 'section-social-share-popup.min.js' | asset_url }}" defer></script>
