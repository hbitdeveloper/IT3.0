                {"type": "image_picker", "id": "picPhone11", "label": "Phone Image11"},
                {"type": "image_picker", "id": "pic12", "label": "Image12"},
                {"type": "image_picker", "id": "picPhone12", "label": "Phone Image12"},
                {"type": "image_picker", "id": "pic13", "label": "Image13"},
                {"type": "image_picker", "id": "picPhone13", "label": "Phone Image13"},
                {"type": "image_picker", "id": "pic14", "label": "Image14"},
                {"type": "image_picker", "id": "picPhone14", "label": "Phone Image14"},
