                {"type": "image_picker", "id": "pic16", "label": "Image16"},
                {"type": "image_picker", "id": "picPhone16", "label": "Phone Image16"}
            ]
        },
        {
            "type": "video_swiper", "name": "Video Swiper",
            "settings": [
                {"type": "textarea", "id": "title", "label": "Heading", "default": "Two line slide title - 1."},
                {"type": "url", "id": "link", "label": "Slide link"},
                {"type": "text", "id": "link_text", "label": "Slide link text", "default": "{{ 'general.action_text.view_more' | t }}"},
                {"type": "url", "id": "video_url", "label": "Video url"},
                {"type": "image_picker", "id": "video_pic", "label": "poster Image"}
            ]
        }
    ]
}
