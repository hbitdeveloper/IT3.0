<style>
    .topheader {
        position: fixed!important;
        top: 0;
        height: 100vh;
        left: 0;
        right: 0;
        z-index: 10009;
    }
    .max-top {
        z-index: 9999!important;
    }
    #MainContent .page-banner-content .jky-text-3xl {
        color: #000;
    }

    #MainContent .text-break-word {
        word-break: break-word;
    }
</style>

<script>
    window.locale_explore_more = `{{ 'general.action_text.explore_more' | t }}`;
    window.locale_view_more = `{{ 'general.action_text.view_more' | t }}`;
</script>

<script>
    var storyData={
        timeLine:[
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'page_story_timeLine' %}
                        { bg:'{{block.settings.bg | image_url}}',
                          bgPhone:'{{block.settings.bgPhone | image_url}}',
                          year:'{{block.settings.year}}',
                          point: [
                            {% for block2 in section.blocks %}
                                {%- assign story_year = block.settings.year | prepend: 'page_story_timeLine_' -%}
                                {% case block2.type %}
                                    {% when story_year %}
                                        {
                                            phonePic:`{{block2.settings.phonePic | image_url}}`,
                                            bigPic:`{{block2.settings.bigPic | image_url}}`,
                                            smallPic:`{{block2.settings.smallPic | image_url}}`,
                                            text:`{{block2.settings.text}}`
                                        },
                                {% endcase %}
                            {% endfor %}
                          ]
                        },
                {% endcase %}
            {% endfor %}
        ],
        certifcationsAndAwards:{
            list:[
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'p_story_ca_l' %}
                            {num:'{{block.settings.num}}',title:'{{block.settings.title}}',title2:'{{block.settings.title2}}'},
                    {% endcase %}
                {% endfor %}
        ],
            swiper:[
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'p_story_ca_s' %}
                            {title:'{{block.settings.title}}',picPhone:'{{block.settings.picPhone | image_url}}',pic:'{{block.settings.pic | image_url}}'},
                    {% endcase %}
                {% endfor %}
            ]
        },
        recognizedBy:{
            list:[
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'p_story_rc_list' %}
                             '{{block.settings.pic0 | image_url}}',
                             '{{block.settings.pic1 | image_url}}',
                             '{{block.settings.pic2 | image_url}}',
                             '{{block.settings.pic3 | image_url}}',
                             '{{block.settings.pic4 | image_url}}',
                             '{{block.settings.pic5 | image_url}}',
                             '{{block.settings.pic6 | image_url}}',
                             '{{block.settings.pic7 | image_url}}',
                             '{{block.settings.pic8 | image_url}}',
                             '{{block.settings.pic9 | image_url}}',
                            '{{block.settings.pic10 | image_url}}',
                            '{{block.settings.pic11 | image_url}}',
                            '{{block.settings.pic12 | image_url}}',
                            '{{block.settings.pic13 | image_url}}',
                            '{{block.settings.pic14 | image_url}}',
                            '{{block.settings.pic15 | image_url}}',
                            '{{block.settings.pic16 | image_url}}',
                            '{{block.settings.pic17 | image_url}}'
                    {% endcase %}
                {% endfor %}
            ],
            listPhone:[
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'p_story_rc_list' %}
                            '{{block.settings.picPhone0 | image_url}}',
                            '{{block.settings.picPhone1 | image_url}}',
                            '{{block.settings.picPhone2 | image_url}}',
                            '{{block.settings.picPhone3 | image_url}}',
                            '{{block.settings.picPhone4 | image_url}}',
                            '{{block.settings.picPhone5 | image_url}}',
                            '{{block.settings.picPhone6 | image_url}}',
                            '{{block.settings.picPhone7 | image_url}}',
                            '{{block.settings.picPhone8 | image_url}}',
                            '{{block.settings.picPhone9 | image_url}}',
                            '{{block.settings.picPhone10 | image_url}}',
                            '{{block.settings.picPhone11 | image_url}}',
                            '{{block.settings.picPhone12 | image_url}}',
                            '{{block.settings.picPhone13 | image_url}}',
                            '{{block.settings.picPhone14 | image_url}}',
                            '{{block.settings.picPhone15 | image_url}}',
                            '{{block.settings.picPhone16 | image_url}}'
                    {% endcase %}
                {% endfor %}
            ]
        }
    }
</script>
    {% render 'pages-banner', blocks: section.blocks, autoplay_speed: section.settings.autoplay_speed, autoplay: section.settings.autoplay %}
    <div id="ourStory">
        {% for block in section.blocks %}
            {% case block.type %}
                {% when 'page_story_solar' %}
                    <div id="solar" class="hideText">
                        <div class="grayFrame">
                            <div class="bigTitle jky-text-3xl font-bold">
                                {{block.settings.title}}
                            </div>
                            <div class="subText jky-text-sm font-300">
                                {{block.settings.text}}
                            </div>
                            <div class="viewMoreButton PCHide">
                                <div class="viewMoreTitle">{{ 'general.action_text.view_more' | t }}</div>
                                <jds-icon name="arrow-down" class="iconfont jackery-icon-arrowdown text-sm"></jds-icon>
                            </div>
                        </div>
                    </div>
                {% endcase %}
        {% endfor %}
                    <div id="timeLine" class="MobileHide">
                        <div class="swiper timeLineSwiper">
                            <div class="swiper-wrapper">

                            </div>
                        </div>
                        <div class="rightFrame">

                        </div>
                    </div>
                    <div id="timeLine" class="PCHide">
                        <div class="swiper timeLineMobileSwiper">
                            <div class="swiper-wrapper">

                            </div>
                        </div>
                        <div class="nav">

                        </div>
                        <div class="nextFrame">
                            <div class="title">2016</div>
                            <img src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/Shape_2x_4da76ec4-1706-49e8-ae1a-5724fb8ff2f0.png?v=1675061979" loading="lazy" class="down" />
                        </div>
                    </div>
                    <div id="videoSwiper">
                        <div class="bigTitle">{{ 'sections.story.video_swiper_title' | t }}</div>
                        <div class="section video-swiper">
                            {% assign vblocks = section.blocks | where: 'type', "video_swiper" %}
                            {% render 'video-swiper', blocks: vblocks %}
                        </div>
                    </div>
                    <div id="certifcationsAndAwards">
                        <div class="bigTitle">{{ 'sections.story.awards_block_heading' | t }}</div>
                        <div class="subText">{{ 'sections.story.awards_block_subheading' | t }}</div>
                        <div class="list">

                        </div>
                        <div class="CertifcationsAndAwardsSwiperFrame">
                            <div class="swiper CertifcationsAndAwardsSwiper">
                                <div class="swiper-wrapper">

                                </div>
                                <div class="swiper-button-next MobileHide">
                                    {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
                                </div>
                                <div class="swiper-button-prev MobileHide">
                                    {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
                                </div>
                                <div class="swiper-pagination"></div>
                            </div>
                        </div>
                    </div>
                    <div id="recognizedBy" class="listHide">
                        <div class="bigTitle">{{ 'sections.story.organizations_heading' | t }}</div>
                        <div class="list">

                        </div>
                        <div class="viewMoreButton" style="display: none;">
                            <div class="viewMoreTitle">{{ 'general.action_text.view_more' | t }}</div>
                            {% comment %} <i class="iconfont jackery-icon-arrowdown"></i> {% endcomment %}
                            <jds-icon name="arrow-down" class="jackery-icon-arrowdown"></jds-icon>
                        </div>
                    </div>



    </div>


{% schema %}
{
    "name": "Page story main",
    "class": "section-page-story",
    "max_blocks": 200,
    "settings": [
        {"type": "checkbox", "id": "autoplay", "label": "Auto-change slides", "default": true},
        {"type": "range", "id": "autoplay_speed", "label": "Change images every", "default": 7, "min": 5, "max": 10, "step": 1, "unit": "s"}
    ],
    "blocks": [
        {
            "type": "page_banner", "name": "Page Banner",
            "settings": [
                {"type": "textarea", "id": "title", "label": "Heading", "default": "Explore Further\nwith Jackery Solar"},
                {"type": "url", "id": "link", "label": "Slide link"},
                {"type": "text", "id": "link_text", "label": "Slide link text", "default": "{{ 'general.action_text.view_more' | t }}"},
                {"type": "image_picker", "id": "image", "label": "Image"},
                {"type": "image_picker", "id": "m_image", "label": "Mobile Image"},
                {"type": "image_picker", "id": "banner_icon", "label": "Banner Icon Image"}
            ]
        },
        {
            "type": "page_story_solar", "name": "Page Story Solar",
            "settings": [
                {"type": "textarea", "id": "title", "label": "title", "default": "Explore Further with Jackery Solar"},
                {"type":"textarea","id":"text","label":"text","default": "Founded in 2012 in California, USA, Jackery was born with a vision to offer green energy to everyone, everywhere. In 2016, Jackery launched the world's first outdoor portable power stations and, two years later, developed the world's first portable solar panels. Having introduced solar generators to the great outdoors, Jackery fulfills the power needs of every nature-lover, inspiring them to explore further and seek more extraordinary experiences than before. We encourage global adventurers to enjoy the outdoors sustainably, working together to protect our planet and build a better future."}
            ]
        },
        {
            "type": "page_story_timeLine", "name": "Page Story TimeLine",
            "settings": [
                {"type": "image_picker", "id": "bg", "label": "Background Image"},
                {"type": "image_picker", "id": "bgPhone", "label": "Phone Background Image"},
                {"type": "textarea", "id": "year", "label": "year", "default": "2012"}
            ]
        },
        {
            "type": "page_story_timeLine_2012", "name": "Page Story TimeLine 2012",
            "settings": [
                {"type": "image_picker", "id": "phonePic", "label": "Phone Image"},
                {"type": "image_picker", "id": "bigPic", "label": "Background Image"},
                {"type": "image_picker", "id": "smallPic", "label": "Small Image"},
                {"type": "textarea", "id": "text", "label": "Text"}
            ]
        },
        {
            "type": "page_story_timeLine_2016", "name": "Page Story TimeLine 2016",
            "settings": [
                {"type": "image_picker", "id": "phonePic", "label": "Phone Image"},
                {"type": "image_picker", "id": "bigPic", "label": "Background Image"},
                {"type": "image_picker", "id": "smallPic", "label": "Small Image"},
                {"type": "textarea", "id": "text", "label": "Text"}
            ]
        },
        {
            "type": "page_story_timeLine_2018", "name": "Page Story TimeLine 2018",
            "settings": [
                {"type": "image_picker", "id": "phonePic", "label": "Phone Image"},
                {"type": "image_picker", "id": "bigPic", "label": "Background Image"},
                {"type": "image_picker", "id": "smallPic", "label": "Small Image"},
                {"type": "textarea", "id": "text", "label": "Text"}
            ]
        },
        {
            "type": "page_story_timeLine_2020", "name": "Page Story TimeLine 2020",
            "settings": [
                {"type": "image_picker", "id": "phonePic", "label": "Phone Image"},
                {"type": "image_picker", "id": "bigPic", "label": "Background Image"},
                {"type": "image_picker", "id": "smallPic", "label": "Small Image"},
                {"type": "textarea", "id": "text", "label": "Text"}
            ]
        },
        {
            "type": "page_story_timeLine_2022", "name": "Page Story TimeLine 2022",
            "settings": [
                {"type": "image_picker", "id": "phonePic", "label": "Phone Image"},
                {"type": "image_picker", "id": "bigPic", "label": "Background Image"},
                {"type": "image_picker", "id": "smallPic", "label": "small Image"},
                {"type": "textarea", "id": "text", "label": "text"}
            ]
        },
        {
            "type": "page_story_timeLine_2023", "name": "Page Story TimeLine 2023",
            "settings": [
                {"type": "image_picker", "id": "phonePic", "label": "Phone Image"},
                {"type": "image_picker", "id": "bigPic", "label": "Background Image"},
                {"type": "image_picker", "id": "smallPic", "label": "small Image"},
                {"type": "textarea", "id": "text", "label": "text"}
            ]
        },
        {
            "type": "p_story_ca_l", "name": "CA List",
            "settings": [
                {"type": "textarea", "id": "num", "label": "Number"},
                {"type": "textarea", "id": "title", "label": "Title"},
                {"type": "textarea", "id": "title2", "label": "Sub Title"}
