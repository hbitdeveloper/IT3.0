{%- style -%}
  #shopify-section-{{ section.id }} {
    margin-top: calc({{ section.settings.margin_top | default: 0 }} / 16 * 1rem);
    margin-bottom: calc({{ section.settings.margin_bottom | default: 0 }} / 16 * 1rem);
  }
  {% if section.settings.mb_margin_type == 'custom' %}
    @media (max-width: 1023.98px) {
      #shopify-section-{{ section.id }} {
        margin-top: calc({{ section.settings.margin_top_mb | default: 0 }} / 16 * 1rem);
        margin-bottom: calc({{ section.settings.margin_bottom_mb | default: 0 }} / 16 * 1rem);
      }
    }
  {% endif %}

  #se-{{ section.id }} {
    height: calc(({{ section.settings.mb_image_height | default: 640 }} + 480) / 32 * 1rem);
  }
  @media (min-width: 1024px) {
    #se-{{ section.id }} {
      height: calc(({{ section.settings.pc_image_height | default: 350 }} + 290) / 16 * 1rem);
      --se-img-w: calc({{ section.settings.pc_image_width | default: 350 }} / 16 * 1rem);
      --se-img-h: calc({{ section.settings.pc_image_height | default: 350 }} / 16 * 1rem);
    }
    #se-{{ section.id }} .se-slide--3-w{
      width: calc(({{ section.settings.pc_image_width | default: 350 }} * 3 + 64) / 16 * 1rem);
    }
    #se-{{ section.id }} .se-slide--5-w{
      width: calc(({{ section.settings.pc_image_width | default: 350 }} * 21 / 5 + 152) / 16 * 1rem);
    }
    #shopify-section-{{ section.id }} .se-swiper {
      height: var(--se-img-h);
    }
    #shopify-section-{{ section.id }} .se-swiper .swiper-slide {
      transition: transform 500ms ease, opacity 500ms ease;
    }
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5 {
      transform: translateX(0);
    }
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5.swiper-slide-active,
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5.swiper-slide-duplicate-active {
      transform: translateX(0);
    }
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5.swiper-slide-prev,
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5.swiper-slide-duplicate-prev{
      transform: translateX(-0.625rem) scale(1);
    }
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5.swiper-slide-next,
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5.swiper-slide-duplicate-next{
     transform: translateX(0.625rem) scale(1);
    }
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5.swiper-slide .img-box-early{
      flex-shrink: 0;
      transition: width 500ms ease, height 500ms ease;
      width: calc(var(--se-img-w) * 4 / 5);
      height: calc(var(--se-img-h) * 4 / 5);
    }
    #shopify-section-{{ section.id }} .se-swiper .se-slide--3 .img-box-early{
      width: var(--se-img-w);
      height: var(--se-img-h);
      transform: scale(calc((var(--se-img-w) - 3.25rem) / var(--se-img-w)));
      transition: transform 500ms ease;
    }
    #shopify-section-{{ section.id }} .se-swiper .se-slide--3.swiper-slide-active .img-box-early,
    #shopify-section-{{ section.id }} .se-swiper .se-slide--3.swiper-slide-duplicate-active .img-box-early{
      transform: scale(1);
    }
    #shopify-section-{{ section.id }} .se-swiper .se-slide--3.swiper-slide-active,
    #shopify-section-{{ section.id }} .se-swiper .se-slide--3.swiper-slide-duplicate-active {
      transform: scale(1);
      opacity: 1;
    }
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5.swiper-slide-active .img-box-early,
    #shopify-section-{{ section.id }} .se-swiper .se-slide--5.swiper-slide-duplicate-active .img-box-early{
      width: var(--se-img-w);
      height: var(--se-img-h);
    }
  }

  #shopify-section-{{ section.id }} .relative .swiper-button-next,
  #shopify-section-{{ section.id }} .relative .swiper-button-prev{
    color: #FFFFFF;
    width: 3rem;
    height: 3rem;
    border: 2px solid #FFFFFF4D;
    border-radius: 50%;
    transition: transform 0.5s ease, border-color 0.5s ease;
  }
  #shopify-section-{{ section.id }} .relative .swiper-button-prev{ left:-4rem; }
  #shopify-section-{{ section.id }} .relative .swiper-button-next{ right:-4rem; }
  #shopify-section-{{ section.id }} .relative .swiper-button-next::after,
  #shopify-section-{{ section.id }} .relative .swiper-button-prev::after{
    font-size: 1rem;
    font-weight: bold;
    transition: none;
  }
  #shopify-section-{{ section.id }} .relative .swiper-button-next:hover,
  #shopify-section-{{ section.id }} .relative .swiper-button-prev:hover{
    transform: scale(1.2);
    border-color: #FFFFFF;
  }

  /* MB 端：3图/5图统一使用自适应 slide 宽度 */
  #shopify-section-{{ section.id }} .sec-swiper .swiper-slide {
    width: {% if section.blocks.size == 4 %}calc({{ section.settings.mb_image_width | default: 480 }} * 3 / 5 * 11 / 18 / 32 * 1rem){% else %}min(8.75rem, calc((100vw - 4rem - {{ section.settings.mb_image_width | default: 480 }} * 0.725 / 32 * 1rem) / 4)){% endif %};
    height: calc({{ section.settings.mb_image_height | default: 640 }} / 32 * 1rem);
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .sec-swiper .slide-visual {
    width: calc({{ section.settings.mb_image_width | default: 480 }} / 32 * 1rem);
    height: calc({{ section.settings.mb_image_height | default: 640 }} / 32 * 1rem);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.725);
    transition-property: transform, opacity;
    transition-duration: 400ms;
    transition-timing-function: ease-out;
    will-change: transform;
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .sec-swiper .swiper-slide-prev,
  #shopify-section-{{ section.id }} .sec-swiper .swiper-slide-next { z-index: 2; }
  #shopify-section-{{ section.id }} .sec-swiper .swiper-slide-active { z-index: 3; opacity: 1; }

  #shopify-section-{{ section.id }} .sec-swiper .swiper-button-next,
  #shopify-section-{{ section.id }} .sec-swiper .swiper-button-prev {
    color: white;
    background: rgba(0,0,0,0.2);
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    backdrop-filter: blur(4px);
    border: none;
  }
  #shopify-section-{{ section.id }} .sec-swiper .swiper-button-next:hover,
  #shopify-section-{{ section.id }} .sec-swiper .swiper-button-prev:hover { transform: none; }
  #shopify-section-{{ section.id }} .sec-swiper .swiper-button-next::after,
  #shopify-section-{{ section.id }} .sec-swiper .swiper-button-prev::after {
    font-size: 1rem;
    font-weight: bold;
    transition: none;
  }

  @media (max-width: 1023.98px) {
    #shopify-section-{{ section.id }} .pc-mb-relative { padding: 0; }
  }
{%- endstyle -%}

{%- assign s = section.settings -%}
{%- assign bg_pc = s.bg_pc_image | default: s.bg_mb_image -%}
{%- assign bg_mb = s.bg_mb_image | default: s.bg_pc_image -%}

<section id="se-{{ section.id }}" class="relative overflow-hidden" {{ section.shopify_attributes }}>
  {%- if bg_pc != blank or bg_mb != blank -%}
    <div class="pointer-events-none absolute inset-0">
      {% render 'diff-end-img',
        class: 'absolute inset-0 h-full w-full max-w-none object-cover object-center',
        pc_img: bg_pc,
        mb_img: bg_mb,
        pc_img_width: 1920,
        mb_img_width: 750
      %}
    </div>
  {%- endif -%}

  <div class="pc-mb-relative relative mx-auto w-full {% if section.blocks.size <= 4 %}w-[75rem]{% else %}w-[82.5rem]{% endif %} px-4 py-12 pb-0 lg:px-8 flex flex-col items-center">
    {% comment %} PC 端轮播 {% endcomment %}
    <div class="relative hidden lg:block w-full {% if section.blocks.size <= 4 %}se-slide--3-w{% else %}se-slide--5-w{% endif %}" data-pc-wrapper style="opacity: 0; transition: opacity 0.3s ease;">
      <div class="swiper overflow-hidden se-swiper" data-se-swiper>
        <div class="swiper-wrapper items-center">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <div class="swiper-slide flex items-center justify-center {% if section.blocks.size <= 4 %}se-slide--3{% else %}se-slide--5{% endif %}" {{ block.shopify_attributes }}>
              {%- if b.pc_image != blank -%}
                <div class="relative overflow-hidden img-box-early">
                  {%- assign pc_img_w = section.settings.pc_image_width | default: 350 -%}
                  {% render 'diff-end-img',
                    class: 'absolute inset-0 h-full w-full max-w-none object-cover object-center',
                    pc_img: b.pc_image,
                    pc_img_width: pc_img_w
                  %}
                </div>
              {%- else -%}
                <div class="bg-amber-50 img-box-early"></div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="swiper-button-prev hover:scale-[1.2] hover:border-white transition-transform absolute left-0 z-10 flex h-10 w-10 items-center justify-center bg-black/20 text-white backdrop-blur lg:h-12 lg:w-12" data-se-prev aria-label="Prev"></div>
        <div class="swiper-button-next hover:scale-[1.2] hover:border-white transition-transform absolute right-0 z-10 flex h-10 w-10 items-center justify-center bg-black/20 text-white backdrop-blur lg:h-12 lg:w-12" data-se-next aria-label="Next"></div>
      {%- endif -%}
    </div>

    {% comment %} MB 端轮播 {% endcomment %}
    <div class="relative block lg:hidden w-full {% if section.blocks.size <= 4 %}px-[2.125rem]{% else %}px-4{% endif %} mt-8">
      <div class="swiper sec-swiper {% if section.blocks.size <= 4 %}se-slide--3{% else %}se-slide--5{% endif %}" data-sec-swiper style="opacity: 0; transition: opacity 0.3s ease;">
        <div class="swiper-wrapper items-center">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <div class="swiper-slide relative" {{ block.shopify_attributes }}>
              <div class="slide-visual absolute overflow-hidden">
                {%- if b.mb_image != blank or b.pc_image != blank -%}
                  {%- assign final_img = b.mb_image | default: b.pc_image -%}
                  {%- assign mb_img_w = section.settings.mb_image_width | default: 480 | times: 1 -%}
                  <img src="{{ final_img | image_url: width: mb_img_w }}" class="w-full h-full object-cover" loading="lazy" alt="{{ final_img.alt | escape }}">
                {%- endif -%}
              </div>
            </div>
          {%- else -%}
            {%- for i in (1..5) -%}
              <div class="swiper-slide relative"><div class="slide-visual absolute overflow-hidden"></div></div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
        {%- if section.blocks.size > 1 or section.blocks.size == 0 -%}
          <div class="swiper-button-prev" data-sec-prev></div>
          <div class="swiper-button-next" data-sec-next></div>
        {%- endif -%}
      </div>
    </div>

    <div class="mt-[1.125rem] text-center lg:mt-[1.875rem]">
      {%- if s.copy != blank -%}
        <div class="text-2xl font-bold lg:text-[2rem] leading-[1.15]" {% if s.copy_color != blank %}style="color: {{ s.copy_color }}"{% endif %}>
          {{ s.copy }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if s.button_text != blank -%}
    <div class="flex justify-center absolute lg:bottom-10 bottom-8 left-1/2 -translate-x-1/2 w-max">
      <jds-button href="{{ s.button_link | default: '#' }}" {% if s.button_open_new %}target="_blank"{% endif %}>
        {{- s.button_text -}}
      </jds-button>
    </div>
  {%- endif -%}
</section>

<script type="module">
  (() => {
    const root = document.getElementById('se-{{ section.id }}');
    if (!root) return;
    const isMulti = {% if section.blocks.size > 1 %}true{% else %}false{% endif %};
    const mbAutoplay = {{ section.settings.mb_autoplay | default: false }};
    const mbAutoplayDelay = {{ section.settings.mb_autoplay_delay | default: 3 }} * 1000;

    // PC 端 Swiper 初始化
    const swiperElPC = root.querySelector('[data-se-swiper]');
    const pcWrapper = root.querySelector('[data-pc-wrapper]');
    if (swiperElPC && !swiperElPC.classList.contains('swiper-initialized')) {
      const useThreeLayout = {% if section.blocks.size <= 4 %}true{% else %}false{% endif %};
      new Swiper(swiperElPC, {
        loop: isMulti,
        centeredSlides: true,
        speed: 500,
        slidesPerView: 1.2,
        spaceBetween: 16,
        breakpoints: {
          1024: { slidesPerView: useThreeLayout ? 3 : 5, spaceBetween: useThreeLayout ? 32 : 38 }
        },
        navigation: {
          nextEl: root.querySelector('[data-se-next]'),
          prevEl: root.querySelector('[data-se-prev]')
        },
        slideToClickedSlide: true
      });
      requestAnimationFrame(() => {
        if (pcWrapper) pcWrapper.style.opacity = '1';
      });
    }

    // MB 端 Swiper
    const swiperElMB = root.querySelector('[data-sec-swiper]');
    if (swiperElMB && !swiperElMB.classList.contains('swiper-initialized')) {
      const useMbFiveLayout = {% if section.blocks.size > 4 %}true{% else %}false{% endif %};
      const mbImageWidth = {{ section.settings.mb_image_width | default: 480 }};
      const mbImageHeight = {{ section.settings.mb_image_height | default: 640 }};
      const mbFiveSpaceBetween = Math.max(0, 480 - mbImageWidth) / 24;
      const mbAdjacentOffset = 2 + Math.max(0, 480 - mbImageWidth) / 24;

      let isLoopFixing = false; // 循环重排状态锁

      const updateMbLayout = (swiper) => {
        if (isLoopFixing) return;

        const slides = swiper.slides;
        const mbVisualW = mbImageWidth / 32;
        const mbVisualH = mbImageHeight / 32;

        const activeSlide = slides[swiper.activeIndex];
        const slideWidth = activeSlide ? activeSlide.offsetWidth : 0;
        const spaceBetween = swiper.params.spaceBetween || 0;
        const activeVisualPx = mbImageWidth / 2;
        const adjVisualPx = activeVisualPx * 0.85;
        const centerDist = slideWidth + spaceBetween;
        const minOffset3 = centerDist > 0
          ? centerDist - (activeVisualPx - adjVisualPx) / 2
          : mbAdjacentOffset;

        for (let i = 0; i < slides.length; i++) {
          const slide = slides[i];
          let progress = slide.progress || 0;

          // 死区归一化，消除亚像素偏差
          if (Math.abs(progress) < 0.01) {
            progress = 0;
          } else if (Math.abs(progress - 1) < 0.03) {
            progress = 1;
          } else if (Math.abs(progress + 1) < 0.03) {
            progress = -1;
          }

          const rawDistance = Math.abs(progress);
          const distance = Math.min(rawDistance, 2);
          slide.style.zIndex = 100 - Math.round(Math.min(rawDistance, 5) * 10);

          const visual = slide.querySelector('.slide-visual');
          if (!visual) continue;

          if (rawDistance > 2.1) {
            visual.style.opacity = '0';
            continue;
          }
          visual.style.opacity = '1';

          const scale = distance <= 1
            ? 1 - distance * 0.15
            : 0.85 - Math.min(distance - 1, 1) * 0.125;

          let offset;
          if (!useMbFiveLayout) {
            const eff = Math.max(mbAdjacentOffset, minOffset3);
            offset = distance <= 1 ? eff * distance : eff * ((2 - distance) * 0.5 + 0.5);
          } else {
            offset = distance <= 1 ? mbAdjacentOffset * distance : mbAdjacentOffset * ((2 - distance) * 0.5 + 0.5);
          }

          const translateX = progress === 0 ? 0 : (progress > 0 ? -offset : offset);
          visual.style.width = mbVisualW.toFixed(4) + 'rem';
          visual.style.height = mbVisualH.toFixed(4) + 'rem';
          visual.style.transform = 'translate(calc(-50% + ' + translateX.toFixed(2) + 'px), -50%) scale(' + scale.toFixed(4) + ')';
        }
      };

      const setMbTransition = (swiper, speed) => {
        const slides = swiper.slides;
        for (let i = 0; i < slides.length; i++) {
          const visual = slides[i].querySelector('.slide-visual');
          if (visual) {
            visual.style.transitionDuration = speed + 'ms';
          }
        }
      };

      new Swiper(swiperElMB, {
        loop: isMulti,
        loopedSlides: isMulti ? Math.max(3, {{ section.blocks.size }}) : 1,
        grabCursor: true,
        centeredSlides: true,
        slidesPerView: 'auto',
        speed: 400,
        spaceBetween: 0,
        watchSlidesProgress: true,
        autoplay: mbAutoplay ? { delay: mbAutoplayDelay, disableOnInteraction: false } : false,
        navigation: {
          nextEl: root.querySelector('[data-sec-next]'),
          prevEl: root.querySelector('[data-sec-prev]')
        },
        slidesPerGroup: 1,
        touchRatio: 1,
        resistanceRatio: 0.85,
        on: {
          touchStart: function () {
            setMbTransition(this, 0);
          },
          setTransition: function (speed) {
            const duration = typeof speed === 'number' ? speed : this.params.speed;
            setMbTransition(this, duration);
          },
          beforeLoopFix: function () {
            isLoopFixing = true;
            setMbTransition(this, 0);
          },
          loopFix: function () {
            isLoopFixing = false;
            updateMbLayout(this);
          },
          setTranslate: function () {
            updateMbLayout(this);
          }
        }
      });

      requestAnimationFrame(() => { swiperElMB.style.opacity = '1'; });
    }
  })();
</script>

{% schema %}
{
  "name": "Subscribe Early Swiper",
  "tag": "section",
  "class": "subscribe-early-swiper",
  "settings": [
    { "type": "header", "content": "外间距（PC）" },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上外间距",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下外间距",
      "default": 0
    },
    { "type": "header", "content": "外间距（MB）" },
    {
      "type": "select",
      "id": "mb_margin_type",
      "label": "MB外间距",
      "options": [
        { "value": "default", "label": "与PC一致" },
        { "value": "custom", "label": "单独配置" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "margin_top_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上外间距",
      "default": 0,
      "visible_if": "{{section.settings.mb_margin_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "margin_bottom_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下外间距",
      "default": 0,
      "visible_if": "{{section.settings.mb_margin_type == 'custom' }}"
    },
    { "type": "header", "content": "轮播尺寸（PC）" },
    {
      "type": "number",
      "id": "pc_image_width",
      "label": "主图宽度（PC）",
      "info": "默认 350px（1倍图尺寸）。最大值<=400",
      "default": 350
    },
    {
      "type": "number",
      "id": "pc_image_height",
      "label": "主图高度（PC）",
      "info": "默认 350px（1倍图尺寸）",
      "default": 350
    },
    { "type": "header", "content": "轮播尺寸（MB）" },
    {
      "type": "number",
      "id": "mb_image_width",
      "label": "主图宽度（MB）",
      "info": "默认 480px（2倍图尺寸）",
      "default": 480
    },
    {
      "type": "number",
      "id": "mb_image_height",
      "label": "主图高度（MB）",
      "info": "默认 640px（2倍图尺寸）",
      "default": 640
    },
    { "type": "header", "content": "移动端轮播设置" },
    { "type": "checkbox", "id": "mb_autoplay", "label": "开启自动轮播", "default": true },
    {
      "type": "range",
      "id": "mb_autoplay_delay",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "自动轮播间隔",
      "default": 3,
      "visible_if": "{{section.settings.mb_autoplay}}"
    },
    { "type": "image_picker", "id": "bg_pc_image", "label": "Background PC Image" },
    { "type": "image_picker", "id": "bg_mb_image", "label": "Background MB Image" },
    {
      "type": "richtext",
      "id": "copy",
      "label": "图片下文案",
      "default": "<p>Subscribe Early.<br>Save Subscribe Early.Save Subscribe Early.</p>"
    },
    { "type": "color", "id": "copy_color", "label": "图片下文案颜色", "default": "#D26104" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "UNLOCK MY LAUNCH BENEFITS" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    { "type": "checkbox", "id": "button_open_new", "label": "Button Open New", "default": false }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "pc_image",
          "label": "PC Image",
          "info": "推荐尺寸：526×700（3:4）"
        },
        { "type": "image_picker", "id": "mb_image", "label": "MB Image", "info": "推荐尺寸：960×1280（3:4）" }
      ]
    }
  ],
  "presets": [{ "name": "Subscribe Early Swiper" }]
}
{% endschema %}