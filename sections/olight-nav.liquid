<style>
  .sticky-nav, .section-jky-nav {
    background: {{ section.settings.background }} !important;
  }
  .sticky-nav .container, .section-jky-nav .sticky-nav .container{
    color: {{ section.settings.text_color }} !important;
  }
  jky-nav .jky-nav-inner .jky-nav-inner--container .jky-nav-slideline .jky-nav-slideline--inner{
    background: {{ section.settings.text_color }} !important;
  }
</style>
{%- assign blocks_nav = section.blocks | where: 'type', "jky_nav" -%}
{%- render 'jky-nav', tabs: blocks_nav, open_trigger: section.settings.open_trigger, trigger_event: section.settings.trigger_event -%}

{% schema %}
  {
    "name": "JKY nav tabs",
    "class": "cal_scroll_target  section-jky-nav",
    "settings": [
      { "type": "header", "content": "数据埋点相关"},
      { "type": "checkbox", "id": "open_trigger", "label": "是否开启埋点", "default": false },
      { "type": "text", "id": "trigger_event", "label": "埋点事件名称" },
      { "type": "color", "id": "text_color", "label": "文本颜色", "default": "#fff" },
      { "type": "color_background", "id": "background", "label": "背景颜色", "default": "#fd5000" }
    ],
    "blocks": [
      {
          "type": "jky_nav",
          "name": "Nav导航栏",
          "limit": 10,
          "settings": [
            {"type": "text", "id": "title", "label": "导航栏名称"},
            {"type": "text", "id": "anchor", "label": "导航栏锚点"}
        ]
      }
    ]
  }
{% endschema %}
