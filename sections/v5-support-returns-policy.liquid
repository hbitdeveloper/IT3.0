
{{ 'sections-v5-support-returns-policy.css' | asset_url | stylesheet_tag }}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  class="v5-returns-policy section-padding"
  id="v5-returns-policy-{{ section.id }}"
  style="{{ style }}"
>
  <div class="main-container v5-returns-policy__inner">
    <h2 class="v5-returns-policy__title js-returns-policy-title">{{ section.settings.page_title }}</h2>
    <div class="v5-returns-policy__tabs" role="tablist" aria-label="Returns policy tabs">
      <button class="v5-returns-policy__tab js-returns-policy-tab is-active" type="button" data-type="return" role="tab" aria-selected="true">{{ section.settings.return_policy_tab }}</button>
      <button class="v5-returns-policy__tab js-returns-policy-tab" type="button" data-type="replacement" role="tab" aria-selected="false">{{ section.settings.replacement_policy_tab }}</button>
    </div>
    <div class="v5-returns-policy__accordion js-returns-policy-accordion">{{ section.settings.return_policy_content }}</div>
    <div class="v5-returns-policy__accordion js-replacement-policy-accordion hidden">{{ section.settings.replacement_policy_content }}</div>
    {% if section.settings.policy_url %}
      <jds-button class="v5-returns-policy__button js-returns-policy-link" href="{{ section.settings.policy_url }}" size="medium" variant="secondary">{{ section.settings.learn_more_text }} > </jds-button>
    {% endif %}
  </div>
</div>


<script src="{{ 'sections-v5-support-returns-policy.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5-Support Returns Policy",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "PC边距" },
    { "type": "number", "id": "padding_top", "label": "上边距", "default": 40 },
    { "type": "number", "id": "padding_bottom", "label": "下边距", "default": 120 },
    { "type": "header", "content": "MB边距" },
    { "type": "text", "id": "mb_padding_type", "default": "custom", "label": "MB边距", "visible_if": "{{ false }}" },
    { "type": "number", "id": "padding_top_mb", "label": "上边距", "default": 60 },
    { "type": "number", "id": "padding_bottom_mb", "label": "下边距", "default": 90 },

    { "type": "text", "id": "page_title", "label": "Default page title", "default": "Return & Refund Policy" },
    { "type": "text", "id": "return_policy_tab", "label": "Return policy tab", "default": "Return Policy" },
    { "type": "text", "id": "replacement_policy_tab", "label": "Replacement policy tab", "default": "Replacement Policy" },
    { "type": "text", "id": "learn_more_text", "label": "Default button text", "default": "Learn More" },
    { "type": "url", "id": "policy_url", "label": "Default policy URL" },

    { "type": "richtext", "id": "return_policy_content", "label": "Return Policy Content", "default": "<p>Jackery offers a 30-day money back guarantee for goods purchased directly from Jackery.com. We are confident that you will love your new Jackery product. However, if you are unsatisfied for any reason, simply let us know within 30 days. Once we receive the product and confirm the validity, we will refund the full purchase price.</p>" },
    { "type": "richtext", "id": "replacement_policy_content", "label": "Replacement Policy Content", "default": "<p>Jackery will replace (at Jackery's expense) any Jackery product that fails to operate during the applicable warranty period due to defect in workmanship or material. A replacement product assumes the remaining warranty of the original product.</p>" }
  ],
  "presets": [
    {
      "name": "V5-Support Returns Policy",
      "category": "V5.0 Support"
    }
  ]
}
{% endschema %}
