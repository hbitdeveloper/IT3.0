{%- render 'v5-pdp-panel-choose', settings: section.settings -%}

{% schema %}
{
    "name": "产品选择-V5",
    "tag": "section",
    "class": "section section-pdp-choose-v5",
    "enabled_on": {
        "templates": ["product"]
    },
    "settings": [
        { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
        {
            "type": "collection",
            "id": "panel_collection",
            "label": "太阳板产品系列"
        },
        {
            "type": "range",
            "id": "panel_num_max",
            "min": 1,
            "max": 50,
            "step": 1,
            "label": "太阳能板最大可选数量",
            "default": 6
        },
        {"type": "header", "content": "文案配置"},
        { "type": "inline_richtext", "id": "heading", "label": "大标题", "default": "Are Your Solar Panels Compatible?", "info": "需要换行，请使用 \\n " },
        { "type": "inline_richtext", "id": "subheading", "label": "小标题", "default": "To maximize the power output of the SolarSaga 500X, please do not connect more than six 85W solar panels in parallel to a single DC8020 input port.", "info": "需要换行，请使用 \\n " },
        { "type": "text", "id": "choose_panel_label", "label": "选择太阳能板Label", "default": "Choose Your Solar Panel Type" },
        { "type": "text", "id": "panel_num_label", "label": "太阳能板数量Label", "default": "Number of Solar Panels" },
        { "type": "text", "id": "is_compatible", "label": "是否匹配文案", "default": "Is it Compatible?" },
        { "type": "text", "id": "description", "label": "描述文案", "default": "Mixing different models of solar panels is not recommended. When connecting more than two solar panels simultaneously, the Jackery Solar Panel Connector is required." },
        { "type": "text", "id": "product_label", "label": "产品模块标题", "default": "Compatible Connectors:" },

        {"type": "header", "content": "公共基础配置"},
        {
            "type": "select", 
            "id": "page_width",
            "options": [
                {
                "value": "section-container",
                "label": "版心/1200px"
                },
                {
                "value": "section-container-lg",
                "label": "大版心/1312px"
                },
                {
                "value": "w-full",
                "label": "铺满/100%"
                }
            ],
            "default": "section-container-lg",
            "label": "PC的组件宽度",
            "info": "MB端组件宽度固定和设计稿一致，不可修改"
        },
        { "type": "color_background", "id": "bg_color", "label": "背景颜色" }
    ],
    "presets": [
        {
            "name": "产品选择-V5",
            "category": "V5.0"
        }
    ]
}
{% endschema %}