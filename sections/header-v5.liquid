                { "type": "inline_richtext", "id": "search_group_1_2_word", "label": "热门搜索词二", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "inline_richtext", "id": "search_group_1_3_word", "label": "热门搜索词三", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "inline_richtext", "id": "search_group_1_4_word", "label": "热门搜索词四", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "inline_richtext", "id": "search_group_1_5_word", "label": "热门搜索词五", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "inline_richtext", "id": "search_group_1_6_word", "label": "热门搜索词六", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "header", "content": "分类二" },
                { "type": "text", "id": "search_group_2_name", "label": "分类标题", "default": "POPULAR SCENARIOS" },
                { "type": "inline_richtext", "id": "search_group_2_1_word", "label": "热门搜索词一", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "inline_richtext", "id": "search_group_2_2_word", "label": "热门搜索词二", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "inline_richtext", "id": "search_group_2_3_word", "label": "热门搜索词三", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "inline_richtext", "id": "search_group_2_4_word", "label": "热门搜索词四", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "inline_richtext", "id": "search_group_2_5_word", "label": "热门搜索词五", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
                { "type": "inline_richtext", "id": "search_group_2_6_word", "label": "热门搜索词六", "info": "角标请用:::分隔,示例：Keyword:::New。链接不要包含角标内容"},
