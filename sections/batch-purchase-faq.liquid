<div class="batch-purchase--faq">
    <div class="batch-purchase-container">
        <div class="faq-content">
            <div class="main-title">{{ section.settings.title | escape }}</div>
            <div class="faq-block">
                {% for block in section.blocks %}
                <div class="faq-item">
                    <div class="item-title" @click="faqIndex = {{forloop.index}}">
                        <div>{{ block.settings.question | newline_to_br }}</div>
                        <svg :class="[faqIndex === {{forloop.index}} ? 'rotate' : '']" focusable="false" data-icon="down" width="1em" height="1em" fill="#333" aria-hidden="true" viewBox="64 64 896 896"><path d="M884 256h-75c-5.1 0-9.9 2.5-12.9 6.6L512 654.2 227.9 262.6c-3-4.1-7.8-6.6-12.9-6.6h-75c-6.5 0-10.3 7.4-6.5 12.7l352.6 486.1c12.8 17.6 39 17.6 51.7 0l352.6-486.1c3.9-5.3.1-12.7-6.4-12.7z"></path></svg>
                    </div>
                    <div class="info" v-show="faqIndex === {{forloop.index}}"> {{ block.settings.answer | newline_to_br }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>


{% schema %}
  {
    "name": "FAQ",
    "tag": "div",
    "settings": [
      { "type": "text", "id": "title", "label": "FAQ", "default": "FAQ" }
    ],
    "blocks": [
      {
        "name": "FAQ",
        "type": "faq",
        "settings": [
          { "type": "textarea", "id": "question", "label": "Question", "default": "Q1. What if I'm not prepared to make a new purchase?" }, 
          { "type": "textarea", "id": "answer", "label": "Answer", "default": "A1. The gift card can be used at anytime, there’s no expiration date." }
        ]
      }
    ]
  }
{% endschema %}