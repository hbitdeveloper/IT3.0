    { "type": "text", "id": "date_1", "label": "有效期文案", "visible_if": "{{ section.settings.show_modal }}" },
    { "type": "text", "id": "rule_1", "label": "rules", "visible_if": "{{ section.settings.show_modal }}" },
    {
      "type": "richtext",
      "id": "rule_detail_1",
      "label": "rules详细文案",
      "visible_if": "{{ section.settings.show_modal }}"
    },
    { "type": "header", "content": "优惠券2配置", "visible_if": "{{ section.settings.show_modal }}" },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "优惠券图片",
      "visible_if": "{{ section.settings.show_modal }}"
    },
    { "type": "text", "id": "code_2", "label": "券码文案", "visible_if": "{{ section.settings.show_modal }}" },
    { "type": "text", "id": "limit_2", "label": "限制", "visible_if": "{{ section.settings.show_modal }}" },
    { "type": "text", "id": "date_2", "label": "有效期文案", "visible_if": "{{ section.settings.show_modal }}" },
    { "type": "text", "id": "rule_2", "label": "rules", "visible_if": "{{ section.settings.show_modal }}" },
    {
      "type": "richtext",
      "id": "rule_detail_2",
      "label": "rules详细文案",
      "visible_if": "{{ section.settings.show_modal }}"
    }
  ],
  "presets": [
    {
      "name": "Olight Subscript"
    }
  ]
}
{% endschema %}

<script defer>
  (function () {
    function qsa(root, selector) {
      return root ? Array.from(root.querySelectorAll(selector)) : [];
    }

    function init() {
      qsa(document, '.olight-subscript .page-url input').forEach(function (inp) {
        inp.value = window.location.href;
      });

      qsa(document, '.olight-subscript').forEach(function (root) {
        var loadingBtn = '';
        var loadingWrap = root.querySelector('.newbee-form_submit');
        if (loadingWrap) loadingBtn = loadingWrap.getAttribute('data-loading') || '';
        if (!loadingBtn) loadingBtn = 'LOADING';

        var styleSheet = null;
        try {
          styleSheet = document.styleSheets && document.styleSheets.length ? document.styleSheets[0] : null;
        } catch (e) {
          styleSheet = null;
        }

        var className = 'loading-' + Math.random().toString(36).substr(2, 9);
        qsa(root, 'button').forEach(function (btn) {
          btn.classList.add(className);
        });
        if (styleSheet && styleSheet.insertRule) {
          try {
            styleSheet.insertRule(
              '.' + className + '.loading::after { content: "' + String(loadingBtn).replace(/"/g, '\\"') + '"; }',
              styleSheet.cssRules.length
            );
          } catch (e) {}
        }

        var privacy = root.querySelector('.newbee-form .form-row .five-kwh-privacy');
        var color = privacy ? privacy.getAttribute('data-color') : '';
        if (color) {
          qsa(root, '.newbee-form .form-row .form-item label .jky-agree').forEach(function (el) {
            el.style.color = color;
          });
          qsa(root, '.newbee-form .form-row .form-item label .jky-agree a').forEach(function (el) {
            el.style.color = color;
          });
          qsa(root, '.newbee-form .form-row .form-item label .jky-agree p').forEach(function (el) {
            el.style.color = color;
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();

  function toOlightSubscribe(data) {
    if (!(data && data.response && data.response.code === 200)) return;

    Array.from(document.querySelectorAll('.olight-subscript .olight-submit-btn')).forEach(function (btn) {
      btn.disabled = true;
      btn.style.opacity = '0.3';
    });

    var formBtn = document.querySelector('.olight-subscript .form_sub_btn');
    var showModalRaw = formBtn ? formBtn.getAttribute('data-show_modal') : '';
    var showModal = showModalRaw === 'true' || showModalRaw === '1' || showModalRaw === true;

    if (showModal) {
      var popupHtml = document.querySelector('.olight-subscript-modal');
      var uniqueId = 'olight-modal';
      if (popupHtml && window.ZModle && typeof window.ZModle.getInstance === 'function') {
        window.ZModle.getInstance(popupHtml, { id: uniqueId, class: 'olight-modal-coupon' });
      }
      var modalEl = document.querySelector('.olight-modal-coupon .olight-subscript-modal');
      if (modalEl) modalEl.style.display = 'block';

      if (!window.__olightSubscriptModalBinded) {
        window.__olightSubscriptModalBinded = true;
        document.addEventListener('click', function (e) {
          var target = e && e.target;
          if (!target || !(target.closest && target.closest('.modal-olight-submit'))) return;
          var closeBtn = document.querySelector('.olight-modal-coupon .close');
          if (closeBtn) closeBtn.click();
        });
      }
    } else {
      var successBtn = document.querySelector('.olight-subscript .newbee-form_submit button');
      var msg =
        (successBtn ? successBtn.getAttribute('data-success') : '') || (data.response && data.response.message) || '';
      if (typeof window.pushSuccessMessage === 'function') window.pushSuccessMessage(msg);
    }

    var emailInp = document.querySelector('.olight-subscript input[type=email]');
    var email = emailInp ? emailInp.value : '';
    var emailId = formBtn ? formBtn.getAttribute('data-emailid') : '';
    var subscribed = formBtn ? formBtn.getAttribute('data-subscribed') : '';
    Array.from(document.querySelectorAll('.olight-subscript .form_sub_btn')).forEach(function (btn) {
      if (subscribed) btn.textContent = subscribed;
    });

    if (window.pageInfo && window.pageInfo.api) {
      fetch(window.pageInfo.api + '/osconsumerapi/v1/email/notice', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
          cr: window && window.pageInfo ? window.pageInfo.cr : undefined,
          lang: window && window.pageInfo ? window.pageInfo.lang : undefined,
        },
        body: JSON.stringify({
          email: email,
          emailId: emailId,
          shopifyShopId: window.pageInfo.shopId,
        }),
      })
        .then(function (response) {
          return response.json();
        })
        .then(function (res) {
          if (!(res && res.code === 200)) {
            if (typeof window.pushErrorMessage === 'function')
              window.pushErrorMessage((res && res.message) || 'Network Error');
          }
        })
        .catch(function (e) {
          if (typeof window.pushErrorMessage === 'function') window.pushErrorMessage(e);
        });
    }

    var titleEl = document.querySelector('.olight-subscript .title');
    var title = titleEl ? titleEl.getAttribute('data-title') || '' : '';
    var params = { module: 'Email Subscribe', position: title, button_name: 'Subscribe' };

    gaPushDataLayer('section_subscribe_banner_user_clicks', params);
  }
</script>
