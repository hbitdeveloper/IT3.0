    { "type": "checkbox", "id": "show_modal", "label": "是否弹窗", "default": true },
    { "type": "header", "content": "弹窗配置", "visible_if": "{{ section.settings.show_modal }}" },
    {
      "type": "richtext",
      "id": "modal_title",
      "label": "弹窗大标题",
      "visible_if": "{{ section.settings.show_modal }}"
    },
    {
      "type": "color",
      "id": "modal_title_color",
      "label": "弹窗大标题颜色",
      "visible_if": "{{ section.settings.show_modal }}"
    },
    {
      "type": "richtext",
      "id": "modal_sub_title",
      "label": "弹窗小标题",
      "visible_if": "{{ section.settings.show_modal }}"
    },
    {
      "type": "color",
      "id": "modal_sub_title_color",
      "label": "弹窗小标题颜色",
      "visible_if": "{{ section.settings.show_modal }}"
    },
    { "type": "text", "id": "modal_btn", "label": "弹窗按钮文案", "visible_if": "{{ section.settings.show_modal }}" },
    { "type": "header", "content": "优惠券1配置", "visible_if": "{{ section.settings.show_modal }}" },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "优惠券图片",
      "visible_if": "{{ section.settings.show_modal }}"
    },
    { "type": "text", "id": "code_1", "label": "券码文案", "visible_if": "{{ section.settings.show_modal }}" },
