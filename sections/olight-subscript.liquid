{% style %}
  .olight-subscript-section{
    overflow: visible;
  }

  .olight-subscript {
    height: 540px;
    width: 100%;
    background: #AFDCF8;
    background-image: url({{ section.settings.subscribe_bg_img | image_url: width: 1920}}) !important;
    background-size: cover !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;

    .jky-12th-container {
      width: 1440px;
      padding: 0 80px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;

      .img-box{
        width: 576px;
        margin-top: 40px;
        img{
          width: 100%;
        }
      }

      .content-box {
        padding-top: 50px;
        max-width: 584px;
        .for-mb-position{
          height: 190px;
          display: flex;
          align-items: end;
        }
        .title {
          font-weight: 600;
          font-size: 40px;
          color: #1A1A1A;
          line-height: 48px;
          display: inline;

          p {
            display: inline;
          }
        }

        .tooltip-box {
          position: relative;
        }
        svg:hover + .tooltip-text{
          display: block;
        }

        .tooltip-text {
          display: none;
          position: absolute;
          width: 584px;
          height: auto;
          background: #FFFFFF;
          box-shadow: 0px 2px 8px 0px rgba(0, 0, 0, 0.27);
          border: 1px solid #EEEEEE;
          font-weight: 500;
          font-size: 16px;
          color: #666666;
          line-height: 24px;
          border-radius: 8px;
          padding: 16px 20px;
          bottom: 45px; /* 位于 box 的正上方，保持 10px 的间隙 */
          left: 50%;
          transform: translateX(-50%); /* 精确居中 */
          z-index: 1;
          &::after{
            content: "";
            position: absolute;
            top: 100%; /* 小三角在提示框的底部 */
            left: 50%;
            transform: translateX(-50%); /* 精确居中 */
            border-width: 10px;
            border-style: solid;
            border-color: #FFFFFF transparent transparent transparent;
          }
        }



        .sub-title {
          margin-top: 16px;
          font-size: 18px;
          color: #666;
          line-height: 1.25;
          font-weight: 500;
        }

        .subscribe-main {
          margin-top: 24px;

          .input-btn {
            width: 584px;
            position: relative;

            .form-row {
              .form-item {
                width: 584px;

                input {
                  height: 56px;
                  border-radius: 28px;
                  border: 1px solid #3679C6;
                  padding-left: 22px;
                  font-weight: 500;
                }
              }

              margin-bottom: 18px;
            }

            .newbee-form_submit {
              position: absolute;
              width: fit-content;
              right: 8px;
              top: 8px;

              button {
                height: 40px;
                background: var(--subscribe-btn-color, var(--jds-color-primary));
                border-radius: 26px;
                font-size: 18px;
                &::after{
                  border-radius: 26px;
                }
                &.loading::after{
                  background: var(--subscribe-btn-color, var(--jds-color-primary));
                }
              }

            }

          }

          jky-checkbox {
            padding-right: 0;
          }

          .jky-agree p {
            font-size: 16px;
            color: #666666;
            line-height: 24px;
            font-weight: 400;
          }

          .newbee-form .form-row .form-item label{
            margin-bottom: 0;
          }

          .jky-checkbox-input+span {
            padding-right: 0;
          }

          .newbee-form .form-row.form-row_check_box{
            margin-bottom: 0;
          }
        }

      }
    }

    .text-overflow-4 {
      -webkit-box-orient: vertical;
      display: -webkit-box;
      -webkit-line-clamp: 4;
      overflow: hidden;
    }

    .text-overflow-3 {
      -webkit-box-orient: vertical;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }
  }

  @media screen and (min-width: 1440px) {
    html[lang=ja] .olight-subscript .jky-checkbox-inner{
      margin-top: 3px;
    }
  }

  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    html[lang=ja] .olight-subscript .jky-checkbox-inner{
      margin-top: 0.1vw;
    }
  }

  @media screen and (max-width: 1023.98px) {
    .olight-subscript {
      background-image: url({{ section.settings.subscribe_bg_img_mb | image_url: width:750 }}) !important;
    }
    html[lang=ja] .olight-subscript .jky-checkbox-inner{
      margin-top: 3px;
    }
  }

  /* 活动页特殊样式 */
  .activity-main-container .olight-subscript .jky-12th-container .content-box .tooltip-text {
    z-index: 2;
  }

  /* 订阅弹窗样式 */
  .olight-subscript-modal {
    display: none;
    margin: 0 auto;
    border-radius: 12px;
    background: #FFF;

    .modal-box {
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 560px;

      .modal-title {
        padding-top: 40px;
        font-weight: 600;
        font-size: 24px;
        color: #1A1A1A;
        line-height: 32px;
      }

      .modal-sub-title {
        margin-top: 6px;
        font-weight: 500;
        font-size: 16px;
        color: #666666;
        line-height: 24px;
      }

      .coupon-top,
      .coupon-bottom {
        width: 414px;
        height: 154px;
        margin-top: 16px;
        padding: 0 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;

        background-image: url("https://cdn.shopify.com/s/files/1/0550/0524/9633/files/coupon-bg.png?v=1741159454");
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;

        img {
          width: 176px;
          margin-top: -20px;
        }

        .coupon-box {
          margin-top: -20px;
          max-width: 176px;
          text-align: right;
          margin-right: 20px;

          .code {
            font-weight: 600;
            font-size: 14px;
            color: #1A1A1A;
            line-height: 14px;
          }

          .required {
            margin-top: 3px;
            font-size: 14px;
            line-height: 16px;
            color: var(--jds-color-primary);
          }

          .date {
            margin-top: 5px;
            font-weight: 400;
            font-size: 14px;
            color: #1A1A1A;
            line-height: 13px;
          }

          .rules {
            margin-top: 3px;
            font-weight: 600;
            font-size: 18px;
            color: #333333;
            line-height: 17px;
            text-decoration: underline;
            position: relative;
            display: inline-block;
          }

          .rules:hover .coupon-pkg-rules-tip {
            display: block;
          }
        }
      }

      .coupon-bottom {
        margin-top: 2px;
      }

      .modal-olight-submit {
        margin-top: 10px;
        padding: 12px 46px;
        border-radius: 26px;
        border: 1px solid var(--jds-color-primary);
        font-size: 18px;
        line-height: 18px;
        color: var(--jds-color-primary);
        font-weight: 600;
      }
    }
  }

  .olight-modal-coupon.modal {
    .modal-content {
      width: 660px !important;
      height: 580px;
      overflow: visible;
      border-radius: var(--theme-dialog-border-radius, 12px);

      .moadal-header {
        border-bottom: none;
        height: 0;
      }

      .modal-content-body {
        padding: 0;
      }
    }
  }

