        border-radius: var(--theme-dialog-border-radius, calc(24 * 100vw / 750));

        .moadal-header {
          border-bottom: none;
          height: 0;
        }

        .modal-content-body {
          padding: 0;
        }
      }
    }
  }

  .olight-subscript-modal .coupon-pkg-rules-tip {
    position: absolute;
    z-index: 10000;
    display: none;
    border-width: 0.133333333333333vw;
    border-color: rgba(238, 238, 238, 1);
    border-style: solid;
    background-color: rgba(255, 255, 255, 1);
    box-shadow: 0px 2px 8px 0px rgba(0, 0, 0, .1);
    filter: drop-shadow(2px 2px 8px rgba(0, 0, 0, .2));
    width: 73vw;
    padding: 5.333333333333333vw 2.6666666666666665vw 5.333333333333333vw 5.333333333333333vw;
    right: 120%;
    /* 移动到 .rules 左侧 */
    top: 50%;
    /* 定位到 .rules 的中间 */
    transform: translate(-10px, -50%);
    border-radius: 4.266666666666667vw;
    text-align: left;

    h3 {
      font-weight: 600;
      font-size: 22px;
      color: #666666;
      line-height: 24px;
      padding-bottom: 10px;
      border-bottom: 1px solid #DDDDDD;
    }

    .modal-tip-content {
      margin-top: 14px;
      font-size: 16px;
      color: #444444;
      line-height: 24px;
    }
  }

  .olight-subscript-modal .coupon-pkg-rules-tip>.angle {
    position: absolute;
    left: 100%;
    top: 50%;
    display: block;
    transform: translateY(-50%);
    border-color: transparent;
    border-left-color: rgba(255, 255, 255, 1);
    border-style: solid;
    background-color: transparent;
    content: "";
    border-width: 2.6666666666666665vw;
    width: 0vw;
    height: 0vw
  }

  @media (min-width: 1024px) {
    .olight-subscript-modal .coupon-pkg-rules-tip {
      width: 27.777777777777775vw;
      padding: 1.6666666666666667vw 2.0833333333333335vw;
      border-width: .06944444444444445vw;
      border-radius: 1.1111111111111112vw;
    }
  }

  @media (min-width: 1024px) {
    .olight-subscript-modal .coupon-pkg-rules-tip>.angle {
      border-width: .9027777777777778vw
    }
  }

  @media (min-width: 1440px) {
    .olight-subscript-modal .coupon-pkg-rules-tip {
      width: 400px;
      padding: 24px 30px;
    }
  }

  @media (min-width: 1440px) {
    .olight-subscript-modal .coupon-pkg-rules-tip>.angle {
      border-width: 13px
    }
  }

  @media screen and (max-width: 1023.98px) {

    .olight-subscript-modal {
      .coupon-pkg-rules-tip {
        right: 90%;

        h3 {
          font-size: calc(40 * 100vw / 750);
          color: #333333;
          line-height: calc(42 * 100vw / 750);
        }

        .modal-tip-content {
          margin-top: calc(16 * 100vw / 750);
          font-weight: 500;
          font-size: calc(28 * 100vw / 750);
          color: #444444;
          line-height: calc(40 * 100vw / 750);
        }
      }
    }
  }
{% endstyle %}

{% if section.settings.code_1 == blank %}
  <style>
    .modal-container.modal .modal-content {
      max-height: 40vh;
    }
  </style>
{% endif %}

{% assign type = section.settings.type %}
<div
  class="olight-subscript {% if type == 'embed' %} embed-component {% else %} independent-carousel {% endif %}"
  style="background: {{ section.settings.bgColor }}"
  {% if section.settings.anchor != blank %}
    anchor="{{ section.settings.anchor | escape }}"
    anchor-target="{{ section.settings.anchor | escape }}"
  {% endif %}
  data-handle="{{ section.settings.handle }}"
  {{ section.shopify_attributes }}
>
  <div class="jky-12th-container">
    <div class="img-box">
      {%- if section.settings['left-img'] != blank -%}
        {% render 'responsive-image', image: section.settings['left-img'], image_class: 'left-img' %}
      {%- endif -%}
    </div>
    <div class="content-box">
      <div class="for-mb-position">
        <div class="just-bottom">
          {% assign titleColor = '<em style="color: ' | append: section.settings.title_color | append: '">' %}
          <div class="title text-overflow-4" data-title="{{ section.settings.title | strip_html }}">
            {{ section.settings.title | replace: '<em>', titleColor }}
          </div>
          {%- if section.settings.notes != blank -%}
            <span class="tooltip-box">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                version="1.1"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"

                data-ga-event="section_subscribe_banner_user_clicks"
                data-ga-action="mouseenter"
                data-ga-params-module="Email Subscribe"
                data-ga-params-position="{{ section.settings.title | strip_html }}"
                data-ga-params-button_name="Question Mark"
              >
                <defs>
