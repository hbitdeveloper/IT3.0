      width: 100%;

      .jky-12th-container {
        width: calc(1440 * 100vw / 1440);
        padding: 0 calc(80 * 100vw / 1440);

        .img-box{
          width: calc(576 * 100vw / 1440);
          margin-top: calc(40 * 100vw / 1440);
        }

        .content-box {
          padding-top: calc(50 * 100vw / 1440);
          max-width: calc(584 * 100vw / 1440);

          .for-mb-position{
            height: calc(190 * 100vw / 1440);
          }

          .title {
            font-weight: 600;
            font-size: calc(40 * 100vw / 1440);
            line-height: calc(48 * 100vw / 1440);
          }

          .sub-title {
            margin-top: calc(16 * 100vw / 1440);
            font-size: calc(18 * 100vw / 1440);
            line-height: 1.25;
          }

          .tooltip-text {
            display: none;
            position: absolute;
            width: 36.5rem;
            height: auto;
            background: #FFFFFF;
            box-shadow: 0 0.125rem 0.5rem 0 rgba(0, 0, 0, 0.27);
            border: 1px solid #EEEEEE;
            font-weight: 500;
            font-size: 1rem;
            color: #666666;
            line-height: 1.5rem;
            border-radius: 0.5rem;
            padding: 1rem 1.25rem;
            bottom: 2.8125rem; /* 位于 box 的正上方，保持 10px 的间隙 */
            left: 50%;
            transform: translateX(-70%);
            z-index: 1;
            &::after{
                content: "";
                position: absolute;
                top: 100%; /* 小三角在提示框的底部 */
                left: 70%;
                transform: translateX(-50%);
                border-width: 0.625rem;
                border-style: solid;
                border-color: #FFFFFF transparent transparent transparent;
            }
          }

          .subscribe-main {
            margin-top: calc(24 * 100vw / 1440);

            .input-btn {
              width: calc(584 * 100vw / 1440);

              .form-row {
                .form-item {
                  width: calc(584 * 100vw / 1440);

                  input {
                    height: calc(56 * 100vw / 1440);
                    border-radius: calc(28 * 100vw / 1440);
                  }
                }

                margin-bottom: calc(18 * 100vw / 1440);
              }

              .newbee-form_submit {
                right: calc(8 * 100vw / 1440);
                top: calc(8 * 100vw / 1440);

                button {
                  height: calc(40 * 100vw / 1440);
                  border-radius: calc(26 * 100vw / 1440);
                  font-size: calc(18 * 100vw / 1440);
                  &::after{
                    border-radius: calc(26 * 100vw / 1440);
                  }
                }

              }

            }

            jky-checkbox {
              padding-right: 0;
            }

            .jky-agree p {
              font-size: calc(16 * 100vw / 1440);
              line-height: calc(24 * 100vw / 1440);
            }

            .jky-checkbox-input+span {
              padding-right: 0;
            }
          }
        }
      }
    }
  }

  @media screen and (max-width: 1023.98px) {
