          padding: 0 calc(17 * 100vw / 750);
          margin-left: calc(35 * 100vw / 750);

          img {
            width: calc(302 * 100vw / 750);
            margin-top: calc(-30 * 100vw / 750);
          }

          .coupon-box {
            margin-top: calc(-30 * 100vw / 750);
            max-width: calc(304 * 100vw / 750);
            margin-right: calc(40 * 100vw / 750);

            .code {
              font-size: calc(26 * 100vw / 750);
              line-height: calc(25 * 100vw / 750);
            }

            .required {
              margin-top: calc(3 * 100vw / 750);
              font-size: calc(24 * 100vw / 750);
              line-height: calc(28 * 100vw / 750);
            }

            .date {
              margin-top: calc(9 * 100vw / 750);
              font-size: calc(24 * 100vw / 750);
              line-height: calc(22 * 100vw / 750);
            }

            .rules {
              margin-top: calc(11 * 100vw / 750);
              font-size: calc(32 * 100vw / 750);
              line-height: calc(29 * 100vw / 750);
            }
          }
        }

        .coupon-bottom {
          margin-top: calc(2 * 100vw / 750);
        }

        .modal-olight-submit {
          margin-top: calc(24 * 100vw / 750);
          padding: calc(24 * 100vw / 750) calc(96 * 100vw / 750);
          border-radius: calc(40 * 100vw / 750);
          border: calc(2 * 100vw / 750) solid var(--jds-color-primary);
          font-size: calc(30 * 100vw / 750);
          line-height: calc(30 * 100vw / 750);
