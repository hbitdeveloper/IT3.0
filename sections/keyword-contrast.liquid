{%- style -%}
  .section-keyword-contrast {
    margin-bottom: 6.3021vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }

  .keyword-contrast-panel {
  }

  .keyword-contrast-title {
    font-size: 2.3438vw;
    font-weight: 600;
    color: #000000;
    padding-bottom: 3.3854vw;
    text-align: center;
  }

  .keyword-contrast-content {
    display: flex;
  }

  .keyword-contrast-content .content-item {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 0 4.5833vw;
    max-width: 28.6458vw;
  }

  .keyword-contrast-content .content-item .title {
    font-weight: 600;
    line-height: 3.4375vw;
    font-size: 1.675vw;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #8e8e8e;
    color: #ffffff;
  }

  .keyword-contrast-content .content-item .active {
    background: var(--primary-color);
  }

  .keyword-contrast-content .content-item .image {
    padding-bottom: 1.3542vw;
  }

  .keyword-contrast-content .content-item .image img {
    width: 100%;
    height: 9.375vw;
  }

  .keyword-contrast-content .content-item .detail {
    padding-top: 2.9167vw;
  }

  .keyword-contrast-content .content-item .detail li {
    display: flex;
    padding-bottom: 2.7083vw;
  }

  .keyword-contrast-content .content-item .detail li:last-child {
    padding-bottom: 0;
  }

  .keyword-contrast-content .content-item .detail .detail-left {
    width: 3.0729vw;
    height: 3.0729vw;
  }

  .keyword-contrast-content .content-item .detail .detail-right {
    display: flex;
    flex-direction: column;
    padding-left: 0.5208vw;
  }

  .keyword-contrast-content .content-item .detail .detail-right .right-title {
    font-weight: 500;
    font-size: 1.3542vw;
  }

  .keyword-contrast-content .content-item .detail .detail-right .right-subtitle {
    font-size: 1.25vw;
  }

  @media screen and (max-width: 768px) {
    .keyword-contrast-title {
      font-size: 6vw;
      line-height: 8vw;
      padding-bottom: 5.2vw;
    }
    .section-keyword-contrast {
      max-width: 71.7333vw;
    }
    .keyword-contrast-content {
      flex-direction: column;
    }

    .keyword-contrast-content .content-item {
      max-width: 100%;
      margin: 0;
      padding-bottom: 7.8667vw;
    }

    .keyword-contrast-content .content-item:last-child {
      padding-bottom: 0;
    }

    .keyword-contrast-content .content-item .image img {
      height: 25.0667vw;
    }

    .keyword-contrast-content .content-item .title {
      font-size: 4.8vw;
      padding: 2.1333vw 0;
    }

    .keyword-contrast-content .content-item .detail {
      padding-top: 5.0667vw;
    }

    .keyword-contrast-content .content-item .detail .detail-left {
      width: 7.8667vw;
      height: 7.8667vw;
    }

    .keyword-contrast-content .content-item .detail li {
      padding-bottom: 6.9333vw;
    }

    .keyword-contrast-content .content-item .detail .detail-right {
      padding-left: 1.3333vw;
    }

    .keyword-contrast-content .content-item .detail .detail-right .right-title {
      font-size: 3.4667vw;
    }

    .keyword-contrast-content .content-item .detail .detail-right .right-subtitle {
      font-size: 3.2vw;
    }
  }

  .keyword-contrast-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .keyword-contrast-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .keyword-contrast-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }

    .keyword-contrast-panel .keyword-sub{
      width: 100%;
    }
  }
{%- endstyle -%}
<div class="keyword-contrast-panel" anchor="{{ section.settings.anchor | escape }}">
  <h2 class="keyword-contrast-title"
  style="
  --pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
  --pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
  "
  >{{ section.settings.title | escape }}</h2>
  {%- if section.settings.sub != blank -%}
    <div class="keyword-contrast-sub keyword-sub">{{ section.settings.sub }}</div>
  {%- endif -%}
  <div class="keyword-contrast-content">
    {% for block in section.blocks %}
      <div class="content-item">
        <div class="image">
          <img src="{{ block.settings.image | image_url: width: 1100 }}" loading="lazy" alt="{{block.settings.image.alt}}">
        </div>
        <div class="title {% if block.settings.is_active %} active {%endif%}">{{ block.settings.title | escape }}</div>
        <ul class="detail">
          {% if block.settings.icon1 and block.settings.icon1 != '' %}
            <li>
              <img
                src="{{ block.settings.icon1 | image_url: width: 50 }}"
                class="detail-left" loading="lazy" alt="{{block.settings.icon1.alt}}"
              >
              <div class="detail-right">
                <div class="right-title">{{ block.settings.icon1_title }}</div>
                <span class="right-subtitle">{{ block.settings.icon1_subtitle | escape }}</span>
              </div>
            </li>
          {% endif %}

          {% if block.settings.icon2 and block.settings.icon2 != '' %}
            <li>
              <img
                src="{{ block.settings.icon2 | image_url: width: 50 }}"
                class="detail-left" loading="lazy" alt="{{block.settings.icon2.alt}}"
              >
              <div class="detail-right">
                <div class="right-title">{{ block.settings.icon2_title }}</div>
                <span class="right-subtitle">{{ block.settings.icon2_subtitle | escape }}</span>
              </div>
            </li>
          {% endif %}

          {% if block.settings.icon3 and block.settings.icon3 != '' %}
            <li>
              <img
                src="{{ block.settings.icon3 | image_url: width: 50 }}"
                class="detail-left" loading="lazy" alt="{{block.settings.icon3.alt}}"
              >
              <div class="detail-right">
                <div class="right-title">{{ block.settings.icon3_title }}</div>
                <span class="right-subtitle">{{ block.settings.icon3_subtitle | escape }}</span>
              </div>
            </li>
          {% endif %}

          {% if block.settings.icon4 and block.settings.icon4 != '' %}
            <li>
              <img
                src="{{ block.settings.icon4 | image_url: width: 50 }}"
                class="detail-left" loading="lazy" alt="{{block.settings.icon4.alt}}"
              >
              <div class="detail-right">
                <div class="right-title">{{ block.settings.icon4_title }}</div>
                <span class="right-subtitle">{{ block.settings.icon4_subtitle | escape }}</span>
              </div>
            </li>
          {% endif %}

          {% if block.settings.icon5 and block.settings.icon5 != '' %}
            <li>
              <img
                src="{{ block.settings.icon5 | image_url: width: 50 }}"
                class="detail-left" loading="lazy" alt="{{block.settings.icon5.alt}}"
              >
              <div class="detail-right">
                <div class="right-title">{{ block.settings.icon5_title }}</div>
                <span class="right-subtitle">{{ block.settings.icon5_subtitle | escape }}</span>
              </div>
            </li>
          {% endif %}
        </ul>
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Keyword Contrast",
  "class": "section-keyword-contrast",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },  
  { "type": "text", "id": "title", "label": "Title" },
  { "type": "richtext", "id": "sub", "label": "SubTitle" },
  { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
  { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 40 },
  { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
  { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 }
  ],
  "blocks": [
    {
      "type": "contrast-item",
      "name": "Contrast Item",
      "settings": [
        { "type": "checkbox", "id": "is_active", "label": "Contrast Active", "default": true },
        { "type": "text", "id": "title", "label": "Contrast Title" },
        { "type": "image_picker", "id": "image", "label": "Contrast Image" },

        { "type": "image_picker", "id": "icon1", "label": "Contrast Items Icon1" },
        { "type": "richtext", "id": "icon1_title", "label": "Contrast Items Icon1 Title" },
        { "type": "text", "id": "icon1_subtitle", "label": "Contrast Items Icon1 Subtitle" },

        { "type": "image_picker", "id": "icon2", "label": "Contrast Items Icon2" },
        { "type": "richtext", "id": "icon2_title", "label": "Contrast Items Icon2 Title" },
        { "type": "text", "id": "icon2_subtitle", "label": "Contrast Items Icon2 Subtitle" },

        { "type": "image_picker", "id": "icon3", "label": "Contrast Items Icon3" },
        { "type": "richtext", "id": "icon3_title", "label": "Contrast Items Icon3 Title" },
        { "type": "text", "id": "icon3_subtitle", "label": "Contrast Items Icon3 Subtitle" },

        { "type": "image_picker", "id": "icon4", "label": "Contrast Items Icon4" },
        { "type": "richtext", "id": "icon4_title", "label": "Contrast Items Icon4 Title" },
        { "type": "text", "id": "icon4_subtitle", "label": "Contrast Items Icon4 Subtitle" },

        { "type": "image_picker", "id": "icon5", "label": "Contrast Items Icon5" },
        { "type": "richtext", "id": "icon5_title", "label": "Contrast Items Icon5 Title" },
        { "type": "text", "id": "icon5_subtitle", "label": "Contrast Items Icon5 Subtitle" }
      ]
    }
  ],
  "presets": [
    {
      "name": "keyword Contrast",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
