{% comment %} 日本防灾日 DP Region Three组件 {% endcomment %}
{% schema %}
{
  "name": "DP Region Three",
  "tag": "section",
  "class": "dp-region-three",
  "disabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "titleImgPC",
      "label": "Title Image(PC)"
    },
    {
      "type": "image_picker",
      "id": "titleImgMB",
      "label": "Title Image(MB)"
    },

    {
      "type": "image_picker",
      "id": "imgPC",
      "label": "Image(PC)"
    },
    {
      "type": "image_picker",
      "id": "imgMB",
      "label": "Image(MB)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [{
    "name": "dp region three"
  }]
}
{% endschema %}

<div class="dp-region-three-box">
  <div class="region-section">
    <div class="content-box">
      {% if section.settings.titleImgPC != blank %}
        <div class="content-title dp-animation">
        {% render 'responsive-image', image: section.settings.titleImgPC, mimage: section.settings.titleImgMB %}
      </div>
      {% endif %}
      <div class="content box-shadow dp-animation">
        <a
          class="btn dp-animation"
          href="{{section.settings.link}}"
        >
          {% render 'responsive-image', image: section.settings.imgPC, mimage: section.settings.imgMB %}
        </a>
      </div>
    </div>
  </div>
</div>
