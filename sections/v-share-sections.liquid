{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div class="section-padding" style="{{ style }}" >
  {% comment %} 卡片容器 {% endcomment %}
  <div class="{{section.settings.page_width}} lg:gap-[1rem] gap-[1.25rem] flex justify-center flex-wrap" style="{{ style }}" id="cards-container">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "V-Share组件",
  "class": "section-v-share-sections",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    {
      "type": "header",
      "content": "分享设置"
    },
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1312px"
        },
        {
          "value": "w-full",
          "label": "铺满/100%"
        }
      ],
      "default": "section-container",
      "label": "组件宽度"
    },
    { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#FFFFFF" },
    {
      "type": "header",
      "content": "内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0
    }
  ],
  "blocks": [{"type": "media-share-icon"}],
  "presets": [
    {
      "name": "通用社媒分享"
    }
  ]
}
{% endschema %}
