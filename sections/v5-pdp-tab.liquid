{%- assign blocks = section.blocks | where: 'type', "tab_item" -%}

{%- if blocks.size > 0 -%}
  {{ 'section-v5-pdp-tab.min.css' | asset_url | stylesheet_tag }}

  <div class="product-tabs-box">
    <div class="product-detail-variants page-container">
      <div class="product-tabs-container">
        {%- if product.title != blank -%}
          <h1 class="product-name text-overflow-1">{{ product.title | escape }}</h1>
        {%- endif -%}

        <ul class="subnav-list relative">
          {%- for block in blocks -%}
            <li
              class="navli {% if forloop.index0 == 0 %} active{% endif %}"
              data-cate="product_tab_{{forloop.index0}}"
              data-ga-event="products_details_page_user_clicks"
              data-ga-action="click"
              data-ga-params-product_spu_name="{{ product.title }}"
              data-ga-params-module="Directory"
              data-ga-params-content="{{ product.title | escape }}"
              data-ga-params-position="{{ block.settings.tab_name | escape }}"
            >{{ block.settings.tab_name | escape }}</li>
          {%- endfor -%}

          <div class="slider-main"></div>
        </ul>

        <jky-v5-pdp-tabs>
          <div class="jky-tabs-scroll">
            <div class="action-btn prev-action invisible">
              <svg fill="#1a1a1a" width="16" height="16" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="4397">
                <path d="M332.501333 183.168a42.666667 42.666667 0 0 1 57.621334-2.496l2.709333 2.496 298.666667 298.666667a42.666667 42.666667 0 0 1 2.496 57.621333l-2.496 2.709333-298.666667 298.666667a42.666667 42.666667 0 0 1-62.826667-57.621333l2.496-2.709334L600.96 512 332.501333 243.498667a42.666667 42.666667 0 0 1-2.496-57.621334l2.496-2.709333z" fill="#1a1a1a" p-id="4398"></path>
              </svg>
            </div>

            <div class="jky-tabs-scroll-inner">
              <div class="inner-w">
                {%- for block in blocks -%}
                  <div
                    class="jky-tabs-item {% if forloop.index0 == 0 %} active curr_tab{% endif %}"
                    data-cate="product_tab_{{forloop.index0}}"
                    data-ga-event="products_details_page_user_clicks"
                    data-ga-action="click"
                    data-ga-params-product_spu_name="{{ product.title }}"
                    data-ga-params-module="Directory"
                    data-ga-params-content="{{ product.title | escape }}"
                    data-ga-params-position="{{ block.settings.tab_name | escape }}"
                  >{{ block.settings.tab_name | escape }}</div>
                {%- endfor -%}

                <div class="jky-tabs-slideline">
                  <div class="jky-tabs-slideline--inner"></div>
                </div>
              </div>
            </div>

            <div class="action-btn next-action invisible">
              <svg fill="#1a1a1a" width="16" height="16" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="4397">
                <path d="M332.501333 183.168a42.666667 42.666667 0 0 1 57.621334-2.496l2.709333 2.496 298.666667 298.666667a42.666667 42.666667 0 0 1 2.496 57.621333l-2.496 2.709333-298.666667 298.666667a42.666667 42.666667 0 0 1-62.826667-57.621333l2.496-2.709334L600.96 512 332.501333 243.498667a42.666667 42.666667 0 0 1-2.496-57.621334l2.496-2.709333z" fill="#1a1a1a" p-id="4398"></path>
              </svg>
            </div>
          </div>
        </jky-v5-pdp-tabs>
      </div>
    </div>
  </div>

  <script src="{{ 'section-v5-pdp-tab.min.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "V5-PDP-二级导航",
  "class": "pdp-v4-content",
  "tag": "div",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "tab_item",
      "name": "Tab Item",
      "settings": [
        {"type": "text", "id": "tab_name", "label": "Tab Name"}
      ]
    }
  ],
  "limit": 1,
  "presets": [
    {
      "name": "V5-PDP-二级导航",
      "category": "V5.0",
      "blocks": [
        {
          "type": "tab_item",
          "settings": {
            "tab_name": "Highlights"
          }
        },
        {
          "type": "tab_item",
          "settings": {
            "tab_name": "Technik"
          }
        },
        {
          "type": "tab_item",
          "settings": {
            "tab_name": "FAQS"
          }
        },
        {
          "type": "tab_item",
          "settings": {
            "tab_name": "Reviews"
          }
        }
      ]
    }
  ]
}
{% endschema %}
