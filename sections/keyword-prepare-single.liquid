{%- style -%}
  .section-keyword-prepare-single {
    margin-bottom: 6.3021vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }
  .section-keyword-prepare-single .keyword-prepare-title {
    font-size: 2.3438vw;
    font-weight: 600;
    color: #000000;
    padding-bottom: 2.9688vw;
    display: flex;
    justify-content: center;
  }

  .section-keyword-prepare-single .content {
    display: flex;
    background: #f6f6f6;
  }

  .section-keyword-prepare-single .content div.title {
    display: flex;
    align-items: center;
    padding: 0 4.7396vw;
    font-weight: 500;
    line-height: 2.5vw;
    width: 33.0729vw;
    word-break: break-word;
    font-size: 1.25vw;
    color: #333333;
  }

  .section-keyword-prepare-single .content .image {
    display: flex;
    flex: 1;
  }

  .section-keyword-prepare-single .content .image img {
    width: 100%;
  }

  @media screen and (max-width: 768px) {
    .section-keyword-prepare-single {
      margin-bottom: 11.6vw;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .section-keyword-prepare-single .content {
      flex-direction: column;
      padding-left: 8vw;
      padding-right: 8vw;
    }

    .section-keyword-prepare-single .keyword-prepare-title {
      font-size: 6vw;
      font-weight: 600;
      color: #000000;
      line-height: 8.8vw;
      padding: 0 20.4vw 4.8vw 20.4vw;
      display: block;
      word-wrap: break-word;
    }

    .section-keyword-prepare-single .content div.title {
      width: 100%;
      font-size: 3.2vw;
      font-weight: 400;
      color: #333333;
      line-height: 6.4vw;
      padding: 7.7333vw 4.6667vw 8.8vw;
    }
  }

  .section-keyword-prepare-single .keyword-prepare-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .section-keyword-prepare-single .keyword-prepare-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .section-keyword-prepare-single .keyword-prepare-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }
  }
{%- endstyle -%}

<h2 class="keyword-prepare-title" anchor="{{ section.settings.anchor | escape }}"
style="
--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
--pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
"
>{{- section.settings.prepare_title | escape -}}</h2>
<div class="keyword-sub">{{ section.settings.prepare_sub }}</div>
<div class="content">
  <div class="title">{{ section.settings.content | newline_to_br }}</div>
  <div class="image"><img src="{{ section.settings.content_img | image_url: width: 2000 }}" loading="lazy" alt="{{section.settings.content_img.alt}}"></div>
</div>

{% schema %}
{
  "name": "Keyword Prepare Single",
  "class": "section section-keyword-prepare-single",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },
    { "type": "text", "id": "prepare_title", "label": "keyword prepare title" },
    { "type": "richtext", "id": "prepare_sub", "label": "keyword prepare subtitle" },
    { "type": "textarea", "id": "content", "label": "prepare content" },
    { "type": "image_picker", "id": "content_img", "label": "prepare content img" },
    { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
    { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 40 },
    { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
    { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 }
  ],
  "presets": [
    {
      "name": "Keyword Prepare Single",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
