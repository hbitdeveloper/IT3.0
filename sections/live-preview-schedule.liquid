<script type="module">
  document.addEventListener('DOMContentLoaded', () => {
    // ✅ 新增：按钮点击逻辑
    const pageUrlInput = document.querySelector('.schedule-dialog .page-url input');
    if (pageUrlInput) {
      pageUrlInput.value = window.location.href;
    }
    document.addEventListener('click', (e) => {
      if (e.target.matches('.schedule-item jds-button')) {

        const offerDialog = document.querySelector('.schedule-dialog');
        offerDialog?.setAttribute('open', true);
      }
    });

    document.querySelectorAll('.live-preview-schedule .swiper-slide').forEach(slide => {
    // trim 去掉空格
    if (!slide.textContent.trim()) {
       slide.remove();
      }
    });

    // 轮播
    const swiperDOM = document.querySelector('.live-preview-schedule .swiper');
    if (!swiperDOM) return;
    const blocks = document.querySelectorAll('.live-preview-schedule .swiper-slide.schedule-item');

    // 手机不轮播
    if (window.innerWidth < 1024) {
      const el = document.querySelector('.live-preview-schedule .swiper-wrapper'); // 只选中一个
      if (el) el.classList.remove('swiper-wrapper');
      const blocks = document.querySelectorAll('.live-preview-schedule .swiper-slide.schedule-item');
      const viewMoreBtn = document.getElementById('view-more-btn');
      const btnText = document.getElementById('btn-text');
      const btnArrow = document.getElementById('view-more-arrow');

      const limit = 4;
      if (blocks.length > limit) {
        blocks.forEach((el, i) => {
          if (i >= limit) el.style.display = 'none'; // 默认隐藏超过前4个
        });

        viewMoreBtn?.addEventListener('click', () => {
          const moreBtn = btnText.getAttribute('data-more');
          const lessBtn = btnText.getAttribute('data-less');
          const isExpanded = btnText.innerText === lessBtn;

          if (isExpanded) {
            // 返回显示 4 个
            blocks.forEach((el, i) => {
              el.style.display = i < limit ? 'block' : 'none';
            });
            btnText.innerText = moreBtn;
            btnArrow.style.transform = 'rotate(0deg)';
          } else {
            // 展开全部
            blocks.forEach((el) => (el.style.display = 'block'));
            btnText.innerText = lessBtn;
            btnArrow.style.transform = 'rotate(180deg)';
          }
        });
      }

      return;
    } else {
      if (blocks.length <= 4) {
        return;
      }
    }

    // ---- 初始化 Swiper ----
    new Swiper(swiperDOM, {
      slidesPerView: 4,
      spaceBetween: 20,
      loop: true,

      navigation: {
        nextEl: document.querySelector('.live-preview-schedule .swiper-button-next'),
        prevEl: document.querySelector('.live-preview-schedule .swiper-button-prev'),
      },
      pagination: {
        el: '.live-preview-schedule .slideshow-pagination',
        clickable: true,
        bulletClass: 'slideshow-pagination-item',
        bulletActiveClass: 'active pagination-active',
        clickableClass: 'slideshow-pagination-clickable',
        modifierClass: 'slideshow-pagination-',
        renderBullet: function (index, className) {
          var slideIndex = index,
            number = index <= 15 ? '0' + (slideIndex + 1) : slideIndex + 1;

          var paginationItem = '<span class="slideshow-pagination-item rounded-[0.25rem] lg:w-4">';
          paginationItem =
            index <= 15
              ? paginationItem +
                '<span class="pagination-separator"><span class="pagination-separator-loader"></span></span>'
              : paginationItem;
          paginationItem += '</span>';
          return paginationItem;
        },
      },
    });
  });

  function toScheduleGA(data) {
    if (data.response && data.response.code === 200) {
      const msg =
        document.querySelector('.schedule-dialog .newbee-form_submit button').getAttribute('data-success') ||
        data.response.message;
      pushSuccessMessage(msg);
      const subsribedText = document.querySelector('.schedule-item jds-button').getAttribute('data-subscribed');
      const buttons = document.querySelectorAll('.schedule-item jds-button');
      if (subsribedText) {
        document.querySelectorAll('.schedule-item jds-button').forEach((btn) => {
          btn.textContent = subsribedText;
          btn.classList.add('active');
        });
      }
    }
  }

  window.toScheduleGA = toScheduleGA;
</script>
