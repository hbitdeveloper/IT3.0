{%- style -%}
  .schedule-dialog .subscribe-main jky-checkbox {
    padding-right: 0;
  }
  .schedule-dialog .subscribe-main .newbee-form_submit {
    flex-wrap: wrap;
    width: auto;
    position: absolute;
    right: 0;
    top: 0;
    width: auto;
  }
  .schedule-dialog .subscribe-main .newbee-form_submit button {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-height: 48px;
    white-space: nowrap;
    font-size: 14px;
    height: 100%;
    padding: 0 46px;
    border-radius: 0 8px 8px 0;
  }
  .schedule-dialog .subscribe-main .newbee-form .form-row {
    position: relative;
    margin-bottom: 16px;
  }
  .schedule-dialog .subscribe-main .newbee-form .privacy {
    width: 100%;
    margin-bottom: 24px;
  }

  .schedule-dialog .subscribe-main .newbee-form .form-row .form-item input {
    background: #ffffff;
    padding-left: 1.8rem;
    border: 1px solid #c8c8c8;
    border-radius: 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .schedule-dialog .subscribe-main .newbee-form .form-row .form-item .jky-checkbox-label .jky-agree p,
  .schedule-dialog .subscribe-main .newbee-form .form-row .form-item .jky-checkbox-label .jky-agree p a {
    color: #666666;
  }
  .schedule-dialog .subscribe-main .newbee-form .form-row .jky-phoneselect .form-item input {
    padding-left: 135px;
    background: #ffffff;
    border: 1px solid #c8c8c8 !important;
    border-radius: 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .schedule-dialog .subscribe-main .required-box {
    position: relative;
  }
  .schedule-dialog .subscribe-main .required-box .required-star {
    position: absolute;
    color: var(--jds-color-primary);
    font-size: 28px;
    left: 12px;
    height: 48px;
    line-height: 60px;
    bottom: 0;
  }
  .schedule-dialog .subscribe-main .newbee-form .form-row .form-item.error input {
    border: 1px solid var(--jds-color-primary) !important;
  }
  .schedule-dialog .subscribe-main .newbee-form .form-row .field_error-tips {
    color: var(--jds-color-primary);
    font-size: 14px;
  }
  .schedule-dialog .subscribe-main .newbee-form .form-row.form-row_check_box .field_error-tips {
    position: relative;
    bottom: 0;
  }
  .schedule-dialog .subscribe-main .newbee-form .form-row .field_error-tips:first-of-type {
    -webkit-line-clamp: 2;
  }
  .schedule-dialog .subscribe-main .jky-checkbox-label .jky-agree {
    color: #666666;
    font-size: 14px;
    line-height: 20px;
  }
  .schedule-dialog .subscribe-main .jky-checkbox-label .jky-agree p {
    color: #666666;
  }
  .schedule-dialog .subscribe-main .jky-checkbox-label .jky-agree p a {
    color: #666666;
  }
  .schedule-dialog .subscribe-main .form_sub_btn {
    height: 48px;
    width: 100%;
    border-radius: 8px;
    font-size: 18px;
    font-weight: 600;
  }

  .live-preview-schedule .slideshow-pagination:not(.slideshow-pagination.slideshow-thumbnail-container) {
    bottom: 0;
  }

  .live-preview-schedule .swiper-button-next,
  .live-preview-schedule .swiper-button-prev {
    border: 2px solid rgba(255, 255, 255, 0.4);
    background: rgba(102, 102, 102, 0.3);
    width: 3rem;
    height: 3rem;
    transition: none;
    border-radius: 50%;
  }

  .live-preview-schedule .swiper-button-next::after,
  .live-preview-schedule .swiper-button-prev::after {
    font-size: 1rem;
    color: #fff;
  }

  .live-preview-schedule jds-button::part(button){
    border-radius: 0.5rem;
  }

   .jky-v5 .live-preview-schedule jds-button::part(button){
    border-radius: 0;
   }

   .live-preview-schedule .slideshow-pagination-item.active {
    width: 5.5rem;
    height: 0.25rem;
   }

  jds-button.active::part(button) {
    background: unset;
  }

  @media screen and (min-width: 1024px) {
    .live-preview-schedule .swiper-wrapper.swiper-wrapper-less {
      gap: 1rem;
    }

    .live-preview-schedule jds-button::part(button){
      border-radius: 0.375rem
    }
    .live-preview-schedule .swiper-wrapper.swiper-wrapper-less .schedule-item {
      width: 19.8125rem;
    }

    jds-button::part(button) {
      font-size: 1.125rem;
      font-weight: 600;
    }

    /* 日站特殊处理 */
    html[lang='ja'] .schedule-item .schedule-date {
      font-size: 2rem;
    }
  }

  @media screen and (max-width: 1023.98px) {
    html[lang='ja'] .schedule-item .schedule-date {
      font-size: 1.25rem;
    }
    .schedule-dialog .subscribe-main .newbee-form .form-row {
      margin-bottom: 0.75rem;
    }

    .schedule-dialog .subscribe-main .newbee-form .form-row .form-item input {
      height: 2.75rem;
      border-radius: 0.375rem;
    }

    .schedule-dialog .subscribe-main .newbee-form_submit {
      width: 100%;
      margin-top: 1rem;
      position: unset;
    }

    .schedule-dialog .subscribe-main .newbee-form_submit button {
      line-height: 2.75rem;
      border-radius: 0.375rem;
    }

    html[lang='ja'] .schedule-dialog .subscribe-main .newbee-form_submit button{
      line-height: 2.75rem !important;
    }

    .schedule-dialog .subscribe-main .required-box .required-star {
      line-height: 3.85rem;
    }

     html[lang='ja'] .schedule-dialog .subscribe-main .required-box .required-star{
      line-height: 4rem !important;
    }
     html[lang='ja'] .schedule-dialog .subscribe-main .jky-checkbox-input{
      margin-top: 0.5rem;
     }
  }
{%- endstyle -%}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}
<div
  {% if section.settings.anchor != blank %}
    anchor-target="{{section.settings.anchor | escape}}"
  {% endif %}
  class="section-padding"
  style="{{style}}"
>
  <div
    class="section-container-lg lg:gap-[1.25rem] gap-[0.75rem] flex justify-center flex-wrap relative"
    style="
      --live-after:url('{{ section.settings.live_after_img | image_url: width: 331 }}');
      --live-before:url('{{ section.settings.live_before_img | image_url: width: 331 }}');
      --live-after-mb:url('{{ section.settings.live_after_img_mb | image_url: width: 690 }}');
      --live-before-mb:url('{{ section.settings.live_before_img_mb | image_url: width: 690 }}');
    "
  >
    {% comment %} 左箭头置于 Swiper 外 {% endcomment %}
    {% if section.blocks.size > 4 %}
      <div class="swiper-arrow swiper-button-next hidden lg:flex right-[-3.5rem]"></div>
    {% endif %}

    <div class="swiper lg:pb-[2rem]">
      <div class="swiper-wrapper {% if section.blocks.size <= 4 %} swiper-wrapper-less {% endif %}">
        {% for block in section.blocks %}
          {% render block with section: section %}
        {% endfor %}
      </div>
      {% if section.blocks.size > 4 %}
        <div class="slideshow-pagination"></div>
      {% endif %}

      {% comment %} View More/Less 按钮 {% endcomment %}
      {% if section.blocks.size > 4 %}
        <div class="flex justify-center mt-[2rem] lg:hidden">
          <div
            id="view-more-btn"
            class="flex cursor-pointer text-[var(--jds-color-primary)] font-medium duration-200 items-center gap-[0.5rem] text-[0.9375rem]"
          >
            <span
              id="btn-text"
              data-more="{{ section.settings.view_more }}"
              data-less="{{ section.settings.view_less }}"
            >
              {{- section.settings.view_more | default: 'View More' -}}
            </span>
            <jds-icon
              id="view-more-arrow"
              name="arrow-down"
              class="text-[var(--jds-color-primary)] transition-transform duration-200"
            ></jds-icon>
          </div>
        </div>
      {% endif %}
    </div>
    {% if section.blocks.size > 4 %}
      <div class="swiper-arrow swiper-button-prev hidden lg:flex left-[-3.5rem]"></div>
    {% endif %}
  </div>
</div>

{% comment %} 订阅弹窗 {% endcomment %}
<jds-dialog class="without-title schedule-dialog" size="large">
  <div class="title lg:text-[1.25rem] text-[1rem] font-medium text-[#666666] lg:leading-[1.875rem] leading-[1.375rem] lg:mb-[1rem] mb-[0.75rem]">
    {{ section.settings.subcribe_title }}
  </div>

  <div class="subscribe-main">
    {% assign sub_url = '' %}
    {% if section.settings.klaviyo_id != blank %}
      {% assign sub_url = '/osconsumerapi/v1/notice/klaviyoSubscribe' %}
    {% else %}
      {% assign sub_url = '/osconsumerapi/v1/notice/subscribe' %}
    {% endif %}
    <jky-form
      onsubmitcall="(e)=>toScheduleGA(e)"
      jky-form-id="footer-email-subscribe"
      class="subscribe-email footer-subscribe-box"
    >
      <form data-action="{{ sub_url }}">
        <div class="form-container newbee-form newbee-form_{{section.id}}">
          {% comment %} 邮箱 {% endcomment %}
          <div class="form-row flex  full email">
            <div class="form-item required" data-field="input">
              <input
                type="email"
                id="email"
                name="email"
                placeholder="{{'newsletter.email_placeholder' | t}}"
                data-error="{{'newsletter.email_empty_info' | t}}"
                data-value="email"
                data-reg="email"
                data-regerror="{{'newsletter.email_error_info' | t}}"
              >
              <div class="required-box">
                <div class="required-star">*</div>
              </div>
            </div>
            <div class="newbee-form_submit flex full" data-loading="{{section.settings.loading_btn}}">
              <button
                class="form_sub_btn z-button-middle"
                data-subcribebtn="{{ section.settings.subcribe_btn }}"
                data-success="{{'newsletter.success' | t}}"
              >
                {{ section.settings.subcribe_btn }}
              </button>
            </div>
          </div>
          {% comment %} 隐私协议 {% endcomment %}
          <div class="form-row privacy form-row_check_box flex full">
            <div
              class="form-item required"
              data-field="check_box"
              data-error="{{'newsletter.policy_empty_info' | t}}"
            >
              {% render 'jky-formField-checkbox', key: section.settings.privacy_policy, value: 'agree_recevie' %}
            </div>
          </div>

          {% if section.settings.klaviyo_id == blank %}
            <div style="display: none;" class="form-row flex  full">
              <div class="form-item form-item_const" data-field="input">
                <input
                  type="text"
                  id="tags"
                  name="tags"
                  data-error=""
                  data-value="tags"
                  data-reg=""
                  value="{% if section.settings.subscript_tag != blank %}{{section.settings.subscript_tag}}{% else %}{{request.path | split: '/' | last}}{% endif %}"
                  data-regerror=""
                >
              </div>
            </div>
          {% endif %}

          {% if section.settings.klaviyo_id != blank %}
            <div style="display: none;" class="form-row flex  full">
              <div class="form-item form-item_const" data-field="input">
                <input
                  type="text"
                  id="list_id"
                  name="list_id"
                  data-error=""
                  data-value="list_id"
                  data-reg=""
                  value="{{ section.settings.klaviyo_id  }}"
                  data-regerror=""
                >
              </div>
            </div>
          {% endif %}

          {% if section.settings.klaviyo_id != blank %}
            <div style="display: none;" class="form-row flex  full">
              <div class="form-item form-item_const" data-field="input">
                <input
                  type="text"
                  id="cr"
                  name="cr"
                  data-error=""
                  data-value="cr"
                  data-reg=""
                  value="{{ settings.shop_cr | default: localization.country.iso_code | default: 'US' }}"
                  data-regerror=""
                >
              </div>
            </div>
          {% endif %}

          <div style="display: none;" class="form-row flex  full">
            <div class="form-item form-item_const" data-field="input">
              <input
                type="text"
                id="componentName"
                name="componentName"
                data-value="componentName"
                value="live订阅"
              >
            </div>
          </div>

          <div style="display: none;" class="form-row flex full page-url">
            <div class="form-item form-item_const" data-field="input">
              <input
                type="text"
                id="pageUrl"
                name="pageUrl"
                data-value="pageUrl"
                value=""
              >
            </div>
          </div>
        </div>
      </form>
    </jky-form>
  </div>
</jds-dialog>

{% schema %}
{
  "name": "Preview Schedule Item",
  "class": "live-preview-schedule",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    { "type": "image_picker", "id": "live_after_img", "label": "PC预告图片", "info": "推荐尺寸：317 * 242" },
    { "type": "image_picker", "id": "live_before_img", "label": "PC已结束图片", "info": "推荐尺寸：317 * 242" },
    { "type": "image_picker", "id": "live_after_img_mb", "label": "MB预告图片", "info": "推荐尺寸：690 * 186" },
    { "type": "image_picker", "id": "live_before_img_mb", "label": "MB已结束图片", "info": "推荐尺寸：690 * 186" },
    { "type": "text", "id": "subsribe", "label": "订阅按钮文案" },
    { "type": "text", "id": "subsribed", "label": "已订阅按钮文案" },
    { "type": "text", "id": "view_more", "label": "MB查看更多文案" },
    { "type": "text", "id": "view_less", "label": "MB收起文案" },
