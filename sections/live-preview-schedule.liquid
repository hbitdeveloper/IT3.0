      "id": "style_type",
      "options": [
        {
          "value": "default",
          "label": "基础配置"
        },
        {
          "value": "custom",
          "label": "开发者配置"
        }
      ],
      "default": "default",
      "label": "配置类型"
    },
    {
      "type": "header",
      "visible_if": "{{ section.settings.style_type == 'custom' }}",
      "content": "文本内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 4
