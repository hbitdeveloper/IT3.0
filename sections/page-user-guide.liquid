<style>
  .banner {
  width: 100%;
  height: 100vh;
  max-height: 890px;
  padding-top: 100px;
  background: url("{{ section.settings.image | image_url: width: 2000 }}") center
    no-repeat;
  background-size: cover;
}
.banner h5 {
  width: 34vw;
  margin-top: 22px;
}
@media screen and (max-width: 768px) {
  .banner {
    padding-top: 32px;
    background-image: url("{{ section.settings.m_image | image_url: width: 1024 }}");
  }
  .banner h1,
  .banner h2,
  .banner h5 {
    width: 100%;
    text-align: center;
  }
}
</style>


<div class="layer-container">
  <h2 class="jky-text-3xl">{{ section.settings.title }}</h2>
  <h5 class="jky-text-lg">{{ section.settings.subTitle }}</h5>
</div>

{% schema %}
{
  "name": "user guide", "class": "layer banner", "tag": "div",
  "settings": [
    {"type": "text", "id": "title", "label": "banner title", "default": "User Guide"},
    {"type": "text", "id": "subTitle", "label": "banner sub title", "default": "Get detailed operating instructions and product care information for all Jackery products"},
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "image_picker", "id": "m_image", "label": "Mobile Image"}
  ]
}
{% endschema %}