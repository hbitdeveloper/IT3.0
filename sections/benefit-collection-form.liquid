<div class="benefit-form">
  <div
    class="jky-12th-form"
    anchor-target="{{ section.settings.anchor | escape }}"
    data-customer-email="{{ customer.email }}"
    data-successful="{{ section.settings.successful }}"
    data-mode="{{ section.settings.mode }}"
    data-title="{{section.settings.title | escape }}"
  >
    
    <div class="jky-12th-container">

      <div class="benefit-form-title">{{ section.settings.title | escape }}</div>
      <div class="benefit-form-des">{{ section.settings.title_sub | escape }}</div>

      <form class="jky-up form">
        {% comment %} 邮箱 {% endcomment %}
        <div class="form-2x-box">
            <div class="form-item form-2x">
              <label class="form-label" for="email">{{ section.settings.email | escape }}</label>
              <input
                class="form-text"
                id="email"
                type="text"
                name="email"
                placeholder="{{ section.settings.email_placeholder | escape }}"
              >
              <div class="error email-error">{{ section.settings.email_error | escape }}</div>
            </div>

          {% comment %} 问题类型 {% endcomment %}
          <div class="form-item form-2x">
            <label class="form-label">{{ section.settings.question | escape }}</label>
            <div class="select" data-placeholder="{{section.settings.question_placeholder | escape}}">
              <div class="form-text choose" id="question">
                {{ section.settings.question_placeholder | escape }}
              </div>
              <div class="list">
                {% assign labels = section.blocks %}
                {% if labels.size > 0 %}
                    {% for label in labels %}
                      <div class="item" data-id='{{ label.type }}'>{{ label.settings.label | escape }}</div>
                    {% endfor %}
                {% endif %}
              </div>
            </div>
            <div class="error product-error">{{ section.settings.question_error | escape }}</div>
          </div>
        </div>

        {% comment %} 意见框 {% endcomment %}
        <div class="form-item form-item-large">
          <label class="form-label large-label" for="comment">{{ section.settings.topic | escape }}</label>
          <div class="relative">
            <textarea
              class="form-text form-textarea"
              name="comment"
              id="comment"
              maxlength="2000"
              placeholder="{{ section.settings.topic_placeholder | escape }}"
            ></textarea>
            <span class="num"> <span class="now-number">0</span>/2000 </span>
          </div>
          <div class="error comment-error">{{ section.settings.topic_error | escape }}</div>
        </div>

        {% comment %} 隐私协议 {% endcomment %}
        <div class="form-item form-2x form-item-privacy">
          <div class="form-check">
            <input class="form-checkbox" id="subscribe" type="checkbox" name="subscribe">
            <label class="form-label checkbox-label" id="checkbox-label" for="subscribe"></label>
            <span class="info">{{ section.settings.privacy }}</span>
          </div>
          <div class="error subscribe-error">{{ section.settings.privacy_error | escape }}</div>
        </div>

        {% comment %} 提交按钮 {% endcomment %}
        <div class="button">
          <button
            class="jky-12th-btn submit-button"
            data-ga-event="section_form_user_clicks"
            data-ga-action="click"
            data-ga-params-module="{{section.settings.title | escape}}"
            data-ga-params-button_name="{{section.settings.submit | escape}}"
            data-ga-params-status="{{ status }}"
          >
            <span> {{ section.settings.submit | escape }} </span>
          </button>
        </div>
      </form>
    </div>
  </div>

</div>

{% schema %}
{
  "name": "BC Message Form",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    { "type": "text", "id": "title", "label": "标题" },
    { "type": "text", "id": "title_sub", "label": "副标题" },
    { "type": "text", "id": "email", "label": "邮箱" },
    { "type": "text", "id": "email_placeholder", "label": "邮箱占位文案" },
    { "type": "text", "id": "question", "label": "问题类型" },
    { "type": "text", "id": "question_placeholder", "label": "问题类型占位文案" },
    { "type": "text", "id": "topic", "label": "意见"},
    { "type": "text", "id": "topic_placeholder", "label": "意见占位文案"},
    { "type": "text", "id": "topic_error", "label": "意见未填写提示文案"},
    { "type": "richtext", "id": "privacy", "label": "隐私协议" },
    { "type": "text", "id": "privacy_error", "label": "隐私协议错误文案" },
    { "type": "text", "id": "submit", "label": "提交按钮" },
    { "type": "text", "id": "successful", "label": "提交成功文案", }
  ],
  "blocks": [
    {
      "type": "site_experience",
      "name": "网站体验",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "网站体验" }]
    },
    {
      "type": "products",
      "name": "产品",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "产品" }]
    },
    {
      "type": "promotions_discounts",
      "name": "促销和折扣",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "促销和折扣" }]
    },
    {
      "type": "other",
      "name": "其他",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "其他" }]
    }
  ],
  "presets": [
    {
      "name": "优惠集合-留言表单",
      "category": "优惠信息集合页"
    }
  ]
}
{% endschema %}
