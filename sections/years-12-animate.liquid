<div class="years_12_container">
    {%- for block in section.blocks -%}
        {%- case block.type -%}
            {%- when 'gift_box' -%}
                {% comment %} 深度礼盒 {% endcomment %}
                <style>
                    .years_12_container .fix-gift .gift-content .title-primary span.active {color: {{block.settings.active_color}};}
                    .years_12_container .fix-gift .gift-content {color: {{block.settings.unlock_color}};}
                </style>
                <div class="fix-gift">
                    <div class="gift-content">
                        <span class="title-primary">{{block.settings.progress_title | escape}}</span>
                        <span>{{block.settings.subtitle | escape}}</span>
                    </div>
                    <div class="gift-icon">
                        <img loading="lazy" class="unlock-img" src="{{block.settings.unlock_gift | image_url: width: 80}}" alt="{{block.settings.progress_title | escape}}">
                        <img loading="lazy" class="lock-img" src="{{block.settings.lock_gift | image_url: width: 80}}" alt="{{block.settings.progress_title | escape}}">
                    </div>
                </div>
                {% comment %} 深度礼盒 {% endcomment %}

            {%- when 'kv_banner' -%}
                {% comment %} KV Banner {% endcomment %}
                <div class="section-kv {%if block.settings.is_gift_block == true%} gift-anchor{%endif%}">
                    <div class="sticky-viewport">
                        <div class="kv-background">
                            <video poster="{{block.settings.kv_pc | image_url: width: 2000}}" preload="true" playsinline="" muted="" autoplay="" src="{{block.settings.kv_video}}"></video>
                            <div class="kv-title">{{block.settings.kv_title | escape}}</div>
                            <picture>
                                <source media="(min-width:1024px)" srcset="{{block.settings.kv_pc | image_url: width: 2000}}">
                                <img src="{{block.settings.kv_mb | image_url: width: 1200}}" alt="{{block.settings.kv_mb.alt | escape}}">
                            </picture>
                        </div>
                    </div>
                    <div class="animation-trigger kv-animation-trigger"></div>
                    <div class="space-80vh"></div>
                    <div class="space-100vh"></div>
                </div>

                <div class="section-kv--mb {%if block.settings.is_gift_block == true%} gift-anchor--mb{%endif%}">
                    <div class="kv-title">{{block.settings.kv_title | escape}}</div>
                    <img loading="lazy" src="{{block.settings.kv_mb | image_url: width: 1200}}" alt="{{block.settings.kv_mb.alt | escape}}">
                </div>
                {% comment %} KV Banner {% endcomment %}

            {%- when 'scroll_content' -%}
                {% comment %} 滚动介绍 {% endcomment %}
                <div class="sec-content {%if block.settings.is_gift_block == true%} gift-anchor{%endif%}">
                    <div class="themepoint-container">
                        <div class="sun-light">
                            <img loading="lazy" class="sun-light-bg" src="{{block.settings.sun_line | image_url: width: 1200}}" alt="{{block.settings.sun_line.alt | escape}}">
                        </div>
                        {%- for i in (0..4) -%}
                            {% assign scroll_title_index = 'scroll_title_' | append: forloop.index %}
                            {% assign scroll_content_index = 'scroll_content_' | append: forloop.index %}
                            {%- if block.settings[scroll_title_index] != blank -%}
                                <div class="theme-pt1 theme-item {%if forloop.index == 1%} show{%endif%}">
                                    <div class="small_text text_primary">{{block.settings[scroll_title_index] | escape}}</div>
                                    <div class="scroll-item-content">{{block.settings[scroll_content_index] | newline_to_br}}</div>
                                </div>
                            {%- endif -%}
                        {%- endfor -%}
                    </div>
                    <div class="space-100vh"
                        style="min-height: 100vh;background-color: #000;display: flex;flex-direction: column;gap: 0;">
                        {%- for i in (0..4) -%}
                            {% assign scroll_title_index = 'scroll_title_' | append: forloop.index %}
                            {% assign scroll_content_index = 'scroll_content_' | append: forloop.index %}
                            {%- if block.settings[scroll_title_index] != blank -%}
                                <div class="trigger-ele" style="flex: 1;"></div>
                            {%- endif -%}
                        {%- endfor -%}
                    </div>
                    <div style="height: 125vh;"></div>
                </div>
                <div class="sec-content--mb {%if block.settings.is_gift_block == true%} gift-anchor--mb{%endif%}">
                    <div class="sec-content--main">
                        <div class="content">
                            {%- for i in (0..4) -%}
                                {% assign scroll_mb_index = 'scroll_mb_' | append: forloop.index %}
                                {%- if block.settings[scroll_mb_index] != blank -%}
                                    {{block.settings[scroll_mb_index]}}
                                {%- endif -%}
                            {%- endfor -%}
                        </div>

                        <img src="{{block.settings.sun_line | image_url: width: 1200}}" alt="{{block.settings.sun_line.alt | escape}}">
                    </div>
                </div>
                {% comment %} 滚动介绍 {% endcomment %}

            {%- when 'brand_grid' -%}
                {% comment %} 品牌介绍 {% endcomment %}
                <div class="brand-pro {%if block.settings.is_gift_block == true%} gift-anchor{%endif%}">
                    <div class="sticky-viewport">
                        <div class="content">
                            <div class="content-flex">
                                <div class="content-left">
                                    <div class="content-left--top stragger-item">
                                        <div class="content--item">
                                            <div class="title">{{block.settings.left_top_title | escape}}</div>
                                            <div class="des-icon">
                                                <div class="des">{{block.settings.left_top_content | newline_to_br}}</div>
                                                <img loading="lazy" src="{{block.settings.left_top_icon | image_url: width: 400}}" alt="{{block.settings.left_top_title | escape}}">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="content-left--bottom stragger-item">
                                        <div class="content--item">
                                            <div class="title">{{block.settings.left_bottom_title | escape}}</div>
                                            <div class="des-icon">
                                                <div class="des">{{block.settings.left_bottom_content | newline_to_br}}</div>
                                                <img loading="lazy" src="{{block.settings.left_bottom_icon | image_url: width: 400}}" alt="{{block.settings.left_bottom_title | escape}}">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="content-middle">
                                    <div class="content-middle--top">
                                        <div class="content--item">
                                            <img loading="lazy" src="{{block.settings.middle_top_img | image_url: width: 2000}}" alt="{{block.settings.middle_top_img.alt | esacpe}}">
                                            <img loading="lazy" class="sunline" src="{{block.settings.middle_top_sun | image_url: width: 2000}}" alt="{{block.settings.middle_top_sun.alt | escape}}">
                                        </div>
                                    </div>
                                    <div class="content-middle--bottom">
                                        <div class="flex-item">
                                            <div class="content-middle--bottom__l stragger-item">
                                                <div class="content--item">
                                                    <div class="title">{{block.settings.left_bottom_left_title | escape}}</div>
                                                    <div class="des-icon">
                                                        <div class="des">{{block.settings.left_bottom_left_content | newline_to_br}}</div>
                                                        <img src="{{block.settings.left_bottom_left_icon | image_url: width: 400}}" alt="{{block.settings.left_bottom_left_icon.alt | escape}}">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="flex-item">
                                            <div class="content-middle--bottom__r stragger-item">
                                                <div class="content--item">
                                                    <div class="title">{{block.settings.left_bottom_right_title | escape}}</div>
                                                    <div class="des-icon">
                                                        <div class="des">{{block.settings.left_bottom_right_content | newline_to_br}}</div>
                                                        <img src="{{block.settings.left_bottom_right_icon | image_url: width: 400}}" alt="{{block.settings.left_bottom_right_icon.alt | escape}}">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="content-right">
                                    <div class="content-right--top stragger-item">
                                        <div class="content--item">
                                            <div class="title">{{block.settings.right_top_title | escape}}</div>
                                            <div class="des-icon">
                                                <div class="des">{{block.settings.right_top_content | newline_to_br}}</div>
                                                <img data-pdf="{{block.settings.pdf_url}}" src="{{block.settings.right_top_icon | image_url: width: 400}}" alt="{{block.settings.right_top_icon.alt | escape}}"
                                                data-ga-event="12anniversary_page_user_clicks" data-ga-action="click" data-ga-params-module="Brand Introduction" data-ga-params-position="{{block.settings.right_top_title | escape}}" data-ga-params-button_name="PDF Download"
                                                >
                                            </div>
                                        </div>
                                    </div>
                                    <div class="content-right--bottom stragger-item">
                                        <div class="content--item">
                                            <div class="title">{{block.settings.right_bottom_title | esacpe}}</div>
                                            <div class="des-icon">
                                                <div class="des">{{block.settings.right_bottom_content | newline_to_br}}</div>
                                                <img src="{{block.settings.right_bottom_icon | image_url: width: 400}}" alt="{{block.settings.right_bottom_icon.alt | escape}}">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="animation-trigger kv-animation-trigger"></div>
                    <div class="space-100vh"></div>
                </div>

                <div class="brand-pro--mb {%if block.settings.is_gift_block == true%} gift-anchor--mb{%endif%}">
                    <div class="brand-pro-container">
                        <img src="{{block.settings.middle_top_mb_img | image_url: width: 1200}}" alt="{{block.settings.middle_top_mb_img.alt | escape}}">
                    </div>

                    <div class="brand-list">
                        {% comment %} 左上 {% endcomment %}
                        <div class="brand-card">
                            <div class="title">{{block.settings.left_top_title | escape}}</div>
                            <div class="des">{{block.settings.left_top_content | newline_to_br}}</div>
                            <div class="icon-box"><img src="{{block.settings.left_top_icon | image_url: width: 400}}" alt="{{block.settings.left_top_title | escape}}"></div>
                        </div>

                        {% comment %} 左下 {% endcomment %}
                        <div class="brand-card brand-card--line brand-card--line-sec">
                            <div class="title">{{block.settings.left_bottom_title | escape}}</div>
                            <div class="flex">
                                <div class="des">{{block.settings.left_bottom_content | newline_to_br}}</div>
                                <div class="icon-box"><img src="{{block.settings.left_bottom_icon | image_url: width: 400}}" alt="{{block.settings.left_bottom_title | escape}}"></div>
                            </div>
                        </div>

                        {% comment %} 中下左 {% endcomment %}
                        <div class="brand-card">
                            <div class="title">{{block.settings.left_bottom_left_title | escape}}</div>
                            <div class="des">{{block.settings.left_bottom_left_content | newline_to_br}}</div>
                            <div class="icon-box"><img src="{{block.settings.left_bottom_left_icon | image_url: width: 400}}" alt="{{block.settings.left_bottom_left_title | escape}}"></div>
                        </div>

                        {% comment %} 右上 {% endcomment %}
                        <div class="brand-card brand-card--fff">
                            <div class="title">{{block.settings.right_top_title | escape}}</div>
                            <div class="flex">
                                <div class="des">{{block.settings.right_top_content | newline_to_br}}</div>
                                <div class="icon-box"><img data-pdf="{{block.settings.pdf_url}}" src="{{block.settings.right_top_icon | image_url: width: 400}}" alt="{{block.settings.right_top_title | escape}}"
                                data-ga-event="12anniversary_page_user_clicks" data-ga-action="click" data-ga-params-module="Brand Introduction" data-ga-params-position="{{block.settings.right_top_title | escape}}" data-ga-params-button_name="PDF Download"
                                ></div>
                            </div>
                        </div>

                        {% comment %} 右下 {% endcomment %}
                        <div class="brand-card brand-card--dark">
                            <div class="title">{{block.settings.right_bottom_title | esacpe}}</div>
                            <div class="des">{{block.settings.right_bottom_content | newline_to_br}}</div>
                            <div class="icon-box"><img src="{{block.settings.right_bottom_icon | image_url: width: 400}}" alt="{{block.settings.right_bottom_title | esacpe}}"></div>
                        </div>

                        {% comment %} 中下右 {% endcomment %}
                        <div class="brand-card brand-card--line years-12-animate--bbbb">
                            <div class="title">{{block.settings.left_bottom_right_title | escape}}</div>
                            <div class="flex">
                                <div class="des">{{block.settings.left_bottom_right_content | newline_to_br}}</div>
                                <div class="icon-box"><img src="{{block.settings.left_bottom_right_icon | image_url: width: 400}}" alt="{{block.settings.left_bottom_right_title | escape}}"></div>
                            </div>
                        </div>
                    </div>
                </div>
                {% comment %} 品牌介绍 {% endcomment %}
            {%- when 'awards' -%}
                {% comment %} 奖项 {% endcomment %}
                <div class="awards-container {%if block.settings.is_gift_block == true%} gift-anchor{%endif%}">
                    <div class="container awards-animate">
                        <div class="title">{{block.settings.title | escape}}</div>
                    </div>
                    <div class="container container-list awards-animate">
                        {%- for i in (0..9) -%}
                            {% assign award_index = 'award_' | append: forloop.index %}
                            {%- if block.settings[award_index] != blank -%}
                                <div class="awards-item">
                                    <img src="{{block.settings[award_index] | image_url: width: 400}}" alt="{{block.settings[award_index].alt | escape}}">
                                </div>
                            {%- endif -%}
                        {%- endfor -%}
                    </div>
                </div>

                <div class="awards-container--mb {%if block.settings.is_gift_block == true%} gift-anchor--mb{%endif%}">
                    <div class="title">{{block.settings.title | escape}}</div>
                    <div class="swiper-pagination"></div>
                    <div class="swiper">
                        <div class="swiper-wrapper">
                            {%- for i in (0..9) -%}
                                {% assign award_index = 'award_mb_' | append: forloop.index %}
                                {%- if block.settings[award_index] != blank -%}
                                    <div class="swiper-slide">
                                        <img src="{{block.settings[award_index] | image_url: width: 800}}" alt="{{block.settings[award_index].alt | escape}}">
                                    </div>
                                {%- endif -%}
                            {%- endfor -%}
                        </div>
                    </div>
                </div>
                {% comment %} 奖项 {% endcomment %}
        {%- endcase -%}
    {%- endfor -%}
</div>
<script src="{{ 'scrollTrigger.js' | asset_url }}" defer></script>
<script src="{{ 'gsap.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "12 yaers main",
    "class": "years-12-main years_12_container",
    "settings": [
      {
        "type": "text",
        "id": "sourceId",
        "label": "Source ID"
      }
    ],
    "blocks": [
      {
        "type": "gift_box",
        "name": "深度礼盒",
        "limit": 1,
        "settings": [
            { "type": "color", "id": "active_color", "label": "激活颜色", "default": "#fd5000" },
            { "type": "color", "id": "unlock_color", "label": "未解锁颜色", "default": "#FFFFFF" },
            {"type": "text", "id": "progress_title", "label": "进度解锁标题", "default": "Jackery"},
            {"type": "text", "id": "subtitle", "label": "副标题", "default": "Suprise Gift"},
            { "type": "image_picker", "id": "unlock_gift", "label": "未解锁礼盒图片"},
            { "type": "image_picker", "id": "lock_gift", "label": "已解锁礼盒图片"}
        ]
      },
      {
          "type": "kv_banner",
          "name": "KV banner",
          "limit": 1,
          "settings": [
            { "type": "checkbox", "id": "is_gift_block", "label": "是否为礼盒模块", "default": false, "info": "该模块的顺序请保持：KV-滚动介绍-品牌介绍-获奖Swiper" },
            { "type": "image_picker", "id": "kv_pc", "label": "KV背景图片（PC）"},
            { "type": "image_picker", "id": "kv_mb", "label": "KV背景图片（Mobile）"},
            { "type": "url", "id": "kv_video", "label": "KV视频" },
            {"type": "text", "id": "kv_title", "label": "KV标题", "default": "Founded in Founded in Founded in"}
        ]
      },
      {
          "type": "scroll_content",
          "name": "滚动介绍",
          "limit": 1,
          "settings": [
            { "type": "checkbox", "id": "is_gift_block", "label": "是否为礼盒模块", "default": false, "info": "该模块的顺序请保持：KV-滚动介绍-品牌介绍-获奖Swiper" },
            { "type": "image_picker", "id": "sun_line", "label": "地平线太阳光"},
            {"type": "header", "content": "介绍 1 配置"},
            {"type": "text", "id": "scroll_title_1", "label": "介绍 1 标题", "default": "Founded in"},
            {"type": "richtext", "id": "scroll_content_1", "label": "介绍 1 内容"},
            {"type": "richtext", "id": "scroll_mb_1", "label": "介绍 1 MB内容"},

            {"type": "header", "content": "介绍 2 配置"},
            {"type": "text", "id": "scroll_title_2", "label": "介绍 2 标题", "default": "We Reach"},
            {"type": "richtext", "id": "scroll_content_2", "label": "介绍 2 内容"},
            {"type": "richtext", "id": "scroll_mb_2", "label": "介绍 2 MB内容"},

            {"type": "header", "content": "介绍 3 配置"},
            {"type": "text", "id": "scroll_title_3", "label": "介绍 3 标题", "default": "Have"},
            {"type": "richtext", "id": "scroll_content_3", "label": "介绍 3 内容"},
            {"type": "richtext", "id": "scroll_mb_3", "label": "介绍 3 MB内容"},

            {"type": "header", "content": "介绍 4 配置"},
            {"type": "text", "id": "scroll_title_4", "label": "介绍 4 标题", "default": "Our Vision is"},
            {"type": "richtext", "id": "scroll_content_4", "label": "介绍 4 内容"},
            {"type": "richtext", "id": "scroll_mb_4", "label": "介绍 4 MB内容"},

            {"type": "header", "content": "介绍 5 配置"},
            {"type": "text", "id": "scroll_title_5", "label": "介绍 5 标题", "default": "xxx yyy"},
            {"type": "richtext", "id": "scroll_content_5", "label": "介绍 5 内容"},
            {"type": "richtext", "id": "scroll_mb_5", "label": "介绍 5 MB内容"}
        ]
      },
      {
          "type": "brand_grid",
          "name": "品牌介绍",
          "limit": 1,
          "settings": [
            { "type": "checkbox", "id": "is_gift_block", "label": "是否为礼盒模块", "default": false, "info": "该模块的顺序请保持：KV-滚动介绍-品牌介绍-获奖Swiper" },
            { "type": "image_picker", "id": "sun_line", "label": "地平线太阳光"},

            {"type": "header", "content": "左上版块 信息配置"},
            {"type": "text", "id": "left_top_title", "label": "标题", "default": "Multiple Application Scenarios"},
            {"type": "richtext", "id": "left_top_content", "label": "内容"},
            { "type": "image_picker", "id": "left_top_icon", "label": "ICON"},

            {"type": "header", "content": "左下版块 信息配置"},
            {"type": "text", "id": "left_bottom_title", "label": "标题", "default": "Advanced Technology Innovation"},
            {"type": "richtext", "id": "left_bottom_content", "label": "内容"},
            { "type": "image_picker", "id": "left_bottom_icon", "label": "ICON" },

            {"type": "header", "content": "中上版块 信息配置"},
            {"type": "image_picker", "id": "middle_top_img", "label": "背景图片"},
            {"type": "image_picker", "id": "middle_top_mb_img", "label": "MB背景图片"},
            {"type": "image_picker", "id": "middle_top_sun", "label": "太阳光图片"},

            {"type": "header", "content": "左下-左版块 信息配置"},
            {"type": "text", "id": "left_bottom_left_title", "label": "标题", "default": "Advanced Technology Innovation"},
            {"type": "richtext", "id": "left_bottom_left_content", "label": "内容"},
            { "type": "image_picker", "id": "left_bottom_left_icon", "label": "ICON" },

            {"type": "header", "content": "左下-右版块 信息配置"},
            {"type": "text", "id": "left_bottom_right_title", "label": "标题", "default": "Rigorous Tests"},
            {"type": "richtext", "id": "left_bottom_right_content", "label": "内容"},
            { "type": "image_picker", "id": "left_bottom_right_icon", "label": "ICON" },

            {"type": "header", "content": "右上版块 信息配置"},
            {"type": "text", "id": "right_top_title", "label": "标题", "default": "Uncompromising Quality"},
            {"type": "richtext", "id": "right_top_content", "label": "内容"},
            { "type": "url", "id": "pdf_url", "label": "PDF下载链接" },
            { "type": "image_picker", "id": "right_top_icon", "label": "ICON"},

            {"type": "header", "content": "右下版块 信息配置"},
            {"type": "text", "id": "right_bottom_title", "label": "标题", "default": "Ready for Challenging Environments"},
            {"type": "richtext", "id": "right_bottom_content", "label": "内容"},
            { "type": "image_picker", "id": "right_bottom_icon", "label": "ICON" }
        ]
      },
      {
          "type": "awards",
          "name": "获奖Swiper",
          "limit": 1,
          "settings": [
            { "type": "checkbox", "id": "is_gift_block", "label": "是否为礼盒模块", "default": false, "info": "该模块的顺序请保持：KV-滚动介绍-品牌介绍-获奖Swiper" },
            { "type": "text", "id": "title", "label": "标题", "default": "Latest Awards"},
            {"type": "header", "content": "奖项 1 配置"},
            { "type": "image_picker", "id": "award_1", "label": "奖项 1 图片"},
            { "type": "image_picker", "id": "award_mb_1", "label": "奖项 1 MB图片"},

            {"type": "header", "content": "奖项 2 配置"},
            { "type": "image_picker", "id": "award_2", "label": "奖项 2 图片"},
            { "type": "image_picker", "id": "award_mb_2", "label": "奖项 2 MB图片"},

            {"type": "header", "content": "奖项 3 配置"},
            { "type": "image_picker", "id": "award_3", "label": "奖项 3 图片"},
            { "type": "image_picker", "id": "award_mb_3", "label": "奖项 3 MB图片"},

            {"type": "header", "content": "奖项 4 配置"},
            { "type": "image_picker", "id": "award_4", "label": "奖项 4 图片"},
            { "type": "image_picker", "id": "award_mb_4", "label": "奖项 4 MB图片"},

            {"type": "header", "content": "奖项 5 配置"},
            { "type": "image_picker", "id": "award_5", "label": "奖项 5 图片"},
            { "type": "image_picker", "id": "award_mb_5", "label": "奖项 5 MB图片"},

