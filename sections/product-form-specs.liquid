  <style>
    .product-table-specs {background: #fff;}
    .product-table-specs-container {margin: 0 auto;max-width:1440px;width:auto;min-width: 1004px;padding: 0 64px;}
    .product-table-specs-container h2 {font-size: 40px;line-height: 56px;color: #1A1A1A;width: 100%;text-align: center;font-weight: 500;}
    .product-table-specs table{margin: 40px 0 0 0;padding: 0;width: 100%;max-width: 100%;border-collapse: collapse;border-style: hidden;border: none;outline: none;border-spacing: 1px;position: relative;background: #FFF;}
    .product-table-specs .table-column {min-width: 145px;padding: 15px 24px;text-align: center;font-size: 24px;font-weight: 600;color: #1A1A1A;background-color: #F2F4F5;border-left: 4px solid #FFFFFF;}
    .product-table-specs .table-row {background-color: #fff;text-align:center;padding: 0 24px;min-width: 120px;border-left: 4px solid #FFFFFF;}
    .product-table-specs .table-row div {text-align: center;padding:15px 0;font-size: 16px;color: #1A1A1A;}
    .product-table-specs .table-column:first-of-type,
    .product-table-specs .table-row:first-of-type {border-left: 0;}
    .product-table-specs tr:first-of-type .table-row{padding-top: 4px;}
    .product-table-specs table[data-align="left"] .table-column {text-align: left;}
    .product-table-specs table[data-align="left"] .table-row div {text-align: left;}
    .product-table-specs .table-row {position: relative;}
    .product-table-specs .table-row::after {display: block;content: '';width:calc(100% - 48px);height:1px;background-color:rgba(0,0,0,0.07);position: absolute;left: 24px;bottom:0;}
    .product-table-specs .table-row picture {display:block;padding-top: 4px;}
    .product-table-specs thead {font-weight: 600;}
    .table-container {overflow-x: scroll;width: 100%;margin:0 auto;}
    .table-container::-webkit-scrollbar {width: 0;}
    .table-container::-webkit-scrollbar-track {background-color: transparent;}
    .table-container::-webkit-scrollbar-thumb {background-color: transparent;}
    .table-container::-webkit-scrollbar-thumb:hover {background-color: transparent;}
    .product-table-specs .table-row a {color: var(--primary-color);}
    .product-table-specs .table-row a>em {background: var(--jds-color-primary);border-radius: 4px;font-size: 15px;
      line-height: 16px;padding: 12px 18px;text-align: center;color: #fff;display:inline-block;margin-top: 6px}
    .jky-v5 .product-table-specs .table-row a>em{ border-radius: 0;}
    .product-table-specs .table-row a>em:active {opacity: 0.6;transition: opacity 0.1s ease;}

      @media screen and (max-width: 1024px) {
        .product-table-specs-container {max-width: 100%;min-width: unset;padding: 0 4.26666667vw;}
        .product-table-specs-container h2 {font-size: 8.53333333333333vw;line-height: 10.6666666666667vw;max-width: 91.4666666666667vw;margin: 0 auto;text-align: left;font-weight: 600;padding-left: 4.26666666666667vw;padding-right: 4.26666666666667vw;}
        .product-table-specs table {margin-top: 5.33333333333333vw;}
        .product-table-specs tr:first-of-type .table-row{padding-top: 1.06666666666667vw;}
        .product-table-specs .table-row a>em {padding: 4px 8px;margin-top: 3px;font-size: 13px;}
        .product-table-specs tr .table-column:first-of-type{border-top-left-radius: 1.06666666666667vw;border-bottom-left-radius: 1.06666666666667vw;}
        .product-table-specs tr .table-column:last-of-type{border-top-right-radius: 1.06666666666667vw;border-bottom-right-radius: 1.06666666666667vw;}
        .product-table-specs .table-column {min-width: unset;padding: 4vw 3.2vw;border-left: 0;font-size: 4.26666666666667vw;}
        .product-table-specs .table-row{border-left: 0;font-size: 3.46666666666667vw;padding: 0 3.2vw;position: relative;}
        .product-table-specs .table-row div{padding: 3.2vw 0;border-bottom: 0;font-size: 3.46666666666667vw;font-weight: 500;}
        .product-table-specs .table-row::after{width: 100%;left: 0;}
        .product-table-specs tr .table-row:first-of-type::after{width: calc(100% - 3.2vw);left: 3.2vw;}
        .product-table-specs tr .table-row:last-of-type::after{width: calc(100% - 3.2vw);left: 0;}

      }
  </style>

  {% style %}
    .section-{{section.id}} .table-row picture img{max-width: {{section.settings.td_img_w}}px; width: {{section.settings.td_img_w}}px;max-height: {{section.settings.td_img_w}}px;}
  {% endstyle %}

  <div
    {% if section.settings.anchor != blank %}
      data-anchor="{{section.settings.anchor}}"
    {% endif %}
    data-handle="{{ section.settings.handle }}"
    class="
      section-{{section.id}} product-table-specs-container relative product-b
      {% if section.settings.type == 'embed' %} embed-component {% endif %}
    "
    style="padding-top:{{section.settings.section_padding_top}}px;padding-bottom:{{section.settings.section_padding_bottom}}px;"
  >
    {% if section.settings.title != blank %}
      <h2 class="text-center jky-text-2xl">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="table-container">
      <table data-align="{{section.settings.text_align}}">
        <thead>
          <tr>
            {% if section.settings.table_h_1 != blank %}
              <td class="table-column">{{section.settings.table_h_1}}</td>
            {% endif %}

            {% if section.settings.table_h_2 != blank %}
              <td class="table-column">{{section.settings.table_h_2}}</td>
            {% endif %}

            {% if section.settings.table_h_3 != blank %}
              <td class="table-column">{{section.settings.table_h_3}}</td>
            {% endif %}

            {% if section.settings.table_h_4 != blank %}
              <td class="table-column">{{section.settings.table_h_4}}</td>
            {% endif %}

            {% if section.settings.table_h_5 != blank %}
              <td class="table-column">{{section.settings.table_h_5}}</td>
            {% endif %}

            {% if section.settings.table_h_6 != blank %}
              <td class="table-column">{{section.settings.table_h_6}}</td>
            {% endif %}

            {% if section.settings.table_h_7 != blank %}
              <td class="table-column">{{section.settings.table_h_7}}</td>
            {% endif %}

            {% if section.settings.table_h_8 != blank %}
              <td class="table-column">{{section.settings.table_h_8}}</td>
            {% endif %}

            {% if section.settings.table_h_9 != blank %}
              <td class="table-column">{{section.settings.table_h_9}}</td>
            {% endif %}

            {% if section.settings.table_h_10 != blank %}
              <td class="table-column">{{section.settings.table_h_10}}</td>
            {% endif %}
          </tr>
        </thead>

        <tbody>
          {% for block in section.blocks %}
            <tr>
              {% if section.settings.table_h_1 != blank %}
                <td class="table-row">
                  {% if block.settings.row_1 != blank %}
                    <div>{{block.settings.row_1 | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_1_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_1_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}

              {% if section.settings.table_h_2 != blank %}
                <td class="table-row">
                  {% if block.settings.row_2 != blank %}
                    <div>{{block.settings.row_2  | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_2_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_2_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}

              {% if section.settings.table_h_3 != blank %}
                <td class="table-row">
                  {% if block.settings.row_3 != blank %}
                    <div>{{block.settings.row_3 | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_3_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_3_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}

              {% if section.settings.table_h_4 != blank %}
                <td class="table-row">
                  {% if block.settings.row_4 != blank %}
                    <div>{{block.settings.row_4 | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_4_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_4_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}

              {% if section.settings.table_h_5 != blank %}
                <td class="table-row">
                  {% if block.settings.row_5 != blank %}
                    <div>{{block.settings.row_5 | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_5_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_5_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}

              {% if section.settings.table_h_6 != blank %}
                <td class="table-row">
                  {% if block.settings.row_6 != blank %}
                    <div>{{block.settings.row_6 | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_6_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_6_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}

              {% if section.settings.table_h_7 != blank %}
                <td class="table-row">
                  {% if block.settings.row_7 != blank %}
                    <div>{{block.settings.row_7 | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_7_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_7_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}

              {% if section.settings.table_h_8 != blank %}
                <td class="table-row">
                  {% if block.settings.row_8 != blank %}
                    <div>{{block.settings.row_8 | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_8_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_8_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}

              {% if section.settings.table_h_9 != blank %}
                <td class="table-row">
                  {% if block.settings.row_9 != blank %}
                    <div>{{block.settings.row_9 | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_9_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_9_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}

              {% if section.settings.table_h_10 != blank %}
                <td class="table-row">
                  {% if block.settings.row_10 != blank %}
                    <div>{{block.settings.row_10 | newline_to_br}}</div>
                  {% endif %}

                  {% if block.settings.row_10_pic != blank %}
                    {% render 'responsive-image', image: block.settings.row_10_pic, width: 300, mwidth: 240 %}
                  {% endif %}
                </td>
              {% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

{% schema %}
{
  "name": "Product Table Specs",
  "tag": "section",
  "class": "section product-table-specs product-section-block",
  "enabled_on": {
    "templates": ["product", "blog", "article"]
  },
  "settings": [
      {
        "type": "select",
        "id": "type",
        "label": "类型",
        "default": "independent",
        "options": [
          {
            "value": "embed",
            "label": "内嵌使用"
          },
          {
            "value": "independent",
            "label": "独立使用"
          }
        ]
      },
      {
        "type": "text",
        "id": "handle",
        "label": "Handle（当前页面唯一的handle）",
        "default": "product-form-specs-table-01"
      },
      {
        "type": "number",
        "id": "section_padding_top",
        "label": "上间距（单位px）",
        "default": 96
      },
      {
        "type": "number",
        "id": "section_padding_bottom",
        "label": "下间距（单位px）",
        "default": 96
      },
      {
        "type": "range",
        "id": "td_img_w",
        "min": 200,
        "max": 400,
        "step": 40,
        "label": "表格图片尺寸？",
        "default": 240
      },
      {
        "type": "select",
        "id": "anchor",
        "label": "锚点设置",
        "info": "非锚点section请清空此项",
        "options": [
            {
            "value": "",
            "label": "非锚点section"
            },
            {
            "value": "anchor__1",
            "label": "第一个section锚点"
            },
            {
            "value": "anchor__2",
            "label": "第二个section锚点"
            },
            {
            "value": "anchor__3",
            "label": "第三个section锚点"
            },
            {
            "value": "anchor__4",
            "label": "第四个section锚点"
            }
        ],
        "default": ""
      },
      {
        "type": "select",
        "id": "text_align",
        "label": "table 文案对齐方式",
        "options": [
          {
            "value": "center",
            "label": "居中对齐"
          },
          {
            "value": "left",
            "label": "左对齐"
          }
        ],
        "default": "center"
      },
      {"type": "textarea", "id": "title", "label": "Form Heading", "default": "使用できる電化製品の例"},
      {"type": "text", "id": "table_h_1", "label": "Form head 1", "info": "表头1（由1-10依次设置，后面没有空置即可）", "default": "製品"},
      {"type": "text", "id": "table_h_2", "label": "Form head 2", "info": "表头2（由1-10依次设置，后面没有空置即可）", "default": "消費電力"},
      {"type": "text", "id": "table_h_3", "label": "Form head 3", "info": "表头3（由1-10依次设置，后面没有空置即可）", "default": "利用時間/回数"},
      {"type": "text", "id": "table_h_4", "label": "Form head 4", "info": "表头4（由1-10依次设置，后面没有空置即可）"},
      {"type": "text", "id": "table_h_5", "label": "Form head 5", "info": "表头5（由1-10依次设置，后面没有空置即可）"},
      {"type": "text", "id": "table_h_6", "label": "Form head 6", "info": "表头6（由1-10依次设置，后面没有空置即可）"},
      {"type": "text", "id": "table_h_7", "label": "Form head 7", "info": "表头7（由1-10依次设置，后面没有空置即可）"},
      {"type": "text", "id": "table_h_8", "label": "Form head 8", "info": "表头8（由1-10依次设置，后面没有空置即可）"},
      {"type": "text", "id": "table_h_9", "label": "Form head 9", "info": "表头9（由1-10依次设置，后面没有空置即可）"},
      {"type": "text", "id": "table_h_10", "label": "Form head 10", "info": "表头10（由1-10依次设置，后面没有空置即可）"}
  ],
  "blocks": [{
      "type": "table", "name": "Specs Table line",
      "settings": [
          {"type": "text", "id": "title", "label": "Title"},
          {"type": "richtext", "id": "row_1", "label": "Form row 1", "info": "表头1内容(内容和图片对应表头有则填，没有空置即可，备注：普通链接正常插入链接即可，如果需要设置按钮形式的链接【先选中链接的文案插入链接，然后再将其设置斜体】)"},
          {"type": "image_picker", "id": "row_1_pic", "label": "表头1图片"},

          {"type": "richtext", "id": "row_2", "label": "Form row 2", "info": "表头2内容(内容和图片对应表头有则填，没有空置即可)"},
          {"type": "image_picker", "id": "row_2_pic", "label": "表头2图片"},

          {"type": "richtext", "id": "row_3", "label": "Form row 3", "info": "表头3内容(内容和图片对应表头有则填，没有空置即可)"},
          {"type": "image_picker", "id": "row_3_pic", "label": "表头3图片"},

          {"type": "richtext", "id": "row_4", "label": "Form row 4", "info": "表头4内容(内容和图片对应表头有则填，没有空置即可)"},
          {"type": "image_picker", "id": "row_4_pic", "label": "表头4图片"},

          {"type": "richtext", "id": "row_5", "label": "Form row 5", "info": "表头5内容(内容和图片对应表头有则填，没有空置即可)"},
          {"type": "image_picker", "id": "row_5_pic", "label": "表头5图片"},

          {"type": "richtext", "id": "row_6", "label": "Form row 6", "info": "表头6内容(内容和图片对应表头有则填，没有空置即可)"},
          {"type": "image_picker", "id": "row_6_pic", "label": "表头6图片"},

          {"type": "richtext", "id": "row_7", "label": "Form row 7", "info": "表头7内容(内容和图片对应表头有则填，没有空置即可)"},
          {"type": "image_picker", "id": "row_7_pic", "label": "表头7图片"},

          {"type": "richtext", "id": "row_8", "label": "Form row 8", "info": "表头8内容(内容和图片对应表头有则填，没有空置即可)"},
          {"type": "image_picker", "id": "row_8_pic", "label": "表头8图片"},

          {"type": "richtext", "id": "row_9", "label": "Form row 9", "info": "表头9内容(内容和图片对应表头有则填，没有空置即可)"},
          {"type": "image_picker", "id": "row_9_pic", "label": "表头9图片"},

          {"type": "richtext", "id": "row_10", "label": "Form row 10", "info": "表头10内容(内容和图片对应表头有则填，没有空置即可)"},
          {"type": "image_picker", "id": "row_10_pic", "label": "表头10图片"}
      ]
  }],
  "presets": [
    {
      "name": "product specs table"
    }
  ]
}
{% endschema %}