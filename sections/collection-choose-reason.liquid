<style>
    .section-collection-reason .pc-show {display: block;}
    .section-collection-reason .mb-show {display: none;}
    .section-collection-reason--{{section.id}} .pdp-three-text-img {
        padding-top: {{section.settings.padding_top | divided_by: 16.0}}rem;
        padding-bottom: {{section.settings.padding_bottom | divided_by: 16.0}}rem;
    }

    .section-collection-reason .pdp-three-text-img .section-title {margin-bottom: 1rem;font-size: 2.5rem;line-height: 3rem;color: var(--jds-color-text-l1);}
    .section-collection-reason .pdp-three-text-img .section-title em, .section-collection-reason .pdp-three-text-img .keyword-sub em {color: var(--jds-color-primary);}
    .section-collection-reason .pdp-three-text-img .section-title a, .section-collection-reason .pdp-three-text-img .keyword-sub a, .section-collection-reason .pdp-three-text-img .card-list .subtitle a {text-decoration: underline;text-underline-offset: 4px;}
    .section-collection-reason .pdp-three-text-img .keyword-sub {font: var(--jds-font-b1-medium);
    color: var(--jds-color-text-l2);}
    .section-collection-reason .pdp-three-text-img.keyword .quality-swiper-container {margin-top: 2.5rem;}
    .section-collection-reason .keyword-three-text-img .pdp-three-text-img .card-list img {margin-bottom: 2rem;}
    @media screen and (max-width: 1024px) {
        .section-collection-reason .pc-show {display: none;}
        .section-collection-reason .mb-show {display: block;} 
        .section-collection-reason--{{section.id}} .pdp-three-text-img {
            padding-top: {{section.settings.padding_top_mb | divided_by: 16.0}}rem;
            padding-bottom: {{section.settings.padding_bottom_mb | divided_by: 16.0}}rem;
        }

        .section-collection-reason .keyword-three-text-img .pdp-three-text-img .card-list img {margin-bottom: 0.75rem;}
        .section-collection-reason .keyword-three-text-img .pdp-three-text-img .card-list .three-video-box {margin-bottom: 0.75rem;}
        .section-collection-reason .pdp-three-text-img .section-title {width: 100%;margin-bottom: 0.5rem;font-size: 1.75rem;padding: 0 0.5rem;}
        .section-collection-reason .pdp-three-text-img .keyword-sub {width: 100%;font-size: 0.875rem;color: #666;line-height: 1.25rem;}
        .section-collection-reason .pdp-three-text-img .card-list .title {font-size: 1rem;line-height: 1.5rem;margin-bottom: 0.5rem;}
        .section-collection-reason .pdp-three-text-img .card-list .subtitle {font-size: 0.875rem;line-height: 1.375rem;font-weight: 400;padding: 0 0.5rem;}
        .section-collection-reason .pdp-three-text-img.keyword .quality-swiper-container {padding: 0;margin-top: 1.5rem;}
        .section-collection-reason .pdp-three-text-img.keyword .quality-pagination {gap: 0.375rem;background: transparent;justify-content: center;}
        .section-collection-reason .pdp-three-text-img.keyword .quality-pagination .swiper-pagination-bullet {background: #CCCCCC;width: 0.5rem;border-radius: 8px;transition: all .24s ease;flex: unset;opacity: 1;}
        .section-collection-reason .pdp-three-text-img.keyword .quality-pagination .swiper-pagination-bullet-active {background: var(--jds-color-primary);width: 2.5rem;}
    }
</style>

<div class="section-container-lg section-collection-reason--{{section.id}}">
  <div 
    class="keyword-three-text-img"
    data-swiper="{{ section.settings.swiper }}"
    data-space="10"
    data-slidesPerView="1.1"
  >
    <div class="pdp-v4-content">
        {% render 'pdp-three-text-img', settings: section.settings, index: 1 %}
    </div>
</div>
 
