<div class="legal-person-swiper" anchor="{{ section.settings.anchor | escape }}">
    <div class="section-photovolatic-find-out" {%if block.settings.anchor_id != blank%}anchor={{block.settings.anchor_id | escape}}{% endif %}>
        {%- render "product-detail-videos", settings: section.settings -%}
    </div>
</div>

{% schema %}
{
  "name": "legal person page",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "anchor", "label": "二级标题定位锚点", "info": "搭配二级导航锚点定位未使用到定位则不配置" },
    { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#ffffff" },
    {"type": "textarea", "id": "title", "label": "Title"},
    {"type": "select", "id": "video_size", "label": "选择视频样式：", "default":"video_small", "options": [{"value": "video_small", "label": "竖屏"},{"value": "video_large", "label": "横屏"}]},
    {"type": "checkbox", "id": "loop", "label": "循环播放？", "default": true},
    {"type": "checkbox", "id": "controls", "label": "显示播放控件？", "default": true},

    {"type": "header", "content": "视频信息 1 配置"},
    {"type": "image_picker", "id": "poster_1", "label": "视频信息 1 封面图片"},
