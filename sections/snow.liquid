  // 获取服务器时间
  async function getServerTime1(shopifyShopId) {
    const url = `https://api.myjackery.com/osconsumerapi/v1/com/get-server-time?shopify_shop_id=${shopifyShopId}`
    const response = await fetch(url, {
        method: "GET",
        mode: "cors",
        cache: "no-cache",
        headers: {
            "Content-Type": "application/json",
        },
    });
    const { data, } = await response.json()
    return new Date(data.datetime).getTime()
  }
</script>