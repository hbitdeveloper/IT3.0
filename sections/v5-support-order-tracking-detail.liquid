
{{ 'sections-v5-support-order-tracking-detail.css' | asset_url | stylesheet_tag }}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  class="v5-order-tracking-detail section-padding"
  id="v5-order-tracking-detail-{{ section.id }}"
  style="{{ style }}"
  data-request-failed-text="{{ section.settings.request_failed_text | escape }}"
  data-back-fallback-url="{{ section.settings.back_fallback_url.url | escape }}"
  data-support-email="{{ section.settings.support_email | escape }}"
>
  <div class="main-container">
    <div class="v5-order-tracking-detail__inner">
      <div class="v5-order-tracking-detail__loading js-otd-loading">{{ section.settings.loading_text }}</div>
      <div class="v5-order-tracking-detail__steps js-otd-steps" hidden></div>
      <div class="v5-order-tracking-detail__empty js-otd-empty" hidden>
        {% if section.settings.empty_image != blank %}
          <img src="{{ section.settings.empty_image | escape }}" alt="{{ section.settings.empty_image_alt | escape }}">
        {% endif %}
        <p class="v5-order-tracking-detail__empty-text js-otd-empty-text" data-template="{{ section.settings.empty_message | escape }}">{{ section.settings.empty_message }}</p>
        <jds-button class="js-otd-back" type="button" variant="secondary">{{ section.settings.back_button_text }}</jds-button>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'sections-v5-support-order-tracking-detail.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5-Support Order Detail",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Desktop Spacing" },
    { "type": "number", "id": "padding_top", "label": "Padding top", "default": 0 },
    { "type": "number", "id": "padding_bottom", "label": "Padding bottom", "default": 0 },
    { "type": "header", "content": "Mobile Spacing" },
    { "type": "text", "id": "mb_padding_type", "default": "custom", "label": "Mobile spacing mode", "visible_if": "{{ false }}" },
    { "type": "number", "id": "padding_top_mb", "label": "Padding top", "default": 0 },
    { "type": "number", "id": "padding_bottom_mb", "label": "Padding bottom", "default": 0 },
    { "type": "text", "id": "loading_text", "label": "Loading text", "default": "Loading..." },
    { "type": "text", "id": "request_failed_text", "label": "Request failed fallback text", "default": "Request failed. Please try again later." },
    { "type": "text", "id": "empty_image", "label": "Empty image URL", "default": "https://cdn.shopify.com/s/files/1/0970/9262/files/a98ad624a1bd89a26b980f77c5f52e80.png?v=1658221357_270x" },
    { "type": "text", "id": "empty_image_alt", "label": "Empty image alt", "default": "track-order not found" },
    { "type": "textarea", "id": "empty_message", "label": "Empty message", "default": "We could not find your order. Please contact [email]." },
    { "type": "text", "id": "back_button_text", "label": "Back button text", "default": "Back" },
    { "type": "page", "id": "back_fallback_url", "label": "Back fallback URL" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "hello@jackery.com" }
  ],
  "presets": [
    {
      "name": "V5-Support Order Detail",
      "category": "V5.0 Support"
    }
  ]
}
{% endschema %}
