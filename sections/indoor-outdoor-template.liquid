{% comment %} Tab栏导航 {% endcomment %}
{%- assign tabs_num = 0 -%}
{%- assign tabs_list = '' -%}
{%- assign tabs_id = '' -%}

{%- for block in section.blocks -%}
  {%- if block.settings.block_id != blank -%}
    {%- assign tabs_num = tabs_num | plus: 1 -%}
    {%- assign tabs_list = tabs_list | append: block.settings.block_id -%}
    {%- assign tabs_id = tabs_id | append: block.settings.anchor_id -%}
    {%- unless forloop.last -%}
      {%- assign tabs_list = tabs_list | append: '-' -%}
      {%- assign tabs_id = tabs_id | append: '-' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign bar_tran_w = 100 | divided_by: tabs_num -%}
{%- assign tabs_list = tabs_list | split: '-' -%}
{%- assign tabs_id = tabs_id | split: '-' -%}
{%- render 'five-kwh-tab',
  bar_tran_w: bar_tran_w,
  list: tabs_list,
  list_id: tabs_id,
  new_window: section.settings.new_window,
  tab_bg_color: section.settings.tab_bg_color,
  tab_active_color: section.settings.tab_active_color,
  text_active_color: section.settings.text_active_color,
  text_color: section.settings.text_color
-%}
{% comment %} Tab栏导航 {% endcomment %}

{% comment %} 自定义场景页 {% endcomment %}
<div class="indoor-and-outdoor five-kwh--content" style="background: {{ section.settings.bgColor }}">
  <div class="activity--content_item five_kwh--content_item">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {% when 'empty-block-box' %}
          {% comment %} 空盒子版块 {% endcomment %}
          {% render 'empty-block-box',settings: block.settings, anchorID: block.settings.anchor_id, handle: block.settings.sourceHandle, index: forloop.index %}
        {%- when 'indoor_banner' -%}
          {%- render 'indoor-banner', banner: block.settings, new_window: section.settings.new_window -%}
        {%- when 'indoor_letter' -%}
          {% comment %} 信任状 {% endcomment %}
          {% render 'five-kwh-letter', letter: block.settings, index: forloop.index %}
        {%- when 'indoor_subscribe' -%}
          {% comment %} 订阅版块 {% endcomment %}
          {% render 'indoor-subscribe',
            subscribe: block.settings,
            index: forloop.index,
            new_window: section.settings.new_window
          %}
        {%- when 'indoor_swiper_one' -%}
          {% comment %} 轮播一 {% endcomment %}
          {% render 'indoor-swiper-one', swiperone: block.settings, index: forloop.index %}
        {%- when 'indoor_img_text' -%}
          {% comment %} 图文版块 {% endcomment %}
          {% render 'indoor-img-text', imgtext: block.settings, index: forloop.index %}
        {%- when 'indoor_product' -%}
          {% comment %} 产品版块 {% endcomment %}
          {% render 'indoor-product',
            product: block.settings,
            index: forloop.index,
            new_window: section.settings.new_window
          %}
        {%- when 'indoor_swiper_two' -%}
          {% comment %} 轮播二 {% endcomment %}
          {% render 'indoor-swiper-two', swipertwo: block.settings, index: forloop.index %}

        {%- when 'indoor_faq' -%}
          {% comment %} FAQ {% endcomment %}
          {% render 'indoor-faq', faq: block.settings, index: forloop.index %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

<script defer>
  (function () {
    const init = function () {
      const contentContainer = document.querySelector('.indoor-and-outdoor .activity--content_item');
      const fiveKwhTab = document.querySelector('.five-kwh-tab');
      if (!contentContainer || !fiveKwhTab) return;

      const getFirstVisibleItem = () => {
        const children = Array.from(contentContainer.children || []);
        for (let i = 0; i < children.length; i += 1) {
          const el = children[i];
          if (el && el.offsetHeight > 0) return el;
        }
        return contentContainer.firstElementChild;
      };

      let firstContentItem = getFirstVisibleItem();

      let ticking = false;
      const update = function () {
        const scrollPosition = window.scrollY || document.documentElement.scrollTop || 0;
        if (!firstContentItem || firstContentItem.offsetHeight <= 0) {
          firstContentItem = getFirstVisibleItem();
        }
        const contentHeight = firstContentItem ? firstContentItem.offsetHeight || 0 : 0;
        if (!firstContentItem || contentHeight <= 0) return;
        const contentOffset = firstContentItem.getBoundingClientRect().top + scrollPosition;
        const isVisible = scrollPosition >= contentOffset + contentHeight * 0.8;

        fiveKwhTab.classList.toggle('show-wrapper', isVisible);
        fiveKwhTab.classList.toggle('hide-wrapper', !isVisible);
        fiveKwhTab.style.display = scrollPosition >= contentOffset + contentHeight * 0.5 ? 'block' : 'none';
      };

      const onScroll = function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          update();
          ticking = false;
        });
      };

      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      window.addEventListener('load', onScroll, { passive: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();

</script>
