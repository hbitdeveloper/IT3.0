<script defer>
  {% if customer %}
    window.ed_userInfo = { earthName: '{{ customer.first_name }}' + ' ' + '{{ customer.last_name }}' };
  {% else %}
    window.ed_userInfo = { earthName: "" };
  {% endif %}
</script>

{% schema %}
  {
    "name": "Earth Day",
    "class": "section section-earth-day",
    "settings": [
      {
        "type": "textarea",
        "id": "help_choose_title",
        "label": "Help To Choose Title",
        "default": "How Many Solar Panels Do I Need"
      },
      {
        "type": "image_picker",
        "id": "help_choose_ip",
        "label": "Help Choose IP Image"
      }, {
        "type": "image_picker",
        "id": "recharging_icon",
        "label": "Recharging Icon Image"
      }, {
        "type": "image_picker",
        "id": "energy_saving_icon",
        "label": "Energy Saving Icon Image"
      }, {
        "type": "image_picker",
        "id": "carbon_reduction_icon",
        "label": "Carbon Reduction Icon Image"
      }
    ]
  }
{% endschema %}
