{% comment %} banner {% endcomment %}
<div class="ed-banner">
  <img src="https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay-web/ed-banner.jpg" alt="image" loading="lazy" />
  <div class="ed-banner-text-wrap">
    <h2 class="earth-i18n" data-i18n="BANNER.TITLE"></h2>
    <p class="earth-i18n" data-i18n="BANNER.PROMOTE1"></p>
    <p class="earth-i18n" data-i18n="BANNER.PROMOTE2"></p>
  </div>
</div>

{% comment %} lattice {% endcomment %}
<div class="ed-lattice-content">
  <div class="ed-header">
    <h3 class="ed-header-title font-bold ed-text-5xl earth-i18n" data-i18n="NineHouseLattice.FirstTitle"></h3>
    <div class="ex-header-desc-wrap">
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="NineHouseLattice.FirstPrompt1"></p>
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="NineHouseLattice.FirstPrompt2"></p>
    </div>
  </div>

  <div class="ed-nine ed-flex-center">
    <div class="ed-lattice"></div>
  </div>
  <div class="ed-lattice-btn ed-flex-center">
    <button class="ed-flex-center"></button>
  </div>
  <div class="ed-lattice-vote ed-flex-center">
    <div class="ed-text-base"></div>
  </div>
</div>
{% comment %} vote {% endcomment %}
<div class="ed-vote-content">
  <div class="ed-header">
    <h3 class="ed-header-title font-bold ed-text-5xl earth-i18n" data-i18n="VOTE.VOTETITLE"></h3>
    <div class="ex-header-desc-wrap">
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="VOTE.VOTEDESCIPTION1"></p>
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="VOTE.VOTEDESCIPTION2"></p>
    </div>
  </div>
  <div class="ed-vote-center">
    <div class="ed-vote-main-wrap">
      <ul class="ed-vote-main">

      </ul>
    </div>
  </div>
  <div class="ed-vote-bottom">
    <div class="ed-vote-submit">
      <div class="ed-vote-submit-wrap">
        <form class="ed-vote-form">
          <input id="emial_t" maxlength="100" class="ed-vote-input earth-i18n ed-text-xl font-400" type="text" id="email" data-i18n="VOTE.VOTEINPUTPLACEHOLDER" />
        </form>
        <div class="ed-vote-btn-wrap">
          <button class="ed-vote-submitbtn">
            <span class="ed-vote-submit-icon"><img src="https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay-web/icon-check.png" loading="lazy" /></span>
            <span class="ed-vote-submit-text earth-i18n" data-i18n="NineHouseLattice.FirstBtn"></span>
          </button>
        </div>
      </div>
    </div>
    <div class="ed-vote-protocol">
      <div class="ed-vote-checkbox">
        <span class="ed-vote-checkbox-wrap">
          <input type="checkbox" class="ed-checkbox_input" />
        </span>
        <label class="ed-vote-checkbox-label ed-text-base font-thin">
          <span class="earth-i18n" data-i18n="VOTE.VOTEPROTOCOLLABEL"></span>
        </label>
      </div>
    </div>
    <div class="ed-vote-btn-wrap ed-mobile-vote-btn">
      <button class="ed-vote-submitbtn">
        <span class="ed-vote-submit-icon"><img src="https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay-web/icon-check.png" loading="lazy" /></span>
        <span class="ed-vote-submit-text earth-i18n" data-i18n="NineHouseLattice.FirstBtn"></span>
      </button>
    </div>
  </div>
  <div class="ed-vote-success">

  </div>
</div>
{% comment %} prize {% endcomment %}
<div class="ed-prize">
  <div class="ed-header">
    <h3 class="ed-header-title font-bold ed-text-5xl earth-i18n" data-i18n="PRIZE.PRIZE_TITLE"></h3>
    <div class="ex-header-desc-wrap">
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="PRIZE.PRIZE_PROMPT1"></p>
      <p class="ed-header-desc font-500 ed-text-xl earth-i18n" data-i18n="PRIZE.PRIZE_PROMPT2"></p>
    </div>
  </div>
  <div class="ed-prize-filled">
    <div class="ed-prize-content">
        <div class="ed-prize-content-l ed-flex-center">
            <img src="https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay-web/ed-prize-l-bg.png" alt="" loading="lazy" >
        </div>
        <div class="ed-prize-content-r">
          <div class="ed-prize-content-r-text"></div>
          <div class="ed-prize-content-r-display">
            <p class="ed-prize-content-r-display-title font-bold ed-text-3xl earth-i18n" data-i18n="PRIZE.PRIZE_DISPLAY_TITLE"></p>
            <div class="ed-prize-content-r-display-content ed-flex-between"></div>
            <div class="ed-prize-content-r-btn">
              <button class="ed-flex-center">
                <img src="https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay-web/ed-share-iconA.png" alt="" loading="lazy">
                <span class="font-bold ed-text-base earth-i18n" data-i18n="PRIZE.PRIZE_DISPLAY_BTN"></span>
              </button>
              <div class="ed-share-container">
                <div class="ed-share"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="ed-prize-content-t">
          <img src="https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay-web/ed-prize-r-bg.png" alt="" loading="lazy">
      </div>
    </div>
  </div>
  <div class="ed-prize-content ed-prize-not ed-flex-center">
    <div class="font-500 ed-text-xl ed-prize-not-text earth-i18n" data-i18n="PRIZE.PRIZE_CONTENT_NOT"></div>
    <div class="ed-prize-not-btn ed-prize-content-r-btn">
      <button class="ed-flex-center">
        <img src="https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay-web/ed-share-iconA.png" alt="" loading="lazy">
        <span class="earth-i18n" data-i18n="PRIZE.PRIZE_DISPLAY_BTN"></span>
      </button>
    </div>
  </div>
  <div class="ed-prize-share-btn ed-flex-center">
      <img src="https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay-web/ed-share-icon.png" alt="" loading="lazy">
      <span class="font-bold ed-text-xs earth-i18n" data-i18n="PRIZE.PRIZE_DISPLAY_BTN"></span>
      <div class="ed-share-container">
        <div class="ed-share"></div>
      </div>
  </div>
</div>

