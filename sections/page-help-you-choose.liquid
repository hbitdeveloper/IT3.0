<style>
  .section-page-help-you-choose * {
    word-break: keep-all;
  }
  .section-page-help-you-choose picture {
    width: 100%;
  }
  @media(min-width: 1024px) {
    .section-page-help-you-choose .pc-banner {
      max-height: calc(100vh - var(--header-main) - var(--announcement-height));
    }
    .section-page-help-you-choose li .choose-checkbox-title {
      margin-top: 4px;
    }
  }
</style>

{% comment %} banner {% endcomment %}
<div class="relative flex-center">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'image_banner' %}
        {% render 'responsive-image',
          image: block.settings.banner_pc_image,
          mimage: block.settings.banner_mb_image,
          image_class: 'w-full object-cover pc-banner',
          fcp: true
        %}
      <h2 class="
        text-70 leading-70 lg:j-text-70 lg:j-leading-70 text-black lg:text-white
        font-600 absolute lg:j-right-130 top-126 lg:j-top-343
      ">{{ block.settings.banner_heading | escape }}</h2>
    {% endcase %}
  {% endfor %}
</div>

{% assign steps = section.blocks | where: 'type', "step_item" %}
  <section id="shopify-section-page-help-me" class="lg:bg-f5">
  {% comment %} steps {% endcomment %}
  <div class="w-full overflow-x-auto flex items-center justify-start lg:justify-center px-60 py-24 lg:j-py-16 bg-white">
    <ul class="
      flex items-center gap-100 lg:j-gap-160 relative
      after:block after:content-[''] after:absolute after:w-[94%] after:h-4 after:lg:h-[2px]
      after:bg-input after:left-32 after:top-15 after:lg:left-[32px] after:lg:top-[12px] after:z-0
    ">
      {% for block in steps %}
        <li class="group {% if forloop.index0 == 0 %} active {% endif %} flex-center flex-col text-20 leading-30 lg:j-text-18 lg:j-leading-27 text-[#999] relative z-1" {% if forloop.index0 == 0 %}data-step-active{% endif %}>
          <span class="choose-step">{{ block.settings.step_num | escape }}</span>
          <span class="group-[.active]:text-black group-[.finish]:text-black !break-normal">{{ block.settings.step_name | escape }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>

  {% assign title_str = '' %}
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'step_item' %}
      {% assign title_str = title_str | append: ',' | append: block.settings.step_title %}
    {% endcase %}
  {% endfor %}
  {% assign title_str = title_str | remove_first: ',' %}


  {% comment %} title {% endcomment %}
  <div class="w-full bg-white lg:bg-f5">
    <div class="px-60 lg:j-px-0 pt-10 pb-5 lg:j-pt-20 lg:j-pb-16 w-full lg:j-w-1200 mx-auto flex flex-col items-end lg:items-center lg:flex-none text-center relative">
      <h2
        class="text-45 leading-66 lg:j-text-36 lg:j-leading-54 text-black lg:text-main font-600 lg:font-500"
        data-title
        data-title-string="{{title_str}}">{{ title_str | split: ',' | first }}</h2>
      <button class="
        hidden appearance-none bg-transparent w-fit text-primary font-400 lg:font-400 text-24 leading-36 lg:j-text-24 lg:j-leading-36
        relative lg:absolute lg:right-0 lg:top-1/2 lg:-translate-y-1/2
        after:absolute after:block after:content-[''] after:w-full after:j-h-2 after:bg-primary
      " data-clear-all>{{ 'helpToChoose.clear_all' | t }}</button>
    </div>
  </div>

  {% comment %} 选择主场景 {% endcomment %}
  <div id="start">
    {% comment %} tabs {% endcomment %}
    <div class="w-full bg-white flex items-center justify-start">
      <ul
        class="w-full lg:j-w-1200 mx-auto flex items-center justify-start lg:justify-center gap-x-60 lg:j-gap-x-70 flex-nowrap overflow-x-auto px-60 lg:j-px-0"
        data-main-scene
        data-other-text="{{section.settings.others_tab}}"
        data-other-pc-img="{{section.settings.others_pc_img | image_url: width: 1200}}"
        data-other-mb-img="{{section.settings.others_mb_img | image_url: width: 750}}">
        <li class="py-50 lg:j-py-20 flex-center">
          <span class="inline-block w-120 lg:j-w-120 h-42 lg:j-h-35 bg-[#EEE] skeleton"></span>
        </li>
        <li class="py-50 lg:j-py-20 flex-center">
          <span class="inline-block w-120 lg:j-w-120 h-42 lg:j-h-35 bg-[#EEE] skeleton"></span>
        </li>
        <li class="py-50 lg:j-py-20 flex-center">
          <span class="inline-block w-120 lg:j-w-120 h-42 lg:j-h-35 bg-[#EEE] skeleton"></span>
        </li>
        <li class="py-50 lg:j-py-20 flex-center">
          <span class="inline-block w-120 lg:j-w-120 h-42 lg:j-h-35 bg-[#EEE] skeleton"></span>
        </li>
        <li class="py-50 lg:j-py-20 flex-center">
          <span class="inline-block w-120 lg:j-w-120 h-42 lg:j-h-35 bg-[#EEE] skeleton"></span>
        </li>
      </ul>
    </div>

    {% comment %} tab 内容 {% endcomment %}
    <div class="flex-center flex-col lg:j-pt-20 lg:j-pb-40 bg-white lg:bg-f5">
      <div class="flex-center flex-col bg-white">
        <div class="w-[100vw] h-[100vw] lg:j-w-1200 lg:j-h-544 overflow-hidden" data-tab-content>
          <div class="block lg:hidden w-full h-[100vw] bg-[#EEE] skeleton"></div>
          <div class="hidden lg:block w-full lg:j-h-560 bg-[#EEE] skeleton"></div>
        </div>

        <div class="hidden w-full px-60 pt-50 lg:j-px-0 lg:j-pt-35 lg:j-pb-24" data-tab-others>
          <label for="preferred" class="flex flex-col items-start lg:items-center gap-12 lg:j-gap-16 cursor-pointer">
            <span class="flex items-center gap-15 lg:j-gap-16 text-26 leading-39 lg:j-text-24 lg:j-leading-36 font-400 text-black">
              <img
                src='data:img/jpg;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAAeCAMAAAB61OwbAAAAn1BMVEUAAAAAAAAAAAAAAAAAAAAA
                                                          AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
                                                          AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
                                                          AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAC3kz5EAAAANHRSTlMA/PgG8b3eIhHt5M9nNpcW
                                                          6Kumj0UljHp1WDEN1HFOCfXZyLCIYFNJPB7DtZ2Efy0aCLZbTvBMtQAAAYBJREFUKM91U+l6gjAQ
                                                          TGIIcsmlgIhVEFG82877P1tJOaU0P/iyO/vt7swQ8nbiA88+yL+n9ChSQLGm4XnAIApiXQBP/QvP
                                                          thq07UxeCwHmz0f4d53si3m4G8BLA3BXw3E+g35so+cXkJ1HLVUXMJbyZt8oxHpi6XMGKE9CFGjR
                                                          bJrXWkCbEY6823jMzGQoyR3gi9UEbD90QJHyehT0uhzBzxur4FOz8WIPJOaA+IcC0IM1aHfXAO3+
                                                          +g02WwGwWzs2t5usDjDPIqrPAR68avQVEGO/UOudjwmAlAJOOG9nM4MUHNSLm9EZAGF+1lHsUvCi
                                                          0j2UdBoWVnRq/VEAPZz3zY31m4gGkBwHCp+UQe+dKXoNSFsVe0xuJ0c6FZ24gw2zLSkDXvHz5afs
                                                          3EjIFXq0aeJNpGMUXol6oNByu/sLzp26uVbJLTVaVVawkaFVkmHfJe2HA+oOvLFcCudRt22ZpVKt
                                                          XqO0M7e3+CLVqjW6jN9f31iIZtj0UX3H8d/f3Q/4Jil0oiwiMwAAAABJRU5ErkJggg=='
                class="w-32 h-30 lg:j-w-32 lg:j-h-30" />
              {{ 'helpToChoose.Enter_your_preferred_scenarios' | t }}
            </span>
            <input
              class="w-full lg:j-w-600 text-26 leading-39 appearance-none rounded-sm border-2 lg:j-border-2 border-solid border-f5 px-20 py-8 lg:j-px-20 lg:j-py-10 lg:j-text-18 lg:j-leading-27 font-400 focus:border-primary focus:outline-none"
              type="text"
              id="preferred"
              placeholder="{{ 'helpToChoose.enter_placeholder' | t }}"
              data-other-scene-input />
          </label>
        </div>

        <button class="choose-btn-next mt-50 mb-105 lg:j-my-24 font-700 lg:font-600" data-start-next>{{ 'helpToChoose.next' | t }}
          <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
        </button>
      </div>
    </div>
  </div>

  {% comment %} 选择子场景 {% endcomment %}
  <div id="question1" class="hidden">
    <ul class="w-full bg-white flex-center gap-60 lg:j-gap-70">
      <li class="py-50 lg:j-py-20 cursor-pointer group active">
        <span class="choose-tab" data-scenarios></span>
      </li>
    </ul>
    <div class="flex-center flex-col lg:j-pt-20 lg:j-pb-40 bg-white lg:bg-f5">
      <div class="flex-center flex-col w-full lg:j-w-1200 px-60 pt-2 pb-50 lg:j-pl-45 lg:j-pr-18 lg:j-py-40 bg-white">
        <ul class="w-full grid grid-cols-2 lg:grid-cols-5 gap-x-40 gap-y-25 lg:j-gap-x-20 lg:j-gap-y-24 lg:j-h-520 lg:j-pr-19 overflow-x-hidden overflow-y-auto" data-sub-scene></ul>

        <div class="w-full flex-center gap-30 lg:j-gap-24 mt-50 mb-55 lg:j-mt-30 lg:j-mb-0">
          <button class="choose-btn-back font-700 lg:font-600" data-question1-back>
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right rotate-180"></jds-icon>
            {{ 'helpToChoose.back' | t }}
          </button>
          <button class="choose-btn-next disabled:cursor-not-allowed disabled:bg-[rgba(253,80,0,0.2)] disabled:border-[rgba(253,80,0,0.2)] font-700 lg:font-600" data-question1-next>{{ 'helpToChoose.next' | t }}
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
          </button>
        </div>
      </div>
    </div>
  </div>

  {% comment %} 选择电器 {% endcomment %}
  <div id="question2" class="hidden lg:bg-f5">
    <div class="choose-appliances-wrap">
      <ul
        class="w-full lg:j-w-1200 mx-auto grid grid-cols-1 lg:grid-cols-2 lg:j-gap-x-20 gap-y-25 lg:j-gap-y-16 p-60 lg:j-px-20 lg:j-py-0 lg:j-max-h-540 overflow-auto"
        data-electric-list
        data-edit-text="{{ 'helpToChoose.edit' | t }}"></ul>
    </div>

    <div class="w-full bg-white lg:bg-f5 overflow-hidden pt-25 pb-100 px-60 lg:j-pt-20 lg:j-pb-0 lg:j-px-0 sticky left-0 bottom-0 lg:static">
      <div class="w-full lg:j-w-1200 mx-auto grid grid-cols-1 lg:grid-cols-2 lg:j-gap-x-20 pb-50 lg:j-pb-0 lg:j-px-20">
        <p class="
                        text-20 leading-30 text-info
                        lg:j-text-18 lg:j-leading-27 lg:text-main font-400 order-2 lg:order-1
                        text-center lg:text-left scale-[0.8333333333333334] lg:scale-100
                      ">{{ 'helpToChoose.total_energy_tip' | t }}</p>
        <p class="
                        flex items-center flex-col lg:flex-row
                        justify-end order-1 lg:order-2
                        text-26 leading-48
                        lg:j-text-18 lg:j-leading-27 text-main lg:text-sub
                        font-500 lg:font-400
                      ">{{ 'helpToChoose.total_energy_per_day' | t }}
          <span class="text-32 leading-48 font-700 text-main ml-5 lg:j-text-24 lg:j-leading-36">
            <em data-total-energy>0</em>
            {{ 'helpToChoose.per_day_unit' | t }}
          </span>
        </p>
      </div>

      <div class="w-full flex-center gap-30 lg:j-gap-24 lg:j-my-40">
        <button class="choose-btn-back font-700 lg:font-600" data-question2-back>
          <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right rotate-180"></jds-icon>
          {{ 'helpToChoose.back' | t }}
        </button>
        <button class="choose-btn-next disabled:cursor-not-allowed disabled:bg-[rgba(253,80,0,0.2)] disabled:border-[rgba(253,80,0,0.2)] font-700 lg:font-600" data-question2-next>{{ 'helpToChoose.next' | t }}
          <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
        </button>
      </div>
    </div>
  </div>


  {% assign advantageItems = section.blocks | where: 'type', "advantage_item" %}
  {% comment %} 选择优势 {% endcomment %}
  <div id="question3" class="hidden">
    <div class="choose-advantages-wrap flex-center flex-col lg:j-pb-40 bg-white lg:bg-f5">
      <div class="flex-center flex-col w-full lg:j-w-1200 px-60 pt-2 pb-50 lg:j-px-45 lg:j-py-40 bg-white">

        <ul class="w-full grid grid-cols-2 lg:grid-cols-5 gap-x-40 gap-y-25 lg:j-gap-x-20 lg:j-gap-y-24 lg:j-pb-32 lg:border-0 !lg:border-b-[1px] lg:border-input lg:border-solid">
          {% for block in advantageItems %}
            {% assign index = forloop.index %}
            <li>
              <div class="relative cursor-pointer">
                <label for="advantage-{{index}}" class="block cursor-pointer relative">
                  <img
                    class="w-296 h-314 lg:j-w-206 lg:j-h-218 object-cover"
                    src="{{block.settings.advantage_image | image_url: width: 206}}"
                    width="296"
                    height="314" />
                  <img
                    class="absolute left-1/2 -translate-x-1/2 top-18 w-120 h-120 lg:j-top-14 lg:j-w-80 lg:j-h-80"
                    src="{{block.settings.advantage_icon | image_url: width: 80}}"
                    width="120"
                    height="120" />
                </label>
                <input
                  type="checkbox"
                  id="advantage-{{index}}"
                  data-advantage-checkbox
                  data-type="{{block.settings.advantage_type}}"
                  data-check="1"
                  checked
                  class="input-checkbox choose-checkbox" />
              </div>
              <h3 class="choose-checkbox-title mt-15">{{ block.settings.advantage_name | newline_to_br }}</h3>
            </li>
          {% endfor %}
        </ul>

        <div class="flex flex-col lg:flex-row gap-20 lg:j-gap-20 items-center text-28 leading-48 lg:j-text-18 lg:j-leading-27 font-600 lg:font-400 mt-60 lg:j-mt-9">
          <span class="text-black">{{ 'helpToChoose.recommand_pps_tip' | t }}</span>
          <button
            class="appearance-none bg-transparent text-primary font-700 text-28 leading-48 lg:j-text-18 lg:j-leading-27 lg:font-400 lg:j-p-1 relative after:block after:content-[''] after:w-full after:h-0.5 after:bg-primary after:absolute after:left-0 after:bottom-0"
            data-open-models
            data-open-models-text="{{ 'helpToChoose.two_models_available' | t }}"
          >{{ 'helpToChoose.two_models_available' | t }}</button>
        </div>

        <div class="w-full flex-center gap-30 lg:j-gap-24 mt-50 mb-55 lg:j-mt-30 lg:j-mb-0">
          <button class="choose-btn-back font-700 lg:font-600" data-question3-back>
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right rotate-180"></jds-icon>
            {{ 'helpToChoose.back' | t }}
          </button>
          <button class="choose-btn-next disabled:cursor-not-allowed disabled:bg-[rgba(253,80,0,0.2)] disabled:border-[rgba(253,80,0,0.2)] font-700 lg:font-600" data-question3-next>{{ 'helpToChoose.next' | t }}
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
          </button>
        </div>

      </div>
    </div>
  </div>

  {% comment %} 选择 储能 + 面板 {% endcomment %}
  <div id="question4" class="hidden">
    <div class="choose-product-combo-wrap flex-center flex-col lg:j-pb-40 bg-white lg:bg-f5">
      <div class="flex-center flex-col w-full lg:j-w-1200 px-60 pt-2 pb-50 lg:j-px-45 lg:j-py-40 bg-white">
        <ul class="w-full grid grid-cols-2 gap-15 lg:j-gap-20">
          <li
            class="group"
            data-portable="1"
            data-recommended-name="{{ 'helpToChoose.recommended' | t }}"></li>
          <li
            class="group"
            data-portable="2"
            data-deluxe-name="{{ 'helpToChoose.deluxe' | t }}"></li>
        </ul>

        <div class="w-full bg-white lg:bg-f5 lg:j-rounded-30 lg:j-mt-7 lg:j-py-30">
          <h2 class="text-center text-primary font-400 text-26 leading-39 mt-36 mb-27 lg:j-text-24 lg:j-leading-36 lg:font-500 lg:j-mt-0 lg:j-mb-20">{{ 'helpToChoose.choose_one_type' | t }}</h2>
          <ul class="grid grid-cols-1 lg:grid-cols-3 gap-32 lg:j-gap-20 lg:j-px-20" data-solar-panels-choose></ul>

          <div class="flex items-center lg:j-gap-60 mt-40 lg:j-mt-20 pl-30 lg:j-pl-56">
            <div class="flex-1 lg:flex-none inline-flex flex-row flex-wrap items-center">
              <img
                class="w-66 h-66 lg:j-w-66 lg:j-h-66 lg:j-mr-2 order-1"
                src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/recharging_time.png?v=1678786253"
                width="66"
                height="66"
                alt="" />
              <span class="text-24 lg:j-text-24 lg:j-leading-36 font-500 order-3 lg:order-2">{{ 'helpToChoose.recharging_time' | t }}</span>
              <span class="text-24 lg:j-text-24 lg:j-leading-36 font-500 order-2 lg:order-3 flex-center">
                <em class="inline-flex mx-5 lg:j-ml-4 lg:j-mr-2 text-45 leading-66 lg:j-text-45 lg:j-leading-66 text-primary font-700 not-italic" data-charging-duration>0</em>
                {{ 'helpToChoose.hours_unit' | t }}
              </span>
            </div>
            <div class="flex-1 lg:flex-none flex-center flex-row flex-wrap items-center">
              <img
                class="w-66 h-66 lg:j-w-66 lg:j-h-66 lg:j-mr-2 order-1"
                src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/save_electricity.png?v=1678786252"
                width="66"
                height="66"
                alt="" />
              <span class="text-24 lg:j-text-24 font-500 order-3 lg:order-2">{{ 'helpToChoose.electricit_saving' | t }}</span>
              <span class="text-24 lg:j-text-24 font-500 order-2 lg:order-3 flex-center">
                <em class="inline-flex mx-5 lg:j-ml-4 lg:j-mr-2 text-45 leading-66 lg:j-text-45 lg:j-leading-66 text-primary font-700 not-italic" data-electric-saving>0</em>
                {{ 'helpToChoose.wattage_hour_unit' | t }}
              </span>
            </div>
          </div>
        </div>

        <div class="w-full bg-white overflow-hidden py-80 lg:j-py-0">
          <div class="w-full lg:j-w-1200 mx-auto lg:j-mt-34" data-checkout-price></div>

          <div class="w-full flex-center gap-30 lg:j-gap-24 mt-50 lg:j-mt-30">
            <button class="choose-btn-back w-300 lg:j-w-206 px-0 font-700 lg:font-600" data-question4-back>
              <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right rotate-180"></jds-icon>
              {{ 'helpToChoose.back' | t }}
            </button>
            <button class="choose-btn-next w-300 lg:j-w-206 px-0 font-700 lg:font-600" data-question4-next>{{ 'helpToChoose.next' | t }}
              <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  {% comment %} 结果 {% endcomment %}
  <div id="end" class="hidden">
    <div class="flex flex-col items-center px-30 gap-50 lg:j-gap-35 lg:bg-f5">
      <ul
        class="w-full lg:j-w-1200 flex flex-col lg:flex-row gap-32 lg:j-gap-20"
        data-goods-result
        data-recommended-name="{{ 'helpToChoose.recommended' | t }}"
        data-deluxe-name="{{ 'helpToChoose.deluxe' | t }}"
        data-learn-more="{{ 'general.action_text.learn_more' | t }}"
        data-booking="{{ 'helpToChoose.booking' | t }}">
        <li class="w-full h-650 lg:j-w-590 lg:j-h-575 bg-[#EEE] skeleton"></li>
        <li class="w-full h-650 lg:j-w-590 lg:j-h-575 bg-[#EEE] skeleton"></li>
      </ul>

      <div class="w-full lg:j-w-1200 flex-center flex-col lg:flex-row lg:justify-between lg:bg-white lg:j-mb-40 lg:j-px-45 lg:j-py-9">
        <div class="flex gap-65 lg:j-gap-65 text-26 leading-48 lg:j-text-24 lg:j-leading-36">
          <a
            href="{{section.settings.pps_url}}"
            class="text-black underline underline-offset-1 decoration-1 lg:underline-offset-8 lg:decoration-2 hover:text-primary"
            data-pps-link>{{ section.settings.pps_text | escape }}
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-24 lg:j-text-18 lg:j-leading-27"></jds-icon>
          </a>
          <a
            href="{{section.settings.sp_url}}"
            class="text-black underline underline-offset-1 decoration-1 lg:underline-offset-8 lg:decoration-2 hover:text-primary"
            data-sp-link>{{ section.settings.sp_text | escape }}
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-24 lg:j-text-18 lg:j-leading-27"></jds-icon>
          </a>
        </div>
        <div class="flex items-center gap-30 lg:j-gap-24">
          <button class="choose-btn-back w-300 lg:j-w-206 px-0 font-700 lg:font-600 mt-50 mb-105 lg:j-my-0" data-question5-back>
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right rotate-180"></jds-icon>
            {{ 'helpToChoose.back' | t }}
          </button>
          <button class="choose-btn-next w-300 lg:j-w-206 px-0 font-700 lg:font-600 mt-50 mb-105 lg:j-my-0" data-end-try-again>{{ 'helpToChoose.try_again' | t }}
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>


{% comment %} fixed edit popup {% endcomment %}
<div
  id="fixed-edit-popup"
  class="hidden w-[100vw] h-[100vw] fixed left-0 top-0 bottom-0 right-0 z-9999"
  data-wattage-unit="{{ 'helpToChoose.wattage_unit' | t }}"
  data-hour-unit="{{ 'helpToChoose.hour_unit' | t }}"
  data-day-unit="{{ 'helpToChoose.day_unit' | t }}">
  <div data-mask class="absolute left-0 top-0 right-0 bottom-0 bg-black/50 cursor-pointer"></div>
  <div data-popup class="w-full lg:j-w-900 h-fit px-60 lg:j-px-40 lg:j-pt-28 lg:j-pb-40 fixed left-0 bottom-0 lg:left-1/2 lg:top-1/2 lg:-translate-1/2 bg-white">
    <h3 class="flex items-center lg:justify-between pt-150 lg:j-pt-0 relative">
      <span class="flex items-center gap-32 lg:j-gap-16" data-edit-popup-title></span>
      <button class="choose-btn-close" data-close></button>
    </h3>
    <div class="w-full h-[1px] bg-input mt-40 mb-48 lg:j-mt-8 lg:j-mb-20"></div>
    <div class="flex flex-col gap-25 lg:j-gap-16">
      <h4 class="text-32 leading-48 text-main font-500 lg:j-text-24 lg:j-leading-36">{{ 'helpToChoose.power_rating' | t }}</h4>
      <div>
        <input
          class="input-number w-228 h-84 lg:j-w-93 lg:j-h-60"
          type="number"
          value="0"
          data-power-input />
        <span class="ml-18 text-32 leading-48 text-main font-500 lg:j-ml-3 lg:j-text-24 lg:j-leading-36">{{ 'helpToChoose.wattage_unit' | t }}</span>
      </div>
      <p class="text-24 leading-36 font-300 lg:j-text-14 lg:j-leading-21 -lg:j-mt-2">
        <span class="text-info lg:text-sub" data-power-input-info>{{ 'helpToChoose.power_input_tip' | t }}</span>
        <span class="text-primary hidden" data-power-input-error-tip>{{ 'helpToChoose.power_input_tip_error' | t }}</span>
      </p>
    </div>
    <div class="w-full h-[1px] bg-input my-48 lg:j-my-20"></div>
    <div class="flex flex-col gap-25 lg:j-gap-16">
      <h4 class="text-32 leading-48 text-main font-500 lg:j-text-24 lg:j-leading-36">{{ 'helpToChoose.Estimated_daily_running_time' | t }}</h4>
      <div class="flex items-center gap-25 lg:j-gap-12">
        <input
          class="input-number w-132 h-84 lg:j-w-93 lg:j-h-60"
          type="number"
          value="0"
          data-hours-input
          oninput="value=value.replace(/\D|^[0]+/g,'');if(value<0)value=0;if(value>24)value=24;" />
        <span class="text-32 leading-48 text-main font-500 lg:j-text-24 lg:j-leading-36">{{ 'helpToChoose.hours' | t }}</span>
        <input
          class="input-number w-132 h-84 lg:j-w-93 lg:j-h-60"
          type="number"
          value="0"
          data-mins-input
          oninput="value=value.replace(/\D|^[0]+/g,'');if(value<0)value=0;if(value>60)value=60;" />
        <span class="text-32 leading-48 text-main font-500 lg:j-text-24 lg:j-leading-36">{{ 'helpToChoose.mins' | t }}</span>
      </div>
      <p class="text-24 leading-36 text-info font-300 lg:j-text-14 lg:j-leading-21 lg:text-sub -lg:j-mt-2">{{ 'helpToChoose.running_time_input_tip' | t }}</p>
    </div>

    <div class="flex-center mt-45 mb-45 lg:j-mb-0">
      <button class="choose-btn-next w-300 lg:j-w-206 disabled:cursor-not-allowed disabled:bg-[rgba(253,80,0,0.2)] disabled:border-[rgba(253,80,0,0.2)] font-700 lg:font-600" data-confirm-edit>{{ 'helpToChoose.confirm' | t }}</button>
    </div>
  </div>
</div>

{% comment %} fixed two models popup {% endcomment %}
<div
  id="fixed-two-models-popup"
  class="hidden w-full h-full fixed left-0 top-0 bottom-0 right-0 z-9999"
  data-recommended-name="{{ 'helpToChoose.recommended' | t }}"
  data-deluxe-name="{{ 'helpToChoose.deluxe' | t }}"
  data-daily-usage="{{ 'helpToChoose.daily_usage' | t }}"
  data-day-unit="{{ 'helpToChoose.day_unit' | t }}"
  data-learn-more="{{ 'general.action_text.learn_more' | t }}"
  data-booking="{{ 'helpToChoose.booking' | t }}">
  <div data-mask class="absolute left-0 top-0 right-0 bottom-0 bg-black/50 cursor-pointer"></div>
  <div data-popup class="w-full lg:j-w-1200 h-fit max-h-full overflow-y-auto px-60 pt-108 pb-55 lg:j-px-92 lg:j-py-55 fixed left-0 bottom-0 lg:left-1/2 lg:top-1/2 lg:-translate-1/2 bg-white">
    <button class="choose-btn-close right-60 lg:j-top-40 lg:j-right-50" data-close></button>
    <ul class="w-full flex flex-col lg:flex-row lg:j-gap-160" data-popup-result></ul>
    <div class="w-full flex-center flex-col mt-65 lg:j-mt-36">
      <p class="w-[120%] lg:w-full text-20 leading-30 lg:j-text-24 lg:j-leading-36 font-500 lg:text-main mb-25 lg:j-mb-8 scale-[0.8333333333333334] lg:scale-100 text-center">{{ 'helpToChoose.estimated_daily_energy' | t }}
        <span data-popup-total-energy></span>
        {{ 'helpToChoose.per_day_unit' | t }}
      </p>
      <p class="w-[120%] lg:w-full text-20 leading-30 lg:j-text-18 lg:j-leading-27 font-300 text-info lg:text-sub scale-[0.8333333333333334] lg:scale-100 text-center">{{ 'helpToChoose.calculated_run_time' | t }}</p>
    </div>
  </div>
</div>


{% comment %} compare {% endcomment %}
<div class="relative" data-smart-shop-compare-wrap>
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'product_compare' %}
      <img
        class="hidden lg:block w-full"
        src="{{block.settings.compare_pc_image | image_url: width: 1920}}"
        alt="jackery"
        width="{{ block.settings.compare_pc_image.width }}"
        height="{{ block.settings.compare_pc_image.height }}">
      <img
        class="block lg:hidden w-full"
        src="{{block.settings.compare_m_image | image_url: width: 1024}}"
        alt="jackery"
        width="{{ block.settings.compare_m_image.width }}"
        height="{{ block.settings.compare_m_image.height }}">
      <div class="w-full flex flex-col items-center px-135 lg:j-px-0 absolute top-78 lg:j-top-230 left-0">
        <div class="w-full flex flex-col items-center">
          <h2 class="text-white text-45 leading-66 font-500 text-center lg:j-mb-60 lg:j-text-45 lg:j-leading-66">{{ block.settings.compare_title | newline_to_br }}</h2>

          {% comment %} 按钮无需处理 {% endcomment %}
          <a
            href="{{block.settings.compare_btn_link}}"
            data-smart-shop-compare-link
            class="choose-btn-next px-24 lg:j-px-24 font-700">
            {{ block.settings.compare_btn_text | escape }}
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
          </a>
        </div>
      </div>
    {% endcase %}
  {% endfor %}
</div>

<script defer>
  const howToChoose = {
    addToCart: "{{'helpToChoose.add_to_cart' | t}}",
    buyNow: '{{section.settings.buy_now}}',
    comingSoon: '{{helpToChoose.new_product_coming_soon | t}}',
    customAppliance: '{{section.settings.custom_appliance}}',
    warrantyKey: "{{'products.product.properties_warranty_key' | t}}",
    warrantyContent: "{{'products.product.properties_warranty' | t}}"
  }
</script>

{% schema %}
