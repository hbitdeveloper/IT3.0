{%- style -%}
  .section-keyword-adv-scroll {
    margin-bottom: 7.0313vw;
  }
  .adv-scroll-swiper {
    padding: 0.9375vw 0;
  }

  .adv-scroll-swiper .adv-scroll-item {
    position: relative;
    width: auto;
  }

  .adv-scroll-swiper .adv-scroll-item img {
    max-width: 29.6875vw;
    max-height: 17.6563vw;
  }

  .adv-scroll-swiper .adv-scroll-item span {
    position: absolute;
    right: 1.5625vw;
    top: 15.625vw;
    font-size: 1.25vw;
    font-weight: 500;
    color: #ffffff;
  }

  @media screen and (max-width: 768px) {
    .adv-scroll-swiper .adv-scroll-item img {
      max-width: 74.9333vw;
      max-height: 45.2vw;
    }
    .adv-scroll-swiper .adv-scroll-item span {
      top: 37.0667vw;
      right: 2.9333vw;
      font-size: 3.4667vw;
    }

    .section-keyword-adv-scroll {
      padding-bottom: 10vw;
    }

    .section-keyword-adv-scroll .pt-80{
      padding-top: 0;
    }
  }
{%- endstyle -%}

<div class="pt-80 lg:pt-[120px]" anchor="{{ section.settings.anchor | escape }}">
  {% for block in section.blocks %}
    <div
      class="swiper adv-scroll-swiper kas-swiper-{{ forloop.index }} swiper-no-swiping"
      data-target="kas-swiper-{{ forloop.index }}"
      data-is_reverse="{{ block.settings.is_reverse }}"
    >
      <div class="swiper-wrapper swiper-explore-wrapper">
        <div class="swiper-slide adv-scroll-item">
          {% if block.settings.banner_1_link != blank %}
            <a href="{{ block.settings.banner_1_link }}">
              <img
                src="{{ block.settings.banner_1_image | image_url: width: 1140 }}"
                alt="{{ block.settings.banner_1_image.alt }}" loading="lazy"
              >
              <span>{{ block.settings.banner_1_title | escape }}</span>
            </a>
          {% else %}
            <div>
              <img
                src="{{ block.settings.banner_1_image | image_url: width: 1140 }}"
                alt="{{ block.settings.banner_1_image.alt }}" loading="lazy"
              >
              <span>{{ block.settings.banner_1_title | escape }}</span>
            </div>
          {% endif %}
        </div>

        <div class="swiper-slide adv-scroll-item">
          {% if block.settings.banner_2_link != blank %}
            <a href="{{ block.settings.banner_2_link }}">
              <img
                src="{{ block.settings.banner_2_image | image_url: width: 1140 }}"
                alt="{{ block.settings.banner_2_image.alt }}" loading="lazy"
              >
              <span>{{ block.settings.banner_2_title | escape }}</span>
            </a>
          {% else %}
            <div>
              <img
                src="{{ block.settings.banner_2_image | image_url: width: 1140 }}"
                alt="{{ block.settings.banner_2_image.alt }}" loading="lazy"
              >
              <span>{{ block.settings.banner_2_title | escape }}</span>
            </div>
          {% endif %}
        </div>

        <div class="swiper-slide adv-scroll-item">
          {% if block.settings.banner_3_link != blank %}
            <a href="{{ block.settings.banner_3_link }}">
              <img
                src="{{ block.settings.banner_3_image | image_url: width: 1140 }}"
                alt="{{ block.settings.banner_3_image.alt }}" loading="lazy"
              >
              <span>{{ block.settings.banner_3_title | escape }}</span>
            </a>
          {% else %}
            <div>
              <img
                src="{{ block.settings.banner_3_image | image_url: width: 1140 }}"
                alt="{{ block.settings.banner_3_image.alt }}" loading="lazy"
              >
              <span>{{ block.settings.banner_3_title | escape }}</span>
            </div>
          {% endif %}
        </div>

        <div class="swiper-slide adv-scroll-item">
          {% if block.settings.banner_4_link != blank %}
            <a href="{{ block.settings.banner_4_link }}">
              <img
                src="{{ block.settings.banner_4_image | image_url: width: 1140 }}"
                alt="{{ block.settings.banner_4_image.alt }}" loading="lazy"
              >
              <span>{{ block.settings.banner_4_title | escape }}</span>
            </a>
          {% else %}
            <div>
              <img
                src="{{ block.settings.banner_4_image | image_url: width: 1140 }}"
                alt="{{ block.settings.banner_4_image.alt }}" loading="lazy"
              >
              <span>{{ block.settings.banner_4_title | escape }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<script type="module">
  function keywordAdvScrollInit() {
    const swipers = document.querySelectorAll('.section-keyword-adv-scroll .adv-scroll-swiper');
    swipers.forEach(function (ele) {
      let target = ele.dataset.target;
      let is_reverse = ele.dataset.is_reverse === 'true';

      new Swiper('.' + target, {
        slidesPerView: 'auto',
        spaceBetween: 12,
        speed: 30000, // 滚动速度
        // freeMode: true,
        touchStartPreventDefault: true,
        centeredSlides: true,
        loop: true,
        loopAdditionalSlides: 4,
        autoplay: {
          delay: 1,
          disableOnInteraction: false, // 就算触摸了也继续滚动
          loopPreventsSlide: true,
          reverseDirection: is_reverse, // 反向
        },
        breakpoints: {
          320: {
            //当屏幕宽度大于等于320
            speed: 10000, // 滚动速度
          },
          768: {
            //当屏幕宽度大于等于768
            speed: 30000, // 滚动速度
          },
        },
        on: {
          click: function (swiper, e) {
            if (e.target.parentElement?.href) {
              window.location.href = e.target.parentElement.href;
            }
            return false;
          },
          touchMove: function (swiper, e) {
          },
        },
      });
    });
  }

  window.addEventListener('DOMContentLoaded', function () {
    setTimeout(() => {
      keywordAdvScrollInit();
    }, 3000);
  });
</script>

{% schema %}
{
  "name": "Keyword Adv Scroll",
  "class": "section-keyword-adv-scroll",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" }
  ],
  "blocks": [
    {
      "type": "adv_scroll_item",
      "name": "Adv Scroll Item",
      "settings": [
        { "type": "checkbox", "id": "is_reverse", "label": "Whether To Scroll Forward", "default": true },

        { "type": "text", "id": "banner_1_title", "label": "Banner 1 Title" },
        { "type": "image_picker", "id": "banner_1_image", "label": "Banner 1 Image" },
        { "type": "url", "id": "banner_1_link", "label": "Banner 1 Link" },

        { "type": "text", "id": "banner_2_title", "label": "Banner 2 Title" },
        { "type": "image_picker", "id": "banner_2_image", "label": "Banner 2 Image" },
        { "type": "url", "id": "banner_2_link", "label": "Banner 2 Link" },

        { "type": "text", "id": "banner_3_title", "label": "Banner 3 Title" },
        { "type": "image_picker", "id": "banner_3_image", "label": "Banner 3 Image" },
        { "type": "url", "id": "banner_3_link", "label": "Banner 3 Link" },

        { "type": "text", "id": "banner_4_title", "label": "Banner 4 Title" },
        { "type": "image_picker", "id": "banner_4_image", "label": "Banner 4 Image" },
        { "type": "url", "id": "banner_4_link", "label": "Banner 4 Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keyword Adv Scroll",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
