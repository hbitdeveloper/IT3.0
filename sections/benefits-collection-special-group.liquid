<div class="benefits-collection-special-group" style="background-color: {{ section.settings.bg_color }}"
     anchor-target="{{ section.settings.anchor | escape }}">
    {% content_for 'blocks' %}
</div>

{% javascript %}
;
$(function () {
    "use strict";

    $(".benefits-collection-special-group jds-button").on("click", function () {
        const $this = $(this);
        const $titleComp = $this.closest('.benefits-collection-special-group').parent().prev();
        let module = "SpecialGroupBenefits";
        if ($titleComp.attr("id") && $titleComp.attr("id").indexOf("benefits_collection_common_title") !== -1) {
            module = $titleComp.find('.title').text().trim() || module;
        }
        let position = "";
        try {
            position = $this.parent().parent().prev().find(".blocks-content-heading").find("div:first-child").text().trim();
        } catch (e) {}
        const buttonName = $this.text().trim();
        let link = $this.attr("href");
        if (link) {
            link = location.origin + link;
        } else {
            link = "";
        }

        window.dataLayer.push({event_parameters: null});
        window.dataLayer.push({
            event: "ga4Event",
            event_name: "promo_collection_user_clicks",
            event_parameters: {
                current_page: window.location.href,
                module: module,
                position: position,
                button_name: buttonName,
                link: link
            }
        });
    });
});
{% endjavascript %}

