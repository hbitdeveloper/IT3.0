{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div class="section-container section-padding text-[#242F20]" style="{{ style }}">
  <div class="repair-request__intro" style="text-align: {{ section.settings.page_title_alignment }}">
    <h1 class="mb-2.5 text-xl font-semibold leading-[1.1] lg:mb-4 lg:text-[2rem]" style="color: {{ section.settings.page_title_color }}">{{ section.settings.title }}</h1>
    <div class="text-base font-normal leading-[1.4] lg:text-base" style="color: {{ section.settings.page_description_color }}">{{ section.settings.description }}</div>
  </div>

  <ol class="repair-request__steps -mx-4 mb-12 mt-6 flex list-none gap-4 overflow-x-auto px-4 pb-1 lg:mx-0 lg:mb-24 lg:mt-12 lg:grid lg:grid-cols-4 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0 [scrollbar-width:none]" aria-label="Repair request progress">
    {% assign step_index = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'step' %}
        {% assign step_index = step_index | plus: 1 %}
        <li class="min-h-32 w-[17.625rem] shrink-0 bg-[#F5F5F3] px-4 py-3 lg:w-auto lg:px-4 lg:py-3 {% unless step_index == 1 %} opacity-60{% endunless %}" data-repair-step="{{ step_index }}" {{ block.shopify_attributes }}
            style="background-color: {{ section.settings.step_block_background_color }}">
          <span class="mb-2 inline-block px-1.5 py-1 text-xs font-semibold leading-none text-white {% if step_index == 1 %} bg-[#242F20]{% else %} bg-[#94948F]{% endif %}" data-repair-step-badge>{{ 'self_mail_repair.create_form.step' | t }} {{ step_index }}</span>
          <strong class="mb-1 block text-sm font-semibold leading-[1.2] lg:mb-1.5 lg:text-xl" style="color: {{ section.settings.step_block_title_color }}">{{ block.settings.title }}</strong>
          <p class="text-xs font-normal leading-[1.3] text-black/65 lg:text-sm" style="color: {{ section.settings.step_block_description_color }}">{{ block.settings.description }}</p>
        </li>
      {% endif %}
    {% endfor %}
  </ol>

  <div data-repair-request-lookup>
    <h2 class="mb-6 text-center text-xl font-semibold leading-[1.1] lg:mb-12 lg:text-[2rem]">{{ section.settings.choose_channel_title }}</h2>

    <div class="grid grid-cols-1 gap-3 lg:grid-cols-2 lg:gap-6">
      <label class="cursor-pointer">
        <input class="peer sr-only" type="radio" name="repair-purchase-channel" value="online" checked>
        <span class="flex flex-col items-center justify-center border lg:border-2 border-transparent bg-[#F5F5F3] py-6 px-5 peer-checked:border-solid peer-checked:border-primary peer-checked:bg-white lg:h-[16.875rem] lg:p-6">
              <span class="h-[3.125rem] w-[3.125rem] mb-4">
                {%- render 'diff-end-img',
                        pc_img: section.settings.online_pc_img,
                        mb_img: section.settings.online_mb_img,
                        class: 'w-full h-full object-cover'
                -%}
              </span>
              <strong class="mb-3 text-base font-semibold leading-[1.2] lg:mb-2.5 lg:text-2xl">{{ section.settings.online_title }}</strong>
              <span class="text-center text-sm font-medium leading-[1.3] text-black/65 lg:text-base">{{ section.settings.online_description }}</span>
            </span>
      </label>
      <label class="cursor-pointer">
        <input class="peer sr-only" type="radio" name="repair-purchase-channel" value="dealer">
        <span class="flex flex-col items-center justify-center border lg:border-2 border-transparent bg-[#F5F5F3] py-6 px-5 peer-checked:border-solid peer-checked:border-primary peer-checked:bg-white lg:h-[16.875rem] lg:p-6">
              <span class="h-[3.125rem] w-[3.125rem] mb-4">
                {%- render 'diff-end-img',
                        pc_img: section.settings.dealer_pc_img,
                        mb_img: section.settings.dealer_mb_img,
                        class: 'w-full h-full object-cover'
                -%}
              </span>
              <strong class="mb-3 text-base font-semibold leading-[1.2] lg:mb-2.5 lg:text-2xl">{{ section.settings.dealer_title }}</strong>
              <span class="text-center text-sm font-medium leading-[1.3] text-black/65 lg:text-base">{{ section.settings.dealer_description }}</span>
            </span>
      </label>
    </div>

    <form class="mt-6 lg:mt-12" data-repair-request-lookup-form novalidate>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-6">
        <label class="repair-lookup-field flex min-w-0 flex-col" data-repair-lookup-field="email">
          <span class="mb-2 text-base lg:text-xl font-medium leading-[1.25] lg:mb-2.5">{{ 'self_mail_repair.step_one.email' | t }}<span class="text-primary">*</span></span>
          <input class="h-11 w-full border border-solid border-[#C6C7C8] px-2.5 text-base lg:text-xl font-normal outline-none placeholder:text-[#C6C7C8] focus:border-[#242F20] lg:h-12 lg:px-4" type="email" name="email" maxlength="50" autocomplete="email">
          <p class="mt-2 hidden text-sm font-normal leading-[1.3] text-[#D92D20]" data-repair-lookup-error aria-live="polite"></p>
        </label>
        <div class="repair-lookup-field flex min-w-0 flex-col" data-repair-channel-fields="online" data-repair-lookup-field="orderNumber">
          <div class="mb-2 flex items-center text-base font-medium leading-[1.25] lg:mb-2.5 lg:text-xl">
            <label for="RepairOrderNumber-{{ section.id }}">{{ 'self_mail_repair.step_one.order_No' | t }}<span class="text-primary">*</span></label>
            <span class="repair-order-tooltip">
              <button type="button" class="repair-order-tooltip__trigger" aria-label="{{ 'self_mail_repair.step_one.order_No_tip' | t | escape }}" aria-describedby="RepairOrderNumberTip-{{ section.id }}">
                {% render 'jky-icon-circle-question-fill', class: 'block w-4 h-4 lg:w-5 lg:h-5', bg_color: '#242f20' %}
              </button>
              <span id="RepairOrderNumberTip-{{ section.id }}" class="repair-order-tooltip__content" role="tooltip">{{ 'self_mail_repair.step_one.order_No_tip' | t }}</span>
            </span>
          </div>
          <input id="RepairOrderNumber-{{ section.id }}" class="h-11 w-full border border-solid border-[#C6C7C8] px-2.5 text-base lg:text-xl font-normal outline-none placeholder:text-[#C6C7C8] focus:border-[#242F20] lg:h-12 lg:px-4" type="text" name="orderNumber" maxlength="50" placeholder="e.g. ORD-2026-001234" autocomplete="one-time-code">
          <p class="mt-2 hidden text-sm font-normal leading-[1.3] text-[#D92D20]" data-repair-lookup-error aria-live="polite"></p>
        </div>
        <div class="repair-lookup-field hidden lg:col-span-2" data-repair-channel-fields="dealer" data-repair-lookup-field="dealerFiles">
          <p class="mb-1 font-medium leading-[1.25] text-base lg:text-xl lg:mb-2">{{ 'self_mail_repair.product_issue.attach_media' | t }}<span class="text-primary">*</span></p>
          <p class="mb-3 text-xs font-normal leading-[1.35] text-black/65 lg:text-base lg:mb-4">{{ 'self_mail_repair.product_issue.attach_media_tip' | t }}</p>
          <div class="flex flex-wrap gap-3" data-repair-dealer-preview-list>
            <label class="flex h-20 w-20 shrink-0 cursor-pointer items-center justify-center border border-solid border-[#C6C7C8] bg-white">
              <input class="sr-only" type="file" name="dealerFiles" accept="image/jpeg,image/png,image/heic,video/*" multiple data-repair-dealer-files>
              <span class="text-5xl font-extralight leading-none text-black/65">+</span>
            </label>
          </div>
          <p class="mt-2 hidden text-sm font-normal leading-[1.3] text-[#D92D20]" data-repair-lookup-error aria-live="polite"></p>
        </div>
      </div>
      <button type="button" class="disabled:cursor-initial disabled:opacity-60 mx-auto mt-6 block h-10 w-full border-0 bg-primary px-12 font-semibold text-white lg:mt-12 lg:h-12 lg:w-64 text-base" data-repair-lookup-submit disabled aria-label="{{ 'accessibility.loading' | t | escape }}">
        <span data-repair-submit-label>{{ 'self_mail_repair.step_one.check_order' | t }}</span>
      </button>
    </form>
  </div>

  <div id="v5-support-repair-request-app" class="hidden"></div>

</div>

