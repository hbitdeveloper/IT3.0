{% schema %}
{
  "name": "V5-Support Repair Request",
  "tag": "section",
  "class": "v5-support-repair-request",
  "limit": 1,
  "settings": [
    { "type": "header", "content": "PC Padding" },
    { "type": "number", "id": "padding_top", "label": "Top Padding", "default": 64 },
    { "type": "number", "id": "padding_bottom", "label": "Bottom Padding", "default": 64 },
    { "type": "header", "content": "MB Padding" },
    { "type": "text", "id": "mb_padding_type", "default": "custom", "label": "MB Padding", "visible_if": "{{ false }}" },
    { "type": "number", "id": "padding_top_mb", "label": "Top Padding", "default": 32 },
    { "type": "number", "id": "padding_bottom_mb", "label": "Bottom Padding", "default": 32 },
    { "type": "header", "content": "Style Settings" },
    {
       "type": "text_alignment",
       "id": "page_title_alignment",
       "label": "Page Title & Description alignment",
       "default": "center"
    },
    {
      "type": "color",
      "id": "page_title_color",
      "label": "Page Title Color",
      "default": "#242F20"
    },
    {
      "type": "color",
      "id": "page_description_color",
      "label": "Page Description Color",
      "default": "#595959"
    },
    {
      "type": "color",
      "id": "step_block_background_color",
      "label": "Step Block Background Color",
      "default": "#F5F5F3"
    },
    {
      "type": "color",
      "id": "step_block_title_color",
      "label": "Step Block Title Color",
      "default": "#242F20"
    },
    {
      "type": "color",
      "id": "step_block_description_color",
      "label": "Step Block Description Color",
      "default": "#565656"
    },
    { "type": "header", "content": "Text Settings" },
    {
      "type": "richtext",
      "id": "title",
      "label": "Page Title",
      "default": "<p>Self-Service Repair Request</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Page Description",
      "default": "<p>Submit your repair request online, and we’ll guide you through the repair process.</p>"
    },
    {
      "type": "text",
      "id": "choose_channel_title",
      "label": "Choose Channel Title",
      "default": "Choose a purchase channel?"
    },
    {
      "type": "image_picker",
      "id": "online_pc_img",
      "label": "Online Channel PC Image"
    },
    {
      "type": "image_picker",
      "id": "online_mb_img",
      "label": "Online Channel Mobile Image"
    },
    {
      "type": "text",
      "id": "online_title",
      "label": "Online Channel Title",
      "default": "Online Purchase"
    },
    {
      "type": "textarea",
      "id": "online_description",
      "label": "Online Channel Description",
      "default": "Jackery.com, Amazon, or other online retailers"
    },
    {
      "type": "image_picker",
      "id": "dealer_pc_img",
      "label": "Dealer Channel PC Image"
    },
    {
      "type": "image_picker",
      "id": "dealer_mb_img",
      "label": "Dealer Channel Mobile Image"
    },
    {
      "type": "text",
      "id": "dealer_title",
      "label": "Dealer Channel Title",
      "default": "Authorized Dealer"
    },
    {
      "type": "textarea",
      "id": "dealer_description",
      "label": "Dealer Channel Description",
      "default": "In-store or through an authorized reseller"
    },
    {
      "type": "richtext",
      "id": "agreement",
      "label": "Term And Agreement",
      "default": "<p>I have read and agree to the <a href=\"https://www.jackery.com/policies/terms-of-service\" title=\"Warranty\">Warranty </a>Terms and Repair Service Agreement. I confirm all submitted information is accurate.</p>"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Creation Successful Title",
      "default": "Your Repair Request Has Been Submitted"
    },
    {
      "type": "richtext",
      "id": "success_description",
      "label": "Creation Successful Description",
      "default": "<p>Thank you for submitting your repair request. Our support team will review your request and contact you if additional information is needed. Once your request has been reviewed, you'll receive an email with the next steps.</p>"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5-Support Repair Request",
      "category": "V5.0 Support",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Submit Request",
            "description": "Provide your product details and describe the issue."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Request Review",
            "description": "Our support team reviews your warranty status and repair request."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Ship Your Product",
            "description": "Send your product to the designated repair center after receiving confirmation."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Repair & Return",
            "description": "Once repaired, we'll ship the product back to you."
          }
        }
      ]
    }
  ]
}
{% endschema %}
