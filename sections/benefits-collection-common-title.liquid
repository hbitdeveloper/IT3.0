<div style="background-color: {{ section.settings.bg_color }}" anchor-target="{{ section.settings.anchor | escape }}">
    <div class="section-container-lg common-title pt-[var(--padding-top-mb)] pb-[var(--padding-bottom-mb)] lg:pt-[var(--padding-top)] lg:pb-[var(--padding-bottom)] "
         style="--padding-top: {{ section.settings.padding_top | divided_by: 16.0 }}rem; --padding-bottom: {{ section.settings.padding_bottom | divided_by: 16.0 }}rem;
                 --padding-top-mb: {{ section.settings.padding_top_mb | divided_by: 32.0 }}rem; --padding-bottom-mb: {{ section.settings.padding_bottom_mb | divided_by: 32.0 }}rem;">
        <div class="image w-[16.31rem] lg:w-[32.625rem] mx-auto mb-[0.25rem] lg:mb-1">
            <svg width="100%" height="20" version="1.1" viewBox="0 0 522 20" xmlns="http://www.w3.org/2000/svg">
                <g fill="none" fill-rule="evenodd">
                    <g transform="translate(-699 -1581)">
                        <g transform="translate(699 1581)">
                            <line x1=".5" x2="521.5" y1="19.5" y2="19.5" stroke="#FA8144" stroke-linecap="round"/>
                            <g transform="translate(226)" fill="#FA8144">
                                <path d="m35 18.329s24.672-23.291 28.431-17.363c1.7864 2.8175 1.7719 4.9489 2.7383 6.3748 0.99591 1.4693 1.8184 2.5451 3.1144 3.7188 2.4699 2.2369-1.9061 6.5986-6.121 6.7103-5.0743 0.1347-26.74 1.2302-26.74 1.2302s26.525-3.5228 27.169-7.8287c0.56771-3.7929-7.4098-0.55921-12.564 0.89469-5.1547 1.4539-15.303 6.5148-15.303 6.5148l-0.7249-0.25173z"/>
                                <path transform="translate(17.5 9.5) scale(-1 1) translate(-17.5 -9.5)" d="m0 18.329s24.672-23.291 28.431-17.363c1.7864 2.8175 1.7719 4.9489 2.7383 6.3748 0.99591 1.4693 1.8184 2.5451 3.1144 3.7188 2.4699 2.2369-1.9061 6.5986-6.121 6.7103-5.0743 0.1347-26.74 1.2302-26.74 1.2302s26.525-3.5228 27.169-7.8287c0.56771-3.7929-7.4098-0.55921-12.564 0.89469-5.1547 1.4539-15.303 6.5148-15.303 6.5148l-0.7249-0.25173z"/>
                            </g>
                        </g>
                    </g>
                </g>
            </svg>
        </div>
        <div class="title lg:line-clamp-2 font-medium text-[1.75rem] lg:text-[2.5rem] text-[#1A1A1A] leading-[2.25rem] lg:leading-[3rem] text-center">{{ section.settings.title }}</div>
        <div class="sub-title lg:line-clamp-3 mt-[0.5rem] lg:mt-4 text-center font-medium text-[1rem] lg:text-lg text-[#666666] leading-[1.5rem] lg:leading-[1.625rem]">{{ section.settings.sub_title }}</div>
    </div>
</div>


{% schema %}
{
  "name": "BC Common Title",
  "presets": [
    {
      "name": "优惠集合-通用标题",
      "category": "优惠信息集合页"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景颜色",
      "default": "#fcedda"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "标题默认内容"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "副标题",
      "default": "副标题默认内容"
    },
    {
      "type": "header",
      "content": "PC边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 20
    },
    {
      "type": "header",
      "content": "MB边距"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 24
    }
  ]
}
{% endschema %}
