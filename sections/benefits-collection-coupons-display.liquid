{% style %}

.benefits-collection-coupons-display .swiper-pagination-bullet {
    margin: 0 !important;
    height: 0.1875rem;
    width: 0.75rem;
    background: #CCCCCC;
    border-radius: 0.25rem;
    opacity: 1;
    transition: all .25s ease;
}

.benefits-collection-coupons-display .swiper-pagination-bullet-active {
    width: 4rem;
    background: var(--jds-color-primary);
}

.benefits-collection-coupons-display article p::-webkit-scrollbar {
    width: 0.25rem;
    height: 3.125rem;
}

.benefits-collection-coupons-display article p::-webkit-scrollbar-thumb {
    background: #999999;
    border-radius: 0.25rem;
}
{% endstyle %}

<section class="section-container-lg benefits-collection-coupons-display py-8 lg:py-[4.5rem]" anchor-target="{{ section.settings.anchor | escape }}">

    <div class="mb-[0.5rem] lg:mb-4 text-center text-[#1A1A1A] font-medium text-[1.75rem] lg:text-[2.5rem] leading-[2.25rem] lg:leading-[3rem]">
        {{ section.settings.title }}
    </div>
    <p class="mb-[1.5rem] lg:mb-10 lg:text-center font-medium lg:text-lg text-[#666666] leading-[1.5rem] lg:leading-[1.625rem]">
        {{ section.settings.description }}
    </p>

    <div class="swiper pb-[1.56rem] lg:pb-0">
        <div class="swiper-wrapper [&>*]:mx-[0.375rem] lg:[&>*]:mx-2.5 [&>*:first-child]:ml-0 [&>*:last-child]:mr-0">

            {% liquid
                if section.blocks.size == 2
                    assign lg_block_style = "lg:w-[40.375rem] lg:px-[5.1875rem]"
                    assign lg_pr = "lg:pr-[1rem]"
                elsif section.blocks.size == 3
                    assign lg_block_style = "lg:w-[26.5rem] lg:px-[2.625rem]"
                    assign lg_pr = "lg:pr-[0.75rem]"
                elsif section.blocks.size == 4
                    assign lg_pr = "lg:pr-[0.5rem]"
                    assign lg_block_style = "lg:w-[19.5625rem] lg:px-[1.25rem]"
                else
                    assign lg_block_style = "w-full"
                    assign lg_pr = "lg:pr-[1.25rem]"
                endif
            %}

            {% for block in section.blocks %}
                {%- if block.type == "benefits-coupon" -%}
                    <article {{ block.shopify_attributes }} class="swiper-slide w-[19.375rem] relative border-2 border-solid border-[#FFB48E] rounded-xl
                       px-[1rem] pt-[1rem] lg:pt-[2.5rem] text-center lg:h-[25.25rem] h-[19.125rem] {{ lg_block_style }}">
                        {% if block.settings.image == blank %}
                            <div class="h-[3.125rem] lg:h-[4.5rem] mb-[0.625rem] lg:mb-10"></div>
                        {% else %}
                            <img class="blur-up mb-[0.625rem] lg:mb-10 w-[3.125rem] lg:w-[4.5rem] h-[3.125rem] lg:h-[4.5rem]" src="{{ block.settings.image | image_url: width: 100 }}" alt="{{ block.settings.title }}" loading="lazy"/>
                        {% endif %}
                        <h3 class="mb-[1.3125rem] lg:mb-4 font-medium text-[1.3125rem] lg:text-[2rem] text-[#1A1A1A] leading-[1.75rem] lg:leading-10 line-clamp-2">
                            {{  block.settings.title }}
                        </h3>
                        <p class="{{ lg_pr }} pr-[0.375rem] font-medium lg:font-normal text-[0.875rem] lg:text-base text-[#999999] leading-[1.375rem] lg:leading-6 h-[8.3125rem] lg:h-[7.5rem] overflow-y-auto lg:overflow-y-auto">
                            {{  block.settings.description }}
                        </p>
                    </article>
                {% endif %}
            {% endfor %}


        </div>

        <div class="lg:hidden swiper-pagination flex justify-center gap-[0.375rem] bottom-0"></div>
    </div>

    <p class="mx-auto mt-[1.5rem] lg:mt-8 font-normal lg:text-base text-[#666666] text-[0.875rem] leading-[1.375rem] lg:leading-6 text-center">
        {{ section.settings.description_bottom | newline_to_br }}
    </p>
</section>
<script src="{{ 'sections-benefits-collection-coupons-display.js' | asset_url }}" defer></script>

