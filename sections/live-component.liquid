{% comment %} 直播版块 (单独页面仅能使用一个） {% endcomment %}
{% schema %}
{
  "name": "Live Component",
  "tag": "section",
  "class": "live-component",
  "settings": [
    {
      "type": "text",
      "id": "liveLink",
      "label": "Live Link"
    }
  ]
}
{% endschema %}
{% if section.settings.liveLink != blank %}
	<div class="live-wrapper">
		<div class="live-box layer-container section-container" data-src="{{ section.settings.liveLink }}"></div>
	</div>
{% endif %}
<style>
	.live-component .live-wrapper{
		padding: 2.0833vw 0;
		background-color: #f6f5f5;
	}

	.live-component .live-box{
		display: block;
		margin: 0 auto;
		height: calc((100vw - 40px) * 315 / 560);
		max-height: calc(1200px * 315 / 560);
	}
	.anniversary-page .live-component .live-wrapper{
		padding:0;
		background-color: transparent;
	}
	.anniversary-page .live-component .live-box{
		padding:0 4.5833vw;
		height: 33.3333vw;
		max-height: none;
	}
	@media screen and (max-width: 1023px){
		.live-component .live-box {
			max-width: 100%;
			width: 100%;
			padding:5.3333vw 4vw;
		}
		.anniversary-page .live-component{
			padding: 0;
		}
		.anniversary-page .live-component .live-box{
			padding: 0;
			height: 80vw;
		}
	}
</style>
