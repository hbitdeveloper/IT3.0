{% comment %} Why Choose {% endcomment %}
<div id="features" class="flex flex-col px-60 pt-90 pb-60 lg:j-px-0 lg:j-py-120 bg-white">
    <h2 class="collection-title">{{section.settings.why_title | newline_to_br}}</h2>
    <ul class="w-full lg:j-w-1200 mx-auto grid gap-y-25 lg:j-gap-24">
        {% for block in section.blocks %}
            {% assign index = forloop.index %}
            <li class="col-span-6 {% if block.settings.features_style == 'full' %} lg:col-span-12{% endif %} relative {% if index == 2 %}active{% endif %}">
                <div class="{% if index == 3 %} de-feature {% endif %} w-full px-60 lg:j-px-50 flex items-start flex-col absolute left-0 top-108 lg:j-top-56 z-2 {% if block.settings.banner_dark == 'dark' %} text-white{% else %} text-black{% endif %} {% if block.settings.features_style == 'full' %} lg:items-center justify-center lg:left-1/2 lg:-translate-x-1/2{% endif %}">
                    <h3 class="text-36 leading-54 lg:j-text-36 lg:j-leading-54 font-600 {% if block.settings.features_style == 'full' %}text-left lg:text-center{% endif %}">{{block.settings.title | newline_to_br}}</h3>
                    {% if block.settings.icon1 != blank or block.settings.icon2 != blank or block.settings.icon3 != blank or block.settings.icon4 != blank %}
                        <dl class="grid grid-cols-2 lg:flex lg:flex-wrap gap-x-80 gap-y-40 lg:j-gap-44 my-50 lg:j-my-30">
                            {% if block.settings.icon1 %}
                                <dd class="flex-1 flex-center flex-col">
                                    <img
                                        class="w-100 h-100 lg:j-w-100 lg:j-h-100 mb-12"
                                        src="{{block.settings.icon1 | image_url: width: 70}}"
                                        alt="{{block.settings.icon1.alt}}" loading="lazy"
                                    />
                                    <p class="text-20 leading-30 lg:j-text-18 lg:j-leading-27 font-300 text-center">{{block.settings.icon1_des | newline_to_br}}</p>
                                </dd>
                            {% endif %}
                            {% if block.settings.icon2 %}
                                <dd class="flex-1 flex-center flex-col">
                                    <img
                                        class="w-100 h-100 lg:j-w-100 lg:j-h-100 mb-12"
                                        src="{{block.settings.icon2 | image_url: width: 70}}"
                                        alt="{{block.settings.icon2.alt}}" loading="lazy"
                                    />
                                    <p class="text-20 leading-30 lg:j-text-18 lg:j-leading-27 font-300 text-center">{{block.settings.icon2_des | newline_to_br}}</p>
                                </dd>
                            {% endif %}
                            {% if block.settings.icon3 %}
                                <dd class="flex-1 flex-center flex-col">
                                    <img
                                        class="w-100 h-100 lg:j-w-100 lg:j-h-100 mb-12"
                                        src="{{block.settings.icon3 | image_url: width: 70}}"
                                        alt="{{block.settings.icon3.alt}}" loading="lazy"
                                    />
                                    <p class="text-20 leading-30 lg:j-text-18 lg:j-leading-27 font-300 text-center">{{block.settings.icon3_des | newline_to_br}}</p>
                                </dd>
                            {% endif %}
                            {% if block.settings.icon4 %}
                                <dd class="flex-1 flex-center flex-col">
                                    <img
                                        class="w-100 h-100 lg:j-w-100 lg:j-h-100 mb-12"
                                        src="{{block.settings.icon4 | image_url: width: 70}}"
                                        alt="{{block.settings.icon4.alt}}" loading="lazy"
                                    />
                                    <p class="text-20 leading-30 lg:j-text-18 lg:j-leading-27 font-300 text-center">{{block.settings.icon4_des | newline_to_br}}</p>
                                </dd>
                            {% endif %}
                        </dl>
                    {% endif %}
                    {% if block.settings.hide_details %}
                        <p class="text-28 leading-36 lg:j-text-18 lg:j-leading-27 opacity-0 translate-y-[20px] transition-all duration-700 {% if block.settings.features_style == 'full' %}w-full lg:j-w-800 text-left lg:text-center{% endif %}
                        " data-blur-show-text>{{block.settings.subtitle | newline_to_br}}</p>
                    {% else %}
                        <p class="text-20 leading-30 lg:j-text-18 lg:j-leading-27 font-300 text-main mt-16 lg:j-mt-8">{{block.settings.subtitle | newline_to_br}}</p>
                    {% endif %}
                </div>
                <div class="w-full rounded-30 lg:j-rounded-30 overflow-hidden relative z-1">
                    <div class="collection-blur-mask {% if block.settings.banner_dark == 'dark' %}bg-black{% else %}bg-white{% endif %}" data-blur-mask></div>
                    {% if block.settings.features_style == 'full' %}
                        <img
                            class="hidden lg:block w-full lg:j-w-1200 lg:j-h-750 object-cover transition-all duration-700"
                            src="{{block.settings.banner_img | image_url: width: 1200}}"
                            alt="{{block.settings.banner_img.alt}}" loading="lazy"
                            data-blur-img
                        />
                        <img
                            class="block lg:hidden w-full h-1070 object-cover transition-all duration-700"
                            src="{{block.settings.m_banner_img | image_url: width: 750}}"
                            alt="{{block.settings.m_banner_img.alt}}" loading="lazy"
                            data-blur-img
                        />
                    {% else %}
                        <img
                            class="hidden lg:block w-full lg:j-w-588 lg:j-h-750 object-cover transition-all duration-700"
                            src="{{block.settings.banner_img | image_url: width: 588}}"
                            alt="{{block.settings.banner_img.alt}}" loading="lazy"
                            data-blur-img
                        />
                        <img
                            class="block lg:hidden w-full h-1070 object-cover transition-all duration-700"
                            src="{{block.settings.m_banner_img | image_url: width: 588}}"
                            alt="{{block.settings.m_banner_img.alt}}" loading="lazy"
                            data-blur-img
                        />
                    {% endif %}
                </div>
                {% if block.settings.hide_details %}
                    <button class="collection-blur-btn text-white flex-center {% if index == 2 %}active{% endif %}" data-blur-btn>
                        <jds-icon name="close" class="iconfont jackery-icon-guanbi text-2xl lg:text-3xl"></jds-icon>
                    </button>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</div>

{% schema %}
{
  "name": "Features",
  "class": "section section-features section-sp-pps-sg-collection",
  "settings": [
    {"type": "textarea", "id": "why_title", "label": "Features Section title", "default": "Why Choose Jackery Solar Generator ?"}
  ],
  "blocks": [
      {
        "type": "features-item",
        "name": "Features block",
        "settings": [
            {
                "type": "select",
                "id": "features_style",
                "options": [
                    {
                        "value": "full",
                        "label": "Row"
                    },
                    {
                        "value": "half",
                        "label": "1/2 Row"
                    }
                ],
                "default": "full",
                "label": "Features Style"
            },
            {
                "type": "select",
                "id": "banner_dark",
                "options": [
                    {
                        "value": "dark",
                        "label": "Dark"
                    },
                    {
                        "value": "light",
                        "label": "Light"
                    }
                ],
                "default": "light",
                "label": "Features dark"
            },
            {"type": "checkbox", "id": "hide_details", "label": "Hide Details Text", "default": true},
            {"type": "textarea", "id": "title", "label": "Features title"},
            {"type": "textarea", "id": "subtitle", "label": "Features details"},
            {"type": "image_picker", "id": "banner_img", "label": "PC Features image"},
            {"type": "image_picker", "id": "m_banner_img", "label": "Mobile Features image"},
            {"type": "image_picker", "id": "icon1", "label": "ICON 1"},
            {"type": "textarea", "id": "icon1_des", "label": "Features 1"},
            {"type": "image_picker", "id": "icon2", "label": "ICON 2"},
            {"type": "textarea", "id": "icon2_des", "label": "Features 2"},
            {"type": "image_picker", "id": "icon3", "label": "ICON 3"},
            {"type": "textarea", "id": "icon3_des", "label": "Features 3"},
            {"type": "image_picker", "id": "icon4", "label": "ICON 4"},
            {"type": "textarea", "id": "icon4_des", "label": "Features 4"}
        ]
      }
    ]
}
{% endschema %}