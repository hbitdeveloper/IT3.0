{% comment %} jackery-life 活动 排行榜 {% endcomment %}

<section class="w-full bg-#F6F5F5">
  <div class="w-full overflow-hidden relative">
    {% comment %} background image {% endcomment %}
    <picture>
      <source media="(min-width:1024px)" srcset="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/14_2x_886f530c-f4f3-4606-872a-ab0d131ca4e0.png?v=1694600194">
      <img
          class="w-full h-632 lg:j-h-570 xl:a-h-570 object-cover"
          src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2x_1_dd3a6192-f4a5-4831-98a5-dbd33e867504.png?v=1694600277"
          alt=""
          loading="lazy"
      >
    </picture>

    {% comment %} decoration 金币图 {% endcomment %}
    <div
        class="
            absolute -right-40 top-505 lg:left-1/2 lg:j-top-498 -lg:j-ml-590 xl:left-1/2 xl:a-top-498 -xl:a-ml-590 z-2 bg-no-repeat bg-contain
            bg-[url(https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2x_990d6827-95c2-403b-96db-aaac23f39608.png?v=1694676328)]
            w-81 h-81 lg:j-w-68 lg:j-h-69 xl:a-w-68 xl:a-h-69
        "
    ></div>
    <div class="w-full mx-auto overflow-x-hidden flex-center flex-col relative z-1 -mt-632 lg:j-w-1080 -lg:j-mt-570 xl:a-w-1080 -xl:a-mt-570">
      <h2 class="font-bold text-white text-44 leading-44 mt-62 lg:j-text-44 lg:j-leading-44 lg:j-mt-53 xl:a-text-44 xl:a-leading-44 xl:a-mt-53">Ranking List</h2>
      <p
          class="
              font-normal text-#FFF6E7 text-24 leading-24 mt-16
              lg:font-medium lg:j-text-16 lg:j-leading-16 lg:j-mt-10
              xl:a-text-16 xl:a-leading-16 xl:a-mt-10
          "
          data-rank-statistic-time
      ></p>
      <div
          class="
              w-690 max-h-1220 rounded-20 pb-130 mt-122 mx-auto flex items-start lg:items-center justify-start flex-col bg-white relative
              lg:j-w-1080 lg:j-h-780 lg:j-min-h-780 lg:j-rounded-20 lg:j-pb-56 lg:j-mt-68
              xl:a-w-1080 xl:a-h-780 xl:a-min-h-780 xl:a-rounded-20 xl:a-pb-56 xl:a-mt-68
              before:block before:content-[''] before:w-130 before:h-29 before:lg:j-w-174 before:lg:j-h-56 before:xl:a-w-174 before:xl:a-h-56
              before:absolute before:left-15 before:top-35 before:lg:j-left-57 before:lg:j-top-38 before:xl:a-left-57 before:xl:a-top-38
              before:bg-[url(https://cdn.shopify.com/s/files/1/0550/0524/9633/files/7_2x_641b1b82-a52b-4ccf-8fb4-3766ed9ca30a.png?v=1694674550)]
              before:lg:bg-[url(https://cdn.shopify.com/s/files/1/0550/0524/9633/files/13_2x_05b0e9f1-b986-4ac9-b01d-ea34a42999e2.png?v=1694675629)]
              before:bg-no-repeat before:bg-contain
              after:block after:content-[''] after:w-35 after:h-22 after:lg:j-w-47 after:lg:j-h-29 after:xl:a-w-47 after:xl:a-h-29
              after:absolute after:right-18 after:top-54 after:lg:j-right-84 after:lg:j-top-41 after:xl:a-right-84 after:xl:a-top-41
              after:bg-[url(https://cdn.shopify.com/s/files/1/0550/0524/9633/files/32_2x_2c80d08f-5c8c-4626-8cb6-8e85bae3acf5.png?v=1694674549)]
              after:bg-no-repeat after:bg-contain
          "
      >
        {% comment %} tab {% endcomment %}
        <ul 
            class="
                w-auto min-w-full h-81 flex-center -mt-50 px-10 transition-all duration-300
                lg:j-w-1080 lg:j-h-81 -lg:j-mt-50 lg:j-gap-x-6
                xl:a-w-1080 xl:a-h-81 -xl:a-mt-50 xl:a-gap-x-6
            "
            data-tab-wrap
        ></ul>

        <p
            class="
                w-full font-medium text-#666 flex-center h-24 text-24 leading-24 my-16
                lg:j-h-16 lg:j-text-16 lg:j-leading-16 lg:j-my-10
                xl:a-h-16 xl:a-text-16 xl:a-leading-16 xl:a-my-10
            "
            data-rank-effective-time
        ></p>

        {% comment %} Rank 1-2-3 {% endcomment %}
        <ol class="w-full flex items-end justify-center gap-x-25 lg:j-gap-x-90 xl:a-gap-90">
          <li class="w-200 flex-center flex-col gap-y-12 lg:j-w-220 lg:j-gap-y-12 xl:a-w-220 xl:a-gap-y-12">
              <img class="w-133 h-133 lg:j-w-133 lg:j-h-133 xl:a-w-133 xl:a-h-133" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_2x_4a66e42d-87eb-433c-89c9-712ba3376698.png?v=1694398714" alt="" loading="lazy">
              <div
                  class="w-200 flex-center flex-col gap-y-4 lg:j-w-220 lg:j-gap-y-12 xl:a-w-220 xl:a-gap-y-12"
                  data-rank-second
              ></div>
          </li>
          <li class="w-200 flex-center flex-col gap-y-12 lg:j-w-220 lg:j-gap-y-12 xl:a-w-220 xl:a-gap-y-12">
              <img class="w-166 h-166 lg:j-w-166 lg:j-h-166 xl:a-w-166 xl:a-h-166" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_2x_057f7ee0-7dc7-4936-bcb3-1f1c2465573c.png?v=1694398714" alt="" loading="lazy">
              <div
                  class="w-200 flex-center flex-col gap-y-4 lg:j-w-220 lg:j-gap-y-12 xl:a-w-220 xl:a-gap-y-12"
                  data-rank-first
              ></div>
          </li>
          <li class="w-200 flex-center flex-col gap-y-12 lg:j-w-220 lg:j-gap-y-12 xl:a-w-220 xl:a-gap-y-12">
              <img class="w-133 h-133 lg:j-w-133 lg:j-h-133 xl:a-w-133 xl:a-h-133" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/3_2x_19d67223-c18b-4904-9743-4e15f6cb4d44.png?v=1694398714" alt="" loading="lazy">
              <div
                  class="w-200 flex-center flex-col gap-y-4 lg:j-w-220 lg:j-gap-y-12 xl:a-w-220 xl:a-gap-y-12"
                  data-rank-third
              ></div>
          </li>
      </ol>

        {% comment %} Rank 4-100 {% endcomment %}
      <div class="w-full px-20 mt-8 lg:j-w-1080 lg:flex-1 lg:j-mt-6 lg:j-px-90 xl:a-w-1080 xl:a-mt-6 xl:a-px-90 relative overflow-y-auto">
          <div
              class="
                  flex-between h-88 gap-x-25 bg-white sticky top-0 left-0
                  lg:j-h-48 lg:j-gap-x-25
                  xl:a-h-48 xl:a-gap-x-25
              "
              data-rank-table-header
          ></div>
          <ul
              class="w-full rank-table-content h-616 lg:j-h-336 xl:a-h-336"
              data-rank-table-content
          ></ul>
      </div>

        <div
            class="
                hidden w-full flex-center border-solid border-#878787/17 h-130 border-0 border-t-1 mt-8
                px-24 text-primary absolute left-0 bottom-0 font-medium
                lg:j-h-56 lg:j-border-t-1 lg:j-mt-2 lg:j-px-24
                xl:a-h-56 xl:a-border-t-1 xl:a-mt-2 xl:a-px-24
            "
            data-rank-tips
        ></div>


        {% comment %} 无数据-占位 {% endcomment %}
        <p
            class="
                hidden w-full h-520 flex-center font-semibold text-primary
                text-36 leading-44 text-center
                lg:j-h-520 lg:j-text-36 -lg:j-mt-24 xl:a-h-520 xl:a-text-36 -xl:a-mt-24
            "
            data-no-data
        >Share your wonderful life now!</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Life Activity Rank",
    "class": "section-life-activity section-life-activity-rank",
    "settings": []
  }
{% endschema %}