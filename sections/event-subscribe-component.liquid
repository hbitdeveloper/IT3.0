{%- style -%}
  @media screen and (min-width: 1024px) {
     .event-subscribe.subscribe-alert .icon-close {
      width: unset;
    }
  }
{%- endstyle -%}

{% comment %} 邮件+手机订阅 {% endcomment %}
{% schema %}
{
  "name": "Event Subscribe Component",
  "tag": "section",
  "class": "event-subscribe-component layer-container section-container",
  "settings": [
    {
      "type": "text",
      "id": "sectionTitle",
      "label": "Section Title",
      "default": "SUBSCRIBE HERE"
    },
    {
      "type": "text",
      "id": "btnSubmitText",
      "label": "Button Submit Text",
      "default": "Submit"
    },
    {
      "type": "text",
      "id": "emailInpPlaceholder",
      "label": "Email Input Placeholder",
      "default": "Enter your email to Subscribe"
    },
    {
      "type": "text",
      "id": "phoneInpPlaceholder",
      "label": "Phone Input Placeholder",
      "default": "option"
    },
    {
      "type": "text",
      "id": "emailErrorTips",
      "label": "Email Error Tips",
      "default": "Please enter a valid email address"
    },
    {
      "type": "text",
      "id": "phoneErrorTips",
      "label": "Phone Error Tips",
      "default": "Please enter a valid phone"
    },
    {
      "type": "text",
      "id": "privacyCheckboxTips",
      "label": "Privacy Checkbox Tips",
      "default": "Please agree to the Terms of Service and Privacy policy."
    },
    {
      "type": "text",
      "id": "IAgreeToText",
      "label": "I agree to",
      "default": "I agree to"
    },
    {
      "type": "text",
      "id": "termsOfUseText",
      "label": "Terms of Use",
      "default": "Terms of Use"
    },
    {
      "type": "url",
      "id": "termsOfUseLink",
      "label": "Terms of Use Link"
    },
    {
      "type": "text",
      "id": "andText",
      "label": "And Text",
      "default": "and"
    },
    {
      "type": "text",
      "id": "privacyPolicyText",
      "label": "Privacy Policy Text",
      "default": "Privacy Policy"
    },
    {
      "type": "url",
      "id": "privacyPolicyLink",
      "label": "Privacy Policy Link"
    },
    {
      "type": "text",
      "id": "moreText",
      "label": "More Text"
    },
    {
      "type": "text",
      "id": "enterKeywordText",
      "label": "Enter keyword Text",
      "default": "Enter keyword"
    },
    {
      "type": "text",
      "id": "noSearchDataText",
      "label": "No Search Data Text",
      "default": "No Search Data"
    },
    {
      "type": "text",
      "id": "alertSuccessTitle",
      "label": "Alert Success Title",
      "default": "Subscribed  Successfully"
    },
    {
      "type": "text",
      "id": "alertSuccessContent",
      "label": "Alert Success Content",
      "default": "Don't miss the latest news and special offers"
    },
    {
      "type": "text",
      "id": "btnRegisterNowText",
      "label": "Button Register Now Text",
      "default": "REGISTER NOW"
    },
    {
      "type": "text",
      "id": "btnEnterFBGroupText",
      "label": "Button Enter FB Group Text",
      "default": "JOIN OUR GROUP"
    },
    {
      "type": "url",
      "id": "btnEnterFBGroupLink",
      "label": "Button Enter FB Group Link"
    }
  ]
}
{% endschema %}

<h2 class="section-title" name="subscribe">{{ section.settings.sectionTitle }}</h2>
{% comment %} 邮箱订阅核心版块 {% endcomment %}
<div class="event-subscribe subscribe-content">
  <div class="item-box email-box">
    <input class="box-inp" type="text" placeholder="{{ section.settings.emailInpPlaceholder }}">
    <button type="button" class="btn-submit" data-section-class="subscribe-content" data-type="email">
      {{ section.settings.btnSubmitText }}
    </button>
    <div class="error-tips email-error-tips">
      {{ section.settings.emailErrorTips }}
    </div>
  </div>
  <div class="item-box phone-box">
    <div class="country-area-select">
      <div class="change-area">
        {% comment %} 国家或区域旗帜 {% endcomment %}
        <img class="selected-flag" src="" alt="jackery country" loading="lazy" width="40" height="40">

        {% comment %} 国家或区域编码 {% endcomment %}
        <span class="selected-item"></span>
        <div class="select-arrow"></div>
      </div>
      {% comment %} 国家或区域列表 {% endcomment %}
      <div class="country-area-list">
        <div class="search-swrapper">
          <input
              type="text"
              class="country-area-search"
              placeholder="{{ section.settings.enterKeywordText }}"
          >
        </div>
        <div class="no-data">{{ section.settings.noSearchDataText }}</div>
        <div class="list-box">
          {% comment %} <div class="country-item" data-code="93" data-iso="AF">Afghanistan</div> {% endcomment %}
        </div>
      </div>
      <span class="country-area-num"></span>
      <input class="box-inp" type="number" placeholder="{{ section.settings.phoneInpPlaceholder }}">
    </div>
    <button type="button" class="btn-submit" data-section-class="subscribe-content" data-type="phone">
      {{ section.settings.btnSubmitText }}
    </button>
    <div class="error-tips phone-error-tips">{{ section.settings.phoneErrorTips }}</div>
  </div>
  <div class="item-box checkbox-box">
    <label class="checkbox">
      <span class="checkbox-input">
        <input
            type="checkbox"
            class="checkbox-original"
            data-section-class="subscribe-content"
        >
        <span class="checkbox-inner">
          <jds-icon name="check" class="jackery-icon-checkbox"></jds-icon>
        </span>
      </span>

      <span class="checkbox-label">
        {{ section.settings.IAgreeToText }}
        <a href="{{ section.settings.termsOfUseLink }}" title="{{ section.settings.termsOfUseLink }}">{{- section.settings.termsOfUseText -}}</a>
        {{ section.settings.andText }}
        <a href="{{ section.settings.privacyPolicyLink }}" title="{{ section.settings.privacyPolicyLink }}">{{- section.settings.privacyPolicyText -}}</a>
        {{ section.settings.moreText }}
      </span>
    </label>
    <div class="error-tips checkbox-error-tips">{{ section.settings.privacyCheckboxTips }}</div>
  </div>
</div>

{% comment %} 订阅成功弹窗 {% endcomment %}
<div class="event-subscribe subscribe-alert">
  {% comment %} 订阅成功提示弹窗 {% endcomment %}
  <div class="alert-box subscribe-success">
    <svg class="pc-show icon-close" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
      <g fill="#3C3C3C" fill-rule="evenodd">
        <path d="M8 7l17 17-1 1L7 8z"></path>
        <path d="M7 24L24 7l1 1L8 25z"></path>
      </g>
    </svg>
    <div class="mb-show icon-close">
      <svg width="32" height="32" xmlns="http://www.w3.org/2000/svg">
        <g fill="#fff" fill-rule="evenodd">
          <path d="M8 7l17 17-1 1L7 8z"></path>
          <path d="M7 24L24 7l1 1L8 25z"></path>
        </g>
      </svg>
    </div>
    <img
        class="alert-icon"
        src="https://cdn.shopifycdn.net/s/files/1/0970/9262/files/icon-giveaways.png?v=1685181380"
        alt="" loading="lazy"
    >
    <p class="alert-title">{{ section.settings.alertSuccessTitle }}</p>
    <p class="alert-content">{{ section.settings.alertSuccessContent }}</p>
    <div class="alert-btns">
      {% comment %} 注册按钮，自行匹配对应站点注册超链接 {% endcomment %}
      {% if section.settings.btnRegisterNowText != blank %}
        {% if shop.id == 55005249633 %}
          {%- assign account_url = 'https://demo-account.jackery.com' -%}
        {% else %}
          {%- assign account_url = 'https://account.jackery.com' -%}
        {% endif %}
        {% assign ref = '{"u":"'
            | append: shop.url
            | append: '","id":"'
            | append: shop.id
            | append: '","back":"/account/overview", "original": "'
            | append: canonical_url
            | append: '"}'
            | base64_encode
        %}
        <a href="{{ account_url | append: "/register?jackeryRef=" | append: ref }}" target="_blank" rel="noopener noreferrer"
           class="btn-item btn-register">
          {{- section.settings.btnRegisterNowText -}}
        </a>
      {% endif -%}
      {%- if section.settings.btnEnterFBGroupLink != blank %}
        <a href="{{ section.settings.btnEnterFBGroupLink }}" class="btn-item btn-enter">
          {{- section.settings.btnEnterFBGroupText -}}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% comment %} 邮箱订阅吸底版块 {% endcomment %}
<div class="event-subscribe subscribe-footer">
  <div class="item-box email-box">
    <input class="box-inp" type="text" placeholder="{{ section.settings.emailInpPlaceholder }}">
    <button type="button" class="btn-submit" data-section-class="subscribe-footer" data-type="email">
      {{ section.settings.btnSubmitText }}
    </button>
    <div class="error-tips email-error-tips">{{ section.settings.emailErrorTips }}</div>
  </div>
  <div class="item-box checkbox-box">
    <label class="checkbox">
      <span class="checkbox-input">
        <input
            type="checkbox"
            class="checkbox-original"
            data-section-class="subscribe-footer"
        >
        <span class="checkbox-inner">
          <jds-icon name="check" class="jackery-icon-checkbox"></jds-icon>
        </span>
      </span>

      <span class="checkbox-label">
        {{ section.settings.IAgreeToText }}
        <a href="{{ section.settings.termsOfUseLink }}" title="{{ section.settings.termsOfUseLink }}">{{- section.settings.termsOfUseText -}}</a>
        {{ section.settings.andText }}
        <a href="{{ section.settings.privacyPolicyLink }}" title="{{ section.settings.privacyPolicyLink }}">{{- section.settings.privacyPolicyText -}}</a>
        {{ section.settings.moreText }}
      </span>
    </label>
    <div class="error-tips checkbox-error-tips">{{ section.settings.privacyCheckboxTips }}</div>
  </div>
</div>

