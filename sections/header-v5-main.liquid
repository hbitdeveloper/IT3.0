        },
        { 
            "type": "color", "id": "text_color","label": "文本色", "default": "#242f20" 
        },
        { 
            "type": "color", "id": "help_bg","label": "help me select背景", "default": "#242f20" 
        },
        { 
            "type": "color", "id": "help_text","label": "help me select文字颜色", "default": "#ffffff" 
        },

