                },
                {
                    "type": "header", "content": "多语言"
                },
                {"type": "text", "id": "view_all", "label": "查看所有", "default": "View All"},
                {"type": "text", "id": "view_less", "label": "Less", "default": "Less"},
                {"type": "text", "id": "view_more", "label": "More", "default": "More"},
