        },

        { "type": "text", "id": "user_menu_title", "label": "用户菜单标题", "default": "Join Jackery Membership for Multiple Benifits" },
        {
            "type": "header",
            "content": "用户菜单副标题"
        },
        { "type": "text", "id": "user_menu_info_1", "label": "用户菜单信息列表-1", "default": "Get $200 off coupon for first registration" },
        { "type": "text", "id": "user_menu_info_2", "label": "用户菜单信息列表-2", "default": "Memership Price (Up to $XXX off)" },
        { "type": "text", "id": "user_menu_info_3", "label": "用户菜单信息列表-3" },
        { "type": "text", "id": "user_menu_info_4", "label": "用户菜单信息列表-4" },
        { "type": "text", "id": "user_menu_info_5", "label": "用户菜单信息列表-5" },
        {
            "type": "header",
            "content": "多语言配置"
        },
        { "type": "text", "id": "text_back", "label": "返回上一级", "default": "Back" },
        { "type": "text", "id": "text_shop_all", "label": "查看所有商品", "default": "Shop All" }
    ],
    "blocks": [
        {
            "type": "shop_menu",
            "name": "Shop菜单",
            "limit": 2,
            "settings": [
                {"type": "link_list", "id": "menu_list", "label": "Menu", "info": "空白菜单项的链接请配置'#'占位"},
                {"type": "text", "id": "menu_tag", "label": "菜单标签"},
                {"type": "text", "id": "menu_heading", "label": "菜单标题", "default": "Shop"},

                { 
                    "type": "color", "id": "fk_color","label": "高亮", "default": "#242f20" 
                },
                {
                    "type": "range",
                    "id": "shop_collection_max",
                    "min": 5,
                    "max": 20,
                    "step": 5,
                    "label": "每个collection最大显示数量",
                    "default": 10
                },
                {
                    "type": "select",
                    "id": "shop_collection_default",
                    "options": [
                        {
                        "value": "1",
                        "label": "一行"
                        },
                        {
                        "value": "2",
                        "label": "两行"
                        }
                    ],
                    "default": "1",
                    "label": "每个collection默认显示数量",
