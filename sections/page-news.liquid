<style>
    .section-page-news .image-text-swiper {
        background: #ffffff;
    }
    .section-page-news .events-list {
        padding-bottom: 120px;
    }
    .section-page-news .image-text-swiper {
        padding-bottom: 70px;
    }
    .section-page-news .image-text-swiper .slideshow-pagination {
        bottom: 50px;
    }
    .kol-join-block {
        background: #FFFFFF;
        margin-bottom: 120px;
    }
    .kol-join-block .section-container {
        padding: 34px 40px;
        box-shadow: 0px 6px 20px 0px rgba(85,85,85,0.2);
        position: relative;
        z-index: 2;
    }
    .kol-join-title {
        margin-right: 114px;
    }

    @media screen and (max-width: 768px) {
        .section-page-news .image-text-swiper {
            background: #F5F5F5;
        }
        .section-page-news .image-text-swiper .slideshow-pagination {
            bottom: 8.6vw;
        }
        .kol-join-block {
            margin-bottom: 0;
            background: #F5F5F5;
        }
        .kol-join-block .section-container {
            padding: 0;
            box-shadow: none;
            flex-direction: column;
            background: #fff;
            padding: 5.3vw;
        }
        .kol-join-title {
            margin-right: 0;
            text-align: center;
            margin-bottom: 4.8vw;
        }
        .section-page-news .events-list {
            padding-bottom: 0;
        }
    }

    .pdf-grid {
        background: #f6f6f6;
        padding: 120px 0;
    }
    .pdf-grid-container {
        --hide: 99;
        padding: 10px;
    }
    .pdf-grid-btn:checked+.pdf-grid-container {
        --hide: 0;
    }
    .pdf-grid-container {
        --grid-rep: 1;
        display: grid;
        flex-wrap: wrap;
        grid-template-columns: repeat(4,1fr);
        grid-template-rows: repeat(var(--grid-rep), minmax(0, 1fr)) repeat(var(--hide), minmax(0, 0));
        overflow: hidden;
    }
    .pdf-grid-item {
        background: #fff;
        margin: 10px;
        padding: 50px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-shadow: 0px 6px 10px 0px rgba(85,85,85,0);
        transition: all .3s ease;
    }
    .pdf-grid-item:hover {
        transform: scale(1.02);
        box-shadow: 0px 6px 10px 0px rgba(85,85,85,0.3);
    }
    .pdf-grid-item:hover .a-button-fill {
        background: var(--primary-color);
        color: #fff;
    }

    .pdf-grid-item .icon-pdf {
        width: 96px;
        height: 96px;
        font-size: 96px;
        color: #333;
        display: inline-block;
    }
    .pdf-card-title {
        margin: 22px 0;
        font-weight: 500;
        min-height: 108px;
    }
    .pdf-grid-item .a-button-fill {
        padding-top: 8px;
        padding-bottom: 8px;
    }
    @media screen and (max-width: 768px) {
        .pdf-grid {
            padding: 14vw 0;
        }
        .pdf-grid-container {
            --hide: 99;
            padding: 0
        }
        .pdf-grid-btn:checked+.pdf-grid-container {
            --hide: 0;
        }
        .pdf-grid-container {
            --grid-rep: 2;
            grid-template-columns: repeat(2,1fr);
            max-width: 85vw;
            grid-template-rows: repeat(var(--grid-rep), minmax(0, 1fr)) repeat(var(--hide), minmax(0, 0));
            overflow: hidden;
        }
        .pdf-grid-item {
            margin: 0 2vw 4vw 0;
            padding: 6.6vw 2.6vw 3.7vw 2.6vw;
        }
        .pdf-grid-item:nth-child(2n) {
            margin-left: 2vw;
            margin-right: 0;
        }
        .pdf-grid-item:hover {
            transform: scale(1);
            box-shadow: none;
        }
        .pdf-grid-item .icon-pdf {
            width: 12vw;
            height: 12vw;
            font-size: 12vw;
            color: #333;
        }
        .pdf-card-title {
            margin: 2.9vw 0 4vw 0;
            min-height: 8vw;
        }
        .pdf-grid-item .a-button-fill {
            padding: 1.6vw 0;
            width: 100%;
        }

        .contact ul {
            margin: 8.6vw auto 20vw auto;
        }
    }

    html[lang='de'] .kol-join-block .a-button-fill {
        font-size: 18px;
    }
    @media screen and (max-width: 768px) {
        html[lang='de'] .kol-join-block .a-button-fill {
            font-size: 16px;
        }
    }
</style>

<div class="page-news-main">
    {% render 'pages-banner', blocks: section.blocks, autoplay_speed: section.settings.autoplay_speed, autoplay: section.settings.autoplay %}
    {% render 'card-swiper', title: section.settings.announced_title, blocks: section.blocks %}
    {% render 'grid-list', title: section.settings.exihibition_title, blocks: section.blocks, show_all: section.settings.show_all %}
    {% render 'image-text-swiper', title: section.settings.recent_title, blocks: section.blocks %}
    <div class="kol-join-block">
        <div class="section-container flex justify-between items-center">
            <h3 class="kol-join-title jky-text-xl font-bold">
                {{section.settings.kol_join_title | escape}}
            </h3>

            <a class="slide-link z-button-big jky-text-lg active" href="{{section.settings.kol_url}}">
                {{section.settings.kol_btn | escape}}
                <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-base"></jds-icon>
            </a>
        </div>
    </div>

    <div class="pdf-grid">
        <h2 class="h2 section-container text-center pdf-grid-title page-section-title">
            {{section.settings.pdf_section_title | escape}}
        </h2>

        <input class="pdf-grid-btn none events-list-btn" type="checkbox" id="pdf-grid-btn">
        <div class="pdf-grid-container section-container">
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'pdf_item' %}
                    <div class="pdf-grid-item">
                        {% if block.settings.image != blank %}
                            <img class="object-cover img-icon"
                                    src="{{block.settings.image | image_url: width: 100}}"
                                    alt="{{block.settings.title | escape}}" loading="lazy">
                        {% else %}
                            <jds-icon name="pdf" class="img-icon icon-pdf"></jds-icon>
                        {% endif %}
                        <div class="jky-text-sm text-center pdf-card-title text-overflow-3">{{block.settings.title | escape}}</div>
                        <a class="a-button-fill jky-text-sm pdf-down" href="{{block.settings.link}}">
                            <jds-icon name="download" class="download jky-text-sm"></jds-icon>
                            {{block.settings.link_btn_txt}}
                        </a>
                    </div>
                {% endcase %}
            {% endfor %}
        </div>

		<label for="pdf-grid-btn" class="flex justify-center pdf-grid-more relative events-list-more">
			<div class="z-button-big">
                <span class="no_all">{{'general.action_text.view_more' | t}}</span>
                <span class="all">{{'accessibility.close' | t}}</span>
                <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
            </div>
		</label>
    </div>
</div>

<script defer>
    if (window.innerWidth <= 768) {
        if(document.querySelectorAll(".pdf-grid-container .pdf-grid-item").length <= 2) {
            document.querySelector('.pdf-grid-container').style.setProperty('--grid-rep', 1)
        }
    }
</script>

{% schema %}
{
    "name": "Page News main",
    "class": "section-page-news",
    "settings": [
        {"type": "checkbox", "id": "autoplay", "label": "Auto-change slides", "default": true},
        {"type": "range", "id": "autoplay_speed", "label": "Change images every", "default": 7, "min": 5, "max": 10, "step": 1, "unit": "s"},
        {"type": "textarea", "id": "recent_title", "label": "Section recent events title", "default": "VIEW RECENT JACKERY\nBRAND EVENTS"},
        {"type": "textarea", "id": "announced_title", "label": "Section announced title", "default": "Here’s what we announced"},
        {"type": "textarea", "id": "exihibition_title", "label": "Section exihibition title", "default": "View recent Jackery\nexihibition events"},
        {"type": "text", "id": "show_all", "label": "Show all text", "default": "EXPLORE MORE"},
        {"type": "textarea", "id": "kol_join_title", "label": "KOL JOIN TITLE", "default": "Interested to be our KOL?\nLet join our Affiliate Program now!"},
        {"type": "text", "id": "kol_btn", "label": "KOL Join buton text", "default": "JOIN NOW"},
        {"type": "url", "id": "kol_url", "label": "KOL Join link"},
        {"type": "textarea", "id": "pdf_section_title", "label": "PDF Section Title", "default": "MEDIA KITS"}

    ],
    "blocks": [
        {
            "type": "page_banner", "name": "Page Banner",
            "settings": [
                {"type": "textarea", "id": "title", "label": "Heading", "default": "Explore Further\nwith Jackery Solar"},
                {"type": "url", "id": "link", "label": "Slide link"},
                {"type": "text", "id": "link_text", "label": "Slide link text", "default": "VIEW MORE"},
                {"type": "image_picker", "id": "image", "label": "Image"},
                {"type": "image_picker", "id": "m_image", "label": "Mobile Image"},
                {"type": "image_picker", "id": "banner_icon", "label": "Banner Icon Image"}
            ]
        },
        {
            "type": "recent_events", "name": "Rectent Events",
            "settings": [
                {"type": "textarea", "id": "title", "label": "Heading"},
                {"type": "text", "id": "sub_text", "label": "Event Abstract"},
                {"type": "url", "id": "link", "label": "Event link"},
                {"type": "url", "id": "video_link", "label": "Video link"},
                {"type": "text", "id": "link_text", "label": "Event link text", "default": "VIEW MORE"},
                {"type": "image_picker", "id": "image", "label": "Image"},
                {"type": "image_picker", "id": "m_image", "label": "Mobile Image"}
            ]
        },
        {
            "type": "announced_block", "name": "Announced block",
            "settings": [
                {"type": "textarea", "id": "title", "label": "Heading"},
                {"type": "textarea", "id": "sub_text", "label": "Announced Abstract"},
                {"type": "url", "id": "link", "label": "Announced link"},
                {"type": "text", "id": "date", "label": "Event Date"},
                {"type": "image_picker", "id": "image", "label": "Image"}
            ]
        },
        {
            "type": "grid_item", "name": "Exihibition block",
            "settings": [
                {"type": "textarea", "id": "title", "label": "Heading"},
                {"type": "text", "id": "date", "label": "Exihibition Date"},
                {"type": "url", "id": "link", "label": "Exihibition link"},
                {"type": "text", "id": "link_text", "label": "Exihibition link text", "default": "VIEW MORE"},
                {"type": "image_picker", "id": "image", "label": "Image"}
            ]
        },
        {
            "type": "pdf_item", "name": "PDF block",
            "settings": [
                {"type": "textarea", "id": "title", "label": "PDF title"},
                {"type": "url", "id": "link", "label": "PDF link"},
                {"type": "text", "id": "link_btn_txt", "label": "PDF link text", "default": "DOWNLOAD"},
                {"type": "image_picker", "id": "image", "label": "Image"}
            ]
        }
    ]
}
{% endschema %}