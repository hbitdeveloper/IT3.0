<style>
  .mmb {display: none;}
  @media screen and (max-width: 1024px) {
    .mmb {display: block;}
  }

  .content-for-layout {
    --p-top: 100px; --content-distance: 40px; --g-radius: 30px; --gray-color: #F5F5F5;
    --symbol-l-w: 34px; --symbol-l-h: 54px; --symbol-r-w: 46px; --symbol-r-h: 66px;
    --p-detail-t: 120px; --appliance-gap: 32px; --appliance-icon: 100px;
    --media: 580px;--img-text: 32px;
    --video-top: 100px;
  }
  @media screen and (max-width: 1024px) {
    .content-for-layout {
      --p-top: 32px; --content-distance: 30px; --g-radius: 15px;
      --symbol-l-w: 18px; --symbol-l-h: 28px; --symbol-r-w: 24px; --symbol-r-h: 33px;
      --p-detail-t: 55px; --appliance-gap: 25px; --appliance-icon: 50px;
      --media: 54vw;
      --video-top: 55px;
    }
  }

  .heading-icon {width: 0; height:0; display: none;}
  .content-for-layout .product-title {margin-bottom: var(--content-distance); text-align: center;}

  .content-for-layout .product-title img,
  .content-for-layout .title-icon .title-box img,
  .content-for-layout .title img {width: 80px; margin-right: var(--gap);}

  .content-for-layout .title {color: var(--text-black); text-align: center;}
  .title-box .title {margin-bottom: 16px;}
  .content-for-layout .title-icon {justify-content: space-between; padding: 0 var(--content-distance);}
  .content-for-layout .title-icon .title-box {width: 72.8%; flex-wrap: wrap;}
  .content-for-layout .left-icon {width: var(--symbol-l-w); height: var(--symbol-l-h);}
  .content-for-layout .right-icon {width: var(--symbol-r-w); height: var(--symbol-r-h); align-self: flex-end;}

  .content-for-layout .main-color {color: var(--primary-color);}
  .content-for-layout img {max-width: 100%;}

  .content-for-layout .card-swiper, .card-swiper .slideshow-pagination {margin-top: var(--content-distance);}
  .card-swiper .card-swiper-container {height: fit-content;}

  .content-for-layout .gray-background {background: var(--gray-color);}

  .features {padding: var(--p-top) 0;}
  .video-text-wrap video {
    width: 100%; height: 675px; margin: 0 auto; object-fit: cover;
    display: flex; justify-content: center;
  }
  .video-text-wrap .video-box .vjs-big-play-button {top: 50%; left: 50%; transform: translate(-50%,-50%);}

  .video-text-wrap .text-box {
    padding: 0 var(--content-distance);
    display: flex; justify-content: space-between;
  }
  .video-text-wrap .text-box.layer-container:not(.sp) {margin-top: var(--content-distance);}
  .video-text-wrap .text-box span {max-width: 80%; display: inline-block; color: var(--text-black);}
  .video-text-wrap .text-box.sp {background: var(--normal-color);padding: 0;}
  .video-text-wrap .text-box.sp span {max-width: 100%; margin: 32px 0 32px 50px;}
  @media screen and (max-width: 1024px) {
    .video-img-box.layer-container {width: 100%;}
    .video-text-wrap video {height: auto;}
    .video-text-wrap .text-box {padding: 0;}
    .video-text-wrap .text-box.layer-container {padding: var(--gap); background: var(--gray-color);}
    .video-text-wrap .text-box.sp span {margin: var(--gap) auto;padding: 0 var(--content-distance);}
  }


  .features-suammry {padding-top: var(--p-detail-t);}
  .features-suammry {text-align: center;}
  .features-suammry img {width: calc(100% - 25px); max-width: 1200px; margin: 0 auto;}
  @media screen and (max-width: 1024px) {
    .features-suammry {background: var(--normal-color);}
  }

  .part-1 {margin-top: var(--p-detail-t);}
  .part-1 .desc {color: var(--text-black); margin-top: var(--content-distance);}
  .part-1 .bms-img {margin-top: var(--content-distance); border-radius: var(--g-radius);}
  @media screen and (max-width: 1024px) {
    .part-1.layer-container {width: 100%;}
    .part-1 .bms-img {border-radius: 0;}
    .part-1 .mmb {padding: 0 30px;}
  }


  .part-2 {margin-top: var(--p-detail-t);}
  .part-2 .title {margin-bottom: 40px;}
  .part-2 .title img {margin-right: var(--gap);}
  .part-2 .part-2-wrap {background: var(--normal-color); border-radius: var(--g-radius);}
  .part-2 .part-2-wrap .text {padding: 20px 50px; color: var(--text-black);}
  @media screen and (max-width: 1024px) {
    .part-2.layer-container {width: 100%;}
    .part-2 .title, .part-2 .part-2-wrap .text {padding: 0 30px;}
    .part-2 .title, .part-2 .part-2-wrap img {margin-bottom: var(--content-distance);}
    .part-2 .part-2-wrap {background: transparent; border-radius: 0;}
    .part-2 .part-2-wrap img {height: 100vw; object-fit: cover;}
  }


  .part-3 {margin-top: var(--p-detail-t);}
  .part-3 .slideshow-pagination {position: static;}
  @media screen and (max-width: 1024px) {
    .part-3.layer-container {width: 100%;}
    .part-3 .mmb {padding: 0 30px;}
    .part-3 .desc {margin-top: var(--content-distance);}
  }


  .seem-wrap {margin-top: var(--p-detail-t);}
  .seem-wrap .seem-box img {width: 100%; object-fit: cover;}
  .seem-wrap .seem-card {background: var(--normal-color); border-radius: var(--g-radius); margin-top: -50px; overflow: hidden;}
  .seem-wrap.no-scens .seem-card {margin-top: 0;}
  .seem-wrap .seem-card .text {padding: 32px 50px; color: var(--text-black);}
  @media screen and (max-width: 1024px) {
    .seem-wrap .seem-box img {height: 77vw;}
    .seem-wrap .seem-card {background: transparent; margin-top: -15vw; position: relative; z-index: 1;}
    .seem-wrap .seem-card img {border-radius: var(--g-radius);}
    .seem-wrap .seem-card .text {padding: var(--content-distance) 0;}
  }


  .outdoors-wrap .seem-card {margin-top: -50px;}
  .outdoors-wrap .sing-image {margin-top: var(--content-distance);}
  @media screen and (max-width: 1024px) {
    .outdoors-wrap .image {filter: brightness(0.7);}
    .outdoors-wrap .sing-image {margin-top: 0;}
    .sing-image.layer-container {width: 100%;}
    .outdoors-wrap .seem-card {margin-top: -15vw;}
  }


  .need-wrap {margin-top: 70px;}
  @media screen and (max-width: 1024px) {
    .need-wrap {margin-top: 0;}
  }


  .power-station {
    --content-top: 80px; --content-text: 45px; --flex: 50% 0 0;
    background: var(--normal-color); border-radius: var(--g-radius); padding: 70px 36px;
  }
  .power-station .header {color: var(--text-main-color); text-align: center;}
  .power-station .header > img {float: right; margin-top: 12px; cursor: pointer;}
  .power-station .content {margin-top: var(--content-top); display: flex;}
  .power-station .content .image {flex: var(--flex);}
  .power-station .content .text {margin-left: var(--content-text); flex: auto;}
  .power-station .content .subtitle {color: var(--text-black);}
  .power-station .content .desc {color: var(--text-black); margin-top: var(--gap);}
  @media screen and (max-width: 1024px) {
    .power-station {
      --content-top: 20px; --content-text: 0; --flex: 100% 0 0;
      padding: var(--content-distance) var(--gap);
    }
    .power-station .header {display: flex; flex-direction: column; align-items: center;}
    .power-station .header > img {width: 14px; height: 14px;}
    .power-station .content {flex-wrap: wrap;}
    .power-station .content .image {margin-bottom: var(--content-top);}
    .power-station .content .desc {line-height: 26px;}
  }


  .product-contrast {
    --contrast-gap: 30px; --param-top: 24px; --select: 48px; --repeat: repeat(3, 1fr);
    margin-top: var(--content-distance);
    display: none;
  }
  .product-contrast .display-none {display: none;}
  .contrast-wrap {display: flex; grid-template-columns: var(--repeat); grid-gap: var(--gap); justify-content: center;}
  .contrast-product {background: var(--normal-color);display: flex;flex-direction: column;}
  .contrast-wrap .main-pdt { padding-top: 98px; }
  .contrast-wrap li {width: 33%; background: var(--normal-color); text-align: center; padding: var(--contrast-gap) var(--gap);}
  .contrast-wrap li .name {font-size: 24px; line-height: 39px; font-weight: 500; color: var(--text-main-color); padding: 0 var(--contrast-gap);}
  .contrast-wrap .param {
    padding: 0 var(--contrast-gap); margin-top: var(--param-top); color: var(--text-black);
    display: flex; flex-direction: column; align-items: center;
  }
  .contrast-wrap .select-product {width: 100%; height: var(--select); margin-bottom: var(--gap);}
  .contrast-wrap select.select-product {
    border-radius: var(--radius); border: 1px solid var(--primary-color); padding: 0 var(--contrast-gap) 0 var(--gap);
    -webkit-appearance: none; -moz-appearance: none; appearance: none; text-overflow: ellipsis;
    background: #FFF8F6 url("https://cdn.shopify.com/s/files/1/0550/0524/9633/files/arrow-down.png?v=1679535875") no-repeat right 14px center;
    background-size: 16px;
  }
  .contrast-wrap .text-inherit {color: inherit;}
  .contrast-wrap .more {margin: var(--contrast-gap) auto;}
  .contrast-wrap .more a {color: var(--primary-color);}
  .contrast-wrap .more a:hover {color: var(--normal-color);}
  @media screen and (max-width: 1024px) {
    .product-contrast {
      --param-top: 6px; --repeat: 1fr; --gap: 20px;
    }
    .contrast-wrap {display: block;}
    .contrast-wrap li {width: 100%; margin-bottom: var(--gap);}
    .contrast-wrap li .name {font-size: 18px; line-height: 28px;}
    .contrast-wrap .main-pdt { padding-top: 0; }
    .contrast-product:nth-child(3) {display: none;}
  }

  .reviews {margin-top: var(--content-distance);}
  .image-plate {padding-top:0;padding-bottom:20px;}
  @media screen and (max-width: 1024px) {
    .image-plate {background:none;padding-bottom:24px;}
  }
  .text-mb-20 {margin-bottom: 40px;}
  .tabs-five-video{
    padding-top: var( --video-top);
  }
</style>
<link rel="stylesheet" href="{{ 'pdp-v3-content.min.css' | asset_url }}">
{%- render 'fix-v5-product-style' -%}
<div class="tabs-header flex cal_scroll_target" data-sticky-ready="false">
  <ul class="section-container J-tabs-point">
    <li class="active" data-point="features">{{ 'products.product.feature' | t }}</li>
    {% if section.settings.tabs_five_title != blank%}
      <li data-point="video">{{ section.settings.tabs_five_title }}</li>
    {% endif %}
    <li data-point="specs">{{ 'products.product.specs' | t }}</li>
    <li data-point="faq">{{ 'products.product.faq' | t }}</li>
    {% if section.settings.is_show_reviews_tab %}
      <li data-point="reviews">{{ 'products.product.review' | t }}</li>
    {% endif %}
  </ul>
</div>

<section id="features" class="features gray-background">
  {%- if section.settings.image_plate_pc -%}
    {%- assign m_img_src = section.settings.image_plate_m | image_url: width: 1024 -%}
    {%- unless section.settings.image_plate_m -%}
      {%- assign m_img_src = section.settings.image_plate_pc | image_url: width: 1024 -%}
    {%- endunless -%}
    <figure class="features-summary layer-container image-plate">
      <h2 class="product-title jky-text-2xl">{{ section.settings.image_plate_title }}</h2>
      <img src="{{ section.settings.image_plate_pc | image_url: width: 2000 }}" class="pc" alt="{{ section.settings.image_plate_pc.alt }}" loading="lazy" />
      <img src="{{ m_img_src }}" class="mmb" alt="{{ section.settings.image_plate_title }}" loading="lazy" />
    </figure>
  {%- endif -%}

  <div class="video-text-wrap">
    {%- if section.settings.feature_video_1 or section.settings.feature_video_poster != blank -%}
    <div class="video-img-box layer-container">
      {%- render 'jky-video', video_url: section.settings.feature_video_1, poster: section.settings.feature_video_poster, title: product.title, class: "video-img-box-media", autoplay: false, controls: true, loop: false -%}
    </div>
    {%- endif -%}
    
    <div class="text-box layer-container sp">
    <span class="jky-text-base">{{ section.settings.feature_intro }}</span>
    </div>
  </div>

  <figure class="features-suammry">
    <h2 class="product-title jky-text-2xl">{{ section.settings.featured_text }}</h2>
    <img src="{{ section.settings.suammry_pc | image_url: width: 2000 }}" class="pc" alt="{{ section.settings.suammry_pc.alt }}" loading="lazy">
    <img src="{{ section.settings.suammry_m | image_url: width: 1024 }}" class="mmb" alt="{{ section.settings.suammry_m.alt }}" loading="lazy">
  </figure>

  <figure class="part-1 layer-container">
    <div class="title-icon pc">
      <img class="left-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016" alt="jackery symbol" loading="lazy" />
      <div class="title-box flex items-center justify-center">
        <img class="heading-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_conversion_efficiency-org.svg?v=1678272097" loading="lazy" alt="icon" />
        {{ section.settings.part_1_title | replace: '<p>', '<p class="title jky-text-2xl font-500">' | replace: '<em>', '<em class="main-color">' }}
        <div class="desc jky-text-base">{{ section.settings.part_1_desc }}</div>
      </div>
      <img class="right-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016" alt="jackery symbol" loading="lazy" />
    </div>

    <div class="mmb">
      <figcaption class="title jky-text-2xl font-500 flex items-center justify-center">
        <img class="heading-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_conversion_efficiency-org.svg?v=1678272097" loading="lazy" alt="icon" />
        {{ section.settings.part_1_title | replace: '<em>', '<em class="main-color">' }}
      </figcaption>
    </div>
    
    {% assign part_1_swiper = section.blocks | where: 'type', "part_1_swiper" %}
    {% if part_1_swiper.size > 0 %}
    <div class="card-swiper relative">
      <div class="card-swiper-container relative swiper">
        <div class="swiper-wrapper">
          {% for block in part_1_swiper %}
          <div class="swiper-slide flex flex-col">
            <img class="bms-img" src="{{ block.settings.part_1_img | image_url: width: 2000 }}" alt="{{ block.settings.part_1_img.alt }}" loading="lazy" />
            <div class="desc jky-text-base mmb">{{ block.settings.part_1_text }}</div>
          </div>
          {% endfor %}
        </div>
        <div class="slideshow-pagination relative"></div>
      </div>
    </div>
    {% endif %}
  </figure>


  <figure class="part-2 layer-container">
    <figcaption class="title jky-text-2xl font-500 flex items-center justify-center">
      <img class="heading-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_Fodable_Portable_2.svg?v=1678265585" loading="lazy" alt="icon" />
      {{ section.settings.part_2_title | replace: '<em>', '<em class="main-color">' }}
    </figcaption>

    {% assign part_2_swiper = section.blocks | where: 'type', "part_2_swiper" %}
    {% if part_2_swiper.size > 0 %}
    <div class="card-swiper relative">
      <div class="card-swiper-container relative swiper">
        <div class="swiper-wrapper">
          {% for block in part_2_swiper %}
          <div class="swiper-slide flex flex-col part-2-wrap">
            <img class="bms-img" src="{{ block.settings.part_2_img | image_url: width: 2000 }}" alt="{{ block.settings.part_2_img.alt }}" loading="lazy">
            <div class="text jky-text-base text-mb-20">{{ block.settings.part_2_text }}</div>
          </div>
          {% endfor %}
        </div>
        <div class="slideshow-pagination relative"></div>
      </div>
    </div>
    {% endif %}
  </figure>

  <div class="part-3 layer-container">
    <div class="title-icon pc">
      <img class="left-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016" alt="icon" loading="lazy">
      <div class="title-box flex items-center justify-center">
        <img class="heading-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-design.svg?v=1679880502" loading="lazy" alt="icon" />
        {{ section.settings.part_3_title | replace: '<p>', '<p class="title jky-text-2xl font-500">' | replace: '<em>', '<em class="main-color">' }}
        <div class="desc jky-text-base">{{ section.settings.part_3_desc }}</div>
      </div>
      <img class="right-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016" alt="icon" loading="lazy">
    </div>
  
    <div class="mmb">
      <figcaption class="title jky-text-2xl font-500 flex items-center justify-center">
        <img class="heading-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-design.svg?v=1679880502" loading="lazy" alt="icon" />
        {{ section.settings.part_3_title | replace: '<em>', '<em class="main-color">' }}
      </figcaption>
    </div>
    
    <div class="card-swiper relative">
      <div class="card-swiper-container relative swiper">
        <div class="swiper-wrapper">
          {% assign part_3_swiper = section.blocks | where: 'type', "part_3_swiper" %}
          {% for block in part_3_swiper %}
          <div class="swiper-slide flex flex-col">
            <img src="{{ block.settings.part_3_img | image_url: width: 2000 }}" alt="{{block.settings.part_3_img.alt}}" loading="lazy">
            <div class="text jky-text-base">{{ section.settings.part_3_text }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    
    <p class="desc jky-text-base mmb">{{ section.settings.part_3_desc }}</p>
  </div>

  <figure class="seem-wrap outdoors-wrap">
    <h2 class="product-title jky-text-2xl layer-container font-500 flex items-center justify-center">
      <img class="heading-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_Waterproof-org.svg?v=1678272097" loading="lazy" alt="icon" />
      {{ section.settings.outdoors_title | replace: '<em>', '<em class="main-color">' }}
    </h2>
    <div class="seem-box">
      <div class="image">
        <img src="{{ section.settings.outdoors_scene_1 | image_url: width: 2000 }}" alt="{{section.settings.outdoors_scene_1.alt}}" loading="lazy">
      </div>
      <div class="seem-card layer-container">
        <img src="{{ section.settings.outdoors_scene_2 | image_url: width: 2000 }}" alt="{{section.settings.outdoors_scene_2.alt}}" loading="lazy">
        <div class="text jky-text-base">{{ section.settings.outdoors_scene_2_intro }}</div>
      </div>
    </div>
  </figure>

  <figure class="seem-wrap no-scens">
    <h2 class="product-title jky-text-2xl layer-container font-500 flex items-center justify-center">
      <img class="heading-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-sunlight.svg?v=1679896159" loading="lazy" alt="icon" />
      {{ section.settings.part_5_title | replace: '<em>', '<em class="main-color">' }}
    </h2>
    <div class="seem-box">
      <div class="seem-card layer-container">
        <img src="{{ section.settings.part_scene | image_url: width: 2000 }}" alt="{{section.settings.part_scene.alt}}" loading="lazy">
        <div class="text jky-text-base">{{ section.settings.part_scene_intro }}</div>
      </div>
    </div>
  </figure>
  
  {% comment %} 视频加标题 {% endcomment %}
  {%- if section.settings.tabs_feature_video or section.settings.tabs_video_poster != blank -%}
    <figure class="tabs-five-video layer-container"> 
        <h2 class="product-title jky-text-2xl">{{ section.settings.tabs_video_title }}</h2>
        <div class="video-img-box layer-container">
          {%- render 'jky-video', video_url: section.settings.tabs_feature_video, poster: section.settings.tabs_video_poster, title: product.title, class: "features-media", autoplay: false, controls: true, loop: false -%}
        </div>
    </figure>
  {%- endif -%}

  <div class="need-wrap" rrrr="{{section.settings.hide_help_choose}}">
    {% comment %} 智能选购模块接入 {% endcomment %}
    {% render 'help-to-choose', title: section.settings.help_choose_title, chooseIpImage: section.settings.help_choose_ip, rechargingIcon: section.settings.recharging_icon, savingIcon: section.settings.energy_saving_icon, hide: section.settings.hide_help_choose %}
    
    {% if section.settings.need_image != blank and section.settings.need_heading != blank and section.settings.need_desc != blank %}
    <div class="power-station layer-container">
      <div class="header jky-text-xl font-500">
        <span>{{ section.settings.need_title }}</span>
        <img class="J-header-slide slide-up" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033" alt="power" loading="lazy">
      </div>
      <div class="content">
        <div class="image">
        <img src="{{ section.settings.need_image | image_url: width: 2000 }}" alt="{{section.settings.need_image.alt}}" loading="lazy">
        </div>
        <div class="text">
          <p class="subtitle jky-text-lg font-500">{{ section.settings.need_heading }}</p>
          <div class="desc jky-text-base">
            {{ section.settings.need_desc }}
          </div>
        </div>
      </div>
    </div>
    {% endif %}
  </div>


  <div class="product-contrast J-product-contrast layer-container">
    <h2 class="product-title jky-text-2xl layer-container">Product Comparison</h2>
    <ul class="contrast-wrap"></ul>
  </div>
</section>


<script src="{{ 'pdp-v3-content.min.js' | asset_url }}" defer></script>
{%- assign current_variant = product.selected_or_first_available_variant -%}
<script defer>
;(function () {
  function initProductDetailSp() {
  const productContrastInfo = new ProductContrast({
    currentVariant: {
      "id": {{ current_variant.id | json }},
      "sku": {{ current_variant.sku | json }},
      "availability" : {{ current_variant.available | json }},
      "price" : "{{ current_variant.price | money }}",
      "compare_at_price" : "{{ current_variant.compare_at_price | money }}"
    },
    productVariants: {
      {%- for variant in product.variants -%}
      "{{ variant.id }}": {
        "id": {{ variant.id | json }},
        "sku": {{ variant.sku | json }},
        "availability" : {{ variant.available | json }},
        "price" : "{{ variant.price | money }}",
        "compare_at_price" : "{{ variant.compare_at_price | money }}"
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    },
    helpToChoose: {pageType: 'sp_detail', goodsSolarSkuId: {{ current_variant.id }}, hideRecommended: false}
  })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductDetailSp);
  } else {
    initProductDetailSp();
  }
})();
</script>

