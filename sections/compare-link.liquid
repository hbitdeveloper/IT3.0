{% style %}
    .compare-container {
        width: 1200px;
        margin: 0 auto;
    }
    .compare-link .compare-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 30px 40px;
        background: #faf4ed;
        margin: 120px 0 158px;
        border-radius: 8px;
    }

    .compare-link .compare-content .title {
        color: #1A1A1A;
        font-size: 32px;
        font-weight: 600;
        line-height: 48px;
        flex: 1;
    }
    .compare-link .compare-content a {
        border-radius: var(--theme-btn-border-radius,24px);
        border: 2px solid var(--jds-color-primary);
        color: var(--jds-color-primary);
        font-size: 16px;
        line-height: 16px;
        padding: 15px 22px;
        font-weight: 600;
        text-decoration: none;
    }
    .compare-link .compare-content a:hover {
        background: var(--jds-color-primary);
        color: #fff;
    }
    /* 屏幕 ≤ 1440px */
    @media (max-width: 1439.98px) {
        .compare-container {
            width: 83.333vw;
        }
        .compare-link .compare-content {
            padding: 2.083vw 1.667vw;
            margin: 8.333vw 0 8.889vw;
            border-radius: 0.556vw;
        }
        .compare-link .compare-content .title {
            font-size: 2.222vw;
            line-height: 3.333vw;
            width: 100%;
        }
        .compare-link .compare-content a {
            font-size: 1.111vw;
            padding: 1.042vw 1.528vw;
            border-radius: var(--theme-btn-border-radius,1.667vw);
            line-height: 1.111vw;
        }
    }

        /* 屏幕 ≤ 1024px */
    @media (max-width: 1023.98px) {
        .compare-container {
            width: 100%;
        }
        .compare-link .compare-content {
            padding: 4.000vw 3.200vw;
            margin: 6.400vw;
            flex-direction: column;
            border-radius: 2.133vw;
        }
        .compare-link .compare-content .title {
            font-size: 4.267vw;
            line-height: 5.867vw;
            margin-bottom: 3.200vw;
        }
        .compare-link .compare-content a {
            font-size: 3.733vw;
            padding: 1.867vw 5.067vw;
            border-radius: var(--theme-btn-border-radius,4.800vw);
            line-height: 3.733vw;
        }
    }
{% endstyle %}
<div class="compare-link">
   <div class="compare-container">
        <div class="compare-content">
            <div class="title">{{ section.settings.title | escape}}</div>
            <a
                href="{{ section.settings.link }}"
                data-ga-event="products_compare_4.0_user_clicks"
                data-ga-action="click"
                data-ga-params-module="Text Block_C"
                data-ga-params-position="{{ section.settings.title | escape}}"
                data-ga-params-button_name="{{ section.settings.button_title | escape}}"
                data-ga-params-link="{{ section.settings.link }}"
            >{{ section.settings.button_title | escape}}</a>
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "Compare Link",
        "settings": [
            { "type": "text", "id": "title", "label": "标题", "default": "标题" },
            { "type": "text", "id": "button_title", "label": "按钮名称", "default": "Help You Choose" },
            { "type": "url", "id": "link", "label": "跳转链接" }
        ]
    }
{% endschema %}
