<style>
  .keyword-button-wrap a {
    width: 100%;
    position: relative;
  }
  @media screen and (min-width: 1024px) {
    .keyword-button-wrap a {
      width: fit-content;
    }
  }
</style>

{% if section.settings.button_text != blank %}
  <div
    class="keyword-button-wrap"
    style="background-color:{{section.settings.button_wrap_bg_color}};padding-top:{{section.settings.button_padding_top | escape}}px;padding-bottom:{{section.settings.button_padding_bottom | escape}}px;"
  >
    {% if section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}">
        <button class="quality-button">
          <span>{{ section.settings.button_text | escape }}</span>
          <div>
            <div class="arrow">
              <svg width="12" height="19" xmlns="http://www.w3.org/2000/svg"><path d="M11.292 9.442c0 .199-.036.382-.108.55a1.466 1.466 0 01-.344.477L2.9 18.245c-.254.253-.562.38-.925.38-.247 0-.47-.06-.668-.18a1.402 1.402 0 01-.478-.473 1.24 1.24 0 01-.18-.662c0-.356.14-.675.422-.955l7.098-6.913L1.071 2.53C.79 2.256.649 1.937.649 1.574c0-.246.06-.467.18-.662s.28-.351.478-.467c.199-.117.421-.175.668-.175.363 0 .67.123.924.37l7.941 7.775c.158.15.273.31.344.478.072.167.108.35.108.55z" fill="#FFF" fill-rule="evenodd"/></svg>
            </div>
          </div>
        </button>
      </a>
    {% else %}
      <button class="quality-button">
        <span>{{ section.settings.button_text | escape }}</span>
        <div>
          <div class="arrow">
            <svg width="12" height="19" xmlns="http://www.w3.org/2000/svg"><path d="M11.292 9.442c0 .199-.036.382-.108.55a1.466 1.466 0 01-.344.477L2.9 18.245c-.254.253-.562.38-.925.38-.247 0-.47-.06-.668-.18a1.402 1.402 0 01-.478-.473 1.24 1.24 0 01-.18-.662c0-.356.14-.675.422-.955l7.098-6.913L1.071 2.53C.79 2.256.649 1.937.649 1.574c0-.246.06-.467.18-.662s.28-.351.478-.467c.199-.117.421-.175.668-.175.363 0 .67.123.924.37l7.941 7.775c.158.15.273.31.344.478.072.167.108.35.108.55z" fill="#FFF" fill-rule="evenodd"/></svg>
          </div>
        </div>
      </button>
    {% endif %}
  </div>
{% endif %}

<style>
  .keyword-button-wrap {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 0;
  }

  .keyword-button-wrap .quality-button {
    --quality-button-p: 20px 14px 20px 82px;
    --quality-button-r: 35px;
    --quality-button-text: 26px;
    --quality-button-h: 70px;
    --quality-button-t: 6px;
    --index-arrow-w: 0;
    --index-arrow-h: 0;
    --index-arrow-r: 44px;
    --index-arrow-l: 44px;
    --index-arrow-ml: 9px;
    --index-arrow-svg-w: 14px;
    --index-arrow-hover-w: 48px;
    --index-arrow-hover-h: 48px;

    padding: var(--quality-button-p);
    border-radius: var(--quality-button-r);
    font-size: var(--quality-button-text);
    color: #ffffff;
    display: flex;
    align-items: center;
    background: var(--primary-color);
    height: var(--quality-button-h);
    font-weight: 500;
    border: 2px solid #FFFFFF;
    position: relative;
  }

  .keyword-button-wrap .quality-button::after{
    left: 0;
    top: var(--quality-button-t);
    border-radius: var(--quality-button-r);
    background-color: #ff5000;
    content: " ";
    display: block;
    height: 100%;
    position: absolute;
    width: 100%;
    z-index: -1;
  }

  .keyword-button-wrap .quality-button > div {
    margin-left: var(--index-arrow-l);
  }
  .keyword-button-wrap .quality-button .arrow {
    width: var(--index-arrow-hover-w);
    height: var(--index-arrow-hover-h);
    border-radius: var(--index-arrow-r);
    background: rgba(253, 115, 51, 1);
    align-items: center;
    justify-content: center;
    display: flex;
  }
  .keyword-button-wrap .quality-button:active {
    background: #d25424;
  }

  @media screen and (max-width: 1440px) {
    .keyword-button-wrap .quality-button {
    --quality-button-p: 1.388889vw 0.972222vw 1.388889vw 5.694444vw;
    --quality-button-r: 2.430556vw;
    --quality-button-text: 1.805556vw;
    --quality-button-h: 4.861111vw;
    --quality-button-t: 0.4166666vw;
    --index-arrow-w: 0;
    --index-arrow-h: 0;
    --index-arrow-r: 3.055556vw;
    --index-arrow-l: 3.055556vw;
    --index-arrow-ml: 0.625000vw;
    --index-arrow-svg-w: 0.972222vw;
    --index-arrow-hover-w: 3.333333vw;
    --index-arrow-hover-h: 3.333333vw;
    }
  }
  @media screen and (max-width: 1023px) {
    .keyword-button-wrap {
      padding-left: 5.33333333333333vw;
      padding-right: 5.33333333333333vw;
    }

    .keyword-button-wrap a{
      width: auto;
    }
    .keyword-button-wrap .quality-button {
        --quality-button-p: 3.2vw 2.666667vw 3.2vw 12.266667vw;
        --quality-button-r: 6.533333vw;
        --quality-button-text: 4.8vw;
        --quality-button-h: 12.266667vw;
        --quality-button-t: 1.06666666vw;
        --index-arrow-w: 0;
        --index-arrow-h: 0;
        --index-arrow-r: 8.266667vw;
        --index-arrow-l: 3.866667vw;
        --index-arrow-ml: 1.2vw;
        --index-arrow-svg-w: 1.866667vw;
        --index-arrow-hover-w: 8.266667vw;
        --index-arrow-hover-h: 8.266667vw;
        justify-content: center;
    }
    .keyword-button-wrap .quality-button span {
      display: -webkit-box;
      text-overflow: ellipsis;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
      width: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Keyword Button",
  "settings": [
    {
      "type": "color",
      "id": "button_wrap_bg_color",
      "label": "Button Wrap Background Color",
      "info": "按钮容器背景色",
      "default": "#FFFFFF"
    },
    { "type": "text", "id": "button_text", "label": "Button Text" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    {
      "type": "number",
      "id": "button_padding_top",
      "label": "Button Margin Top",
      "info": "上间距, 单位为px",
      "default": 40
    },
    {
      "type": "number",
      "id": "button_padding_bottom",
      "label": "Button Margin Bottom",
      "info": "下间距, 单位为px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Keyword Button",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
