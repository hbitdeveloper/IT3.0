{%- style -%}
  .section-collection-accessories-anchor{
    position: sticky;
    left: 0;
    top: 0;z-index: 1000;}
  .shadow {
    position: sticky;
    top: 30px;
    height: 10px;
    margin-top: -20px;
    box-shadow: 0px 2px 12px 4px rgba(153,153,153,0.15);
  }
  .section-accessories-anchor {
    background-color: #FFFFFF;
  }
  .tabs-wrap {
    width: 100%;
    padding-top: 33px;
    padding-bottom: 33px;
    background-color: #ffffff;
    justify-content: center;
    gap: 170px;
  }
  .tabs-wrap li {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    cursor: pointer;
    position: relative;
  }
  .tabs-wrap li.active::after {
    display: block;
    content: '';
    width: 98px;
    height: 3px;
    background: var(--primary-color);
    position: absolute;
    left: 50%;
    bottom: -2px;
    transform: translateX(-50%);
  }
  .tabs-wrap li h3 {
    font-size: 24px;
    font-weight: 400;
    color: #999999;
    line-height: 36px;
  }
  .tabs-wrap li img {
    width: 170px;
    height: 100px;
  }
  .tabs-wrap li.active h3 {
    color: #000000;
  }
@media only screen and (max-width: 768px) {
    .section-accessories-anchor {
      background-color: #F5F5F5;
    }
    .tabs-wrap {
      gap: 12vw;
      box-shadow: 0px 2px 1.6vw rgba(153, 153, 153, 0.15);
      padding: 6.666666666666667vw 0;
    }
    .tabs-wrap li.active::after {
      width: 14.8vw;
      height: 0.266666666666667vw;
      bottom: -0.266666666666667vw;
    }
    .tabs-wrap li h3 {
      font-size: 3.2vw;
      line-height: 4vw;
      max-width: 48vw;
      text-align: center;
    }
    .tabs-wrap li img {
      width: 21.333333333333332vw;
      height: 13.333333333333334vw;
    }
}
{%- endstyle -%}

<div class="section-accessories-anchor">
    {% comment %} tabs {% endcomment %}
    <ul class="flex items-center tabs-wrap">
        {% if section.settings.anchor_1_title != blank %}
          <li class="tab-item items-center" data-tab-id="portable_power">
              <h3>{{ section.settings.anchor_1_title | escape}}</h3>
              <img
                  src="{{section.settings.anchor_1_active_image | image_url: width: 170}}"
                  alt="{{section.settings.anchor_1_title}}"
                  data-active="{{section.settings.anchor_1_active_image | image_url: width: 170}}"
                  data-negative="{{section.settings.anchor_1_negative_image | image_url: width: 170}}" loading="lazy"
              />
          </li>
        {% endif %}
        {% if section.settings.anchor_2_title != blank %}
          <li class="tab-item items-center" data-tab-id="solar_panels">
              <h3>{{ section.settings.anchor_2_title | escape}}</h3>
              <img
                  src="{{section.settings.anchor_2_negative_image | image_url: width: 170}}"
                  alt="{{section.settings.anchor_2_title}}"
                  data-active="{{section.settings.anchor_2_active_image | image_url: width: 170}}"
                  data-negative="{{section.settings.anchor_2_negative_image | image_url: width: 170}}" loading="lazy"
              />
          </li>
        {% endif %}
        {% if section.settings.anchor_3_title != blank %}
          <li class="tab-item items-center" data-tab-id="bundles">
            <h3>{{ section.settings.anchor_3_title | escape}}</h3>
            <img
                src="{{section.settings.anchor_3_negative_image | image_url: width: 170}}"
                alt="{{section.settings.anchor_3_title}}"
                data-active="{{section.settings.anchor_3_active_image | image_url: width: 170}}"
                data-negative="{{section.settings.anchor_3_negative_image | image_url: width: 170}}" loading="lazy"
            />
          </li>
        {% endif %}
    </ul>
</div>

{% schema %}
    {
        "name": "Accessories Anchor",
        "class": "section section-collection-accessories-anchor",
        "settings": [
            {"type": "text", "id": "anchor_1_title", "label": "Anchor One Title"},
            {"type": "image_picker", "id": "anchor_1_active_image", "label": "Anchor One Active Image"},
            {"type": "image_picker", "id": "anchor_1_negative_image", "label": "Anchor One Negative Image"},

            {"type": "text", "id": "anchor_2_title", "label": "Anchor Two Title"},
            {"type": "image_picker", "id": "anchor_2_active_image", "label": "Anchor Two Active Image"},
            {"type": "image_picker", "id": "anchor_2_negative_image", "label": "Anchor Two Negative Image"},

            {"type": "text", "id": "anchor_3_title", "label": "Anchor Three Title"},
            {"type": "image_picker", "id": "anchor_3_active_image", "label": "Anchor Three Active Image"},
            {"type": "image_picker", "id": "anchor_3_negative_image", "label": "Anchor Three Negative Image"}
        ]
    }
{% endschema %}
