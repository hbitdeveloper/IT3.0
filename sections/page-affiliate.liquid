{%- render 'pages-banner', blocks: section.blocks, autoplay_speed: section.settings.autoplay_speed, autoplay: section.settings.autoplay -%}
    <div class="section-container affiliate-introduce">
        <div class="affiliate-introduce-main flex">
            <div class="affiliate-info jky-text-sm flex items-center justify-center">{{section.settings.affiliate_introduce_content | newline_to_br}}</div>

            <div class="focus-zoom-container overflow-hidden relative">
                <img class="focus-zoom affiliate-img object-cover" src="{{section.settings.affiliate_introduce_img | image_url: width: 600}}" alt="{{section.settings.affiliate_introduce_img.alt}}" loading="lazy">

                <div class="absolute top-0 bottom-0 left-0 right-0 affiliate-img-text flex items-center justify-center jky-text-lg text-center">
                    {{section.settings.affiliate_introduce_txt | newline_to_br}}
                </div>
            </div>
        </div>

        <div class="affiliate-introduce-steps flex">
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'affiliate_step' %}
                    <div class="step-item flex flex-col items-center">
                        <img src="{{block.settings.banner_icon | image_url: width: 104}}" alt="{{block.settings.banner_icon.alt}}" loading="lazy">
                        <div>
                            <div class="step-title jky-text-xl">{{block.settings.title | escape}}</div>
                            <div class="step-content text-center">{{block.settings.des | newline_to_br}}</div>
                        </div>
                    </div>
                {% endcase %}
            {% endfor %}
        </div>
    </div>

    <div class="affiliate-choose-reasons">
        <div class="section-container">
            <h2 class="affiliate-choose-title jky-text-2xl text-center font-bold">{{section.settings.affiliate_choose_title | newline_to_br}}</h2>

            <div class="affiliate-reason-list flex justify-between">
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'affiliate_choose' %}
                        <div class="affiliate-reason-item focus-zoom-container overflow-hidden relative">
                            {% render 'responsive-image', image: block.settings.banner_pc, mimage: block.settings.banner_mb, image_class: 'focus-zoom object-cover' %}

                            <div class="affiliate-reason-content absolute top-0 left-0 right-0 bottom-0 flex flex-col justify-between items-center">
                                <div>
                                    <h3 class="affiliate-reason-title text-center jky-text-2xl font-bold">{{block.settings.title | escape}}</h3>
                                    <div class="affiliate-reason-text text-center jky-text-lg">{{block.settings.des | newline_to_br}}</div>
                                </div>
                                <img src="{{block.settings.banner_icon | image_url: width: 120}}" alt="{{block.settings.banner_icon.alt}}" loading="lazy">
                            </div>
                        </div>
                    {% endcase %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div>
        {% assign voice_list = section.blocks | where: 'type', "affiliate_case" %}
        <div class="affiliate-case-title h2 text-center mobile-block">{{section.settings.affiliate_case_title}}</div>
        <div data-size="{{voice_list.size}}" class="affiliate-case relative affiliate__case__size" data-autoplay="{{section.settings.case_autoplay}}" data-speed="{{section.settings.case_autoplay_speed}}">
            <div class="voice-banner absolute left-0 right-0 bottom-0 top-0 flex">
                <div class="voice-image-swiper-container overflow-x-hidden">
                    <div class="swiper-wrapper">
                        {% for block in section.blocks %}
                            {% case block.type %}
                                {% when 'affiliate_case' %}
                                <div class="swiper-slide relative">
                                    {% render 'responsive-image', image: block.settings.banner_pc, mimage: block.settings.banner_mb, image_class: 'vocie-banner' %}
                                </div>
                            {% endcase %}
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="voice-list-container relative">
                <h2 class="affiliate-case-title h2 pc-block">{{section.settings.affiliate_case_title}}</h2>

                <div class="voice-list-swiper-container swiper">
                    <div class="swiper-wrapper flex">
                        {% for block in section.blocks %}
                            {% case block.type %}
                                {% when 'affiliate_case' %}
                                <div class="swiper-slide">
                                    <div class="container">
                                        <div class="voice-item-title font-bold jky-text-lg text-overflow-2">
                                            {% if block.settings.link != blank %}
                                                <a class="text-black" href="{{block.settings.link}}">{{block.settings.title | newline_to_br}}</a>
                                            {% else %}
                                                {{block.settings.title | newline_to_br}}
                                            {% endif %}
                                        </div>
                                        <div class="vocie-item-content text-overflow-3 jky-text-base">{{block.settings.des}}</div>

                                        <a class="z-button-fill-middle case-link" href="{{block.settings.link}}" data-analytics-title="{{ block.settings.title | replace: '/n', '' }}">{{block.settings.link_title}} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></a>
                                    </div>
                                </div>
                            {% endcase %}
                        {% endfor %}
                    </div>
                </div>
                <div class="pagination-navigation flex">
                    <div class="slideshow-pagination-voice"></div>

                    <div class="slideshow-navigation flex">
                        <div class="slideshow-navigation-button prev">
                            {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
                        </div>
                        <div class="slideshow-navigation-button next">
                            {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="affiliate-guide relative">
        {% render 'responsive-image', image: section.settings.join_img, mimage: section.settings.m_join_img, image_class: '' %}

        <div class="section-container absolute left-0 right-0 bottom-0 flex flex-col items-center">
            <h2 class="affiliate-guide-title jky-text-xl font-bold text-center">{{section.settings.join_affiliate_title | newline_to_br}}</h2>

            {% if section.settings.join_link_1 != blank %}
                <a class="z-button-big" href="{{section.settings.join_link_1}}">{{section.settings.join_link_1_text}} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></a>
            {% endif %}

            {% if section.settings.join_link_2 != blank %}
                <a class="z-button-big" href="{{section.settings.join_link_2}}">{{section.settings.join_link_2_text}} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></a>
            {% endif %}

            {% if section.settings.join_link_3 != blank %}
                <a class="z-button-big" href="{{section.settings.join_link_3}}">{{section.settings.join_link_3_text}} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></a>
            {% endif %}

            {% if section.settings.join_link_4 != blank %}
                <a class="z-button-big" href="{{section.settings.join_link_4}}">{{section.settings.join_link_4_text}} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></a>
            {% endif %}

            {% if section.settings.join_link_5 != blank %}
                <a class="z-button-big" href="{{section.settings.join_link_5}}">{{section.settings.join_link_5_text}} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></a>
            {% endif %}
        </div>
    </div>

{% schema %}
{
    "name": "Page Affiliate main",
    "class": "section-page-affiliate",
    "settings": [
        {"type": "checkbox", "id": "autoplay", "label": "Bnner Auto-change slides", "default": true},
        {"type": "range", "id": "autoplay_speed", "label": "Bnner Change images every", "default": 7, "min": 5, "max": 10, "step": 1, "unit": "s"},

        {"type": "textarea", "id": "affiliate_introduce_content", "label": "Affiliate Introduce content"},
        {"type": "image_picker", "id": "affiliate_introduce_img", "label": "Affiliate Introduce Background Image"},
        {"type": "textarea", "id": "affiliate_introduce_txt", "label": "Affiliate Introduce title"},

        {"type": "textarea", "id": "affiliate_choose_title", "label": "Affiliate choose title"},

        {"type": "textarea", "id": "affiliate_case_title", "label": "Affiliate case title"},

        {"type": "checkbox", "id": "case_autoplay", "label": "Case card Auto-change slides", "default": true},
        {"type": "range", "id": "case_autoplay_speed", "label": "Case card Change images every", "default": 7, "min": 5, "max": 10, "step": 1, "unit": "s"},

        {"type": "textarea", "id": "join_affiliate_title", "label": "Join Affiliate title"},
        {"type": "url", "id": "join_link_1", "label": "Join Link 1"},
        {"type": "text", "id": "join_link_1_text", "label": "Join Link 1 name"},
        {"type": "url", "id": "join_link_2", "label": "Join Link 2"},
        {"type": "text", "id": "join_link_2_text", "label": "Join Link 2 name"},
        {"type": "url", "id": "join_link_3", "label": "Join Link 3"},
        {"type": "text", "id": "join_link_3_text", "label": "Join Link 3 name"},
        {"type": "url", "id": "join_link_4", "label": "Join Link 4"},
        {"type": "text", "id": "join_link_4_text", "label": "Join Link 4 name"},
        {"type": "url", "id": "join_link_5", "label": "Join Link 5"},
        {"type": "text", "id": "join_link_5_text", "label": "Join Link 5 name"},
        {"type": "image_picker", "id": "join_img", "label": "JOIN US Background Image"},
        {"type": "image_picker", "id": "m_join_img", "label": "JOIN US Mobile Background Image"}
    ],
    "blocks": [
        {
            "type": "page_banner", "name": "Page Banner",
            "settings": [
                {"type": "textarea", "id": "title", "label": "Heading", "default": "Explore Further\nwith Jackery Solar"},
                {"type": "url", "id": "link", "label": "Slide link"},
                {"type": "text", "id": "subtitle", "label": "Slide link subtitle"},
                {"type": "text", "id": "link_text", "label": "Slide link text", "default": "VIEW MORE"},
                {"type": "image_picker", "id": "image", "label": "Image"},
                {"type": "image_picker", "id": "m_image", "label": "mobile Image"},
                {"type": "image_picker", "id": "banner_icon", "label": "Banner Icon Image"}
            ]
        },
        {
            "type": "affiliate_step", "name": "Affiliate Step",
            "settings": [
                {"type": "text", "id": "title", "label": "Affiliate Step title"},
                {"type": "textarea", "id": "des", "label": "Affiliate Step description"},
                {"type": "image_picker", "id": "banner_icon", "label": "Icon Image"}
            ]
        },
        {
            "type": "affiliate_choose", "name": "Affiliate Choose",
            "settings": [
                {"type": "text", "id": "title", "label": "Affiliate Choose title"},
                {"type": "textarea", "id": "des", "label": "Affiliate Choose description"},
                {"type": "image_picker", "id": "banner_icon", "label": "Icon Image"},
                {"type": "image_picker", "id": "banner_pc", "label": "PC Background Image"},
                {"type": "image_picker", "id": "banner_mb", "label": "mobile Background Image"}
            ]
        },
        {
            "type": "affiliate_case", "name": "Affiliate Case",
            "settings": [
                {"type": "text", "id": "title", "label": "Affiliate case title"},
                {"type": "textarea", "id": "des", "label": "Affiliate case description"},
                {"type": "url", "id": "link", "label": "Case link"},
                {"type": "text", "id": "link_title", "label": "Case link text"},
                {"type": "image_picker", "id": "banner_icon", "label": "Icon Image"},
                {"type": "image_picker", "id": "banner_pc", "label": "PC Background Image"},
                {"type": "image_picker", "id": "banner_mb", "label": "mobile Background Image"}
            ]
        }
    ]
}
{% endschema %}