<style>
  /* Mobile 端，标题，副标题字号修复 */
  @media screen and (max-width: 1023px) {
    .olight-banner .five-kwh-banner section .swiper-container .absolute-box .title-box .mini-title .banner-title,
    .olight-banner .five-kwh-banner section .swiper-container .absolute-box .title-box .mini-title .banner-title p {
      font-size: 8.53333333333333vw;
      line-height: normal;
    }
    .olight-banner .five-kwh-banner section .swiper-container .absolute-box .title-box .mini-title .sub-title p {
      line-height: 5.86666666666667vw;
    }
  }
  @media screen and (min-width: 1024px) {
    .olight-banner .five-kwh-banner section .swiper-container .absolute-box .title-box .mini-title .banner-title,
    .olight-banner .five-kwh-banner section .swiper-container .absolute-box .title-box .mini-title .banner-title p {
      font-size: 3.88888888888889vw;
      line-height: normal;
    }
    .olight-banner .five-kwh-banner section .swiper-container .absolute-box .title-box .mini-title .sub-title p {
      line-height: 36px;
    }
  }
  @media screen and (min-width: 1440px) {
    .olight-banner .five-kwh-banner section .swiper-container .absolute-box .title-box .mini-title .banner-title,
    .olight-banner .five-kwh-banner section .swiper-container .absolute-box .title-box .mini-title .banner-title p {
      font-size: 56px;
      line-height: normal;
    }
    .olight-banner .five-kwh-banner section .swiper-container .absolute-box .title-box .mini-title .sub-title p {
      line-height: 36px;
    }
  }
</style>

