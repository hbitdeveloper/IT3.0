{{ 'section-contact-us.min.css' | asset_url | stylesheet_tag }}

{%- assign flag = false -%}
{%- if section.settings.btn_text != blank -%}
    {%- assign flag = true -%}
    <script src="{{ 'snippet-collapsible-select.min.js' | asset_url }}"></script>
{%- endif -%}

<div class="contact-us" id="{{ section.settings.anchor | escape }}" data-handle="{{ section.settings.anchor | escape }}">
    <div class="contact-us-container">
        {% render 'responsive-image', image: section.settings.pc_image, mimage: section.settings.mb_image  %}
        <div class="info">
            <div class="title pc-block">{{ section.settings.pc_title | escape }}</div>
            <div class="title mobile-block">{{ section.settings.mb_title | escape }}</div>
            <div class="rte tips pc-block" > {{ section.settings.pc_tip | replace: '<em>', '<em style="color: var(--jds-color-primary)">' }} </div>
            <div class="rte tips mobile-block" > {{ section.settings.mb_tip | replace: '<em>', '<em style="color: var(--jds-color-primary)">' }} </div>
            {%- if section.settings.btn_text != blank -%}
                <button class="contact-btn"
                    data-module-pc="{{ section.settings.pc_title | escape }}"
                    data-module-mb="{{ section.settings.mb_title | escape }}"
                >{{ section.settings.btn_text | escape }}</button>
            {%- endif -%}
        </div>
    </div>
</div>
{% comment %} 如果按钮配置了文案加载以下数据 {% endcomment %}
{%- if flag == true -%}
    <div class="contact-us-modal"
        data-name_error="{{ section.settings.name_error | escape }}"
        data-email_error="{{ section.settings.email_error | escape }}"
        data-phone_error="{{ section.settings.phone_error | escape }}"
        data-company_error="{{ section.settings.company_error | escape }}"
        data-industry_error="{{ section.settings.industry_error | escape }}"
        data-industry_placeholder="{{ section.settings.industry_placeholder | escape }}"
        data-product_placeholder="{{ section.settings.product_placeholder | escape }}"
        data-message_error="{{ section.settings.message_error | escape }}"
        data-privacy_error="{{ section.settings.privacy_error | escape }}"
        data-success="{{ section.settings.successful | escape }}"
        data-fail="{{ section.settings.fail | escape }}"
    >
        <div class="contact-us-modal-wrapper">
            <div class="contact-us-modal-content">
                <div class="contact-us-modal-header">
                    <span class="modal-title">{{ section.settings.modal_title | escape }}</span>
                    <div class="close-modal">&times;</div>
                </div>
                <div class="contact-us-modal-body">
                    <div class="body-content">
                        <div class="list">
                            <div class="item">
                                <div class="item-label">{{ section.settings.name | escape }}</div>
                                <input id="name" name="name" type="text" maxlength="20" placeholder="{{ section.settings.name_placeholder | escape  }}">
                            </div>
                            <div class="item">
                                <div class="item-label">{{ section.settings.email | escape }}</div>
                                <input id="email" name="email" type="text" maxlength="30" placeholder="{{ section.settings.email_placeholder | escape }}">
                            </div>
                        </div>
                        <div class="list">
                            <div class="item">
                                <div class="item-label">{{ section.settings.phone | escape }}</div>
                                <input id="phone" name="phone" type="text" placeholder="{{ section.settings.phone_placeholder | escape  }}">
                            </div>
                            <div class="item">
                                <div class="item-label">{{ section.settings.company | escape }}</div>
                                <input id="company" name="company" type="text" maxlength="50" placeholder="{{ section.settings.company_placeholder | escape }}">
                            </div>
                        </div>
                        <div class="list">
                            <div class="item item-100">
                                <div class="item-label">{{ section.settings.industry | escape }}</div>
                                <div class="select" id="select" data-placeholder="{{section.settings.industry_placeholder | escape}}">
                                    <div class="choose" id="industry">{{section.settings.industry_placeholder | escape}}</div>
                                    <div class="items"></div>
                                </div>
                            </div>
                        </div>
                        <div class="list">
                            <div class="item item-100">
                                <div class="item-label">{{ section.settings.product | escape }}</div>
                                <collapsible-select class="contact-us-product" placeholder="{{section.settings.product_placeholder | escape}}"></collapsible-select>
                            </div>
                        </div>
                        <div class="list">
                            <div class="item item-100">
                                <div class="item-label">{{ section.settings.message | escape }}</div>
                                <div class="relative">
                                    <textarea id="message" name="message" maxlength="1000" placeholder="{{ section.settings.message_placeholder | escape  }}"></textarea>
                                    <span class="num"><span class="now-number">0</span>/1000</span>
                                </div>
                            </div>
                        </div>
                        <div class="list">
                            <div class="form-check">
                                <input class="form-checkbox" id="subscribe" type="checkbox" name="subscribe">
                                <label class="form-label checkbox-label" id="checkbox-label" for="subscribe"></label>
                                <span class="info">{{ section.settings.privacy }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="button">
                        <button class="submit-btn">{{ section.settings.submit | escape }}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ 'section-contact-us.min.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
    {
        "name": "联系我们",
        "class": "section-contact-us",
        "limit": 1,
        "settings": [
            { "type": "text", "id": "anchor", "label": "版块锚点", "default": "contact-us", "info": "当前模板需要具有唯一值" },
            { "type": "text", "id": "pc_title", "label": "PC标题", "default": "Need Help? Our UK Team is Here for You" },
            { "type": "text", "id": "mb_title", "label": "MB标题", "default": "Need Help? Our UK Team is Here for You" },
            { "type": "richtext", "id": "pc_tip", "label": "PC描述", "default": "<p>Whether you're placing a large order, need technical advice, or have questions about VAT exemption, our dedicated UK support team is ready to assist. Drop us a message, and we'll get back to you within 1-2 working day.</p>" },
            { "type": "richtext", "id": "mb_tip", "label": "MB描述", "default": "<p>Whether you're placing a large order, need technical advice, or have questions about VAT exemption, our dedicated UK support team is ready to assist. Drop us a message, and we'll get back to you within 1-2 working day.</p>" },
            { "type": "text", "id": "btn_text", "label": "按钮文案", "default": "Get Help Now" },
            { "type": "image_picker", "id": "pc_image", "label": "PC图（1312*440）" },
            { "type": "image_picker", "id": "mb_image", "label": "MB图（686*880）" },
            { "type": "header","content": "联系我们", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "modal_title", "label": "标题", "default": "Contact Us", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "name", "label": "名字", "default": "Full name*", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "name_placeholder", "label": "名字占位符", "default": "Please Enter Full name*", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "name_error", "label": "名字提示", "default": "Full name Error", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "email", "label": "邮箱", "default": "Email Address*", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "email_placeholder", "label": "邮箱占位符", "default": "Please Enter Email Address", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "email_error", "label": "邮箱提示", "default": "Email Error", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "phone", "label": "手机号", "default": "Phone Number (Optional)", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "phone_placeholder", "label": "手机号占位符", "default": "Please Enter Phone Number", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "phone_error", "label": "手机号提示", "default": "Phone Number Error", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "company", "label": "公司", "default": "Company / Organisation Name*", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "company_placeholder", "label": "公司占位符", "default": "Please Enter Company / Organisation Name*", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "company_error", "label": "公司提示", "default": "Company / Organisation Name Error", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "industry", "label": "Industry*", "default": "Industry*", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "industry_placeholder", "label": "Industry占位符", "default": "Please Select Your Industry", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "industry_error", "label": "Industry提示", "default": "Industry Error", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "product", "label": "产品名称", "default": "Product Name", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "product_placeholder", "label": "产品名称占位符", "default": "Please Select Your Product", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "message", "label": "留言", "default": "Leave Your Message*", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "message_placeholder", "label": "留言占位符", "default": "Please provide as much detail as possible so we can assist you better.", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "message_error", "label": "留言提示", "default": "Message Error", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "richtext", "id": "privacy", "label": "协议", "default": "<p>I agree to Jackery's</p>", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "privacy_error", "label": "协议提示", "default": "Please Agree Our Privacy", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "successful", "label": "成功提示文案", "default": "Successful", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "fail", "label": "失败提示文案", "default": "Fail", "visible_if": "{{ section.settings.btn_text != blank }}" },
            { "type": "text", "id": "submit", "label": "提交按钮", "default": "Submit", "visible_if": "{{ section.settings.btn_text != blank }}" }
        ],
        "presets": [
            {
                "name": "联系我们",
                "settings": {
                    "pc_title": "Need Help? Our UK Team is Here for You",
                    "mb_title": "Need Help? Our UK Team is Here for You",
                    "pc_tip": "<p>Whether you're placing a large order, need technical advice, or have questions about VAT exemption, our dedicated UK support team is ready to assist. Drop us a message, and we'll get back to you within 1-2 working day.</p>",
                    "mb_tip": "<p>Whether you're placing a large order, need technical advice, or have questions about VAT exemption, our dedicated UK support team is ready to assist. Drop us a message, and we'll get back to you within 1-2 working day.</p>",
                    "btn_text": "Get Help Now"
                }
            }
        ]
    }
{% endschema %}
