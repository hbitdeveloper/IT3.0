<style>
    .advertising-image .advertising-body{
        text-align: center;
        margin: 0 auto;
        width: 1248px;
    }
    .advertising-image h2{
        margin-bottom: 30px;
        line-height: 48px;
        font-size: 40px;
        padding: 0 40px;
    }
    .advertising-image .advertising-image{
        border-radius: 12px;
        width: 100%;
        height: 430px;
        object-fit: cover;
    }
    @media screen and (max-width: 1024px) {
      .advertising-image .advertising-body{
        width: 100%;
        padding: 10.6666667vw 5.33333333vw 26.66666667vw;
      }
      .advertising-image h2{
        margin-bottom: 8vw;
        line-height: 8vw;
        font-size: 6.4vw;
        padding: 0 5.3333333vw;
      }
      .advertising-image .advertising-image{
        border-radius: 12px;
        width: 100%;
        height: 145.6vw;
        object-fit: cover;
      }
    }
    @media screen and (min-width: 1024px) and (max-width: 1440px) {
        .advertising-image .advertising-body{
            width: 100%;
        }
        .advertising-image h2{
            margin-bottom: 1.66666666666667vw;
            line-height: 48px;
            font-size: 40px;
            padding: 0 40px;
        }
        .advertising-image .advertising-image{
            border-radius: 12px;
            width: 100%;
            object-fit: cover;
        }
    }
</style>
<section class="advertising-image">
    <div class="advertising-body">
        <h2 class="font-600 text-#1A1A1A">
            {{ section.settings.title | newline_to_br }}
        </h2>
        <a href="{{ section.settings.advertising_link }}" target="{% if section.settings.open_new %}_blank{% else %}_self{% endif %}" rel="advertising image">
            {% render 'responsive-image',
                    image: section.settings.advertising_pc_image,
                    mimage: section.settings.advertising_mb_image,
                    image_class: 'advertising-image'
            %}
        </a>
    </div>
</section>
{% schema %}
{
  "name": "Advertising Image",
  "class": "section-photovolatic section-photovolatic-advertising-image",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Find out what users think about the Jackery \n All in One Solar Generator for Home"
    },
    {
      "type": "image_picker",
      "id": "advertising_pc_image",
      "label": "Advertising PC Image"
    },
    {
      "type": "image_picker",
      "id": "advertising_mb_image",
      "label": "Advertising Mobile Image"
    },
    {
      "type": "url",
      "id": "advertising_link",
      "label": "Advertising Image Link"
    },
    {
      "type": "checkbox",
      "id": "open_new",
      "label": "Open Link New Target？？",
      "default": false
    }
  ]
}
{% endschema %}
