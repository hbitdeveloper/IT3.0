
{% comment %} no activity {% endcomment %}
<section class="w-full flex-center px-40 py-100 lg:px-0 lg:j-py-100 xl:a-py-100" style="background-color: {{ section.settings.section_background_color }}" data-membership-no-activity>
  <div
    class="
      w-full flex-between flex-col rounded-16 px-40 pt-54 pb-64
      lg:flex-row lg:j-w-1200 lg:j-min-h-320 lg:j-rounded-8 lg:j-px-64 lg:j-py-30
      xl:a-w-1200 xl:a-min-h-320 xl:a-rounded-8 xl:a-px-64 xl:a-py-30 bg-white
      {{ section.settings.page_width }}
    "
    data-animation-dom
  >
    <div class="flex-1 mb-40 lg:mb-0 lg:j-px-50 xl:a-px-50">
      <h3 class="text-#FB7127 font-700 text-44 leading-60 lg:j-text-48 lg:j-leading-72 xl:a-text-48 xl:a-leading-72">{{ section.settings.section_title | newline_to_br }}</h3>
      <span
        data-href="{{ section.settings.section_button_link }}"
        class="!hidden !lg:inline-flex membership-price-button membership-price-highlight-button min-w-335 lg:j-mt-42 lg:j-min-w-160 xl:a-mt-42 xl:a-min-w-160 cursor-pointer"
        data-ga-event="membership_price_user_clicks"
        data-ga-action="click"
        data-ga-params-module="{% if section.settings.section_title != blank %}{{ section.settings.section_title }}{% else %}Waiting{% endif %}"
        data-ga-params-button_name="{{ section.settings.section_button_text | escape }}"
        data-ga-params-status="{% if customer.id != blank %}logged_in{% else %}tourist{% endif %}"
      >
        <span class="line-clamp-1">{{ section.settings.section_button_text | escape }}</span>
      </span>
    </div>
    {% comment %} image {% endcomment %}
    {% render 'responsive-image',
      image: section.settings.section_img,
      mimage: section.settings.section_img,
      image_class: 'w-430 h-300 lg:j-w-368 lg:j-h-258 xl:a-w-368 xl:a-h-258 object-cover'
    %}
    <span
      data-href="{{ section.settings.section_button_link }}"
      class="!inline-flex !lg:hidden membership-price-button membership-price-highlight-button min-w-335 mt-40 lg:mt-0 lg:j-mt-42 lg:j-min-w-160 xl:a-mt-42 xl:a-min-w-160 cursor-pointer"
      data-ga-event="membership_price_user_clicks"
      data-ga-action="click"
      data-ga-params-module="{% if section.settings.section_title != blank %}{{ section.settings.section_title }}{% else %}Waiting{% endif %}"
      data-ga-params-button_name="{{ section.settings.section_button_text | escape }}"
      data-ga-params-status="{% if customer.id != blank %}logged_in{% else %}tourist{% endif %}"
    >
      <span class="line-clamp-1">{{ section.settings.section_button_text | escape }}</span>
    </span>
  </div>
</section>

{% schema %}
  {
    "name": "Membership Price Inactive",
    "class": "section-membership-price section-membership-price-no-activity",
    "settings": [
      {
        "type": "select",
        "id": "page_width",
        "options": [
          {
            "value": "section_container",
            "label": "版心/1200px"
          },
          {
            "value": "section_container_lg",
            "label": "大版心/1312px"
          }
        ],
        "default": "section_container",
        "label": "组件宽度"
      },
      {
        "type": "color_background",
        "id": "section_background_color",
        "label": "Section Background Color",
        "default": "#FCF7F1"
      },
      {
        "type": "textarea",
        "id": "section_title",
        "label": "Section Title",
        "default": "Stay Tuned for the Next Sale!"
      },
      {
        "type": "text",
        "id": "section_button_text",
        "label": "Section Button Text",
        "default": "Go Shopping"
      },
      {
        "type": "url",
        "id": "section_button_link",
        "label": "Section Button Url"
      },
      {
        "type": "image_picker",
        "id": "section_img",
        "label": "Section Image"
      }
    ]
  }
{% endschema %}