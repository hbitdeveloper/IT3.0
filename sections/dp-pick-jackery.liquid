{% comment %} 日本防灾日 dp-pick-jackery组件 {% endcomment %}
{% schema %}
  {
    "name": "DP Pick Jackery",
    "tag": "section",
    "class": "dp-pick-jackery",
    "settings": [
      {
        "type": "image_picker",
        "id": "titleImgPC",
        "label": "Title Image(PC)"
      },
      {
        "type": "image_picker",
        "id": "titleImgMB",
        "label": "Title Image(MB)"
      },
  
      {
        "type": "image_picker",
        "id": "subTitleImgPC",
        "label": "SubTitle Image(PC)"
      },
      {
        "type": "image_picker",
        "id": "subTitleImgMB",
        "label": "SubTitle Image(MB)"
      },
  
      {
        "type": "text",
        "id": "description",
        "label": "Description"
      },
  
      {
        "type": "image_picker",
        "id": "contentImage",
        "label": "Content Image"
      }
    ]
  }
  {% endschema %}

  <div class="dp-pick-jackery-box">
    <div class="pick-section">
      <div class="pick-title dp-animation">
        {% render 'responsive-image', image: section.settings.titleImgPC, mimage: section.settings.titleImgMB %}
      </div>
      <div class="dp-animation">
        <div class="dp-content">
          <div class="content-title dp-animation">
            {% render 'responsive-image', image: section.settings.subTitleImgPC, mimage: section.settings.subTitleImgMB %}
          </div>
          <div class="content-text dp-animation">
            {{ section.settings.description }}
          </div>
          <div class="content-img dp-animation">
            <img
              class="scenes-img lazy"
              src="{{ section.settings.contentImage | image_url: width: 1280 }}"
              alt="{{ section.settings.contentImage.alt | escape }}"
            >
          </div>
        </div>
      </div>
      
    </div>
  </div>