{%- style -%}
  .keyword-banner {
    width: 100%;
    padding-bottom: 5.3125vw;
  }
  .keyword-banner .kb-pc-banner-container {
    height: 38.9063vw;
    width: 100%;
    overflow: hidden;
  }
  .keyword-banner  .kb-pc-banner-container .kb-pc-block {
    transition: transform .5s ease;
  }
  .keyword-banner  .kb-pc-banner-container .kb-pc-block {
    transform: scale(1.02);
  }

  .kb-pc-block {
    display: block;
  }
  .kb-mobile-block {
    display: none;
  }

  .keyword-banner .slide-banner {
    height: 37.5vw;
    width: 100%;
    object-fit: cover;
  }
  .keyword-banner .swiper-banner-foot {
    height: 8.85vw;
    background: #fff;
  }
  .keyword-banner .keyword-banner-container {
    height: 40vw;
    {% comment %} bottom: 1.0417vw; {% endcomment %}
    top: 6.4583vw;
    left: 50%;
    transform: translateX(-50%);
  }
  .keyword-banner .brand-left-icon {
    width: 3.645vw;
  }
  .keyword-banner .brand-right-icon {
    width: 4.5vw;
  }
  .keyword-banner .banner-icon {
    height: 5.55vw;
  }
  .keyword-banner .keyword-banner-content {
    text-align: right;
    align-items: flex-end;
    transition: all .3s ease-in-out;
    animation-delay: .3s;
    -webkit-animation-delay: .3s;
  }
  .keyword-banner .slideshow-pagination {
    align-items: center;
    bottom: -3.4vw;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    left: 0;
    position: absolute;
    transition: opacity .3s;
    width: 100%;
    z-index: 10;
  }
  .keyword-banner-content .jky-text-3xl {
    color: #fff;
    margin-bottom: 1.25vw;
  }
  .keyword-banner-content .h4 {
    color: #fff;
    margin-bottom: 1.25vw;
  }
  @media screen and (max-width: 768px) {
    .keyword-banner  .kb-pc-banner-container {
      height: 0;
    }
    .keyword-banner .slide-banner {
      height: 118vw;
      width: 100%;
      object-fit: cover;
    }
    .keyword-banner .swiper-banner-foot {
      height: 27vw;
    }
    .keyword-banner .keyword-banner-container {
      height: 130.1333vw;
      top: 8.6667vw;
    }

    .keyword-banner .brand-left-icon {
      width: 7.6vw;
    }
    .keyword-banner .brand-right-icon {
      width: 10.5vw;
      right: -5vw;
      bottom: -4vw;
    }
    .keyword-banner .banner-icon {
      height: 12vw;
    }
    .keyword-banner .keyword-banner-content {
      max-width: 80vw;
      transform: translateY(1.0417vw);
    }
    .keyword-banner .keyword-banner-content .h4 {
      font-size: 3.8vw;
      line-height: 4.8vw;
      margin-bottom: 1.8vw;
    }
    .keyword-banner .keyword-banner-content .jky-text-3xl {
      margin-bottom: 3vw;
    }
    .keyword-banner .has-subtitle .keyword-banner-content .jky-text-3xl {
      margin-bottom: 0;
    }
    .keyword-banner .slideshow-pagination {
      bottom: -8.6vw;
    }

    .kb-pc-block {
      display:none
    }
    .kb-mobile-block {
      display: block;
    }
  }
  
  .keyword-banner .slide-banner {
    height: {{ section.settings.pc_height }}px;
  }

  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .keyword-banner .slide-banner {
      height: calc(({{ section.settings.pc_height }}/1440)*100vw);
    }
  }

  @media screen and (max-width: 1024px) {
    .keyword-banner .slide-banner {
      height: calc(({{ section.settings.mb_height }}/750)*100vw);
    }
  }

{%- endstyle -%}
<div class="relative">
  <div class="kb-pc-banner-container">
    <img
      class="kb-pc-block slide-banner"
      src="{{section.settings.image | image_url: width: 3000}}"
      alt="{{section.settings.title | escape}}"
      fetchpriority="high"
    >
  </div>
  <img
    class="kb-mobile-block slide-banner"
    src="{{section.settings.m_image | image_url: width: 750}}"
    alt="{{section.settings.title | escape}}"
    fetchpriority="high"
  >
  <div class="swiper-banner-foot"></div>

  <div class="keyword-banner-container index-container absolute {% if section.settings.subtitle %}has-subtitle{% endif %}">
    <img
      class="absolute left-0 brand-left-icon"
      src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016"
      alt="icon" loading="lazy"
    >
    <img
      class="absolute right-0 bottom-0 brand-right-icon"
      src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016"
      alt="icon" loading="lazy"
    >
    <img
      class="banner-icon absolute left-0 bottom-0"
      src="{{section.settings.banner_icon | img_url: 'master'}}"
      alt="icon" loading="lazy"
    >
    <div class="keyword-banner-content absolute right-0 top-0 flex flex-col">
      {% if section.settings.title != blank %}
        <div
          class="jky-text-3xl font-bold"
          style="{% if section.settings.color != blank %}color: {{section.settings.color}} {% endif %}"
        >
          {{ section.settings.title | newline_to_br }}
        </div>
      {% endif %}
      {% if section.settings.subtitle %}
        <div
          class="h4 "
          style="{% if section.settings.color != blank %}color: {{section.settings.color}} {% endif %}"
        >
          {{ section.settings.subtitle | newline_to_br }}
        </div>
      {% endif %}

      {% if section.settings.link != blank %}
        <a class="z-button-big" href="{{section.settings.link}}">
          {{ 'general.action_text.view_more' | t }}
          <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Keyword Banner",
  "class": "keyword-banner",
  "settings": [
    { "type": "textarea", "id": "title", "label": "Heading", "default": "Explore Further\nwith Jackery Solar" },
    { "type": "textarea", "id": "subtitle", "label": "Heading subtitle" },
    { "type": "url", "id": "link", "label": "Slide link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "m_image", "label": "Mobile Image" },
    { "type": "image_picker", "id": "banner_icon", "label": "Banner Icon Image" },
    { "type": "range", "id": "pc_height", "label": "PC自定义高度", "default": 720,  "min": 320,"max": 1200,"step": 10, "unit": "px" },
    { "type": "range", "id": "mb_height", "label": "MB自定义高度", "default": 890,  "min": 640,"max": 1500,"step": 10, "unit": "px" },
  ],
  "presets": [
    {
      "name": "Keyword Banner",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
