<style>
  .v5-support-train-modal .privacy {
    color: #333;
  }
  .v5-support-train-modal .privacy:before {
    background: #FD5000;
  }
  .v5-support-train-modal .privacy a {
    color: #333;
    text-decoration: underline;
  }

  /* iPad Air 横屏（Landscape） */
  @media only screen and (min-width: 1178px) and (max-width: 1182px) and (orientation: landscape) and (-webkit-min-device-pixel-ratio: 2) {
    .jky-ipad-text,
    .jky-ipad-text .lg\:text-\[1rem\] {
      font-size: max(15px, 1rem) !important;
    }
  }


  @media only screen and (max-width: 1024px){
    .v5-support-train-modal .jky-ipad-text.privacy{
      font-size: 0.7rem;
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1023.98px) {
    .v5-support-train-modal .y-checkbox input{
      margin-top: 0.1rem;
    }
  }

</style>

{%- assign CR = 'US' -%}
{%- case shop.id -%}
  {%- when 60738666677 -%}
    {%- assign CR = 'CA' -%}
  {%- when 57272172741, 64525172955, 75730714917 -%}
    {%- assign CR = 'DE' -%}
  {%- when 56981160124 -%}
    {%- assign CR = 'GB' -%}
  {%- when 69013700929 -%}
    {%- assign CR = 'ES' -%}
  {%- when 69511053598 -%}
    {%- assign CR = 'FR' -%}
  {%- when 69224431898 -%}
    {%- assign CR = 'IT' -%}
  {%- when 73356443969 -%}
    {%- assign CR = 'EU' -%}
  {%- when 65060929623 -%}
    {%- assign CR = 'NL' -%}
  {%- when 10015375438, 56124375224 -%}
    {%- assign CR = 'JP' -%}
  {%- when 68984701213 -%}
    {%- assign CR = 'AU' -%}
  {%- when 60455780502 -%}
    {%- assign CR = 'KR' -%}
  {%- when 74688758050 -%}
    {%- assign CR = 'HK' -%}
  {%- when 74914496810 -%}
    {%- assign CR = 'MO' -%}
  {% else %}
    {% assign CR = 'US' %}
{%- endcase -%}

<div
  data-train-in-modal-root
  data-train-in-country="{{ CR }}"
  data-train-in-upload-max="{{ section.settings.upload_max_count | default: 3 }}"
  data-train-in-upload-max-mb="{{ section.settings.upload_max_size_mb | default: 10 }}"
  data-train-in-upload-exceed-text="{{ section.settings.upload_exceed_error | escape }}"
  data-train-in-upload-size-text="{{ section.settings.upload_size_error | escape }}"
  data-train-in-upload-fail-text="{{ section.settings.upload_fail_error | escape }}"
  data-train-in-uploading-text="{{ section.settings.uploading_text | escape }}"
  data-train-in-select-one-text="{{ section.settings.select_one_error | escape }}"
  data-train-in-upload-tips-text="{{ section.settings.upload_tips_error | escape }}"
  data-train-in-email-format-text="{{ section.settings.email_format_error | escape }}"
  data-train-in-phone-format-text="{{ section.settings.phone_format_error | escape }}"
  class="v5-support-train-modal jky-ipad-text"
>
  
  {%- if shop.metafields.custom.train_in != blank -%}
    <script type="application/json" data-train-in-json>{{ shop.metafields.custom.train_in.value | json }}</script>
  {%- endif -%}
  <div class="flex items-center w-full justify-center py-[0.4667rem] lg:pt-[2.5rem]">
    <button
      type="button"
      class="text-white font-bold cursor-pointer px-[0.8rem] py-[0.5333rem] bg-[#FF5000] lg:text-[1.75rem] text-[0.8rem] lg:px-[1.5rem] lg:py-[0.625rem]"
      data-train-in-open
    >
      {{ section.settings.open_button_label | escape }}
    </button>
  </div>

  <div class="fixed inset-0 bg-[rgba(0,0,0,0.5)] z-[10000]" data-train-in-overlay hidden></div>
  <div
    class="fixed inset-0 z-[10001] flex w-screen items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    data-train-in-modal
    hidden
  >
    <div
      class="rounded bg-[#F5F5F5] min-w-[20.3125rem] p-[0.9375rem] max-h-[90vh] lg:p-[1.875rem] lg:w-[56.25rem] lg:max-h-[50rem] overflow-y-auto"
      role="document"
    >
      <div class="flex justify-between items-center">
        <div
          class="flex items-center cursor-pointer min-w-[3.125rem] lg:min-w-[6.25rem]"
          data-train-in-prev
          aria-label="{{ section.settings.prev_button_label | escape }}"
        >
          <span
            class="flex items-center text-[#333] font-bold text-[0.8125rem] lg:text-[1.25rem]"
            data-train-in-prev-label
          >
            {%- render 'icon-arrow',
              width: 16,
              height: 16,
              color: '#333',
              class: 'pl-[0.25rem] w-4 h-4 rotate-180 font-normal'
            -%}
            {{- section.settings.prev_button_label | escape -}}
          </span>
        </div>
        <div class="font-black text-[#ff5000] text-[0.8125rem] lg:text-[1.25rem]">
          {{ section.settings.modal_title | escape }}
        </div>
        <div
          class="min-w-[3.125rem] min-h-[1.875rem] flex items-center justify-center cursor-pointer lg:min-w-[6.25rem] lg:min-h-[1.875rem]"
          data-train-in-close
          aria-label="{{ section.settings.close_aria_label | escape }}"
        >
          <div class="text-[#333]  text-[1.125rem] lg:w-[1.875rem] lg:h-[1.0625rem] lg:text-[1.875rem] lg:ml-[3.75rem]">
            <svg
              class="w-4 h-4 lg:w-full lg:h-full"
              viewBox="0 0 1024 1024"
              width="200"
              height="200"
            >
              <path d="M576 512l277.333333 277.333333-64 64-277.333333-277.333333L234.666667 853.333333 170.666667 789.333333l277.333333-277.333333L170.666667 234.666667 234.666667 170.666667l277.333333 277.333333L789.333333 170.666667 853.333333 234.666667 576 512z" fill="#444444"></path>
            </svg>
          </div>
        </div>
      </div>

      <div class="pt-[0.5rem] my-[2rem] mx-auto lg:max-w-[31.25rem]" data-train-in-content-wrap>
        <div class="font-bold text-[#333] text-[0.875rem] lg:text-[1.75rem]" data-train-in-step></div>
        <div
          class="font-medium text-[#333] max-w-[15.625rem] my-[0.4688rem] text-[0.8125rem] leading-[1rem] lg:max-w-[31.25rem] lg:text-[1rem] lg:leading-[1.5rem]"
          data-train-in-subtitle
        ></div>

        <div class="mt-[0.625rem] max-h-[15.625rem] lg:max-h-[18.75rem] overflow-y-auto" data-train-in-options></div>

        <div data-train-in-upload hidden>
          <div class="text-[0.8rem] lg:text-[1.2rem] text-[#333]">
            {{ section.settings.upload_intro_text | escape }}
          </div>
          <div
            class="hidden mt-[0.5rem] text-[0.75rem] lg:text-[1rem] text-[#333]"
            data-train-in-upload-loading
          ></div>
          <label class="w-fit px-[10px] h-[50px] border-[3px] border-dotted border-[#333333] cursor-pointer relative mt-[20px] flex items-center justify-center">
            <input
              class="absolute inset-0 opacity-0 cursor-pointer"
              type="file"
              accept="image/*"
              multiple
              data-train-in-file
            >
            <span class="text-[0.8rem] lg:text-[1.2rem] text-[#333]">
              {{- section.settings.upload_file_label | escape -}}
            </span>
          </label>
          <div class="mt-[0.3125rem]" data-train-in-files></div>
        </div>

        <div class="flex justify-end items-center cursor-pointer" data-train-in-next-row hidden>
          <div class="text-[#333] font-bold lg:text-[1.25rem]" data-train-in-next>
            {{ section.settings.next_button_label | escape -}}
            {%- render 'icon-arrow',
              width: 16,
              height: 16,
              color: '#333',
              class: 'pl-[0.25rem] w-4 h-4 pt-[0.25rem] font-normal'
            %}
          </div>
        </div>

        <div
          class="flex flex-col justify-around items-center h-[15.625rem] lg:h-[24.875rem]"
          data-train-in-result
          hidden
        >
          <div class="font-medium text-center text-[0.875rem] leading-[1.0625rem] max-w-[20.3125rem] lg:text-[1.125rem] lg:leading-[1.75rem] lg:max-w-[40.625rem]">
            {{ section.settings.gift_text | escape }}
          </div>
          <div class="relative w-[9.375rem] h-[6.25rem] lg:w-[23.75rem] lg:h-[14.375rem]">
            <img
              class="w-full h-full absolute"
              src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/5ca1ff71795576af1865ddc33fda1394.png?v=1694502329"
              alt=""
            >
            <span
              class="absolute font-black text-[#f0efe7] lg:bottom-0 bottom-2 right-[0.8125rem] lg:right-[1.25rem] text-[2rem] lg:text-[5rem] leading-[1.5]"
              data-train-in-price
              style="text-shadow:0px 3px 0px #5c5c5c, 0px 1px 7px #685e5e;"
            ></span>
          </div>
          <button
            type="button"
            class="bg-[#ff5000] text-[#fff] font-bold px-[1.5rem] py-[0.625rem] lg:text-[1.75rem] lg:py-[0.625rem] lg:px-[1.5rem] text-[1rem]"
            data-train-in-accept
          >
            {{ section.settings.accept_button_label | escape }}
          </button>
        </div>

        <form class="w-full px-[0.875rem] lg:px-[3.375rem]" data-train-in-form hidden novalidate>
          <div class="font-bold text-[#333] text-center text-[0.875rem] my-[0.3125rem] lg:text-[1.25rem] lg:my-[0.625rem]">
            {{ section.settings.info_title | escape }}
          </div>
          <div class="flex justify-between items-center gap-[0.75rem]">
            <div class="w-full">
              <input
                class="w-full h-[2rem] border-solid border text-[0.875rem] leading-[0.8125rem] lg:h-[3rem] lg:px-[1.875rem]  lg:text-[1.25rem] lg:leading-[1.5rem] text-[#333] px-[0.5rem]"
                type="text"
                name="first_name"
                data-train-in-input
                placeholder="{{ section.settings.placeholder_first_name | escape }}*"
                maxlength="32"
              >
              <div class="h-[0.8125rem] leading-[0.6rem] lg:h-6 lg:leading-[1.5rem]">
                <span class="hidden text-[0.5rem] lg:text-[0.875rem] text-[#ff0000] jky-ipad-text" data-train-in-error="first_name">
                  {{- section.settings.error_text | escape -}}
                </span>
              </div>
            </div>
            <div class="w-full">
              <input
                class="w-full h-[2rem] border-solid border text-[0.875rem] leading-[0.8125rem] lg:h-[3rem] lg:px-[1.875rem]  lg:text-[1.25rem] lg:leading-[1.5rem] text-[#333] px-[0.5rem]"
                type="text"
                name="last_name"
                data-train-in-input
                placeholder="{{ section.settings.placeholder_last_name | escape }}*"
                maxlength="32"
              >
              <div class="h-[0.8125rem] leading-[0.6rem] lg:h-6 lg:leading-[1.5rem]">
                <span class="hidden text-[0.5rem] lg:text-[0.875rem] text-[#ff0000] jky-ipad-text" data-train-in-error="last_name">
                  {{- section.settings.error_text | escape -}}
                </span>
              </div>
            </div>
          </div>
          <div class="lg:flex justify-between items-center gap-[0.75rem]">
            <div class="w-full">
              <input
                class="w-full h-[2rem] border-solid border text-[0.875rem] leading-[0.8125rem] lg:h-[3rem] lg:px-[1.875rem]  lg:text-[1.25rem] lg:leading-[1.5rem] text-[#333] px-[0.5rem]"
                type="email"
                name="email"
                data-train-in-input
                placeholder="{{ section.settings.placeholder_email | escape }}*"
                value="{% if customer and customer.email %}{{ customer.email | escape }}{% endif %}"
              >
              <div class="h-[0.8125rem] leading-[0.6rem] lg:h-6 lg:leading-[1.5rem]">
                <span class="hidden text-[0.5rem] lg:text-[0.875rem] text-[#ff0000] jky-ipad-text" data-train-in-error="email">
                  {{- section.settings.error_text | escape -}}
                </span>
              </div>
            </div>
            <div class="w-full">
              <input
                class="w-full h-[2rem] border-solid border text-[0.875rem] lg:h-[3rem] lg:px-[1.875rem]  lg:text-[1.25rem] lg:leading-[1.5rem] text-[#333] px-[0.5rem]"
                type="text"
                name="mobilePhone"
                data-train-in-input
                placeholder="{{ section.settings.placeholder_phone | escape }}*"
              >
              <div class="h-[0.8125rem] leading-[0.6rem] lg:h-6 lg:leading-[1.5rem]">
                <span class="hidden text-[0.5rem] lg:text-[0.875rem] text-[#ff0000] jky-ipad-text" data-train-in-error="mobilePhone">
                  {{- section.settings.error_text | escape -}}
                </span>
              </div>
            </div>
          </div>
          <div>
            <input
              class="w-full h-[2rem] border-solid border text-[0.875rem] lg:h-[3rem] lg:px-[1.875rem]  lg:text-[1.25rem] lg:leading-[1.5rem] text-[#333] px-[0.5rem]"
              type="text"
              name="detailAddressEx"
              data-train-in-input
              placeholder="{{ section.settings.placeholder_detail_address | escape }}*"
            >
            <div class="h-[0.8125rem] leading-[0.6rem] lg:h-6 lg:leading-[1.5rem]">
              <span
                class="hidden text-[0.5rem] lg:text-[0.875rem] text-[#ff0000] jky-ipad-text"
                data-train-in-error="detailAddressEx"
              >
                {{- section.settings.error_text | escape -}}
              </span>
            </div>
          </div>
          <div class="flex justify-between items-center gap-[0.75rem]">
            <div class="w-full">
              <input
                class="w-full h-[2rem] text-[0.875rem] border-solid border lg:h-[3rem] lg:px-[1.875rem]  lg:text-[1.25rem] lg:leading-[1.5rem] text-[#333] px-[0.5rem]"
                type="text"
                name="provinceNameEx"
                data-train-in-input
                placeholder="{{ section.settings.placeholder_state | escape }}*"
              >
              <div class="h-[0.8125rem] leading-[0.6rem] lg:h-6 lg:leading-[1rem]">
                <span
                  class="hidden text-[0.5rem] lg:text-[0.875rem] text-[#ff0000] jky-ipad-text"
                  data-train-in-error="provinceNameEx"
                >
                  {{- section.settings.error_text | escape -}}
                </span>
              </div>
            </div>
            <div class="w-full">
              <input
                class="w-full h-[2rem] text-[0.875rem] border-solid border lg:h-[3rem] lg:px-[1.875rem]  lg:text-[1.25rem] lg:leading-[1.5rem] text-[#333] px-[0.5rem]"
                type="text"
                name="cityNameEx"
                data-train-in-input
                placeholder="{{ section.settings.placeholder_city | escape }}*"
              >
              <div class="h-[0.8125rem] leading-[0.6rem] lg:h-6 lg:leading-[1rem]">
                <span class="hidden text-[0.5rem] lg:text-[0.875rem] text-[#ff0000] jky-ipad-text" data-train-in-error="cityNameEx">
                  {{- section.settings.error_text | escape -}}
                </span>
              </div>
            </div>
            <div class="w-full">
              <input
                class="w-full h-[2rem] text-[0.875rem] border-solid border lg:h-[3rem] lg:px-[1.875rem]  lg:text-[1.25rem] lg:leading-[1.5rem] text-[#333] px-[0.5rem]"
                type="text"
                name="zipCodeEx"
                data-train-in-input
                placeholder="{{ section.settings.placeholder_zip | escape }}*"
              >
              <div class="h-[0.8125rem] leading-[0.6rem] lg:h-6 lg:leading-[1rem]">
                <span class="hidden text-[0.5rem] lg:text-[0.875rem] text-[#ff0000] jky-ipad-text" data-train-in-error="zipCodeEx">
                  {{- section.settings.error_text | escape -}}
                </span>
              </div>
            </div>
          </div>

          <div class="text-[#333] text-[0.8125rem] mt-[0.6rem] leading-[0.875rem] lg:text-[1rem] lg:leading-[1.25rem]">
            {{ section.settings.tips_text | escape }}
          </div>
          <div class="text-[#333] text-[0.8125rem] leading-[0.875rem] lg:text-[1rem] lg:leading-[1.25rem]">
            {{ section.settings.tips1_text | escape }}
          </div>

          <label class="y-checkbox mt-[0.3125rem] lg:mt-[0.625rem] flex cursor-pointer">
            <input type="checkbox" name="isCheck" data-train-in-input style="accent-color: #FF5000;">
            <span class="!lg:text-[1.25rem] text-[#999] privacy pl-[0.5rem] jky-ipad-text">
              {{- section.settings.terms_text -}}
            </span>
          </label>
          <div class="h-[0.8125rem] leading-[0.8125rem] lg:h-6 lg:leading-[1.5rem]">
            <span class="hidden text-[0.5rem] lg:text-[0.875rem] text-[#ff0000] jky-ipad-text" data-train-in-error="isCheck">
              {{- section.settings.error_text | escape -}}
            </span>
          </div>

          <div class="flex items-center justify-center mt-[0.5rem] lg:mt-[1.5625rem]">
            <button
              type="submit"
              class="font-bold flex items-center text-[#fff] bg-[#FF5000] px-[0.4375rem] py-[0.1875rem] text-[0.875rem] lg:px-[1.875rem] lg:py-[0.3125rem] lg:text-[1.5rem]"
              data-train-in-submit
            >
              <span class="hidden" data-train-in-submit-loading>
                {%- render 'icon-loading-new' -%}
              </span>
              {{ section.settings.submit_button_label | escape }}
            </button>
          </div>
        </form>

        <div
          class="flex flex-col items-center justify-center mt-[1.875rem] mb-[1.25rem] lg:mt-[1.25rem]"
          data-train-in-success
          hidden
        >
          <div class="text-center font-black flex items-center justify-center text-[#000] text-[0.9375rem] mb-[0.8125rem] lg:text-[1.25rem] lg:mb-[1.625rem]">
            {% render 'icon-correct' -%}
            {{- section.settings.submit_success_title | escape }}
          </div>
          <div class="font-semibold text-[#000] w-full leading-[1.25rem] text-[0.8125rem] lg:leading-[1.875rem] lg:text-[1.25rem] text-center">
            {{ section.settings.submit_success_info | escape }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'aws-sdk-2.1046.0.min.js' | asset_url }}" defer></script>
<script src="{{ 'section-v5-support-train-modal.min.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5 Support Train Modal",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "open_button_label",
      "label": "打开弹窗按钮文案",
      "default": "START train-IN"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "弹窗标题",
      "default": "Jackery train-in"
    },
    {
      "type": "text",
      "id": "close_aria_label",
      "label": "关闭按钮无障碍文案",
      "default": "Close"
    },
    {
      "type": "text",
      "id": "prev_button_label",
      "label": "上一步按钮文案",
      "default": "Previous"
    },
    {
      "type": "text",
      "id": "next_button_label",
      "label": "下一步按钮文案",
      "default": "Next"
    },
    {
      "type": "text",
      "id": "select_one_error",
      "label": "未选择选项提示",
      "default": "Please select one option."
    },
    {
      "type": "text",
      "id": "upload_tips_error",
      "label": "第8步缺少上传/选择提示",
      "default": "Please upload photos of your current product."
    },
    {
      "type": "textarea",
      "id": "upload_intro_text",
      "label": "上传提示文案",
      "default": "Please upload photos of your current product."
    },
    {
      "type": "text",
      "id": "upload_file_label",
      "label": "上传按钮文案",
      "default": "Upload File"
    },
    {
      "type": "number",
      "id": "upload_max_count",
      "label": "上传数量上限",
      "default": 3
    },
    {
      "type": "number",
      "id": "upload_max_size_mb",
      "label": "上传大小上限(MB)",
      "default": 10
    },
    {
      "type": "text",
      "id": "upload_exceed_error",
      "label": "超过数量提示",
      "default": "You can upload up to 3 images."
    },
    {
      "type": "text",
      "id": "upload_size_error",
      "label": "超过大小提示",
      "default": "Please upload files smaller than 10MB."
    },
    {
      "type": "text",
      "id": "upload_fail_error",
      "label": "上传失败提示",
      "default": "Upload failed. Please try again."
    },
    {
      "type": "text",
      "id": "uploading_text",
      "label": "上传中提示",
      "default": "Uploading..."
    },
    {
      "type": "textarea",
      "id": "gift_text",
      "label": "结果页提示文案",
      "default": "You will receive a gift card for:"
    },
    {
      "type": "text",
      "id": "accept_button_label",
      "label": "接受按钮文案",
      "default": "Accept"
    },
    {
      "type": "text",
      "id": "info_title",
      "label": "表单标题",
      "default": "Your Information"
    },
    {
      "type": "text",
      "id": "placeholder_first_name",
      "label": "First Name 占位符",
      "default": "First Name"
    },
    {
      "type": "text",
      "id": "placeholder_last_name",
      "label": "Last Name 占位符",
      "default": "Last Name"
    },
    {
      "type": "text",
      "id": "placeholder_email",
      "label": "Email 占位符",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "placeholder_phone",
      "label": "Phone 占位符",
      "default": "Phone Number"
    },
    {
      "type": "text",
      "id": "placeholder_detail_address",
      "label": "Address 占位符",
      "default": "Street Address"
    },
    {
      "type": "text",
      "id": "placeholder_state",
      "label": "State 占位符",
