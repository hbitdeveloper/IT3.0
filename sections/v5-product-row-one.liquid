  {%- if section.settings.installment_type == 'splitit' and shop.id == 55005249633 -%}
    <script>
      (function () {
        function initSplitit() {
          if(window.splitit_script_loaded) return;
          window.splitit_script_loaded = true;
          var s = document.createElement('script');
          var splitit_url = 'https://cdn.shopify.com/proxy/6da4c7acd8056454fa088038cdfbba4216fa9acf2c292a9c3a4905a58e39a8e1/web-components.splitit.com/upstream.js?shop=jackeryuk.myshopify.com&sp-cache-control=cHVibGljLCBtYXgtYWdlPTkwMA';
          s.type = 'text/javascript';
          s.async = true;
          s.src = splitit_url;

          var x = document.getElementsByTagName('script')[0];
          x.parentNode.insertBefore(s, x);
          x.defer = true;
        }

        if(window.attachEvent) {
          window.attachEvent('onload', initSplitit);
        } else {
          window.addEventListener('load', initSplitit, false);
        }
      })()
    </script>
  {%- endif -%}

  <v5-product-row-one
    sss="{{ shop.id }}"
    section-id="{{ section.id }}"
    class="{% if section.settings.related_v_tabs and section.settings.belongs_to != blank and request.design_mode == false %}!hidden{% endif %} flex flex-col w-full section-padding px-4 lg:px-0"
    {% if section.settings.anchor != blank %}
      anchor-target="{{ section.settings.anchor | escape}}"
    {% endif %}
    {% if section.settings.belongs_to != blank %}
      belongs-to-target="{{ section.settings.belongs_to | escape }}"
    {% endif %}
    data-countdown-hide-section="{{ section.settings.countdown_hide_section_when_off }}"
    style="
      --pc-bg-color:{{ section.settings.pc_bg_color | default: '#FFFFFF' }};
      --mb-bg-color:{{ section.settings.mb_bg_color | default: '#FFFFFF' }};
      --main-color:{{ section.settings.main_color | default: '#93161B' }};
      {{ style }}"
  >
    {% comment %} 模块标题、副标题 {% endcomment %}
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="w-full h-fit mx-auto lg:w-[75rem] flex flex-col items-center justify-center gap-y-6 lg:gap-y-4 mb-6 lg:mb-10">
        {% comment %} 模块标题 {% endcomment %}
        {%- if section.settings.title != blank -%}  
          <h2 class="w-full text-center text-[1.75rem] lg:text-5xl un-ja-text text-[#242F20] font-semibold leading-[1.1]" style="color:{{ section.settings.title_color | default: '#242F20' }}">{{ section.settings.title | newline_to_br }}</h2>
        {%- endif -%}
        {% comment %} 副标题 {% endcomment %}
        {%- if section.settings.subtitle != blank -%}
          <div class="subtitle w-full flex items-center justify-center">
            <p class="w-full text-center font-semibold text-sm lg:text-xl un-ja-text" style="color:{{ section.settings.subtitle_color | default: '#242F20' }}">{{ section.settings.subtitle | newline_to_br }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% comment %} 倒计时 {% endcomment %}
    {%- if show_countdown -%}
      <div class="w-full mx-auto lg:w-[75rem] flex flex-col lg:flex-row items-center justify-center mb-6 lg:mb-10 gap-4 lg:gap-6" data-countdown-row>
        {%- if section.settings.countdown_title != blank -%}
          <h2 class="w-fit text-center font-semibold text-white leading-[1.1] un-ja-text relative">
            {%- if section.settings.countdown_title_bg_img != blank -%}
              <img
                class="countdown-title-bg-img"
                style="
                  --countdown-title-bg-img-offset-pc-x:{{ section.settings.countdown_title_bg_img_offset_pc_x }};
                  --countdown-title-bg-img-offset-mb-x:{{ section.settings.countdown_title_bg_img_offset_mb_x }};
                  --countdown-title-bg-img-offset-pc-y:{{ section.settings.countdown_title_bg_img_offset_pc_y }};
                  --countdown-title-bg-img-offset-mb-y:{{ section.settings.countdown_title_bg_img_offset_mb_y }};
                "
                src="{{ section.settings.countdown_title_bg_img | image_url: height: 54 }}"
                width="auto" height="auto"
                alt="" loading="lazy"
              >
            {%- endif -%}
            <span class="countdown-title-text relative z-[1]" style="color:{{ section.settings.countdown_title_color | default: '#FFFFFF' }};">{{ section.settings.countdown_title | escape }}</span>
          </h2>
        {%- endif -%}
        <div
          class="w-fit max-w-full flex flex-wrap items-center shrink-0"
          data-count-down
          data-ends-in-text="{{ section.settings.ends_in_text | escape }}"
          data-countdown-label-text="{{ section.settings.countdown_label_text | escape }}"
          data-shopify-time="{{ 'now' | date: "%Y/%m/%d %H:%M:%S" }}"
          data-begin-time="{{ section.settings.begin_time_str | escape }}"
          data-end-time="{{ section.settings.end_time_str | escape }}"
        >
          <div class="w-[3.25rem] h-[3.25rem] lg:w-16 lg:h-16 skeleton mr-7"></div>
          <div class="w-[3.25rem] h-[3.25rem] lg:w-16 lg:h-16 skeleton mr-7"></div>
          <div class="w-[3.25rem] h-[3.25rem] lg:w-16 lg:h-16 skeleton mr-7"></div>
          <div class="w-[3.25rem] h-[3.25rem] lg:w-16 lg:h-16 skeleton"></div>
        </div>
      </div>
    {%- endif -%}

    {%- if product_items.size > 0 -%}
      <ul class="w-full mx-auto lg:w-[75rem] flex flex-col gap-y-6">
        {%- for block in product_items -%}
          {%- liquid
            assign curr_product = block.settings.product
            assign curr_variant_id = block.settings.variant_id
            assign variant = curr_product.variants | where: "id", curr_variant_id | first
            if variant == blank
              assign variant = curr_product.selected_or_first_available_variant
            endif

            # SPU 标题
            assign display_title = curr_product.title
            if block.settings.product_title != blank
              assign display_title = block.settings.product_title
            endif

            # 图片
            assign base_img = variant.featured_image | default: curr_product.featured_image
            assign p_img = base_img
            assign m_img = base_img

            if block.settings.pc_product_image != blank
              assign p_img = block.settings.pc_product_image
            endif
            if block.settings.mb_product_image != blank
              assign m_img = block.settings.mb_product_image
            endif

            # 价格、划线价
            assign price = variant.price | default: 1999
            assign compare_at_price = variant.compare_at_price | default: price

            # 划线价
            if compare_at_price < price
              assign compare_at_price = price
            endif

            # 设置了产品折扣价，则以 产品折扣价 为准
            assign price_value = block.settings.price_value | plus: 0
            if price_value > 0
              assign price = price_value | times: 100
            else
              # 开启了自动折扣
              if settings.open_auto_discount_price and settings.display_auto_discount_price_in_activity_page
                assign auto_discount_price = variant.metafields.custom.auto_discount_price | times: 1
                if auto_discount_price > 0 and auto_discount_price < variant.price
                  assign price = auto_discount_price
                endif
              endif
            endif
          -%}
          
          {%- if variant.available or request.design_mode -%}
            {%- assign product_layout = block.settings.product_layout -%}
            <li class="w-full h-auto mx-auto {% if product_layout == 'l_img_r_text' %} lg:pl-[37.5rem] {% else %} lg:pr-[37.5rem] {% endif %} flex flex-col lg:flex-row items-center bg-white relative" data-card-item>
              <div class="w-full h-[14.25rem] lg:h-auto lg:absolute {% if product_layout == 'l_img_r_text' %} left-0 {% else %} right-0 {% endif %} top-0 bottom-0 lg:w-[37.5rem] shrink-0">
                <a href="{{ curr_product.url }}?variant={{ variant.id }}" class="focus-zoom-container flex w-full h-full overflow-hidden">
                  {%- render 'diff-end-img',
                    class: 'focus-zoom w-full h-full object-cover',
                    style: '',
                    anchor: '',
                    pc_img: p_img,
                    mb_img: m_img,
                    pc_img_width: 600,
                    mb_img_width: 343,
                    placeholder_name: 'hero-apparel-1',
                    alt: p_img.alt | default: 'product image',
                    load_scene: block.settings.load_scene | default: 'default',
                  -%}
                </a>
                {% comment %} 折扣角标 {% endcomment %}
                {%- if section.settings.show_discount_tag and compare_at_price > price -%}
                  {%- liquid
                    assign discount_amount = ''
                    assign discount_percent = ''
                    
                    # 1. 基础差价计算
                    assign diff_price = compare_at_price | minus: price
                    assign calc_percent = diff_price | times: 100 | divided_by: compare_at_price | floor

                    # 2. 自动折扣逻辑覆盖 (Metafields 优先级最高)
                    if price_value <= 0 and settings.open_auto_discount_price and settings.display_auto_discount_price_in_activity_page
                      assign auto_amount = variant.metafields.custom.auto_discount_amount
                      assign auto_percent = variant.metafields.custom.auto_discount_percentage
                      
                      if auto_amount != blank and auto_amount != 0
                        assign diff_price = auto_amount
                      endif
                      if auto_percent != blank and auto_percent != 0
                        assign calc_percent = auto_percent | floor
                      endif
                    endif

                    # 3. 最终格式化赋值
                    if section.settings.discount_tag_display_style == 'amount'
                      # 抹除分分位（保留到百位，如 1234 -> 1200），然后转为货币格式
                      assign discount_amount = diff_price | divided_by: 100 | floor | times: 100 | money_without_trailing_zeros
                    else
                      assign discount_percent = calc_percent
                    endif

                    assign pc_discount_img = section.settings.pc_discount_img
                    assign mb_discount_img = section.settings.mb_discount_img | default: pc_discount_img
                  -%}

                  {%- if discount_amount != blank or discount_percent != blank -%}
                    <div class="absolute left-0 top-3 flex items-center [transform:translateZ(0)] [backface-visibility:hidden] [will-change:transform]"> 
                      <div style="width:var(--discount-img-width); padding-left:var(--discount-margin-left); padding-top:var(--discount-margin-top);">
                        {%- if pc_discount_img != blank or mb_discount_img != blank -%}
                          <img class="hidden lg:block w-fit h-auto object-contain absolute left-0 top-0 z-0 max-w-none" src="{{ pc_discount_img | image_url: width: 689 }}" style="width:var(--discount-img-width);" alt="discount img" width="auto" height="auto">
                          <img class="block lg:hidden w-fit h-auto object-contain absolute left-0 top-0 z-0 max-w-none" src="{{ mb_discount_img | image_url: width: 686 }}" style="width:var(--discount-img-width);" alt="discount img" width="auto" height="auto">
                        {%- endif -%}

                        {%- if section.settings.discount_tag_display_style == 'amount' -%}
                          {%- if discount_amount != blank -%}
                            <span class="relative z-[1] font-semibold text-white text-sm lg:text-base whitespace-nowrap un-ja-text" style="color:{{ section.settings.discount_color | default: '#FFFFFF' }};">{{ section.settings.discount_amount_display_style | replace: '()', discount_amount }}</span>
                          {%- endif -%}
                        {%- else -%}
                          {%- if discount_percent != blank -%}
                            <span class="relative z-[1] font-semibold text-white text-sm lg:text-base whitespace-nowrap un-ja-text" style="color:{{ section.settings.discount_color | default: '#FFFFFF' }};">{{ section.settings.discount_percent_display_style | replace: '()', discount_percent }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                      {%- if variant.metafields.custom.discount_tag_time != blank -%}
                        <span class="ml-2 md:ml-[0.625rem] px-[0.625rem] h-[1.875rem] leading-[1.875rem] bg-[#000000]/25 text-white text-[1rem] font-medium rounded" style="margin-top:var(--discount-margin-top);">
                            {{ variant.metafields.custom.discount_tag_time }}
                        </span>
                      {%- endif -%} 
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
              <div class="w-full flex-1 flex flex-col items-start justify-center px-4 py-6 lg:p-10 relative">
                {% comment %} 产品标题、副标题 {% endcomment %}
                <div class="flex flex-col mb-6 lg:mb-10">
                  {%- assign product_tag = block.settings.product_tag | default: variant.metafields.custom.variant_tag -%}
                  {%- if product_tag != blank -%}
                    <span class="text-[var(--main-color)] font-semibold text-sm lg:text-base mb-2 un-ja-text">{{ product_tag | escape }}</span>
                  {%- endif -%}

                  <a href="{{ curr_product.url }}?variant={{ variant.id }}" class="text-[#242F20] font-semibold text-base lg:text-2xl line-clamp-2 un-ja-text" title="{{ display_title | escape }}">{{ display_title | escape }}</a>
                  {%- if block.settings.product_selling_info != blank -%}
                    <div class="text-[#242F20]/90 text-sm lg:text-base mt-3 lg:mt-5 line-clamp-2 lg:line-clamp-1 un-ja-text">{{ block.settings.product_selling_info | newline_to_br }}</div>
                  {%- else -%}
                    {%- if variant.metafields.custom.product_features_info != blank -%}
                      <div class="text-[#242F20]/90 text-sm lg:text-base mt-3 lg:mt-5 line-clamp-2 lg:line-clamp-1 un-ja-text">
                        {{ variant.metafields.custom.product_features_info | metafield_tag | strip_html }}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                </div>

                {% comment %} 赠品 {% endcomment %}
                {%- if section.settings.show_priority == 'gift' and block.settings.gift_product != blank -%}
                  {%- liquid
                    assign curr_gift_product = block.settings.gift_product
                    assign curr_gift_variant_id = block.settings.gift_variant_id
                    assign gift_variant = curr_gift_product.variants | where: "id", curr_gift_variant_id | first
                    if gift_variant == blank
                      assign gift_variant = curr_gift_product.selected_or_first_available_variant
                    endif

                    # 标题
                    assign gift_display_title = curr_gift_product.title
                    if gift_variant.title != 'Default Title' and gift_variant.title != blank
                      assign gift_display_title = gift_variant.title
                    endif

                    if block.settings.gift_product_title != blank
                      assign gift_display_title = block.settings.gift_product_title
                    endif

                    # 图片
                    assign gift_base_img = gift_variant.featured_image | default: curr_gift_product.featured_image
                    assign gift_product_image = gift_base_img

                    if block.settings.gift_product_image != blank
                      assign gift_product_image = block.settings.gift_product_image
                    endif
                  -%}
                  <jds-tooltip placement="top-end" class="w-full mb-5 lg:max-h-[5.25rem]">
                    <div slot="tooltip-trigger" class="w-full flex items-center justify-start px-4 py-3 lg:pl-3 lg:pr-6 bg-[#F5F5F3]">
                      {%- if section.settings.gift_icon != blank -%}
                        <img class="w-9 h-9 object-contain shrink-0" src="{{ section.settings.gift_icon | image_url: width: 72 }}" width="36" height="36" alt="" loading="lazy">
                      {%- else -%}
                        {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-9 h-9 object-cover shrink-0' }}
                      {%- endif -%}
                      <div class="w-[12.5rem] lg:w-[24.25rem] flex flex-col px-4 gap-y-2">
                        <p class="font-semibold text-sm lg:text-base text-[var(--main-color)] un-ja-text">{{ section.settings.gift_text | default: 'FREE GIFT' }}</p>
                        <p class="text-[#242F20] text-xs lg:text-base line-clamp-1 un-ja-text" title="{{ gift_display_title | escape }}">{{ gift_display_title | escape }}</p>
                      </div>
                      <img class="w-10 h-10 lg:w-[3.75rem] lg:h-[3.75rem] object-contain shrink-0" src="{{ gift_product_image | image_url: width: 120 }}" width="60" height="60" alt="" loading="lazy">
                    </div>
                    <div slot="" class="p-6 max-w-[18.75rem] relative" style="box-shadow:0 0 24px rgba(0,0,0,0.1)">
                      <button class="appearance-none bg-transparent flex lg:hidden items-center justify-center absolute right-6 top-3 w-10 h-10 ">
                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                          <path d="M13.6172 13.6167L26.3831 26.3827" stroke="#242F20" stroke-width="1.70213"/>
                          <path d="M26.3828 13.6167L13.6169 26.3827" stroke="#242F20" stroke-width="1.70213"/>
                        </svg>
                      </button>
                      <img class="w-[14.125rem] h-[8.75rem] object-contain" src="{{ gift_product_image | image_url: width: 422 }}" width="226" height="140" alt="" loading="lazy">
                      <h2 class="text-[#242F20] font-semibold text-base mt-2 un-ja-text">{{ gift_display_title | escape }}</h2>
                      {%- if block.settings.gift_product_desription != blank -%}
                        <div class="text-black/65 text-sm mt-3 un-ja-text">
                          {{ block.settings.gift_product_desription | escape }}
                        </div>
                      {%- elsif gift_variant.metafields.custom.product_features_info != blank -%}
                        <div class="text-black/65 text-sm mt-3 un-ja-text">
                          {{ gift_variant.metafields.custom.product_features_info | metafield_tag | strip_html }}
                        </div>
                      {%- endif -%}
                    </div>
                  </jds-tooltip>
                {% comment %} 加价购 {% endcomment %}
                {%- elsif section.settings.show_priority == 'price_up' and variant != blank -%}
                  <div class="w-full flex items-center justify-start border border-solid border-[#E8E8E5] mb-5 p-3 gap-x-2.5 lg:p-4" data-sku-id="{{ variant.id }}" data-bundle-product>
                    <div class="w-[3.75rem] h-[3.75rem] lg:w-[4.6875rem] lg:h-[4.6875rem] skeleton"></div>
                    <div class="flex-1 flex flex-col gap-y-3">
                      <div class="w-4/5 lg:w-3/5 h-5 skeleton"></div>
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-x-1">
                          <div class="w-12 h-5 skeleton"></div>
                          <div class="w-12 h-5 skeleton"></div>
                        </div>
                        <div class="w-[5.5rem] lg:w-[5.75rem] h-7 skeleton"></div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}

                {% comment %} 税费 {% endcomment %}
                {%- if block.settings.tax_fee_info != blank -%}
                  <div class="w-full flex item-start mb-3 font-semibold text-sm lg:text-base">
                    {{ block.settings.tax_fee_info }}
                  </div>
                {%- endif -%}

                {% comment %} 价格、折扣码 {% endcomment %}
                <div class="w-full flex flex-col lg:flex-row item-start gap-y-2 lg:items-center justify-between mb-6">
                  <div class="flex items-baseline gap-x-1">
                    {%- if section.settings.from_text != blank -%}
                      <span class="text-sm lg:text-base text-[var(--main-color)] un-ja-text">{{ section.settings.from_text | escape }}</span>
                    {%- endif -%}
                    <span class="font-semibold text-xl lg:text-[1.75rem] text-[var(--main-color)] un-ja-text">{{ price | money_without_trailing_zeros }}</span>
                    {%- if compare_at_price > price -%}
                      <span class="text-black/65 line-through text-xs lg:text-sm un-ja-text">{{ compare_at_price | money_without_trailing_zeros }}</span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.code_value != blank -%}
                    <div
                      class="flex items-center gap-x-2 cursor-pointer"
                      data-code="{{ block.settings.code_value | escape  }}"
                      data-copy-success="{{ section.settings.copy_success | escape }}"
                      data-copy-checkout="{{ section.settings.copy_checkout }}"
                      data-sku-id="{{ variant.id }}"
                      data-code-wrap
                    >
                      <span class="text-sm lg:text-base text-[var(--main-color)] un-ja-text">{{ section.settings.use_code_text | default: 'Use Code' }}:</span>
                      <span class="font-semibold text-sm lg:text-base flex items-center gap-x-2 text-[var(--main-color)] un-ja-text">
                        <span>{{ block.settings.code_value | escape }}</span>
                        <svg class="w-4 h-4 lg:w-5 lg:h-5" width="100" height="100" viewBox="0 0 100 100" fill="none">
                          <g clip-path="url(#clip0_15867_72333)">
                            <path d="M100 0H0V100H100V0Z" fill="none"/>
                            <path d="M14 78V23H22V78C22 80.2091 23.7909 82 26 82H71.5V90H26C19.3726 90 14 84.6274 14 78Z" fill="var(--main-color)"/>
                            <path d="M66.1992 11C66.6398 11 67.0624 11.1749 67.374 11.4863L85.5137 29.626C85.8252 29.9376 85.9999 30.3602 86 30.8008V74.6338C86 76.2906 84.6569 77.6338 83 77.6338H30C28.3431 77.6338 27 76.2906 27 74.6338V14C27 12.3431 28.3431 11 30 11H66.1992ZM62 34H79L62 17V34Z" fill="var(--main-color)"/>
                          </g>
                          <defs>
                            <clipPath id="clip0_15867_72333">
                              <rect width="100" height="100" fill="none"/>
                            </clipPath>
                          </defs>
                        </svg>
                      </span>
                    </div>
                  {%- endif -%}
                </div>

                {% comment %} 按钮 {% endcomment %}
                <div class="w-full flex items-center">
                  {%- liquid
                    assign pc_btn_type = section.settings.pc_show_btn_type
                    assign mb_btn_type = section.settings.mb_show_btn_type
                  -%}

                  {%- capture btn_class -%}
                    flex-1 appearance-none flex items-center justify-center px-2 lg:px-6 h-[2.125rem] text-[0.875rem] lg:h-12 lg:text-[1.25rem] un-ja-text leading-[2.125rem] lg:leading-[3rem] text-white font-semibold bg-[var(--main-color)]
                  {%- endcapture -%}

                  <a href="{{ curr_product.url }}?variant={{ variant.id }}" class="{{ btn_class }} {% if pc_btn_type != 'shop_now_and_add_to_cart' %} lg:hidden {% endif %} {% if mb_btn_type != 'shop_now_and_add_to_cart' %} hidden lg:flex {% endif %}">
                    <span class="w-fit line-clamp-1">{{ section.settings.shop_now_text | default: 'Shop Now' | escape }}</span>
                  </a>
                  <button
                    class="jky-v5-button appearance-none bg-transparent px-2 h-[2.125rem] lg:px-3 lg:h-12 flex items-center justify-center border border-solid border-[var(--main-color)] {% if pc_btn_type != 'shop_now_and_add_to_cart' %} lg:hidden {% endif %} {% if mb_btn_type != 'shop_now_and_add_to_cart' %} hidden lg:flex {% endif %}"
                    style="--border-color:var(--main-color);"
                    data-sku-id="{{ variant.id }}"
                    data-sku-warranty-info="{{ variant.metafields.custom.sku_warranty_info.value | default: variant.metafields.custom.sku_warranty_info | escape }}"
                    data-add-to-cart-btn
                  >
                    {% render 'v5-icon-cart', stroke_width: 1, class: 'text-[var(--main-color)] w-[1.75rem] h-[1.75rem] lg:w-10 lg:h-10' %}
                  </button>
                  <button
                    class="jky-v5-button {{ btn_class }} {% if pc_btn_type == 'shop_now_and_add_to_cart' %} lg:hidden {% endif %} {% if mb_btn_type == 'shop_now_and_add_to_cart' %} hidden lg:flex {% endif %}"
                    data-sku-id="{{ variant.id }}"
                    data-sku-warranty-info="{{ variant.metafields.custom.sku_warranty_info.value | default: variant.metafields.custom.sku_warranty_info | escape }}"
                    data-add-to-cart-btn
                  >
                    <span class="w-fit line-clamp-1">{{ section.settings.add_to_cart_text | default: 'Add To Cart' | escape }}</span>
                  </button>
                </div>

                {% comment %} 分期付款 {% endcomment %}
                {%- assign price_num = price | plus: 0.0 -%}
                {%- if section.settings.installment_type == 'custom' -%}
                  {%- if section.settings.installment_text != blank -%}
                    {% if price_num < 20000 %}
                      {% comment %} 直接除以 100.0 强制保留小数 {% endcomment %}
                      {% assign dividend = price_num | divided_by: 100.0 %}
                      {% assign divisor = 4 %}
                    {% else %}
                      {% comment %} 先通过 times 1.1229 得到含息总额，再除以 100 {% endcomment %}
                      {% assign dividend = price_num | times: 1.1229 | divided_by: 100.0 | plus: 0.0 %}
                      {% assign divisor = 18.0 %}
                    {% endif %}

                    {% comment %} 向上取整 {% endcomment %}
                    {% assign per_affirm = dividend | divided_by: divisor | ceil %}

                    <div 
                      class="flex items-baseline text-black/65 text-xs lg:text-sm gap-x-2 mt-3 un-ja-text"
                    >
                      {%- assign per_affirm_price = per_affirm | times:100 | money_without_trailing_zeros -%}
                      {%- assign per_affirmplaceholder = "{Installment_per}" -%}
                      <span>{{ section.settings.installment_text | replace: per_affirmplaceholder, per_affirm_price }}</span>
                      {%- if section.settings.installment_img != blank -%}
                        <img class="w-[1.875rem] h-[0.75rem] lg:w-[3.375rem] lg:h-[1.3125rem] object-contain shrink-0" src="{{ section.settings.installment_img | image_url: width: 108 }}" width="54" height="21" alt="Installment" loading="lazy">
                      {%- else -%}
                        {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-[1.875rem] h-[0.75rem] lg:w-[3.375rem] lg:h-[1.3125rem] object-contain shrink-0' }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- elsif section.settings.installment_type == 'klarna' -%}
                  <div style="--fk-klarna-height: {{ section.settings.fk_klarna_height }}rem;--fk-klarna-height-mb: {{ section.settings.fk_klarna_height_mb }}rem;" class="row-klarna mt-3">
                    <klarna-placement data-key="credit-promotion-badge" data-locale="{{ data_local }}" data-purchase-amount="{{ price_num }}"><span></span></klarna-placement>
                  </div>
                {%- elsif section.settings.installment_type == 'paypal' -%}
                  <div
                    style="--fk-paypal-height: {{ section.settings.fk_paypal_height }}rem;--fk-paypal-height-mb: {{ section.settings.fk_paypal_height_mb }}rem;"
                    class="product-info_block mt-3 w-full row-paypal"
                    data-pp-message
                    data-pp-placement="product"
                    data-pp-amount="{{ price_num | money_without_currency }}"
                    data-pp-style-layout="text"
                    data-pp-style-logo-type="primary"
                    data-pp-style-logo-position="left"
                  ></div>
                {%- elsif section.settings.installment_type == 'splitit' -%}
                  <div 
                    style="--fk-splitit-height: {{ section.settings.fk_splitit_height }}px;--fk-splitit-height-mb: {{ section.settings.fk_splitit_height_mb }}px;"
                    class="mt-3 w-full row-splitit"
                  >
                    <spt-one-liner 
                      installments="{{ section.settings.splitit_installments | default: 6 }}" 
                      text_custom="{{ section.settings.splitit_text_custom }}" 
                      learn_more_color="{{ section.settings.splitit_learn_more_color | default: '#4e8cfd' }}" 
                      hide_icon="{{ section.settings.splitit_hide_icon | default: true }}" 
                      logo_color="{{ section.settings.splitit_logo_color | default: '#39bca7' }}" 
                      amount="{{ price_num | money_without_currency | replace: ',', '' }}"
                    ></spt-one-liner>
                  </div>
                {%- endif -%}
              </div>

              {% comment %} 订阅 {% endcomment %}
              {%- if section.settings.show_subscribe == true -%}
                <button class="appearance-none bg-transparent w-6 h-6 lg:w-9 lg:h-9 lg:p-1 absolute {% if product_layout == 'l_img_r_text' %} lg:right-3 {% else %} lg:right-[38.25rem] {% endif %} right-3 top-3 z-[1] disabled:pointer-events-none [transform:translateZ(0)] [backface-visibility:hidden] [will-change:transform]" data-sku-id="{{ variant.id }}" data-subsciber-btn>
                  <svg class="w-full h-full" width="80" height="74" viewBox="0 0 80 74">
                    <use id="heart-use" xlink:href="#icon-heart-line"></use>
                  </svg>
                </button>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {% comment %} 订阅图标 {% endcomment %}
      <svg style="display: none;">
        <symbol id="icon-heart-line" viewBox="0 0 80 74">
          <path d="M0 24.5514C0 17.2425 2.1779 11.4105 5.8838 7.22035C9.568 3.05475 14.5059 0.803047 19.5186 0.179347C26.861 -0.734253 34.986 1.85235 40 7.71545C45.014 1.85245 53.139 -0.733553 60.4814 0.180347C65.494 0.804247 70.4321 3.05575 74.1162 7.22135C77.8221 11.4116 80 17.2435 80 24.5524C80 36.5777 72.7647 45.8585 64.9951 53.3512C61.0822 57.1247 56.798 60.6595 52.9619 63.9215C49.0471 67.2505 45.6103 70.2851 43.0225 73.2711H36.9775C34.3896 70.285 30.953 67.2497 27.0381 63.9205C23.202 60.6583 18.9179 57.1239 15.0049 53.3502C7.2354 45.8572 0.0001 36.5765 0 24.5514ZM8 24.5514C8.0001 33.1584 13.1399 40.4376 20.5576 47.5914C24.2383 51.1411 28.2513 54.4521 32.2197 57.8268C34.9108 60.1153 37.5954 62.445 40 64.8238C42.4047 62.445 45.0891 60.1152 47.7803 57.8268C51.7487 54.4522 55.7617 51.1419 59.4424 47.5924C66.8603 40.4388 72 33.1595 72 24.5524C72 18.8775 70.34 15.0268 68.124 12.5211C65.8863 9.99085 62.818 8.53265 59.4932 8.11885C52.5903 7.25975 45.7487 10.889 43.8145 17.0133H36.1855C34.2513 10.8889 27.4097 7.26005 20.5068 8.11885C17.182 8.53245 14.1136 9.99005 11.876 12.5201C9.66 15.0257 8 18.8765 8 24.5514Z" fill="var(--subscribe-icon-color)"/>
        </symbol>
        <symbol id="icon-heart-fill" viewBox="0 0 80 74">
          <path d="M19.5186 0.179342C26.861 -0.734258 34.986 1.85244 40 7.71544C45.014 1.85254 53.1391 -0.733557 60.4814 0.180243C65.4939 0.804143 70.4321 3.05574 74.1162 7.22134C77.822 11.4115 79.9999 17.2436 80 24.5523C80 36.5776 72.7646 45.8585 64.9951 53.3511C61.0822 57.1246 56.798 60.6595 52.9619 63.9215C49.0472 67.2503 45.6103 70.2851 43.0225 73.2711H36.9775C34.3896 70.285 30.9529 67.2496 27.0381 63.9205C23.202 60.6583 18.9178 57.1238 15.0049 53.3502C7.2355 45.8572 0.0001 36.5764 0 24.5513C0.0001 17.2426 2.1779 11.4104 5.8838 7.22034C9.568 3.05484 14.506 0.803042 19.5186 0.179342Z" fill="var(--subscribe-icon-color)"/>
        </symbol>
      </svg>
    {%- endif -%}
  </v5-product-row-one>
  
  {% comment %} 订阅弹窗 {% endcomment %}
  {%- if product_items.size > 0 and section.settings.show_subscribe == true -%}
    {%- render 'v5-common-subscribe-dialog',
      id: section.id,
      class: 'v5-product-row-one-subscibe-dialog',
      settings: section.settings,
      pc_dialog_width: '30rem',
      mb_dialog_width: '100vw',
    -%}
  {%- endif -%}

  <script src="{{ 'section-v5-product-row-one.min.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "V5-产品组件-一行1个",
  "class": "v5-product-row-one",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    { "type": "checkbox", "id": "related_v_tabs", "label": "是否关联V-Tabs组件", "default": false },
    {
      "type": "text",
      "id": "belongs_to",
      "label": "划分到的组件组名",
      "info": "用于在【V-Tabs组件（关联sections）】中进行分组显示",
      "visible_if": "{{ section.settings.related_v_tabs == true }}"
    },
    { "type": "header", "content": "PC边距" },
    { "type": "number", "id": "padding_top", "label": "PC上边距", "default": 64 },
    { "type": "number", "id": "padding_bottom", "label": "PC下边距", "default": 64 },

    { "type": "header", "content": "MB边距" },
    {
      "type": "select",
      "id": "mb_padding_type",
      "options": [
        {
          "value": "default",
          "label": "默认"
        },
        {
          "value": "custom",
          "label": "自定义"
        }
      ],
      "default": "default",
      "label": "MB边距"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 64,
      "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 64,
      "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
    },

    { "type": "header", "content": "基础配置" },
    { "type": "color_background", "id": "pc_bg_color", "label": "PC端版块背景色", "default": "#FFFFFF" },
    { "type": "color_background", "id": "mb_bg_color", "label": "MB端版块背景色", "default": "#F5F5F3" },
    { "type": "color", "id": "main_color", "label": "主颜色", "default": "#93161B" },
    { "type": "textarea", "id": "title", "label": "模块标题" },
    { "type": "color", "id": "title_color", "label": "标题字体颜色", "default": "#242F20" },
    { "type": "textarea", "id": "subtitle", "label": "模块副标题" },
    { "type": "color", "id": "subtitle_color", "label": "副标题字体颜色", "default": "#242F20" },

    { "type": "header", "content": "倒计时配置" },
    { "type": "text", "id": "countdown_title", "label": "倒计时标题", "default": "48-Hour Flash Sale" },
    { "type": "color", "id": "countdown_title_color", "label": "倒计时标题字体颜色", "default": "#FFFFFF" },
    { "type": "range", "id": "countdown_title_font_size_pc", "min": 12, "max": 80, "step": 1, "unit": "px", "label": "倒计时标题字体大小(PC)", "default": 48 },
    { "type": "range", "id": "countdown_title_font_size_mb", "min": 12, "max": 64, "step": 1, "unit": "px", "label": "倒计时标题字体大小(MB)", "default": 28 },
    { "type": "checkbox", "id": "countdown_hide_section_when_off", "label": "倒计时结束后只隐藏倒计时那一行", "default": false },
    { "type": "image_picker", "id": "countdown_title_bg_img", "label": "倒计时标题背景图片" },
    {
      "type": "select",
      "id": "countdown_title_bg_img_position",
      "label": "倒计时标题背景图片位置",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "right"
    },
    { "type": "number", "id": "countdown_title_bg_img_offset_pc_x", "label": "PC端，倒计时标题背景图片，X轴偏移量", "default": 16 },
    { "type": "number", "id": "countdown_title_bg_img_offset_pc_y", "label": "PC端，倒计时标题背景图片，Y轴偏移量", "default": 0 },
    { "type": "number", "id": "countdown_title_bg_img_offset_mb_x", "label": "MB端，倒计时标题背景图片，X轴偏移量", "default": 16 },
    { "type": "number", "id": "countdown_title_bg_img_offset_mb_y", "label": "MB端，倒计时标题背景图片，Y轴偏移量", "default": 0 },
    { "type": "text", "id": "countdown_label_text", "label": "倒计时\"天、时、分、秒\"多语言", "default": "Days,Hours,Mins,Secs", "info": "用英文','号分隔" },
    {
      "type": "text", "id": "begin_time_str", "label": "倒计时\"开始时间\"",
      "info": "rules is matter, YYYY/MM/DD hh:mm:ss, such as: 2025/09/09 00:00:00"
    },
    {
      "type": "text", "id": "end_time_str", "label": "倒计时\"结束时间\"",
      "info": "rules is matter, YYYY/MM/DD hh:mm:ss, such as: 2025/09/09 00:00:00"
    },

    { "type": "header", "content": "通用配置" },
    { "type": "text", "id": "from_text", "label": "价格显示前的文案" },
    { "type": "text", "id": "use_code_text", "label": "使用Code文案", "default": "Use Code" },
    { "type": "text", "id": "copy_success", "label": "Copy成功提示文案", "default": "Copy Success" },
    { "type": "checkbox", "id": "copy_checkout", "label": "Copy成功后跳转到checkout页", "default": false },
    { "type": "select", "id": "pc_show_btn_type", "options": [
      { "value": "shop_now_and_add_to_cart", "label": "Shop Now + Add To Cart" },
      { "value": "add_to_cart", "label": "Add To Cart" }
    ], "default": "shop_now_and_add_to_cart", "label": "PC端，显示按钮类型" },
    { "type": "select", "id": "mb_show_btn_type", "options": [
