<style>

    .v5-scenario-tob-tabs .tile > .v-block-container:has(.blocks-heading-content:nth-of-type(2)) > .blocks-heading-content:first-child .blocks-content-des {
        font-size: 0;
        display: inline-block;
        padding: 0.5rem;
        margin-right: 1.5rem;
        margin-bottom: 1rem;
        border: 1px solid #242F20;
    }

    .v5-scenario-tob-tabs .tile > .v-block-container:has(.blocks-heading-content:nth-of-type(2)) > .blocks-heading-content:first-child .blocks-content-des p {
        font-size: 0.875rem;
    }

    @media screen and (max-width: 1023.98px) {
        .v5-scenario-tob-tabs .tile > .v-block-container:has(.blocks-heading-content:nth-of-type(2)) > .blocks-heading-content:first-child .blocks-content-des {
            margin-right: 1rem;
            margin-bottom: 0.875rem;
        }

        .v5-scenario-tob-tabs .tile > .v-block-container:has(.blocks-heading-content:nth-of-type(2)) > .blocks-heading-content:first-child .blocks-content-des p {
            font-size: 0.75rem;
        }
    }

</style>


{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
  class="blocks-tabs-blocks"
  style="background: {{section.settings.bg_color | default: 'transparent' }};"
>
  <div class="section-padding {{section.settings.page_width}}" style="{{ style }}">
    {% content_for 'blocks' %}
