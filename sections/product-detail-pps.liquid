      <div class="video-img-box layer-container">
        {%- render 'jky-video',
          video_url: section.settings.tabs_feature_video,
          poster: section.settings.tabs_video_poster,
          title: product.title,
          class: 'features-media',
          autoplay: false,
          controls: true,
          loop: false
        -%}
      </div>
    </figure>
  {%- endif -%}

  <div class="need-wrap">
    {% comment %} 智能选购模块接入 {% endcomment %}
    {% render 'help-to-choose',
      title: section.settings.help_choose_title,
      chooseIpImage: section.settings.help_choose_ip,
      rechargingIcon: section.settings.recharging_icon,
      savingIcon: section.settings.energy_saving_icon,
      hide: section.settings.hide_help_choose
    %}

    {% if section.settings.need_image != blank
      and section.settings.need_heading != blank
      and section.settings.need_desc != blank
    %}
      <div class="power-station layer-container">
        <div class="header jky-text-xl font-500">
          <span>{{ section.settings.need_title }}</span>
          <img
            class="J-header-slide slide-up"
            src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033"
            alt="power"
            loading="lazy"
          >
        </div>
        <div class="content">
          <div class="image">
            <img
              src="{{ section.settings.need_image | image_url: width: 1080 }}"
              alt="{{section.settings.need_image.alt}}"
              loading="lazy"
            >
          </div>
          <div class="text">
            <p class="subtitle jky-text-lg font-500">{{ section.settings.need_heading }}</p>
            <div class="desc jky-text-base">
              {{ section.settings.need_desc }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  </div>

  <div class="product-contrast J-product-contrast layer-container">
    <h2 class="product-title jky-text-2xl layer-container">Product Comparison</h2>
    <ul class="contrast-wrap"></ul>
  </div>
</section>


<script src="{{ 'pdp-v3-content.min.js' | asset_url }}" defer></script>
{%- assign current_variant = product.selected_or_first_available_variant -%}
<script defer>
  (function () {
    function initProductDetailPps() {
    const productContrastInfo = new ProductContrast({
      currentVariant: {
        "id": {{ current_variant.id | json }},
        "sku": {{ current_variant.sku | json }},
        "availability" : {{ current_variant.available | json }},
        "price" : "{{ current_variant.price | money }}",
        "compare_at_price" : "{{ current_variant.compare_at_price | money }}"
      },
      productVariants: {
        {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "id": {{ variant.id | json }},
          "sku": {{ variant.sku | json }},
          "availability" : {{ variant.available | json }},
          "price" : "{{ variant.price | money }}",
          "compare_at_price" : "{{ variant.compare_at_price | money }}"
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      },
      helpToChoose: {pageType: 'pps_detail'}
    })
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductDetailPps);
    } else {
      initProductDetailPps();
    }
  })();
</script>

