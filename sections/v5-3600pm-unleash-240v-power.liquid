
{{ 'sections-v5-3600pm-unleash-240v-power.css' | asset_url | stylesheet_tag }}

{%- assign pcimage = section.settings.pcimage -%}
{%- assign mimage = section.settings.mimage -%}

<div {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}>
    <div class="power-240v relative overflow-hidden lg:h-[68.75rem] lg:bg-[#f5f5f3]" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
        <div class="power-240v__image relative h-[23.25rem] lg:absolute lg:inset-0 lg:h-auto">
            {%-liquid
              assign pc_img_width_val = pcimage.width | default: 1920
              assign mb_img_width_val = mimage.width | default: 750
              assign img_alt = section.settings.heading | strip_html | default: pcimage.alt | default: 'image alt'
            %}

            {% render 'diff-end-img',
              picture_class:'',
              pc_img: pcimage,
              mb_img: mimage,
              pc_img_width: pc_img_width_val,
              mb_img_width: mb_img_width_val,
              placeholder_name: 'hero-apparel-1',
              alt: img_alt,
              load_scene: 'default',
            %}
        </div>
        <div class="hidden lg:absolute lg:inset-0 lg:block lg:bg-black/20"></div>
        <div class="text-container relative flex flex-col items-center mx-[2.25rem] mb-[1.875rem] mt-[1.25rem] text-center lg:w-[81.5rem] lg:h-full lg:bg-transparent lg:mx-auto lg:mb-0 lg:mt-[6.25rem]"
          style="--text-color: {{ section.settings.text_color }}; --mb-text-color: {{ section.settings.mb_text_color }};">
            {%- if section.settings.heading != blank -%}
                <div class="text-[1.25rem] font-semibold leading-[1.625rem] lg:text-[3.375rem] lg:font-medium lg:leading-[5rem] blocks-text" style="--active-color: {{ section.settings.active_color }};">{{ section.settings.heading }}</div>
            {%- endif -%}
            {%- if section.settings.description != blank -%}
                <div class="mt-[0.625rem] text-[0.875rem] font-medium leading-[1.125rem] lg:mt-0 lg:text-[1.875rem] lg:leading-[3.125rem] blocks-text" style="--active-color: {{ section.settings.active_color }};">
                    {{ section.settings.description }}
                </div>
            {%- endif -%}
            <div class="lg:w-[94%] lg:mt-[1.5rem]">
              <div class="mt-[1.75rem] flex flex-col items-center lg:mt-0 lg:items-start">
                {%- if section.settings.button_text != blank -%}
                  <div class="flex items-center flex-col">
                    <button type="button" class="power-240v__button flex w-auto items-center justify-center gap-[0.5rem] bg-transparent text-center text-[0.875rem] font-semibold leading-[1.125rem]
                    text-primary lg:h-[3.75rem] lg:w-[15.9375rem] lg:rounded-[0.875rem] lg:border lg:border-solid lg:border-white/50 lg:bg-white/[0.01] lg:px-[1.25rem] lg:text-[1.125rem]
                    lg:font-medium lg:text-white lg:backdrop-blur-[1.875rem]" aria-expanded="false" aria-controls="Power240vPanel-{{ section.id }}">
                      <span>{{ section.settings.button_text }}</span><span class="lg:hidden text-[1rem] leading-[1rem]">→</span>
                    </button>
                    <div class="power-240v__pulse mt-[0.9375rem] hidden size-[3.125rem] items-center justify-center rounded-[9999rem] bg-white/20 lg:flex" >
                        <span class="block size-[1.25rem] rounded-[9999rem] bg-white/40"></span>
                    </div>
                  </div>
                {%- endif -%}
                {%- if section.blocks.size > 0 -%}
                    <div id="Power240vPanel-{{ section.id }}" class="power-240v__panel fixed inset-0 z-[20000] mt-0 w-full overflow-y-auto bg-white px-[1.125rem] pb-[3.75rem] pt-[4.6875rem] text-[#000000]
                    lg:relative lg:w-[38.25rem] lg:inset-auto lg:z-auto lg:mt-[0.5rem] lg:overflow-visible lg:rounded-[0.875rem] lg:border-[0.0625rem] lg:border-white/50 lg:bg-white/[0.01] lg:p-[1.25rem] lg:text-white
                    lg:backdrop-blur-[1.875rem]" hidden>
                        <button type="button" class="power-240v__close bg-white rounded-full fixed right-[1.75rem] top-[1.5rem] size-[2rem] lg:hidden" aria-label="Close"></button>
                        <div class="mb-[1.375rem] text-center text-[1.25rem] font-semibold leading-[1.625rem] lg:hidden">{{ section.settings.button_text }}</div>
                        <div class="flex w-full flex-col rounded-[0.75rem] bg-[#F5F5F3] px-[1.25rem] lg:rounded-none lg:bg-transparent lg:px-0">
                            {%- for block in section.blocks -%}
                                <div class="flex min-h-[4.3125rem] w-full items-center justify-between gap-[1rem] border-solid border-b border-[#dddddb] py-[0.75rem] text-[1rem] leading-[100%] last:border-b-0 lg:min-h-[2.75rem] lg:overflow-hidden lg:border-b-0 lg:py-0 lg:text-[1.125rem] lg:leading-[2.75rem]" {{ block.shopify_attributes }}>
                                    <span class="min-w-0 flex-1 text-left font-normal">{{ block.settings.appliance }}</span>
                                    <span class="shrink-0 text-right font-medium">{{ block.settings.power }}</span>
                                </div>
                            {%- endfor -%}
                        </div>
                    </div>
                {%- endif -%}
            </div>
            </div>
        </div>
    </div>
</div>

<script src="{{ 'sections-v5-3600pm-unleash-240v-power.js' | asset_url }}" defer></script>

