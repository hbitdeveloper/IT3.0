<style>
  .accessories-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #FFFFFF;
  }
  .accessories-title h2 {
    font-size: 45px;
    font-weight: 600;
    color: #000000;
    line-height: 66px;
    margin-top: 120px;
    max-width: 1200px;
    text-align: center;
    padding: 13px 200px;
    position: relative;
  }
  .accessories-title h2::before {
    display: block;
    content: '';
    width: 46px;
    height: 70px;
    background-image: url('https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016');
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    position: absolute;
    left: 0;
    top: 0;
  }
  .accessories-title h2::after {
    display: block;
    content: '';
    width: 61px;
    height: 89px;
    background-image: url('https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016');
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    position: absolute;
    right: 0;
    bottom: 0;
  }
  @media only screen and (max-width: 768px) {
    .accessories-title h2 {
      max-width: calc(100% - 8vw);
      font-size: 4.266666666666667vw;
      font-weight: 500;
      line-height: 6.4vw;
      margin-top: 8.8vw;
      padding: 1.3333333333333333vw 9.066666666666666vw;
    }
    .accessories-title h2::before {
      width: 4.8vw;
      height: 7.466666666666667vw;
    }
    .accessories-title h2::after {
      width: 6.4vw;
      height: 9.333333333333334vw;
    }
  }
</style>

<div class="accessories-title">
    <h2>{{section.settings.checkout_title | newline_to_br}}</h2>
</div>

{% schema %}
  {
    "name": "Accessories Title",
    "class": "section section-collection-accessories-title",
    "settings": [
      {"type": "textarea", "id": "checkout_title", "label": "Check out title", "default": "Check out the accessories that meet your solat needs"}
    ]
  }
{% endschema %}
