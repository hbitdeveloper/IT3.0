<div class="jky-12th-points {%if section.settings.is_gift_block == true%} gift-anchor gift-anchor--mb{%endif%}" anchor="{{ section.settings.anchor | escape }}" data-id="{{ customer.id }}">
  <div class="jky-12th-container">
    <div class="jky-up points">
      <div class="content">
        <div class="points-title">{{ section.settings.title | escape }}</div>

        <div class="value">
          {%- if customer.id -%}
          <span class="text">{{ section.settings.point | escape }}</span>
          <span class="real"></span>
          {%- endif -%}
        </div>

        <a
          target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}"
          href="{{ section.settings.link }}"
          data-ga-event="12anniversary_page_user_clicks"
          data-ga-action="click"
          data-ga-params-button_name="{{section.settings.redeem | escape}}"
          data-ga-params-link="{{section.settings.link}}"
        >
          <button class="jky-12th-btn">
            <span>{{ section.settings.redeem | escape}}</span>
          </button>
        </a>
      </div>
      <div class="img">
        {% render 'responsive-image', image: section.settings.image %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "十二周年-积分",
  "settings": [
    { "type": "checkbox", "id": "is_gift_block", "label": "是否为礼盒模块", "default": false, "info": "该模块的顺序请保持：KV-滚动介绍-品牌介绍-获奖Swiper" },
    { "type": "text",  "id": "anchor", "label": "二级标题定位锚点" },
    { "type": "text", "id": "title", "label": "标题" },
    { "type": "checkbox", "id": "new_window", "label": "新开标签页", "default": false },
    { "type": "text", "id": "point", "label": "积分" },
    { "type": "text", "id": "redeem", "label": "兑换按钮" },
    { "type": "url", "id": "link", "label": "跳转地址" },
    { "type": "image_picker", "id": "image", "label": "礼物图(560*460)" }
  ]
}
{% endschema %}
