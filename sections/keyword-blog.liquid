<style>
  .section-keyword-blog {
    margin-bottom: 6.3021vw;
    background: #ffffff;
  }

  .section-keyword-blog .keyword-blog-title {
    font-size: 2.3438vw;
    font-weight: 600;
    color: #000000;
    padding: 2.9688vw 0;
    text-align: center;
  }

  .keyword-blog-content-m {
    display: none;
  }

  .keyword-blog-content {
    max-width: 62.5vw;
    grid-gap: 0.9375vw;
    display: grid;
    flex-wrap: wrap;
    grid-template-columns: repeat(3, 1fr);
    margin-left: auto;
    margin-right: auto;
  }
  .keyword-blog-content .blog-item {
    display: flex;
    flex-direction: column;
  }
  .keyword-blog-content .blog-item .blog-image {
    height: 14.4271vw;
    overflow: hidden;
  }
  .keyword-blog-content .blog-item .blog-image img {
    height: 100%;
    width: 100%;
  }

  .keyword-blog-content .blog-item .blog-info {
    padding: 1.0417vw;
    flex: 1;
  }
  .keyword-blog-content .blog-item .blog-info .blog-tags {
    height: 1.0938vw;
    margin-bottom: 1.0417vw;
    display: flex;
  }
  .keyword-blog-content .blog-item .blog-info .blog-tags .blog-tag {
    font-size: 0.7292vw;
    font-weight: 400;
    color: #666666;
    line-height: 0.8333vw;
    position: relative;
    padding-right: 1.875vw;
  }

  .keyword-blog-content .blog-item .blog-info .blog-tags .blog-tag::after {
    position: absolute;
    content: '';
    right: 0.8854vw;
    top: 0;
    bottom: 0.2083vw;
    width: 0.0521vw;
    background: var(--primary-color);
  }
  .keyword-blog-content .blog-item .blog-info .blog-tags .blog-tag:last-child {
    padding-right: 0;
  }
  .keyword-blog-content .blog-item .blog-info .blog-tags .blog-tag:last-child::after {
    display: none;
  }

  .keyword-blog-content .blog-item .blog-info .blog-title {
    height: unset;
    overflow: hidden;
    margin-bottom: 1.0417vw;
    font-size: 0.9375vw;
    font-weight: 500;
    color: #333333;
    line-height: 1.4063vw;
  }
  .keyword-blog-content .blog-item .blog-info .blog-bottom {
    display: flex;
    align-items: center;
  }
  .keyword-blog-content .blog-item .blog-info .blog-bottom .blog-date {
    display: flex;
    flex: 1;
    font-size: 0.7292vw;
    font-weight: 400;
    color: #666666;
    line-height: 1.4063vw;
  }

  @media screen and (max-width: 768px) {
    .section-keyword-blog {
      margin-bottom: 11.6vw;
    }

    .keyword-blog-content {
      display: none;
    }

    .section-keyword-blog .keyword-blog-title {
      padding: 8.6667vw 0;
      font-size: 6vw;
      font-weight: 600;
      color: #000000;
      line-height: 8.8vw;
    }

    .keyword-blog-content-m {
      display: block;
      max-width: 100%;
      margin: 0 8vw;
    }
    .keyword-blog-content-m .blog-item {
      background: #f6f6f6;
      border-bottom: 1.0667vw solid var(--primary-color);
    }
    .keyword-blog-content-m .blog-item .blog-image {
      height: 82.6667vw;
      overflow: hidden;
    }
    .keyword-blog-content-m .blog-item .blog-image img {
      height: 100%;
      width: 100%;
    }

    .keyword-blog-content-m .blog-item .blog-info {
      padding: 10.6667vw 5.3333vw;
    }

    .keyword-blog-content-m .blog-item .blog-info .blog-tags {
      height: 6.4vw;
      margin-bottom: 4.8vw;
      display: flex;
    }

    .keyword-blog-content-m .blog-item .blog-info .blog-tags .blog-tag {
      position: relative;
      padding-right: 6.4vw;
      font-size: 3.4667vw;
      font-weight: 400;
      color: #666666;
      line-height: 5.2vw;
    }

    .keyword-blog-content-m .blog-item .blog-info .blog-tags .blog-tag::after {
      position: absolute;
      content: '';
      right: 2.8854vw;
      top: 1vw;
      bottom: 2.2083vw;
      width: 0.1333vw;
      background: var(--primary-color);
    }
    .keyword-blog-content-m .blog-item .blog-info .blog-tags .blog-tag:last-child {
      padding-right: 0;
    }
    .keyword-blog-content-m .blog-item .blog-info .blog-tags .blog-tag:last-child::after {
      display: none;
    }

    .keyword-blog-content-m .blog-item .blog-info .blog-title {
      height: unset;
      overflow: hidden;
      margin-bottom: 2.4vw;
      font-size: 4.2667vw;
      font-weight: 500;
      color: #333333;
      line-height: 6.4vw;
    }
    .keyword-blog-content-m .blog-item .blog-info .blog-bottom {
      display: flex;
      align-items: center;
    }
    .keyword-blog-content-m .blog-item .blog-info .blog-bottom .blog-date {
      display: flex;
      flex: 1;
      font-size: 3.2vw;
      font-weight: 400;
      color: #666666;
      line-height: 4.8vw;
    }

    .kwblog-swiper-pagination {
      display: flex;
      justify-content: center;
      padding-top: 5.3333vw;
      align-items: center;
    }
    .kwblog-swiper-pagination .kwblog-swiper-pagination-customs {
      width: 5.3333vw;
      height: 0.2667vw;
      background: #cccccc;
      margin-right: 1.3333vw;
    }
    .kwblog-swiper-pagination .kwblog-swiper-pagination-customs-active {
      width: 13.3333vw;
      height: 0.5333vw;
      background: var(--primary-color);
    }
  }

  .section-keyword-blog .keyword-blog-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .section-keyword-blog .keyword-blog-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .section-keyword-blog .keyword-blog-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }
  }
</style>

<h2 class="keyword-blog-title" anchor="{{ section.settings.anchor | escape }}" 
style="
  --pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
  --pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
  "
>{{- section.settings.title | escape -}}</h2>
{%- if section.settings.sub != blank -%}
  <div class="keyword-blog-sub keyword-sub">{{ section.settings.sub }}</div>
{%- endif -%}
<div class="keyword-blog-content">
  {% for block in section.blocks limit: section.settings.blog_size %}
    {% assign article = block.settings.blog %}
    <div class="blog-item focus-zoom-container">
      <div class="blog-image">
        <img
          class="object-cover focus-zoom"
          src="{{ article.image | image_url: width: 388}} "
          alt="{{article.image.alt}}"
          {% unless lazy_load == false %}
            loading="lazy"
          {% endunless %}
        >
      </div>
      <div class="blog-info flex flex-col justify-between">
        <div>
          <div class="blog-tags">
            {% for tag in article.tags %}
              <div class="blog-tag">{{ tag }}</div>
            {% endfor %}
          </div>
          <div class="blog-title">{{ article.title | escape }}</div>
        </div>
        
        <div class="blog-bottom">
          <div class="blog-date">
            {% if article.published_at != blank %}
              {{ article.published_at | time_tag: format: 'date' }}
            {% endif %}
          </div>
          <a class="kw-blog-button slide-link z-button-fill-middle jky-text-base" data-position_index="{{ forloop.index }}" data-href="{{article.url}}" data-title="{{ article.title | escape }}">
            {{ block.settings.more_text | escape }}
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
          </a>
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<div class="swiper keyword-blog-content-m">
  <div class="swiper-wrapper">
    {% for block in section.blocks limit: section.settings.blog_size %}
      {% assign article = block.settings.blog %}
      <div class="swiper-slide blog-item focus-zoom-container">
        <div class="blog-image">
          <img
            class="object-cover focus-zoom"
            src="{{ article.image | image_url: width: 750}} "
            alt="{{article.image.alt}}"
            {% unless lazy_load == false %}
              loading="lazy"
            {% endunless %}
          >
        </div>
        <div class="blog-info">
          <div class="blog-tags">
            {% for tag in article.tags %}
              <div class="blog-tag">{{ tag }}</div>
            {% endfor %}
          </div>
          <div class="blog-title">{{ article.title | escape }}</div>
          <div class="blog-bottom">
            <div class="blog-date">
              {% if article.published_at != blank %}
                {{ article.published_at | time_tag: format: 'date' }}
              {% endif %}
            </div>
            <a class="kw-blog-button slide-link z-button-fill-middle jky-text-base" data-position_index="{{ forloop.index }}" data-href="{{article.url}}" data-title="{{ article.title | escape }}">
              {{ block.settings.more_text | escape }}
              <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
            </a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
<div id="kwblog_swiper_page" class="kwblog-swiper-pagination"></div>

<script type="module">
  function keywordBlogsInit() {
    var swiper = new Swiper('.keyword-blog-content-m', {
      autoHeight: true,
      pagination: {
        el: '#kwblog_swiper_page',
        type: 'custom',
        renderCustom: function (swiper, current, total) {
          var paginationHtml = '';
          for (var i = 1; i <= total; i++) {
            // 判断是否是激活焦点，是的话添加active类，不是就只添加基本样式类
            if (i === current) {
              paginationHtml +=
                '<span class="kwblog-swiper-pagination-customs kwblog-swiper-pagination-customs-active"></span>';
            } else {
              paginationHtml += '<span class="kwblog-swiper-pagination-customs"></span>';
            }
          }
          return paginationHtml;
        },
      },
    });

    const blogButtons = document.querySelectorAll('.kw-blog-button');
    blogButtons.forEach(function (button) {
      button.addEventListener('click', function (e) {
        let targetDom;
        if (e.target.localName == 'span') {
          targetDom = e.target.offsetParent;
        } else {
          targetDom = e.target;
        }

        let href = targetDom.dataset.href;
        let title = targetDom.dataset.title;
        let position_index = targetDom.dataset.position_index;
        
        window.dataLayer.push({ event_parameters: null });
        window.dataLayer.push({
          event: 'ga4Event',
          event_name: ' blog_view_more',
          event_parameters: {
            current_page: location.pathname,
            title: title,
            position: position_index,
            url: href,
          },
        }); 
         window.location.href = href;
      });
    });
  }

  window.addEventListener('DOMContentLoaded', function () {
    keywordBlogsInit();
  });
</script>

{% schema %}
{
  "name": "Keyword Blog",
  "class": "section section-keyword-blog",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },  
  { "type": "text", "id": "title", "label": "keyword blog title" },
  { "type": "richtext", "id": "sub", "label": "keyword blog subtitle" },
  { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
  { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 40 },
  { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
  { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 }
],
  "blocks": [
    {
      "type": "keyword_blog_item",
      "name": "Keyword Blog Item",
      "settings": [
        { "type": "article", "id": "blog", "label": "Recommend Blog" },
        { "type": "text", "id": "more_text", "label": "More button text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keyword Blog",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
