{% comment %} tabs {% endcomment %}
<div class="sticky left-0 top-0 bg-white z-1000 cal_scroll_target">
    <ul class="px-60 py-10 flex items-center justify-between lg:justify-center lg:j-gap-x-150">
        {% for block in section.blocks %}
            <li class="group cursor-pointer {% if forloop.index0 == 0 %} active {%endif%}" data-tab-id="{{block.settings.anchor_type}}">
                <span class="collection-tab">{{block.settings.anchor_title | escape}}</span>
            </li>
        {% endfor %}
    </ul>
</div>

{% schema %}
    {
        "name": "Collection Anchor",
        "class": "section section-collection-anchor section-sp-pps-sg-collection sticky left-0 top-0 z-1000",
        "settings": [],
        "blocks": [
            {
                "type": "anchor-item",
                "name": "Anchor Item",
                "settings": [
                    {
                        "type": "select",
                        "id": "anchor_type",
                        "label": "Anchor Type",
                        "options": [
                            {
                                "value": "how-it-works",
                                "label": "How it works"
                            },
                            {
                                "value": "features",
                                "label": "Features"
                            },
                            {
                                "value": "products-list",
                                "label": "Products List"
                            }
                        ]
                    },
                    {"type": "text", "id": "anchor_title", "label": "Anchor Title"}
                ]
            }
        ]
    }
{% endschema %}