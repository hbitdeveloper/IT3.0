{% comment %} V5 计算器 {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }}{
    background-color: {{ section.settings.bg_color }};
  }
  .jky-v5 {
    .pdp-calculator {
      padding: 0;
      justify-content: flex-start;
      min-height: auto;
      align-items: normal;
      background-color: transparent;

      input.power-inp {
        background-color: transparent;
      }

      .btn-enter[disabled] {
        background-color: #0000004d;
      }

      .input-box:hover,
      .input-box.has-value {
        border-color: var(--jds-color-primary);
      }

      .input-box.error {
        border-color: #e40f00;
      }
    }

    .popup-mode {
      .popup-title {
        display: block;
      }

      .pdp-calculator {
        display: block;
        opacity: 0;
        z-index: -1;
        transform: translateY(-50px);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s;
        background-color: #ffffff;
        padding: 4rem;
        position: fixed;
        top: 9vh;

        &.fade-in {
          opacity: 1;
          transform: translateY(0) translateZ(0);
        }

        &.fade-out {
          opacity: 0;
          transform: translateY(-50px);
        }

        .top-title-part {
          display: flex;
          justify-content: space-between;
          margin-bottom: 4rem;
          align-items: center;

          .top-title {
            margin-bottom: 0;
          }

          svg {
            display: block;
          }
        }

        .content-part {
          display: block;
        }

        .left-part {
          width: 45.6875rem;
          margin-right: 1.5rem;
        }

        .right-part {
          position: absolute;
          right: 4rem;
          bottom: 8.5rem;
        }

        .runs-for {
          margin-left: 5.75rem;
          color: #1d1d1d;
        }

        .calculator-title {
          margin-bottom: 1.5rem;
          color: #1d1d1d;
          display: flex;
          align-items: center;

          span {
            display: flex;
          }
        }

        .dropdown-item:hover {
          background-color: #f5f5f5;
        }

        .icon-cal {
          width: 5rem;
          height: 5rem;
          margin-right: 0.75rem;
        }

        .input-box-container {
          margin-right: 1rem;

          .input-box {
            width: 25rem;
          }
        }

        .notice {
          display: none;
        }
      }
    }

    .pdp-calculator-mask {
      opacity: 0;
      z-index: -1;
      transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);

      &.fade-in {
        opacity: 1;
      }

      &.fade-out {
        opacity: 0;
      }
    }

    @media screen and (max-width: 1023.98px) {
      .popup-mode {
        width: 100%;
        margin: 0;

        .pdp-calculator {
          border-radius: 0.5rem;
          padding: 1.5rem 1rem;
          width: 100%;
          left: 0;
          top: 60px;

          .top-title-part {
            margin-bottom: 1.5rem;
          }

          .left-part {
            margin-top: 1.5rem;
            width: 100%;
            border-bottom: 1px solid #d9d9d9;
            padding-bottom: 1.5rem;

            .calculator-title {
              font-size: 0.875rem;
              line-height: 1.3125rem;
              margin-bottom: 1.5rem;

              span {
                display: flex;
              }
            }

            .calculator-operator {
              justify-content: center;

              .icon-cal {
                width: 4rem;
                height: 4rem;
                margin-right: 2.375rem;
              }

              .input-box-container {
                margin: 0;
              }

              .input-box {
                width: 14.9375rem;
              }

              .btn-enter {
                width: 100%;
                background-color: var(--jds-color-primary);
              }
            }
          }

          .right-part {
            position: static;
            border-bottom: 1px solid #d9d9d9;

            .runs-for {
              margin-left: 0;
              margin-bottom: 0.5rem;
              font-size: 0.875rem;
              line-height: 1.3125rem;
            }

            .result-num {
              font-size: 6rem;
              line-height: 4.5rem;
            }

            .result-unit {
              font-size: 2.25rem;
              line-height: 4.5rem;
            }
          }
        }
      }
    }

    @media screen and (max-width: 374.98px) {
      .popup-mode .pdp-calculator .left-part .calculator-operator .icon-cal {
        margin-right: 1.2rem;
      }
    }
  }

  .jky-v5 .pdp-calculator button.btn-enter {
    border-radius: 0;
  }
{% endstyle %}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

{% if section.settings.enable_popup %}
  {% if section.settings.collection_shop != blank %}
    {% assign selected_collection = collections[section.settings.collection_shop] %}
    {% assign collection_products = selected_collection.products %}

    {% comment %} 初始化产品数组 {% endcomment %}
    {% assign product_data = '' %}
    {% assign dropdown_html = '' %}

    {% for product in collection_products %}
      {% assign capacity = product.metafields.my_fields.wattage %}
      {% if capacity != blank %}
        {% comment %} 产品最大功率，单位：W（瓦特） {% endcomment %}
        {% assign max_power = product.metafields.custom.max_power %}

        {% assign efficiency = 0.8 %}
        {% assign ac_consumption = 0 %}

        {%- if capacity >= 100 and capacity < 1000 -%}
          {% assign efficiency = 0.82 %}
          {% assign ac_consumption = 10 %}
        {%- elsif capacity >= 1000 and capacity < 1200 -%}
          {% assign efficiency = 0.82 %}
          {% assign ac_consumption = 15 %}
        {%- elsif capacity >= 1200 and capacity < 2100 -%}
          {% assign efficiency = 0.82 %}
          {% assign ac_consumption = 18 %}
        {%- elsif capacity >= 2100 and capacity < 3050 -%}
          {% assign efficiency = 0.85 %}
          {% assign ac_consumption = 25 %}
        {%- elsif capacity >= 3050 and capacity < 5000 -%}
          {% assign efficiency = 0.85 %}
          {% assign ac_consumption = 22 %}
        {%- elsif capacity >= 5000 -%}
          {% assign efficiency = 0.85 %}
          {% assign ac_consumption = 50 %}
        {%- endif -%}

        {% if product.metafields.custom.efficiency != blank %}
          {% assign efficiency = product.metafields.custom.efficiency %}
        {% endif %}

        {% if product.metafields.custom.ac_consumption != blank %}
          {% assign ac_consumption = product.metafields.custom.ac_consumption %}
        {% endif %}

        {% assign shortname = product.metafields.custom.shortname | default: product.title %}
        {% assign words = shortname | split: ' ' %}
        {% if words.first == 'Jackery' %}
          {% assign shortname = shortname | remove_first: 'Jackery ' %}
        {% endif %}

        {% comment %} 构建产品数据对象 {% endcomment %}
        {% capture product_item %}
          {
            "id": "{{ product.id }}",
            "title": "{{ product.title | escape }}",
            "shortname": "{{ shortname | escape }}",
            "capacity": {{ capacity | default: 0 }},
            "max_power": {{ max_power | default: 0 }},
            "efficiency": {{ efficiency }},
            "ac_consumption": {{ ac_consumption }},
            "image": "{{ product.metafields.custom.shop_menu_product_image | default: product.featured_image | image_url: width: 200 }}",
            "specs": "Capacity {{ capacity }}Wh, Output {{ max_power }}W"
          }
        {% endcapture %}

        {% if product_data != '' %}
          {% assign product_data = product_data | append: ',' | append: product_item %}
        {% else %}
          {% assign product_data = product_item %}
        {% endif %}
        {% comment %} 同时构建下拉列表HTML {% endcomment %}
        {% capture dropdown_item %}
          <div
            class="dropdown-item flex items-center cursor-pointer"
            data-product-id="{{ product.id }}"
            data-max-power="{{ max_power | default: 0 }}"
            data-capacity="{{ capacity | default: 0 }}"
            data-efficiency="{{ efficiency }}"
            data-ac-consumption="{{ ac_consumption }}"
            data-image="{{ product.metafields.custom.shop_menu_product_image | default: product.featured_image | image_url: width: 200 }}"
            data-short-name="{{ shortname }}"
            data-equipment="{{ section.settings.equipment }}"
          >
            <div class="item-image hidden lg:block">
              <img class="lg:w-[7.5rem] lg:h-[7.5rem] lg:mr-[0.75rem]" src="{{ product.metafields.custom.shop_menu_product_image | default: product.featured_image | image_url: width: 180 }}" alt="{{ product.title }}" width="180" height="180" loading="lazy" />
            </div>
            <div class="item-info px-[0.75rem] lg:px-0 h-[2.8125rem] lg:h-[4.25rem] flex lg:block items-center border-b-[#00000012] border-b border-solid">
              <div class="item-title line-clamp-1 lg:line-clamp-2 font-semibold lg:text-[1.75rem] lg:w-[33.75rem] lg:mr-[0.625rem] lg:leading-[2.0625rem] ">{{ shortname }}</div>
            </div>
          </div>
        {% endcapture %}
        {% assign dropdown_html = dropdown_html | append: dropdown_item %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% else %}
  {% assign newProduct = product %}
  {% if newProduct == blank %}
    {% assign newProduct = section.settings.product %}
  {% endif %}
  {% assign capacity = newProduct.metafields.my_fields.wattage %}
  {% if capacity != blank %}
    {% comment %} 产品最大功率，单位：W（瓦特） {% endcomment %}
    {% assign max_power = newProduct.metafields.custom.max_power %}

    {% assign efficiency = 0.8 %}
    {% assign ac_consumption = 0 %}

    {%- if capacity >= 100 and capacity < 1000 -%}
      {% assign efficiency = 0.82 %}
      {% assign ac_consumption = 10 %}
    {%- elsif capacity >= 1000 and capacity < 1200 -%}
      {% assign efficiency = 0.82 %}
      {% assign ac_consumption = 15 %}
    {%- elsif capacity >= 1200 and capacity < 2100 -%}
      {% assign efficiency = 0.82 %}
      {% assign ac_consumption = 18 %}
    {%- elsif capacity >= 2100 and capacity < 3050 -%}
      {% assign efficiency = 0.85 %}
      {% assign ac_consumption = 25 %}
    {%- elsif capacity >= 3050 and capacity < 5000 -%}
      {% assign efficiency = 0.85 %}
      {% assign ac_consumption = 22 %}
    {%- elsif capacity >= 5000 -%}
      {% assign efficiency = 0.85 %}
      {% assign ac_consumption = 50 %}
    {%- endif -%}

    {% if newProduct.metafields.custom.efficiency != blank %}
      {% assign efficiency = newProduct.metafields.custom.efficiency %}
    {% endif %}

    {% if newProduct.metafields.custom.ac_consumption != blank %}
      {% assign ac_consumption = newProduct.metafields.custom.ac_consumption %}
    {% endif %}

    {% if newProduct.metafields.custom.efficiency != blank %}
      {% assign efficiency = newProduct.metafields.custom.efficiency %}
    {% endif %}
  {% endif %}
{% endif %}

{% assign power_flag = '${power}' %}
{% assign power_text = '(' | append: max_power | append: 'W)' %}

{% if capacity != blank %}
  <div
    class=" {% if section.settings.enable_popup %} popup-mode {% endif %} {{ section.settings.page_width }} section-padding"
    {% if section.settings.anchor != blank %}
      anchor-target="{{section.settings.anchor | escape}}"
    {% endif %}
    style="{{ style }}"
  >
    <div class="popup-title hidden items-center justify-center text-center text-[0.875rem] lg:text-[1.125rem] leading-[1.3125rem] lg:leading-[1.6875rem] font-semibold">
      <span class="cursor-pointer underline">{{ section.settings.popup_title }}</span>
    </div>

    <div
      class="pdp-calculator flex flex-col bg-white {% if section.settings.enable_popup %} {{ section.settings.page_width }} {% endif %}"
      data-type="ui-hrs"
      data-id="{{ section.id }}"
      data-capacity="{{ capacity }}"
      data-efficiency="{{ efficiency }}"
      data-product-title="{{ product.title | escape }}"
    >
      <div class="top-title-part">
        <div class="top-title text-center text-[1.5rem] leading-[2.25rem] lg:text-[3rem] lg:leading-[4.5rem] mb-[1.5rem] lg:mb-[2.5rem] font-semibold text-[#000000E5]">
          {{ section.settings.topTitle }}
        </div>
        {% render 'icon-close',
          class: 'cursor-pointer hidden',
          stroke_width: 2,
          width: 28,
          height: 28,
          color: '#000000'
        %}
      </div>

      {% if section.settings.enable_popup %}
        <div class="product-selector relative lg:w-[45.6875rem] border-b lg:border-b-0 lg:border-r border-solid border-[#D9D9D9] lg:pb-[2.5rem]">
          <div class="flex items-center font-semibold text-[#1D1D1D] text-[0.875rem] lg:text-[1.75rem] mb-[1rem] lg:mb-[1.5rem]">
            <span class="flex items-center justify-center text-[#FFFFFF] lg:text-[1.4375rem] w-[2rem] h-[2rem] lg:w-[3rem] lg:h-[3rem] bg-[var(--jds-color-primary)] rounded-[2rem] lg:rounded-[3rem] mr-[1rem]">1</span>
            {{ section.settings.select_title }}
          </div>
          <div class="product-item flex items-center w-full h-[2.8125rem] rounded-md lg:rounded-none lg:h-auto bg-[#ece6dc] lg:bg-inherit mb-[1.5rem] lg:mb-0 border-b lg:border-none border-b-[#D9D9D9] border-solid">
            <div class="hidden lg:block product-image lg:w-[7.5rem] lg:h-[7.5rem] lg:mr-[0.75rem]"></div>
            <div class="product-info cursor-pointer w-full lg:w-auto px-[0.75rem] lg:px-0">
              <div class="product-name flex justify-between">
                <div
                  class="item-title line-clamp-1 lg:line-clamp-2 font-semibold lg:text-[1.75rem] lg:h-[4.25rem] lg:w-[33.75rem] lg:mr-[0.625rem] lg:leading-[2.0625rem] border-none border-b-[#00000012] border-b lg:border-solid"
                ></div>
                <div class="selector-arrow">
                  <jds-icon name="arrow-down" class="icon lg:text-[1.75rem]"></jds-icon>
                </div>
              </div>
            </div>
          </div>
          <div class="product-dropdown-list hidden z-[1] bg-[#ece6dc] lg:bg-white max-h-[5.625rem] lg:max-h-[15rem] overflow-y-auto w-full lg:w-[45.625rem] absolute top-[5.8125rem] lg:top-[12rem]">
            {{ dropdown_html }}
          </div>
        </div>
      {% endif %}

      <div class="flex flex-col lg:flex-row justify-start content-part">
        <div class="left-part flex flex-col items-start justify-center lg:w-[52.125rem] lg:border-r border-solid border-[#D9D9D9] lg:mr-[3rem]">
          <div
            class="
              calculator-title w-full text-center lg:text-left text-[1.125rem] leading-[1.6875rem] lg:text-[1.75rem] lg:leading-[2.625rem]  text-[#000000E5] lg:text-[#00000099] font-semibold
              mb-[0.75rem] lg:mb-[3.4375rem]
            "
          >
            <span class="hidden items-center justify-center text-[#FFFFFF] lg:text-[1.4375rem] w-[2rem] h-[2rem] lg:w-[3rem] lg:h-[3rem] bg-[var(--jds-color-primary)] rounded-[2rem] lg:rounded-[3rem] mr-[1rem]">2</span>
            {{ section.settings.title }}
          </div>
          <div class="calculator-operator w-full flex flex-row flex-wrap lg:flex-nowrap items-center justify-center lg:justify-start lg:mb-[1rem]">
            <svg
              class="icon-cal w-[3.375rem] h-[3.375rem] lg:w-[7.5rem] lg:h-[7.5rem] mr-[1rem] lg:mr-[2.375rem] lg:ml-[0.5625rem]"
              viewBox="0 0 120 121"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
            >
              <rect y="0.594727" width="120" height="120" rx="16" fill="url(#pattern0_477_6615)"/>
              <defs>
                <pattern id="pattern0_477_6615" patternContentUnits="objectBoundingBox" width="1" height="1">
                  <use xlink:href="#image0_477_6615" transform="matrix(0.0122715 0 0 0.0125861 -7.72062 -3.91135)"/>
                </pattern>
                <image id="image0_477_6615" width="1115" height="460" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
              </defs>
            </svg>
            <div class="input-box-container lg:mr-[2.375rem]">
              <div
                class="
                  flex input-box items-center w-[12.5rem] h-[2rem] lg:w-[20rem] font-semibold lg:h-[4rem] pl-[0.75rem]
                  rounded-lg lg:rounded-[0.75rem] border lg:border-2 border-solid border-[#D9D9D9] text-[0.875rem] lg:text-[1.5rem]
                "
              >
                <input
                  type="number"
                  min="0"
                  max="{{ max_power }}"
                  data-max-power="{{ max_power }}"
                  data-ac_consumption="{{ ac_consumption }}"
                  class="power-inp h-full w-full pr-[0.75rem] py-[0.34375rem] lg:py-[0.875rem] font-semibold leading-[1.3125rem] lg:leading-[2.25rem]"
                  onkeyup="value=value.replace(/[^\d]/g,'')"
                  onblur="value=value.replace(/[^\d]/g,'')"
                >
                <span class="leading-[1.3125rem] lg:leading-[2.25rem] py-[0.34375rem] lg:py-[0.875rem] mr-[0.75rem]">W</span>
              </div>
              <div
                class="absolute error-tips line-clamp-1 invisible w-[14.75rem] lg:w-[20rem] mt-[0.25rem] lg:mt-[0.5rem] text-[0.75rem] leading-[1.125rem] lg:text-[1rem] lg:leading-[1.5rem] text-[var(--jds-color-primary)] font-normal lg:font-medium"
                data-error-message="{{ section.settings.errorTips }}"
                data-error-placeholder="{{ power_flag }}"
              >
                {% assign max_power_text = max_power | append: 'W' %}
                {{ section.settings.errorTips | replace: power_flag, max_power_text }}
              </div>
            </div>
            <button
              type="button"
              class="
                btn-enter mt-[1rem] lg:mt-0 rounded-[6.25rem] w-[9.0625rem] h-[1.8125rem] lg:w-[12.8125rem] lg:h-[2.6875rem] bg-[var(--jds-color-primary)] px-[1.5rem] py-[0.25rem] lg:py-[0.5rem] lg:px-[1.3125rem]
                font-semibold leading-[1.3125rem] text-[0.875rem] lg:text-[1.0625rem] lg:leading-[1.6875rem] text-white
              "
              disabled
            >
              {{ section.settings.btnText }}
            </button>
          </div>
        </div>
        <div class="right-part lg:w-[26.875rem] flex flex-col justify-center items-center lg:items-start">
          <div class="runs-for mt-[1.5rem] lg:mt-0 text-[1.125rem] leading-[1.6875rem] lg:text-[1.75rem] lg:leading-[2.625rem] font-semibold text-[#000000E5] lg:text-[#00000099]">
            {{ section.settings.runsFor }}
          </div>
          <div class="lg:mt-[2.375rem] lg:mb-[1rem] text-[var(--jds-color-primary)] font-medium">
            <span
              class="v5-font-oxm font-extrabold result-num text-[4rem] lg:text-[8rem] leading-[6rem]"
              id="{{ section.id }}-resultNum">00</span>
            <span class="result-unit text-[3rem] lg:text-[3rem]">{{ section.settings.hrs }}</span>
          </div>
          <p class="notice text-center font-normal px-[1rem] lg:px-0 lg:text-left text-[0.75rem] leading-[1.125rem] lg:text-[0.875rem] lg:leading-[1.3125rem]">
            {{ section.settings.note }}
          </p>
        </div>
      </div>
    </div>
  </div>
  {% if section.settings.enable_popup %}
    <div class="fixed pdp-calculator-mask w-screen h-screen top-0 bg-[rgba(0,0,0,0.5)]"></div>
  {% endif %}

  <script defer src="{{ 'sections-v5-pdp-calculator.js' | asset_url }}"></script>
{% endif %}

<script defer src="{{ 'snippet-pdp-calculator.min.js' | asset_url }}"></script>

{% schema %}
{
  "name": "V5-计算器",
  "settings": [
    {
      "type": "header",
      "content": "提醒：配置完当前产品的 Wattage/Capacity 后才展示此版块"
    },
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    {
      "type": "select",
      "id": "style_type",
      "options": [
        {
          "value": "default",
          "label": "基础配置"
        },
        {
          "value": "custom",
          "label": "开发者配置"
        }
      ],
      "default": "default",
      "label": "配置类型"
    },
    { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#FFFFFF" },
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1312px"
        },
        {
          "value": "w-full",
          "label": "铺满/100%"
        }
      ],
      "default": "section-container-lg",
      "label": "组件宽度",
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    { "type": "header", "content": "使用场景设置", "visible_if": "{{ section.settings.style_type == 'custom' }}" },
    { "type": "header", "content": "PC边距", "visible_if": "{{ section.settings.style_type == 'custom' }}" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 80,
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 80,
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0,
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },

    { "type": "header", "content": "MB边距", "visible_if": "{{ section.settings.style_type == 'custom' }}" },
    {
      "type": "select",
      "id": "mb_padding_type",
      "options": [
        {
          "value": "default",
          "label": "默认"
        },
        {
          "value": "custom",
          "label": "自定义"
        }
      ],
      "default": "custom",
      "label": "MB边距",
      "visible_if": "{{ section.settings.style_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 64,
      "visible_if": "{{ section.settings.style_type == 'custom' and section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
