
<style>
	#shopify-section-{{ section.id }} {
		{% if section.settings.background_type == 'color' %}
      background: {{ section.settings.bg_color }}
    {% else %}
      background-image: url("{{ section.settings.bg_image | image_url }}");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
	}
  .v5-general-ing-text-tit,
  .v5-general-img-text-desc{
    line-height: 1.3;
  }
  .v5-general-card-group .swiper-slide{
    width: 232px
  }
  .v5-general-card-image{
    height: 271px;
  }
  .general-card-slide-set-title,
  .general-card-img_text_set-title{
    line-height: 1.1;
  }
  .v5-general-card-imgText-image{
    height: 353px;
  }
  .general-card-img_text_set-desc{
    line-height: 1.2;
  }
  @media (min-width: 1440px) {
    .v5-general-card-image{
      width: 336px;
    }
    .v5-general-card-imgText-image{
      width: 792px;
    }
  }
  @media (min-width: 1024px) and (max-width: 1440px) {
    .v5-general-card-imgText-image{
      width: 66%;
    }
  }
  @media (max-width: 767.99px) {
    #shopify-section-{{ section.id }} .v5-carousel-card-tit{
      font-size: 1.75rem;
    }
    .v5-general-card-group .swiper-slide{
      width: 17.5rem
    }
    .v5-general-card-image{
      height: 14.5rem;
    }
    .v5-general-card-imgText-image{
      height: 14.3125rem;
    }
  }
</style>

{% assign set = section.settings %}

<div 
	{% if set.anchor != blank %} anchor-target="{{set.anchor | escape}}"{% endif %}
	class="section-container"
	style="padding-top: {{ set.padding_top }}px; padding-bottom: {{ set.padding_bottom }}px;"
>
	{%- if set.heading != blank -%}
    <h2 class="v5-general-ing-text-tit font-semibold md:text-5xl text-center lg:mb-16 mb-8 mx-auto">
      {{ set.heading | replace: '\n', '<br>' | strip }}
    </h2>
  {%- endif -%}
  
  {%- assign slide_blocks = section.blocks | where: 'type', 'v5-general-card-slide' -%}
  {%- if slide_blocks.size > 0 -%}
    <div class="v5-general-card-group w-full mx-auto">
      <div class="container mx-auto">
        <div class="relative w-full">
          <div class="swiper overflow-hidden w-full" data-mfj-swiper>
            <div class="swiper-wrapper" >
              {%- for block in section.blocks -%}
                {%- if block.type == 'v5-general-card-slide' -%}
                  {%- assign slide_set = block.settings -%}

                  <div class="swiper-slide h-auto overflow-hidden relative shrink-0" style="height: auto !important;">
    
										<div class="v5-general-card-slide	
											{% if slide_set.desc != blank %}has-desc{% endif %} 
											overflow-hidden shadow-md h-full flex flex-col" 
											style="width:100%; background-color: {{ slide_set.card_bg }};"
                      id="card-{{ block.id }}">
                      {%- style -%}
                        #card-{{ block.id }} {
                          padding: {{ slide_set.pc_card_padding | default: '24px 24px 24px 24px' }};
                        }
                        @media only screen and (max-width: 749.98px) {
                          #card-{{ block.id }} {
                            padding: {{ slide_set.mb_card_padding | default: '16px 16px 16px 16px' }};
                          }
                        }
                      {%- endstyle -%}
                      <div class="v5-general-card-image mb-6 relative w-full">
                        {%- if slide_set.pcimage != blank or slide_set.mimage != blank -%} 
                          {% if slide_set.border_radius != blank and slide_set.border_radius > 0 %}
                            {% assign img_style = 'border-radius: ' | append: slide_set.border_radius | append: 'px;' %}
                          {% endif %}
                          {% render 'diff-end-img',
                            class: 'w-full h-full max-w-none object-cover object-center block',
                            style: img_style,
                            pc_img: slide_set.pcimage,
                            mb_img: slide_set.mimage,
                            pc_img_width: 336,
                            mb_img_width: 496 
                          %}
                        {%- else -%}
                          <div class="w-full h-full" style="border-radius: {{ slide_set.border_radius }}px; overflow: hidden;">
                            {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-full h-full block object-cover' }}
                          </div>
                        {%- endif -%}
                      </div>
                      <div class="flex-grow">
                        {%- if slide_set.sub_title != blank -%}
                          <div class="md:text-base text-sm leading-none font-semibold uppercase overflow-hidden truncate mb-4" 
                            style="color: {{ slide_set.sub_title_color }};">
                            {{ slide_set.sub_title }}
                          </div>
                        {%- endif -%}
                        {%- if slide_set.title != blank -%}
                          <div class="general-card-slide-set-title md:text-2xl text-base font-semibold" 
                            style="color: {{ slide_set.title_color }};" id="card-tit-{{ block.id }}">
                            {{ slide_set.title }}
                          </div>
                          {%- style -%}
                            #card-tit-{{ block.id }} {
                              margin-bottom: {{ slide_set.title_margin_bottom }}px;
                            }
                          {%- endstyle -%}
                        {%- endif -%}
                        {%- if slide_set.desc != blank -%}
                          <div class="v5-general-img-text-desc text-sm line-clamp-3 mb-6 break-words hidden md:block" style="color:{{ slide_set.desc_color }}">
                            {{ slide_set.desc }}
                          </div>
                        {%- endif -%}
                      </div>
                      {%- if slide_set.button_text != blank -%}
                        <div class="mt-auto" style="text-align: {{ slide_set.button_align }};">
                          <a href="{{ slide_set.button_link }}" class="inline-block text-base font-semibold text-center transition-all duration-300 hover:opacity-80 hover:-translate-y-1" 
                            style="
                              width: 136px;
                              height: 36px;
                              line-height: 36px;
                              background-color: {{ slide_set.button_bg | default: 'transparent' }}; 
                              color: {{ slide_set.button_text_color | default: '#000000' }}; 
                              border: {{ slide_set.button_border_width | default: 1 }}px solid {{ slide_set.button_border_color | default: '#ffffff' }};">
                            {{ slide_set.button_text }}
                          </a>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
  
  {%- for block in section.blocks -%}
    {%- if block.type == 'v5-general-card-imgText' -%}
      {%- assign img_text_set = block.settings -%}
      <div class="v5-general-card-imgText container mx-auto" style="padding-top: {{ img_text_set.padding_top }}px;">
        <div class="v5-general-card-imgText-box flex flex-col md:flex-row {% if img_text_set.reverse %}md:flex-row-reverse{% endif %}">
          <div class="v5-general-card-imgText-image w-full">
            {%- if img_text_set.pcimage != blank or img_text_set.mimage != blank -%}
              {% render 'diff-end-img',
                class: 'w-full h-full max-w-none object-cover object-center',
                pc_img: img_text_set.pcimage,
                mb_img: img_text_set.mimage,
                pc_img_width: 792,
                mb_img_width: 686  
              %}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-full h-full' }}
            {%- endif -%}
          </div>
          <div class="v5-general-card-imgText-text flex-1 md:h-[353px] flex flex-col justify-center py-6 px-4 md:py-0"
            style="background: {{ img_text_set.bg_color }};">
            {%- style -%}
              {% if img_text_set.reverse %}
                .v5-general-card-imgText-text { 
                  padding-left: 1.5rem;
                  padding-right: 3rem;
                }
              {% else %}
                .v5-general-card-imgText-text { 
                  padding-left: 3rem;
                  padding-right: 1.5rem;
                }
              {% endif %}
            {%- endstyle -%}
            {%- if img_text_set.sub_title != blank -%}
              <span class="self-start justify-self-start text-xs md:text-base leading-none font-semibold uppercase overflow-hidden truncate px-4 py-1.5 mb-5"
                style="background: {{ img_text_set.sub_title_bg }}; color: {{ img_text_set.sub_title_color }}">
                {{ img_text_set.sub_title }}
              </span> 
            {%- endif -%}
            {%- if img_text_set.title != blank -%}
              <div class="general-card-img_text_set-title md:text-4xl text-2xl font-semibold line-clamp-3 mb-5 break-words"
                style="color: {{ img_text_set.title_color }}">
                {{ img_text_set.title }}
              </div>
            {%- endif -%}
            {%- if img_text_set.desc != blank -%}
              <div class="general-card-img_text_set-desc md:text-sm text-xs line-clamp-3 mb-6 break-words">
                {{ img_text_set.desc }}
              </div>
            {%- endif -%}
          
            {%- if img_text_set.button_text != blank -%}
              <div style="text-align: {{ img_text_set.button_align }};">
                <a href="{{ img_text_set.button_link }}" class="inline-block text-center text-base font-semibold transition-all duration-300 hover:opacity-80 hover:-translate-y-1" 
                  style="
                    width: 99px;
                    height: 36px;
                    line-height: 36px;
                    background-color: {{ img_text_set.button_bg | default: 'transparent' }}; 
                    color: {{ img_text_set.button_text_color | default: '#000000' }}; 
                    border: {{ img_text_set.button_border_width | default: 1 }}px solid {{ img_text_set.button_border_color | default: '#ffffff' }};">
                  {{ img_text_set.button_text }}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

<script type="module">
 // 在 theme.js 或单独的 JS 文件里（非 section inline）
  document.addEventListener('DOMContentLoaded', () => {
    initAllGeneralCardSwipers();
  });

  // 监听 section 动态加载（编辑器 + AJAX）
  document.addEventListener('shopify:section:load', (e) => {
    if (e.target.querySelector('.v5-general-card-group')) {
      initAllGeneralCardSwipers();
    }
  });

  function initAllGeneralCardSwipers() {
    document.querySelectorAll('.v5-general-card-group .swiper:not(.swiper-initialized)').forEach(container => {
      if (container.swiper) container.swiper.destroy(true, true);

      const section = container.closest('[id^="shopify-section-"]');
      const sectionId = section ? section.id.replace('shopify-section-', '') : '';
      const blocksSize = parseInt(container.dataset.blocksSize || '0'); // 你可以加 data-blocks-size="{{ section.blocks.size }}" 到 .swiper 上

      const options = {
        slidesPerView: 'auto',
        spaceBetween: 16,
        breakpoints: {
          750: { spaceBetween: 16 },
          1024: { slidesPerView: 3, spaceBetween: 24 }
        },
        loop: blocksSize > 3,
        lazy: { loadPrevNext: true, loadPrevNextAmount: 2 },
        observer: true,
        observeParents: true
      };

      new Swiper(container, options);
      container.classList.add('swiper-initialized'); // 标记已初始化，避免重复
    });
  }
</script>

