{% comment %} Shopify组件 {% endcomment %}
{%- assign tabs_num = 0 -%}
{%- assign tabs_list = '' -%}
{%- assign tabs_id = '' -%}
{%- assign show_type_list = '' -%}

{%- for block in section.blocks -%}
  {%- if block.settings.anchor != blank -%}
    {%- assign tabs_num = tabs_num | plus: 1 -%}

    {%- assign anchor = block.settings.anchor -%}
    {%- assign anchor_id = block.settings.anchor_id -%}
    {%- assign show_type = block.settings.display_type | default: 'all' -%}

    {%- assign tabs_list = tabs_list | append: anchor -%}
    {%- assign tabs_id = tabs_id | append: anchor_id -%}
    {%- assign show_type_list = show_type_list | append: show_type -%}

    {%- unless forloop.last -%}
      {%- assign tabs_list = tabs_list | append: '-' -%}
      {%- assign tabs_id = tabs_id | append: '-' -%}
      {%- assign show_type_list = show_type_list | append: '-' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}

{%- assign bar_tran_w = 100 | divided_by: tabs_num -%}
{%- assign tabs_list = tabs_list | split: '-' -%}
{%- assign tabs_id = tabs_id | split: '-' -%}
{%- assign show_type_list = show_type_list | split: '-' -%}

{%- render 'activity-tab',
  bar_tran_w: bar_tran_w,
  list: tabs_list,
  list_id: tabs_id,
  show_type_list: show_type_list,
  new_window: section.settings.new_window,
  tab_bg_color: section.settings.tab_bg_color,
  tab_active_color: section.settings.tab_active_color,
  text_active_color: section.settings.text_active_color,
  text_color: section.settings.text_color
-%}
{% comment %} Tab栏导航 {% endcomment %}
{% comment %} 自定义活动落地页 {% endcomment %}
{%- assign jp_land_product_num = 0 -%}
<div class="activity-main-container">
    <div class="activity--content_item">
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {%- when 'activity_pic' -%}
                  {% capture pic_type %}
                    {%- if  block.settings.display_type == 'pc' -%}
                      pc-block
                    {%- elsif  block.settings.display_type == 'mb' -%}
                      mobile-block
                    {% endif %}
                  {% endcapture %}
                  <div class="{{ pic_type}}">
                    {%- render "activity-image", schema_settings: block.settings,index: forloop.index -%}
                  </div>
                {%- when 'activity_coupon' -%}
                    {%- render "activity-coupon", schema_settings: block.settings -%}
                {%- when 'activity_des' -%}
                    {%- render "activity-description", settings: block.settings -%}
                {%- when 'activity_countdown' -%}
                    {%- render "activity-countdown", settings: block.settings,new_window: section.settings.new_window -%}
                {%- when 'activity_scense' -%}
                    <div style="width: 100vw;padding:1px 0;background:{{ block.settings.bg_color }}" {%if block.settings.anchor_id != blank%}anchor={{block.settings.anchor_id | escape}}{% endif %}>
                        {% render "diy-media-swiper", settings: block.settings %}
                    </div>
                {%- when 'activity_pic_swiper' -%}
                    {%- render "activity-pic-swiper", settings: block.settings,new_window: section.settings.new_window,index: forloop.index -%}
                {%- when 'activity_subscript' -%}
                    <div class="activity_subscript_box">
                      {%- render "activity-subscript", settings: block.settings,new_window: section.settings.new_window,index: forloop.index -%}
                    </div>
                {%- when 'activity_videos' -%}
                  <div class="section-photovolatic-find-out" {%if block.settings.anchor_id != blank%}anchor={{block.settings.anchor_id | escape}}{% endif %}>
                    {%- render "product-detail-videos", settings: block.settings,new_window: section.settings.new_window,index: forloop.index -%}
                  </div>
                {%- when 'activity_products' -%}
                  {% capture display_type %}
                    {%- if  block.settings.display_type == 'pc' -%}
                        pc-block
                    {%- elsif  block.settings.display_type == 'mb' -%}
                        mobile-block
                    {% endif %}
                  {% endcapture %}
                  <div class="{{ display_type}}">
                    {%- render "landing-product", schema_settings: block.settings -%}
                  </div>
                {%- when 'activity_products_eu' -%}
                  {% capture display_type %}
                    {%- if  block.settings.display_type == 'pc' -%}
                        pc-block
                    {%- elsif  block.settings.display_type == 'mb' -%}
                        mobile-block
                    {% endif %}
                  {% endcapture %}
                  <div class="{{ display_type }}" {{ block.shopify_attributes }}>
                    {%- render "landing-product-eu", schema_settings: block.settings -%}
                  </div>
                {%- when 'activity_products_jp' -%}
                  {%- assign jp_land_product_num = jp_land_product_num | plus: 1 -%}
                  {% capture display_type %}
                    {%- if  block.settings.display_type == 'pc' -%}
                        pc-block
                    {%- elsif  block.settings.display_type == 'mb' -%}
                        mobile-block
                    {% endif %}
                  {% endcapture %}
                  <div class="{{ display_type}}" {{ block.shopify_attributes }}>
                    {%- if jp_land_product_num > 2 -%}
                      {%- render "landing-product-jp", schema_settings: block.settings, need_style: false -%}
                    {%- else -%}
                      {%- render "landing-product-jp", schema_settings: block.settings, need_style: true -%}
                    {%- endif -%}
                  </div>
                {%- when 'activity_products_new' -%}
                  {% capture new_display_type %}
                    {%- if  block.settings.display_type == 'pc' -%}
                        pc-block
                    {%- elsif  block.settings.display_type == 'mb' -%}
                        mobile-block
                    {% endif %}
                  {% endcapture %}
                  <div class="{{ new_display_type}}">
                    {%- render "landing-product-new", schema_settings: block.settings -%}
                  </div>
                {%- when 'five_kwh_letter' -%}
                  {% comment %} 信任状 {% endcomment %}
                  {% render 'five-kwh-letter', letter: block.settings, index: forloop.index %}

              {% when 'empty-block-box' %}
                  {% comment %} 空盒子版块 {% endcomment %}
                  {% render 'empty-block-box',settings: block.settings, anchorID: block.settings.anchor_id, handle: block.settings.sourceHandle, index: forloop.index %}

              {%- when 'activity_banner' -%}
                  {% comment %} banner版块 {% endcomment %}
                  {% render 'five-kwh-banner', banner: block.settings, new_window: section.settings.new_window, index: forloop.index %}

              {%- when 'activity_video' -%}
                  {% comment %} 视频版块 {% endcomment %}
                  {% render 'five-kwh-video', settings: block.settings, index: forloop.index %}
              {%- when 'activity_modal' -%}
                  {% comment %} 通用弹窗按钮 {% endcomment %}
                  {% render 'common-modal-button',  block: block, index: forloop.index %}
              {% when 'activity_christmas' %}
                {%- render 'linshi-christams', schema_settings: block.settings -%}
              {% when 'activity_two' %}
                <div class="pdp-v4-content" {%if block.settings.anchor_id != blank%}anchor={{block.settings.anchor_id | escape}}{% endif %}>
                  {% render 'pdp-two-text-img', settings: block.settings, index: forloop.index %}
                </div>
              {% when 'activity_three' %}
                <div class="pdp-v4-content" {%if block.settings.anchor_id != blank%}anchor={{block.settings.anchor_id | escape}}{% endif %}>
                  {% render 'pdp-three-text-img', settings: block.settings, index: forloop.index %}
                </div>
              {%- when 'activity_img_text' -%}
                {% comment %} 图文版块 {% endcomment %}
                {%- render 'five-img-text',
                        settings: block.settings,
                        new_window: section.settings.new_window,
                        index: forloop.index
                -%}
              {% comment %} 视频/图片轮播版块 {% endcomment %}
              {%- when 'activity_swiper_two' -%}
                {%- render "five-kwh-swiper-two",settings: block.settings, new_window: section.settings.new_window -%}
              {%- when 'activity-matrix' -%}
                {% comment %} 灵活矩阵 {% endcomment %}
                <div class="activity-matrix section-matrix-graph" {%if block.settings.anchor_id != blank%}anchor={{block.settings.anchor_id | escape}}{% endif %}>
                  {% render 'matrix-graph', settings: block.settings, index: forloop.index %}
                </div>
              {%- when 'activity-card-text-img' -%}
                {% comment %} 单张卡片图文{% endcomment %}
                {% render 'pdp-card-text-img', settings: block.settings, index: forloop.index %}
              {%- when 'activity-animated-title' -%}
                {% comment %} 动效标题 {% endcomment %}
                <div class="activity-animated-title" {%if block.settings.anchor_id != blank%}anchor={{block.settings.anchor_id | escape}}{%endif%} data-index="{{ forloop.index }}">
                  {% render 'new-title-v2',
                          title: block.settings.title,
                          type: block.settings.type,
                          color: block.settings.title_color,
                          formId: block.settings.form_id,
                          bgColor: block.settings.bg_color
                  %}
                </div>
              {%- when 'activity-calculator' -%}
                {% comment %} 计算器 {% endcomment %}
                {% render 'pdp-calculator', settings: block.settings, index: forloop.index %}

              {%- when 'activity-scroll' -%}
                {% comment %} 滚动高亮 {% endcomment %}
                {% render 'scroll-high-light', settings: block.settings, index: forloop.index %}

              {%- when 'activity-pv-pic-text' -%}
                {% comment %} 光伏瓦图文组件 {% endcomment %}
                {% render 'activity-pv-image-text', settings: block.settings, index: forloop.index %}
            {%- endcase -%}
        {%- endfor -%}
    </div>
</div>

<script defer>
    (function() {
        const init = function() {
            const contentItem = document.querySelector('.activity-main-container .activity--content_item');
            const firstContentItem = contentItem ? contentItem.children[0] : null;
            const fiveKwhTab = document.querySelector('.five-kwh-tab');

            if (!firstContentItem || !fiveKwhTab) {
                return;
            }

            const contentHeight = firstContentItem.offsetHeight;
            const contentOffset = firstContentItem.getBoundingClientRect().top + window.scrollY;

            let ticking = false;
            const update = function() {
                const scrollPosition = window.scrollY || document.documentElement.scrollTop || 0;
                const isVisible = scrollPosition >= contentOffset + contentHeight * 0.8;

                if (isVisible) {
                    fiveKwhTab.classList.add('show-wrapper');
                    fiveKwhTab.classList.remove('hide-wrapper');
                } else {
                    fiveKwhTab.classList.add('hide-wrapper');
                    fiveKwhTab.classList.remove('show-wrapper');
                }

                const shouldShow = scrollPosition >= contentOffset + contentHeight * 0.5;
                fiveKwhTab.style.display = shouldShow ? 'block' : 'none';
            };

            const onScroll = function() {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(function() {
                    update();
                    ticking = false;
                });
            };

            update();
            window.addEventListener('scroll', onScroll, { passive: true });
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
{% comment %} Shopify活动版块 结束 {% endcomment %}


