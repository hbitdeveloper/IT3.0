 {%- assign blocks_app_size = section.blocks | where: 'type', "@app" | size -%}

{%- assign blocks_kwh_size = 0 -%}
{%- for block in section.blocks -%}
    {%- assign blocks_type = block.type -%}
    {%- if blocks_type contains 'five_kwh' -%}
        {%- assign blocks_kwh_size = blocks_kwh_size | plus: 1 -%}
    {%- endif -%}
{%- endfor -%}

{% comment %} Tab栏导航 {% endcomment %}
{%- assign tabs_num = 0 -%}
{%- assign tabs_list = '' -%}
{%- assign tabs_id = '' -%}

 {%- for block in section.blocks -%}
  {%- if block.settings.block_id != blank -%}
    {%- assign tabs_num = tabs_num | plus: 1 -%}
    {%- assign tabs_list = tabs_list | append: block.settings.block_id -%}
    {%- assign tabs_id = tabs_id | append: block.settings.anchor_id -%}
    {%- unless forloop.last -%}
      {%- assign tabs_list = tabs_list | append: '-' -%}
      {%- assign tabs_id = tabs_id | append: '-' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign bar_tran_w = 100 | divided_by: tabs_num -%}
{%- assign tabs_list = tabs_list | split: '-' -%}
{%- assign tabs_id = tabs_id | split: '-' -%}
{%- render 'five-kwh-tab',
        bar_tran_w: bar_tran_w,
        list: tabs_list,
        list_id: tabs_id,
        product_name: section.settings.product_name,
        product_buy_text: section.settings.product_buy_text,
        product_buy_link: section.settings.product_buy_link,
        new_window: section.settings.new_window
-%}
{% comment %} Tab栏导航 {% endcomment %}

{% comment %} 5度电各子版块 开始 {% endcomment %}
<div class="five-kwh--content" section-id="{{section.id}}"  style="background: {{ section.settings.bgColor }};">
    {%- if blocks_kwh_size > 0 -%}
      <div class="five_kwh--content_item">
        {%- for block in section.blocks -%}
          {%- assign blocks_type = block.type -%}
          {%- if blocks_type contains 'five_kwh' -%}
            {%- case block.type -%}
              {% comment %} 轮播版块 {% endcomment %}
              {%- when 'five_kwh_swiper_one' -%}
                {% render "five-kwh-swiper-one",settings: block.settings %}
              {% comment %} 视频/图片轮播版块 {% endcomment %}
              {%- when 'five_kwh_swiper_two' -%}
                {% render "five-kwh-swiper-two",settings: block.settings, new_window: section.settings.new_window %}
              {% comment %} 弹窗视频板块 {% endcomment %}
              {%- when 'five_kwh_apply' -%}
                {% render "five-kwh-apply",settings: block.settings, index: forloop.index, new_window: section.settings.new_window %}
              {% comment %} app视频版块 {% endcomment %}
              {%- when 'five_kwh_app_list' -%}
                {% render "five-kwh-app-list",settings: block.settings, index: forloop.index, new_window: section.settings.new_window %}
              {%- when 'five_kwh_compare' -%}
                {% assign compare = section.blocks | where: 'type', "five_kwh_compare" | first %}
                {% render 'five-kwh-compare', compare: compare, bgColor: section.settings.bgColor , new_window: section.settings.new_window %}
              {%- when 'five_kwh_3d' -%}
                {% render 'five-kwh-3d', imagethree: block, new_window: section.settings.new_window %}
              {%- when 'five_kwh_pick' -%}
                {% render 'five-kwh-pick', pick: block, new_window: section.settings.new_window %}
              {%- when 'five_kwh_video' -%}
                {% comment %} 视频版块 {% endcomment %}
                {% render 'five-kwh-video', settings: block.settings, index: forloop.index %}
              {%- when 'five_kwh_banner' -%}
                {% comment %} banner版块 {% endcomment %}
                {% render 'five-kwh-banner', banner: block.settings, new_window: section.settings.new_window%}
              {%- when 'five_kwh_scroll_trigger' -%}
                {% comment %} 滚动跑帧版块 {% endcomment %}
                {% render 'five-kwh-scroll-trigger', settings: block.settings, index: forloop.index %}
              {%- when 'five_kwh_subscribe' -%}
                {% comment %} 订阅版块 {% endcomment %}
                {% render 'five-kwh-subscribe', attributes:block.shopify_attributes, subscribe: block.settings, index: forloop.index %}
              {%- when 'five_kwh_media' -%}
                {% comment %} 媒体版块 {% endcomment %}
                {% render 'five-kwh-media', media: block.settings, index: forloop.index, new_window: section.settings.new_window %}
              {%- when 'five_kwh_letter' -%}
                {% comment %} 信任状 {% endcomment %}
                {% render 'five-kwh-letter', letter: block.settings, index: forloop.index %}
              {%- when 'five_kwh_common_button' -%}
                {% comment %} 通用按钮 {% endcomment %}
                {% render 'common-button', block: block %}
              {% when 'five_kwh_empty_block_box' %}
                {% comment %} 空盒子版块 {% endcomment %}
                {% render 'empty-block-box',settings: block.settings, anchorID: block.settings.anchor_id, handle: block.settings.sourceHandle, index: forloop.index %}

              {%- when 'five_kwh_product_videos' -%}
                {% comment %} 用户视频轮播列表 {% endcomment %}
                <div  class="section-five-find-out section-photovolatic-find-out" anchor="{{ block.settings.anchor_id | url_decode | strip | replace: ' ', ''}}" >
                  {%- render "product-detail-videos", settings: block.settings, new_window: section.settings.new_window,index: forloop.index -%}
                </div>
              {%- when 'five_kwh_img_text' -%}
                {% comment %} 图文版块 {% endcomment %}
                {%- render 'five-img-text',
                  settings: block.settings,
                  new_window: section.settings.new_window,
                  index: forloop.index
                -%}
              {%- when 'five_kwh_award' -%}
                {% comment %} 媒体背书 {% endcomment %}
                {% render 'index-award-new', award: block.settings , index: forloop.index %}

              {%- when 'five_kwh_textpic' -%}
                {% comment %} 左图右文 {% endcomment %}
                <div class=" product-media_highlight--block product-block-section">
                  {%- render "diy-scroll-textpic", settings: block.settings -%}
                </div>
              {%- when 'five_kwh_des' -%}
                {% comment %} 富文本版块 {% endcomment %}
                {%- render "activity-description", settings: block.settings -%}

              {%- when 'five_kwh_calculator' -%}
                {% comment %} 计算器 {% endcomment %}
                {% render 'pdp-calculator', settings: block.settings, index: forloop.index %}

              {% when 'five_kwh_three' %}
                {% comment %} 一行三组图文 {% endcomment %}
                <div class="pdp-v4-content">
                  {% render 'pdp-three-text-img', settings: block.settings, index: forloop.index %}
                </div>

              {%- when 'five_kwh_faq' -%}
                {% comment %} FAQ {% endcomment %}
                {% render 'indoor-faq', faq: block.settings, index: forloop.index %}
              {%- when 'five_kwh_dialog_box' -%}
                {% comment %} 对话动画版块 {% endcomment %}
                  {% render 'animate-text', attributes:block.shopify_attributes,  settings: block.settings, index: forloop.index %}
              {%- when 'five_kwh_app_subsribe' -%}
                {% comment %} 活动订阅 {% endcomment %}
                {%- render "activity-subscript", settings: block.settings,new_window: section.settings.new_window,index: forloop.index -%}
              {%- when 'five_kwh_balcony_quest' -%}
                {% comment %} 德国阳台发电站问卷 {% endcomment %}
                {%- render "de-balcony-power-questionnaire" -%}
            {%- endcase -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
</div>
{% comment %} 5度电各子版块 开始 {% endcomment %}
<script type="module">
  (function () {
    const init = function () {
      const contentItem = document.querySelector('.five-kwh--content .five_kwh--content_item');
      const fiveKwhTab = document.querySelector('.five-kwh-tab');

      if (!contentItem || !fiveKwhTab) return;

      const getFirstVisibleItem = () => {
        const children = Array.from(contentItem.children || []);
        for (let i = 0; i < children.length; i += 1) {
          const el = children[i];
          if (el && el.offsetHeight > 0) return el;
        }
        return contentItem.children && contentItem.children[0] ? contentItem.children[0] : null;
      };

      let firstContentItem = getFirstVisibleItem();

      let ticking = false;
      const update = function () {
        const scrollPosition = window.scrollY || document.documentElement.scrollTop || 0;
        if (!firstContentItem || firstContentItem.offsetHeight <= 0) {
          firstContentItem = getFirstVisibleItem();
        }
        const contentHeight = firstContentItem ? firstContentItem.offsetHeight || 0 : 0;
        if (!firstContentItem || contentHeight <= 0) {
          fiveKwhTab.classList.add('hide-wrapper');
          fiveKwhTab.classList.remove('show-wrapper');
          fiveKwhTab.style.display = 'none';
          return;
        }
        const contentOffset = firstContentItem.getBoundingClientRect().top + scrollPosition;
        const isVisible = scrollPosition >= contentOffset + contentHeight * 0.8;

        if (isVisible) {
          fiveKwhTab.classList.add('show-wrapper');
          fiveKwhTab.classList.remove('hide-wrapper');
        } else {
          fiveKwhTab.classList.add('hide-wrapper');
          fiveKwhTab.classList.remove('show-wrapper');
        }

        const shouldShow = scrollPosition >= contentOffset + contentHeight * 0.5;
        fiveKwhTab.style.display = shouldShow ? 'block' : 'none';
      };

      const onScroll = function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          update();
          ticking = false;
        });
      };

      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      window.addEventListener('load', onScroll, { passive: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
