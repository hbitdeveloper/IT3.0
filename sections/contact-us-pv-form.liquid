<style>
    .contact-us-form.pv {
        margin-top: 0;
    }

    .contact-us-form.pv .J-contact-titles-pv .title {
        color: rgb(51, 51, 51);
        font-size: 20px;
        font-weight: 700;
        line-height: 24px;
        text-align: left;
    }

    .contact-us-form.pv .J-contact-titles-pv .description {
        color: rgb(51, 51, 51);
        font-size: 16px;
        font-weight: 500;
        line-height: 24px;
        text-align: left;
        margin-bottom: 60px;
        margin-top: 20px;
    }

    .contact-us-form.pv .J-contact-tabs-pv {
        width: 100%;
        height: 48px;
        border-radius: 4px;
        background: rgb(238, 238, 238);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .contact-us-form.pv .J-contact-tabs-pv span {
        color: rgb(34, 34, 34);
        font-size: 20px;
        font-weight: 700;
        line-height: 18px;
    }

    .contact-us-form.pv .info-wrap {
        margin-top: 0;
    }

    .contact-us-form.pv .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        margin-top: 15px;
        margin-bottom: 30px;
    }

    .contact-us-form.pv .checkbox-group-title {
        font-size: 20px;
        font-weight: 700;
        line-height: 24px;
        margin: 20px 0;
    }

    .contact-us-form.pv .checkbox-item {
        display: flex;
        align-items: center;
        margin-right: 80px;
    }

    .contact-us-form.pv .form-box .form-wrap .row .form-item input[type="checkbox"] {
        width: 32px;
        height: 32px;
        margin-right: 20px;
    }

    .contact-us-form.pv .form-box .form-wrap .row .form-item .checkbox-item label {
        margin: 0;
    }

    .contact-us-form.pv .form-box .form-wrap .row .form-item label .error-msg {
        display: none;
        margin-left: 20px;
        font-size: 16px;
    }

    .contact-us-form.pv .form-box .form-wrap .row .form-item .checkbox-item label a {
        text-decoration: underline;
    }

    .contact-us-form.pv .form-box .form-wrap .row .form-item textarea {
        min-height: 144px;
    }

    .contact-us-form.pv .row.privacy {
        margin-top: 36px;
    }

    @media screen and (max-width: 768px) {
        .contact-us-form.pv .form-box .submit span {
            line-height: 10.6667vw !important;
        }
    }

    @media screen and (max-width: 1024px) {
        .contact-us-form.pv .J-contact-titles-pv {
            padding: 0 6.67vw;
        }

        .contact-us-form.pv .J-contact-titles-pv .title {
            font-size: 5vw;
            line-height: 6vw;
        }

        .contact-us-form.pv .J-contact-titles-pv .description {
            font-size: 4vw;
            line-height: 4.5vw;
        }

        .contact-us-form.pv .J-contact-tabs-pv {
            height: auto;
            padding: 2vw;
        }

        .contact-us-form.pv .J-contact-tabs-pv span {
            font-size: 4vw;
            padding: 2vw;
        }

        .contact-us-form.pv .checkbox-group-title {
            font-size: 4.2vw;
            margin-bottom: 4vw;
        }

        .contact-us-form.pv .checkbox-item {
            margin-bottom: 4vw;
        }
        .contact-us-form.pv .row.privacy label {
            line-height: 5vw;
        }
        .contact-us-form.pv .row.privacy .checkbox-item {
            margin-right: 0;
        }

        .contact-us-form.pv .form-box .form-wrap .row .form-item input[type="checkbox"] {
            margin-right: 3vw;
        }

        .contact-us-form.pv .form-box .form-wrap .row .form-item label .error-msg {
            font-size: 3.2vw;
        }

        .contact-us-form.pv .btn--loading:after {
            width: 20px;
            height: 20px;
            top: 9px;
        }
    }

    @media screen and (min-width: 1023.98px) {
        .contact-us-form.pv .J-contact-customer-submit-pv {
            line-height: 250% !important;
        }
        .contact-us-form.pv .btn--loading:after {
            top: 20px !important;
            width: 32px;
            height: 32px;
        }
    }

</style>

{% if settings.jky_theme_version == 'v5' %}
    <style>
        @media screen and (min-width: 1023.98px) {
            .contact-us-form.pv .form-box .submit span  {
                border-radius: 0;
                height: 3.5rem;
                font-size: 1.25rem;
                font-weight: 600;
                line-height: 280% !important;
                padding: 0 2.5rem;
            }
        }

        @media screen and (max-width: 1024px) {
            .contact-us-form.pv .form-box .submit span  {
                width: auto;
                border-radius: 0;
                height: 2.9375rem;
                padding: 0 1.125rem;
                font-size: 1.25rem;
                line-height: 2.75rem !important;
            }
        }
    </style>
{% endif %}

{% capture privacy_row %}
    <div class="row privacy">
        <div class="form-item">
            <div class="checkbox-item">
                <input type="checkbox" id="Contact_Privacy_Policy" name="Contact_Privacy_Policy"
                       value="1"/>
                <label for="Contact_Privacy_Policy">
                    <span>*</span>
                    {{ section.settings.agree_to }}
                </label>
            </div>
        </div>
    </div>
{% endcapture %}

{% capture email_input %}
    <div class="form-item">
        <label for="Contact_PV_Email">
            {{ section.settings.email }}
            <span>*</span>
            <span class="error-msg">{{ section.settings.invalid_email }}</span>
        </label>
        <input type="text" id="Contact_PV_Email" name="Contact_PV_Email"/>
    </div>
{% endcapture %}

<div class="contact-us-form pv index-container" data-agree-policy-text="{{ section.settings.agree_notice }}" data-push-success-text="{{ section.settings.push_success }}"
        data-push-error-text="{{ section.settings.push_error }}">
    <div class="form-wrap">
        <div class="J-contact-titles-pv">
            <div class="title">{{ section.settings.title }}</div>
            <div class="description">{{ section.settings.description }}</div>
        </div>
        <div class="J-contact-tabs-pv">
            <span>{{ section.settings.your_information }}</span>
        </div>
        <div class="form-box J-contact-form">
            <div class="customer-support J-customer-support active">
                {%- if section.settings.pv_form_type == 'company' -%}
                    <div class="form-wrap company">

                        <div class="row">
                            <div class="form-item">
                                <label for="Contact_PV_Name">
                                    {{ section.settings.company_name }}
                                    <span>*</span>
                                </label>
                                <input type="text" id="Contact_PV_Name" name="Contact_PV_Name"/>
                            </div>
                            <div class="form-item">
                                <label for="Contact_Company_Addr">
                                    {{ section.settings.company_address }}
                                    <span>*</span>
                                </label>
                                <input type="text" id="Contact_Company_Addr" name="Contact_Company_Addr"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-item">
                                <label for="Contact_Company_Industry">
                                    {{ section.settings.industry }}
                                    <span>*</span>
                                </label>
                                <input type="text" id="Contact_Company_Industry" name="Contact_Company_Industry"/>
                            </div>
                            <div class="form-item">
                                <label for="Contact_Company_Industry_Name">
                                    {{ section.settings.name }}
                                    <span>*</span>
                                </label>
                                <input type="text" id="Contact_Company_Industry_Name"
                                       name="Contact_Company_Industry_Name"/>
                            </div>
                        </div>

                        <div class="row">
                            {{ email_input }}
                            <div class="form-item">
                                <label for="Contact_PV_Phone">
                                    {{ section.settings.phone }}
                                    <span>*</span>
                                </label>
                                <input type="text" id="Contact_PV_Phone" name="Contact_PV_Phone"
                                       maxlength="50"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-item">
                                <label for="Contact_PV_Country">
                                    {{ section.settings.country }}
                                </label>
                                <input type="text" id="Contact_PV_Country" name="Contact_PV_Country"/>
                            </div>
                            <div class="form-item">
                                <label for="Contact_PV_City">
                                    {{ section.settings.city }}
                                </label>
                                <input type="text" id="Contact_PV_City" name="Contact_PV_City"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-item">
                                <div class="checkbox-group-title">{{ section.settings.cooperation_intention }}</div>
                                <label for="Contact_Company_Interest">
                                    {{ section.settings.preferred_cooperation }}
                                </label>
                                <div class="checkbox-group">
                                    <div class="checkbox-item">
                                        <input type="checkbox" id="Contact_Company_Interest_1"
                                               name="Contact_Company_Interest"
                                               value="{{ section.settings.government }}"/>
                                        <label for="Contact_Company_Interest_1">{{ section.settings.government }}</label>
                                    </div>
                                    <div class="checkbox-item">
                                        <input type="checkbox" id="Contact_Company_Interest_2"
                                               name="Contact_Company_Interest"
                                               value="{{ section.settings.sales_attribution }}"/>
                                        <label for="Contact_Company_Interest_2">{{ section.settings.sales_attribution }}</label>
                                    </div>
                                    <div class="checkbox-item">
                                        <input type="checkbox" id="Contact_Company_Interest_3"
                                               name="Contact_Company_Interest"
                                               value="{{ section.settings.international_service }}"/>
                                        <label for="Contact_Company_Interest_3">{{ section.settings.international_service }}</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-item">
                                <label for="Contact_PV_Message">
                                    {{ section.settings.project_description }}
                                </label>
                                <textarea id="Contact_PV_Message" name="Contact_PV_Message"
                                          style="resize: vertical;" maxlength="1000"></textarea>
                            </div>
                        </div>

                        {{ privacy_row }}

                    </div>
                {%- endif -%}
                {%- if section.settings.pv_form_type == 'consumer' -%}
                    <div class="form-wrap">

                        <div class="row">
                            <div class="form-item">
                                <label for="Contact_PV_Name">
                                    {{ section.settings.full_name }}
                                    <span>*</span>
                                </label>
                                <input type="text" id="Contact_PV_Name" name="Contact_PV_Name"/>
                            </div>
                            {{ email_input }}
                        </div>

                        <div class="row">
                            <div class="form-item">
                                <label for="Contact_PV_Phone">
                                    {{ section.settings.phone_number }}
                                    <span>*</span>
                                </label>
                                <input type="text" id="Contact_PV_Phone" name="Contact_PV_Phone"
                                       maxlength="50"/>
                            </div>
                            <div class="form-item">
                                <label for="Contact_PV_Country">
                                    {{ section.settings.country }}
                                </label>
                                <input type="text" id="Contact_PV_Country" name="Contact_PV_Country"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-item">
                                <label for="Contact_PV_City">
                                    {{ section.settings.city }}
                                </label>
                                <input type="text" id="Contact_PV_City" name="Contact_PV_City"/>
                            </div>
                            <div class="form-item">
                                <label for="Contact_Detail_Addr">
                                    {{ section.settings.detailed_addr }}
                                </label>
                                <input type="text" id="Contact_Detail_Addr" name="Contact_Detail_Addr"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-item">
                                <label for="Contact_Build_Type">
                                    {{ section.settings.building_type }}
                                </label>
                                <input type="text" id="Contact_Build_Type" name="Contact_Build_Type"/>
                            </div>
                            <div class="form-item">
                                <label for="Contact_Build_Area">
                                    {{ section.settings.root_area }}
                                </label>
                                <input type="text" id="Contact_Build_Area" name="Contact_Build_Area"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-item">
                                <label for="Contact_PV_Message">
                                    {{ section.settings.project_description }}
                                </label>
                                <textarea id="Contact_PV_Message" name="Contact_PV_Message"
                                          style="resize: vertical;" maxlength="1000"></textarea>
                            </div>
                        </div>

                        {{ privacy_row }}

                    </div>
                {%- endif -%}
                <div class="submit">
                    <span class="J-contact-customer-submit-pv">{{ section.settings.submit_btn }}</span>
                </div>

            </div>
        </div>
    </div>
    <div class="info-wrap">
        {% assign contact_item = section.blocks | where: 'type', "contact-info" %}
        {% if contact_item.size > 0 %}
            {% for block in contact_item %}
                <div class="contact-info-item">
                    <div class="title">{{ block.settings.contact_item_title }}</div>
                    <div class="text">{{ block.settings.contact_item_value | newline_to_br }}</div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

<script src="{{ 'jquery-3.6.4.min.js' | asset_url }}" data-cookieconsent="ignore" defer></script>
<script type="module">
    document.addEventListener('DOMContentLoaded', function () {
        const isCompanyForm = "{{ section.settings.pv_form_type }}" === 'company';
        const recipientEmail = "{{ section.settings.recipient_email }}";

        const required = [
            '#Contact_PV_Name',
            '#Contact_Company_Addr',
            '#Contact_Company_Industry',
            '#Contact_Company_Industry_Name',
            '#Contact_PV_Email',
            '#Contact_PV_Phone'
        ];

        function validate() {
            let ok = true;
            required.forEach(sel => {
                const $el = $(sel);
                if ($el.length && !$el.val().trim()) {
                    ok = false;
                    $el.addClass('red');
                } else {
                    $el.removeClass('red');
                }
            });
            checkEmailFormat($('.contact-us-form.pv #Contact_PV_Email'))
            return ok;
        }

        function buildHtmlBody() {
            const rows = [];

            $('.contact-us-form.pv input[type="text"], textarea').each(function () {
                const $el = $(this);
                const label = $el.prev('label').clone().find('span').remove().end().text().trim();
                const val = $el.val().trim() || '';
                if (label) {
                    rows.push(`<tr><td>${label}</td><td>${escapeHtml(val)}</td></tr>`);
                }
            });

            if (isCompanyForm) {
                const checked = $('input[name="Contact_Company_Interest"]:checked').map((_, el) => $(el).val()).get();
                const label = document.querySelector('.contact-us-form.pv label[for="Contact_Company_Interest"]').textContent.trim();
                rows.push(`<tr><td>${label}</td><td>${checked.join(', ') || '&nbsp;'}</td></tr>`);
            }

            return `<html>
              <table border="1" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
                <tbody>${rows.join('')}</tbody>
              </table></html>`;
        }

        function escapeHtml(str) {
            return $('<div>').text(str).html();
        }

        function checkEmailFormat($el) {
            if (/^[A-Za-z0-9._%+!`#$^-]+@([A-Za-z0-9-]+\.)+[A-Za-z]{2,8}$/.test($el.val().trim())) {
                $el.removeClass('red');
                $('.contact-us-form.pv .form-item label[for="Contact_PV_Email"] .error-msg').hide();
            } else {
                $el.addClass('red');
                $('.contact-us-form.pv .form-item label[for="Contact_PV_Email"] .error-msg').show();
            }
        }

        $('.contact-us-form.pv #Contact_PV_Email').on('input', function () {
            const $el = $(this);
            checkEmailFormat($el);
        });

        $('.contact-us-form.pv .J-contact-customer-submit-pv').on('click', function () {

            if (!validate()) return;

            if (!$('#Contact_Privacy_Policy').is(':checked')) {
                pushErrorMessage($(".contact-us-form.pv").data("agreePolicyText"));
                return;
            }

            const subject = '光伏瓦页面Contact Us表单信息收集 —— ' + (isCompanyForm ? '公司用户' : '个人用户');
            const payload = {
                content: buildHtmlBody(),
                html: true,
                recipient: recipientEmail,
                applyUser: $('#Contact_PV_Email').val(),
                subject: subject,
            };

            const $btn = $(this).addClass('btn--loading');

            $.ajax({
                url: window.pageInfo.api + '/osconsumerapi/v1/com/v2/email/forward',
                type: 'POST',
                data: JSON.stringify(payload),
                contentType: 'application/json',
                success(res) {
                    $btn.removeClass('btn--loading');
                    if (res.code === 30001) {
                        pushErrorMessage(res.message);
                    } else {
                        pushSuccessMessage($(".contact-us-form.pv").data("pushSuccessText"));
                    }
                },
                error(xhr) {
                    pushErrorMessage($(".contact-us-form.pv").data("pushErrorText"));
                    console.error(xhr);
                    $btn.removeClass('btn--loading');
                }
            });
        });
    });
</script>

{% schema %}
{
  "name": "contact us pv form",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "pv_form_type",
      "label": "PV Form Type",
      "options": [
        {
          "value": "company",
          "label": "Company"
        },
        {
          "value": "consumer",
          "label": "Consumer"
        }
      ],
      "default": "company"
    },
    {
      "type": "text",
      "id": "recipient_email",
      "label": "Recipient Email",
      "info": "If you want to send to multiple recipients, please use a ',' to separate their emails.",
    },
    {
      "type": "text",
      "id": "title",
      "label": "Form Title",
      "default": "Explore the Boundless Potential of Solar"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Form Description",
      "default": "<p>Be a part of the green energy revolution and help shape the future of technology with us. Please provide your contact details, and our partnership team will get in touch soon to explore customized collaboration opportunities.</p>"
    },
    { "type": "text", "id": "your_information", "label": "Your Information", "default": "Your Information" },
    { "type": "text", "id": "company_name", "label": "Company Name", "default": "Company Name", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "company_address", "label": "Company Address", "default": "Company Address", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "industry", "label": "Industry", "default": "Industry", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "name", "label": "Name", "default": "Name", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "full_name", "label": "Full Name", "default": "Full Name", "visible_if": "{{ section.settings.pv_form_type == 'consumer' }}" },
    { "type": "text", "id": "email", "label": "Email", "default": "Email" },
    { "type": "text", "id": "invalid_email", "label": "Invalid Email Notice", "default": "Invalid Email Address" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "Phone", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "phone_number", "label": "Phone Number", "default": "Phone Number", "visible_if": "{{ section.settings.pv_form_type == 'consumer' }}" },
    { "type": "text", "id": "country", "label": "Country", "default": "Country/Region" },
    { "type": "text", "id": "city", "label": "City", "default": "City" },
    { "type": "text", "id": "cooperation_intention", "label": "Cooperation intention", "default": "Cooperation intention", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "preferred_cooperation", "label": "Preferred Cooperation", "default": "Preferred Cooperation?", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "government", "label": "Government", "default": "Government", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "sales_attribution", "label": "Sales attribution", "default": "Sales attribution", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "international_service", "label": "International Service", "default": "International Service", "visible_if": "{{ section.settings.pv_form_type == 'company' }}" },
    { "type": "text", "id": "detailed_addr", "label": "Detailed Address", "default": "Detailed Address", "visible_if": "{{ section.settings.pv_form_type == 'consumer' }}" },
    { "type": "text", "id": "building_type", "label": "Building Type", "default": "Building Type", "visible_if": "{{ section.settings.pv_form_type == 'consumer' }}" },
    { "type": "text", "id": "root_area", "label": "Roof Area", "default": "Roof Area(ft²)", "visible_if": "{{ section.settings.pv_form_type == 'consumer' }}" },
    { "type": "text", "id": "project_description", "label": "Project Description", "default": "Project Description" },
    { "type": "inline_richtext", "id": "agree_to", "label": "I Agree to", "default": "I agree to Jackery's <a href=\"/policies/terms-of-service\" title=\"/policies/terms-of-service\">Terms of Service</a> and <a href=\"/policies/privacy-policy\" title=\"/policies/privacy-policy\">Privacy Policy</a>" },
    { "type": "text", "id": "submit_btn", "label": "Submit Button", "default": "Submit" },
    { "type": "text", "id": "agree_notice", "label": "Agree Policy Notice", "default": "Please agree to the Terms of Service and Privacy Policy." },
    { "type": "text", "id": "push_success", "label": "Push Success Message", "default": "Your message has been successfully sent. We’ll get back to you as soon as possible." },
    { "type": "text", "id": "push_error", "label": "Push Error Message", "default": "Woops! Something went wrong. Please try another way." }
  ],
  "blocks": [
    {
      "type": "contact-info",
      "name": "Contact Item",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "contact_item_title",
          "label": "Contact Title"
        },
        {
          "type": "textarea",
          "id": "contact_item_value",
          "label": "Contact Message"
        }
      ]
    }
  ]
}
{% endschema %}
