{% comment %} jackery-life 活动 introduction {% endcomment %}
<section class="w-full px-30 py-64 bg-#F6F5F5 lg:j-px-0 lg:j-py-96 xl:a-px-0 xl:a-py-96">
  <div class="lg:j-w-1200 xl:a-w-1200 mx-auto">
    <h2 class="life-activity-title mb-60 lg:j-mb-40 xl:a-mb-40">{{ section.settings.title | escape }}</h2>
    <div class="w-full bg-white rounded-tl-75 py-48 lg:j-rounded-tl-75 lg:j-py-48 xl:a-rounded-tl-75 xl:a-py-48">
      <div class="px-32 lg:j-px-120 lg:j-max-h-504 xl:a-px-120 xl:a-max-h-504 overflow-y-auto">
        <p class="
          text-28 leading-36 text-#666 mb-27 font-normal
          lg:j-text-16 lg:j-leading-24 lg:j-mb-16 lg:text-#333
          xl:a-text-16 xl:a-leading-24 xl:a-mb-16 xl:text-#333
        ">{{ section.settings.description | ewline_to_br }}</p>
        <div class="max-h-462 gap-32 flex flex-col lg:j-gap-24 xl:a-gap-24">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'faq_item' %}
              <dl>
                <dt class="text-28 leading-36 lg:j-text-20 lg:j-leading-24 xl:a-text-20 xl:a-leading-24 text-#333 font-semibold">{{ block.settings.question | newline_to_br }}</dt>
                <dd class="text-28 leading-36 lg:j-text-16 lg:j-leading-24 xl:a-text-16 xl:a-leading-24 text-#333 font-normal">{{ block.settings.answer | newline_to_br }}</dd>
              </dl>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
    {% if section.settings.show_button %}
      <div class="lg:j-w-1200 xl:a-w-1200 mx-auto flex-center mt-64 lg:j-mt-64 xl:a-mt-64">
        <div
          class="
            inline-flex flex-center min-w-280 h-80 text-28 border-3 border-solid border-primary bg-primary
            text-white rounded-full font-semibold cursor-pointer
            lg:j-min-w-240 lg:j-h-56 lg:j-text-24 lg:j-border-2
            xl:a-min-w-240 xl:a-h-56 xl:a-text-24 xl:a-border-2
          "
          data-link="{{ section.settings.btn_link | escape }}"
          data-share-now
        >
          {{ section.settings.btn_text | escape }}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
  {
    "name": "Life Activity Intro",
    "class": "section-life-activity section-life-activity-introduction",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Introduction Title",
        "default": "Activity Introduction"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Introduction Description",
        "default": "Welcome to Jackery Life! We are committed to creating an active community where you can share your photos and videos, become an advocate for a sustainable lifestyle, and inspire more people to focus on environmental protection and sustainable development. You will also have the opportunity to meet like-minded friends and discover interesting green lifestyles around the world."
      },
      {
        "type": "checkbox",
        "id": "show_button",
        "label": "Show Button",
        "default": false
      },
      {
        "type": "text",
        "id": "btn_text",
        "label": "Button Text",
        "default": "SHARE NOW"
      },
      {
        "type": "url",
        "id": "btn_link",
        "label": "Button Link"
      }
    ],
    "blocks": [
      {
        "type": "faq_item",
        "name": "Introduction Item",
        "settings": [
          {
            "type": "textarea",
            "id": "question",
            "label": "Question"
          }, {
            "type": "textarea",
            "id": "answer",
            "label": "Answer"
          }
        ]
      }
    ]
  }
{% endschema %}
