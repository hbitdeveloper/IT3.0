{% comment %} Shopify组件 {% endcomment %}
{%- assign blocks_activity_size = 0 -%}
{%- for block in section.blocks -%}
    {%- assign blocks_type = block.type -%}
    {%- assign blocks_activity_size = blocks_activity_size | plus: 1 -%}
{%- endfor -%}

{% comment %} Tab栏导航 {% endcomment %}
{%- assign tabs_num = 0 -%}
{%- assign tabs_list = '' -%}
{%- assign tabs_id = '' -%}

{%- for block in section.blocks -%}
    {%- if block.settings.anchor != blank -%}
        {%- assign tabs_num = tabs_num | plus: 1 -%}
        {%- assign tabs_list = tabs_list | append: block.settings.anchor -%}
        {%- assign tabs_id = tabs_id | append: block.settings.anchor_id -%}
        {%- unless forloop.last -%}
            {%- assign tabs_list = tabs_list | append: '-' -%}
            {%- assign tabs_id = tabs_id | append: '-' -%}
        {%- endunless -%}
    {%- endif -%}
{%- endfor -%}
{%- assign bar_tran_w = 100 | divided_by: tabs_num -%}
{%- assign tabs_list = tabs_list | split: '-' -%}
{%- assign tabs_id = tabs_id | split: '-' -%}
{%- render 'five-kwh-tab',
        bar_tran_w: bar_tran_w,
        list: tabs_list,
        list_id: tabs_id
-%}
{% comment %} Tab栏导航 {% endcomment %}
{% comment %} 自定义新人教育页 {% endcomment %}
<div class="five-kwh--content">
    <div class="newcomer--content_item">
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {% comment %} 空盒子版块 {% endcomment %}
                {% when 'empty-block-box' %}
                    {% render 'empty-block-box',settings: block.settings, anchorID: block.settings.anchor_id, handle: block.settings.sourceHandle, index: forloop.index %}
                {% comment %} 动效标题 {% endcomment %}
                {%- when 'animated-title' -%}
                    <div class="animated-title" {%if block.settings.anchor_id != blank%}anchor={{block.settings.anchor_id | escape}}{%endif%} data-index="{{ forloop.index }}">
                        {% render 'new-title-v2',
                                title: block.settings.title,
                                type: block.settings.type,
                                color: block.settings.title_color,
                                formId: block.settings.form_id,
                                bgColor: block.settings.bg_color
                        %}
                    </div>
                {% comment %} 维护介绍组件 {% endcomment %}
                {%- when 'newcomer-recharge' -%}
                    {% render 'newcomer-recharge',settings: block.settings, anchorID: block.settings.anchor_id, index: forloop.index %}

                {% comment %} 使用介绍组件 {% endcomment %}
                {%- when 'newcomer-use' -%}
                    {% render 'newcomer-use',settings: block.settings, anchorID: block.settings.anchor_id, index: forloop.index %}

                {% comment %} 使用介绍组件 {% endcomment %}
                {%- when 'newcomer-maintain' -%}
                  {% render 'newcomer-maintain',settings: block.settings, anchorID: block.settings.anchor_id, index: forloop.index %}

                {% comment %} 功能按钮组件 {% endcomment %}
                {%- when 'newcomer-edu-buttons' -%}
                  {% render 'newcomer-buttons',settings: block.settings, anchorID: block.settings.anchor_id, index: forloop.index, new_window: section.settings.new_window %}

                {% comment %} 智能选购入口 {% endcomment %}
                  {%- when 'newcomer-edu-smart' -%}
                  {% render 'newcomer-smart',settings: block.settings, anchorID: block.settings.anchor_id, index: forloop.index, new_window: section.settings.new_window %}

                {% comment %} 电器设备功率 {% endcomment %}
                {%- when 'newcomer-find-power' -%}
                  {% render 'newcomer-find-power',settings: block.settings, anchorID: block.settings.anchor_id, index: forloop.index %}

                {% comment %} 设备储能 {% endcomment %}
                {%- when 'newcomer-higher-output' -%}
                  {% render 'newcomer-higher-output',settings: block.settings, anchorID: block.settings.anchor_id, index: forloop.index %}

                {% comment %} 储能估算 {% endcomment %}
                {%- when 'newcomer-calculator' -%}
                  {% render 'newcomer-calculator',settings: block.settings, anchorID: block.settings.anchor_id, index: forloop.index %}

                {% comment %} 智能选购 {% endcomment %}
                {%- when 'newcomer-smart-recommend' -%}
                  <div class="smart-box" style="background: {{ block.settings.bg_color }}">
                   {% render 'smart-recommend-block',smart: block.settings, anchorID: block.settings.anchor_id, index: forloop.index %}
                  </div>

                {% comment %} 智能选购下面的按钮文案部分 {% endcomment %}
                {%- when 'newcomer-smart-bottom' -%}
                <div class="smart-box" style="background: {{ block.settings.bg_color }}">
                  {% render 'newcomer-smart-btn',settings: block.settings, index: forloop.index %}
                </div>
            {%- endcase -%}
        {% endfor %}
    </div>
</div>
	<script defer>
        (function() {
            const init = function() {
                const contentItem = document.querySelector('.newcomer--content_item');
                const firstContentItem = contentItem ? contentItem.children[0] : null;
                const fiveKwhTab = document.querySelector('.five-kwh-tab');

                if (firstContentItem && fiveKwhTab) {
                    const contentHeight = firstContentItem.offsetHeight;
                    const contentOffset = firstContentItem.getBoundingClientRect().top + window.scrollY;

                    let ticking = false;
                    const update = function() {
                        const scrollPosition = window.scrollY || document.documentElement.scrollTop || 0;
                        const isVisible = scrollPosition >= contentOffset + contentHeight * 0.8;

                        if (isVisible) {
                            fiveKwhTab.classList.add('show-wrapper');
                            fiveKwhTab.classList.remove('hide-wrapper');
                        } else {
                            fiveKwhTab.classList.add('hide-wrapper');
                            fiveKwhTab.classList.remove('show-wrapper');
                        }

                        const shouldShow = scrollPosition >= contentOffset + contentHeight * 0.5;
                        fiveKwhTab.style.display = shouldShow ? 'block' : 'none';
                    };

                    const onScroll = function() {
                        if (ticking) return;
                        ticking = true;
                        requestAnimationFrame(function() {
                            update();
                            ticking = false;
                        });
                    };

                    update();
                    window.addEventListener('scroll', onScroll, { passive: true });
                }

                window.dataLayer = window.dataLayer || [];

                //功能按钮组件埋点
                document.querySelectorAll('.newcomer-education-buttons a').forEach(function(linkEl) {
                    linkEl.addEventListener('click', function() {
                        const currentHref = this.getAttribute('href');
                        const button_name = (this.textContent || '').trim();

                        const buttonsWrap = document.querySelector('.newcomer-education-buttons');
                        let module = '';
                        if (buttonsWrap) {
                            let prev = buttonsWrap.previousElementSibling;
                            while (prev) {
                                if (prev.classList && prev.classList.contains('animated-title')) {
                                    module = (prev.querySelector('.text')?.textContent || '').trim();
                                    break;
                                }
                                prev = prev.previousElementSibling;
                            }
                        }

                        let params ={
                          link: currentHref,
                          button_name: button_name,
                          module: module
                        }
                        gaPushDataLayer('new_education_user_clicks', params);
                    });
                });
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();


    </script>
