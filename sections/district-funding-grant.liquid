{% schema %}
{
  "name": "district-funding-grant",
  "tag": "section",
  "class": "district-funding-grant",
  "settings": [
    {
      "type": "text",
      "id": "districtTitle",
      "label": "District Title",
      "default": "A Guide to District Funding Grants "
    },
    {
      "type": "richtext",
      "id": "districtSub",
      "label": "District Description",
      "default": "<p>Note: This information was correct at the time the article was written. We therefore accept no liability for funding conditions that change at short notice or offers that are no longer available. The subsidy amount provided here is for reference only. For accurate subsidy information, please refer to government policies and visit https://www.homeandsmart.de/balkonkraftwerk-foerderung</p>"
    }
  ]
}
{% endschema %}
<div class="district-grant-container section-container">
    {% if section.settings.districtTitle != blank%}
        <div class="district-title">{{ section.settings.districtTitle }}</div>
    {% endif %}
    <div class="district-grant-body">
        <div class="district-grant-top">
            <div class="district-grant-country">
            </div>
            <div class="district-grant-change">
                <div class="custom-arrow swiper-button-prev"></div>
                <div class="custom-arrow swiper-button-next"></div>
            </div>
        </div>
        <div class="district-grant-bottom">
            <div class="district-grant-description">
            </div>
        </div>
    </div>
    {% if section.settings.districtSub != blank%}
        <div class="district-description">{{ section.settings.districtSub }}</div>
    {% endif %}
</div>
