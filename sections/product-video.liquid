{%- if section.settings.feature_video_1 != blank or section.settings.feature_video_poster != blank -%}
    <div {% if section.settings.anchor != blank %} data-anchor="{{section.settings.anchor}}" {% endif %} class="product-video-text-wrap section-container relative product-b {% if section.settings.section_type %} product-p-t{% endif %}">
        {%- render 'jky-video', video_url: section.settings.feature_video_1, poster: section.settings.feature_video_poster, title: product.title, class: section.id, autoplay: false, controls: true, loop: false -%}
    </div>
{%- endif -%}

{% schema %}
{
    "name": "product video", "class": "product-video-wrap product-section-block", "tag": "div",
    "enabled_on": {
      "templates": ["product"]
    },
    "settings": [
        {
          "type": "checkbox",
          "id": "section_type",
          "default": true,
          "label": "是否为大版块？",
          "info": "大版块与上一个模块之间间距大，小版块与上一模块间距较小"
        },
        {
            "type": "select",
            "id": "anchor",
            "label": "锚点设置",
            "info": "非锚点section请清空此项",
            "options": [
                {
                "value": "",
                "label": "非锚点section"
                },
                {
                "value": "anchor__1",
                "label": "第一个section锚点"
                },
                {
                "value": "anchor__2",
                "label": "第二个section锚点"
                },
                {
                "value": "anchor__3",
                "label": "第三个section锚点"
                },
                {
                "value": "anchor__4",
                "label": "第四个section锚点"
                }
            ],
            "default": ""
        },
        {
            "type": "url", "id": "feature_video_1", "label": "feature main video"
        },
        {
            "type": "image_picker", "id": "feature_video_poster", "label": "feature video poster", "info": "尺寸建议16：9 按照视频比例"
        }
    ],
    "presets": [{
        "name": "product video section"
    }]
}
{% endschema %}