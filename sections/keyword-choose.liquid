<script type="module">
  function initContentRightSwiper(target) {
    var swiper1 = new Swiper('#' + target, {
      slidesPerView: 2,
      spaceBetween: 15,
      noSwiping: false,
      pagination: {
        el: '#custom_kc_swiper_page',
        type: 'custom',
        renderCustom: function (swiper, current, total) {
          var paginationHtml = '';
          for (var i = 1; i <= total; i++) {
            // 判断是否是激活焦点，是的话添加active类，不是就只添加基本样式类
            if (i === current) {
              paginationHtml +=
                '<span class="kc-swiper-pagination-customs kc-swiper-pagination-customs-active"></span>';
            } else {
              paginationHtml += '<span class="kc-swiper-pagination-customs"></span>';
            }
          }
          return paginationHtml;
        },
      },
    });
  }

  function initPcContentRightSwiper(target) {
    const swiperWrapper = document.querySelector('#' + target + ' .swiper-wrapper');
    const ddElements = swiperWrapper ? swiperWrapper.querySelectorAll('dd') : [];
    const ddLenght = ddElements.length;
    if(ddLenght <= 0) {
      return;
    }

    let slidesPerView = 1;
    if (ddLenght >= 4) {
      slidesPerView = 4;
    } else {
      slidesPerView = ddLenght;
    }

    var swiper2 = new Swiper('#' + target, {
      slidesPerView: slidesPerView,
      spaceBetween: 15,
      noSwiping: false,
      pagination: {
        el: '#custom_pc_kc_swiper_page',
        type: 'custom',
        renderCustom: function (swiper, current, total) {
          var paginationHtml = '';
          if(total > 1) {
            for (var i = 1; i <= total; i++) {
              // 判断是否是激活焦点，是的话添加active类，不是就只添加基本样式类
              if (i === current) {
                paginationHtml +=
                  '<span class="kc-pc-swiper-pagination-customs kc-pc-swiper-pagination-customs-active"></span>';
              } else {
                paginationHtml += '<span class="kc-pc-swiper-pagination-customs"></span>';
              }
            }
          }
          return paginationHtml;
        },
      },
    });
  }

  function keyWordChooseInit() {
    const activeTab = document.querySelector('.keyword-choose-tabs .tab-active');
    const targetID = activeTab ? activeTab.dataset.target_id : '';
    const pcTargetId = activeTab ? activeTab.dataset.pc_target_id : '';
    initContentRightSwiper(targetID);
    initPcContentRightSwiper(pcTargetId);

    const tabItems = document.querySelectorAll('.keyword-choose-tabs .tab-item');
    tabItems.forEach(function (tabItem) {
      tabItem.addEventListener('click', function (e) {
        // 移除所有tab的active类
        tabItems.forEach(function (item) {
          item.classList.remove('tab-active');
        });
        // 为当前点击的tab添加active类
        e.target.classList.add('tab-active');

        const contentId = e.target.dataset.content_id;
        // 移除所有内容的show类
        const contentShows = document.querySelectorAll('.choose-swiper-main .kc-content-show');
        contentShows.forEach(function (content) {
          content.classList.remove('kc-content-show');
        });
        // 为当前内容添加show类
        const currentContent = document.getElementById(contentId);
        if (currentContent) currentContent.classList.add('kc-content-show');

        const target_id = e.target.dataset.target_id;
        const pcTargetId = e.target.dataset.pc_target_id;
        initContentRightSwiper(target_id);
        initPcContentRightSwiper(pcTargetId);
      });
    });

    const rightHeaderLinks = document.querySelectorAll('.right-header a');
    rightHeaderLinks.forEach(function (link) {
      link.addEventListener('click', function (e) {
        if (e.target.localName == 'span') {
          return;
        }

        const targetDom = e.target;
        const href = targetDom.dataset.href;
        const title = targetDom.dataset.title;
        const position_index = targetDom.dataset.position_index;

        window.dataLayer.push({ event_parameters: null });
        const activeTab = document.querySelector('.keyword-choose-tabs .tab-active');
        window.dataLayer.push({
          event: 'ga4Event',
          event_name: 'learn_more',
          event_parameters: {
            current_page: location.pathname,
            first_nav_title: activeTab ? activeTab.textContent.trim() : '',
            first_nav_title_position: activeTab ? activeTab.dataset.position_index : '',
            product_name: title,
            product_position: position_index,
            product_ur: href,
          },
        });

        window.open(href, "_blank");
      });
    });
  }

  window.addEventListener('DOMContentLoaded', function () {
    keyWordChooseInit();
  });
</script>
