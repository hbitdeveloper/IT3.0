{%- style -%}
  .section-keyword-choose {
    margin-bottom: 6.3021vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }

  .keyword-choose-title {
    font-size: 2.3438vw;
    font-weight: 600;
    color: #000000;
    padding-top: 4.6875vw;
    padding-bottom: 3.3854vw;
    text-align: center;
  }

  .keyword-choose-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.0417vw;
  }

  .keyword-choose-remark {
    font-size: 0.9375vw;
    font-weight: 400;
    color: #333333;
    padding-top: 3.3854vw;
  }

  .keyword-choose-tabs .tab-item {
    border: 0.0521vw solid #999999;
    display: flex;
    font-size: 1.3542vw;
    font-weight: 500;
    color: #333333;
    justify-content: center;
    align-items: center;
    border-radius: var(--theme-btn-border-radius,0.4167vw);
    cursor: pointer;
    padding: 0.6771vw 0.8854vw;
  }

  .keyword-choose-tabs .tab-active {
    background: var(--primary-color);
    color: #ffffff;
  }

  .choose-swiper-main {
    padding-top: 3.6458vw;
  }

  .choose-swiper-main .keyword-choose-content {
    display: none;
    opacity: 0;
  }

  .choose-swiper-main .kc-content-show {
    display: flex;
    opacity: 1;
    transition: opacity 1s ease;
  }

  .keyword-choose-content .content-left {
    max-width: 12.2396vw;
  }

  .keyword-choose-content .content-left dd {
    display: flex;
    flex-direction: column;
  }

  .keyword-choose-content .content-left dd .left-header {
    text-align: center;
    margin-bottom: 2.8646vw;
    height: 9.375vw;
  }
  .keyword-choose-content .content-left dd .left-header .header-image {
    display: inline-block;
    max-width: 9.6354vw;
    max-height: 6.7708vw;
  }
  .keyword-choose-content .content-left dd .left-header .header-image-m {
    display: none;
  }

  .keyword-choose-content .content-left dd .left-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 8.125vw;
  }

  .keyword-choose-content .content-left dd .left-body .body-icon-img {
    width: 4.1667vw;
    height: 4.1667vw;
  }

  .keyword-choose-content .content-left dd .left-body .body-icon-subtitle {
    padding-top: 0.625vw;
    text-align: center;
    font-size: 0.9375vw;
    font-weight: 500;
    color: #333333;
    line-height: 1.0417vw;
  }

  .keyword-choose-content .content-right {
    margin-left: 3.9063vw;
    display: flex;
    flex-direction: row;
  }

  .keyword-choose-content .content-right-m {
    display: none;
  }

  .keyword-choose-content .content-right dd {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin-right: 3.6458vw;
  }

  .keyword-choose-content .content-right dd .right-header {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 2.8646vw;
    height: 9.375vw;
  }

  .keyword-choose-content .content-right dd .right-header img {
    max-height: 6.6667vw;
    max-width: 12.3958vw;
    margin-bottom: 1.0417vw;
  }

  .keyword-choose-content .content-right dd .right-header a {
    cursor: pointer;
    border-radius: var(--theme-btn-border-radius,0.8333vw);
    font-size: 0.8333vw;
    font-weight: 500;
    color: #333333;
    border: 0.0521vw solid #8e8e8e;
    padding: 0.5208vw 0;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    text-align: center;
    line-height: 1;
  }
  .keyword-choose-content .content-right dd .right-body {
    font-size: 2.3438vw;
    font-weight: 600;
    color: var(--primary-color);
    line-height: 1.0417vw;
    display: flex;
    flex: 1;
    justify-content: center;
    align-items: center;
  }

  .kc-pc-swiper-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 30%;
    position: relative;
    top: 13vw;
    left: 35vw;
    z-index: 9;
  }
  .kc-pc-swiper-pagination .kc-pc-swiper-pagination-customs {
    width: 2.0833vw;
    height: 0.1042vw;
    background: #cccccc;
    margin-right: 0.5208vw;
    cursor: pointer;
  }
  .kc-pc-swiper-pagination .kc-pc-swiper-pagination-customs-active {
    width: 5.2083vw;
    height: 0.2083vw;
    background: var(--primary-color);
  }

  @media screen and (max-width: 768px) {
    .section-keyword-choose {
      max-width: 100%;
      margin-left: 4.2667vw;
      margin-right: 4.2667vw;
      margin-bottom: 9.3333vw;
    }

    .keyword-choose-title {
      font-size: 6vw;
      font-weight: 600;
      color: #000000;
      padding-top: 4.6875vw;
      padding-bottom: 3.3854vw;
      text-align: center;
    }

    .keyword-choose-tabs {
      display: grid;
      gap: 8px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .keyword-choose-tabs .tab-item {
      width: 100%;
      height: 100%;
      margin-right: 0;
      border-radius: var(--theme-btn-border-radius,1.0667vw);
      padding: 2.6667vw;
      font-size: 3.4667vw;
      font-weight: 600;
      line-height: 3.6vw;
    }

    .keyword-choose-content .content-left {
      max-width: 20vw;
    }

    .keyword-choose-content .content-left dd {
      width: 20vw;
    }

    .keyword-choose-content .content-left dd .left-header .header-image {
      display: none;
    }

    .keyword-choose-content .content-left dd .left-header {
      height: 26.6667vw;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .keyword-choose-content .content-left dd .left-header .header-image-m {
      display: inline-block;
      max-width: 13.3333vw;
      max-height: 18.6667vw;
    }

    .keyword-choose-content .content-left dd .left-body {
      flex: 1;
      padding: 4.6667vw 0;
      height: 100%;
    }

    .keyword-choose-content .content-left dd .left-body .body-icon-img {
      width: 10.6667vw;
      height: 10.6667vw;
    }

    .keyword-choose-content .content-left dd .left-body .body-icon-subtitle {
      padding-top: 1.6vw;
      font-size: 2.6667vw;
      font-weight: 400;
      line-height: 2.6667vw;
    }

    .keyword-choose-content .content-right {
      display: none;
    }

    .keyword-choose-content .content-right-m {
      padding-left: 3.9063vw;
      padding-right: 3.9063vw;
      display: block;
    }

    .keyword-choose-content .content-right-m dd {
      display: flex;
      flex-direction: column;
      height: 100%;
      margin-right: 3.6458vw;
    }

    .keyword-choose-content .content-right-m dd .right-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 2.8646vw;
      height: 26.6667vw;
    }

    .keyword-choose-content .content-right-m dd .right-header img {
      max-height: 17.0667vw;
      max-width: 31.7333vw;
      margin-bottom: 1.0667vw;
    }

    .keyword-choose-content .content-right-m dd .right-header a {
      cursor: pointer;
      border-radius: 2.1333vw;
      font-size: 1.8667vw;
      font-weight: 500;
      color: #333333;
      border: 0.1333vw solid #8e8e8e;
      padding: 1.3333vw 0;
      display: inline-block;
      max-width: max-content;
      text-align: center;
    }
    .keyword-choose-content .content-right-m dd .right-body {
      color: var(--primary-color);
      line-height: 1.0417vw;
      display: flex;
      flex: 1;
      justify-content: center;
      align-items: center;
      font-size: 6vw;
      font-weight: 600;
    }

    .kc-swiper-pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 30%;
      position: relative;
      top: 35vw;
      left: 40vw;
    }
    .kc-swiper-pagination .kc-swiper-pagination-customs {
      width: 5.3333vw;
      height: 0.2667vw;
      background: #cccccc;
      margin-right: 1.3333vw;
    }
    .kc-swiper-pagination .kc-swiper-pagination-customs-active {
      width: 13.3333vw;
      height: 0.5333vw;
      background: var(--primary-color);
    }

    .keyword-choose-remark {
      font-size: 2.6667vw;
      font-weight: 400;
      line-height: 3.2vw;
    }
  }

  .keyword-choose-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .keyword-choose-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .keyword-choose-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }
  }
{%- endstyle -%}
<h2 class="keyword-choose-title" id="applications" anchor="{{ section.settings.anchor | escape }}"
style="
--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
--pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
"
>{{ section.settings.title | escape }}</h2>
{%- if section.settings.sub != blank -%}
 <div class="keyword-choose-sub keyword-sub">{{ section.settings.sub }}</div>
{%- endif -%}
<div class="keyword-choose-tabs">
  {% for block in section.blocks %}
    <div
      data-position_index="{{ forloop.index }}"
      data-target_id="kc-swiper-{{ block.id }}"
      data-pc_target_id="kc-swiper-pc-{{ block.id }}"
      data-content_id="kc-content-{{ block.id }}"
      class="tab-item {% if forloop.index0 == 0 %} tab-active {%endif%}"
    >
      {{ block.settings.tab_title | escape }}
    </div>
  {% endfor %}
</div>
