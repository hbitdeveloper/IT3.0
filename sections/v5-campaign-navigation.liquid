
<style>
    #shopify-section-{{ section.id }} {
        background: {{ section.settings.bg_color }};
    }

    @media screen and (min-width: 1024px) {

        .cal_scroll_target:not(.pos_show) jky-navigation .navigation-item {
          background-color: var(--nav-item-background-color);
          background-image: var(--nav-item-background-image);
          background-size: cover;
          background-position: center;'
        }

        jky-navigation .navigation-item {
            font-size: 1.25rem;
            font-weight: 600;
            justify-content: center;
        }

        .cal_scroll_target:not(.pos_show) jky-navigation .navigation-inner {
            width: 75rem;
            overflow-x: auto;
            padding: 0;
        }

        .cal_scroll_target:not(.pos_show) jky-navigation .navigation--container {
            align-items: stretch;
            margin: 0;
            height: auto;
            gap: 1.5rem;
        }
        .cal_scroll_target:not(.pos_show) jky-navigation .navigation--container > .shopify-block {
            height: auto;
        }
        .cal_scroll_target:not(.pos_show) jky-navigation .navigation-item {
            width: 13.75rem;
            padding: 1.25rem 1rem;
            text-align: center;
            line-height: 120%;
        }
        .cal_scroll_target:not(.pos_show) jky-navigation .navigation-action {
            display: none;
        }

        .cal_scroll_target.pos_show jky-navigation .navigation-item.active {
            border-bottom: 2px solid;
        }
    }

    @media screen and (max-width: 1023.98px) {

        .mode-nav--button_rectangle:not(.pos_show) .navigation-item:not(.active),
        .mode-nav--button_rectangle:not(.pos_show) .navigation-item.active {
            background-color: var(--nav-item-background-color);
            background-image: var(--nav-item-background-image-mb);
            background-size: cover;
            background-position: center;'
        }

        .mode-nav--button_rectangle.blocks-navs:not(.pos_show) {
            padding-left: 1rem;
            padding-right: 0;
        }

        .mode-nav--button_rectangle.blocks-navs:not(.pos_show) .navigation-inner {
            width: 100%;
            margin: 0;
        }
        .mode-nav--button_rectangle.blocks-navs:not(.pos_show) jky-navigation .navigation--container {
            flex-wrap: nowrap;
            gap: 0;
            align-items: stretch;
            height: auto;
        }
        .mode-nav--button_rectangle.blocks-navs:not(.pos_show) jky-navigation .navigation--container > .shopify-block {
            height: auto;
        }
        .mode-nav--button_rectangle:not(.pos_show) jky-navigation .navigation-item {
            width: 8rem;
            height: 100%;
            padding: 1.125rem 1rem;
            border: none;
            font-weight: 600;
            justify-content: center;
            margin-right: 1rem;
            text-align: center;
            align-items: center;
        }
        .mode-nav--button_rectangle:not(.pos_show) jky-navigation .navigation-action {
          display: none;
        }
        .cal_scroll_target.pos_show jky-navigation .navigation-item {
          font-size: 1rem;
          font-weight: 600;
        }
        .cal_scroll_target.pos_show jky-navigation .navigation-item.active {
          border-bottom: 2px solid;
        }
        .blocks-navs jky-navigation .navigation-inner.navigation-inner--overflow {
            padding: 0;
        }
    }
</style>


{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div class="section-padding" style="{{ style }}">
    {% content_for "block", type: "v-heading-content", id: "v-heading-content-01" %}
    {% content_for "block", type: "navigation", id: "navigation-01" %}
</div>


