
{{ 'sections-v5-support-search-banner.css' | asset_url | stylesheet_tag }}


<div
  class="v5-support-index-banner active"
  id="v5-support-index-banner-{{ section.id }}"
  data-default-search-base-url="{{ section.settings.search_base_url | escape }}"
>

    {% render 'diff-end-img',
            picture_class:'',
            class: 'v5-support-index-banner__bg js-support-banner-bg object-cover',
            pc_img: section.settings.pc_image,
            mb_img: section.settings.mb_image,
            pc_img_width: pcimage.width | default: 1920,
            mb_img_width: mimage.width | default: 375,
            placeholder_name: 'hero-apparel-1',
            alt: section.settings.image_alt,
            load_scene: 'lcp',
    %}

  <div class="v5-support-index-banner__container">
    <div class="v5-support-index-banner__title js-support-banner-title">
      <p class="v5-font-oxm ">{{ section.settings.title_line_1 }}</p>
      <p class="sub-title">{{ section.settings.title_line_2 }}</p>
    </div>
    <div class="v5-support-index-banner__frame">
      {% render 'icon-search', class: 'hidden lg:block iconfont header__section_search ml-2.5', width: 18, height: 18, color: '#CCCCCC' %}
      <input class="v5-support-index-banner__input js-support-banner-input" type="text" placeholder="{{ section.settings.search_placeholder | escape }}">
      <button class="hidden min-w-40 h-12 text-xl font-semibold lg:block js-support-banner-search bg-primary text-white">{{ section.settings.search_button_text }}</button>
      <button class="block lg:hidden js-support-banner-search">{% render 'icon-search', class: 'iconfont header__section_search', width: 20, height: 20, color: '#FFFFFF' %}</button>

    </div>
  </div>
</div>

<script src="{{ 'sections-v5-support-search-banner.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5-Support Search Banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title_line_1", "label": "Title", "default": "Support" },
    { "type": "text", "id": "title_line_2", "label": "Sub Title", "default": "Welcome to Jackery Support" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search for Support" },
    { "type": "text", "id": "search_button_text", "label": "Search button text", "default": "SEARCH" },
    { "type": "text", "id": "search_base_url", "label": "Search base URL", "default": "https://www.jackery.com" },
    { "type": "image_picker", "id": "pc_image", "label": "PC image URL" },
    { "type": "image_picker", "id": "mb_image", "label": "Mobile image URL" },
    { "type": "text", "id": "image_alt", "label": "Image alt", "default": "Jackery Support" }
  ],
  "presets": [
    {
      "name": "V5-Support Search Banner",
      "category": "V5.0 Support"
    }
  ]
}
{% endschema %}
