<style>
  @media screen and (min-width: 1440px) and (max-width: 1600px) {
    .v5-sg-banner .block-common-banner .swiper-wrapper{
       height: calc(var(--pc-banner-h, 420) * 1px);
      }
    .v5-sg-banner .block-common-banner .banner-img {
        height: calc(var(--pc-banner-h, 420) * 1px);
    }
  }

  @media screen and (min-width: 1024px) {
    {% comment %} 上中下 {% endcomment %} 
    .v5-sg-banner .block-common-banner .banner-info.vertical-top{
        top: 2rem;
    }
    .v5-sg-banner .block-common-banner .banner-info.vertical-center{
        top: 50%;
    }
    .v5-sg-banner .block-common-banner .banner-info.vertical-bottom{
        top: unset;
        bottom: 2rem;
        transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 1023.98px) {
    .v5-sg-banner .block-common-banner .banner-info {
      width: 21.4375rem;
    }

    {% comment %} 上中下 {% endcomment %}
    .v5-sg-banner .block-common-banner .banner-info.vertical-top-mb{
        top: 2.75rem;
    }
    .v5-sg-banner .block-common-banner .banner-info.vertical-center-mb{
      top: 50%;
      transform: translate(-50%, -50%);
    }
    .v5-sg-banner .block-common-banner .banner-info.vertical-bottom-mb{
        top: unset;
        bottom: 2.75rem;
        transform: translateX(-50%);
    }
  }
</style>

