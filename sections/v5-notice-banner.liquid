<style>
    @media screen and (min-width: 1920px) {
    .v5-notice-subscribe .block-common-banner .banner-img {
      height: 100%;
    }
  }

  @media screen and (min-width: 1440px) and (max-width: 1600px) {
    .v5-notice-subscribe .block-common-banner .swiper-wrapper{
       height: calc(var(--pc-banner-h, 240) * 1px);
      }
    .v5-notice-subscribe .block-common-banner .banner-img {
        height: calc(var(--pc-banner-h, 240) * 1px);
    }
  }

    .v5-notice-subscribe .form-item-group{
      margin-bottom: 0.75rem;
    }

  @media screen and (min-width: 1024px) {

    {% comment %} 上中下 {% endcomment %}
    .v5-notice-subscribe .block-common-banner .banner-info.vertical-top{
        top: 3.75rem;
    }
    .v5-notice-subscribe .block-common-banner .banner-info.vertical-center{
        top: 50%;
    }
    .v5-notice-subscribe .block-common-banner .banner-info.vertical-bottom{
        top: unset;
        bottom: 3.75rem; 
        transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 1023.98px) {

    {% comment %} 上中下 {% endcomment %}
    .v5-notice-subscribe .block-common-banner .banner-info.vertical-top-mb{
        top: 2.75rem;
    }
    .v5-notice-subscribe .block-common-banner .banner-info.vertical-center-mb{
      top: 50%; 
      transform: translate(-50%, -50%);
    }
    .v5-notice-subscribe .block-common-banner .banner-info.vertical-bottom-mb{
        top: unset;
        bottom: 2.75rem;
        transform: translateX(-50%);
    }

    .v5-notice-subscribe .swiper-button-prev,
    .v5-notice-subscribe .swiper-button-next {
      display: none;
    }
  }
</style>

