{% endstyle %}

{%- liquid
  assign payment_icon_list = shop.metaobjects.payment_icon_list.values
  assign first_icon_list = payment_icon_list | first
  assign section_position = first_icon_list.section_position
  assign pc_pay_position = section.settings.pc_pay_position
  assign position = 'left'
  if section.settings.is_show_new_pay == true
    if pc_pay_position == 'left' or pc_pay_position == 'right'
      assign position = pc_pay_position
    endif
  elsif section_position == 'left' or section_position == 'right'
    assign position = section_position
  endif
  assign warranty_enable = first_icon_list.warranty_enable | default: true, allow_false: true
  assign pay_enable = first_icon_list.pay_enable | default: true, allow_false: true
  assign both_enable = true
  assign warranty_list = section.blocks | where: 'type', 'warranty_item'
  if warranty_enable == false and pay_enable == false and warranty_list.size == 0
    assign both_enable = false
  endif
  assign show_point = section.settings.is_show_point | default: true, allow_false: true


  # 产品价格直降方式
  assign show_product_direct_way = section.settings.show_product_direct_way
  assign product_direct_way = section.settings.product_direct_way | default: 'way_one'

  assign price_class_name = 'price'
  assign origin_price_class_name = 'originPrice'
  if show_product_direct_way
    assign price_class_name = 'djp'
    assign origin_price_class_name = 'odjp'
  endif

  # 建议零售价
  assign msrp = 'products.product.price.msrp' | default: '' | t

  # 欧洲站点，需要修改产品标签、标题的默认字体大小
  assign need_modify_size = false
  assign iso_code = settings.shop_cr | default: localization.country.iso_code | default: 'US'
  if iso_code == 'GB' or iso_code == 'DE' or iso_code == 'FR' or iso_code == 'ES' or iso_code == 'EU' or iso_code == 'NL'
    assign need_modify_size = true
  endif
-%}

{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- assign model_3d = product.media | where: 'media_type', 'model' -%}

{% comment %} {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%} {% endcomment %}
{%- if product.metafields.custom.modals_list.value != blank -%}
  {% comment %} {%- assign first_3d_model = product.metafields.custom.modals_list.value | first -%} {% endcomment %}
  {%- assign model_3d = product.metafields.custom.modals_list.value -%}
{%- endif -%}

{% comment %} 获取媒体视频 video or external_video {% endcomment %}
{%- assign first_video_media = false -%}
{%- assign first_video_media = product.media | where: 'media_type', 'video' | first -%}
{%- if first_video_media == false or first_video_media == blank -%}
  {%- assign first_video_media = product.media | where: 'media_type', 'external_video' | first -%}
{%- endif -%}

{% if section.settings.use_old_code %}
  {%- render "product-new-patch" -%}
{% endif %}
<div data-version="v4" class="section-container--lg flex product-main-block" onltvariant="{{product.has_only_default_variant}}">
  {% comment %} 图片、视频、3D、延保信息 {% endcomment %}
  <div class="gallery product-media-container w-full mr-0 {% if first_video_media == blank and model_3d.size < 1 %}product-media-container-half{% endif %}">
    {%- render
      "product-gllerry",
        photos_i18n: section.settings.product_photos_i18n | escape,
        video_i18n: section.settings.product_video_i18n | escape,
        model_i18n: section.settings.product_3d_model_i18n | escape,

        show_3d_model_unfold: section.settings.product_3d_model_show_unfold,
        unfolded_i18n: section.settings.product_unfolded_i18n | escape,
        folded_i18n: section.settings.product_folded_i18n | escape,

        first_video_media: first_video_media,
        model_3d: model_3d,
        warranty_list: warranty_list,
        position: position,
        first_icon_list: first_icon_list,
        pay_enable: pay_enable,
        warranty_enable: warranty_enable
    -%}
  </div>

  {% comment %} 商品信息 {% endcomment %}
  {% assign pay_wrannty = section.blocks | where: 'type', 'pay_wrannty' %}
  <div class="product-info-container">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          <div class="main-product--app-box product-info_block" {{ block.shopify_attributes }}>{% render block %}</div>

        {%- when 'title' -%}
          {% comment %} 商品标题 {% endcomment %}
          <h1
            {% if need_modify_size %}
              style="
                --title-size-pc: calc({% if block.settings.title_size_pc > 0 %}{{ block.settings.title_size_pc }}{% else %}32{% endif %} / 16 * 1rem);
                --title-size-mb: calc({% if block.settings.title_size_mb > 0 %}{{ block.settings.title_size_mb }}{% else %}24{% endif %} / 16 * 1rem);
                line-height:1.25;
              "
            {% else %}
              style="
                --title-size-pc: calc({% if block.settings.title_size_pc > 0 %}{{ block.settings.title_size_pc }}{% else %}32{% endif %} / 16 * 1rem);
                --title-size-mb: calc({% if block.settings.title_size_mb > 0 %}{{ block.settings.title_size_mb }}{% else %}28{% endif %} / 16 * 1rem);
                line-height:1.25;
              "
            {% endif %}
            class="product-info_block product__title font-semibold mb-4 !text-[length:var(--title-size-mb)] lg:!text-[length:var(--title-size-pc)]"
            {{ block.shopify_attributes }}
          >{{product.title | escape}}</h1>

        {%- when 'price' -%}
          {% comment %} 商品价格 {% endcomment %}

          {% comment %} Promi 插件代码 {% endcomment %}
          <div class="pm-price-wrapper" pm-section-id="{{ section.id }}">
            <div
              {{ block.shopify_attributes }}
              id="price-{{ section.id }}"
              class="product-info_block product__{{ price_class_name }} !flex flex-wrap {% if msrp != blank %}items-center lg:items-end lg:gap-x-1{% else %}items-end{% endif %} mb-6 lg:gap-y-2 lg:gap-x-3 
              {%- if available == false %} price--sold-out {% endif -%}
              {%- if compare_at_price > price %} price--on-sale {% endif -%}"
            >
              {%- liquid
                assign target = product.selected_or_first_available_variant
                assign compare_at_price = target.compare_at_price | default: target.price
                assign price = target.price | default: 1999
                assign available = target.available | default: false
                assign money_price = price

                # if target == product and product.price_varies
                  # assign money_price = 'products.product.price.from_price_html' | t: price: money_price
                # endif

                # 开启了价格直降
                if show_product_direct_way
                  # 方案一
                  if product_direct_way == 'way_one'
                    assign dsf = target.metafields.custom.dsf
                    if dsf != blank
                      assign money_price = dsf | times: 100
                    endif
                  # 方案二
                  elsif product_direct_way == 'way_two'
                    if settings.open_auto_discount_price
                      assign auto_dis_price = target.metafields.custom.auto_discount_price | times: 1
                      if auto_dis_price > 0 and auto_dis_price < price
                        assign money_price = auto_dis_price
                      else
                        assign money_price = price
                      endif
                    endif
                  endif
                endif
              -%}


              <span class="product--{{ price_class_name }} font-semibold text-primary lg:text-3xl text-xl -mb-1" data-{{price_class_name}}="{{money_price}}">{{money_price  | money}}</span>

              {%- if product_direct_way == 'way_one' -%}
                <span class="product--price-">{{ compare_at_price | money }}</span>
              {%- endif -%}

              {%- if section.settings.tax != blank -%}
                <span class="product--price__tax">{{section.settings.tax}}</span>
              {%- endif -%}
              {%- unless product.price_varies == false and product.compare_at_price_varies %}
                {%- if compare_at_price > money_price -%}
                  <span style="color:#626262;" class="product--{{ origin_price_class_name }} {% if msrp != blank %}inline-flex flex-col items-start text-xs lg:flex-row lg:inline-block {% else %} inline-block align-middle text-sm mt-2 lg:mt-1 {% endif %} font-normal lg:text-lg lg:mb-0 -mb-px line-through">
                    {%- if msrp != blank -%}
                      <span class="mr-1 leading-none">{{ msrp | escape }}</span>
                    {%- endif -%}
                    <span>{{ compare_at_price | money }}</span>
                  </span>
                {%- endif -%}
              {%- endunless -%}

              {%- assign display_discount_amount = false -%}

              {%- if settings.show_discount_amount -%}
                {%- unless product.price_varies == false and product.compare_at_price_varies %}
                  {%- if compare_at_price > money_price -%}
                    {%- assign display_discount_amount = true -%}
                    {%- assign amount_discount = compare_at_price | minus: money_price | divided_by: 100 | floor | times: 100 | money_without_trailing_zeros -%}
                    <span class="product-{{ price_class_name }}--discount_amount">{{settings.discount_amount_format | replace: '()', amount_discount}}</span>
                  {%- endif -%}
                {%- endunless -%}
              {%- endif -%}

              {%- if section.settings.product_extras_msg != blank -%}
                <span class="product--price__discount" data-full-product-price-discount="{{display_discount_amount}}">{{section.settings.product_extras_msg}}</span>
              {%- endif -%}

              {% comment %} 方案三 {% endcomment %}
              {%- if show_product_direct_way and product_direct_way == 'way_three' -%}
                {%- liquid
                  if settings.open_auto_discount_price
                    assign auto_dis_price = target.metafields.custom.auto_discount_price | times: 1
                    if auto_dis_price > 0 and auto_dis_price < price
                      assign money_price = auto_dis_price
                    else
                      assign money_price = price
                    endif
                  endif
                -%}
                <br/>
                <div class="w-full mt-3 lg:mt-2">
                  <p class="product-final-wrap">
                    <span>{{ section.settings.product_direct_way_three_text | escape }}</span>
                    <span>{{money_price  | money}}</span>
                  </p>
                </div>
              {%- endif -%}
            </div>
            {%- if section.settings.tax_fee_explanation != blank -%}
              <div style="color: #626262;" class="product-tax_fee_explanation font-normal lg:text-lg text-sm lg:my-2 my-1">{{ section.settings.tax_fee_explanation }}</div>
            {%- endif -%}
          </div>

          {% comment %} 判断是否创建product_points_text的block，若否 则渲染默认的商详积分文案版块 {% endcomment %}
          {%- if show_point -%}
            {%- assign has_block_product_points_text = false -%}
            {% assign pdp_points_text = section.blocks | where: 'type', 'product_points_text' %}
            {% if pdp_points_text.size > 0 %}
              {%- assign has_block_product_points_text = true -%}
            {%- endif -%}
            {% unless has_block_product_points_text %}
              {% comment %} 全局 商详积分文案版块，默认在价格下方 {% endcomment %}
              {% render 'global-pdp-points-text', id:'globalPdpPointsText', gaEventName: 'products_details_page_user_clicks' %}
            {% endunless %}
           {%- endif -%}

        {%- when 'paypal_message' -%}
          {% comment %} paypal 分期显示 {% endcomment %}
          {%- if settings.paypal_clientId -%}
            <script src="https://www.paypal.com/sdk/js?client-id={{ settings.paypal_clientId }}&components=messages" defer></script>
            <div
              class="product-info_block"
              data-pp-message
              data-pp-placement="product"
              data-pp-amount="{{ product.selected_or_first_available_variant.price | money_without_currency }}"
              data-pp-style-layout="text"
              data-pp-style-logo-type="primary"
              data-pp-style-logo-position="left"
            ></div>
          {%- endif -%}
          {% comment %} paypal 分期显示 {% endcomment %}
        {%- when 'coupon_new' -%}
          {% comment %} 新优惠券 {% endcomment %}
          {% render 'app-coupon-new', block: block %}

        {%- when 'membership_price' -%}
          {% comment %} 会员价 {% endcomment %}
          {% render 'app-membership-price', block: block %}

        {%- when 'delivery_instructions' %}
          {% comment %} 配送与服务说明设置 {% endcomment %}
          {%- render 'delivery-instructions', block: block -%}
          
        {%- when 'klarna' -%}
          {% comment %} klarna 支付 {% endcomment %}
          <div class="product-info_block" {{ block.shopify_attributes }}>
            {% render 'app-klarna' %}
          </div>

        {%- when 'variant_picker' -%}

          {% comment %} 判断是否创建text_promotion的block，若否 则渲染默认的全局促销文案 {% endcomment %}
          {%- assign has_block_text_promotion = false -%}
          {% assign text_promotion = section.blocks | where: 'type', 'text_promotion' %}
          {% if text_promotion.size > 0 %}
            {%- assign has_block_text_promotion = true -%}
          {%- endif -%}
          {%- unless has_block_text_promotion -%}
            {% render 'global-text-promotion', id:'quantityGlobalTextPromotion' %}
          {%- endunless -%}

          {% comment %} 变体列表 {% endcomment %}
          {%- unless product.has_only_default_variant -%}
            <variant-fields
              class="product-info_block"
              id="variant-radios-{{ section.id }}"
              data-section="{{ section.id }}"
              data-url="{{ product.url }}"
              data-class-name="{{ price_class_name }}"
              {{ block.shopify_attributes }}
            >
              {%- for option in product.options_with_values -%}
                {%- assign last_index = false -%}
                {%- if forloop.last -%}
                  {%- assign last_index = true -%}
                {%- endif -%}
                <div class="product-form__input">
                    <div class="form__label">{{ option.name }}</div>
                    {%- liquid
                      assign variants_available_arr = product.variants | map: 'available'
                      assign variants_option1_arr = product.variants | map: 'option1'
                      assign variants_option2_arr = product.variants | map: 'option2'
                      assign variants_option3_arr = product.variants | map: 'option3'
                      assign product_form_id = 'product-form-' | append: section.id
                    -%}

                    {%- for value in option.values -%}
                      {%- liquid
                        assign option_disabled = true

                        for option1_name in variants_option1_arr
                          case option.position
                            when 1
                              if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                assign option_disabled = false
                              endif
                            when 2
                              if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                assign option_disabled = false
                              endif
                            when 3
                              if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                assign option_disabled = false
                              endif
                          endcase
                        endfor
                      -%}
                      <div class="variant-select">
                        <input
                          type="radio"
                          id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          data-id="{{ product.variants[forloop.index0].id }}"
                          name="{{ option.name }}"
                          value="{{ value | escape }}"
                          form="{{ product_form_id }}"
                          corner="{{ product.variants[forloop.index0].metafields.custom.variant_tag | escape }}"
                          {% if option.selected_value == value %} checked {% endif %}
                          {% if option_disabled %} class="disabled" {% endif %}
                        >
                        <label
                          {% if option_disabled %} class="disabled unavailable" {% endif %}
                          for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                        >
                          <span class="option-name">{{- value -}}</span>
                          <div>
                            {% comment %} Promi 插件代码 {% endcomment %}
                            <div class="option-{{ price_class_name }}" data-product-id="{{ product.id }}" data-variant-id="{{product.variants[forloop.index0].id }}">
                              {%- if last_index == true -%}
                                {%- assign last_variant = product.variants[forloop.index0] -%}
                                {%- assign l_price = last_variant.price -%}
                                {%- assign l_origin_price = last_variant.compare_at_price | default: l_price -%}

                                {%- if show_product_direct_way and product_direct_way == 'way_one' -%}
                                  {%- assign dsf = last_variant.metafields.custom.dsf -%}
                                  {%- if dsf != blank -%}
                                    {%- assign l_price = dsf | times: 100 -%}
                                  {%- endif -%}
                                {%- else -%}

                                  {%- if settings.open_auto_discount_price and settings.display_auto_discount_price_in_sku %}
                                      {%- assign l_auto_discount_price = last_variant.metafields.custom.auto_discount_price | times: 1 -%}
                                      {%- if l_auto_discount_price > 0 and l_auto_discount_price < last_variant.price -%}
                                          {%- assign l_price = l_auto_discount_price -%}
                                      {%- else -%}
                                          {%- assign l_price = last_variant.price -%}
                                      {%- endif -%}
                                  {%- endif -%}

                                  {%- if l_origin_price < last_variant.price -%}
                                      {%- assign l_origin_price = last_variant.price -%}
                                  {%- endif -%}
                                {%- endif -%}

                                <span class="{{ price_class_name }} text-lg text-[#1A1A1A] font-semibold lg:font-medium">{{ l_price | money }}</span>
                                {%- if l_origin_price > l_price -%}
                                  <span class="origin-{{ price_class_name }} text-sm text-[#999] font-medium line-through">
                                    {%- if msrp != blank -%}
                                      <span class="mr-1">{{ msrp | escape }}</span>
                                    {%- endif -%}
                                    <span>{{ l_origin_price | money }}</span>
                                  </span>
                                {%- endif -%}
                              {%- endif -%}
                            </div>
                            <span class="option-sold-out visually-hidden">{{ 'products.product.sold_out' | t }}</span>
                          </div>

                          {%- if last_index == true -%}
                            {%- if product.variants[forloop.index0].metafields.custom.variant_tag != blank -%}
                              <span class="variant-select--tag">{{product.variants[forloop.index0].metafields.custom.variant_tag | escape}}</span>
                            {%- endif -%}
                          {%- endif -%}
                        </label>
                      </div>
                    {%- endfor -%}
                </div>
              {%- endfor -%}
            </variant-fields>
          {%- endunless -%}

        {% comment %} {%- when 'accesorries' -%} {% endcomment %}
          {% comment %} 配件列表 {% endcomment %}
          {% comment %} <div class="product-form__input product-info_block product_main--accesorries"></div> {% endcomment %}

        {%- when 'bundled_sale' -%}
          {% comment %} 捆版销售 {% endcomment %}
          {% render 'app-bundled-sale' %}

        {%- when 'product_extra_text' -%}
          {% comment %} 横幅折叠组件 {% endcomment %}
          <div class="product-info_block" {{ block.shopify_attributes }}>
            {%- render 'app-product-extra-text', current_variant_id: product.selected_or_first_available_variant.id -%}
          </div>

        {%- when 'buy_buttons' -%}
          {% comment %} 购买按钮 {% endcomment %}
          <div class="product-info_block" {{ block.shopify_attributes }}>
            {%- liquid
              assign check_against_inventory = true
              if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
                assign check_against_inventory = false
              endif
              if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                assign quantity_rule_soldout = true
              endif

              assign sku_warranty_info = product.selected_or_first_available_variant.metafields.custom.sku_warranty_info.value | default: product.selected_or_first_available_variant.metafields.custom.sku_warranty_info
              assign sku_warranty_info = sku_warranty_info | strip
              assign sku_warranty_info_normalized = sku_warranty_info | replace: '：', ':'
              assign product_warranty_key = ''
              assign product_warranty_value = ''
              if sku_warranty_info_normalized contains ':'
                assign product_warranty_parts = sku_warranty_info_normalized | split: ':'
                assign product_warranty_key = product_warranty_parts | first | strip
                assign product_warranty_value = sku_warranty_info_normalized | remove_first: product_warranty_key | remove_first: ':' | strip
              endif
            -%}

            <product-form
              class="product-form"
              data-hide-errors="{{ gift_card_recipient_feature_active }}"
              data-section-id="{{ section.id }}"
              data-tax-free-pop-z-index="{{ settings.tax_free_popup_z_index | default: 9999999999 }}"
            >
              {%- form 'product',
                product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ product.selected_or_first_available_variant.id }}"
                  data-sku="{{product.selected_or_first_available_variant.sku}}"
                  data-skutitle="{{product.selected_or_first_available_variant.title}}"
                  data-product-warranty-info="{{ sku_warranty_info | escape }}"
                  data-full-gift-obj={{ product.selected_or_first_available_variant.metafields.custom.full_gift_list.value | json }}
                  data-tax-free-popup="{{ product.selected_or_first_available_variant.metafields.custom.open_tax_free_popup_before_buy.value | json }}"
                  class="product-variant-id"
                >
                {%- if product_warranty_key != blank and product_warranty_value != blank -%}
                  <input
                    type="hidden"
                    name="properties[{{ product_warranty_key | escape }}]"
                    value="{{ product_warranty_value | escape }}"
                    data-product-warranty-property="true"
                  >
                {%- endif -%}

                <div class="product-form__buttons">
                  <button
                    id="ProductSubmitButton-{{ section.id }}"
                    type="submit"
                    name="add"
                    class="product-form__submit"
                    {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                      disabled
                    {% endif %}
                  >
                    {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- else -%}
                      <span>{{ 'products.product.add_to_cart' | t }}</span>
                    {%- endif -%}
                  </button>

                  {%- if customer and customer.current_company -%}
                    {% comment %} B2B 用户 {% endcomment %}
                    <div style="flex: 1;" class="buy-now--box {% if settings.hide_buynow == true or section.settings.hide_buy_now == true %}!hidden{% endif %}">{{ form | payment_button }}</div>
                  {%- else -%}
                    {% comment %} 2C 用户 {% endcomment %}
                    <button
                      class="buy-now--box buy-it-now-custom-btn {% if settings.hide_buynow == true or section.settings.hide_buy_now == true %}!hidden{% endif %}"
                      type="button"
                      name="buy-it-now"
                      onclick="e=>e.preventDefault()"
                      {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                        disabled
                      {% endif %}
                    >
                      <span>{{ 'products.product.buy_it_now' | t }}</span>
                    </button>
                  {%- endif -%}
                </div>

                {% comment %} 2C 用户，按需显示【Shopify立即购买】按钮 {% endcomment %}
                {%- unless customer and customer.current_company -%}
                  {%- if block.settings.show_shopify_buy_it_now -%}
                    <div class="w-full buy-now--box mt-4 {% if settings.hide_buynow == true or section.settings.hide_buy_now == true %}!hidden{% endif %}">{{ form | payment_button }}</div>
                  {%- endif -%}
                {%- endunless -%}
              {%- endform -%}
            </product-form>
          </div>

        {%- when 'text_promotion' -%}
          {% comment %} 促销文案机动版块 {% endcomment %}
          {% render 'app-text-promotion', block: block %}

        {%- when 'text_promotion_fold' -%}
          {% comment %} 促销文案折叠组件 {% endcomment %}
          {% render 'app-text-promotion-fold', block: block %}

        {%- when 'quantity' -%}
          {% comment %} 数量选择器 {% endcomment %}
          <div {{ block.shopify_attributes }} class="product-info_block w-full flex items-center justify-between" style="display:flex;">
            <label class="quantity-label">{{ block.settings.product_quantity_label | escape }}</label>
            <quantity-input data-mian-product-quantity class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
              <button
                aria-label="minus"
                class="quantity__button no-js-hidden"
                name="minus"
                type="button"
                disabled
                data-ga-event="products_details_page_user_clicks"
                data-ga-action="click"
                data-ga-params-product_spu_name="{{ product.title | escape }}"
                data-ga-params-module="Product Selection"
                data-ga-params-options="{{ product.selected_or_first_available_variant.title | escape }}"
                data-ga-params-corner="{{ product.selected_or_first_available_variant.metafields.custom.variant_tag | escape }}"
                data-ga-params-action="minus"
                data-ga-params-options_price="{{ product.selected_or_first_available_variant.price | money }}"
              >
                <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
                {% render 'icon-minus' %}
              </button>
              <input
                aria-label="purchase quantity"
                class="quantity__input"
                type="number"
                name="quantity"
                id="Quantity-{{ section.id }}"
                data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                min="{{ product.selected_or_first_available_variant.quantity_rule.min | default: 1 }}"
                {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                  data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                  max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                {% else %}
                  data-max="1000000"
                  max="1000000"
                {% endif %}
                step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                value="{{ product.selected_or_first_available_variant.quantity_rule.min | default: 1 }}"
                form="{{ product_form_id }}"
              />
              <button
                aria-label="plus"
                class="quantity__button no-js-hidden"
                name="plus"
                type="button"
                data-ga-event="products_details_page_user_clicks"
                data-ga-action="click"
                data-ga-params-product_spu_name="{{ product.title | escape }}"
                data-ga-params-module="Product Selection"
                data-ga-params-options="{{ product.selected_or_first_available_variant.title | escape }}"
                data-ga-params-corner="{{ product.selected_or_first_available_variant.metafields.custom.variant_tag | escape }}"
                data-ga-params-action="plus"
                data-ga-params-options_price="{{ product.selected_or_first_available_variant.price | money }}"
                {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                  {% if product.selected_or_first_available_variant.quantity_rule.max <= 1 %}
                    disabled
                  {% endif %}
                {% endif %}
              >
                <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span>
                {% render 'icon-plus' %}
              </button>
            </quantity-input>
          </div>
          <div class="add_cart_error_wrapper text-[#FE3A31] font-normal lg:text-lg text-sm text-right -mt-2 mb-4 min-h-px"></div>

        {%- when 'app_shortage' -%}
          {% comment %} 到货提醒 {% endcomment %}
          {%- if section.settings.enable_shortage_reminds -%}
            {%- liquid
              assign target = product.selected_or_first_available_variant
            -%}
            <product-shortage {{ block.shopify_attributes }}>
              {%- if target.available == false -%}
                {%- assign pageUrlWithHost = content_for_header | split:'"pageurl":"' | last | split:'"' | first |
                    replace:'\/','/' |
                    replace:'%20',' ' |
                    replace:'\u0026','&'
                -%}
                <div
                  ddd-available="{{target.available}}"
                  class="product-shortage-container product-info_block"
                  data-title="{{section.settings.shortage_title | escape}}"
                  data-content="{{section.settings.shortage_content | escape}}"
                  data-email_placeholder="{{section.settings.shortage_input_tips | escape}}"
                  data-shortage_policy="{{section.settings.shortage_policy | escape}}"
                  data-email_empty_info="{{'newsletter.email_empty_info' | t}}"
                  data-email_error_info="{{'newsletter.email_error_info' | t}}"
                  data-policy_empty_info="{{'newsletter.policy_empty_info' | t}}"
                  data-shortage_submit="{{section.settings.shortage_submit | escape}}"
                  data-shortage_reminds_success="{{section.settings.shortage_reminds_success | escape}}"
                  data-shortage_reminds_error="{{section.settings.shortage_reminds_error | escape}}"

                  variant-sku="{{target.sku}}"
                  variant-goods_name="{{product.title}}"
                  variant-sku_goods_name="{{target.title}}"
                  variant-source="1"
                  variant-id="{{target.id}}"
                  variant_url="{{pageUrlWithHost}}"
                >
                  <button>{{ section.settings.shortage_title | escape}}</button>
                </div>
              {%- endif -%}
            </product-shortage>
          {%- endif -%}

        {%- when 'bfcm' -%}
          {% if product.metafields.my_fields.bfcm %}
            <div class="product-info_block">
                {% render 'main-product-bfcm', bfcm: block.settings , new_product: true %}
            </div>
          {% endif %}

        {%- when 'description' -%}
          {% comment %} 产品描述 {% endcomment %}
          {%- if product.description != blank -%}
            <div class="product-info_block" {{ block.shopify_attributes }}>
              <product-description>
                <div class="product__description">
                  <div class="description-content">{{product.description}}</div>
                  <button
                    style="display:none;"
                    data-show-all-des="{{ block.settings.show_description }}"
                    data-view-more-text="{{ block.settings.learn_more_text | escape }}"
                    data-hide-text="{{ block.settings.learn_less_text | escape }}"
                  ><span>{{ block.settings.learn_more_text | escape }}</span> <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></button>
                </div>
              </product-description>
            </div>
          {%- endif -%}

        {%- when 'app_coupon' -%}
          {% comment %} 旧优惠券 {% endcomment %}
          {%- unless settings.hide_cart_icon -%}
            <product-coupon class="coupon" {{ block.shopify_attributes }}>
              <div
                class="coupon product-info_block"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                data-copysuccess="{{ 'gift_cards.issued.copy_code_success' | t }}"
                data-copy-and-use-text="{{ block.settings.copy_and_use_i18n | escape }}"
                data-code-text="{{ block.settings.code_i18n | escape }}"
                data-off-text="{{ block.settings.off_i18n | escape }}"
              ></div>
            </product-coupon>
          {%- endunless -%}

        {%- when 'app_shoppay' -%}
          {% comment %} Shop pay分期 {% endcomment %}
          {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
          <div class="product-info_block" id="product-form-installment-main" {{ block.shopify_attributes }}>
            {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              {{ form | payment_terms }}
            {%- endform -%}
          </div>

        {%- when 'poidy' -%}
          {% comment %} 日站Poidy分期信息 {% endcomment %}
          {% if settings.open_poidy == true %}
            <div {{ block.shopify_attributes }}>
              <span class="_paidy-promotional-messaging" data-amount="{{ target.price | money }}" data-alignment="start" data-font-size="13px" data-6-pay-enabled data-12-pay-enabled></span>
            </div>
            <script src="{{ 'poidy.js' | asset_url }}" defer></script>
          {% endif %}

        {% comment %} custom_liquid {% endcomment %}
        {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }} style="background-color: {{ block.settings.bg_color }}; margin: {{  block.settings.margin | escape }};padding: {{  block.settings.padding }};" >
                {{ block.settings.liquid }}
            </div>

        {% comment %} 智能选购 4.0 {% endcomment %}
        {%- when 'product-smart-recommend' -%}
          {% render 'product-head-smart-recommend', id: block.id, smart_recommend_text: block.settings.smart_recommend_text, compare_id: block.settings.compare_id, coupon_id: block.settings.coupon_id %}


        {% comment %} 购买意向表单拉起按钮 {% endcomment %}
        {%- when 'pif_btn' -%}
        <div class="product-info_block">
          <jds-button variant="text" class="btn-for-pif">{{ block.settings.pif_btn_text }}</jds-button>
        </div>

        {% comment %} 加购和购买前，免税弹窗提示 {% endcomment %}
        {%- when 'tax_free_popup' -%}
          {% render 'tax-free-popup', block: block %}

        {% comment %} 产品对比 {% endcomment %}
        {%- when 'product-compare' -%}
          {% assign current_variant_id = product.selected_or_first_available_variant.id %}
          {% render 'product-head-compare', id: block.id, compare_text: block.settings.compare_text, current_variant_id: current_variant_id %}
        {%- when 'product_points_text' -%}
          {%- if show_point -%}
              {%- render 'product-points-text', block: block -%}
          {%- endif -%}

        {%- when 'pay_wrannty' -%}
          {% comment %} 商详页支付icon与延保信息 {% endcomment %}
              {% if both_enable %}
                {% assign block_classes = 'mobile-block' %}
                {% if position == 'right' %}
                  {% assign block_classes = block_classes | append: ',pc-block' %}
                {% endif %}

                {% assign block_classes_array = block_classes | split: ',' %}
                {% for block_class in block_classes_array %}
                  {% render 'pay-warranty-v4',
                    block_class: block_class,
                    first_icon_list: first_icon_list,
                    warranty_list: warranty_list,
                    warranty_enable: warranty_enable,
                    pay_enable: pay_enable
                  %}
                {% endfor %}
              {% endif %}

        {% comment %} 产品推荐 {% endcomment %}
        {%- when 'recommend_products' -%}
          {%- if settings.recommend_products_position == 'right' -%}
            {%- render 'app-recommend-products', product: product -%}
          {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}

    {% comment %} 支付icon和延保在右侧默认位置 {% endcomment %}
    {%- if pay_wrannty.size == 0 and position == 'right' and both_enable -%}
        {% render 'pay-warranty-v4', block_class: 'pc-block', first_icon_list: first_icon_list, warranty_list:warranty_list, warranty_enable:warranty_enable, pay_enable:pay_enable %}
    {%- endif -%}

    {%- if pay_wrannty.size == 0 and both_enable -%}
        {% render 'pay-warranty-v4', block_class: 'mobile-block', first_icon_list: first_icon_list, warranty_list:warranty_list, warranty_enable:warranty_enable, pay_enable:pay_enable %}
    {%- endif -%}

    {%- if product.has_only_default_variant == true -%}
      {%- render "product-variants-json", variant: product.selected_or_first_available_variant, id: "selected-variant", show_discount_price: settings.display_auto_discount_price_in_sku -%}
    {%- else -%}
      {%- render "product-variants-json", variants: product.variants, id: "selected-variant", show_discount_price: settings.display_auto_discount_price_in_sku -%}
    {%- endif -%}
  </div>

  {% unless template == 'product.nosale' %}
    {% render
      'app-stickyCart',
      enable_shortage_reminds: section.settings.enable_shortage_reminds,
      mb_show_origin_price: section.settings.mb_show_origin_price,
    %}
  {% endunless %}
</div>

{% comment %} 底部推荐产品 {% endcomment %}
{%- assign recommend_products = section.blocks | where: 'type', 'recommend_products' -%}
{%- if recommend_products.size > 0 and settings.recommend_products_position == 'bottom' -%}
  {%- render 'app-recommend-products', product: product -%}
{%- endif -%}

{% render "product-appld-json" %}

<script src="{{ 'new-product.min.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "商详页4.0主模块（价格直降）",
    "tag": "section",
    "class": "section section-product-main-new",
    "enabled_on": {
      "templates": ["product"]
    },
    "settings": [
      {"type": "header", "content": "左侧（橱窗图/视频/3D模型）设置"},
      {"type": "text", "id": "product_photos_i18n", "label": "图片选项\"Photos\"多语言", "default": "Photos"},
      {"type": "text", "id": "product_video_i18n", "label": "视频选项\"Intro\"多语言", "default": "Intro"},
      {"type": "text", "id": "product_3d_model_i18n", "label": "3d模型选项\"3D\"多语言", "default": "3D"},
      {
        "type": "checkbox",
        "id": "product_3d_model_show_unfold",
        "label": "是否启用3D模型展开（Unfold）/折叠（Fold）的视图选项",
        "default": false
      },
      {"type": "text", "id": "product_unfolded_i18n", "label": "\"Unfolded\"多语言", "default": "Unfolded"},
      {"type": "text", "id": "product_folded_i18n", "label": "\"Folded\"多语言", "default": "Folded"},

      {"type": "header", "content": "右侧（产品信息）设置"},
      {"type": "richtext", "id": "product_extras_msg", "label": "产品信息补充"},
      {"type": "text", "id": "tax", "label": "免税信息"},
      {"type": "richtext", "id": "tax_fee_explanation", "label": "税费说明"},
      {"type": "header", "content": "产品价格直降"},
      {"type": "checkbox", "id": "show_product_direct_way", "label": "是否开启", "default": false},
      {"type": "select", "id": "product_direct_way",
        "options": [
          { "value": "way_one", "label": "方案一" },
          { "value": "way_two", "label": "方案二" },
          { "value": "way_three", "label": "方案三" }
        ],
        "default": "way_one",
        "label": "实现方式",
        "info": "方案一：展示的价格：加一个新字段，取价格Shopify的价格（字段名称中不包含price）；原来的价格字段，取shopify的原价，不展示；展示的划线价：逻辑不变，用原来的原价字段，取shopify的原价。方案二：字段名称都改为不包含price，展示的价格：取自动计算的折后价；展示的划线价：取Shopify的原价（有原价且原价大于价格时）或价格（无原价或原价小于价格时）。方案三：新增一个最终价展示在现有价格下，最终价取自动计算的折后价，需要按SPU维度控制是否展示。",
        "visible_if": "{{ section.settings.show_product_direct_way == true }}"
      },
      {"type": "text", "id": "product_direct_way_three_text", "label": "方案三文案", "default": "Final Price", "visible_if": "{{ section.settings.show_product_direct_way == true and section.settings.product_direct_way == 'way_three' }}"},


      {"type": "header", "content": "底部粘性购物车"},
      {"type": "checkbox", "id": "mb_show_origin_price", "label": "Mobile端显示划线价", "default": true},

      {"type": "header", "content": "到货提醒设置"},
      {"type": "checkbox", "id": "enable_shortage_reminds", "label": "开启到货提醒", "default": true},
      {
        "type": "text", "id": "shortage_title", "label": "Shortage form title",
        "default": "Notify Me When Available for Pre-order"
      },
      {
      "type": "text", "id": "shortage_content", "label": "Shortage form content",
        "default": "Leave your email below to get a notification when the product is available for pre-order."
      },
      {"type": "text", "id": "shortage_input_tips", "label": "Placeholder", "default": "Enter Your Email"},
      {"type": "text", "id": "shortage_submit", "label": "Button text", "default": "Notify Me"},
      {
        "type": "richtext", "id": "shortage_policy", "label": "Policy",
        "default": "<p>I have read and agreed to the <a href=\"https:\/\/www.jackery.com\/policies\/terms-of-service\" title=\"Jackery Terms and service\">Terms<\/a> and <a href=\"https:\/\/ca.jackery.com\/policies\/privacy-policy\" title=\"https:\/\/ca.jackery.com\/policies\/privacy-policy\">Privacy Policy<\/a>.<\/p>"
      },
      {
        "type": "text", "id": "shortage_reminds_success", "label": "Tips success",
        "default": "Successfully subscribed! We'll let you know as soon as this product is available for purchase."
      },
      {
        "type": "text", "id": "shortage_reminds_error", "label": "Tips error",
        "default": "Oops, something went wrong. Please try again later."
      },
      { "type": "checkbox", "id": "use_old_code", "label": "仅头部为4.0样式", "default": false , "info": "页面为3.0商详页，头部切换了4.0，需开启；"},

      {"type": "header", "content": "支付icon与延保模块设置"},
      {"type": "checkbox", "id": "is_show_new_pay", "label": "启用模板级位置开关", "default": false},
      {"type": "select", "id": "pc_pay_position",
          "options": [
            { "value": "left", "label": "左侧" },
            { "value": "right", "label": "右侧" },
          ],
          "default": "left",
          "label": "PC端位置",
          "info": "（①左侧：套图下方 ②右侧：商品信息最底部,模板优先级比元字段高）"
      },
      {"type": "header", "content": "积分版块"},
      {"type": "checkbox", "id": "is_show_point", "label": "启用积分文案版块开关", "default": true},
    ],
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "warranty_item",
        "name": "延保信息展示(商品橱窗图下方显示)",
        "limit": 4,
        "settings": [
          {"type": "text", "id": "title", "label": "标题"},
          {"type": "image_picker", "id": "icon", "label": "ICON图"}
        ]
      },
      {
        "type": "product_points_text",
        "name": "商品积分文案版块",
        "settings": [
          {
            "type": "header",
            "content": "内容配置",
            "info":"说明：未配置内容（图片和文案）时，则展示【元对象-3.0&4.0商详页-商品积分文案版块】配置数据",
          },
          {
            "type": "image_picker",
            "id": "points_icon",
            "label": "ICON图片"
          },
          {
            "type": "richtext",
            "id": "points_text",
            "label": "积分文案（文案示例：成为会员可以获得：$points积分，请登录）",
            "default": "<p>成为会员可以获得：$points积分，请登录</p>",
            "info": "注意：$points 为变量插值，会自动按照倍率将价格换算成积分替换，可以移动其位置，但不要改变形式，例如改成 $ points 或 $Points 都是错误的，$btn为变量插值为配置项弹窗按钮文案替换使用，&nbsp;可以实现空格"
          },
           {"type": "select", "id": "pop",
