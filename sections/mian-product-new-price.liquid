      color: #1A1A1A;
      line-height: 4.26666667vw;
      max-width: 79.2vw;
    }
    .pay-wrannty.v3 .pay-wrannty-item span {
      max-width: 74.4vw;
    }
    .pay-wrannty .new-pay-box {
      padding-top: 1.33333333vw;
      display: flex;
      gap: 3.6vw;
    }
    .pay-wrannty .new-pay-box >img {
      width: 6.4vw;
