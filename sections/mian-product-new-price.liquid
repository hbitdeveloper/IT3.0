{{ 'new-product.min.css' | asset_url | stylesheet_tag }}
{% style %}
  .section-product-main-new {
    overflow: visible;
    padding-top: 40px
  }
  @media screen and (max-width: 1024px) {
    .add_cart_error_wrapper {max-width: 91.4666666666667vw;width: 91.4666666666667vw;margin: -5vw auto 5.8vw;}
  }
  /* .product-main-block{gap: 0;padding: 0 100px;} */
  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper-slide .product-tag-img img {width: 210px;}
  @media screen and (min-width: 1024px) {
    .pc-left-v4{
      display: flex;
      justify-content: center;
    }

    .product-main-block {
      width: 1200px;
      gap: 0;
    }

    /* PC端 缩略图 */
    .product-main-block .product-media-container .product-media-container__inner .product-image-thumbs {
      position: absolute;
      bottom: 72px;
      left: 50%;
      transform: translateX(-50%) scaleX(0.5) scaleY(0.0833333333333333);
      z-index: 2;
      height: 48px;
      margin-bottom: 0;
      transition: all .3s;
      transform-origin: 50% 100%;
    }

     .product-main-block .product-media-container .pay-warranty-container .product-image-thumbs {
      bottom: 150px;
    }
     .product-main-block .product-media-container .pay-warranty-container.pay-warranty-container-three .product-image-thumbs {
      bottom: 180px;
    }

    .product-main-block .product-media-container .product-media-container__inner:hover .product-image-thumbs {
      transform: translateX(-50%) scaleX(1) scaleY(1);
    }

    .product-main-block .product-media-container .product-media-container__inner.product-media-container__inner--nopt .product-image-thumbs {
      bottom: 18px;
    }

    .product-main-block .product-media-container .product-media-container__inner.pay-only-two-container .product-image-thumbs {
      bottom: 80px;
    }

    .product-main-block .product-media-container .product-media-container__inner.pay-only-three-container.pay-only-two-container .product-image-thumbs {
      bottom: 110px;
    }

    .product-main-block .product-media-container .product-media-container__inner .product-image-thumbs .swiper {
      width: 588px;
      height: 100%
    }

    .product-main-block .product-media-container .product-media-container__inner .product-image-thumbs .swiper .swiper-slide {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      border-radius: 0;
      border: none;
      overflow: hidden;
      background-color: #D8D8D8;
      transition: all .3s;
      cursor: pointer;
    }

    .product-main-block .product-media-container .product-media-container__inner .product-image-thumbs .swiper .swiper-slide:last-child {
      margin-right: 0!important;
    }

    .product-main-block .product-media-container .product-media-container__inner .product-image-thumbs .swiper .swiper-slide.swiper-slide-thumb-active {
      background-color: #1A1A1A;
    }

    .product-main-block .product-media-container .product-media-container__inner .product-image-thumbs .swiper .swiper-slide img {
      opacity: 0;
      flex: 0 0 auto;
      max-width: 100%;
      max-height: 100%;
      width: 40px;
      height: 40px;
      transition: all .3s;
    }

    .product-main-block .product-media-container .product-media-container__inner:hover .product-image-thumbs .swiper-slide {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 2px;
      overflow: hidden;
      background-color: rgba(255, 255, 255, 0.5);
      border: 1px solid rgba(153, 153, 153, 0.5);
      transition: all .3s;
      cursor: pointer;
    }

    .product-main-block .product-media-container .product-media-container__inner:hover .product-image-thumbs .swiper-slide.swiper-slide-thumb-active {
      border: 1px solid #666;
      background-color: white;
      opacity: 1;
    }

    .product-main-block .product-media-container .product-media-container__inner:hover .product-image-thumbs .swiper-slide.swiper-slide-thumb-active img {
      opacity: 1;
    }

    .product-main-block .product-media-container .product-media-container__inner:hover .product-image-thumbs .swiper-slide img {
      opacity: .4;
      flex: 0 0 auto;
      max-width: 100%;
      max-height: 100%;
      height: auto;
      width: 40px;
      height: 40px;
      transition: opacity .3s;
    }

    .product-main-block .product-media-container .product-media-container__inner .product-image-thumbs .swiper .swiper-slide:hover {
      background-color: white;
    }
    .product-main-block .product-media-container .product-media-container__inner .product-image-thumbs .swiper .swiper-slide:hover img {
      opacity: 1;
    }
    .product-main-block .product-media-container {
      width: 650px;
      margin-right: 50px;
      padding-bottom: 90px;
    }
  }

  .product-main-block .product-media-container .product-media-container__inner {
    position: sticky;
    top: calc(var(--header-main) + 40px);
  }

  {% if settings.show_pdp_breadcrumbs %}
    .section-product-main-new {
      padding-top: 64px;
    }
    .product-main-block .product-media-container .product-media-container__inner {
      top: calc(var(--header-main) + 80px);
    }
  {% endif %}

  .product-main-block .product-media-container .product-media-container__inner .product-media__box {
    height: 650px;
    background: #FFFFFF;
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper {
    height: 100%;
    user-select: none
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper-slide img {
    flex: 0 0 auto;
    max-width: 100%;
    max-height: 100%;
    width: 100%;
    height: auto
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper--pagebtn,
  .pswp .swiper--pagebtn {
    height: 48px;
    width: 48px;
    border-radius: 50%;
    overflow: hidden;
    background-color: rgba(26, 26, 26, .1);
    transition: .5s;
    display: flex;
    z-index: 1;
    cursor: pointer;
    justify-content: center;
    align-items: center
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-tab-bar.product_gallery-tab-bar--half,
  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper-pagination {
    display: none
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper--pagebtn::after,
  .pswp .swiper--pagebtn::after {
    transform: translateX(1px);
    font-weight: 700;
    color: #fff;
    font-size: 16px
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper--pagebtn.swiper-button-next,
  .pswp .swiper--pagebtn.swiper-button-next {
    right: 16px
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper--pagebtn.swiper-button-prev,
  .pswp .swiper--pagebtn.swiper-button-prev {
    left: 16px
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper--pagebtn.swiper-button-prev::after,
  .pswp .swiper--pagebtn.swiper-button-prev::after {
    transform: translateX(-1px)
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper--pagebtn:hover,
  .pswp .swiper--pagebtn:hover {
    background-color: rgba(0, 0, 0, .15)
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .swiper .swiper--pagebtn:active,
  .pswp .swiper--pagebtn:active {
    opacity: .8
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-tab-bar {
    bottom: -16px;
    z-index: 9;
    display: flex;
    align-items: center;
    height: 32px;
    left: 50%;
    transform: translate(-50%, 100%);
    column-gap: 8px;
    width: max-content;
    max-width: 100%;
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-tab-bar .product_gallery-tab_item {
    z-index: 1;
    font-size: 14px;
    color: rgba(0, 0, 0, .85);
    cursor: pointer;
    display: flex;
    align-items: center;
    width: fit-content;
    justify-content: center;
    padding: 0 16px;
    height: 100%;
    border-radius: 16px;
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-tab-bar .product_gallery-tab_item:hover {
    background-color: rgba(0,0,0,0.05);
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-3d-tab {
    z-index: 2;
    display: none;
    align-items: center;
    column-gap: 48px;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(0,0,0,0.15);
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-3d-tab_item {
    font-family: var(--jds-font-family);
    font-weight: 400;
    font-size: 16px;
    color: #999;
    cursor: pointer;
  }
  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-3d-tab_item.active {
    color: #1A1A1A;
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-3d-tab_highlight {
    height: 2px;
    left: 0;
    bottom: -1px;
    background: #1A1A1A;
    transition: all .3s;
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-tab-bar .product_gallery-tab_item span {
    padding-left: 8px;
    font-weight: 500
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-tab-bar .product_gallery-tab_item svg path {
    fill: rgba(0, 0, 0, 0.85)
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-tab-bar .product_gallery-tab_item.active {
    color: #fff
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-tab-bar .product_gallery-tab_item.active svg path {
    fill: #fff
  }

  .product-main-block .product-media-container .product-media-container__inner .product-media__box .product_gallery-tab-bar .product--list-tabs_slider {
    height: 100%;
    left: 0;
    top: 0;
    background: #fff;
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.85);
    border-radius: 16px;
    height: 100%;
    transition: all .3s;
    /* box-shadow: rgba(100, 100, 111, .2) 0 7px 29px 0 */
  }

  .product-main-block .product-media-container .product-media-container__inner .product-warranty_tab {
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #191919;
    font-weight: 400;
    font-size: 14px;
    width: 500px;
    margin: 0 auto;
    gap: 12px;
    transform: translateY(70px);
  }

  .product-main-block .product-media-container .product-media-container__inner .product-warranty_tab .product-warranty-item {
    display: flex;
    align-items: center;
    color: #1A1A1A;
    font-weight: 500;
  }

  .product-main-block .product-media-container .product-media-container__inner .product-warranty_tab img {
    height: 24px;
    margin-right: 4px
  }

  .product-main-block .product-info-container {
    width: 500px
  }

  .product-main-block .product-info-container .product-form__input,
  .product-main-block .product-info-container .product-info_block,
  .product-main-block .product-info-container .shopify-app-block {
    margin-bottom: 18px
  }

  .product-main-block .product-info-container>.product-info_block:last-child {
    margin-bottom: 0;
  }

  .product-main-block .product-info-container .product__title {
    letter-spacing: -1px;
    color: rgba(25, 25, 25, 1);
  }

  .product-main-block .product-info-container .product__price .product--price__discount,
  .product-main-block .product-info-container .product__djp .product--price__discount {
    font-size: 18px;
    color: #626262;
    font-weight: 400;
    display: inline-block;
    margin-top: 5px;
  }

  .product-main-block .product-info-container .product__price .product--price__discount a,
  .product-main-block .product-info-container .product__djp .product--price__discount a {
    color: #0070d5
  }

  .product-main-block .product-info-container .product--price- {
    display: none;
  }

  .product-main-block .product-info-container .product-final-wrap {
    width: max-content;
    display: flex;
    align-items: center;
    background-color: #FFF6F1;
    border-radius: 6px;
  }

  .product-main-block .product-info-container .product-final-wrap span:nth-of-type(1){
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 12px;
    font-size: 18px;
    line-height: 24px;
    color: var(--jds-color-primary);
    font-weight: 500;
  }

  .product-main-block .product-info-container .product-final-wrap span:nth-of-type(2){
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    font-size: 24px;
    line-height: 45px;
    background-color: var(--jds-color-primary);
    color: #FFF;
    border-radius: 6px;
    font-weight: 600;
  }

  .product-main-block .product-info-container .product-apps {
    height: 50px;
    background-color: #f5f5f5;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(0, 0, 0, .15)
  }

  .product-main-block .product-info-container .product-form__input .form__label {
    color: rgba(25, 25, 25, 1);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 16px
  }

  .product-main-block .product-info-container .product-form__input .variant-select input[type=checkbox],
  .product-main-block .product-info-container .product-form__input .variant-select input[type=radio] {
    width: 0;
    height: 0;
    position: absolute;
    overflow: hidden;
    clip: rect(0, 0, 0, 0)
  }

  .product-main-block .product-info-container .product-form__input .variant-select input[type=checkbox]:checked+label,
  .product-main-block .product-info-container .product-form__input .variant-select input[type=radio]:checked+label {
    background: #ffffff;
  }

  .product-main-block .product-info-container .product-form__input .variant-select input[type=checkbox]:checked+label::after,
  .product-main-block .product-info-container .product-form__input .variant-select input[type=radio]:checked+label::after {
    border: solid 2px var(--primary-color)
  }

  .product-main-block .product-info-container .product-form__input .variant-select label {
    position: relative;
    display: flex;
    border-radius: 8px;
    padding: 20px 24px;
    /* height: 88px; */
    min-height: 88px;
    align-items: center;
    color: #333;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    margin-bottom: 10px;
    justify-content: space-between;
    line-height: 24px;
    align-items: center;
  }

  .product-main-block .product-info-container .product-form__input .variant-select label .option-name {
    width: 330px;
    /* -webkit-box-orient: vertical;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    overflow: hidden; */
  }
  .product-main-block .product-info-container .product-form__input .variant-select label .option-price,
  .product-main-block .product-info-container .product-form__input .variant-select label .option-djp {
    display: flex;
    align-items: flex-end;
    flex-direction: column;
  }

  .product-main-block .product-info-container .product-form__input .variant-select label .variant-select--tag {
    line-height: 16px;
    position: absolute;
    top: 0;
    right: 0;
    background: #FE7704;
    border-radius: 0px 8px 0px 8px;
    font-weight: 500;
    font-size: 12px;
    color: #FFFFFF;
    padding: 0 10px;
  }

  .product-main-block .product-info-container .product__description p,
  .product-main-block .product-info-container .product__description ul :last-child {
    margin-bottom: 0
  }

  .accesorries-content {
    align-items: center
  }

  .product-main-block .product-info-container .product-form__input .variant-select label img {
    width: 45px;
    height: 45px;
    margin-right: 8px
  }

  .product-main-block .product-info-container .product-form__input .variant-select label.disabled {
    opacity: .6;
    cursor: not-allowed
  }

  .product-main-block .product-info-container .product-form__input .variant-select label.disabled .option-price,
  .product-main-block .product-info-container .product-form__input .variant-select label.disabled .option-djp {
    display: none;
  }
  .product-main-block .product-info-container .product-form__input .variant-select label.disabled span.visually-hidden {
    display: initial;
    text-wrap: nowrap;
    padding-left: 12px;
    word-break: keep-all
  }

  .product-main-block .product-info-container .product-form__input .variant-select label::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    right: 0;
    z-index: 1;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, .15)
  }

  .product-main-block .product-info-container .product-form__input .variant-select label:hover::after {
    border: solid 1px rgba(0, 0, 0, .4)
  }

  .product-main-block .product-info-container .product_main--accesorries {
    margin-bottom: 0;
  }

  .product-main-block .product-info-container .product_main--accesorries .form__label + .variant-select.variant-select__accesorries {
    margin-bottom: 18px;
  }

  .product-main-block .product-info-container .product-form__input .variant-select.variant-select__accesorries {
    display: grid;
    grid-template-columns: repeat(2, calc(50% - 5px));
    column-gap: 10px
  }

  .product-main-block .product-info-container .product-form__buttons {
    display: flex;
    column-gap: 16px
  }

  .product-main-block .product-info-container .product-form__buttons button:not(.shopify-payment-button button) {
    flex: 1;
    height: 45px;
    border-radius: 30px;
    font-size: 18px;
    font-weight: 700;
    color: var(--primary-color);
    background-color: #fff;
    border: solid 2px var(--primary-color);
    transition: .3s
  }
  .jky-v5 .product-main-block .product-info-container .product-form__buttons button:not(.shopify-payment-button button) {
    border-radius: 0;
  }

  .product-main-block .product-info-container .product-form__buttons button.loading:not(.shopify-payment-button button)::after {
    color: #fff !important
  }

  .product-main-block .product-info-container .product-form__buttons button[disabled]:not(.shopify-payment-button button) {
    opacity: .6;
    cursor: not-allowed
  }

  .shopify-payment-button {
    flex: 1
  }

  .product-main-block .product-info-container .product-form__buttons button.button-fill {
    color: #fff;
    background-color: var(--primary-color)
  }

  .product-main-block .product-info-container .product-form__buttons button.button-fill:active:not(:disabled) {
    opacity: 1;
    color: #fff;
    border: 2px solid #fd2f00;
    background-color: #fd2f00
  }

  .product-main-block .product-info-container .product-form__buttons button:hover:not(:disabled) {
    opacity: .8
  }

  .product-main-block .product-info-container .product-form__buttons button:active:not(:disabled, .shopify-payment-button__more-options) {
    opacity: 1;
    color: #fd2f00;
    border: 2px solid #fd2f00;
    background-color: #fff
  }

  .product-main-block .product-info-container .product__description {
    background-color: #F7F9FA;
    padding: 10px 16px 16px;
    font-size: 14px;
    line-height: 24px;
    border-radius: 8px;
    color: #666666;
  }

  .product-main-block .product-info-container .product__description h1 strong,
  .product-main-block .product-info-container .product__description h2 strong,
  .product-main-block .product-info-container .product__description h3 strong,
  .product-main-block .product-info-container .product__description h4 strong,
  .product-main-block .product-info-container .product__description h5 strong,
  .product-main-block .product-info-container .product__description h6 strong {
    font-size: 16px;
    font-weight: 600;
    line-height: 26px;
    display: inline-block;
    margin-bottom: 6px;
    color: #626262
  }

  .product-main-block .product-info-container .product__description ul {
    margin-bottom: 0;
  }

  .product-main-block .product-info-container .product__description ul li {
    list-style-type: disc;
    list-style-position: inside;
    /* text-indent: 8px;
    color: #626262 */
  }
  .product-main-block .product-info-container .product__description ol li {
    list-style-type: decimal;
    list-style-position: inside;
    /* text-indent: 8px;
    color: #626262 */
  }

  .product-main-block .product-info-container .product__description ul li p {
    display: inline;
  }

  .product-main-block .product-info-container .product__description .description-content {
    max-height: 166px;
    transition: max-height .3s;
    line-height: 23.5px;
    overflow: hidden;
  }

  .product-main-block .product-info-container .product__description button {
    font-weight: 400;
    background-color: transparent;
    color: var(--jds-color-primary);
    font-size: 14px;
    padding-top: 10px;
  }

  .product-main-block .product-info-container .product__description button > jds-icon {
    display: inline-block;
    font-size: 16px;
    transform: rotate(90deg);
    transition: transform .3s;
  }
  .product-main-block .product-info-container .product__description button.active > jds-icon {
    transform: rotate(-90deg);
    transition: transform .3s;
  }

  .product-main-block .buy-it-now-custom-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 45px;
    background-color: var(--primary-color) !important;
    color: white !important;
    font-weight: 700;
    font-size: 18px;
    border-radius: 30px;
    cursor: pointer;
  }
  .jky-v5 .product-main-block .buy-it-now-custom-btn {
    border-radius: 0;
  }

  .product-main-block .buy-it-now-custom-btn:disabled {
    opacity: 0.6;
