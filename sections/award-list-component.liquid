{% schema %}
{
  "name": "Award List Component",
  "tag": "section",
  "class": "award-list-component layer-container section-container",
  "settings": [
    {
      "type": "text",
      "id": "sectionTitle",
      "label": "Section Title",
      "default": "ANNOUNCEMENT OF LOTTERY RESULTS"
    }
  ],
  "blocks": [
    {
      "name": "List Item",
      "type": "slide",
      "settings": [
        {
          "type": "html",
          "id": "winningAccountOne",
          "label": "Winning Account One"
        },
        {
          "type": "html",
          "id": "winningAccountTwo",
          "label": "Winning Account Two"
        }
      ]
    }
  ]
}
{% endschema %}
<div class="section-wrapper">
  <h2 class="section-title">{{ section.settings.sectionTitle }}</h2>
  <div class="section-content">
    <ul>
      {% for block in section.blocks %}
        <li>
          <span>{{ block.settings.winningAccountOne }}</span>
          <span>{{ block.settings.winningAccountTwo }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>
