{% comment %} PDF描述组件 {% endcomment %}
{% schema %}
{
  "name": "PDF Description Component",
  "tag": "section",
  "class": "pdf-description-component",
  "disabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "html",
      "id": "description",
      "label": "Description",
      "default": "With 12 years of dedication and adherence to strict standards, each product is meticulously crafted for excellence. Each year, millions of products, with up to 39 certifications across various countries, are manufactured from Jackery’s self-owned factory. They're shipped worldwide, offering users a reliable power solution. Our mission is to bring green energy to all, making reliable products accessible to consumers globally. Explore the Jackery Solar Generator (Carbon-reducing Product) Standard to witness Jackery's unwavering commitment to reliability."
    },
    {
      "type": "text",
      "id": "btnLabel",
      "label": "Button Label",
      "default": "Explore Jackery Solar Generator (Carbon-reducing Product) Standard"
    },
    {
    "type": "url",
      "id": "btnLink",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "contentAlign",
      "label": "Content Align",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "presets": [{
    "name": "pdf description component"
  }]
}
{% endschema %}
{% if section.settings.description != blank or section.settings.btnLabel != blank %}
  <div class="pdf-description-component">
    <div class="pdf-description-box">
      {% if section.settings.description != blank %}
        <div class="description section-container type-{{ section.settings.contentAlign }}" >{{ section.settings.description }}</div>
      {% endif %}
      {% if section.settings.btnLabel != blank %}
        <div class="btn-box">
          <a class="btn-more btn-link" href="{{ section.settings.btnLink }}">{{ section.settings.btnLabel }}&nbsp;&nbsp;<span>></span></a>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

