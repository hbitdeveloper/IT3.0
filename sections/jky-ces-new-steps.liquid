            top: 3.958vw;
            left: 0;
        }
        .ces_step_lb {
            width: 24.375rem;
            bottom: 3.958vw;
            left: 0;
        }
        .ces_step_rt {
            width: 24.375rem;
            top: 2.6302vw;
            right: 0;
        }
        .ces_step_rb {
            width: 24.375rem;
            bottom: 2.6302vw;
            right: 0;
        }
    {% else %}
        .ces_step_lt {
            width: 25.416666vw;
            top: 3.958vw;
            left: 0;
        }
        .ces_step_lb {
            left: 0;
            width: 36.40625vw;
            top: 18.33333vw;
        }
        .ces_step_rt {
            width: 21.19791vw;
