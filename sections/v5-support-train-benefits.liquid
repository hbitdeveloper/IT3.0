<div class="train-in-container lg:px-0 {{section.settings.page_width}}" data-train-in-benefits-container>
  <div class="font-bold text-[#000] text-center text-[1.5rem] leading-[1.75rem] my-[1rem] lg:mt-[30px] lg:text-[3rem] lg:leading-[3.625rem]">
    {{ section.settings.heading }}
  </div>

  <div class="grid grid-cols-1 mb-[0.625rem] lg:grid-cols-2 lg:gap-6 lg:mt-[3.125rem] lg:mb-[5rem]">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
        <div class="flex flex-col justify-start items-center bg-[#f5f5f5] py-[0.7813rem] px-[1.875rem] mt-[0.625rem] lg:py-[2.5rem] lg:px-[2rem] lg:h-[34.375rem]" {{ block.shopify_attributes }}>
          <h3 class="text-[#333] text-center text-[1rem] lg:text-[2rem]">{{ block.settings.title }}</h3>
          <div class="text-[#333] text-center text-[1rem] leading-[1.1875rem] my-[1rem] lg:text-[1.25rem] lg:leading-[1.5rem] lg:mt-[1.875rem] lg:mb-[4.375rem]">
            {{ block.settings.text }}
          </div>
          {% if block.settings.icon != blank %}
            <img class="w-[7.1875rem] lg:w-[10.625rem]" src="{{ block.settings.icon | image_url: width: 340 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% elsif block.settings.icon_url != blank %}
            <img class="w-[7.1875rem] lg:w-[10.625rem]" src="{{ block.settings.icon_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  @media (min-width: 1024px) {
    [data-train-in-benefits-container] {
      max-width: var(--train-in-benefits-container-pc);
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

{% schema %}
{
  "name": "V5 Support Train Benefits",
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1312px"
        },
        {
          "value": "w-full",
          "label": "铺满/100%"
        }
      ],
      "default": "section-container",
      "label": "组件宽度"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>There’s every reason to train in with Jackery.<br>Including one very big 🌎 one.</p>"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Simple"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "With just 4 steps, you can train your old product to a new one."
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_url",
          "label": "Icon URL (fallback)",
          "default": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/simple.png?v=1693822870"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "V5 Support Train Benefits",
      "category": "V5.0 Support",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Simple",
            "text": "With just 4 steps, you can train your old product to a new one.",
            "icon_url": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/simple.png?v=1693822870"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Best Value",
            "text": "Get the most out of the product you train in and get a valuable Jackery gift card.",
            "icon_url": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/best-value.png?v=1693822870"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Good For You, Good For The",
            "text": "train in your old product to reduce waste and support sustainability.",
            "icon_url": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/good-for-you.png?v=1693822870"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Upgrade With Instant Savings",
            "text": "Apply your gift card toward a new Jackery product whenever you’re ready.",
            "icon_url": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/saving.png?v=1693822870"
          }
        }
      ]
    }
  ]
}
{% endschema %}
