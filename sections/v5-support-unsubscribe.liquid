
{{ 'sections-v5-support-unsubscribe.css' | asset_url | stylesheet_tag }}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  class="v5-support-unsubscribe section-padding"
  id="v5-support-unsubscribe-{{ section.id }}"
  style="{{ style }}"
  data-submit-text="{{ section.settings.submit_text | escape }}"
  data-loading-text="{{ section.settings.loading_text | escape }}"
  data-error-email-empty="{{ section.settings.error_email_empty | escape }}"
  data-error-email-invalid="{{ section.settings.error_email_invalid | escape }}"
  data-request-failed-text="{{ section.settings.request_failed_text | escape }}"
>
  <div class="main-container">
    <div class="form-box">
      <div class="form-background">
        {% if section.settings.background_image_desktop != blank %}
          <img
            class="form-background-desktop"
            src="{{ section.settings.background_image_desktop }}"
          >
        {% endif %}
        {% if section.settings.background_image_mobile != blank %}
          <img
            class="form-background-mobile"
            src="{{ section.settings.background_image_mobile }}"
          >
        {% endif %}
      </div>

      <div class="form-content">
        <div class="js-unsubscribe-initial">
          <h2 class="form-title">{{ section.settings.title_before }}</h2>
          <div class="form-sub-title">{{ section.settings.subtitle_before }}</div>
          <form class="email-form js-unsubscribe-form" novalidate>
            <input
              class="email-input js-unsubscribe-email"
              type="email"
              inputmode="email"
              autocomplete="email"
              placeholder="{{ section.settings.input_placeholder | escape }}"
            >
            <div class="help js-unsubscribe-error" hidden></div>
            <div class="submit-box">
              <jds-button type="submit" class="js-unsubscribe-submit w-full">{{ section.settings.submit_text }}</jds-button>
            </div>
          </form>
        </div>

        <div class="js-unsubscribe-success" hidden>
          <h2 class="form-title">{{ section.settings.title_after }}</h2>
          <div class="form-sub-title is-submit">{{ section.settings.subtitle_after }}</div>
          <div class="submit-success">
            <h3 class="form-title">{{ section.settings.confirm_title }}</h3>
            <div class="form-sub-title is-submit">{{ section.settings.confirm_content }}</div>
            <div class="social-list">
              {% for block in section.blocks %}
                {% if block.type == 'social_item' %}
                    <a
                      class="social-link js-social-link"
                      href="{{ block.settings.default_url | escape }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="{{ block.settings.label | escape }}"
                      data-link-default="{{ block.settings.default_url | escape }}"
                    >
                      {% if block.settings.icon_url != blank and block.settings.default_url != blank %}
                        <img src="{{ block.settings.icon_url | escape }}" alt="{{ block.settings.label | escape }}">
                      {% endif %}
                    </a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'sections-v5-support-unsubscribe.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V5-Support Unsubscribe",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "PC边距" },
    { "type": "number", "id": "padding_top", "label": "上边距", "default": 0 },
    { "type": "number", "id": "padding_bottom", "label": "下边距", "default": 20 },
    { "type": "header", "content": "MB边距" },
    { "type": "text", "id": "mb_padding_type", "default": "custom", "label": "MB边距", "visible_if": "{{ false }}" },
    { "type": "number", "id": "padding_top_mb", "label": "上边距", "default": 0 },
    { "type": "number", "id": "padding_bottom_mb", "label": "下边距", "default": 20 },
    { "type": "text", "id": "background_image_desktop", "label": "PC background image URL", "default": "https://cdn.shopify.com/s/files/1/0970/9262/files/unsubscribe-envelope-pc.jpg?v=1672974731" },
    { "type": "text", "id": "background_image_mobile", "label": "Mobile background image URL", "default": "https://cdn.shopify.com/s/files/1/0970/9262/files/unsubscribe-envelope-m.jpg?v=1672974731" },
    { "type": "text", "id": "title_before", "label": "Initial title", "default": "Unsubscribe from Jackery emails" },
    { "type": "textarea", "id": "subtitle_before", "label": "Initial subtitle", "default": "Enter your email address below to unsubscribe from promotional emails.\nYou may still receive essential order or service updates.\nWe are sorry to see you go." },
    { "type": "text", "id": "input_placeholder", "label": "Email placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "submit_text", "label": "Submit button text", "default": "Submit" },
    { "type": "text", "id": "loading_text", "label": "Loading button text", "default": "Submitting..." },
    { "type": "text", "id": "error_email_empty", "label": "Empty email error", "default": "Please enter your email address." },
    { "type": "text", "id": "error_email_invalid", "label": "Invalid email error", "default": "Please enter a valid email address." },
    { "type": "text", "id": "request_failed_text", "label": "Request failed fallback text", "default": "Request failed. Please try again later." },
    { "type": "text", "id": "title_after", "label": "Submitted title", "default": "You have been unsubscribed" },
    { "type": "textarea", "id": "subtitle_after", "label": "Submitted subtitle", "default": "You will no longer receive promotional emails from Jackery.\nThank you for staying connected with us." },
    { "type": "text", "id": "confirm_title", "label": "After submit title", "default": "Stay connected with Jackery" },
    { "type": "textarea", "id": "confirm_content", "label": "After submit content", "default": "Follow us on social media for the latest product news.\nYou can reconnect with us any time." }
  ],
  "blocks": [
    {
      "type": "social_item",
      "name": "Social item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Facebook" },
        { "type": "text", "id": "icon_url", "label": "Icon image URL", "default": "https://cdn.shopify.com/s/files/1/0970/9262/files/u-icon-fb.png?v=1672974731" },
        { "type": "text", "id": "default_url", "label": "Default URL", "default": "https://www.facebook.com/jackery.inc/" }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5-Support Unsubscribe",
      "category": "V5.0 Support",
      "blocks": [
        {
          "type": "social_item",
          "settings": {
            "label": "Facebook",
            "icon_url": "https://cdn.shopify.com/s/files/1/0970/9262/files/u-icon-fb.png?v=1672974731",
            "default_url": "https://www.facebook.com/jackery.inc/"
          }
        },
        {
          "type": "social_item",
          "settings": {
            "label": "Twitter",
            "icon_url": "https://cdn.shopify.com/s/files/1/0970/9262/files/u-icon-tw.png?v=1672974730",
            "default_url": "https://twitter.com/jackeryinc"
          }
        },
        {
          "type": "social_item",
          "settings": {
            "label": "Instagram",
            "icon_url": "https://cdn.shopify.com/s/files/1/0970/9262/files/u-icon-ig.png?v=1672974731",
            "default_url": "https://www.instagram.com/jackeryusa/"
          }
        },
        {
          "type": "social_item",
          "settings": {
            "label": "YouTube",
            "icon_url": "https://cdn.shopify.com/s/files/1/0970/9262/files/u-icon-ytb.png?v=1672974731",
            "default_url": "https://www.youtube.com/user/jackeryinc"
          }
        }
      ]
    }
  ]
}
{% endschema %}
