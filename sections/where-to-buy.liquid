
<div class="store-map-component">
  {{ 'section-where-to-buy.min.css' | asset_url | stylesheet_tag }}
  <h2 class="title ">{{ section.settings.title }}</h2>
  <div class="desc">{{ section.settings.subTitle }}</div>
  <div
    class="search-box"
    data-source-id="{{section.settings.sourceId}}"
    data-items-per-page="{{section.settings.limit}}"
    data-enable-country-or-region-search="{{section.settings.countryOrRegionSearch}}"
    data-def-country-or-region="{{section.settings.defaultCountry}}"
    data-lat="{{section.settings.lat}}"
    data-lng="{{section.settings.lng}}"

    >
    
    <div class="common-search">
      <form id="commonSearch" action="">
        <input
          class="common-search-inp"
          type="search"
          placeholder="{{section.settings.searchPlaceholder}}">
      </form>
      <p class="icon-box icon-search">
        <jds-icon name="search" class="icon-search"></jds-icon>
      </p>
    </div>
    <div class="region-search">
      <div class="search-item country-region display-hide">
        <div class="curr-selected">
          <span class="search-placeholder">{{section.settings.countryRegion}}</span>
          <p class="selected">
            <span class="active-item"></span>
            <jds-icon name="close" class="icon-close" data-type="countryOrRegion"></jds-icon>
          </p>
        </div>
        <p class="icon-box icon-arrow">
          <jds-icon name="arrow-down"></jds-icon>
        </p>
        <ul class="region-list country-region-list" data-type="countryOrRegion"></ul>
      </div>
      <div class="search-item province display-hide">
        <div class="curr-selected">
          <span class="search-placeholder">{{ section.settings.province }}</span>
          <p class="selected">
            <span class="active-item"></span>
            <jds-icon name="close" class="icon-close" data-type="province"></jds-icon>
          </p>
        </div>
        <p class="icon-box icon-arrow">
          <jds-icon name="arrow-down"></jds-icon>
        </p>
        <ul class="region-list province-list" data-type="province"></ul>
      </div>
      <div class="search-item city display-hide">
        <div class="curr-selected">
          <span class="search-placeholder">{{ section.settings.city }}</span>
          <p class="selected">
            <span class="active-item"></span>
            <jds-icon name="close" class="icon-close" data-type="city"></jds-icon>
          </p>
        </div>
        <p class="icon-box icon-arrow">
          <jds-icon name="arrow-down"></jds-icon>
        </p>
        <ul class="region-list city-list" data-type="city"></ul>
      </div>
    </div>
  </div>

  <div class="content-box">
    <div class="store-list-box">
      <div class="abnormal-tips empty-tips jackery-rte display-hide">
        <img class="tips-img" data-src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/IP_0151ccce-8000-4b13-9fe8-dab3d6e4f59e.png?v=1701100175">
        {{ section.settings.noData }}
      </div>
      <div class="abnormal-tips error-tips jackery-rte display-hide">
        <img class="tips-img" data-src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/IP_0151ccce-8000-4b13-9fe8-dab3d6e4f59e.png?v=1701100175">
        {{ section.settings.searchError }}
      </div>
      <ul class="store-list display-hide"></ul>
    </div>
    <div id="map" class="store-map-box"></div>
  </div>
  <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCS607e5_FAKWT8xSiAQMEEgRrQOMrBlG0" data-cookieconsent="ignore" defer></script>
  <script src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/markerclusterer.js?v=1703039263" data-cookieconsent="ignore" defer></script>
  <script src="{{ 'section-where-to-buy.min.js' | asset_url }}" data-cookieconsent="ignore" defer></script>
</div>

{% schema %}
  {
    "name": "Where To Buy",
    "class": "where-to-buy",
    "settings": [
      {
        "type": "text",
        "id": "sourceId",
        "label": "Source ID"
      }, 
      {
        "type": "text",
        "id": "limit",
        "label": "Page Limit",
        "default": "10"
      },
      {
        "type": "text",
        "id": "lat",
        "label": "Center Lat",
        "default": "39.865246"
      },
      {
        "type": "text",
        "id": "lng",
        "label": "Center Lng",
        "default": "116.378517"
      },
      {
        "type": "text",
        "id": "searchPlaceholder",
        "label": "Search Placeholder",
        "default": "Search"
      },
      {
        "type": "checkbox",
        "id": "countryOrRegionSearch",
        "label": "Country Or Region Search",
        "default": false
      },
      {
        "type": "text",
        "id": "defaultCountry",
        "label": "Default Country",
        "default": "US"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Jackery 门店租赁地图"
      }, {
        "type": "text",
        "id": "subTitle",
        "label": "Sub Title",
        "default": "欢迎亲临您附近的官方授权点体验，也可通过线上官方商城购买智能电力生态产品~。"
      }, {
        "type": "text",
        "id": "countryRegion",
        "label": "Country/Region",
        "default": "国家/地区"
      }, {
        "type": "text",
        "id": "province",
        "label": "Province",
        "default": "省/州"
      }, {
        "type": "text",
        "id": "city",
        "label": "City",
        "default": "城市"
      }, {
        "type": "text",
        "id": "noData",
        "label": "No Data",
        "default": "暂无数据"
      }, {
        "type": "text",
        "id": "searchError",
        "label": "Search Error",
        "default": "搜索失败"
      }
    ]
  }
{% endschema %}