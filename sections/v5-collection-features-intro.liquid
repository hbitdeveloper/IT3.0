<style>

    .v5-collection-features-intro .right-card:last-child {
        width: 10.5rem;
    }

    @media only screen and (min-width: 1024px) {
        .v5-collection-features-intro .pc-show {
            display: flex;
        }
    }

</style>

{%- capture style -%}
    {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %} style="{{ style }}" class="section-padding">
    <div class=" flex flex-col gap-[1rem] lg:flex-row lg:items-stretch lg:gap-[1.5rem]">

        {% assign left_items = section.blocks | where: "type", "left_item" %}
        {% assign right_items = section.blocks | where: "type", "right_item" %}

        <div class="w-full lg:w-[40.5rem] bg-[#f5f5f3]">
            <div class="w-full overflow-hidden px-[1rem] pt-[1.5rem] pb-[1rem] lg:px-[2rem] lg:pt-[3.5rem] lg:pb-0">
                <p class="font-semibold text-[1rem] leading-[normal] text-[#242f20] lg:text-[1.75rem] lg:leading-[1.1]">
                    {{ section.settings.left_title | escape }}
                </p>
            </div>

            <div class="w-full px-0 pt-[1rem] pb-[1.5rem] lg:pt-[2.5rem] lg:pb-[3.5rem]">
                <div class="flex flex-col gap-[1.5rem] lg:gap-[2.5rem]">
                    {% for block in left_items %}
                        <div class="flex w-full items-center gap-[1.25rem] px-[1rem] lg:gap-[1.25rem] lg:px-[2rem]" {{ block.shopify_attributes }} >
                            {% if block.settings.icon != blank %}
                                <img class="h-[2.5rem] w-[2.5rem] shrink-0"
                                     src="{{ block.settings.icon | image_url: width: 80 }}"
                                     alt="{{ block.settings.icon.alt | escape }}" loading="lazy">
                            {% else %}
                                <div class="h-[2.5rem] w-[2.5rem] shrink-0">
                                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                                </div>
                            {% endif %}

                            <div class="flex min-w-0 flex-1 flex-col gap-[0.75rem] lg:gap-[0.5rem]">
                                <p class="font-semibold text-[0.875rem] leading-[normal] text-[#242f20] lg:text-[1.125rem] lg:leading-[1.1] lg:text-black line-clamp-1">
                                    {{ block.settings.title | escape }}
                                </p>
                                <p class="font-normal text-[0.75rem] leading-[normal] text-[rgba(36,47,32,0.9)] lg:text-[0.875rem] lg:leading-[1.375rem] lg:line-clamp-1 line-clamp-2">
                                    {{ block.settings.desc | escape }}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="w-full lg:w-[40.5rem] bg-[#f5f5f3]">
            <div class="w-full overflow-hidden px-[1rem] pt-[1.5rem] pb-[1rem] lg:px-[2rem] lg:pt-[3.5rem] lg:pb-0">
                <p class="font-semibold text-[1rem] leading-[normal] text-[#242f20] lg:text-[1.75rem] lg:leading-[1.1]">
                    {{ section.settings.right_title | escape }}
                </p>
            </div>

            <div class="w-full px-0 pt-[1rem] pb-[1.5rem] lg:pt-[2.5rem] lg:pb-[2.5rem]">

                <div class="lg:hidden flex flex-col {% if section.settings.right_items_direction != 'horizontal' %}pc-show{% endif %}">
                    {% for block in right_items %}
                        <div class="flex w-full items-center gap-[1.25rem] px-[1rem] lg:gap-[1.25rem] lg:px-[2rem]" {{ block.shopify_attributes }} >
                            {% if block.settings.icon != blank %}
                                <img class="h-[2.5rem] w-[2.5rem] shrink-0"
                                     src="{{ block.settings.icon | image_url: width: 80 }}"
                                     alt="{{ block.settings.icon.alt | escape }}" loading="lazy">
                            {% else %}
                                <div class="h-[2.5rem] w-[2.5rem] shrink-0">
                                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                                </div>
                            {% endif %}

                            <div class="flex min-w-0 flex-1 flex-col gap-[0.75rem] lg:gap-[0.5rem]">
                                <p class="font-semibold text-[0.875rem] leading-[normal] text-[#242f20] lg:text-[1.125rem] lg:leading-[1.1] lg:text-black line-clamp-1">
                                    {{ block.settings.title | escape }}
                                </p>
                                <p class="font-normal text-[0.75rem] leading-[normal] text-[rgba(36,47,32,0.9)] lg:text-[0.875rem] lg:leading-[1.375rem] line-clamp-1">
                                    {{ block.settings.desc | escape }}
                                </p>
                            </div>
                        </div>

                        {% unless forloop.last %}
                            <div class="mx-[1rem] lg:mx-[2rem] lg:my-[0.25rem] w-[2.5rem] h-[2rem]">
                                <svg width height viewBox="0 0 40 32" fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M17.3333 3C17.3333 4.47276 18.5272 5.66667 20 5.66667C21.4728 5.66667 22.6667 4.47276 22.6667 3C22.6667 1.52724 21.4728 0.333333 20 0.333333C18.5272 0.333333 17.3333 1.52724 17.3333 3ZM20 31L22.8868 26H17.1132L20 31ZM20 3H19.5V26.5H20H20.5V3H20Z"
                                          fill="var(--jds-color-primary)"/>
                                </svg>
                            </div>
                        {% endunless %}
                    {% endfor %}
                </div>

                <div class="hidden lg:mt-[1.75rem] lg:px-[2rem] gap-[1.25rem] {% if section.settings.right_items_direction == 'horizontal' %}pc-show{% endif %}">
                    {% for block in right_items %}
                        <div class="right-card flex lg:w-[11.75rem] flex-wrap items-center lg:gap-[2rem_1.55rem]" {{ block.shopify_attributes }} >
                            {% if block.settings.icon != blank %}
                                <img class="h-[2.5rem] w-[2.5rem] shrink-0"
                                     src="{{ block.settings.icon | image_url: width: 80 }}"
                                     alt="{{ block.settings.icon.alt | escape }}" loading="lazy">
                            {% else %}
                                <div class="h-[2.5rem] w-[2.5rem] shrink-0">
                                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                                </div>
                            {% endif %}

                            {% unless forloop.last %}
                                <div class="lg:w-[7.5rem]">
                                    <svg width height="6" viewBox="0 0 120 6" fill="none"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <path d="M120 2.88672L115 -3.26633e-05V5.77347L120 2.88672ZM0 2.88672V3.38672H115.5V2.88672V2.38672H0V2.88672Z"
                                              fill="var(--jds-color-primary)"/>
                                    </svg>
                                </div>
                            {% endunless %}

                            <div class="flex flex-col gap-[0.75rem] lg:gap-[0.5rem] lg:w-[10.5rem]">
                                <p class="font-semibold text-[0.875rem] leading-[normal] text-[#242f20] lg:text-[1.125rem] lg:leading-[1.1] lg:text-black line-clamp-1">
                                    {{ block.settings.title | escape }}
                                </p>
                                <p class="font-normal text-[0.75rem] leading-[normal] text-[rgba(36,47,32,0.9)] lg:text-[0.875rem] lg:leading-[1.375rem] line-clamp-2">
                                    {{ block.settings.desc | escape }}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                </div>

            </div>
        </div>

    </div>
</div>


{% schema %}
{
  "name": "V5品类聚合页-PPS/SP工作原理",
  "tag": "section",
  "class": "v5-collection-features-intro section-container-lg",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "PC上边距",
      "default": 40
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "PC下边距",
      "default": 40
    },
    {
      "type": "text",
      "id": "mb_padding_type",
      "default": "custom",
      "label": "MB边距",
      "visible_if": "{{ false}}",
    },
    {
      "type": "number",
      "id": "padding_top_mb",
      "label": "MB上边距",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_mb",
      "label": "MB下边距",
      "default": 32
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "左侧板块标题",
      "default": "What is Power Stations"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "右侧板块标题",
      "default": "How it Works"
    },
    {
      "type": "select",
      "id": "right_items_direction",
      "label": "右侧板块排列方式",
      "options": [
        {
          "value": "horizontal",
          "label": "横向"
        },
        {
          "value": "vertical",
          "label": "纵向"
        }
      ],
      "default": "vertical"
    }
  ],
  "blocks": [
    {
      "type": "left_item",
      "name": "Left item",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "图标"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "A Portable Power Source"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "描述",
          "default": "A compact, rechargeable battery that provides electricity anywhere."
        }
      ]
    },
    {
      "type": "right_item",
      "name": "Right item",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "图标"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Capture Power"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "描述",
          "default": "Charge via solar, home outlets, or your car."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5品类聚合页-PPS/SP工作原理",
      "category": "V5.0",
      "blocks": [
        {
          "type": "left_item"
        },
        {
          "type": "left_item"
        },
        {
          "type": "left_item"
        },
        {
          "type": "right_item"
        },
        {
          "type": "right_item"
        },
        {
          "type": "right_item"
        }
      ]
    }
  ]
}
{% endschema %}
