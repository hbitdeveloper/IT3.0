<div>
    <div class="batch-purchase--banner">
      {%- if section.settings.pc_banner_image != blank -%}
        {%-liquid
            assign is_lcp = false
            if section.index < 2
                assign is_lcp = true
            endif
        -%}
        {%- 
          render 'responsive-image', 
          image: section.settings.pc_banner_image, 
          mimage: section.settings.m_banner_image,
          fcp: is_lcp
        -%}
      {%- endif -%}
    </div>
    <div class="batch-purchase--credential">
      {%- if section.settings.pc_credential_image != blank -%}
        {%- 
          render 'responsive-image', 
          image: section.settings.pc_credential_image, 
          mimage: section.settings.m_credential_image
        -%}
      {%- endif -%}
    </div>
</div>

{% schema %}
  {
    "name": "Batch Purchase Banner",
    "tag": "div",
    "settings": [
      {
        "type": "image_picker",
        "id": "pc_banner_image",
        "label": "Banner PC Image (1920x854)"
      }, {
        "type": "image_picker",
        "id": "m_banner_image",
        "label": "Banner Mobile Image(750x1140)"
      }, {
        "type": "image_picker",
        "id": "pc_credential_image",
        "label": "Credential PC Image (1426x176)"
      }, {
        "type": "image_picker",
        "id": "m_credential_image",
        "label": "Credential Mobile Image(534x319)"
      }
    ]
  }
{% endschema %}