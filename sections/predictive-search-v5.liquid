{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- if predictive_search.performed -%}
  <div id="v5-predictive-search-results">
    {%- assign search_terms_sort_lc = predictive_search.terms | default: '' | downcase | strip -%}
    {%- assign search_terms_sort_compact = search_terms_sort_lc | replace: '-', '' | replace: ' ', '' -%}
    {%- assign search_terms_words = search_terms_sort_lc | split: ' ' -%}
    {%- assign search_terms_word_count = search_terms_words.size -%}
    {%- assign search_terms_tail_compact = '' -%}
    {%- if search_terms_word_count > 1 -%}
      {%- assign search_terms_second_last_index = search_terms_word_count | minus: 2 -%}
      {%- assign search_terms_second_last_word = search_terms_words[search_terms_second_last_index] -%}
      {%- assign search_terms_last_word = search_terms_words | last -%}
      {%- assign search_terms_tail_compact = search_terms_second_last_word | append: search_terms_last_word | replace: '-', '' | replace: ' ', '' -%}
    {%- endif -%}
    {%- if predictive_search.resources.products.size > 0 -%} 
      <h2 id="v5-predictive-search-products" class="v5-predictive-search__heading text-body caption-with-letter-spacing">
        {{ 'templates.search.products' | t }}
      </h2>
    {%- endif -%}
    <ul id="v5-predictive-search-results-list" class="predictive-search__results-list list-unstyled" role="listbox" aria-labelledby="v5-predictive-search-products" data-products-heading="{{ 'templates.search.products' | t }}">
      {%- for product in predictive_search.resources.products limit: 250 -%}
        {% assign title_lc = product.title | downcase %}
        {% assign handle_lc = product.handle | downcase %}
        {% assign title_compact = title_lc | replace: '-', '' | replace: ' ', '' %}
        {% assign handle_compact = handle_lc | replace: '-', '' | replace: ' ', '' %}
        {% assign is_kit = false %}
        {% if title_lc contains 'solar generator' or title_lc contains 'solar-generator'%}
          {% assign is_kit = true %}
        {% endif %}
        {% assign is_refurbished = false %}
        {% if title_lc contains 'refurbished' or handle_lc contains 'refurbished' %}
          {% assign is_refurbished = true %}
        {% endif %}
        {% assign is_add_on = false %}
        {% if title_lc contains 'add-on' or title_lc contains 'addon' or title_lc contains 'add on' or handle_lc contains 'addon' or handle_lc contains 'add-on' %}
          {% assign is_add_on = true %}
        {% endif %}
        {% assign is_series = false %}
        {% if title_lc contains 'series' or handle_lc contains 'series' %}
          {% assign is_series = true %}
        {% endif %}
        {% assign has_jackery = false %}
        {% if title_lc contains 'jackery' or handle_lc contains 'jackery' %}
          {% assign has_jackery = true %}
        {% endif %}
        {% assign current_product_rank = 4 %}
        {% if is_kit %}
          {% assign current_product_rank = 0 %}
        {% elsif is_refurbished %}
          {% assign current_product_rank = 5 %}
        {% elsif is_add_on %}
          {% assign current_product_rank = 6 %}
        {% elsif is_series %}
          {% assign current_product_rank = 7 %}
        {% elsif product.available %}
          {% if has_jackery %}
            {% assign current_product_rank = 1 %}
          {% else %}
            {% assign current_product_rank = 2 %}
          {% endif %}
        {% elsif has_jackery %}
          {% assign current_product_rank = 3 %}
        {% endif %}
        {% assign current_product_match_priority = 3 %}
        {% if search_terms_sort_lc != blank %}
          {% if search_terms_sort_compact != blank %}
            {% if title_compact contains search_terms_sort_compact or handle_compact contains search_terms_sort_compact %}
              {% assign current_product_match_priority = 0 %}
            {% endif %}
          {% endif %}
          {% if current_product_match_priority == 3 and search_terms_tail_compact != blank %}
            {% if title_compact contains search_terms_tail_compact or handle_compact contains search_terms_tail_compact %}
              {% assign current_product_match_priority = 1 %}
            {% endif %}
          {% endif %}
          {% if current_product_match_priority == 3 %}
            {% if title_lc contains search_terms_sort_lc or handle_lc contains search_terms_sort_lc %}
              {% assign current_product_match_priority = 2 %}
            {% endif %}
          {% endif %}
        {% endif %}
        <li id="predictive-search-option-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false" data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" data-product-handle="{{ product.handle }}" data-product-available="{{ product.available }}" data-is-kit="{{ is_kit }}" data-product-sort-rank="{{ current_product_rank }}" data-product-sort-match-priority="{{ current_product_match_priority }}">
          <a href="{{ product.url }}" class="predictive-search__item predictive-search__item--link link link--text" tabindex="-1">
            {%- if product.featured_media != blank -%}
              <img class="predictive-search__image shrink-0"
                src="{{ product.featured_media | image_url: width: 150 }}"
                alt="{{ product.featured_media.alt }}"
                width="50"
                height="{{ 50 | divided_by: product.featured_media.preview_image.aspect_ratio }}"
              >
            {%- endif -%}
            <div class="predictive-search__item-content{% unless settings.predictive_search_show_vendor or settings.predictive_search_show_price %} predictive-search__item-content--centered{% endunless %}">
              {%- if settings.predictive_search_show_vendor -%} 
                <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span><div class="predictive-search__item-vendor caption-with-letter-spacing">{{ product.vendor }}</div>
              {%- endif -%}
              <h3 class="predictive-search__item-heading h5">{{ product.title }}</h3> 
              {%- if settings.predictive_search_show_price -%}
                {% render 'price', product: product, use_variant: true, show_badges: false %} 
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if predictive_search.resources.pages.size > 0 -%} 
      <h2 id="v5-predictive-search-products" class="v5-predictive-search__heading text-body caption-with-letter-spacing">
        {{ 'templates.search.page' | t }}
        <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66">
          <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
        </svg>
      </h2>
    {%- endif -%}
    <ul 
      id="v5-predictive-search-pages-list" 
      class="predictive-search__results-list list-unstyled" 
      role="listbox" 
      aria-labelledby="predictive-search-pages"
    >
      {%- assign pages_count = 0 -%}
      {%- for article in predictive_search.resources.pages -%}
        {%- if pages_count >= 10 -%}{%- break -%}{%- endif -%}
        {%- assign article_title_downcase = article.title | downcase -%}
        {%- unless article.url contains 'stories' or article_title_downcase contains 'stories' -%}
          <li 
            id="predictive-search-articles-option-{{ forloop.index }}" 
            class="predictive-search__list-item" 
            role="option" 
            aria-selected="false"
          >
            <a href="{{ article.url }}" class="predictive-search__item predictive-search__item--link link link--text" tabindex="-1" style="grid-template-columns: 4px 1fr;">
              <div class="predictive-search__item-content{% unless settings.predictive_search_show_vendor or settings.predictive_search_show_price %} predictive-search__item-content--centered{% endunless %}">
                <h3 class="predictive-search__item-heading h5">{{ article.title }}</h3> 
              </div>
            </a>
          </li>
          {%- assign pages_count = pages_count | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
    </ul>

    {%- if predictive_search.resources.articles.size > 0 -%} 
      <h2 id="v5-predictive-search-articles" class="v5-predictive-search__heading text-body caption-with-letter-spacing">
        {{ 'templates.search.articles' | t }}
      </h2>
    {%- endif -%}
    <ul 
      id="v5-predictive-search-articles-list" 
      class="predictive-search__results-list list-unstyled" 
      role="listbox" 
      aria-labelledby="v5-predictive-search-articles"
    >
      {%- assign blogs_count = 0 -%}
      {%- for article in predictive_search.resources.articles -%}
        {%- if blogs_count >= 10 -%}{%- break -%}{%- endif -%}
        {%- unless article.url contains '/blogs/stories/' or article.url contains '/stories/' -%}
          <li 
            id="predictive-search-articles-option-{{ forloop.index }}" 
            class="predictive-search__list-item" 
            role="option" 
            aria-selected="false"
            data-article-title="{{ article.title | escape }}"
            data-article-tags="{{ article.tags | join: ',' | escape }}"
            data-article-updated="{{ article.updated_at | date: "%s" }}"
            data-article-published="{{ article.published_at | date: format: 'date' | escape }}"
            data-article-published-iso="{{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" }}"
            data-article-image="{{ article.image | image_url: width: 424 }}"
            data-article-image-alt="{{ article.image.alt | default: article.title | escape }}"
          >
            <a href="{{ article.url }}" class="predictive-search__item predictive-search__item--link link link--text" tabindex="-1">
              {%- if article.image != blank -%}
                <img class="predictive-search__image shrink-0"
                  src="{{ article.image | image_url: width: 150 }}"
                  alt="{{ article.image.alt }}"
                  width="50"
                  height="{{ 50 | divided_by: article.image.aspect_ratio }}"
                >
              {%- endif -%}
              <div class="predictive-search__item-content{% unless settings.predictive_search_show_vendor or settings.predictive_search_show_price %} predictive-search__item-content--centered{% endunless %}">
                <h3 class="predictive-search__item-heading h5">{{ article.title }}</h3> 
              </div>
            </a>
          </li>
          {%- assign blogs_count = blogs_count | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- unless settings.use_v5_header -%}
        <li id="predictive-search-option-search-keywords" class="predictive-search__list-item" role="option">
          <button class="predictive-search__item predictive-search__item--term link link--text h5 animate-arrow" tabindex="-1">
            {{ 'templates.search.search_for' | t: terms: predictive_search.terms }}
            {% render 'icon-arrow', width: 18, height: 18 %}
          </button>
        </li>
      {%- endunless -%}
    </ul>

    {%- capture stories_list_html -%}
      {%- assign stories_count = 0 -%}
      {%- for article in predictive_search.resources.articles -%}
        {%- if stories_count >= 10 -%}{%- break -%}{%- endif -%}
        {%- if article.url contains '/blogs/stories/' or article.url contains '/stories/' -%}
          <li 
            id="predictive-search-stories-option-{{ forloop.index }}" 
            class="predictive-search__list-item" 
            role="option" 
            aria-selected="false"
          >
            <a href="{{ article.url }}" class="predictive-search__item predictive-search__item--link link link--text" tabindex="-1">
              {%- if article.image != blank -%}
                <img class="predictive-search__image shrink-0"
                  src="{{ article.image | image_url: width: 150 }}"
                  alt="{{ article.image.alt }}"
                  width="50"
                  height="{{ 50 | divided_by: article.image.aspect_ratio }}"
                >
              {%- endif -%}
              <div class="predictive-search__item-content{% unless settings.predictive_search_show_vendor or settings.predictive_search_show_price %} predictive-search__item-content--centered{% endunless %}">
                <h3 class="predictive-search__item-heading h5">{{ article.title }}</h3> 
              </div>
            </a>
          </li>
          {%- assign stories_count = stories_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if stories_list_html != blank -%} 
      <h2 id="v5-predictive-search-products" class="v5-predictive-search__heading text-body caption-with-letter-spacing">
        {{ 'templates.search.stories' | t }}
      </h2>
      <ul 
        id="v5-predictive-search-stories-list" 
        class="predictive-search__results-list list-unstyled" 
        role="listbox" 
        aria-labelledby="v5-predictive-search-stories"
      >
        {{ stories_list_html }}
      </ul>
    {%- endif -%}

    <div class="predictive-search__loading-state" aria-hidden="true">
      <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66">
        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
      </svg>
    </div>
  </div>

  <span class="hidden" data-predictive-search-live-region-count-value>
    {%- if search.results_count == 0 -%}
      {{ 'templates.search.no_results' | t: terms: predictive_search.terms }}
    {%- else -%}
      {{ 'templates.search.results_with_count' | t: terms: predictive_search.terms, count: predictive_search.resources.products.size }}
    {%- endif -%}
  </span>
{%- endif -%}
