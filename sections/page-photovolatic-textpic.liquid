{%- for block in section.blocks -%}
  {%- assign blocks_type = block.type -%}
  {%- if blocks_type contains 'media_highlight' -%}
    {%- case block.type -%}
      {%- when 'media_highlight_space' -%}
        <div class=" product-media_highlight--block product-block-section">
          {%- render "diy-scroll-textpic", settings: block.settings -%}
        </div>
    {%- endcase -%}
  {%- endif -%}
{%- endfor -%}

{% schema %}
  {
