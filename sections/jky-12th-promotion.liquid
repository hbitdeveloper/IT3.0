<div class="jky-up jky-12th-promotion {%if section.settings.is_gift_block == true%} gift-anchor gift-anchor--mb{%endif%}" anchor="{{ section.settings.anchor | escape }}">
    <div class="jky-12th-container">
        <a
            target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}"
            href="{{ section.settings.link }}"
            data-ga-event="12anniversary_page_user_clicks"
                data-ga-action="click"
                data-ga-params-module="Bottom banner"
                data-ga-params-link="{{section.settings.link}}"
                data-ga-params-url="{{section.settings.pc_image | img_url: 'master'}}"
        >
            {% render 'responsive-image', image: section.settings.pc_image, mimage: section.settings.mb_image %}
        </a>
    </div>
</div>

{% schema %}
    {
        "name": "十二周年-促销版块",
        "settings": [
          { "type": "checkbox", "id": "is_gift_block", "label": "是否为礼盒模块", "default": false, "info": "该模块的顺序请保持：KV-滚动介绍-品牌介绍-获奖Swiper" },
          { "type": "text",  "id": "anchor", "label": "二级标题定位锚点" },
          { "type": "checkbox", "id": "new_window", "label": "新开标签页", "default": false },
          { "type": "url", "id": "link", "label": "跳转地址" },
          { "type": "image_picker", "id": "pc_image", "label": "PC图(1280*420)" },
          { "type": "image_picker",  "id": "mb_image", "label": "MB图(654*500)" }
        ]
    }
{% endschema %}
