{%- capture style -%}
  {%- render 'spacing-padding', settings: section.settings -%}
{%- endcapture -%}

<style>
  jky-general-product .buttons-wrap {
    width: calc(50% - 0.5rem);
  }
  jky-general-product jds-button.function-btn::part(button) {
    height: var(--jds-size-40);
    font-weight: 600;
  }
  jky-general-product jds-button.function-btn::part(label) {
    line-height: normal;
  }
  jky-general-product .bundle-quantity {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 4px;
  }
  jky-general-product .quantity-btn svg {
    width: 10px;
    height: 10px;
  }
  jky-general-product .quantity-btn:hover {
    background: #e9ecef;
  }

  @media screen and (max-width: 1023.98px) {
    jky-general-product [data-mb-slides="2"] .buttons-wrap,
    jky-general-product .grid-cols-2 .buttons-wrap {
      width: 100%;
    }
    jky-general-product .quantity-btn svg {
      width: 2.6666667vw;
      height: 2.6666667vw;
    }
    jky-general-product jds-button.function-btn::part(button) {
      height: var(--jds-size-72);
      font-weight: 600;
    }
  }

  jky-general-product .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #e5e5e5;
    border-radius: 4px;
    overflow: hidden;
  }
  jky-general-product .quantity-selector .quantity-btn {
    background: #f8f8f8;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  jky-general-product .quantity-selector .quantity-btn:hover {
    background: #e8e8e8;
  }
  jky-general-product .quantity-selector .quantity-btn:disabled {
    background: #f0f0f0;
    cursor: not-allowed;
    opacity: 0.5;
  }
  jky-general-product .quantity-selector .quantity-input {
    border: none;
    outline: none;
    background: white;
  }
  /* 轮播相关样式 */
  jky-general-product .swiper {
    width: 100%;
    height: 100%;
  }
  jky-general-product .swiper-slide {
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  /* 初始宽度占位，仅未初始化时生效，避免首帧拉满 */
  jky-general-product .general-product-grid.swiper:not(.swiper-initialized) .swiper-wrapper { column-gap: 20px }
  jky-general-product .general-product-grid.swiper:not(.swiper-initialized)[data-pc-slides="2"] .swiper-slide { width: calc(50% - 10px); }
  jky-general-product .general-product-grid.swiper:not(.swiper-initialized)[data-pc-slides="3"] .swiper-slide { width: calc(33.3333% - 13.3333333333333px); }
  jky-general-product .general-product-grid.swiper:not(.swiper-initialized)[data-pc-slides="4"] .swiper-slide { width: calc(25% - 15px); }
  jky-general-product .general-product-grid.swiper:not(.swiper-initialized)[data-mb-slides="1"] .swiper-slide { width: 100%; }
  @media screen and (max-width: 1023.98px) {
    jky-general-product .general-product-grid.swiper:not(.swiper-initialized) .swiper-wrapper { column-gap: 16px }
    jky-general-product .general-product-grid.swiper:not(.swiper-initialized)[data-mb-slides="2"] .swiper-slide { width: 17.6979375rem; }
  }
  jky-general-product .general-product-pagination { overflow-x: auto; -webkit-overflow-scrolling: touch; scroll-behavior: smooth; }
</style>

<jky-general-product
  section-id="{{ section.id }}"
  {% if section.settings.nav_anchor != blank %}anchor-target="{{section.settings.nav_anchor | escape}}"{% endif %}
  {% if section.settings.belongs_to != blank %}belongs-to-target="{{section.settings.belongs_to | escape}}"{% endif %}
  {% if section.settings.anchor != blank %}data-anchor="{{ section.settings.anchor | escape }}"{% endif %}
  data-copied-text="{{ section.settings.copied_text | default: 'Copied' }}"
  data-copy-success="{{ section.settings.copy_success | default: 'Copy Success' }}"
  data-copy-checkout="{{ section.settings.copy_checkout | default: false }}"
  class="block section-padding"
  style="background: {{ section.settings.bg_color | default: 'transparent' }};{{ style }};--recommend-product-bg: {{ section.settings.bg_color | default: 'transparent' }};"
>
  <div class="v-general-product relative {{ section.settings.page_width }}
    {%- if section.settings.display_device == 'pc-only' %} max-lg:hidden
    {%- elsif section.settings.display_device == 'mb-only' %} lg:hidden
    {%- endif %}"
  >
    {%- liquid
      assign mb_grid = 'grid-cols-1'
      if section.settings.mb_products_number == 'mb-arrange-style-two'
        assign mb_grid = 'grid-cols-2'
      endif

      assign pc_grid = 'lg:grid-cols-2'
      if section.settings.pc_products_number == 'arrange-style-three'
        assign pc_grid = 'lg:grid-cols-3'
      elsif section.settings.pc_products_number == 'arrange-style-four'
        assign pc_grid = 'lg:grid-cols-4'
      endif

      assign pc_slides_per_view = 2
      if section.settings.pc_products_number == 'arrange-style-three'
        assign pc_slides_per_view = 3
      elsif section.settings.pc_products_number == 'arrange-style-four'
        assign pc_slides_per_view = 4
      endif

      assign mb_slides_per_view = 1
      if section.settings.mb_products_number == 'mb-arrange-style-two'
        assign mb_slides_per_view = 2
      endif

      # 计算blocks数量
      assign blocks_count = section.blocks | size

      # 轮播配置逻辑
      assign pc_is_swiper = false
      assign mb_is_swiper = false

      if section.settings.pc_products_number == 'arrange-style-three' or section.settings.pc_products_number == 'arrange-style-four'
        if section.settings.pc_products_style == 'pc-swiper-style' and blocks_count > pc_slides_per_view
          assign pc_is_swiper = true
        endif
      endif

      if section.settings.mb_products_number == 'mb-arrange-style-two'
        if section.settings.mb_products_style == 'mb-swiper-style'
          assign mb_is_swiper = true
        endif
      endif

      # 判断是否显示导航按钮
      assign show_navigation = false
      if pc_is_swiper and blocks_count > pc_slides_per_view
        assign show_navigation = true
      endif
    -%}

    {%- comment -%} PC 独立容器（仅 PC 可见） {%- endcomment -%}
    {%- render 'general-product-pc',
      pc_is_swiper: pc_is_swiper,
      pc_slides_per_view: pc_slides_per_view,
      pc_grid: pc_grid,
      section: section,
      blocks_count: blocks_count
    -%}

    {%- comment -%} MB 独立容器（仅 MB 可见） {%- endcomment -%}
    {%- render 'general-product-mb',
      mb_is_swiper: mb_is_swiper,
      mb_slides_per_view: mb_slides_per_view,
      mb_grid: mb_grid,
      section: section,
      blocks_count: blocks_count
    -%}

    {% comment %} 左右箭头 {% endcomment %}
    {%- if show_navigation == true -%}
      <div class="max-lg:hidden general-product-prev swiper-button-prev after:content-['prev'] after:pr-0.5 lg:left-[-5rem]
          h-12 w-12 transition-transform ease-linear origin-center
          after:text-white after:text-lg after:font-bold after:transition-transform after:ease-linear after:z-10
          before:absolute before:w-full before:h-full before:border-2 before:border-[rgba(255,255,255,0.4)] before:rounded-full before:bg-[rgba(102,102,102,0.2)] before:border-solid before:transition-all hover:before:bg-[rgba(102,102,102,0.4)] hover:before:scale-110"></div>
      <div class="max-lg:hidden general-product-next swiper-button-next after:content-['next'] after:pl-0.5 lg:right-[-5rem]
          h-12 w-12 transition-transform ease-linear origin-center
          after:text-white after:text-lg after:font-bold after:transition-transform after:ease-linear after:z-10
          before:absolute before:w-full before:h-full before:border-2 before:border-[rgba(255,255,255,0.4)] before:rounded-full before:bg-[rgba(102,102,102,0.2)] before:border-solid before:transition-all hover:before:bg-[rgba(102,102,102,0.4)] hover:before:scale-110"></div>
    {%- endif -%}

    {% comment %} 分页指示 {% endcomment %}
    <div class="{% if show_navigation and mb_is_swiper and blocks_count >= mb_slides_per_view %}flex{% elsif show_navigation %}hidden lg:flex{% elsif mb_is_swiper and blocks_count >= mb_slides_per_view %}flex lg:hidden{% else %}hidden{% endif %} w-full general-product-pagination mx-auto mt-6 swiper-pagination justify-center overflow-x-auto"></div>
  </div>

  <script id="general-product-config" type="application/json">
    {
      "remind_title": "{{ section.settings.remind_title | escape }}",
      "remind_des": "{{ section.settings.remind_des | escape }}",
      "remind_email_place": "{{ section.settings.remind_email_place | escape }}",
      "remind_email_error": "{{ section.settings.remind_email_error | escape }}",
      "remind_email_empty": "{{ section.settings.remind_email_empty | escape }}",
      "remind_policy": "{{ section.settings.remind_policy | replace: '"', "'" }}",
      "remind_policy_error": "{{ section.settings.remind_policy_error | escape }}",
      "remind_submit": "{{ section.settings.remind_submit | escape }}",
      "remind_tag": "{{ section.settings.remind_tag | escape }}",
      "remind_success_tip": "{{ section.settings.remind_success_tip | escape }}",
      "remind_error_tip": "{{ section.settings.remind_error_tip | escape }}"
    }
  </script>
</jky-general-product>

<script defer src="{{ 'jky-general-product.js' | asset_url }}"></script>

{% # theme-check-disable %}
