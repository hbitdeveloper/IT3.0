{% style %}
.section-v5-main-product {
  /* 覆盖 judge.me 插件样式 */
  .jdgm-widget.jdgm-preview-badge {
    margin-top: 0.25rem;
  }
  .jdgm-prev-badge__stars .jdgm-star {
    font-size: 1.25rem;
    @media (max-width: 1023.98px) {
      font-size: 1rem;
    }
  }
  .jdgm-prev-badge__text {
    text-decoration: underline;
    text-underline-offset: 2px;
    color: rgba(0, 0, 0, 0.65);
    font-size: 1.25rem;
    margin-left: 0.75rem;
    @media (max-width: 1023.98px) {
      font-size: 1rem;
      margin-left: 0.5rem;
    }
  }
}
@media screen and (max-width:1023px) {
  .product-tax_fee_explanation{
    max-width: 91.4666666666667vw;
    width: 91.4666666666667vw;
    margin: 0 auto;
  }
}
{% endstyle %}

{%- liquid
  assign model_3d = product.media | where: 'media_type', 'model'
  if product.metafields.custom.modals_list.value != blank
    assign model_3d = product.metafields.custom.modals_list.value
  endif

  assign first_video_media = false
  assign first_video_media = product.media | where: 'media_type', 'video' | first
  if first_video_media == false or first_video_media == blank
    assign first_video_media = product.media | where: 'media_type', 'external_video' | first
  endif

  assign icon_text_block = section.blocks | where: 'type', 'icon_text'

  # 欧洲站点，需要修改产品标签、标题的默认字体大小
  assign need_modify_size = false
  assign iso_code = settings.shop_cr | default: localization.country.iso_code | default: 'US'
  if iso_code == 'GB' or iso_code == 'DE' or iso_code == 'FR' or iso_code == 'ES' or iso_code == 'EU' or iso_code == 'NL'
    assign need_modify_size = true
  endif
-%}

<div data-version="v5" class="max-w-full w-[82.5rem] mx-auto flex flex-col lg:flex-row justify-between pt-6 pb-10 lg:py-[3.75rem]">
  {% comment %} 图片、视频、3D、延保信息 {% endcomment %}
  <div class="v5-product-gallery-wrapper flex flex-col self-start relative lg:sticky lg:top-[calc(var(--jky-header-h)+2.25vh)] w-[21.4375rem] mx-auto lg:w-[40.5rem] lg:mx-0 lg:gap-y-3">
    {% comment %} 商品图、视频、3D {% endcomment %}
    <div class="w-full lg:w-[40.5rem]">
      {%- render
        "v5-product-gallery",
          img_product_tag_position_pc: section.settings.img_product_tag_position_pc,
          img_product_tag_width_pc: section.settings.img_product_tag_width_pc,
          img_product_tag_width_mb: section.settings.img_product_tag_width_mb,

          photos_i18n: section.settings.product_photos_i18n | escape,
          video_i18n: section.settings.product_video_i18n | escape,
          model_i18n: section.settings.product_3d_model_i18n | escape,

          show_3d_model_unfold: section.settings.product_3d_model_show_unfold,
          unfolded_i18n: section.settings.product_unfolded_i18n | escape,
          folded_i18n: section.settings.product_folded_i18n | escape,

          first_video_media: first_video_media,
          model_3d: model_3d,
      -%}
    </div>

    {% comment %} 技术证书 {% endcomment %}
    {%- for block in icon_text_block -%}
      {%- if block.settings.position == 'pos_1' -%}
        {%- render 'v5-app-pdp-icon-text', block: block, class: 'hidden lg:flex' -%}
      {%- endif -%}
    {%- endfor -%}

    {% comment %} 特征图片 {% endcomment %}
    {%- assign feature_image_list = product.metafields.custom.feature_image_list.value -%}
    {%- if feature_image_list -%}
      <div class="w-full hidden lg:flex flex-col gap-y-2 mt-8 lg:gap-y-3 lg:mt-0">
        {%- for image in feature_image_list limit: 2 -%}
          {%- render 'diff-end-img',
            class: 'w-full h-auto lg:w-[40.5rem] object-cover',
            pc_img: image,
            mb_img: image,
            pc_img_width: 648,
            mb_img_width: 375,
            placeholder_name: 'hero-apparel-1',
            load_scene: 'defer'
          -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {% comment %} 商品信息 {% endcomment %}
  <div class="v5-product-info-wrapper w-[21.4375rem] mx-auto lg:w-[40.5rem] lg:mx-0 lg:pl-6" onlyVariant="{{ product.has_only_default_variant }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {% comment %} 插件 {% endcomment %}
        {%- when '@app' -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>

        {% comment %} 标题 {% endcomment %}
        {%- when 'title' -%}
          {%- capture pdp_title_style -%}
            {% render 'spacing-padding', settings: block.settings %}
          {%- endcapture -%}

          <div data-sticky-cart-title-trigger class="flex flex-col section-padding gap-y-2" style="{{ pdp_title_style }}" {{ block.shopify_attributes }}>
            {%- if block.settings.tag_1_text != blank or block.settings.tag_2_text != blank -%}
              <p class="flex items-center flex-wrap gap-2.5">
                {%- if block.settings.tag_1_text != blank -%}
                  <span
                    {% if need_modify_size %}
                      style="
                        --mb-tag-size: calc({% if block.settings.tag_size_mb > 0 %}{{ block.settings.tag_size_mb }}{% else %}14{% endif %} / 16 * 1rem);
                        --pc-tag-size: calc({% if block.settings.tag_size_pc > 0 %}{{ block.settings.tag_size_pc }}{% else %}16{% endif %} / 16 * 1rem);
                      "
                    {% else %}
                      style="
                        --mb-tag-size: calc({% if block.settings.tag_size_mb > 0 %}{{ block.settings.tag_size_mb }}{% else %}14{% endif %} / 16 * 1rem);
                        --pc-tag-size: calc({% if block.settings.tag_size_pc > 0 %}{{ block.settings.tag_size_pc }}{% else %}14{% endif %} / 16 * 1rem);
                      "
                    {% endif %}
                    class="inline-flex items-center justify-center font-medium min-h-6 text-[length:var(--mb-tag-size)] lg:text-[length:var(--pc-tag-size)] leading-none text-primary px-2 py-1 bg-[#FFEEE6]"
                  >{{ block.settings.tag_1_text | escape }}</span>
                {%- endif -%}
                {%- if block.settings.tag_2_text != blank -%}
                  <span
                    {% if need_modify_size %}
                      style="
                        --mb-tag-size: calc({% if block.settings.tag_size_mb > 0 %}{{ block.settings.tag_size_mb }}{% else %}14{% endif %} / 16 * 1rem);
                        --pc-tag-size: calc({% if block.settings.tag_size_pc > 0 %}{{ block.settings.tag_size_pc }}{% else %}16{% endif %} / 16 * 1rem);
                      "
                    {% else %}
                      style="
                        --mb-tag-size: calc({% if block.settings.tag_size_mb > 0 %}{{ block.settings.tag_size_mb }}{% else %}14{% endif %} / 16 * 1rem);
                        --pc-tag-size: calc({% if block.settings.tag_size_pc > 0 %}{{ block.settings.tag_size_pc }}{% else %}14{% endif %} / 16 * 1rem);
                      "
                    {% endif %}
                    class="inline-flex items-center justify-center font-medium min-h-6 text-[length:var(--mb-tag-size)] lg:text-[length:var(--pc-tag-size)] leading-none text-[#22A050] px-2 py-1 bg-[#EBF5ED]"
                  >{{ block.settings.tag_2_text | escape }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}

            {%- assign title_parts = product.title | escape | split: '  ' -%}
            {%- if title_parts.size > 1 and need_modify_size == false -%}
              <h1 class="flex flex-col gap-y-1.5 lg:gap-y-3.5">
                <span class="font-semibold text-[#242F20]/90 text-base lg:text-2xl">{{ title_parts[0] }}</span>
                <span
                  style="
                    --title-size-pc: calc({% if block.settings.title_size_pc > 0 %}{{ block.settings.title_size_pc }}{% else %}48{% endif %} / 16 * 1rem);
                    --title-size-mb: calc({% if block.settings.title_size_mb > 0 %}{{ block.settings.title_size_mb }}{% else %}28{% endif %} / 16 * 1rem);
                    line-height:1.25;
                  "
                  class="font-semibold text-[#242F20] !text-[length:var(--title-size-mb)] lg:!text-[length:var(--title-size-pc)]"
                >{{ title_parts[1] }}</span>
              </h1>
            {%- else -%}
              <h1
                {% if need_modify_size %}
                  style="
                    --title-size-pc: calc({% if block.settings.title_size_pc > 0 %}{{ block.settings.title_size_pc }}{% else %}32{% endif %} / 16 * 1rem);
                    --title-size-mb: calc({% if block.settings.title_size_mb > 0 %}{{ block.settings.title_size_mb }}{% else %}24{% endif %} / 16 * 1rem);
                    line-height:1.25;
                  "
                {% else %}
                  style="
                    --title-size-pc: calc({% if block.settings.title_size_pc > 0 %}{{ block.settings.title_size_pc }}{% else %}48{% endif %} / 16 * 1rem);
                    --title-size-mb: calc({% if block.settings.title_size_mb > 0 %}{{ block.settings.title_size_mb }}{% else %}28{% endif %} / 16 * 1rem);
                    line-height:1.25;
                  "
                {% endif %}
                class="font-semibold text-[#242F20] !text-[length:var(--title-size-mb)] lg:!text-[length:var(--title-size-pc)]"
              {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
            {%- endif -%}
          </div>

        {% comment %} 价格 {% endcomment %}
        {%- when 'price' -%}
          <div data-sticky-cart-price-trigger>
            {%-
              render 'v5-app-pdp-product-price',
              show_product_direct_way: section.settings.show_product_direct_way | default: false,
              product_direct_way: section.settings.product_direct_way | default: 'way_one',
              product_direct_way_three_text: section.settings.product_direct_way_three_text | default: 'Final Price',
              product: product,
              block: block,
              sectionId: section.id,
              tax_fee_explanation: section.settings.tax_fee_explanation
            -%}
          </div>

        {% comment %} 特性文案 {% endcomment %}
        {%- when 'product_feature_text' -%}
          {%- render 'v5-app-pdp-product-feature-text', product: product, block: block -%}

        {% comment %} 会员价 {% endcomment %}
        {%- when 'membership_price_coupon' -%}
          {% render 'v5-app-membership-price-coupon', block: block, sectionId: section.id %}

        {% comment %} 优惠券 {% endcomment %}
        {%- when 'coupon' -%}
          {% render 'v5-app-coupon', block: block %}

        {% comment %} 商品描述 {% endcomment %}
        {%- when 'description' -%}
          {% comment %} 技术证书 {% endcomment %}
          {%- for block in icon_text_block -%}
            {%- if block.settings.position == 'pos_1' -%}
              {%- render 'v5-app-pdp-icon-text', block: block, class: 'flex lg:hidden' -%}
            {%- endif -%}
          {%- endfor -%}
          {%- render 'v5-app-pdp-description', product: product, block: block -%}

        {% comment %} 多变体切换 {% endcomment %}
        {%- when 'variant_picker' -%}
          {%-
            render 'v5-app-pdp-variant-picker',
            show_product_direct_way: section.settings.show_product_direct_way | default: false,
            product_direct_way: section.settings.product_direct_way | default: 'way_one',
            product_direct_way_three_text: section.settings.product_direct_way_three_text | default: 'Final Price',
            product: product,
            block: block,
            sectionId: section.id
          -%}
      
        {% comment %} 配送与服务说明设置 {% endcomment %}
        {%- when 'delivery_instructions' %}
          {%- render 'delivery-instructions', block: block -%}

        {% comment %} 数量选择器 {% endcomment %}
        {%- when 'quantity_selector' -%}
          {%- render 'v5-app-pdp-quantity', product: product, block: block -%}

        {% comment %} klarna 支付 {% endcomment %}
        {%- when 'klarna' -%}
          <div class="product-info_block lg:py-4 py-2" {{ block.shopify_attributes }}>
            {% render 'app-klarna' %}
          </div>

        {% comment %} 加购、立即购买 {% endcomment %}
        {%- when 'buy_buttons' -%}
          {%- render 'v5-app-pdp-buy-buttons', product: product, block: block, section: section, sectionId: section.id -%}

        {% comment %} 加购和购买前，免税弹窗提示 {% endcomment %}
        {%- when 'tax_free_popup' -%}
          {% render 'tax-free-popup', block: block %}

        {%- when 'icon_text' -%}
          {% comment %} 服务优势 {% endcomment %}
          {%- if block.settings.position == 'pos_2' -%}
            {%- render 'v5-app-pdp-icon-text', block: block, class: 'flex' -%}
          {%- endif -%}

        {% comment %} 权益文案 {% endcomment %}
        {%- when 'benefit_text' -%}
          {%- render 'v5-app-pdp-benefit-text', section: section, block: block -%}

        {% comment %} 快捷入口 {% endcomment %}
        {%- when 'quike_chat' -%}
          {%- render 'v5-app-pdp-quick-chat', block: block -%}

        {% comment %} 捆绑销售 {% endcomment %}
        {%- when 'bundled_sale' -%}
          {%- render 'v5-app-bundled-sale', product: product, block: block -%}

        {% comment %} 产品推荐 {% endcomment %}
        {%- when 'recommend_products' -%}
          {%- render 'v5-app-recommend-products', product: product, block: block -%}

        {% comment %} 产品推荐一度电 {% endcomment %}
        {%- when 'recommend_products_one' -%}
          {%- render 'v5-app-recommend-products-one', product: product, block: block -%}

        {% comment %} 买赠 {% endcomment %}
        {%- when 'free_gift' -%}
          {%- render 'v5-app-pdp-free-gift', block: block -%}

        {% comment %} 自动延保 {% endcomment %}
        {%- when 'auto_extended_warranty' -%}
          {%- render 'v5-app-pdp-auto-warranty', block: block -%}

        {% comment %} 促销文案机动版块 {% endcomment %}
        {%- when 'text_promotion' -%}
          {% render 'app-text-promotion', block: block %}

        {% comment %} 促销文案折叠组件 {% endcomment %}
        {%- when 'text_promotion_fold' -%}
          {% render 'app-text-promotion-fold', block: block %}

        {% comment %} 自定义liquid {% endcomment %}
        {%- when 'custom_liquid' -%}
          {%- render 'v5-app-custom-liquid', block: block -%}
      {%- endcase -%}
    {%- endfor -%}

    {%- if product.has_only_default_variant == true -%}
      {%- render "product-variants-json", variant: product.selected_or_first_available_variant, id: "selected-variant", show_discount_price: settings.display_auto_discount_price_in_sku -%}
    {%- else -%}
      {%- render "product-variants-json", variants: product.variants, id: "selected-variant", show_discount_price: settings.display_auto_discount_price_in_sku -%}
    {%- endif -%}
  </div>
</div>

{% comment %} 结构化数据 {% endcomment %}
{% render "product-appld-json" %}

{% comment %} 吸底购物车 {% endcomment %}
{%- unless template == 'product.nosale' -%}
  {%- render 'v5-app-stickyCart',
    enable_shortage_reminds: section.settings.enable_shortage_reminds,
    show_price_info: section.settings.show_price_info,
  -%}
{%- endunless -%}

<script type="module">
  // 注册 Judge.me 插件的点击事件监听器
  function registerJdgmPluginClickEvent() {
    const jdgmDOM = document.querySelector('.jdgm-prev-badge');
    
    // 如果已经找到元素，并且它还没有注册过事件（通过检查自定义属性）
    if (jdgmDOM && !jdgmDOM.dataset.eventRegistered) {
      jdgmDOM.addEventListener('click', function() {
        // 1. 查找导航容器
        const navigationContainer = document.querySelector('jky-navigation')?.querySelector('.navigation--container')

        if (navigationContainer) {
          // 2. 使用 querySelectorAll 获取所有动态导航块
          const blocks = navigationContainer.querySelectorAll('.shopify-block')

          // 3. 检查是否有块，并点击最后一个（通常是 REVIEWS 评论）
          if (blocks.length > 0) {
            const lastBlock = blocks[blocks.length - 1]
            
            // 确保找到的块是可见的且可点击的，然后触发点击
            if (lastBlock) {
              lastBlock.querySelector('.navigation-item').click()
            }

            // 4. 数据埋码 (使用模板字符串优化可读性)
            gaPushDataLayer('5.0_products_details_page_user_clicks', {
              product_spu_name: '{{ product.title | escape }}',
              module: "Product Review", 
              button_name: jdgmDOM.querySelector('span.jdgm-prev-badge__text')?.textContent?.trim() || 'Click to Reviews',
            })
          }
        }
      })
      
      // 标记该元素已注册事件，防止 MutationObserver 重复注册
      jdgmDOM.dataset.eventRegistered = 'true'
    }
  }

  // 使用防抖的 MutationObserver 确保在动态加载的内容中捕获 .jdgm-prev-badge
  document.addEventListener('DOMContentLoaded', function() {
    const productInfoWrapper = document.querySelector('.v5-product-info-wrapper')

    // 首次检查并注册
    registerJdgmPluginClickEvent()

    if (productInfoWrapper) {
      let debounceTimer;

      const observer = new MutationObserver(function() {
        // 已注册成功则直接断开，不再处理
        if (document.querySelector('.jdgm-prev-badge[data-event-registered="true"]')) {
          observer.disconnect();
          return;
        }
        // 防抖：合并高频 DOM 变动，只做一次查询
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          registerJdgmPluginClickEvent();
          if (document.querySelector('.jdgm-prev-badge[data-event-registered="true"]')) {
            observer.disconnect();
          }
        }, 200);
      })

      observer.observe(productInfoWrapper, { 
        childList: true, 
        subtree: true
      })
    }
  })
</script>

{% schema %}
  {
    "name": "V5-PDP-橱窗产品信息",
    "class": "section section-v5-main-product",
    "tag": "section",
    "enabled_on": {
      "templates": ["product"]
    },
    "settings": [
      {"type": "header", "content": "左侧橱窗图，右上角图片角标设置", "info": "需要先在SKU元字段配置【产品橱窗配件图片】"},
      {"type": "select", "id": "img_product_tag_position_pc", "label": "PC端角标位置", "options": [
        { "value": "left", "label": "左侧" },
        { "value": "right", "label": "右侧" },
      ], "default": "left", "info": "MB端固定右侧显示"},
      {"type": "number", "id": "img_product_tag_width_pc", "label": "PC端角标宽度", "default": 180},
      {"type": "number", "id": "img_product_tag_width_mb", "label": "MB端角标宽度", "default": 140},
      
      {"type": "header", "content": "左侧（橱窗图/视频/3D模型）设置"},
      {"type": "text", "id": "product_photos_i18n", "label": "图片选项\"Photos\"多语言", "default": "Photos"},
      {"type": "text", "id": "product_video_i18n", "label": "视频选项\"Intro\"多语言", "default": "Intro"},
      {"type": "text", "id": "product_3d_model_i18n", "label": "3d模型选项\"3D\"多语言", "default": "3D"},
      {
        "type": "checkbox",
        "id": "product_3d_model_show_unfold",
        "label": "是否启用3D模型展开（Unfold）/折叠（Fold）的视图选项",
        "default": false
      },
      {"type": "text", "id": "product_unfolded_i18n", "label": "\"Unfolded\"多语言", "default": "Unfolded"},
      {"type": "text", "id": "product_folded_i18n", "label": "\"Folded\"多语言", "default": "Folded"},

      {"type": "header", "content": "右侧（产品信息）设置"},
      {"type": "richtext", "id": "tax_fee_explanation", "label": "税费说明"},
      {"type": "header", "content": "产品价格直降"},
      {"type": "checkbox", "id": "show_product_direct_way", "label": "是否开启", "default": false},
      {"type": "select", "id": "product_direct_way",
        "options": [
          { "value": "way_one", "label": "方案一" },
          { "value": "way_two", "label": "方案二" },
          { "value": "way_three", "label": "方案三" }
        ],
        "default": "way_one",
        "label": "实现方式",
        "info": "方案一：展示的价格：加一个新字段，取价格Shopify的价格（字段名称中不包含price）；原来的价格字段，取shopify的原价，不展示；展示的划线价：逻辑不变，用原来的原价字段，取shopify的原价。方案二：字段名称都改为不包含price，展示的价格：取自动计算的折后价；展示的划线价：取Shopify的原价（有原价且原价大于价格时）或价格（无原价或原价小于价格时）。方案三：新增一个最终价展示在现有价格下，最终价取自动计算的折后价，需要按SPU维度控制是否展示。",
        "visible_if": "{{ section.settings.show_product_direct_way == true }}"
      },
      {"type": "text", "id": "product_direct_way_three_text", "label": "方案三文案", "default": "Final Price", "visible_if": "{{ section.settings.show_product_direct_way == true and section.settings.product_direct_way == 'way_three' }}"},

      {"type": "header", "content": "到货提醒设置"},
      {"type": "checkbox", "id": "enable_shortage_reminds", "label": "开启到货提醒", "default": true },
      {"type": "text", "id": "shortage_title", "label": "Shortage form title", "default": "Notify Me When Available for Pre-order" },
      {"type": "text", "id": "shortage_content", "label": "Shortage form content", "default": "Leave your email below to get a notification when the product is available for pre-order." },
      {"type": "text", "id": "shortage_input_tips", "label": "Placeholder", "default": "Enter Your Email" },
      {"type": "text", "id": "shortage_submit", "label": "Button text", "default": "Notify Me" },
      {"type": "richtext", "id": "shortage_policy", "label": "Policy", "default": "<p>I have read and agreed to the <a href=\"https:\/\/www.jackery.com\/policies\/terms-of-service\" target=\"_blank\" title=\"Jackery Terms and service\">Terms<\/a> and <a href=\"https:\/\/www.jackery.com\/policies\/privacy-policy\" target=\"_blank\" title=\"https:\/\/www.jackery.com\/policies\/privacy-policy\">Privacy Policy<\/a>.<\/p>" },
      {"type": "text", "id": "shortage_reminds_success", "label": "Tips success", "default": "Successfully subscribed! We'll let you know as soon as this product is available for purchase." },
