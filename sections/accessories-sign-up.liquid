{%- style -%}
  .sign-up-wrap {
    width: 100%;
    height: 450px;
    background-image: url('{{section.settings.sign_up_image | image_url: width: 1920}}');
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
    padding-top: 90px;
  }
  .sign-up-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .sign-up-content h2 {
    font-size: 45px;
    font-weight: 500;
    color: #000000;
    line-height: 66px;
  }
  .sign-up {
    display: flex;
    align-items: center;
    position: relative;
  }
  .sign-up input {
    width: 540px;
    height: 46px;
    background: #ffffff;
    border-radius: 23px;
    border: 2px solid #dddddd;
    padding: 10px 20px;
    font-size: 18px;
    padding: 10px 150px 10px 20px;
    line-height: 27px;
    font-weight: 400;
  }
  .sign-up button {
    height: 46px;
    background: var(--jds-color-primary);
    border-radius: 23px;
    border: 1px solid var(--jds-color-primary);
    font-size: 18px;
    font-weight: 500;
    color: #ffffff;
    line-height: 27px;
    padding: 10px 30px;
    position: absolute;
    right: 0;
    top: 0;
  }
  .sign-up-content p {
    font-size: 18px;
    font-weight: 400;
    color: #000000;
    line-height: 33px;
    margin-bottom: 40px;
    margin-top: 14px;
  }

  .sign-up-declaration {
    padding-top: 15px;
    display: flex;
    gap: 5px;
    align-items: center;
  }

  .sign-up-declaration span a {
    color: #000000;
    text-decoration: underline;
  }
  .wobble-hor-bottom {
    -webkit-animation: wobble-hor-bottom 1s both;
    animation: wobble-hor-bottom 1s both;
  }
  @-webkit-keyframes wobble-hor-bottom {
    0%,
    100% {
      -webkit-transform: translateX(0%);
      transform: translateX(0%);
      -webkit-transform-origin: 50% 50%;
      transform-origin: 50% 50%;
    }
    15% {
      -webkit-transform: translateX(-30px) rotate(-6deg);
      transform: translateX(-30px) rotate(-6deg);
    }
    30% {
      -webkit-transform: translateX(15px) rotate(6deg);
      transform: translateX(15px) rotate(6deg);
    }
    45% {
      -webkit-transform: translateX(-15px) rotate(-3.6deg);
      transform: translateX(-15px) rotate(-3.6deg);
    }
    60% {
      -webkit-transform: translateX(9px) rotate(2.4deg);
      transform: translateX(9px) rotate(2.4deg);
    }
    75% {
      -webkit-transform: translateX(-6px) rotate(-1.2deg);
      transform: translateX(-6px) rotate(-1.2deg);
    }
  }
  @keyframes wobble-hor-bottom {
    0%,
    100% {
      -webkit-transform: translateX(0%);
      transform: translateX(0%);
      -webkit-transform-origin: 50% 50%;
      transform-origin: 50% 50%;
    }
    15% {
      -webkit-transform: translateX(-30px) rotate(-6deg);
      transform: translateX(-30px) rotate(-6deg);
    }
    30% {
      -webkit-transform: translateX(15px) rotate(6deg);
      transform: translateX(15px) rotate(6deg);
    }
    45% {
      -webkit-transform: translateX(-15px) rotate(-3.6deg);
      transform: translateX(-15px) rotate(-3.6deg);
    }
    60% {
      -webkit-transform: translateX(9px) rotate(2.4deg);
      transform: translateX(9px) rotate(2.4deg);
    }
    75% {
      -webkit-transform: translateX(-6px) rotate(-1.2deg);
      transform: translateX(-6px) rotate(-1.2deg);
    }
  }

  @media only screen and (max-width: 768px) {
    .sign-up-wrap {
      height: 113.87vw;
      background-image: url('{{section.settings.sign_up_m_image | image_url: width: 768}}');
      padding-top: 8vw;
    }
    .sign-up-content h2 {
      font-size: 7.2vw;
      line-height: 8.8vw;
      margin-bottom: 3.2vw;
      text-align: center;
      padding: 0 8vw;
    }
    .sign-up {
      width: 100%;
      max-width: 106.67vw;
      padding: 0 8vw;
    }
    .sign-up input {
      width: 100%;
      height: 9.0666666667vw;
      border-radius: 4.533333333333333vw;
      border: 1px solid #dddddd;
      font-size: 3.2vw;
      line-height: 5.33333333vw;
      padding: 1.6vw 20.333333333332vw 1.6vw 2.6666666667vw;
    }
    .sign-up button {
      height: 9.0666666667vw;
      padding: 1.8666666667vw 5.33333333vw;
      border-radius: 4.53333333333vw;
      font-size: 3.466666666667vw;
      line-height: 5.33333333vw;
      right: 8vw;
    }
    .sign-up-content p {
      font-size: 3.2vw;
      line-height: 4vw;
      margin-top: 3.2vw;
    }
    .sign-up-declaration {
      padding-left: 8vw;
      padding-right: 8vw;
      padding-top: 2.66666666666667vw;
    }
    .J-sign-up-declaration-span {
      font-size: 3.2vw;
      line-height: 4vw;
    }
  }
{%- endstyle -%}

<div class="sign-up-wrap">
  <div class="sign-up-content">
    <h2
      {% if section.settings.heading_color != blank %}
        style="color: {{section.settings.heading_color}}"
      {% endif %}
    >
      {{ section.settings.sign_up_title | newline_to_br }}
    </h2>
    <p
      {% if section.settings.heading_color != blank %}
        style="color: {{section.settings.heading_color}}"
      {% endif %}
    >
      {{ section.settings.abstract | newline_to_br }}
    </p>
    <div class="sign-up">
      <input type="email" placeholder="{{section.settings.email_placeholder}}" data-accessories-email-input>
      <button data-accessories-sign-up>{{ section.settings.sign_up_text | escape }}</button>
    </div>
    {% if section.settings.sevice_privacy_text != '' %}
      <div class="sign-up-declaration">
        <input type="checkbox" class="checkbox J-sign-up-declaration-checkbox">
        <span
          class="J-sign-up-declaration-span"
          data-terms_service="{{ section.settings.terms_service | escape }}"
          data-terms_service_url="{{ section.settings.terms_service_url }}"
          data-privacy_policy="{{ section.settings.privacy_policy | escape }}"
          data-privacy_policy_url="{{ section.settings.privacy_policy_url }}"
        >
          {{ section.settings.sevice_privacy_text | escape }}
        </span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Sign Up",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "sign_up_title", "label": "Heading", "default": "DON'T MISS OUT ON JACKERY DEALS" },
    {
      "type": "textarea",
      "id": "abstract",
      "label": "Abstract",
      "default": "Enter your email to get Jackery's fantastic news and offers"
    },
    { "type": "text", "id": "email_placeholder", "label": "Email Placeholder", "default": "Enter your Email Address" },
    { "type": "text", "id": "sign_up_text", "label": "Sign up text", "default": "SIGN UP" },
    { "type": "image_picker", "id": "sign_up_image", "label": "Image" },
    { "type": "image_picker", "id": "sign_up_m_image", "label": "Mobile Image" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    {
      "type": "text",
      "id": "sevice_privacy_text",
      "label": "as: I agree to Jackery's {termsService} and {PrivacyPolicy}"
    },
    { "type": "text", "id": "terms_service", "label": "terms service text" },
    { "type": "url", "id": "terms_service_url", "label": "terms service url" },
    { "type": "text", "id": "privacy_policy", "label": "privacy Policy text" },
    { "type": "url", "id": "privacy_policy_url", "label": "privacy Policy url" }
  ]
}
{% endschema %}
