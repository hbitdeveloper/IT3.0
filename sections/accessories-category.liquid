                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        {% endcase %}
    {% endfor %}
</div>

{% schema %}
{
    "name": "Accessories Category",
    "class": "section-page-accessories-category",
    "settings": [
        {"type": "checkbox", "id": "autoplay", "label": "Auto-change slides", "default": true},
        {"type": "range", "id": "autoplay_speed", "label": "Change images every", "default": 7, "min": 5, "max": 10, "step": 1, "unit": "s"},
        
        {"type": "textarea", "id": "portable_title", "label": "Section portable title", "default": "PORTABLE POWER STATIONS ACCESSORIES"},
        {"type": "header", "content": "Portable collections"},
        {"type": "collection", "id": "portbale_collection", "label": "Portable Accessories Collection"},
        
        {"type": "textarea", "id": "solar_title", "label": "Section solar title", "default": "SOLAR PANELS ACCESSORIES"},
        {"type": "header", "content": "Solar collections"},
        {"type": "collection", "id": "solar_collection", "label": "Solar Accessories Collection"},
        
        {"type": "textarea", "id": "bundles_title", "label": "Section bundles title", "default": "BUNDLES OF ACCESSORIES"},
        {"type": "header", "content": "Bundles collections"},
        {"type": "collection", "id": "bundles_collection", "label": "Bundles Accessories Collection"}
    ],
    "blocks": [
        {
            "type": "accessories_category", "name": "Accessories Category",
            "settings": [
                {"type": "text", "id": "category_title", "label": "Category Title"},
                {"type": "image_picker", "id": "category_active_image", "label": "Category Active Image"},
                {"type": "image_picker", "id": "category_negative_image", "label": "Category Negative Image"}
            ]
        },
        {
            "type": "category_type", "name": "Category Type",
            "settings": [
                {"type": "text", "id": "category_type", "label": "Category Of Images"},
                {"type": "image_picker", "id": "image", "label": "Image"},
                {"type": "image_picker", "id": "m_image", "label": "Mobile Image"},
                {"type": "url", "id": "portable_url", "label": "Image Link"}
            ]
        }
    ]
}
{% endschema %}
