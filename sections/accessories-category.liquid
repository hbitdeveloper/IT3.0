<style>
.tabs-wrap {
  width: 100%;
  padding-top: 33px;
  background-color: #ffffff;
  justify-content: center;
  gap: 170px;
  position: sticky;
  left: 0;
  top: 0;
  overflow: hidden;
  z-index: 999;
}
.tabs-wrap li {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  cursor: pointer;
}
.tabs-wrap li h3 {
  font-size: 24px;
  font-family: Gilroy-Regular, Gilroy;
  font-weight: 400;
  color: #999999;
  line-height: 36px;
}
.tabs-wrap li img {
  width: 170px;
  height: 100px;
}
.tabs-wrap li.active h3 {
  color: #000000;
}
.category-product {
  width: 100%;
  padding: 120px 0;
}
.category-product:not(:last-of-type) {
  padding-bottom: 0;
}
.category-product h2 {
  width: 100%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 50px;
}
.category-product h2 span {
  font-size: 45px;
  font-family: Gilroy-Medium, Gilroy;
  font-weight: 500;
  color: #000000;
  line-height: 66px;
}
.category-product h2 i {
  display: none;
}
.product-list {
  max-width: 1200px;
  margin: 10px auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}
.product-list li {
  background: #ffffff;
  box-shadow: 0px 6px 20px 0px rgba(85, 85, 85, 0.2);
  padding: 40px 30px 20px;
  flex-direction: column;
  justify-content: space-between;
}
.product-info {
  flex-direction: column;
}
.product-info h3 {
  text-align: center;
  font-size: 24px;
  font-family: Gilroy-Medium, Gilroy;
  font-weight: 500;
  color: #333333;
  line-height: 36px;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.product-info img {
  width: 280px;
  height: 280px;
  object-fit: cover;
  margin: 10px 0 20px;
}
.product-info .price em {
  font-size: 26px;
  font-family: Gilroy-Medium, Gilroy;
  font-weight: 500;
  color: #fd5000;
  line-height: 39px;
}
.product-info .price del {
  font-size: 22px;
  font-family: Gilroy-Regular, Gilroy;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.6);
  line-height: 33px;
  margin-left: 10px;
}
.product-info .text {
  width: 100%;
  text-align: center;
  font-size: 14px;
  font-family: Gilroy-Light, Gilroy;
  font-weight: 300;
  color: #333333;
  line-height: 21px;
  margin: 8px 0 12px;
}
.product-chose {
  width: 100%;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 10px;
}
.product-chose span {
  background: #f2f2f2;
  border-radius: 5px;
  border: 1px solid transparent;
  padding: 5px 10px;
  font-size: 14px;
  font-family: Gilroy-Light, Gilroy;
  font-weight: 300;
  color: #000000;
  line-height: 21px;
  cursor: pointer;
}
.product-chose span.active {
  background: #fef7f6;
  border-color: #fd5000;
}
.tips-words {
  height: 42px;
  font-size: 14px;
  font-family: Gilroy-Light, Gilroy;
  font-weight: 300;
  color: #000000;
  line-height: 21px;
  margin: 20px 0;
}
.button-wrap {
  gap: 20px;
}
.button-wrap p {
  height: 21px;
  font-size: 14px;
  font-family: Gilroy-Light, Gilroy;
  font-weight: 300;
  color: #999999;
  line-height: 21px;
  margin-top: 12px;
  text-align: center;
}

@media only screen and (max-width: 768px) {
  .section-page-accessories-category {
    background-color: #F5F5F5;
  }
  .tabs-wrap {
    gap: 12vw;
    box-shadow: 0px 2px 1.6vw rgba(153, 153, 153, 0.15);
    padding: 6.666666666666667vw 0;
  }
  .tabs-wrap li h3 {
    font-size: 3.2vw;
    line-height: 4vw;
  }
  .tabs-wrap li img {
    width: 21.333333333333332vw;
    height: 13.333333333333334vw;
  }
  .category-product {
    padding: 0;
  }
  .category-product:first-of-type{
    margin-top: 0;
  }
  .category-product h2 {
    width: 100%;
    justify-content: space-between;
    padding: 8vw;
    margin-bottom: 8.8vw;
  }
  .category-product h2 span {
    font-size: 4.266666666666667vw;
    line-height: 6.4vw;
  }
  .category-product h2 i {
    display: block;
  }
  .product-content{
    width: 100%;
    max-height: 0px;
    overflow: hidden;
    transition: max-height .5s;
  }
  .product-list {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 4.8vw;
    padding: 0 8vw;
  }
  .category-product[data-active] .product-content {
    max-height: 1000vh;
  }
  .product-list li {
    box-shadow: none;
    padding: 6.666666666666667vw 5.333333333333333vw;
  }
  .product-list li:last-of-type{
    margin-bottom: 13.333333333333334vw;
  }
  .product-info h3 {
    font-size: 3.475935828877005vw;
    line-height: 5.333333333333333vw;
  }
  .product-info .price em {
    font-size: 4.8vw;
    font-weight: 600;
    line-height: 7.2vw;
  }
  .product-info .price del {
    font-size: 3.2vw;
    font-weight: 300;
    line-height: 4.8vw;
    margin-left: 1.0666666666666667vw;
  }
  .product-info .text {
    text-align: left;
    font-size: 3.2vw;
    font-weight: 400;
    line-height: 4.8vw;
    margin: 4.266666666666667vw 0 1.6vw;
  }
  .product-chose span {
    padding: 1.3333333333333333vw;
    font-size: 3.2vw;
    line-height: 4.8vw;
  }
  .tips-words {
    height: auto;
    font-size: 3.466666666666667vw;
    font-weight: 400;
    line-height: 4vw;
    margin: 4.266666666666667vw 0;
  }
  .button-wrap {
    gap: 4vw;
  }
  .button-wrap p {
    height: auto;
    font-size: 3.2vw;
    font-weight: 400;
    color: #cccccc;
    line-height: 4vw;
  }
}
</style>

{% assign CategoryTabs = section.blocks | where: 'type', "accessories_category" %}

<div class="section-page-accessories-category">
    <!-- tabs -->
    <ul class="flex items-center tabs-wrap">
        {% for tab in CategoryTabs %}
            <li class="tab-item items-center" data-id="{{tab.settings.category_id}}">
                <h3>{{tab.settings.category_title}}</h3>
                {% if forloop.index0 == 0 %}
                    <img
                        src="{{tab.settings.category_active_image | img_url: 'master'}}"
                        alt="{{tab.settings.category_title}}"
                        data-active="{{tab.settings.category_active_image | img_url: 'master'}}"
                        data-negative="{{tab.settings.category_negative_image | img_url: 'master'}}"
                    />
                {% else %}
                    <img
                        src="{{tab.settings.category_negative_image | img_url: 'master'}}"
                        alt="{{tab.settings.category_title}}"
                        data-active="{{tab.settings.category_active_image | img_url: 'master'}}"
                        data-negative="{{tab.settings.category_negative_image | img_url: 'master'}}"
                    />
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    {% for block in section.blocks %}
        {% case block.type %}
            {% when 'category_type' %}
            <!-- 内容 -->
            <div id="portable" class="category-product" data-active>
                <h2>
