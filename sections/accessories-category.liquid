                                        </a>
                                        <p></p>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="flex">
                            <div class="flex items-center product-info">
                                <h3>Jackery PowerCable 12V Automobile Lead-Acid Battery</h3>
                                <img src="" alt="" />
                                <div class="flex items-center price">
                                    <em>$ 99.99</em>
                                    <del>$ 129.00</del>
                                </div>
                                <p class="text">Apply for:</p>
                                <div class="flex items-center product-chose">
                                    <span class="active">Explorer 2000 Pro&1000pro</span>
