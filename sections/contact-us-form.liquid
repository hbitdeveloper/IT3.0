
{%-liquid
    assign email_to = 'mailto:hello@jackery.com'
    case shop.id
        when 9709262
            assign email_to = 'mailto:hello@jackery.com'
        when 57272172741, 64525172955, 75730714917
            assign email_to = 'mailto:hello.eu@jackery.com'
        when 56981160124
            assign email_to = 'mailto:hello.eu@jackery.com'
        when 69013700929
            assign email_to = 'mailto:hello.eu@jackery.com'
        when 73356443969
            assign email_to = 'mailto:hello.eu@jackery.com'
        when 65060929623
            assign email_to = 'mailto:hello.eu@jackery.com'
        else
            assign email_to = 'mailto:hello@jackery.com'
    endcase
-%}

<div class="contact-us-form index-container" data-success-message="{{ 'accessibility.contact_us_success_msg' | t }}" data-error-message="{{ 'accessibility.contact_us_fail_msg' | t }}">
  <div class="form-wrap">
    <div class="tabs J-contact-tabs">
      <span class="active">{{ 'templates.contact.customer_support' | t }}</span>
      <span>{{ 'templates.contact.media_cooperation' | t }}</span>
      <span>{{ 'templates.contact.channel_cooperation' | t }}</span>
    </div>
    <div class="form-box J-contact-form">
      <div class="customer-support J-customer-support active">
        <div class="form-wrap">
          <div class="row">
            <div class="form-item">
              <label for="Contact_Customer_Email">{{ 'templates.contact.customer_email' | t }}<span>*</span></label>
              <input type="text" id="Contact_Customer_Email" name="Contact_Customer_Email" />
            </div>
            <div class="form-item">
              <label for="Contact_Customer_Name">{{ 'templates.contact.customer_name' | t }}<span>*</span></label>
              <input type="text" id="Contact_Customer_Name" name="Contact_Customer_Name" maxlength="50" />
            </div>
          </div>
          <div class="row">
            <div class="form-item">
              <label for="Contact_Customer_Category">{{ 'templates.contact.customer_category' | t }}<span>*</span></label>
              {% render 'tree-select', class: 'category_field' %}
            </div>
          </div>

          <div class="row">
            <div class="form-item">
              <label for="Contact_Customer_Product">{{ 'templates.contact.customer_product_name' | t }}</label>
              {% render 'tree-select', class: 'contact-us__tree_field' %}
            </div>
          </div>

          <div class="row">
            <div class="form-item">
              <label for="Contact_Customer_Message">{{ 'templates.contact.customer_message' | t }}<span>*</span></label>
              <textarea id="Contact_Customer_Message" name="Contact_Customer_Message" style="resize: vertical;" maxlength="1000"></textarea>
            </div>
          </div>
          <div class="row">
            <div class="form-item">
              <label for="Contact_Customer_Attachment">{{ 'templates.contact.customer_upload' | t }}</label>
              <div class="file-list J-contact-customer-filelist"></div>
              <div class="btn">
                <input type="file" id="Contact_Customer_Attachment" class="upload-input" accept=".png, .jpg, .jpeg, .gif, .mp4, .avi, .mov, .wmv, .3gp, .doc, .docx, .xls, .xlsx, .pdf">
              </div>
            </div>
          </div>

          {%- if section.settings.privacy != blank -%}
          <div class="row">
            <div class="form-item">
               <div class="form-check">
                  <input class="form-checkbox" id="agree" type="checkbox" name="agree">
                  <label class="form-label checkbox-label" id="checkbox-label" for="agree"></label>
                  <span class="info">{{ section.settings.privacy }} </span>
              </div>
              <p class="error-tip hidden" id="error-agree">{{'newsletter.policy_empty_info' | t}}</p>
            </div>
          </div>
          {%- endif -%}

        </div>
        <div class="submit">
          <span class="J-contact-customer-submit">{{ 'templates.contact.submit' | t }}</span>
        </div>
      </div>
      <div class="media-cooperation J-media-cooperation">
        <div class="form-wrap">
          <div class="row">
            <div class="form-item">
              <label for="Contact_Media_Name">{{ 'templates.contact.channel_name' | t }}<span>*</span></label>
              <input type="text" id="Contact_Media_Name" name="Contact_Media_Name" maxlength="50" />
            </div>
            <div class="form-item">
              <label for="Contact_Media_Email">{{ 'templates.contact.email_address' | t }}<span>*</span></label>
              <input type="text" id="Contact_Media_Email" name="Contact_Media_Email" />
            </div>
          </div>
          <div class="row">
            <div class="form-item">
              <label for="Contact_Media_Category">{{ 'templates.contact.category' | t }}<span>*</span></label>
              <input type="text" id="Contact_Media_Category" name="Contact_Media_Category" maxlength="50" />
            </div>
          </div>
          <div class="row">
            <div class="form-item">
              <label for="Contact_Media_Plantform">{{ 'templates.contact.plantform' | t }}<span>*</span></label>
              <input type="text" id="Contact_Media_Plantform" name="Contact_Media_Plantform" maxlength="200" />
            </div>
          </div>
          <div class="row">
            <div class="form-item">
              <label for="Contact_Media_Audience">{{ 'templates.contact.audience_protrait' | t }}<span>*</span></label>
              <input type="text" id="Contact_Media_Audience" name="Contact_Media_Audience" maxlength="200" />
            </div>
          </div>
          <div class="row">
            <div class="form-item">
              <label for="Contact_Media_Influence">{{ 'templates.contact.influence' | t }}<span>*</span></label>
              <input type="text" id="Contact_Media_Influence" name="Contact_Media_Influence" maxlength="200" />
            </div>
          </div>
          <div class="row">
            <div class="form-item">
              <label for="Contact_Media_Introduction">{{ 'templates.contact.channel_introduction' | t }}</label>
              <input type="text" id="Contact_Media_Introduction" name="Contact_Media_Introduction" maxlength="200" />
            </div>
          </div>
          <div class="row">
            <div class="form-item">
              <label for="Contact_Media_Proposal">{{ 'templates.contact.partnership_proposal' | t }}</label>
              <textarea id="Contact_Media_Proposal" name="Contact_Media_Proposal" style="resize: vertical;" maxlength="200"></textarea>
            </div>
          </div>
          <div class="row">
            <div class="form-item">
              <label for="Contact_Media_Proposal">{{ 'templates.contact.upload_attachment' | t }}</label>
              <div class="file-list J-contact-flie-list"></div>
              <div class="btn">
                <input type="file" id="Contact_Media_Proposalt" class="upload-input" accept=".png, .jpg, .jpeg, .gif, .mp4, .avi, .mov, .wmv, .3gp, .doc, .docx, .xls, .xlsx, .pdf">
              </div>
            </div>
          </div>
          {%- if section.settings.privacy != blank -%}
          <div class="row">
            <div class="form-item">
               <div class="form-check">
                  <input class="form-checkbox" id="agree-media" type="checkbox" name="agree-media">
                  <label class="form-label checkbox-label" id="checkbox-label" for="agree-media"></label>
                  <span class="info">{{ section.settings.privacy }} </span>
              </div>
              <p class="error-tip hidden" id="error-agree-media">{{'newsletter.policy_empty_info' | t}}</p>
            </div>
          </div>
          {%- endif -%}
        </div>
        <div class="submit">
          <span class="J-contact-submit">{{ 'templates.contact.submit' | t }}</span>
        </div>
      </div>
      <div class="channel-cooperation">
        <div class="box">
          <div class="title">{{ section.settings.channel_title | newline_to_br }}</div>
          <div class="subtitle">{{ section.settings.channel_subtitle | newline_to_br }}</div>
          {%- if section.settings.channel_button_text != blank -%}
            <a href="{{ section.settings.channel_button_url }}" class="submit">{{ section.settings.channel_button_text }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  <div class="info-wrap">
    {% comment %} {% assign contact_item = section.blocks | where: 'type', "contact-info" %} {% endcomment %}
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.type == "contact-info" %}
          <div class="contact-info-item" data-block-id="{{ block.id }}">
            {% comment %} AI CHAT {% endcomment %}
            {% if block.settings.add_ai_chat == 'true' %}
              <div class="title">{{ block.settings.ai_chat_title }}</div>
              <div class="text jds_zip_chat_click" style="cursor: pointer;" onClick="(window.pageInfo && (window.pageInfo.cr === 'ES' || window.pageInfo.cr === 'EU')) ? window.Jackery.Utils.pullZipChat(event) : window.zE('messenger', 'open')">{{ block.settings.ai_chat_value }}</div>
              {%- style -%}
                .jds_zip_chat_click:hover{
                  text-decoration: underline;
                }
              {%- endstyle -%}
            {% else %}
              {% comment %} 普通文案 {% endcomment %}
              <div class="title">{{ block.settings.contact_item_title }}</div>
              <div class="text">
                {% if block.settings.add_contact_item_url == 'true' %}
                  <a href="{{ block.settings.contact_item_url | default: email_to }}" target="_blank" rel="noopener noreferrer">
                    {{ block.settings.contact_item_value | newline_to_br }}
                  </a>
                  {%- style -%}
                    .contact-info-item a:hover{
                      text-decoration: underline;
                    }
                  {%- endstyle -%}
                {% else %}
                  {{ block.settings.contact_item_value | newline_to_br }}
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</div>
{% schema %}
  {
    "name": "contact us form",
    "tag": "div",
    "settings": [
      {"type": "header", "content": "Contact Form Plate"},
      { "type": "textarea", "id": "channel_title", "label": "Channel Cooperation Title" },
      { "type": "textarea", "id": "channel_subtitle", "label": "Channel Cooperation Subtitle" },
      { "type": "text", "id": "channel_button_text", "label": "Channel Cooperation Button Text" },
      { "type": "url", "id": "channel_button_url", "label": "Channel Cooperation Url" },
      { "type": "richtext", "id": "privacy", "label": "Privacy Policy"}
    ],
    "blocks": [
      {
        "type": "contact-info",
        "name": "Contact Item",
        "limit": 8,
        "settings": [
          {
            "type": "select",
            "id": "add_ai_chat",
            "label": "是否添加AI Chat",
            "options": [
              { "value": "false", "label": "否,普通文案" },
              { "value": "true", "label": "是，AIChat入口" }
            ],
            "default": "false"
          },
          { "type": "text", "id": "ai_chat_title", "label": "AI Chat Title", "default": "Pre-Sale AI Chat", "visible_if": "{{ block.settings.add_ai_chat == 'true' }}" },
          { "type": "text", "id": "ai_chat_value", "label": "AI Chat Message", "default": "Chat Now(24/7 Support)", "visible_if": "{{ block.settings.add_ai_chat == 'true' }}" },
          { "type": "text", "id": "contact_item_title", "label": "Contact Title", "visible_if": "{{ block.settings.add_ai_chat == 'false' }}"  },
          { "type": "textarea", "id": "contact_item_value", "label": "Contact Message", "visible_if": "{{ block.settings.add_ai_chat == 'false' }}"  },
          {
            "type": "select",
            "id": "add_contact_item_url",
            "label": "是否添加超链接",
            "options": [
              { "value": "false", "label": "否" },
              { "value": "true", "label": "是" }
            ],
            "default": "false",
            "visible_if": "{{ block.settings.add_ai_chat == 'false' }}"
          },
          {
            "type": "url",
            "id": "contact_item_url",
            "label": "超链接地址",
            "visible_if": "{{ block.settings.add_ai_chat == 'false' and block.settings.add_contact_item_url == 'true' }}"
          }
        ]
      }
    ]
  }
{% endschema %}