
<section class="w-full flex-center bg-white px-30 pt-70 pb-200 lg:px-0 lg:j-pt-56 lg:j-pb-120 xl:a-pt-56 xl:a-pb-120">
  {% comment %} 骨架屏 {% endcomment %}
  <div class="old-invite-new-skeleton-wrap rounded-24 w-full min-h-900 p-8 lg:j-w-760 lg:j-min-h-520 lg:j-p-6 lg:j-rounded-20 xl:a-w-760 xl:a-min-h-520 xl:a-p-6 xl:a-rounded-20" style="background-color:#e1e1e145;">
    <div class="flex-start flex-col rounded-24 w-full max-h-full min-h-884 px-50 pt-40 pb-25 lg:j-min-h-508 lg:j-rounded-20 lg:j-px-64 lg:j-pt-40 lg:j-pb-25 xl:a-min-h-508 xl:a-rounded-20 xl:a-px-64 xl:a-pt-40 xl:a-pb-25">
      <div class="flex-center flex-col w-full">
        <span class="w-full h-48 lg:j-h-58 xl:a-h-58 skeleton"></span>
        <span class="block lg:hidden w-3/4 h-48 mt-8 skeleton"></span>
      </div>
      <div class="flex flex-col w-full mt-25 min-h-248 gap-y-12 lg:j-mt-20 lg:j-gap-y-8 lg:j-min-h-110 xl:a-mt-20 xl:a-gap-y-8 xl:a-min-h-110">
        <span class="w-full h-28 mt-lg:j-h-14 xl:a-h-14 skeleton"></span>
        <span class="w-full h-28 lg:j-h-14 xl:a-h-14 skeleton"></span>
        <span class="w-full h-28 lg:j-h-14 xl:a-h-14 skeleton"></span>
        <span class="w-1/2 h-28 lg:j-h-14 xl:a-h-14 skeleton"></span>
      </div>

      <div class="w-full mt-58 lg:j-w-400 lg:j-mt-47 xl:a-w-400 xl:a-mt-47">
        <span class="w-full flex h-80 rounded-40 mb-8 lg:j-w-400 lg:j-h-48 lg:j-rounded-24 lg:j-mb-8 xl:a-h-48 xl:a-rounded-24 xl:a-w-400 xl:a-mb-8 skeleton"></span>
        <span class="w-full flex h-80 rounded-40 mt-24 lg:j-w-400 lg:j-h-48 lg:j-rounded-24 lg:j-mt-16 xl:a-w-400 xl:a-h-48 xl:a-rounded-24 xl:a-mt-16 skeleton"></span>
        <span class="w-full flex h-28 mt-48 lg:j-w-350 lg:j-h-16 lg:j-mt-16 xl:a-w-350 xl:a-h-16 xl:a-mt-16 skeleton"></span>
      </div>
    </div>
  </div>

  {% comment %} Content 区域 {% endcomment %}
  <div class="!hidden old-invite-new-content-wrap envelope-border flex-center rounded-24 w-full min-h-900 p-8 lg:j-w-760 lg:j-min-h-520 lg:j-p-6 lg:j-rounded-20 xl:a-w-760 xl:a-min-h-520 xl:a-p-6 xl:a-rounded-20">
    <div class="flex-start flex-col bg-#FAF8F4 rounded-24 w-full max-h-full min-h-884 px-50 pt-40 pb-25 lg:j-min-h-508 lg:j-rounded-20 lg:j-px-64 lg:j-pt-40 lg:j-pb-25 xl:a-min-h-508 xl:a-rounded-20 xl:a-px-64 xl:a-pt-40 xl:a-pb-25">
      <h2
        class="w-full font-semibold text-center text-#1A1A1A text-40 leading-48 lg:j-text-40 lg:j-leading-58 xl:a-text-40 xl:a-leading-58"
        data-old-invite-new-invite-title
      >{{ section.settings.title | newline_to_br }}</h2>
      <p
        class="
          w-full font-normal text-#0C0B0B overflow-y-auto
          mt-25 text-28 leading-40 max-h-500
          lg:j-mt-20 lg:j-text-14 lg:j-leading-22 lg:j-max-h-248
          xl:a-mt-20 xl:a-text-14 xl:a-leading-22 xl:a-max-h-248

          min-h-248 lg:j-min-h-110 xl:a-min-h-110
        "
        data-old-invite-new-invite-description
        data-purchase-guidance="{{ section.settings.purchase_guidance | newline_to_br }}"
      >{{ section.settings.subscribe_description | newline_to_br }}</p>

      <form id="old-invite-new-invite-form" class="w-full mt-58 lg:j-w-400 lg:j-mt-47 xl:a-w-400 xl:a-mt-47">
        <input
          class="appearance-none font-normal text-left placeholder:text-#1C1A18 w-full flex h-80 border-1 rounded-40 text-#1A1A1A border-#B4B4B4 border-solid bg-transparent text-28 leading-52 px-34 text-28 mb-8 lg:j-w-400 xl:a-w-400 lg:j-h-48 lg:j-border-1 lg:j-rounded-24 lg:j-text-16 lg:j-leading-24 lg:j-px-20 lg:j-mb-8 xl:a-h-48 xl:a-border-1 xl:a-rounded-24 xl:a-text-16 xl:a-leading-24 xl:a-px-20 xl:a-mb-8"
          type="text"
          placeholder="{{'newsletter.email_placeholder' | t}}"
          data-old-invite-new-form-input
          data-email-empty-error-text="{{'newsletter.email_empty_info' | t}}"
          data-email-format-error-text="{{'newsletter.email_error_info' | t}}"
        >
        <p class="hidden text-#FE3B30 font-normal text-28 leading-32 mt-12 lg:j-mt-8 lg:j-text-14 lg:j-leading-24 xl:a-mt-8 xl:a-text-14 xl:a-leading-24" data-email-error-tip></p>
        <button class="old-invite-new-button old-invite-new-highlight-button w-full flex-center lg:j-w-400 xl:a-w-400" type="submit" data-old-invite-new-form-button>
          <span class="line-clamp-1 w-full break-all font-medium lg:j-text-18 xl:a-text-18">{{ section.settings.get_my_rewards_text | escape }}</span>
        </button>

        <label class="flex items-start mt-48 lg:j-mt-16 xl:a-mt-16" data-policy-error-text="{{'newsletter.policy_empty_info' | t}}">
          <jds-checkbox id="old-invite-new-agree-checkbox" value="true">
            <span
              class="flex-1 font-normal text-#666 cursor-pointer text-26 leading-40 lg:j-text-13 lg:j-leading-24 xl:a-text-13 xl:a-leading-24"
              data-terms_service="{{ section.settings.terms_service | escape }}"
              data-terms_service_url="{{ section.settings.terms_service_url }}"
              data-privacy_policy="{{ section.settings.privacy_policy | escape }}"
              data-privacy_policy_url="{{ section.settings.privacy_policy_url }}"
            >{{ section.settings.sevice_privacy_text | escape }}</span>
          </jds-checkbox>
        </label>
        <p class="hidden text-#FE3B30 font-normal text-28 leading-32 mt-12 lg:j-text-14 lg:j-leading-24 lg:j-mt-8 xl:a-text-14 xl:a-leading-24 xl:a-mt-8" data-policy-error-tip></p>
      </form>

      <div
        class="!hidden w-full flex-1 flex-between flex-col mt-56 mb-50 lg:j-mt-25 lg:j-mb-20 xl:a-mt-25 xl:a-mb-20"
        data-old-invite-new-coupon
        data-rule-text="{{ 'oldInviteNew.rules' | t }}"
        data-code-text="{{ 'oldInviteNew.code' | t }}"
        data-copy-and-use-successfully="{{ 'oldInviteNew.copy_and_use_successfully' | t }}"
      >
        <div class="w-full flex-center flex-col">
          <div class="flex-center w-461 h-181 lg:j-w-287 lg:j-h-106 xl:a-w-287 xl:a-h-106">
            <img class="w-auto h-full object-contain -mt-20 -lg:j-mt-20 -xl:a-mt-20" src="" alt="" loading="lazy">
          </div>
          <p class="w-full flex-center text-#FEA42D font-medium mt-8 gap-x-45 text-28 lg:j-gap-x-20 lg:j-mt-8 lg:j-text-16 xl:a-gap-x-20 xl:a-mt-8 xl:a-text-16">
            <span class="underline underline-offset-2 cursor-pointer" data-old-invite-new-code></span>
            <span class="underline underline-offset-2 cursor-pointer" data-old-invite-new-rule>{{ 'oldInviteNew.rules' | t }}</span>
          </p>
        </div>
        <button
          class="old-invite-new-button old-invite-new-highlight-button w-fit min-w-460 lg:j-min-w-282 xl:a-min-w-282 disabled:opacity-50"
          data-copy-and-use-link="{{ section.settings.copy_and_use_link }}"
          data-old-invite-new-copy-use-button
        >
          <span class="line-clamp-1 w-full break-all font-medium text-28 lg:j-text-18 xl:a-text-18">{{ 'oldInviteNew.copy_and_use' | t  }}</span>
        </button>
      </div>

    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Old Invite New Referral",
    "class": "section-old-invite-new section-old-invite-new-referral",
    "settings": [
      {"type": "text", "id": "title", "label": "Referral Title", "default": "{coupon} from your friend"},
      {
        "type": "textarea",
        "id": "subscribe_description",
        "label": "Subscribe Description",
        "default": "Claim your Coupon by subscribing to Jackery, you will receive our marketing messages, including the latest offers, freebies, services, etc."
      },
      {
        "type": "textarea",
        "id": "purchase_guidance",
        "label": "Purchase guidance",
        "default": "The reward has been claimed successfully. You can also check it via your email. Shop now!"
      },
      {
        "type": "text",
        "id": "get_my_rewards_text",
        "label": "Get My Rewards Button Text",
        "default": "Get My Rewards"
      },
      {
        "type": "text",
        "id": "sevice_privacy_text",
        "label": "as: I agree to Jackery's {termsService} and {PrivacyPolicy}",
        "default": "I agree to Jackery's {termsService} and {PrivacyPolicy}"
      },
      { "type": "text", "id": "terms_service", "label": "terms service text", "default": "Terms of Service" },
      { "type": "url", "id": "terms_service_url", "label": "terms service url" },
      { "type": "text", "id": "privacy_policy", "label": "privacy Policy text", "default": "Privacy Policy" },
      { "type": "url", "id": "privacy_policy_url", "label": "privacy Policy url" },
      {
        "type": "url",
        "id": "copy_and_use_link",
        "label": "Copy and Use Link"
      }
    ]
  }
{% endschema %}
