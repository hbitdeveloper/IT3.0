<style>
  .olight-brand-introduce .top-brand {
    background: url({{ section.settings.top_bg_pc | image_url: width: 1280 }});
  }

  .olight-brand-introduce .bottom-brand {
    background: url({{ section.settings.bottom_bg_pc | image_url: width: 1280 }});
  }

  @media screen and (max-width: 1024px) {
    .olight-brand-introduce .top-brand {
      background: url({{ section.settings.top_bg_mb | image_url: width: 750 }});
    }

    .olight-brand-introduce .bottom-brand {
      background: url({{ section.settings.bottom_bg_mb | image_url: width: 750 }});
    }
  }
</style>
<div class="olight-brand-introduce" anchor="{{ section.settings.anchor | escape }}" style="background: {{ section.settings.bg_color }}">
  {% render 'new-title',
    class: 'sence-title',
    title: section.settings.title,
    type: section.settings.type,
    bgColor: '#DBEEF9'
  %}
  <div class="jky-12th-container">
    <div class="top-brand">
      <div class="icon">
        {% render 'responsive-image', image: section.settings.top_icon, image_class: 'top-icon'  %}
      </div>
      <div class="text">
        {{ section.settings.top_text }}
      </div>
    </div>
    <div class="bottom-brand">
      <div class="icon">
        {% render 'responsive-image', image: section.settings.bottom_icon, image_class: 'bottom-icon'  %}
      </div>
      <div class="text">
        {{ section.settings.bottom_text }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Olight Brand",
  "tag": "section",
  "settings": [
    { "type": "text",  "id": "anchor", "label": "二级标题定位锚点" },
    { "type": "color_background", "id": "bg_color", "label": "背景颜色"},
    { "type": "text", "id": "title", "label": "标题" },
    {
      "type": "select",
      "id": "type",
      "label": "标题类型",
      "options": [
        { "value": "1", "label": "小档" },
        { "value": "2", "label": "大档" }
      ],
      "default": "1"
    },
    {"type": "image_picker",  "id": "top_bg_pc",  "label": "上部分背景图PC"},
    {"type": "image_picker",  "id": "top_bg_mb",  "label": "上部分背景图MB"},
    {"type": "image_picker",  "id": "top_icon",  "label": "上部分icon"},
    { "type": "richtext", "id": "top_text", "label": "上部分文案" },
    {"type": "image_picker",  "id": "bottom_bg_pc",  "label": "下部分背景图PC"},
    {"type": "image_picker",  "id": "bottom_bg_mb",  "label": "下部分背景图MB"},
    {"type": "image_picker",  "id": "bottom_icon",  "label": "下部分icon"},
    { "type": "richtext", "id": "bottom_text", "label": "下部分文案" }


  ],
  "presets": [
    {
      "name": "Olight Brand"
    }
  ]
}
{% endschema %}
