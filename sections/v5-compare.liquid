{% comment %} 产品对比页面 {% endcomment %}
{% style %}
  v5-compare .com-header-item.active {
    position: relative;
  }
  v5-compare .com-header-item.active .item-title,
  v5-compare .com-header-item:hover .item-title {
    color: #242f20;
  }
  v5-compare .com-header-item.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: rgba(0, 0, 0, 0.65);
  }
  v5-compare .com-header-item .item-img {
    width: auto;
  }
  v5-compare .select-item.active .select-input:after {
    transform: rotate(225deg);
  }

  v5-compare .select-item.active .select-dropdown {
    opacity: 1;
    visibility: visible;
  }

  v5-compare .select-item.active .select-dropdown .select-option:hover {
    background: #f3f0f0;
  }
  v5-compare .select-item.active .select-dropdown .select-option.active {
    background: #f5f5f5;
  }
  v5-compare .select-item.active .select-dropdown .select-option.active:after {
    border: solid #666;
    border-width: 0 2px 2px 0;
    content: '';
    height: 11px;
    position: absolute;
    right: 10px;
    transform: rotate(45deg);
    width: 8px;
  }
  v5-compare .overflow-x-auto::-webkit-scrollbar {
    height: 0px;
    width: 0px;
  }

  v5-compare .overflow-x-auto::-webkit-scrollbar-track {
    background-color: transparent;
  }

  v5-compare .overflow-x-auto::-webkit-scrollbar-thumb {
    background-color: transparent;
    border-radius: 0px;
    box-shadow: none;
  }

  v5-compare .curr-products {
    top: calc(var(--jky-header-h) - 1px);
  }

  v5-compare .curr-products.is-sticky {
    border-bottom: 1px solid #E5E5E5;
  }

  v5-compare .curr-products.is-sticky .images,
  v5-compare .curr-products.is-sticky .desc {
    display: none;
  }

  v5-compare .curr-products.is-sticky .select-item {
    margin-bottom: 1rem;
  }
  
  @media (max-width: 1024px) {
    v5-compare .curr-products.is-sticky .price,
    v5-compare .curr-products.is-sticky .toggle-diff {
      display: none;
    }

    v5-compare .compare-header {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
  }
  
{% endstyle %}
{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}
<v5-compare
  id="{{ section.id }}"
  {{ section.shopify_attributes }}
  {% if section.settings.anchor != blank %}
    anchor-target="{{section.settings.anchor | escape}}"
  {% endif %}
  new-window="{{ section.settings.new_window }}"
  open-auto-discount-price="{{settings.open_auto_discount_price}}"
  text-shop-now="{{ 'general.action_text.shop_now' | t }}"
  text-show-diff="{{ 'products.product.show_diff_text' | t }}"
>
  <div class="section-padding" style="background: {{section.settings.bg_color}};{{style}}">
    <div>
      <div class="w-full lg:w-[82.5rem] mx-auto">
        <div class="border-b border-[#E5E5E5] border-solid">
          <div class="flex items-center justify-between w-[21.4375rem] lg:w-[66.25rem] mx-auto">
            {% for item in section.blocks %}
              {% assign title = item.settings.title | strip_html %}
              <div
                {{ item.shopify_attributes }}
                class="w-[7.125rem] lg:w-[18.75rem] h-[3.75rem] flex items-center justify-center pb-3 cursor-pointer com-header-item"
                data-id="{{ item.settings.id | escape }}"
                data-title="{{ title }}"
                data-handle="{{ item.settings.handle | escape }}"
              >
                {% render 'diff-end-img',
                  pc_img: item.settings.image,
                  pc_img_width: 40,
                  picture_class: 'hidden lg:block item-img',
                  class: 'w-10 h-10',
                  alt: title
                %}
                <div class="text-[1rem] text-center lg:text-[1.25rem] leading-[1.2] text-[#818181] font-semibold pl-1 item-title">{{ item.settings.title }}</div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="compare-main">
          <div class="sticky top-[3.75rem] lg:top-10 z-10 curr-products">
            <div class="px-4 lg:px-0 w-full mx-auto pt-6 lg:pt-10 text-left grid grid-cols-[10.25rem_10.25rem] lg:grid-cols-[10.5rem_24rem_24rem_24rem] bg-[#fff] gap-4 lg:gap-0  product-select">
              <div class="hidden lg:block"></div>
              <div class="lg:pl-6 lg:pr-[4.5rem] animate-pulse">
                  <div class="w-full h-12 bg-[#F5F5F5] rounded mb-3"></div>
              </div>
              <div class="lg:pl-6 lg:pr-[4.5rem] animate-pulse">
                  <div class="w-full h-12 bg-[#F5F5F5] rounded mb-3"></div>
              </div>
              <div class="hidden lg:block lg:pl-6 lg:pr-[4.5rem] animate-pulse">
                  <div class="w-full h-12 bg-[#F5F5F5] rounded mb-3"></div>
              </div>
            </div>
            <div class="px-4 lg:px-0 w-full mx-auto text-left grid grid-cols-[10.25rem_10.25rem] lg:grid-cols-[10.5rem_24rem_24rem_24rem] bg-[#fff] gap-4 lg:gap-0  product-info">
              <div class="hidden lg:block"></div>
              <div class="lg:pl-6 lg:pr-[4.5rem] animate-pulse">
                  <div class="w-full h-[6.25rem] bg-[#F5F5F5] rounded mb-4"></div>
                  <div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div>
                  <div class="h-4 bg-[#F5F5F5] rounded w-1/2 mb-4"></div>
                  <div class="h-8 bg-[#F5F5F5] rounded w-1/3"></div>
              </div>
              <div class="lg:pl-6 lg:pr-[4.5rem] animate-pulse">
                  <div class="w-full h-[6.25rem] bg-[#F5F5F5] rounded mb-4"></div>
                  <div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div>
                  <div class="h-4 bg-[#F5F5F5] rounded w-1/2 mb-4"></div>
                  <div class="h-8 bg-[#F5F5F5] rounded w-1/3"></div>
              </div>
              <div class="hidden lg:block lg:pl-6 lg:pr-[4.5rem] animate-pulse">
                  <div class="w-full h-[6.25rem] bg-[#F5F5F5] rounded mb-4"></div>
                  <div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div>
                  <div class="h-4 bg-[#F5F5F5] rounded w-1/2 mb-4"></div>
                  <div class="h-8 bg-[#F5F5F5] rounded w-1/3"></div>
              </div>
              <div class="col-span-2 lg:col-span-4 flex justify-center items-center lg:pt-6 pb-6 bg-white animate-pulse">
                  <div class="flex items-center justify-center w-full">
                  <div class="w-11 h-6 bg-[#F5F5F5] rounded-full"></div>
                  <div class="ml-3 lg:ml-4 h-6 lg:h-7 bg-[#F5F5F5] rounded w-24 lg:w-48"></div>
                  </div>
              </div>
            </div>
          </div>
          <div class="compare-details bg-[#fff]">
            <div class="compare-section animate-pulse">
                <div class="compare-header bg-[#E8E8E5] h-[3.75rem] px-4 lg:px-6 flex items-center justify-between border-b border-solid border-[#E2E3E3]">
                    <div class="h-6 w-1/3 bg-[#dcdcdc] rounded"></div>
                </div>
                <div class="compare-content border-t border-[#E2E3E3] bg-white">
                    <div class="grid grid-cols-[10.25rem_10.25rem] lg:grid-cols-[24rem_24rem_24rem] lg:pl-[10.5rem] border-b border-[#E2E3E3]">
                        <div class="p-6 min-h-[5rem] border-r border-[#E2E3E3]"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                        <div class="p-6 min-h-[5rem] border-r border-[#E2E3E3]"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                        <div class="p-6 min-h-[5rem] hidden lg:block"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                    </div>
                    <div class="grid grid-cols-[10.25rem_10.25rem] lg:grid-cols-[24rem_24rem_24rem] lg:pl-[10.5rem]">
                        <div class="p-6 min-h-[5rem] border-r border-[#E2E3E3]"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                        <div class="p-6 min-h-[5rem] border-r border-[#E2E3E3]"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                        <div class="p-6 min-h-[5rem] hidden lg:block"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                    </div>
                </div>
            </div>
            <div class="compare-section animate-pulse">
                <div class="compare-header bg-[#E8E8E5] h-[3.75rem] px-4 lg:px-6 flex items-center justify-between border-b border-solid border-[#E2E3E3]">
                    <div class="h-6 w-1/3 bg-[#dcdcdc] rounded"></div>
                </div>
                <div class="compare-content border-t border-[#E2E3E3] bg-white">
                    <div class="grid grid-cols-[10.25rem_10.25rem] lg:grid-cols-[24rem_24rem_24rem] lg:pl-[10.5rem] border-b border-[#E2E3E3]">
                        <div class="p-6 min-h-[5rem] border-r border-[#E2E3E3]"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                        <div class="p-6 min-h-[5rem] border-r border-[#E2E3E3]"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                        <div class="p-6 min-h-[5rem] hidden lg:block"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                    </div>
                    <div class="grid grid-cols-[10.25rem_10.25rem] lg:grid-cols-[24rem_24rem_24rem] lg:pl-[10.5rem]">
                        <div class="p-6 min-h-[5rem] border-r border-[#E2E3E3]"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                        <div class="p-6 min-h-[5rem] border-r border-[#E2E3E3]"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                        <div class="p-6 min-h-[5rem] hidden lg:block"><div class="h-4 bg-[#F5F5F5] rounded w-3/4 mb-2"></div><div class="h-4 bg-[#F5F5F5] rounded w-1/2"></div></div>
                    </div>
                </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="application/ld+json">
    [
        {% for item in section.blocks %}
            {
                "id": {{ item.settings.id | json}},
                "title": {{ item.settings.title | json}},
                "handle": {{ item.settings.handle | json }},
                "image": {{ item.settings.image | image_url: width: 80, height: 80  | json}}
            }{% if forloop.last != true %},{% endif %}
        {% endfor %}
    ]
  </script>
</v5-compare>
<script src="{{ 'section-v5-compare.min.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "V5 - 产品对比",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#FFFFFF" },
    { "type": "header", "content": "PC边距" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0
    },
    { "type": "header", "content": "MB边距" },
    {
      "type": "select",
      "id": "mb_padding_type",
      "label": "MB边距",
      "options": [
        { "value": "default", "label": "与PC一致" },
        { "value": "custom", "label": "单独配置" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 24,
      "visible_if": "{{section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 64,
      "visible_if": "{{section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0,
      "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0,
      "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
    },
    { "type": "checkbox", "id": "new_window", "label": "打开新的页面", "default": false }
  ],
  "limit": 1,
  "blocks": [
    {
      "type": "productType",
      "name": "类型(必须是3个)",
      "limit": 3,
      "settings": [
        { "type": "richtext", "id": "title", "label": "标题" },
        { "type": "text", "id": "id", "label": "ID", "info": "OS后台配置的ID(必填)" },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle",
          "info": "链接带系列的参数时，需要自动选中对应的系列(solar-generator、portable-power-station、solar-panel)"
        },
        { "type": "image_picker", "id": "image", "label": "Icon (80*80)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5 - 产品对比",
      "category": "V5.0",
      "settings": {
      },
      "blocks": [
        {
          "type": "productType",
          "settings": {
            "title": "<p>Solar Generator</p>",
            "id": "HBC051",
            "handle": "solar-generator"
          }
        },
        {
          "type": "productType",
          "settings": {
            "title": "<p>Portable Power Station</p>",
            "id": "HBC039",
            "handle": "portable-power-station"
          }
        },
        {
          "type": "productType",
          "settings": {
            "title": "<p>Solar Panel</p>",
            "id": "HBC027",
            "handle": "solar-panel"
          }
        }
      ]
    }
  ]
}
{% endschema %}
