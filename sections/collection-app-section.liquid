{%- if section.settings.collection.handle == collection.handle -%}
    {%- for block in section.blocks -%}
        {%- case block.type -%}
            {%- when '@app' -%}
                {% render block %}
        {%- endcase -%}
    {%- endfor -%}
{%- endif -%}

{% schema %}
  {
    "name": "collection app section",
    "tag": "section",
    "class": "section section-app-blocks",
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "指定collection分类中显示App内容",
        "info": "不选择则都不显示"
      }
    ],
    "blocks": [
      {
        "type": "@app"
      }
    ]
  }
{% endschema %}