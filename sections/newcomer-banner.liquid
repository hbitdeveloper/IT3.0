<style>
    .newcomer-education-banner {
        background-image: url({{ section.settings.pc_image | image_url }});
    }

    @media screen and (max-width: 1024px) {
        .newcomer-education-banner {
            background-image: url({{ section.settings.mb_image | image_url }});
        }
    }

    .newcomer-education-banner {
        height: 640px;
        width: 100%;
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        position: relative;
        display: flex;
        justify-content: center;
    }

    .newcomer-education-banner .education-banner-container {
        margin-top: 248px;
        width: 960px;
        text-align: center;
    }

    .newcomer-education-banner .education-banner-container .content .title {
        font-weight: 600;
        font-size: 56px;
        color: #FFFFFF;
        line-height: 64px;
    }

    .newcomer-education-banner .education-banner-container .content .sub-title {
        margin-top: 20px;
        font-weight: 600;
        font-size: 18px;
        color: #FFFFFF;
        line-height: 18px;
    }

    .newcomer-education-banner .pc-block{
        display: block;
    }
    .newcomer-education-banner .mb-block{
        display: none;
    }

    @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
        .newcomer-education-banner {
            height: 44.44444444vw;
        }

        .newcomer-education-banner .education-banner-container {
            margin-top: 17.22222222vw;
            width: 66.66666667vw;
            text-align: center;
        }

        .newcomer-education-banner .education-banner-container .content .title {
            font-size: 3.88888889vw;
            line-height: 4.44444444vw;
        }

        .newcomer-education-banner .education-banner-container .content .sub-title {
            margin-top: 1.38888889vw;
            font-size: 1.25vw;
            line-height: 1.25vw;
        }
    }

    @media screen and (max-width: 1024px) {
        .newcomer-education-banner {
            height: 133.33333333vw;
        }

        .newcomer-education-banner .education-banner-container {
            margin-top: 36.93333333vw;
            width: 87.2vw;
            text-align: center;
        }

        .newcomer-education-banner .education-banner-container .content .title {
            font-size: 7.46666667vw;
            line-height: 8.53333333vw;
        }

        .newcomer-education-banner .education-banner-container .content .sub-title {
            margin-top: 2vw;
            font-size: 3.73333333vw;
            line-height: 4.8vw;
        }

        .newcomer-education-banner .pc-block{
            display: none;
        }
        .newcomer-education-banner .mb-block{
            display: block;
        }
    }
</style>

<div class="newcomer-education-banner">
  <div class="education-banner-container">
    <div class="content">
      {% assign titleColor = '<em style="color: ' | append: section.settings.title_color | append: '">' %}
      {% if section.settings.title != blank %}
        <div class="title pc-block {% if settings.jky_theme_version != 'v4' %}v5-font-oxm{% endif %}">
          {{ section.settings.title | replace: '<em>', titleColor }}
        </div>
      {% endif %}
      {% if section.settings.title_mb != blank %}
        <div class="title-mb mb-block title {% if settings.jky_theme_version != 'v4' %}v5-font-oxm{% endif %}">
          {{ section.settings.title_mb | replace: '<em>', titleColor }}
        </div>
      {% endif %}
      {% assign titleSubColor = '<em style="color: ' | append: section.settings.title_sub_color | append: '">' %}
      <div class="sub-title">
        {{ section.settings.title_sub | replace: '<em>', titleSubColor }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newcomer Banner",
  "settings": [
    { "type": "image_picker", "id": "pc_image", "label": "PC背景图", "info": "1920*640" },
    { "type": "image_picker", "id": "mb_image", "label": "MB背景图", "info": "750*1000" },
    { "type": "richtext", "id": "title", "label": "PC标题" },
    { "type": "richtext", "id": "title_mb", "label": "MB标题" },
    { "type": "color", "id": "title_color", "label": "标题颜色【斜体=文案突出】" },
    { "type": "richtext", "id": "title_sub", "label": "副标题" },
    { "type": "color", "id": "title_sub_color", "label": "副标题文案颜色【斜体=文案突出】" }
  ],
  "presets": [
    {
      "name": "newcomer banner"
    }
  ]
}
{% endschema %}
