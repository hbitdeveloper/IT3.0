  {%- if section.settings.installment_type == 'splitit' and shop.id == 55005249633 -%}
    <script>
      (function () {
        function initSplitit() {
          if(window.splitit_script_loaded) return;
          window.splitit_script_loaded = true;
          var s = document.createElement('script');
          var splitit_url = 'https://cdn.shopify.com/proxy/6da4c7acd8056454fa088038cdfbba4216fa9acf2c292a9c3a4905a58e39a8e1/web-components.splitit.com/upstream.js?shop=jackeryuk.myshopify.com&sp-cache-control=cHVibGljLCBtYXgtYWdlPTkwMA';
          s.type = 'text/javascript';
          s.async = true;
          s.src = splitit_url;

          var x = document.getElementsByTagName('script')[0];
          x.parentNode.insertBefore(s, x);
          x.defer = true;
        }

        if(window.attachEvent) {
          window.attachEvent('onload', initSplitit);
        } else {
          window.addEventListener('load', initSplitit, false);
        }
      })()
    </script>
  {%- endif -%}

  <v5-product-row-multi
    section-id="{{ section.id }}"
    class="{% if section.settings.related_v_tabs and section.settings.belongs_to != blank and request.design_mode == false %}!hidden{% endif %} flex flex-col w-full section-padding"
    {% if section.settings.anchor != blank %}
      anchor-target="{{ section.settings.anchor | escape}}"
    {% endif %}
    {% if section.settings.belongs_to != blank %}
      belongs-to-target="{{ section.settings.belongs_to | escape }}"
    {% endif %}
    data-pc-is-swiper="{{ pc_layout_style }}"
    data-mb-is-swiper="{{ mb_is_swiper }}"
    data-countdown-hide-section="{{ section.settings.countdown_hide_section_when_off }}"
    style="
      --pc-bg-color:{{ section.settings.pc_bg_color | default: '#FFFFFF' }};
      --mb-bg-color:{{ section.settings.mb_bg_color | default: '#FFFFFF' }};
      --main-color:{{ section.settings.main_color | default: '#93161B' }};
      {{ style }}
    "
  >
    {% comment %} 模块标题、副标题 {% endcomment %}
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="w-full h-fit mx-auto lg:w-[75rem] flex flex-col items-center justify-center gap-y-6 lg:gap-y-4 mb-6 lg:mb-10 px-4 lg:px-0">
        {% comment %} 模块标题 {% endcomment %}
        {%- if section.settings.title != blank -%}
          <h2
            class="w-full text-center text-[1.75rem] lg:text-5xl un-ja-text text-[#242F20] font-semibold leading-[1.1]"
            style="color:{{ section.settings.title_color | default: '#242F20' }}"
          >
            {{ section.settings.title | newline_to_br }}
          </h2>
        {%- endif -%}
        {% comment %} 副标题 {% endcomment %}
        {%- if section.settings.subtitle != blank -%}
          <div class="subtitle w-full flex items-center justify-center">
            <p
              class="w-full text-center font-semibold text-sm lg:text-xl un-ja-text"
              style="color:{{ section.settings.subtitle_color | default: '#242F20' }}"
            >
              {{ section.settings.subtitle | newline_to_br }}
            </p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% comment %} 倒计时 {% endcomment %}
    {%- if show_countdown -%}
      <div class="w-full mx-auto lg:w-[75rem] flex flex-col lg:flex-row items-center justify-center mb-6 lg:mb-10 gap-4 lg:gap-6 px-4 lg:px-0" data-countdown-row>
        {%- if section.settings.countdown_title != blank -%}
          <h2 class="w-fit text-center font-semibold text-white leading-[1.1] un-ja-text relative">
            {%- if section.settings.countdown_title_bg_img != blank -%}
              <img
                class="countdown-title-bg-img"
                style="
                  --countdown-title-bg-img-offset-pc-x:{{ section.settings.countdown_title_bg_img_offset_pc_x }};
                  --countdown-title-bg-img-offset-mb-x:{{ section.settings.countdown_title_bg_img_offset_mb_x }};
                  --countdown-title-bg-img-offset-pc-y:{{ section.settings.countdown_title_bg_img_offset_pc_y }};
                  --countdown-title-bg-img-offset-mb-y:{{ section.settings.countdown_title_bg_img_offset_mb_y }};
                "
                src="{{ section.settings.countdown_title_bg_img | image_url: height: 54 }}"
                width="{{ section.settings.countdown_title_bg_img.width }}" height="{{ section.settings.countdown_title_bg_img.height }}"
                alt="{{ section.settings.countdown_title_bg_img.alt }}" loading="lazy"
              >
            {%- endif -%}
            <span class="countdown-title-text relative z-[1]" style="color:{{ section.settings.countdown_title_color | default: '#FFFFFF' }};">{{ section.settings.countdown_title | escape }}</span>
          </h2>
        {%- endif -%}
        <div
          class="w-fit max-w-full flex flex-wrap items-center shrink-0"
          data-count-down
          data-ends-in-text="{{ section.settings.ends_in_text | escape }}"
          data-countdown-label-text="{{ section.settings.countdown_label_text | escape }}"
          data-shopify-time="{{ 'now' | date: "%Y/%m/%d %H:%M:%S" }}"
          data-begin-time="{{ section.settings.begin_time_str | escape }}"
          data-end-time="{{ section.settings.end_time_str | escape }}"
        >
          <div class="w-[3.25rem] h-[3.25rem] lg:w-16 lg:h-16 skeleton mr-7"></div>
          <div class="w-[3.25rem] h-[3.25rem] lg:w-16 lg:h-16 skeleton mr-7"></div>
          <div class="w-[3.25rem] h-[3.25rem] lg:w-16 lg:h-16 skeleton mr-7"></div>
          <div class="w-[3.25rem] h-[3.25rem] lg:w-16 lg:h-16 skeleton"></div>
        </div>
      </div>
    {%- endif -%}

    {% comment %} 过滤有效商品 {% endcomment %}
    {%- assign valid_items = 0 -%}
    {%- for item in product_items -%}
      {%- if item.settings.product != blank -%}
        {%- assign valid_product = item.settings.product -%}
        {%- assign valid_variant_id = item.settings.variant_id -%}
        {%- assign valid_variant = valid_product.variants | where: 'id', valid_variant_id | first -%}
        {%- if valid_variant == blank -%}
          {%- assign valid_variant = valid_product.selected_or_first_available_variant -%}
        {%- endif -%}

        {% comment %} 过滤有效商品【仅显示有库存商品、或者编辑模式】 {% endcomment %}
        {%- if valid_variant.available or request.design_mode -%}
          {%- assign valid_items = valid_items | plus: 1 -%}
        {%- endif -%}
      {%- else -%}
        {% comment %} 过滤有效商品【编辑模式】 {% endcomment %}
        {%- if request.design_mode -%}
          {%- assign valid_items = valid_items | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {% comment %} PC端一行商品数量 {% endcomment %}
    {%- assign pc_layout_number = section.settings.pc_layout_num | plus: 0 -%}
      
    {%- if product_items.size > 0 -%}
      <div class="w-full mx-auto lg:w-[75rem] relative {% if mb_is_swiper or pc_layout_style == 'swiper' %}swiper{% endif %}">
        <ul
          class="
            flex
            {% if mb_is_swiper %} swiper-wrapper box-content {% else %} box-border flex-wrap gap-4 pl-4 lg:gap-0 lg:pl-0 lg:flex-nowrap{% endif %}
            {% if pc_layout_style == 'flex' %}lg:!flex-wrap lg:gap-6 lg:box-border {% else %} swiper-wrapper lg:box-content {% endif %}
            {% if mb_row_one %}pr-4 lg:pr-0{% endif %}
          "
          {% unless mb_is_swiper %}data-view-more-list{% endunless %}
        >
          {%- assign item_index = 0 -%}
          {%- for block in product_items -%}
            {%- liquid
              assign curr_product = block.settings.product
              assign curr_variant_id = block.settings.variant_id
              assign variant = curr_product.variants | where: 'id', curr_variant_id | first
              if variant == blank
                assign variant = curr_product.selected_or_first_available_variant
              endif

              # SPU 标题
              assign display_title = curr_product.title
              if block.settings.product_title != blank
                assign display_title = block.settings.product_title
              endif

              # 图片
              assign base_img = variant.featured_image | default: curr_product.featured_image
              assign p_img = base_img
              assign m_img = base_img

              if block.settings.pc_product_image != blank
                assign p_img = block.settings.pc_product_image
              endif
              if block.settings.mb_product_image != blank
                assign m_img = block.settings.mb_product_image
              endif

              # 价格、划线价
              assign price = variant.price | default: 1999
              assign compare_at_price = variant.compare_at_price | default: price

              # 划线价
              if compare_at_price < price
                assign compare_at_price = price
              endif

              # 设置了产品折扣价，则以 产品折扣价 为准
              assign price_value = block.settings.price_value | plus: 0
              if price_value > 0
                assign price = price_value | times: 100
              else
                # 开启了自动折扣
                if settings.open_auto_discount_price and settings.display_auto_discount_price_in_activity_page
                  assign auto_discount_price = variant.metafields.custom.auto_discount_price | times: 1
                  if auto_discount_price > 0 and auto_discount_price < variant.price
                    assign price = auto_discount_price
                  endif
                endif
              endif

              # PC 显示个数
              assign pc_layout_num = section.settings.pc_layout_num
            -%}

            {%- if variant.available or request.design_mode -%}
              {%- assign item_index = item_index | plus: 1 -%}
              <li
                class="
                  !h-auto {% if pc_layout_num == '3' %} lg:!w-[24rem] {% else %} lg:!w-[17.625rem] {% endif %}
                  {% if item_index > section.settings.mb_show_max %}
                    {% if mb_is_swiper %} !flex {% else %} !hidden {% endif %}
                  {% else %}
                    !flex
                  {% endif %}
                  {% if item_index > section.settings.pc_show_max %}
                    {% if pc_layout_style == 'flex' %} lg:!hidden {% else %} lg:!flex {% endif %}
                  {% else %}
                    lg:!flex
                  {% endif %}
                   flex-col items-center bg-white relative
                  {% if mb_is_swiper or pc_layout_style == 'swiper' %}swiper-slide{% endif %}
                  {% if mb_is_swiper %}
                    !w-[17.5rem] first-of-type:ml-4 mr-4 lg:first-of-type:ml-0 lg:mr-0
                  {% elsif mb_row_one %}
                    w-full
                  {% else %}
                    !w-[10.21875rem]
                  {% endif %}
                  {% if pc_layout_style == 'swiper' %}
                    lg:mr-6 lg:last-of-type:mr-0
                  {% endif %}
                "
                data-card-item
              >
                {% comment %} 产品图片 {% endcomment %}
                <div class="w-full {% if mb_is_swiper %} h-[12.5rem] {% elsif mb_row_one %} h-[14.25rem] {% else %} h-[10.21875rem] {% endif %} lg:h-[12.5rem] shrink-0">
                  <a href="{{ curr_product.url }}?variant={{ variant.id }}" class="focus-zoom-container flex w-full h-full overflow-hidden">
                    {%- assign pc_img_w = 384 -%}
                    {% if pc_layout_num == '4' %}
                      {%- assign pc_img_w = 282 -%}
                    {% endif %}
                    {%- render 'diff-end-img',
                      class: 'focus-zoom w-full h-full object-contain',
                      style: '',
                      anchor: '',
                      pc_img: p_img,
                      mb_img: m_img,
                      pc_img_width: pc_img_w,
                      mb_img_width: 343,
                      placeholder_name: 'hero-apparel-1',
                      alt: p_img.alt | escape | default: 'product image',
                      load_scene: block.settings.load_scene | default: 'default',
                    -%}
                  </a>
                  {% comment %} 折扣角标 {% endcomment %}
                  {%- if section.settings.show_discount_tag and compare_at_price > price -%}
                    {%- liquid
                      assign discount_amount = ''
                      assign discount_percent = ''
                      
                      # 1. 基础差价计算
                      assign diff_price = compare_at_price | minus: price
                      assign calc_percent = diff_price | times: 100 | divided_by: compare_at_price | floor

                      # 2. 自动折扣逻辑覆盖 (Metafields 优先级最高)
                      if price_value <= 0 and settings.open_auto_discount_price and settings.display_auto_discount_price_in_activity_page
                        assign auto_amount = variant.metafields.custom.auto_discount_amount
                        assign auto_percent = variant.metafields.custom.auto_discount_percentage
                        
                        if auto_amount != blank and auto_amount != 0
                          assign diff_price = auto_amount
                        endif
                        if auto_percent != blank and auto_percent != 0
                          assign calc_percent = auto_percent | floor
                        endif
                      endif

                      # 3. 最终格式化赋值
                      if section.settings.discount_tag_display_style == 'amount'
                        # 抹除分分位（保留到百位，如 1234 -> 1200），然后转为货币格式
                        assign discount_amount = diff_price | divided_by: 100 | floor | times: 100 | money_without_trailing_zeros
                      else
                        assign discount_percent = calc_percent
                      endif

                      assign pc_discount_img = section.settings.pc_discount_img
                      assign mb_discount_img = section.settings.mb_discount_img | default: pc_discount_img


                      # 如果是一行三个  则时间显示在角标右边 其他的情况时间展示在角标下方 
                      assign mb_box_class = "flex-col"
                      assign pc_aspect_ratio = "130/39"
                      assign mb_aspect_ratio = "130/39" 
                      assign pc_margin_top = "0"
                      assign mb_margin_top = "0"
                      assign pc_time_class = "ml-1 px-[0.625rem] h-[1.875rem] leading-[1.875rem] text-[1rem] un-ja-text font-medium"
                      assign mb_time_class = "ml-2 font-medium"
                      assign pc_time_color = section.settings.main_color | default: '#93161B'
                      assign mb_time_color = section.settings.main_color | default: '#93161B'

                      if mb_is_swiper 
                        assign mb_time_class ="ml-2 font-medium text-[0.875rem] un-ja-text"
                        assign mb_img_url_width = 560
                      elsif mb_row_one
                        assign mb_box_class = "flex-row"
                        assign mb_aspect_ratio = "auto"
                        assign mb_margin_top =  'calc(var(--discount-margin-top) * -1)'
                        assign mb_time_color = "white"
                        assign mb_time_class ="ml-2 h-[1.875rem] px-[0.625rem] leading-[1.875rem] bg-[#000000]/25 text-[1rem] un-ja-text rounded" 
                        assign mb_img_url_width = 686
                      else 
                        assign mb_time_class ="ml-2 font-medium text-[0.75rem] un-ja-text"
                        assign mb_img_url_width = 327
                      endif

                      if pc_layout_num == '3' 
                        assign box_class = "md:flex-row md:items-center" 
                        assign pc_aspect_ratio = "auto"
                        assign pc_margin_top = 'calc(var(--discount-margin-top)'
                        assign pc_img_url_width = 384
                      else
                        assign box_class = "md:flex-col" 
                        assign pc_time_class = "ml-4 text-[0.875rem] un-ja-text font-medium"
                        assign pc_img_url_width = 282
                      endif

                    -%}

                    {%- if discount_amount != blank or discount_percent != blank -%}
                      <div class="absolute left-0 top-3 flex items-start {{ mb_box_class }} {{ box_class }}  [transform:translateZ(0)] [backface-visibility:hidden] [will-change:transform]"> 
                        <div class="discount-tag-box" style=" width:var(--discount-img-width); padding-left:var(--discount-margin-left); padding-top:var(--discount-margin-top); 
                          --pc-aspect-ratio: {{ pc_aspect_ratio }};
                          --mb-aspect-ratio: {{ mb_aspect_ratio }};" >
                          {%- if pc_discount_img != blank or mb_discount_img != blank -%}
                            <img class="hidden lg:block w-fit h-auto object-contain absolute left-0 top-0 z-0 max-w-none" src="{{ pc_discount_img | image_url: width: pc_img_url_width }}" style="width:var(--discount-img-width);" alt="discount img" width="auto" height="auto">
                            <img class="block lg:hidden w-fit h-auto object-contain absolute left-0 top-0 z-0 max-w-none" src="{{ mb_discount_img | image_url: width: mb_img_url_width }}" style="width:var(--discount-img-width);" alt="discount img" width="auto" height="auto">
                          {%- endif -%}

                          {%- if section.settings.discount_tag_display_style == 'amount' -%}
                            {%- if discount_amount != blank -%}
                              <span class="relative z-[1] font-semibold text-white text-sm lg:text-base un-ja-text whitespace-nowrap" style="color:{{ section.settings.discount_color | default: '#FFFFFF' }};">{{ section.settings.discount_amount_display_style | replace: '()', discount_amount }}</span>
                            {%- endif -%}
                          {%- else -%}
                            {%- if discount_percent != blank -%}
                              <span class="relative z-[1] font-semibold text-white text-sm lg:text-base un-ja-text whitespace-nowrap" style="color:{{ section.settings.discount_color | default: '#FFFFFF' }};">{{ section.settings.discount_percent_display_style | replace: '()', discount_percent }}</span>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                        {%- if variant.metafields.custom.discount_tag_time != blank -%}
                          <span id="pc_discount_tag_time" class=" {{ pc_time_class }} " style="color:{{ pc_time_color }}; margin-top: {{ pc_margin_top }}"> 
                            {{ variant.metafields.custom.discount_tag_time }}
                          </span>
                          <span id="mb_discount_tag_time" class=" {{ mb_time_class }} " style="color:{{ mb_time_color }}; margin-top: {{ mb_margin_top }}"> 
                            {{ variant.metafields.custom.discount_tag_time }}
                          </span>
                        {%- endif -%}
                      </div> 
                    {%- endif -%}
                  {%- endif -%}

                  {% comment %} 订阅 {% endcomment %}
                  {%- if section.settings.show_subscribe == true -%}
                    <button
                      class="appearance-none bg-transparent w-6 h-6 lg:w-9 lg:h-9 lg:p-1 absolute {% if mb_row_two %} right-2 {% else %} right-3 {% endif %} lg:right-3 top-3 z-[1] disabled:pointer-events-none [transform:translateZ(0)] [backface-visibility:hidden] [will-change:transform]"
                      data-sku-id="{{ variant.id }}"
                      data-subsciber-btn
                    >
                      <svg class="w-full h-full" width="80" height="74" viewBox="0 0 80 74">
                        <use id="heart-use" xlink:href="#icon-heart-line"></use>
                      </svg>
                    </button>
                  {%- endif -%}
                </div>
                <div class="w-full flex-1 flex flex-col items-start justify-between px-4 {% if mb_row_one %} py-6 {% else %} py-4 {% endif %} lg:p-6 relative {% if mb_row_two %} gap-y-3 {% else %} gap-y-5 {% endif %} lg:gap-y-10">
                  {% comment %} 产品标题、副标题 {% endcomment %}
                  <div class="flex flex-col h-[8.75rem] {% if pc_layout_num == '3' %} lg:h-[10.25rem] {% else %} lg:h-[9.75rem] {% endif %}">
                    {%- assign product_tag = block.settings.product_tag | default: variant.metafields.custom.variant_tag -%}
                    {%- if product_tag != blank -%}
                      <span class="text-[var(--main-color)] font-semibold text-sm lg:text-base un-ja-text mb-2">
                        {{- product_tag | escape -}}
                      </span>
                    {%- endif -%}
                    <a href="{{ curr_product.url }}?variant={{ variant.id }}" class="text-[#242F20] font-semibold un-ja-text {% if pc_layout_num == '4' %} lg:text-xl {% else %} lg:text-2xl {% endif %} {% if mb_row_two %} text-sm line-clamp-3 {% else %} text-base line-clamp-2 {% endif %} lg:line-clamp-2" title="{{ display_title | escape }}">{{ display_title | escape }}</a>
                    {%- if block.settings.product_selling_info != blank -%}
                      <div class="text-[#242F20]/90 text-sm lg:text-base un-ja-text mt-3 lg:mt-5 line-clamp-2">{{ block.settings.product_selling_info | newline_to_br }}</div>
                    {%- else -%}
                      {%- if variant.metafields.custom.product_features_info != blank -%}
                        <div class="text-[#242F20]/90 text-sm lg:text-base un-ja-text mt-3 lg:mt-5 line-clamp-2">
                          {{ variant.metafields.custom.product_features_info | metafield_tag | strip_html }}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>

                  <div class="w-full flex-1 flex flex-col justify-between">
                    <div class="flex-1 flex flex-col justify-between gap-4 {% if mb_row_one %} mb-6 {% else %} mb-3 {% endif %} lg:mb-6">
                      {% comment %} 赠品 {% endcomment %}
                      {%- if section.settings.show_priority == 'gift' -%}
                        {%- if block.settings.gift_product != blank -%}
                          {%- liquid
                              assign curr_gift_product = block.settings.gift_product
                              assign curr_gift_variant_id = block.settings.gift_variant_id
                              assign gift_variant = curr_gift_product.variants | where: 'id', curr_gift_variant_id | first
                              if gift_variant == blank
                              assign gift_variant = curr_gift_product.selected_or_first_available_variant
                              endif

                              # 标题
                              assign gift_display_title = curr_gift_product.title
                              if gift_variant.title != 'Default Title' and gift_variant.title != blank
                              assign gift_display_title = gift_variant.title
                              endif

                              if block.settings.gift_product_title != blank
                              assign gift_display_title = block.settings.gift_product_title
                              endif

                              # 图片
                              assign gift_base_img = gift_variant.featured_image | default: curr_gift_product.featured_image
                              assign gift_product_image = gift_base_img

                              if block.settings.gift_product_image != blank
                              assign gift_product_image = block.settings.gift_product_image
                              endif
                          -%}

                          {% comment %} PC端，赠品 {% endcomment %}
                          <jds-tooltip placement="top-end" class="{% if mb_row_two %}hidden{% else %}block{% endif %} {% if pc_layout_num == '4' %} lg:hidden {% else %} lg:block {% endif %} w-full h-16 lg:w-full lg:h-16">
                            <div
                              slot="tooltip-trigger"
                              class="{% if mb_row_one %}w-[19.4375rem]{% else %}w-[15.5rem]{% endif %} h-16 lg:w-[21rem] lg:h-16 flex items-center justify-start px-4 py-3 lg:pl-3 lg:pr-6 bg-[#F5F5F3]"
                            >
                              {%- if section.settings.gift_icon != blank -%}
                                <img
                                  class="w-9 h-9 object-contain shrink-0"
                                  src="{{ section.settings.gift_icon | image_url: width: 72 }}"
                                  width="36"
                                  height="36"
                                  alt=""
                                  loading="lazy"
                                >
                              {%- else -%}
                                {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-9 h-9 object-cover shrink-0' }}
                              {%- endif -%}
                              <div class="flex-1 flex flex-col px-4 gap-y-2 lg:gap-y-1">
                                <p class="font-semibold text-sm lg:text-base un-ja-text text-[var(--main-color)] line-clamp-1">{{ section.settings.gift_text | default: 'FREE GIFT' }}</p>
                                <p class="text-[#242F20] text-xs lg:text-sm un-ja-text line-clamp-1" title="{{ gift_display_title | escape }}">{{ gift_display_title | escape }}</p>
                              </div>
                              <img
                                class="w-10 h-10 object-contain shrink-0"
                                src="{{ gift_product_image | image_url: width: 80 }}"
                                width="40"
                                height="40"
                                alt=""
                                loading="lazy"
                              >
                            </div>
                            <div slot="" class="p-6 max-w-[18.75rem]" style="box-shadow:0 0 24px rgba(0,0,0,0.1)">
                              <img
                                class="w-[14.125rem] h-[8.75rem] object-contain"
                                src="{{ gift_product_image | image_url: width: 422 }}"
                                width="226"
                                height="140"
                                alt=""
                                loading="lazy"
                              >
                              <h2 class="text-[#242F20] font-semibold text-base mt-2 un-ja-text">{{ gift_display_title | escape }}</h2>
                              {%- if block.settings.gift_product_desription != blank -%}
                                <div class="text-black/65 text-sm mt-3 un-ja-text">
                                  {{ block.settings.gift_product_desription | escape }}
                                </div>
                              {%- elsif gift_variant.metafields.custom.product_features_info != blank -%}
                                <div class="text-black/65 text-sm mt-3 un-ja-text">
                                  {{ gift_variant.metafields.custom.product_features_info | metafield_tag | strip_html }}
                                </div>
                              {%- endif -%}
                            </div>
                          </jds-tooltip>
                        {%- else -%}
                          <div
                            class="
                              {% if mb_row_two %}hidden{% else %}
                                {% if section.settings.show_gift_placeholder %}
                                  {% if mb_is_swiper %} block {% else %} hidden {% endif %}
                                {% else %}
                                  hidden
                                {% endif %}
                              {% endif %}
                              {% if pc_layout_num == '4' %}lg:hidden{% else %} {% if section.settings.show_gift_placeholder %}lg:block{%else%}lg:hidden{% endif %}{% endif %}
                              {% if mb_row_one %}w-[19.4375rem]{% else %}w-[15.5rem]{% endif %}
                              h-16 lg:w-full lg:h-16 invisible
                            "
                          ></div>
                        {%- endif -%}
                        {% comment %} 加价购 {% endcomment %}
                      {%- elsif section.settings.show_priority == 'price_up' and variant != blank -%}
                        <div
                          class="{% if mb_row_two %}hidden{% else %}flex{% endif %} {% if pc_layout_num == '4' %} lg:hidden {% else %} lg:flex {% endif %} items-center justify-start border border-solid border-[#E8E8E5] p-3 gap-x-2.5 w-full {% if mb_row_one %}h-[6.3125rem]{% else %}h-[7.5rem]{% endif %} lg:w-full lg:h-[6.3125rem] shrink-0"
                          data-sku-id="{{ variant.id }}"
                          data-show-price-up="{{ section.settings.show_price_up }}"
                          {% if pc_layout_num == '4' %}
                            data-pc-not-valid
                          {% endif %}
                          {% if mb_row_two %}
                            data-mb-not-valid
                          {% endif %}
                          data-bundle-product
                        >
                          <div class="{% if mb_row_one %} w-[3.75rem] h-[3.75rem] {% else %} w-10 h-10 {% endif %} lg:w-[3.75rem] lg:h-[3.75rem] shrink-0 skeleton"></div>
                            <div class="flex-1 flex flex-col gap-y-3 justify-between">
                              <div class="{% if mb_row_one %}w-4/5{% else %}w-full{% endif %} h-5 skeleton"></div>
                              <div class="flex {% if mb_row_one %} items-center justify-between {% else %} flex-col items-start gap-y-3 lg:flex-row lg:items-center lg:justify-between {% endif %}">
                                <div class="flex items-center gap-x-1">
                                  <div class="w-12 h-5 skeleton"></div>
                                  <div class="w-12 h-5 skeleton"></div>
                                </div>
                              <div class="w-[5.5rem] lg:w-[5.75rem] h-7 skeleton"></div>
                            </div>
                          </div>
                        </div>
                      {%- endif -%}

                      {% comment %} 税费 {% endcomment %}
                      {%- if block.settings.tax_fee_info != blank -%}
                        <div class="w-full flex item-start font-semibold text-sm lg:text-base">
                          {{ block.settings.tax_fee_info }}
                        </div>
                      {%- endif -%}

                      {% comment %} 价格、折扣码 {% endcomment %}
                      <div class="flex-1 h-auto flex flex-col item-start justify-between gap-y-2">
                        <div class="flex items-baseline gap-x-1 flex-wrap">
                          {%- if section.settings.from_text != blank -%}
                            <span class="text-sm lg:text-base un-ja-text text-[var(--main-color)]">{{- section.settings.from_text | escape -}}</span>
                          {%- endif -%}
                          <span class="font-semibold un-ja-text {% if mb_row_two %} text-base {% else %} text-xl {% endif %} lg:text-[1.75rem] text-[var(--main-color)]">{{- price | money_without_trailing_zeros -}}</span>
                          {%- if compare_at_price > price -%}
                            <span class="text-black/65 line-through text-xs lg:text-sm un-ja-text">{{- compare_at_price | money_without_trailing_zeros -}}</span>
                          {%- endif -%}
                        </div>
                        {%- if block.settings.code_value != blank -%}
                          <div
                            class="{% if mb_row_two %}hidden{% else %}flex{% endif %} lg:flex flex-wrap items-center cursor-pointer gap-x-2"
                            data-code="{{ block.settings.code_value | escape  }}"
                            data-copy-success="{{ section.settings.copy_success | escape }}"
                            data-copy-checkout="{{ section.settings.copy_checkout }}"
                            data-sku-id="{{ variant.id }}"
                            data-code-wrap
                          >
                            <span class="text-sm lg:text-base un-ja-text text-[var(--main-color)]">
                              {{- section.settings.use_code_text | default: 'Use Code' }}:
                            </span>
                            <span class="font-semibold text-sm lg:text-base un-ja-text flex items-center gap-x-2 text-[var(--main-color)]">
                              <span>{{ block.settings.code_value | escape }}</span>
                              <svg class="w-4 h-4 lg:w-5 lg:h-5" width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <g clip-path="url(#clip0_15867_72333)">
                                  <path d="M100 0H0V100H100V0Z" fill="none"/>
                                  <path d="M14 78V23H22V78C22 80.2091 23.7909 82 26 82H71.5V90H26C19.3726 90 14 84.6274 14 78Z" fill="var(--main-color)"/>
                                  <path d="M66.1992 11C66.6398 11 67.0624 11.1749 67.374 11.4863L85.5137 29.626C85.8252 29.9376 85.9999 30.3602 86 30.8008V74.6338C86 76.2906 84.6569 77.6338 83 77.6338H30C28.3431 77.6338 27 76.2906 27 74.6338V14C27 12.3431 28.3431 11 30 11H66.1992ZM62 34H79L62 17V34Z" fill="var(--main-color)"/>
                                </g>
                                <defs>
                                  <clipPath id="clip0_15867_72333">
                                    <rect width="100" height="100" fill="none"/>
                                  </clipPath>
                                </defs>
                              </svg>
                            </span>
                          </div>
                        {%- endif -%}
                      </div>
                    </div>

                    <div class="flex flex-col">
                      {% comment %} 按钮 {% endcomment %}
                      <div class="w-full flex items-center">
                        {%- liquid
                          assign pc_btn_type = section.settings.pc_show_btn_type
                          assign mb_btn_type = section.settings.mb_show_btn_type
                        -%}

                        <a href="{{ curr_product.url }}?variant={{ variant.id }}" class="flex-1 appearance-none flex items-center justify-center px-2 lg:px-6 h-[2.125rem] text-[0.875rem] lg:h-12 lg:text-[1.25rem] un-ja-text leading-[2.125rem] lg:leading-[3rem] text-white font-semibold bg-[var(--main-color)] {% if pc_layout_num == '4' %} lg:text-[var(--main-color)] lg:bg-transparent lg:border lg:border-solid lg:border-[var(--main-color)] {% endif %} {% if pc_btn_type != 'shop_now_and_add_to_cart' %} lg:hidden {% endif %} {% if mb_btn_type != 'shop_now_and_add_to_cart' %} hidden lg:flex {% endif %}">
                          <span class="w-fit line-clamp-1">{{ section.settings.shop_now_text | default: 'Shop Now' | escape }}</span>
                        </a>
                        <button
                          class="jky-v5-button add-to-cart-icon-btn appearance-none bg-transparent px-2 h-[2.125rem] lg:px-3 lg:h-12 flex items-center justify-center border border-solid border-[var(--main-color)] {% if pc_layout_num == '4' %} lg:bg-[var(--main-color)] {% endif %} {% if pc_btn_type != 'shop_now_and_add_to_cart' %} lg:hidden {% endif %} {% if mb_btn_type != 'shop_now_and_add_to_cart' %} hidden lg:flex {% endif %}"
                          data-sku-id="{{ variant.id }}"
                          data-sku-warranty-info="{{ variant.metafields.custom.sku_warranty_info.value | default: variant.metafields.custom.sku_warranty_info | escape }}"
                          data-add-to-cart-btn
                        >
                          {%- assign text_color = 'text-[var(--main-color)]' -%}
                          {%- if pc_layout_num == '4' -%}
                            {%- assign text_color = 'text-[var(--main-color)]' | append: ' lg:text-white' -%}
                          {%- endif -%}
                          {% render 'v5-icon-cart', stroke_width: 1, class: text_color | append: ' w-[1.75rem] h-[1.75rem] lg:w-10 lg:h-10' %}
                        </button>
                        <button
                          class="jky-v5-button flex-1 appearance-none flex items-center justify-center px-2 lg:px-6 h-[2.125rem] text-[0.875rem] lg:h-12 lg:text-[1.25rem] un-ja-text leading-[2.125rem] lg:leading-[3rem] text-white font-semibold bg-[var(--main-color)] {% if pc_btn_type == 'shop_now_and_add_to_cart' %} lg:hidden {% endif %} {% if mb_btn_type == 'shop_now_and_add_to_cart' %} hidden lg:flex {% endif %}"
                          data-sku-id="{{ variant.id }}"
                          data-sku-warranty-info="{{ variant.metafields.custom.sku_warranty_info.value | default: variant.metafields.custom.sku_warranty_info | escape }}"
                          data-add-to-cart-btn
                        >
                          <span class="w-fit line-clamp-1">{{ section.settings.add_to_cart_text | default: 'Add To Cart' | escape }}</span>
                        </button>
                      </div>
                      {%- assign price_num = price | plus: 0.0 -%}
                      {%- if section.settings.installment_type == 'custom' -%}
                        {%- if section.settings.installment_text != blank -%}
                          {% comment %} 分期付款 {% endcomment %}
                          {% if price_num < 20000 %}
                            {% comment %} 直接除以 100.0 强制保留小数 {% endcomment %}
                            {% assign dividend = price_num | divided_by: 100.0 %}
                            {% assign divisor = 4 %}
                          {% else %}
                            {% comment %} 先通过 times 1.1229 得到含息总额，再除以 100 {% endcomment %}
                            {% assign dividend = price_num | times: 1.1229 | divided_by: 100.0 | plus: 0.0 %}
                            {% assign divisor = 18.0 %}
                          {% endif %}
                          {% comment %} 向上取整 {% endcomment %}
                          {% assign per_affirm = dividend | divided_by: divisor | ceil %}

                          <div 
                            class="{% if mb_row_two %}hidden{% else %}flex{% endif %} {% if mb_is_swiper %} h-8 lg:h-auto {% endif %} {% if pc_layout_num == '4' %} lg:hidden {% else %} lg:flex {% endif %} items-baseline text-black/65 text-xs lg:text-sm gap-x-2 mt-3 un-ja-text"
                            data-ttt="{{ section.settings.installment_type | escape }}"
                          >
                            {%- assign per_affirm_price = per_affirm | times: 100 | money_without_trailing_zeros -%}
                            {%- assign per_affirmplaceholder = '{Installment_per}' -%}
                            <span>
                              {{- section.settings.installment_text | replace: per_affirmplaceholder, per_affirm_price -}}
                            </span>
