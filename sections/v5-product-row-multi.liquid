                              <img
                                class="w-[1.875rem] h-[0.75rem] lg:w-[3.375rem] lg:h-[1.3125rem] object-contain shrink-0"
                                src="{{ section.settings.installment_img | image_url: width: 108 }}"
                                width="54"
                                height="21"
                                alt=""
                                loading="lazy"
                              >
                            {%- else -%}
                              {{
                                'hero-apparel-1'
                                | placeholder_svg_tag: 'w-[1.875rem] h-[0.75rem] lg:w-[3.375rem] lg:h-[1.3125rem] object-contain shrink-0'
                              }}
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- elsif section.settings.installment_type == 'klarna' -%}
                        <div style="--fk-klarna-height: {{ section.settings.fk_klarna_height }}rem; --fk-klarna-height-mb: {{ section.settings.fk_klarna_height_mb }}rem;" class="row-klarna mt-3 {% if mb_row_two %}hidden{% else %}block{% endif %} {% if pc_layout_num == '4' %} lg:hidden {% else %} lg:block {% endif %}">
                          <klarna-placement data-key="credit-promotion-badge" data-locale="{{ data_local }}" data-purchase-amount="{{ price_num }}"><span></span></klarna-placement>
                        </div>
                      {%- elsif section.settings.installment_type == 'paypal' -%}
                        <div
                          style="--fk-paypal-height: {{ section.settings.fk_paypal_height }}rem; --fk-paypal-height-mb: {{ section.settings.fk_paypal_height_mb }}rem;"
                          class="mt-3 w-full row-paypal {% if mb_row_two %}hidden{% else %}block{% endif %} {% if pc_layout_num == '4' %} lg:hidden {% else %} lg:block {% endif %}"
                          data-pp-message
                          data-pp-placement="product"
                          data-pp-amount="{{ price_num | money_without_currency }}"
                          data-pp-style-layout="text"
                          data-pp-style-logo-type="primary"
                          data-pp-style-logo-position="left"
                        ></div>
                      {%- elsif section.settings.installment_type == 'splitit' -%}
                        <div 
                          style="--fk-splitit-height: {{ section.settings.fk_splitit_height }}px;--fk-splitit-height-mb: {{ section.settings.fk_splitit_height_mb }}px;"
                          class="mt-3 w-full row-splitit"
                        >
                          <spt-one-liner 
                            installments="{{ section.settings.splitit_installments | default: 6 }}" 
                            text_custom="{{ section.settings.splitit_text_custom }}" 
                            learn_more_color="{{ section.settings.splitit_learn_more_color | default: '#4e8cfd' }}" 
                            hide_icon="{{ section.settings.splitit_hide_icon | default: true }}" 
                            logo_color="{{ section.settings.splitit_logo_color | default: '#39bca7' }}" 
                            amount="{{ price_num | money_without_currency | replace: ',', '' }}"
                          ></spt-one-liner>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if pc_layout_style == 'swiper' and valid_items > pc_layout_number -%}
          <div class="hidden lg:flex items-center justify-center lg:pt-6 lg:gap-x-10">
            {%- render 'v5-icon-arrow-left', class: 'swiper-button-prev !relative flex !w-10 !h-10 items-center justify-center bg-white/80 rounded-full shadow-md text-[#242F20] hover:bg-white transition-colors cursor-pointer !mt-0' -%}
            {%- render 'v5-icon-arrow-right', class: 'swiper-button-next !relative flex !w-10 !h-10 items-center justify-center bg-white/80 rounded-full shadow-md text-[#242F20] hover:bg-white transition-colors cursor-pointer !mt-0' -%}
          </div>
        {%- endif -%}
      </div>

      {%- if valid_items > section.settings.pc_show_max or valid_items > section.settings.mb_show_max -%}
        <div class="w-full {% if mb_is_swiper %} hidden {% else %} {% if valid_items > section.settings.mb_show_max %} flex {% else %} hidden {% endif %} {% endif %} items-center justify-center {% if pc_layout_style == 'swiper' %}lg:hidden{% else %} {% if valid_items > section.settings.pc_show_max %} lg:flex {% else %} lg:hidden {% endif %} {% endif %}">
          <button
            class="appearance-none bg-transparent flex items-center justify-center gap-x-1 lg:gap-x-2 font-semibold text-[#242F20] text-base lg:text-xl un-ja-text underline underline-offset-4 mt-4 lg:mt-6"
            style="color: {{ section.settings.view_more_text_color | default: '#242F20' }}"
            data-view-more-btn
          >
            <span>{{ section.settings.view_more_text | default: 'View More' }}</span>
            <svg class="hidden lg:block w-4 h-4 -mt-0.5 lg:w-6 lg:h-6 lg:-mt-1" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22 8.99997L12 18.5L2 8.99997" stroke="currentColor" stroke-width="2"/>
            </svg>
          </button>
        </div>
      {%- endif -%}

      {% comment %} 订阅图标 {% endcomment %}
      <svg style="display: none;">
        <symbol id="icon-heart-line" viewBox="0 0 80 74">
          <path d="M0 24.5514C0 17.2425 2.1779 11.4105 5.8838 7.22035C9.568 3.05475 14.5059 0.803047 19.5186 0.179347C26.861 -0.734253 34.986 1.85235 40 7.71545C45.014 1.85245 53.139 -0.733553 60.4814 0.180347C65.494 0.804247 70.4321 3.05575 74.1162 7.22135C77.8221 11.4116 80 17.2435 80 24.5524C80 36.5777 72.7647 45.8585 64.9951 53.3512C61.0822 57.1247 56.798 60.6595 52.9619 63.9215C49.0471 67.2505 45.6103 70.2851 43.0225 73.2711H36.9775C34.3896 70.285 30.953 67.2497 27.0381 63.9205C23.202 60.6583 18.9179 57.1239 15.0049 53.3502C7.2354 45.8572 0.0001 36.5765 0 24.5514ZM8 24.5514C8.0001 33.1584 13.1399 40.4376 20.5576 47.5914C24.2383 51.1411 28.2513 54.4521 32.2197 57.8268C34.9108 60.1153 37.5954 62.445 40 64.8238C42.4047 62.445 45.0891 60.1152 47.7803 57.8268C51.7487 54.4522 55.7617 51.1419 59.4424 47.5924C66.8603 40.4388 72 33.1595 72 24.5524C72 18.8775 70.34 15.0268 68.124 12.5211C65.8863 9.99085 62.818 8.53265 59.4932 8.11885C52.5903 7.25975 45.7487 10.889 43.8145 17.0133H36.1855C34.2513 10.8889 27.4097 7.26005 20.5068 8.11885C17.182 8.53245 14.1136 9.99005 11.876 12.5201C9.66 15.0257 8 18.8765 8 24.5514Z" fill="var(--subscribe-icon-color)"/>
        </symbol>
        <symbol id="icon-heart-fill" viewBox="0 0 80 74">
          <path d="M19.5186 0.179342C26.861 -0.734258 34.986 1.85244 40 7.71544C45.014 1.85254 53.1391 -0.733557 60.4814 0.180243C65.4939 0.804143 70.4321 3.05574 74.1162 7.22134C77.822 11.4115 79.9999 17.2436 80 24.5523C80 36.5776 72.7646 45.8585 64.9951 53.3511C61.0822 57.1246 56.798 60.6595 52.9619 63.9215C49.0472 67.2503 45.6103 70.2851 43.0225 73.2711H36.9775C34.3896 70.285 30.9529 67.2496 27.0381 63.9205C23.202 60.6583 18.9178 57.1238 15.0049 53.3502C7.2355 45.8572 0.0001 36.5764 0 24.5513C0.0001 17.2426 2.1779 11.4104 5.8838 7.22034C9.568 3.05484 14.506 0.803042 19.5186 0.179342Z" fill="var(--subscribe-icon-color)"/>
        </symbol>
      </svg>
    {%- endif -%}
  </v5-product-row-multi>

  {% comment %} 订阅弹窗 {% endcomment %}
  {%- if product_items.size > 0 and section.settings.show_subscribe == true -%}
    {%- render 'v5-common-subscribe-dialog',
      id: section.id,
      class: 'v5-product-row-multi-subscibe-dialog',
      settings: section.settings,
      pc_dialog_width: '30rem',
      mb_dialog_width: '100vw'
    -%}
  {%- endif -%}
  <script src="{{ 'section-v5-product-row-multi.min.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
