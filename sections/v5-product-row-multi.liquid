{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

{%- liquid
  assign data_local = 'de-DE'

  assign time_now = 'now' | date: '%s'
  # section 默认显示
  assign is_section_valid_time = true
  # 倒计时默认不显示
  assign show_countdown = false

  assign section_begin_time = 0
  if section.settings.begin_time_str != blank
    assign section_begin_time = section.settings.begin_time_str | date: '%s'
  endif

  assign section_end_time = 0
  if section.settings.end_time_str != blank
    assign section_end_time = section.settings.end_time_str | date: '%s'
  endif

  if section_begin_time != 0 and section_end_time != 0
    if section_end_time > time_now and section_begin_time < time_now
      assign is_section_valid_time = true
      assign show_countdown = true
    else
      # 只有【开始时间】和【结束时间】都配置了，且过了有效期，才不会显示 section
      unless section.settings.countdown_hide_section_when_off
        assign is_section_valid_time = false
      else
        assign is_section_valid_time = true
        assign show_countdown = false
      endunless
    endif
  endif

  # 移动端布局样式
  assign mb_is_swiper = false
  assign mb_row_one = false
  assign mb_row_two = false
  if section.settings.mb_layout_style == 'one-row-swiper'
    assign mb_is_swiper = true
  elsif section.settings.mb_layout_style == 'one-row-one'
    assign mb_row_one = true
  else
    assign mb_row_two = true
  endif

  # PC端布局样式
  assign pc_layout_style = section.settings.pc_layout_style

  # 筛选出 v5-product-item 类型的 block
  assign product_items = section.blocks | where: 'type', 'v5-product-item'
-%}

{%- if is_section_valid_time -%}
  <style>
    .row-paypal {
      min-height: var(--fk-paypal-height);
    }
    .row-splitit {
      min-height: var(--fk-splitit-height);
    }
    .row-klarna {
      min-height: var(--fk-klarna-height);
    }

    v5-product-row-multi[section-id="{{ section.id }}"] {
      background: var(--pc-bg-color);
      --discount-img-width: calc({{ section.settings.pc_discount_img_width }} / 16 * 1rem);
      --discount-margin-left: calc({{ section.settings.discount_margin_left_pc }} / 16 * 1rem);
      --discount-margin-top: calc({{ section.settings.discount_margin_top_pc }} / 16 * 1rem);
      --subscribe-icon-color: {{ section.settings.subscribe_icon_color | default: '#242F20' }};
    }
    v5-product-row-multi[section-id="{{ section.id }}"] jds-tooltip::part(tooltip) {
      --jds-popover-background-color: #FFF;
      --jds-popover-padding: 0;
      --jds-popover-border-radius: 0;
      --jds-index-popover: 97;
    }
    v5-product-row-multi[section-id="{{ section.id }}"] jds-tooltip {
      max-height: 5.25rem;
    }
    v5-product-row-multi[section-id="{{ section.id }}"] .countdown-title-bg-img {
      position: absolute;
      z-index: 0;
      height: 3.375rem;
      --offset-pc-x: calc(var(--countdown-title-bg-img-offset-pc-x) / 16 * 1rem);
      {% if section.settings.countdown_title_bg_img_position == 'left' %}
        left: var(--offset-pc-x);
      {% else %}
        right: var(--offset-pc-x);
      {% endif %}
      --offset-pc-y: calc(var(--countdown-title-bg-img-offset-pc-y) / 16 * 1rem);
      top: var(--offset-pc-y);
    }
    v5-product-row-multi[section-id="{{ section.id }}"] .countdown-title-text {
       font-size: calc({{ section.settings.countdown_title_font_size_pc }} / 16 * 1rem);
    }
    {%- if section.settings.pc_layout_num == '4' -%}
      v5-product-row-multi[section-id="{{ section.id }}"] .jky-v5-button.add-to-cart-icon-btn {
        --border-color: #FFF;
      }
    {%- else -%}
      v5-product-row-multi[section-id="{{ section.id }}"] .jky-v5-button.add-to-cart-icon-btn {
        --border-color:var(--main-color);
      }
    {%- endif -%}
    @media screen and (max-width: 1023.98px) {
      .row-paypal {
        min-height: var(--fk-paypal-height-mb);
      }
      .row-splitit {
        min-height: var(--fk-splitit-height-mb);
      }
      .row-klarna {
        min-height: var(--fk-klarna-height-mb);
      }

      v5-product-row-multi[section-id="{{ section.id }}"] {
        background: var(--mb-bg-color);
        --discount-img-width: calc({{ section.settings.mb_discount_img_width }} / 16 * 1rem);
        --discount-margin-left: calc({{ section.settings.discount_margin_left_mb }} / 16 * 1rem);
        --discount-margin-top: calc({{ section.settings.discount_margin_top_mb }} / 16 * 1rem);
      }
      v5-product-row-multi[section-id="{{ section.id }}"] .countdown-title-text {
        font-size: calc({{ section.settings.countdown_title_font_size_mb }} / 16 * 1rem);
      }
      v5-product-row-multi[section-id="{{ section.id }}"] jds-tooltip {
        max-height: unset;
      }
      v5-product-row-multi[section-id="{{ section.id }}"] .countdown-title-bg-img {
        height: 1.875rem;
        --offset-mb-x: calc(var(--countdown-title-bg-img-offset-mb-x) / 16 * 1rem);
        {% if section.settings.countdown_title_bg_img_position == 'left' %}
          left: var(--offset-mb-x);
        {% else %}
          right: var(--offset-mb-x);
        {% endif %}
        --offset-mb-y: calc(var(--countdown-title-bg-img-offset-mb-y) / 16 * 1rem);
        top: var(--offset-mb-y);
      }
      v5-product-row-multi[section-id="{{ section.id }}"] .jky-v5-button.add-to-cart-icon-btn {
        --border-color:var(--main-color);
      }
    }

    #pc_discount_tag_time {
        display: block;
    }
    #mb_discount_tag_time {
        display: none;
    }
     v5-product-row-multi[section-id="{{ section.id }}"] .discount-tag-box {
      aspect-ratio: var(--pc-aspect-ratio);
    }
    @media (max-width: 1023.99px) {
      #pc_discount_tag_time {
          display: none;
      }
      #mb_discount_tag_time {
          display: block;
      }
      v5-product-row-multi[section-id="{{ section.id }}"] .discount-tag-box {
        aspect-ratio: var(--mb-aspect-ratio);
      }
    }
  </style>

  {%- if section.settings.installment_type == 'paypal' and section.settings.installment_paypal_client_id != blank -%}
    <script>
      (function () {
        function initPaypal() {
          if(window.paypal_script_loaded) return;
          window.paypal_script_loaded = true;
          var s = document.createElement('script');
          var paypal_url = 'https://www.paypal.com/sdk/js?client-id={{ section.settings.installment_paypal_client_id }}&components=messages';
          s.type = 'text/javascript';
          s.async = true;
          s.src = paypal_url;
          var x = document.getElementsByTagName('script')[0];
          x.parentNode.insertBefore(s, x);
          x.defer = true;
        }

        if(window.attachEvent) {
          window.attachEvent('onload', initPaypal);
        } else {
          window.addEventListener('load', initPaypal, false);
        }
      })()
    </script>
  {%- endif -%}

