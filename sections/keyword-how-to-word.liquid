{%- style -%}
  .section-keyword-htw {
    background: #ffffff;
    margin-bottom: 3.125vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }

  .keyword-htw-title {
    font-size: 2.3438vw;
    font-weight: 600;
    color: #000000;
    padding-bottom: 3.3854vw;
    text-align: center;
  }

  .keyword-htw-content-m {
    display: none;
  }

  .keyword-htw-content {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5625vw;
  }

  .keyword-htw-content .keyword-htw-content-item {
    background: #f4f2ed;
  }
  .keyword-htw-content .keyword-htw-content-item .htw-item-image {
    display: block;
    max-width: 100%;
  }
  .keyword-htw-content .keyword-htw-content-item .htw-item-image-m {
    display: none;
  }

  .keyword-htw-content .keyword-htw-content-item .htw-item-title {
    padding: 1.5625vw 1.5625vw 0.625vw 1.5625vw;
    font-size: 1.3542vw;
    font-weight: 600;
    color: #000000;
  }
  .keyword-htw-content .keyword-htw-content-item .htw-item-subtitle {
    padding: 0 1.5625vw 1.875vw 1.5625vw;
    font-size: 1.25vw;
    font-weight: 500;
    color: #000000;
    line-height: 1.5625vw;
    word-wrap: break-word;
  }

  .khtw-swiper-pagination {
    display: none;
  }
  @media screen and (max-width: 768px) {
    .keyword-htw-title {
      font-size: 6vw;
      font-weight: 600;
      color: #000000;
      line-height: 8.8vw;
      padding-bottom: 7.3333vw;
    }

    .section-keyword-htw {
      max-width: 100%;
      padding: 0 8vw;
      padding-bottom: 8.4vw;
    }

    .keyword-htw-content {
      display: none;
    }

    .keyword-htw-content-m {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 2vw;
    }

    .keyword-htw-content-m .keyword-htw-content-item {
      background: #f4f2ed;
    }

    .keyword-htw-content-m .keyword-htw-content-item .htw-item-image {
      display: none;
    }

    .keyword-htw-content-m .keyword-htw-content-item .htw-item-image-m {
      display: block;
      max-width: 100%;
    }

    .keyword-htw-content-m .keyword-htw-content-item .htw-item-title {
      padding: 4.1333vw 4.4vw 1.6vw 4.4vw;
      font-size: 3.4667vw;
      font-weight: 600;
      color: #000000;
    }

    .keyword-htw-content-m .keyword-htw-content-item .htw-item-subtitle {
      padding: 0 4.4vw 3.7333vw 4.4vw;
      font-size: 3.2vw;
      font-weight: 500;
      color: #000000;
      line-height: 4vw;
      word-wrap: break-word;
    }

    .khtw-swiper-pagination{
      display: flex;
      justify-content: center;
      padding-top: 5.3333vw;
      align-items: center;
    }
    .khtw-swiper-pagination .khtw-swiper-pagination-customs {
      width: 5.3333vw;
      height: 0.2667vw;
      background: #CCCCCC;
      margin-right: 1.3333vw;
    }
    .khtw-swiper-pagination .khtw-swiper-pagination-customs-active{
      width: 13.3333vw;
      height: 0.5333vw;
      background: var(--primary-color);
    }
  }

  .keyword-htw-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .keyword-htw-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .keyword-htw-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }
  }
{%- endstyle -%}

<h2 class="keyword-htw-title" anchor="{{ section.settings.anchor | escape }}"
style="
--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
--pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
"
>{{ section.settings.title | escape }}</h2>
{%- if section.settings.sub != blank -%}
 <div class="keyword-htw-sub keyword-sub">{{ section.settings.sub }}</div>
{%- endif -%}
<div class="keyword-htw-content">
  {% for block in section.blocks %}
    <div class="keyword-htw-content-item">
      <img
        src="{{ block.settings.image | image_url: width: 900 }}"
        alt="{{ block.settings.image.alt }}"
        class="htw-item-image" loading="lazy"
      >
      <div class="htw-item-title">{{ block.settings.title | escape }}</div>
      <div class="htw-item-subtitle">{{ block.settings.content | newline_to_br }}</div>
    </div>
  {% endfor %}
</div>

<div class="swiper keyword-htw-content-m">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="swiper-slide keyword-htw-content-item">
        <img
          src="{{ block.settings.m_image | image_url: width: 750 }}"
          alt="{{ block.settings.m_image.alt }}"
          class="htw-item-image-m" loading="lazy"
        >
        <div class="htw-item-title">{{ block.settings.title | escape }}</div>
        <div class="htw-item-subtitle">{{ block.settings.content | newline_to_br }}</div>
      </div>
    {% endfor %}
  </div>
</div>
<div id="khtw_swiper_page" class="khtw-swiper-pagination"></div>

<script type="module">
  function keywordHowToWordInit() {
    var swiper = new Swiper('.keyword-htw-content-m', {
      autoHeight: true,
      autoplay: true,
      loop: true,
      pagination: {
        el: '#khtw_swiper_page',
        type: 'custom',
        renderCustom: function (swiper, current, total) {
          var paginationHtml = '';
          for (var i = 1; i <= total; i++) {
            // 判断是否是激活焦点，是的话添加active类，不是就只添加基本样式类
            if (i === current) {
              paginationHtml +=
                '<span class="khtw-swiper-pagination-customs khtw-swiper-pagination-customs-active"></span>';
            } else {
              paginationHtml += '<span class="khtw-swiper-pagination-customs"></span>';
            }
          }
          return paginationHtml;
        },
      },
    });
  }

  window.addEventListener('DOMContentLoaded', function () {
    keywordHowToWordInit();
  });
</script>

{% schema %}
{
  "name": "Keyword How To Word",
  "class": "section-keyword-htw",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },  
  { "type": "text", "id": "title", "label": "Title" },
  { "type": "richtext", "id": "sub", "label": "Subtitle" },
  { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
  { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 40 },
  { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
  { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 }
],
  "blocks": [
    {
      "type": "htw-item",
      "name": "htw Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab Title" },
        { "type": "textarea", "id": "content", "label": "Tab Content" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "m_image", "label": "Mobile Image" }
      ]
    }
  ],
    "presets": [
    {
      "name": "Keyword How To Word",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
