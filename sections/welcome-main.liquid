<style>
    .image-banner-container {
        background: #F5F5F5;
        padding: 60px 0 100px 0;
    }

    .image-banner-brand-content {
        padding: 41px 52px 40px 70px;
        margin-top: 50px;
    }
    .image-banner-brand-content img:first-child {
        width: 35px;
    }

    .image-banner-brand-content img:nth-child(2) {
        width: 49px;
    }
    @media screen and (max-width: 768px) {
        .image-banner-container {
            padding: 6.66vw 0;
        }
        .image-banner-brand-content {
            padding: 10vw 6.4vw 9.33vw 6vw;
            margin-top: 3.7vw;
        }
        .image-banner-brand-content img:first-child {
            width: 4.66vw;
        }
        .image-banner-brand-content img:nth-child(2) {
            width: 6.4vw;
        }
        .image-banner .image-banner-title {
            color: #fff!important;
        }
        .image-banner .image-banner-content.middle-center {
            justify-content: flex-start;
        }

        .product-recommend-box .z-button-middle {
            font-weight: 600;
        }
    }


    .main {
        width: 100%;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .main-container {
        position: relative;
        width: 100%;
        height: 100vh;
        bottom: 0;
        left: 0;
    }
    .main-container.topIndex {
        z-index: 10002!important;
        background: #fff
    }
    .main .bg {
        position: absolute;
        width: 100%;
        bottom: 0;
        object-fit: cover;
        
        height: calc(124vh + 100px);
        opacity: 0;
        visibility: hidden;
    }
    .gift-icon {
        text-align: center;
        z-index: 2;
    }
    .gift-icon img {
        height: 10vw;
    }
    .gift-icon p {
        color: #333333;
        margin-top: 24px;
    }

    .timeLine {
        align-items: center;
        display: flex;
        justify-content: space-between;
        left: 18.75vw;
        position: absolute;
        top: 40px;
        width: 62.5vw;
        z-index: 2;
    }
    .timeLine .point, .timeLine .num{
        width:2.19vw;
        height:2.19vw;
        position: relative;
        border-radius: 50%;
    }
    .num{
        text-align: center;
        line-height: 2.19vw;
        box-sizing: border-box;
        border: 1px solid var(--jds-color-primary);
        color: var(--jds-color-primary);
    }

    .timeLine .text{
        color: #999999;
        text-align: center;
        position:absolute;
        top: calc(100% + 4px);
        width: max-content;
        left: 50%;
        transform: translateX(-50%);
        word-break: break-word;
        padding: 0 5px;
    }
    .line {
        border-bottom: 1px solid var(--jds-color-primary);
        border-top: 1px solid var(--jds-color-primary);
        box-sizing: border-box;
        flex-grow: 1;
        height: 0.52vw;
    }
    .line.start {
        border-radius: 0.26vw 0 0 0.26vw;
    }
    .line.end {
        border-radius: 0 0.26vw 0.26vw 0;
        border-right: 1px solid var(--jds-color-primary);
    }
    .step-item {
        transition: all .3s ease;
    }
    .step-item.active {
        background: var(--jds-color-primary);
    }
    .step-item.active .num {
        color: #fff;
    }
    .step-item.active .text {
        color: var(--jds-color-primary);
    }
    .step-gift {
        position: absolute;
        top: 6.8vw;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        opacity: 0;
        visibility: hidden;
        transition: all .3s ease;
        max-width: 550px;
    }
    .step-gift.active {
        opacity: 1;
        visibility: visible;
    }
    .step-gift img {
        width: 7.8125vw;
        height: 6.77083vw;
        object-fit: cover;
        margin-bottom: 8px;
    }
    .step-gift-title {
        color: var(--jds-color-primary);
        margin-bottom: 4px;
    }
    .step-gift-subtitle {
        color: var(--jds-color-primary);
        margin-bottom: 4px;
    }

    .fixed-container {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background:#fff;
        z-index: -1;
        opacity: 0;
        padding: 18px 0 4px 0;
    }
    .fixed-container .z-button-fill-middle {
        margin-bottom: 10px;
        width: 240px;
    }
    .fixed-container span.jky-text-base {
        color: #999;
    }
    .register-box {
        margin-right: 30px;
    }

    .benefits_des p {
        font-weight: 400;
        color: #000;
        font-size: 18px;
        margin-top: 2px;
        backdrop-filter: blur(2px);
    }
    .benefits_des p strong {
        color: var(--primary-color);
    }

    @media screen and (max-width: 768px) {
        .main .bg {
            height: calc(100vh + 48vw);
        }
        .gift-icon {
            padding-top: 8vw
        }
        .gift-icon img {
            height: 26vw;
        }
        .gift-icon p {
            margin-top: 3.2vw;
        }
        .timeLine {
            left: 8vw;
            top: 9vw;
            width: 84vw;
        }
        .timeLine .point, .timeLine .num{
            width: 5.6vw;
            height: 5.6vw;
        }
        .num {
            line-height: 5.6vw;
        }
        .line {
            height: 1.32vw;
        }
        .line.start {
            border-radius: 5px 0 0 5px;
            flex-grow: unset;
            width: 8vw;
        }
        .line.end {
            border-radius: 0 5px 5px 0;
            flex-grow: unset;
            width: 8vw;
        }
        .step-gift {
            top: 28.4vw;
            width: 85vw;
            max-width: unset;
        }
        .step-gift img {
            width: 20vw;
            height: auto;
            margin-bottom: 2px;
        }
        .step-gift-subtitle {
            margin-bottom: 9px;
        }
        .fixed-container {
            padding: 10vw 0 6vw 0;
        }
        .fixed-container .z-button-fill-middle {
            margin-bottom: 2.13vw;
            width: 40vw;
        }
        .register-box {
            margin-right: 4vw;
        }
        .benefits_des p {
            font-size: 14px;
            margin-top: 8px;
        }
    }
    @media screen and (max-width: 375px) {
        .timeLine .text {
            max-width: 78px;
        }
        #whatCan .point {
            height: 138vw;
        }
    }
</style>

