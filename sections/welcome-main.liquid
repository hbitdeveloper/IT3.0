<script src="{{ 'gsap.js' | asset_url }}"></script>
<script src="{{ 'scrollTrigger.js' | asset_url }}"></script>

<script>
        gsap.defaults({
            overwrite: 'auto'
        });

        var end_pos = 1000

        const ST = ScrollTrigger.create({
            trigger: ".main-container",
            start: "top top",
            end: () => "+=" + end_pos,
            onUpdate: getCurrentSection,
            onEnter: () => {
                $('.main-container').addClass('topIndex')
                $('.fixed-container span.jky-text-base').css('display', 'block')
            },
            onEnterBack: () => {
                $('.main-container').addClass('topIndex')
                $('.fixed-container span.jky-text-base').css('display', 'block')
            },
            onLeave: () => {
                $('.main-container').removeClass('topIndex')
                $('.fixed-container span.jky-text-base').css('display', 'none')
            },
            onLeaveBack: () => {
                $('.main-container').removeClass('topIndex')
                $('.fixed-container span.jky-text-base').css('display', 'none')
            },
            pin: ".main-container"
        });

        const contentMarkers = gsap.utils.toArray(".main .bg");
        contentMarkers.forEach(marker => {
            gsap.set(document.querySelector(`.main .bg.step-1`), {
                autoAlpha: 1
            });
            marker.enter = function () {
                gsap.fromTo(marker, {
                    autoAlpha: 0
                }, {
                    duration: 0.5,
                    autoAlpha: 1
                });
            }

            marker.leave = function () {
                gsap.to(marker, {
                    duration: 0.1,
                    autoAlpha: 0
                });
            }
        });

        let lastContent;
        let lastContent_gift;

        function getCurrentSection(v) {
            let newContent;
            let newContent_gift;
            const currScroll = scrollY;

            if (v.direction === -1 && v.progress <= 0.01) {
                $('.fixed-container').css('z-index', -1)
                $('.fixed-container').css('opacity', 0)
            }

            if(v.direction === 1 && v.progress >= 0.99) {
                $('.fixed-container').css('background', '#fff')
            }

            if(v.direction === -1 && v.progress <= 0.99) {
                $('.fixed-container').css('background', 'transparent')
            }

            if (v.progress >= 0 && v.progress <= 0.25) {
                if (v.direction === 1) {
                    lastContent = document.querySelector(`.main .bg.step-1`)
                    lastContent_gift = document.querySelector(`.main .step-gift.step-1`)
                    $('.fixed-container').css('z-index', 10005)
                    $('.fixed-container').css('opacity', 1)
                    $('.fixed-container').css('background', 'transparent')
                    return
                }
                newContent = 1
                $(`.timeLine .step-1`).addClass('active')
                $(`.timeLine .step-4,.timeLine .step-3, .timeLine .step-2`).removeClass('active')

                $(`.step-gift.step-1`).addClass('active')
                $(`.step-gift.step-2,.step-gift.step-3,.step-gift.step-4`).removeClass('active')
            } else if (v.progress > 0.25 && v.progress <= 0.5) {
                newContent = 2
                $(`.timeLine .step-1,.timeLine .step-2`).addClass('active')
                $(`.timeLine .step-4,.timeLine .step-3`).removeClass('active')

                $(`.step-gift.step-2`).addClass('active')
                $(`.step-gift.step-1,.step-gift.step-3,.step-gift.step-4`).removeClass('active')
            } else if (v.progress > 0.5 && v.progress <= 0.75) {
                newContent = 3
                $(`.timeLine .step-1,.timeLine .step-2,.timeLine .step-3`).addClass('active')
                $(`.timeLine .step-4`).removeClass('active')

                $(`.step-gift.step-3`).addClass('active')
                $(`.step-gift.step-1,.step-gift.step-2,.step-gift.step-4`).removeClass('active')
            } else if (v.progress > 0.75 && v.progress <= 1) {
                newContent = 4
                $(`.timeLine .step-item`).addClass('active')

                $(`.step-gift.step-4`).addClass('active')
                $(`.step-gift.step-1,.step-gift.step-2,.step-gift.step-3`).removeClass('active')
            }
            $(`.timeLine .step-${newContent}`).addClass('active')
            newContent = document.querySelector(`.main .bg.step-${newContent}`)

            if (newContent && (lastContent == null || !newContent.isSameNode(lastContent))) {
                if (lastContent) {
                    lastContent.leave();
                }
                newContent.enter();
                lastContent = newContent;
            }
        }

        if($('.fixed-container').length > 0) {
            let id_url = '';
            if('{{shop.id}}' !== '55005249633') {
                id_url = "https://account.jackery.com"
            } else {
                id_url = 'http://demo-account.jackery.com'
            }
            let uparams = {
                register_act: "welcome_page_register",
                is_new: 0,
                return_url: `${window.location.href}`,
            }
            $('.fixed-container .z-button-fill-middle.register').click(function() {
                window.location.href = `${id_url}/register?uparams=${encodeURIComponent(JSON.stringify({...uparams, is_new: 1}))}`
            })
            $('.fixed-container .z-button-fill-middle.login').click(function() {
                window.location.href = `${id_url}/login?uparams=${encodeURIComponent(JSON.stringify({...uparams, is_new: 0}))}`
            })

        }
</script>

<script type="module">
    $(document).ready(function() {
        if (window.innerWidth > 1024) {
            $(".index-support-item").mouseenter(function () {
            if ($(this).hasClass("active")) return
            $(".index-support-item").removeClass("active")
            $(this).addClass("active")
            })
        } else {
            $(".index-support-item").click(function () {
            var $this = $(this),
                $next = $this.next();

            $next.slideToggle();
            $this.toggleClass('active');

            $(".index-support-item_content_m").not($next).slideUp().prev().removeClass('active');
            })
        }
    })

    var whatCanSwiper = new Swiper("#whatCan .whatCanSwiper", {
        centeredSlides: true,
        spaceBetween: 60,
        slidesPerView: 'auto',
        loop: true,
        autoplay: {
            delay: 7000,
            disableOnInteraction: false
        },
        navigation: {
            nextEl: "#whatCan .whatCanSwiper .swiper-button-next",
            prevEl: "#whatCan .whatCanSwiper .swiper-button-prev",
        },
        pagination: {
            el: "#whatCan .whatCanSwiper .swiper-pagination",
            clickable: true,
        },
    });
</script>
