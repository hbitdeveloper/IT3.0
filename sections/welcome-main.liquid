<div class="image-banner-container">
        <div class="section-container">
            <div class="image-banner-brand-content relative">
                <img class="absolute left-0 top-0"
                    src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016"
                    alt="jackery" loading="lazy">
                <img class="absolute bottom-0 right-0"
                    src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016"
                    alt="jackery" loading="lazy">

                <div class="jky-text-lg font-300">{{section.settings.page_sub_title | newline_to_br}}</div>
            </div>
        </div>
</div>

<div class="main">
        <div class="gift-icon section-container">
            {% render 'responsive-image', image: section.settings.membership_img, mimage: image: section.settings.membership_img, image_class: ''  %}

            <p class="jky-text-sm font-400 text-center">{{section.settings.membership_title | newline_to_br}}</p>
        </div>

        <div class="main-container">
            {% for block in section.blocks %}
                {%- assign class_ = 'bg step-' | append: forloop.index -%}
                {% render 'responsive-image', image: block.settings.image, image_class: class_, mimage: block.settings.m_image, nolazy:'no' %}
            {% endfor %}

            <div class="timeLine">
                {% for block in section.blocks %}
                    {%- assign class_ = 'bg step-' | append: forloop.index -%}
                    <div class="step-item line step-{{forloop.index}} {% if forloop.index0 == 0 %} start active{% endif %}"></div>
                    <div class="step-item point step-{{forloop.index}} active">
                        <div class="num jky-text-xl font-500">{{forloop.index}}</div>
                        <div class="text jky-text-base font-400">{{block.settings.title | escape}}</div>
                    </div>
                    {% if forloop.index == 4 %}
                        <div class="step-item line end step-4"></div>
                    {% endif %}
                {% endfor %}
            </div>

            {% for block in section.blocks %}
                <div class="step-gift step-{{forloop.index}} {% if forloop.index0 == 0 %} active{% endif %}">
                    {% render 'responsive-image', image: block.settings.benefits_icon, image_class: '', mimage: block.settings.benefits_icon %}
                    <div class="step-gift-title jky-text-lg font-bold">{{block.settings.benefits_title}}</div>
                    <div class="step-gift-subtitle jky-text-base font-500">{{block.settings.benefits_subtitle}}</div>
                    <div class="jky-text-base font-400 benefits_des">{{block.settings.benefits_des}}</div>
                </div>
            {% endfor %}
        </div>
</div>

