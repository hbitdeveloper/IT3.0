<style>
  .keyword-img-list {
    padding-bottom: 6.3021vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .keyword-img-list::after {
    content: '';
    flex: auto;
  }
  .keyword-img-list a {
    width: 23.958vw;
    margin-bottom: 1.042vw;
    margin-left: 1.042vw;
    text-align: center;
  }
  @media screen and (max-width: 768px) {
    .keyword-img-list {
      max-width: 100%;
      margin: 0;
    }
    .keyword-img-list a {
      width: 100vw;
      margin-left: 0;
    }
  }
</style>
<div class="keyword-img-list" anchor="{{ section.settings.anchor | escape }}">
  {% for block in section.blocks %}
    <a href="{{block.settings.url}}">
      {% render 'responsive-image', image: block.settings.p_img, mimage: block.settings.m_img, %}
    </a>
  {% endfor %}
</div>
{% schema %}
  {
    "name": "Img List",
    "settings": [
      { "type": "text", "id": "anchor", "label": "锚点定位文案" }
    ],
    "blocks": [
      {
        "type": "keyword-img-list",
        "name": "keyword Img Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "p_img",
            "label": "PC image Width(340px)"
          }, {
            "type": "image_picker",
            "id": "m_img",
            "label": "Mobile image Width(750px)"
          }, {
            "type": "text",
            "id": "img_alt",
            "label": "Image Alt",
            "default": "Image"
          }, {
            "type": "url",
            "id": "url",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Keyword Img List",
        "category": "Keyword"
      }
    ]
  }
{% endschema %}