{%- capture style -%}
    {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<style>
    .earily-bird-p-card--content picture {width: 100%;}
    .early-bird--rich em, .early-bird--rich a:has(em) {
        font-style: normal;
        color: var(--brand-color, var(--jds-color-primary));
    }

    .early-bird-price-tag {
        color: #F98C2C;
        border: solid 1px #F98C2C;
        border-left: none;
    }
    .early-bird-price-tag::before {
        content: '';
        position: absolute;
        top: 0;
        left: -1rem;
        width: 1rem;
        transform: rotate(-50deg);
        height: 1px;
        transform-origin: right center;
        background: #F98C2C;
    }
    .early-bird-price-tag::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: -1rem;
        width: 1rem;
        transform: rotate(50deg);
        height: 1px;
        transform-origin: right center;
        background: #F98C2C;
    }

    .early-bird-price .form-row .form_sub_btn.loading {
        opacity: 1;
        color: transparent;
    }
    .early-bird-price .form-row .form_sub_btn.loading::after {
        display: flex !important;
        content: "LOADING";
        background-color: var(--jds-color-primary);
        border-radius: 9999px;
        opacity: 1;
        color: #fff;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        position: absolute;
        align-items: center;
        justify-content: center;
        z-index: 10;
    }

    .early-bird-price .form-row .form_sub_btn {
        min-width: 9.375rem;
    }

    .early-bird-price .form-item input:not(.blocks-subscribe-banner-form .form-item input) {
        border: solid 1px #cccccc!important;
        border-right: none!important;
    }


    .early-bird-price .jky-checkbox label {
        display: flex;
    }
    .early-bird-price .jky-checkbox-input+span {
        padding: 0 0.375rem;
    }
    .early-bird-price .jky-checkbox-label .jky-agree p {
        font-size: 1rem;
        line-height: 1.5rem;
        color: #666666;
    }
    .early-bird-price .field_error-tips {
        font-size: 0.8125rem;
        color: var(--error-color, red);
        padding-top: 0.25rem;
        position: absolute;
        bottom: -1.05rem;
    }
    .early-bird-price .jky-checkbox-input {
        font-size: 1rem;padding-top: 0.25rem;
    }
    .early-bird-price-content {
        row-gap: 0.375rem;
    }
    .early-bird-subscribe picture {
        width: 50%;
    }
    .early-bird-price .early-bird--product_url {
        border-color: color-mix(in srgb, var(--jds-color-primary), transparent 50%);
    }

    @media screen and (max-width: 1024px) {
        .early-bird-price--title {
            font-size: 1.75rem;
            line-height: 2.25rem;
        }
        .early-bird-price--title:not(.jky-early-bird--unlock .early-bird-price--title) {
            padding-top: 1rem;
            background: #FFFFFF;
        }
        .early-bird-price {
            background: var(--early-bird-bg)!important;
        }

        .early-bird-price .form-item-group {
            gap: 1rem;
            margin-bottom: 1.125rem;
        }
        .early-bird-price .form-item input {
            border-radius: 9999px!important;
            height: 2.75rem;
            padding: 0 1.125rem 0 0.75rem;
        }
        .early-bird-price .form-row .form_sub_btn::after, .early-bird-price .form-row .form_sub_btn::before {
            display: none;
        }
        .early-bird-price .form-row .form_sub_btn {
            height: 2.75rem;
            width: 100%;
            font-size: 0.9375rem;
        }

        .early-bird-price .jky-checkbox-label .jky-agree p {
            font-size: 0.875rem;
            line-height: 1.375rem;
            color: #666666;
            font-weight: 400;
        }
        .early-bird-price .jky-checkbox-input+span {
            padding: 0 0.5rem;
        }
        .early-bird-price .jky-checkbox-inner:after {
            left: 20%;
        }
        .early-bird-price .form-item input:not(.blocks-subscribe-banner-form .form-item input) {
            border-right: solid 1px #cccccc!important;
        }
        .early-bird-price--innner.section-container-lg {
            width: 100%;
        }
        .early-bird-product-list {
            background: var(--early-bird-bg);
        }

        .early-bird-product-card--bottom {
            margin-top: 0.375rem;
        }
        .early-bird-product-card--price_box {
            margin-top: 0.5625rem;
        }
        .early-bird-price-tag::before {
            left: -0.9rem;
            width: 0.9rem;
        }
        .early-bird-price-tag::after {
            left: -0.9rem;
            width: 0.9rem;
        }
        .early-bird-subscribe--img {
            background: var(--early-bird-bg);
            height: 13.125rem;
            box-sizing: content-box;
        }
        .jky-early-bird--unlock .early-bird-subscribe--img {
            padding-bottom: calc(var(--section-padding-bottom-mb) / 32 * 1rem);
        }

        .early-bird-price .form-row_check_box .field_error-tips {
            bottom: -1.8rem;
        }

        .early-bird-price .jky-early-bird--unlock .early-bird-subscribe--success {
            display: none;
        }

        .early-bird-price .form-item input:not(.blocks-subscribe-banner-form .form-item input) {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }

        .jky-early-bird--unlock .early-bird-price--unlock_title {
            display: none!important;
        }

        .jky-early-bird--unlock .early-bird-price {padding-top: 0;}
        .early-bird-price .early-bird-subscribe--success {
            text-align: center;
        }

        .jky-early-bird--unlock .early-bird-subscribe {
            border-radius: 0;
            margin-top: 1rem;
        }
        .early-bird-subscribe:not(.jky-early-bird--unlock .early-bird-subscribe) {
            margin-top: 0;
            border-top-left-radius: 0;
            border-top-right-radius: 0;
        }
        .jky-early-bird--unlock .early-bird-price--innner {
            background: var(--early-bird-bg);
        }
    }
    

    .jky-early-bird--unlock .early-bird-actions, .jky-early-bird--unlock .early-bird-subscribe--success {
        display: flex;
    }
    .jky-early-bird--unlock .early-bird-price--unlock_title {
        display: block;
    }
    .jky-early-bird--unlock .early-bird-price--title, .jky-early-bird--unlock .early-bird-subscribe-lock_form {
        display: none;
    }

    .early-bird-subscribe--success {
        text-align: left;
    }
</style>

{%- assign subs = section.blocks | where: 'type', 'subscribe' -%}
{%- assign products = section.blocks | where: 'type', 'product' -%}
{% assign activity_name_prefix = section.settings.activity_name_prefix | default: '25PF' %}

<jky-early-bird 
    section-id="{{section.id}}"
    data-handle="{{ section.settings.handle }}"
    class="{% if section.settings.type == 'embed' %}embed-component{% endif %}"
>
    <div 
        class="early-bird-price section-padding"
        {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
        style="background: {{section.settings.bg_color | default: 'transparent'}};{{style}};--early-bird-bg: {{section.settings.bg_color | default: 'transparent'}};"
    >
        <div
            class="early-bird-price--innner section-container-lg"
        >   
            {%- if section.settings.heading != blank -%}
                <div 
                    class="early-bird-price--title early-bird--rich lg:text-[2.5rem] lg:leading-[3rem] text-center text-[#1A1A1A] font-medium lg:px-0 px-6"
                >
                    {{ section.settings.heading | replace: "\n", "<br>" | strip}}
                </div>
            {%- endif -%}

            {%- if section.settings.unlock_heading != blank -%}
                <div 
                    class="early-bird-price--unlock_title early-bird--rich text-[1.75rem] leading-9 lg:text-[2.5rem] lg:leading-[3rem] text-center text-[#1A1A1A] font-medium lg:px-0 px-6 hidden"
                >
                    {{ section.settings.unlock_heading | replace: "\n", "<br>" | strip}}
                </div>
            {%- endif -%}

            {%- if section.settings.subheading != blank -%}
                <div class="text-base lg:text-lg text-[#666666] font-medium mt-2 lg:mt-4 text-center hidden lg:block">
                    {{ section.settings.subheading | replace: "\n", "<br>" | strip}}
                </div>
            {%- endif -%}

            <div class="flex flex-col-reverse lg:flex-col">
                {%- for block in subs -%}
                    {%- if block.settings.img_mobile != blank -%}
                            <div class="early-bird-subscribe--img lg:hidden block px-4 overflow-hidden pt-9">
                                {% render 'responsive-image', image: block.settings.img_mobile, image_class: 'w-full object-cover rounded-xl h-full', width: 656, mwidth: 686 %}
                            </div>
                        {%- else -%}
                            <div class="early-bird-subscribe--img lg:hidden block px-4 overflow-hidden pt-9">
                                <img 
                                    class="w-1/2 h-full object-cover hidden lg:block"
                                    src="https://shop.sit-eu.jackery.com/cdn/shop/files/598x387-1_1300x.png?v=1756449174" 
                                    alt
                                />
                            </div>
                        {%- endif -%}
                {%- endfor -%}

                <div class="early-bird-product-list grid lg:grid-cols-4 grid-cols-1 gap-3 lg:gap-5 lg:mt-10 px-4 lg:px-0 pt-6 lg:pt-0">
                    {%- for block in products -%}
                        {% assign block_product = block.settings.product %}
                        {% assign block_img = block.settings.product_img %}
                        {% assign block_title = block.settings.product_title %}
                        {% assign block_product_discount_price = block.settings.product_discount_price %}
                        {% if block.settings.product_discount_price != blank %}
                            {% assign block_product_discount_price = block.settings.product_discount_price | times: 100.00 %}
                        {% endif %}
                        {% assign block_product_origin_price = blank %}

                        {% for variant in block.settings.product.variants %}
                            {% assign vid = variant.id | append: '' %} 
                            {% if vid == block.settings.variant_id %}
                                {% assign block_product = variant %} 
                            {% endif %}
                        {% endfor %}

                        {% if block_img == blank %}
                            {%- if block_product.featured_image != blank -%}
                                {% assign block_img = block_product.featured_image %}
                            {%- else -%}
                                {% assign block_img = block.settings.product.featured_image %}
                            {%- endif -%}
                        {% endif %}

                        {% if block_title == blank %}
                            {% assign block_title = block_product.title %}
                        {% endif %}

                        {% if block_product_discount_price == blank or block_product_discount_price == 0 %}
                            {% assign block_product_discount_price = block_product.price %}
                        {% endif %}

                        {% if block.settings.product != blank %}
                            {% if block_product.compare_at_price != blank and  block_product.compare_at_price > block_product.price %}
                                {% assign block_product_origin_price = block_product.compare_at_price %}
                            {% endif %}
                        {% endif %}


                        <jky-early-bird-card
                            p-discount="{{block.settings.product_discount_price}}"
                            p-discount_type="{{block.settings.discount_show_type}}"
                            {% if block.settings.discount_off != blank %}p-discount_off="{{block.settings.discount_off}}"{% endif %}

                            {% if shop.currency == 'EUR' %}
                                p-sale="{{block_product.price | money_without_currency | replace: '.', '' | replace: ',', '.'}}"
                                p-origin="{{block_product_origin_price | money_without_currency | replace: '.', '' | replace: ',', '.'}}"
                            {% else %}
                                p-sale="{{block_product.price | money_without_currency | replace: ',', ''}}"
                                p-origin="{{block_product_origin_price | money_without_currency | replace: ',', ''}}"
                            {% endif %}
                            
                            pid="{{block_product.id}}" 
                            class="early-bird-product-card overflow-hidden flex flex-col justify-between relative rounded-xl px-4 pb-6 bg-white items-center lg:gap-y-[0.625rem]"
                            {{ block.shopify_attributes }}
                        >
                                <div class="absolute top-2 left-2 lg:w-20 w-[4.25rem] lg:h-20 h-[4.25rem] flex items-center justify-center flex-col">
                                    {%- if block.settings.discount_img != blank -%}
                                        {%- render "responsive-image", 
                                            mimage: block.settings.discount_img, 
                                            image: block.settings.discount_img, 
                                            width: 80, 
                                            mwidth: 68, 
                                            image_class: "object-contain w-full h-full absolute top-0 left-0 z-[1]" 
                                        -%}
                                    {%- else -%}
                                        <img
                                            class="object-contain w-full h-full absolute top-0 left-0 z-[1]"
                                            alt="{{section.settings.heading}}" 
                                            loading="lazy" 
                                            src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2x_ef362fd3-c611-4d8e-9c2e-49b8999eb294.png?v=1756782321" 
                                        />
                                    {%- endif -%}

                                    {%- if block.settings.discount_off != blank -%}
                                        <div class="early_bird_discount__num font-semibold text-white lg:text-lg text-base relative z-[1] opacity-0"></div>
                                        <div class="early_bird_discount__text font-semibold text-white lg:text-xs text-[0.625rem] relative opacity-0 z-[1]">{{block.settings.discount_off}}</div>
                                    {%- endif -%}
                                </div>

                            <div class="earily-bird-p-card--content lg:w-60 w-[13rem] lg:h-60 h-[13rem] flex items-center justify-center relative overflow-hidden">
                                {%- if block_img != blank -%}
                                    {% render "responsive-image", mimage: block_img, image: block_img, width: 242, mwidth: 416, image_class: "object-contain w-full h-full" %}
                                {%- else -%}
                                    <img 
                                        class="object-contain w-full h-full"
                                        src="{{'placeholder.webp' | asset_url}}" 
                                        alt=""
                                    />
                                {%- endif -%}

                                {%- if block_product != blank -%}
                                    <a {% if section.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer" {% endif %} class="absolute z-[2] inset-0 opacity-0" href="{{block_product.url}}"></a>
                                {%- endif -%}
                            </div>

                            <div class="early-bird-product-card--bottom flex flex-col justify-between flex-1 w-full">
                                <div class="early-bird-product-card--title font-medium text-[#1A1A1A] jds-h6 relative line-clamp-2 lg:min-h-14 lg:mb-4">
                                    <span class="line-clamp-2">{{block_title}}</span>
                                    {%- if block_product != blank -%}
                                        <a {% if section.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer" {% endif %} class="absolute z-[2] inset-0 opacity-0" href="{{block_product.url}}"></a>
                                    {%- endif -%}
                                </div>

                                <div class="early-bird-product-card--price_box flex gap-x-6 lg:gap-x-5 items-center">
                                    <span class="text-primary font-semibold text-2xl lg:text-[1.375rem]">
                                        {{block_product_discount_price | money_without_trailing_zeros}}
                                    </span>
                                    {%- if section.settings.discount_tag != blank -%}
                                        <div class="early-bird-price-tag font-medium text_b3 lg:h-7 lg:leading-7 leading-6 px-1 lg:px-0.5 rounded-sm relative h-6">
                                            {{section.settings.discount_tag}}
                                        </div>
                                    {%- endif -%}
                                </div>

                                <div class="early-bird-price-content flex justify-between mt-3 items-center flex-wrap">
                                    <span
                                        class="early-bird-price--sale text_b3 text-[#666666] font-medium"
                                    >{{block_product.price | money_without_trailing_zeros}} {%- if section.settings.origin_price_txt != blank -%}({{section.settings.origin_price_txt}}){%- endif -%}
                                    </span>

                                    {%- if block_product_origin_price != blank -%}
                                        <span class="early-bird-price--origin text_b3 font-medium line-through text-[#999999]">{{block_product_origin_price | money}}</span>
                                    {%- endif -%}
                                </div>

                                <div class="early-bird-actions hidden flex-col gap-y-3 mt-4">
                                    {%- if section.settings.buy_now_txt != blank -%}
                                        <div sold="{{block_product.available}}" data-id="{{block_product.id}}" class="early-bird--buy_now {% if block_product == blank %}opacity-50 pointer-events-none {% endif %} lg:h-9 h-10 rounded-full lg:text-base text-sm flex items-center justify-center text-white bg-primary font-medium border border-transparent border-solid cursor-pointer {% if block_product.available != true %} opacity-50 pointer-events-none{% endif %}">
                                            {% if block_product.available == true %}
                                                {{section.settings.buy_now_txt}}
                                            {% else %}
                                                {{ 'products.product.sold_out' | t }}
                                            {% endif %}
                                        </div>
                                    {%- endif -%}

                                    {%- if section.settings.product_detail_txt != blank -%}
                                        <a href="{{block_product.url}}" {% if section.settings.open_in_new_tab and block_product != blank %} target="_blank" rel="noopener noreferrer" {% endif %} class="{% if block_product == blank or block_product.available != true %}opacity-50 pointer-events-none {% endif %} lg:h-9 h-10 rounded-full lg:text-base text-sm flex items-center justify-center text-primary bg-transparent font-medium border border-primary border-solid cursor-pointer border-opacity-50 early-bird--product_url">
                                            {{section.settings.product_detail_txt}}
                                        </a>
                                    {%- endif -%}
                                </div>
                            </div>
                        </jky-early-bird-card>
                    {%- endfor -%}
                </div>

                {%- for block in subs -%}
                    <div 
                        class="early-bird-subscribe lg:mt-5 mt-2 overflow-hidden rounded-xl bg-white flex h-auto lg:h-56 flex-col lg:flex-row"
                        {{ block.shopify_attributes }}
                    >
                        {%- if block.settings.img != blank -%}
                            {% render 'responsive-image', image: block.settings.img, image_class: 'w-full h-full object-cover hidden lg:block', width: 656, mwidth: 686 %}
                        {%- else -%}
                            <img 
                                class="w-1/2 h-full object-cover hidden lg:block"
                                src="{{'placeholder.webp' | asset_url}}" 
                                alt
                            />
                        {%- endif -%}
                        

                        <div class="early-bird-subscribe-lock_form lg:px-16 px-6 lg:pt-5 pt-0 lg:w-1/2 w-full">
                            {%- if block.settings.heading != blank -%}
                                <div class="lg:text-2xl text-base lg:text-[#1A1A1A] text-[#666666] font-medium text-center lg:mb-[1.375rem] mb-6">{{block.settings.heading | replace: "\n", "<br>" | strip}}</div>
                            {%- endif -%}

                            <jky-form
                                onsubmitcall="pushSuccessMessage(`{{'newsletter.success' | t}}`)"
                                data-unpush
                                jky-form-id="early-bird--{{section.id}}"
                                class="early-bird--form_main subscribe-email subscribe-banner-form_main"
                            >
                                <form data-action="/osconsumerapi/v1/notice/subscribe">
                                <div class="form-container w-full">
                                    <div class="form-row flex flex-col full">
                                    {% comment %} 邮箱 {% endcomment %}
                                    <div 
                                        class="flex w-full group form-item-group mb-6 lg:flex-row flex-col">
                                        <div
                                        class="form-item h-11 lg:h-12 bg-transparent required flex-1 relative lg:-mr-8
                                        "
                                        data-field="input"
                                        style="min-height: unset;"
                                        >
                                        <input
                                            type="email"
                                            id="email"
                                            name="email"
                                            placeholder="{{'newsletter.email_placeholder' | t}}"
                                            data-error="{{'newsletter.email_empty_info' | t}}"
                                            data-value="email"
                                            data-reg="email"
                                            data-regerror="{{'newsletter.email_error_info' | t}}"
                                            class="h-full w-full lg:text-lg text-base font-normal lg:font-medium px-5 lg:px-6
                                            group-[.form-item-group]:rounded-l-full group-[.form-item-group]:rounded-r-none"
                                        >
                                        </div>

                                        <div
                                        class="flex lg:group-[.form-item-group]:w-auto"
                                        >
                                        <button class="form_sub_btn relative z-button-middle text-lg h-full lg:leading-[3rem]
                                            group-[.form-item-group]:font-semibold group-[.form-item-group]:rounded-r-full group-[.form-item-group]:rounded-l-full px-2 lg:px-4"
                                        >{{block.settings.btn_txt}}</button>
                                        </div>
                                    </div>

                                    {% comment %} 隐私协议 {% endcomment %}
                                    <div
                                        class="form-row form-row_check_box flex full lg:mb-6 mb-8"
                                    >
                                        <div
                                        class="form-item required relative"
                                        data-field="check_box"
                                        data-error="{{'newsletter.policy_empty_info' | t}}"
                                        style="min-height: unset;"
                                        >
                                            {% 
                                                render 'jky-formField-checkbox', 
                                                key: block.settings.policy, 
                                                value: 'agree_recevie', 
                                                class: 'text_b3 agree_provicy' 
                                            %}
                                        </div>
                                    </div>

                                    <div style="display: none;" class="form-row flex">
                                        <div class="form-item form-item_const" data-field="input">
                                        <input
                                            type="text"
                                            id="tags"
                                            name="tags"
                                            data-error=""
                                            data-value="tags"
                                            data-reg=""
                                            value="{{activity_name_prefix}}-Subscribe"
                                            data-regerror=""
                                        >
                                        </div>
                                    </div>

                                    <div style="display: none;" class="form-row flex">
                                        <div class="form-item form-item_const" data-field="input">
                                        <input
                                            type="text"
                                            id="newUserTags"
                                            name="newUserTags"
                                            data-error=""
                                            data-value="newUserTags"
                                            data-reg=""
                                            value="{{activity_name_prefix}}-Subscribe-New"
                                            data-regerror=""
                                        >
                                        </div>
                                    </div>

                                    <div style="display: none;" class="form-row flex">
                                        <div class="form-item form-item_const" data-field="input">
                                        {%- assign pageUrlWithHost = content_for_header | split:'"pageurl":"' | last | split:'"' | first | replace:'\/','/' | replace:'%20',' ' | replace:'\u0026','&' -%}
                                        <input type="text" id="pageUrl" name="pageUrl" data-value="pageUrl" value="{{pageUrlWithHost}}">
                                        </div>
                                    </div>

                                    <div style="display: none;" class="form-row flex">
                                        <div class="form-item form-item_const" data-field="input">
                                            <input type="text" id="propertyName" name="propertyName" data-value="propertyName" value="discountType">
                                        </div>
                                    </div>

                                    <div style="display: none;" class="form-row flex">
                                        <div class="form-item form-item_const" data-field="input">
                                            <input type="text" id="propertyValue" name="propertyValue" data-value="propertyValue" value="{{activity_name_prefix}} Unlock">
                                        </div>
                                    </div>

                                    </div>
                                </div>
                                </form>
                            </jky-form>
                        </div>
                        
                            <div class="early-bird-subscribe--success lg:px-14 px-6 lg:pt-6 pt-7 lg:pb-6 pb-8 hidden items-center justify-center text-lg lg:text-2xl text-[#1A1A1A] font-medium lg:text-left text-center lg:w-1/2 w-full">
                                {%- if block.settings.unlock_heading != blank -%}
                                    {{block.settings.unlock_heading | replace: "\n", "<br>" | strip}}
                                {%- endif -%}
                            </div>
                    </div>
                {%- endfor -%}
            </div>
        </div>
    </div>

    <script type="application/json">
        {

        }
    </script>
</jky-early-bird>

<script>
    if (!customElements.get("jky-early-bird-card")) {
        class JkyEarlyBirdCard extends HTMLElement {
            constructor() {
                super();
                this.discountPrice = Number(this.getAttribute("p-discount")) || 0
                this.salePrice = Number(this.getAttribute("p-sale").replace(/\s/g, '')) || 0
                this.originPrice = Number(this.getAttribute("p-origin")) || 0
                this.discountType = this.getAttribute("p-discount_type")
                this.discountOff = this.getAttribute("p-discount_off") || false

                this.selectors = {
                    discount: this.querySelector(".early_bird_discount__num"),
                    discount_text: this.querySelector(".early_bird_discount__text"),
                    buy: this.querySelector(".early-bird--buy_now")
                }
            }

            connectedCallback() {
                this.discountOff && this.handleDiscount(this.discountType)

                this.selectors.buy && this.selectors.buy.addEventListener("click", async () => {
                    if(!this.selectors?.buy?.getAttribute("data-id")) return
                    const params = {
                        id: this.selectors?.buy?.getAttribute("data-id"),
                        quantity: 1,
                        properties: {}
                    }
                    const checkoutUrl = await createCartAndCheckout([params])
                    if(checkoutUrl) {
                        window.location.href = checkoutUrl
                    } else {
                        window.location.href = `${window.location.origin}/cart/${params.id}:1`
                    }
                })
            }

            handleDiscount(type = 'percent') {
                const _sale = this.discountPrice ? this.discountPrice : this.salePrice
                const _origin = this.originPrice ? this.originPrice : this.salePrice
                let res = ''
                if(type === 'percent') {
                    if(_origin) {
                        res = Math.floor((_origin - _sale) / _origin * 100) + '%'
                    } else {
                        res = '0%'
                    }
                } else {
                    if(pageInfo.currency.currency === 'EUR') {
                        res = formatMoney(Math.floor(_origin - _sale) * 100, pageInfo.currency.money_format).replace(',00', '')
                    } else {
                        res = formatMoney(Math.floor(_origin - _sale) * 100, pageInfo.currency.money_format).replace('.00', '')
                    }
                }
                this.selectors.discount.textContent = res
                this.selectors.discount.classList.remove("opacity-0")
                this.selectors.discount_text.classList.remove("opacity-0")
            }
        }
        customElements.define('jky-early-bird-card', JkyEarlyBirdCard);
    }

    if (!customElements.get("jky-early-bird")) {
        class JkyEarlyBird extends HTMLElement {
            constructor() {
                super();
                this.sid = `early-bird--` + this.getAttribute("section-id");

                this.selector = {

                }
            }

            connectedCallback() {
                this.getConfig();

                document.addEventListener('jkyFormSubmitEvent', (e) => {
                    const {id} = e.detail
                    if(id === this.sid) {
                        this.handleCache()
                    }
                })

                if(this.checkCache()) {
                    this.classList.add("jky-early-bird--unlock")
                }
            }

            handleProductsDiscouunt() {
                let that = this
                const products = this.querySelectorAll("jky-early-bird-card")
                products.forEach(card => {
                    card.handleDiscount && card.handleDiscount('percent')
                })
            }

            getConfig() {
                this.config = this.config || JSON.parse(this.querySelector('[type="application/json"]').textContent);
                return this.config;
            }

            handleCache() {
                const now = new Date();
                const item = {
                    value: 'subscribed',
                    expiry: now.getTime() + 86400000
                };
                localStorage.setItem(`{{activity_name_prefix}}-Subscribe`, JSON.stringify(item));
                this.classList.add("jky-early-bird--unlock");
            }

            checkCache() {
                const _cache = localStorage.getItem(`{{activity_name_prefix}}-Subscribe`);
                if(!_cache) return false
                const _cache_params = JSON.parse(_cache);
                const now = new Date();
                if (now.getTime() > _cache_params.expiry) {
                    localStorage.removeItem(`{{activity_name_prefix}}-Subscribe`);
                    return false;
                }
                return true
            }
        }

        customElements.define('jky-early-bird', JkyEarlyBird);
    }
</script>

