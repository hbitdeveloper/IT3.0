<style>
    .product-text-wrap .text-box {justify-content: space-between;}
    .product-text-wrap .product-text-wrap-main {max-width:80%;color: var(--text-black);}
    .product-text-wrap .product-text-wrap-main .text-box-title {padding-bottom: 16px;}
    .product-text-wrap .product-text-wrap-main .text-box-title em, .product-text-wrap .product-text-wrap-main .text-box-title strong, .product-text-wrap .product-text-wrap-main .text-box-title b {color: var(--primary-color);}
    @media screen and (max-width: 1024px) {
        .product-text-wrap {padding: var(--p-detail-t) 0;}
    }
</style>

<div {% if section.settings.anchor != blank %} data-anchor="{{section.settings.anchor}}" {% endif %} class="product-text-wrap section-container relative product-b {% if section.settings.section_type %} product-p-t{% endif %}">
  <div class="text-box flex content-between">
    <img class="left-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016" alt="jackery symbol" loading="lazy">
    <div class="jky-text-base product-text-wrap-main">
        {%- if section.settings.feature_title != blank -%}
            <h2 class="text-box-title">{{ section.settings.feature_title | replace: '<p>', '<p class="jky-text-2xl font-bold text-center">' }}</h2>
        {%- endif -%}

        {%- if section.settings.feature_intro != blank -%}
            <div class="text-box-intro">{{ section.settings.feature_intro }}</div>
        {%- endif -%}
    </div>
    <img class="right-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016" alt="jackery symbol" loading="lazy">
  </div>
</div>

{% schema %}
{
    "name": "product video and text",
    "class": "product-video-text-wrap product-section-block",
    "tag": "div",
    "enabled_on": {
      "templates": ["product"]
    },
    "settings": [
        {
          "type": "checkbox",
          "id": "section_type",
          "default": false,
          "label": "是否为大版块？",
          "info": "大版块与上一个模块之间间距大，小版块与上一模块间距较小"
        },
        {
            "type": "select",
            "id": "anchor",
            "label": "锚点设置",
            "info": "非锚点section请清空此项",
            "options": [
                {
                "value": "",
                "label": "非锚点section"
                },
                {
                "value": "anchor__1",
                "label": "第一个section锚点"
                },
                {
                "value": "anchor__2",
                "label": "第二个section锚点"
                },
                {
                "value": "anchor__3",
                "label": "第三个section锚点"
                },
                {
                "value": "anchor__4",
                "label": "第四个section锚点"
                }
            ],
            "default": ""
        },
        {
            "type": "richtext", "id": "feature_title", "label": "feature title",
            "default": "<p>BMS: <em>12 Levels</em> Safet Gurantee</p>"
        },
        {
            "type": "textarea", "id": "feature_intro", "label": "feature intro",
            "default": "Jackery Solar Generator 1000 Pro is the good choice for camping. It can charge almost all small and large electric appliances, including electric blankets, cooking appliances, etc., and ensure you enjoy your camping to the fullest."
        }
    ],
    "presets": [{
        "name": "product video and text"
    }]
}
{% endschema %}