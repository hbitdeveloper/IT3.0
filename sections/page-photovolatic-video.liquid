<section style="width:100%;">
  {% render
    "diy-video",
      pcPoster: section.settings.poster_pc,
      pcUrl: section.settings.video_pc_url,
      mbPoster: section.settings.poster_mb,
      mbUrl: section.settings.video_mb_url,
      autoplay: section.settings.autoplay,
      loop: section.settings.loop,
      controls: section.settings.controls,
  %}
</section>

{% schema %}
  {
    "name": "photovolatic Video",
    "class": "section-photovolatic section-photovolatic-video",
    "settings": [
      { "type": "image_picker", "id": "poster_pc", "label": "封面图片（PC）"},
      { "type": "url", "id": "video_pc_url", "label": "视频地址（PC）", "info": "本地视频建议视频大小不超过10MB"},
      { "type": "image_picker", "id": "poster_mb", "label": "封面图片（Mobile）"},
      { "type": "url", "id": "video_mb_url", "label": "视频地址（Mobile）", "info": "本地视频建议视频大小不超过10MB"},
      
      { "type": "checkbox", "id": "autoplay", "label": "自动播放？", "default": true },
      { "type": "checkbox", "id": "loop", "label": "循环播放？", "default": true },
      { "type": "checkbox", "id": "controls", "label": "显示播放控件？", "default": false }
    ]
  }
{% endschema %}
