<style>
    .jky-ces-animate .themepoint-container{
        background: url({{section.settings.pc_image | image_url: width: 1920}});
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center center;
    }
    @media screen and (max-width: 1024px) {
        .jky-ces-animate .sec-content--mb .sec-content--main{
            background: url({{section.settings.mb_image  | image_url: width: 750 }});
            background-size: cover;
        }
    }
</style>

<div class="jky-ces-animate">
    <div class="sec-content">
        <div class="themepoint-container">
            {%- for block in section.blocks -%}
                {%- if block.settings.scroll_content != blank -%}
                    <div class="theme-pt1 theme-item {%if forloop.index == 1%} show{%endif%}">
                        {%- if block.settings.scroll_title != blank -%}
                            <div class="small_text text_primary">{{block.settings.scroll_title | escape}}</div>
                        {%- endif -%}
                        <div class="scroll-item-content">{{block.settings.scroll_content | newline_to_br}}</div>
                    </div>
                {%- endif -%}
            {%- endfor -%}
        </div>
        <div class="space-100vh">
            {%- for block in section.blocks -%}  
                {%- if block.settings.scroll_content != blank -%}
                    <div class="trigger-ele" style="flex: 1;"></div>
                {%- endif -%}                     
            {%- endfor -%}
        </div>
    </div>
    <div class="sec-content--mb">
        <div class="sec-content--main">
            <div class="content" >
                {%- for block in section.blocks -%}
                    {%- if block.settings.scroll_mb != blank -%}
                        <div class="cont" style="font-size: {{ block.settings.scroll_mb_font_size }}px">
                            {{block.settings.scroll_mb}}
                        </div>
                    {%- endif -%}
                {%- endfor -%}
            </div>
        </div>
    </div>
</div>
<script src="{{ 'scrollTrigger.js' | asset_url }}" defer></script>
<script src="{{ 'gsap.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "JKY CES 2024",
    "settings": [
        { "type": "image_picker", "id": "pc_image", "label": "PC图(1920*1080)"},
        { "type": "image_picker", "id": "mb_image", "label": "MB图(702*1049)"}
    ],
    "blocks": [
        {
            "type": "scroll_content",
            "name": "滚动介绍",
            "limit": 5,
            "settings": [
                {"type": "text", "id": "scroll_title", "label": "介绍标题", "default": "Founded in"},
                {"type": "richtext", "id": "scroll_content", "label": "介绍内容"},
                {"type": "richtext", "id": "scroll_mb", "label": "介绍 MB内容"},
                { "type": "range", "id": "scroll_mb_font_size", "min": 12, "max": 100, "step": 1, "unit": "px", "label": "移动端文字大小", "default": 22 }
            ]
        }
    ]
  }
{% endschema %}