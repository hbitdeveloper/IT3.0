<style>
    .shopify-section.jky-header,
    header-v5 {
        position: relative!important;
    }
    .canvas-container {margin-top: -100vh;}


    .banner-container {
    background-color: #EBEBED;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    height: calc(100vh + 500px);
    position: relative;
    z-index: 2;
    }
    .solar-mars-bot-kv {
    position: relative;
    background: #fff;
    z-index: 2;
    }
    .banner-container .container {
    height: 100vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    }
    .banner-container img {
    width: 1200px;
    object-fit: contain;
    }
    .second-container {
    min-height: 200vh;
    }
    .bg-block {
    height: 100vh;
    position: fixed;
    top: 0;
    width: 100vw;
    }
    .bg-block .content-img {
    width: 1200px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    }
    .bg-block .bg {
    position: absolute;
    top: 0;
    left: 0;
    height: 100vh;
    width: 100vw;
    object-fit: fill;
    }
    .bg--1 {
    z-index: 2;
    }
    .second-content {
    min-height: 50vh;
    margin-top: 100vh;
    position: relative;
    z-index: 2;
    }
    .second-content ul {
    margin: 0 auto;
    width: 960px;
    padding: 2vh 0;
    font-weight: 600;
    font-size: 72px;
    line-height: 88px;
    letter-spacing: -1px;
    position: relative;
    z-index: 2;
    }
    .second-content ul li {
    color: var(--jds-color-primary);
    transition: color 0.3s ease;
    opacity: 0.3;
    }
    .second-content ul li[data-title] {
        font-size: 88px;
        line-height: 96px;
        margin: 24px 0;
    }
    .second-content ul li:first-child {
        margin-top: 0!important;
    }
    .second-content ul li:last-child {
        margin-bottom: 0!important;
    }
    #hero-lightpass {
    width: 100vw;
    height: auto;
    margin: 0 auto;
    }
    .pc-hide,
    .mb-action {
    display: none;
    }
    @media screen and (max-width: 1024px) {
    .banner-container {
        align-items: flex-start;
        height: calc(100vh + 250px);
    }
    .second-content ul li[data-title] {
        font-size: 40px;
        line-height: 48px;
        margin: 12px 0;
    }
    .banner-container .container {
        height: 100vh;
        align-items: center;
    }
    .banner-container img {
        width: 82.9333vw;
    }
    .second-container {
        min-height: 100vh;
    }
    .bg-block .content-img {
        width: 82.9333vw;
        text-align: center;
        font-weight: 600;
        color: var(--jds-color-primary);
        font-size: 9.8vw;
        letter-spacing: -0.53333vw;
        line-height: 16.53333vw;
        text-transform: uppercase;
        overflow: hidden;
    }
    .m-hide {
        display: none;
    }
    .pc-hide {
        display: block;
    }
    .bg-block .bg {
        position: absolute;
        top: 0;
        left: 0;
        height: 100vh;
        width: 100vw;
        object-fit: cover;
    }
    .second-content {
        min-height: 50vh;
    }
    .second-content ul {
        margin: 0 auto;
        width: 82.9333vw;
        padding: 2vh 0;
        font-size: 7.46666vw;
        line-height: 9.6vw;
    }
    #hero-lightpass {
        width: 100vw;
        height: 100vh;
        margin: 0 auto;
    }
    .mb-action {
        display: block;
        position: absolute;
        bottom: 10.6vw;
        left: 50%;
        width: 83.46666vw;
        transform-origin: center center!important;
        height: 16vw;
        border-radius: 4vw;
        overflow: hidden;
        backdrop-filter: blur(7px);
        background-color: rgba(255, 255, 255, 0.4);
        box-shadow: inset 0 0 1px rgba(0, 0, 0, 0.11);
    }
    .mb-action input[type="range"] {
        -webkit-appearance: none;
        width: 100%;
        height: 100%;
        margin: 0;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 2;
        background: transparent;
        outline: 0;
        border: 0;
        opacity: 0;
    }
    .mb-action input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        display: block;
        width: 48px;
        height: 48px;
        background-color: transparent;
    }
    .mb-action input[type="range"]::-moz-range-thumb {
        display: block;
        width: 48px;
        height: 48px;
        background: transparent;
        border: 0;
    }
    .mb-action input[type="range"]::-moz-range-track {
        background: transparent;
        border: 0;
    }
    .mb-action input[type="range"]::-moz-focus-outer {
        border: 0;
    }
    .mb-action .jk-seekbar-progress {
        height: 16vw;
        position: relative;
        z-index: 1;
        margin: 0 6vw;
    }
    .mb-action .jk-seekbar-progress [role="progressbar"] {
        height: 100%;
        position: relative;
        background: transparent;
        border-radius: 6px;
        box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.15);
    }
    .mb-action .jk-seekbar-progress [role="progressbar"]:after {
        content: " ";
        display: block;
        width: 0.8vw;
        position: absolute;
        top: 2.4vw;
        bottom: 2.4vw;
        right: -0.4vw;
        background-color: var(--primary-color);
        border-radius: 0.4vw;
    }
    .mb-action .progress-list {
        position: absolute;
        left: 0;
        right: 0;
        width: 100%;
        padding: 0 6vw;
        height: 5.7333vw;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        justify-content: space-between;
        z-index: 1;
    }
    .mb-action .progress-list li {
        width: 0.5333vw;
        height: 100%;
        opacity: 1!important;
    }
    .mb-action .progress-list li::after {
        content: '';
        display: block;
        height: 100%;
        width: 0.5333vw;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.6);
    }
    }
    .demo-boxx {
    background-color: skyblue;
    height: 50px;
    width: 80vw;
    left: 50%;
    position: absolute;
    transform: translate(-50%, 0px);
    top: 0;
    }
</style>

<div class="bg-block">
    <img class="content-img m-hide" src="{{section.settings.big_title_img | image_url: width: 2000}}" alt="{{section.settings.big_title_img.alt | escape}}">
    <div class="content-img pc-hide">{{section.settings.title | escape}}</div>

    <img class="bg bg--1" src="{{section.settings.bg_1 | image_url: width: 2000}}" alt="{{section.settings.bg_1.alt | escape}}">
    <img class="bg bg--2" src="{{section.settings.bg_2 | image_url: width: 2000}}" alt="{{section.settings.bg_2.alt | escape}}">
</div>

<div class="second-content">
    <ul class="scroll_ul">
        {%- for block in section.blocks -%}
            <li class="text_{{forloop.index}}" {% if block.settings.is_heading == true %}data-title{% endif %}>{{block.settings.heading | escape}}</li>
        {%- endfor -%}
    </ul>

    <div class="canvas-container relative">
        <div>
            <img class="ert--img" style="height: 100vh;width:100vw;object-fit: fill;opacity: 0;" src="//shop.sit-eu.jackery.com/cdn/shop/files/2_2x_e4a690cc-7b4e-4eae-808b-2b4b56e4172e.png?v=1735106710" alt="">
        </div>
        <div class="cvs-box relative">
            <canvas id="hero-lightpass"></canvas>
            <div class="mb-action">
                <input type="range" value="0" min="0.5" max="99.9" />
                <div class="jk-seekbar-progress">
                    <div role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width: 0%;"></div>
                </div>

                <ul class="progress-list">
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                    <li></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script src="{{ 'CustomEase.js' | asset_url }}"></script>
<script>
    $(document).ready(function() {


    gsap.registerPlugin(ScrollTrigger);
    gsap.registerPlugin(CustomEase)

    const mb_range = document.querySelector('.cvs-box input[type="range"]')
    const progressbar = document.querySelector('.cvs-box div[role="progressbar"]')
    let f_key

    function isMobile() {
        return window.matchMedia('(max-width: 1024px)').matches
    }

    ScrollTrigger.create({
        trigger: '.banner-container .container',
        start: 'top top',
        end: `+=${isMobile() ? 500 / 2 : 500}`,
        ease: 'none',
        pin: true,
    })

    // 背景切换
    ScrollTrigger.create({
        trigger: '.second-content',
        animation: gsap.to(
            '.bg--1',
            {opacity: 0}
        ),
        start: 'top bottom',
        end: 'top top',
        ease: 'none',
        scrub: 0
    })

    ScrollTrigger.create({
        trigger: '.ert--img',
        start: 'top top',
        end: `+${window.innerHeight}`,
        scrub: 1, // I like the 1 sec delay, set to true for exact anime on scroll
        onLeave: function() {
            document.querySelector(".ert--img").style.opacity = 1
            document.querySelector(".bg--2").style.opacity = 0
        },
        onEnterBack: function() {
            document.querySelector(".ert--img").style.opacity = 0
            document.querySelector(".bg--2").style.opacity = 1
        },
    })

    // 大文字动效
    const tl = gsap.timeline().to('.bg-block .content-img', {opacity: 0, y: -240})
    ScrollTrigger.create({
        trigger: '.second-content',
        animation: tl,
        start: 'top bottom',
        end: '+=150',
        scrub: 0,
        ease: 'none'
    })

    // 文字高亮切换
    const text_item = document.querySelectorAll('.second-content ul.scroll_ul li')
    ScrollTrigger.create({
        trigger: '.second-content ul',
        start: 'top center',
        end: `bottom center`,
        scrub: 0,
        onLeave: function(self) {
            $(text_item).css('opacity', 0.3)
        },
        onLeaveBack: function(self) {
            $(text_item).css('opacity', 0.3)
        },
        onUpdate: function(self) {
            var progress = self.progress.toFixed(2);
            text_item.forEach(function(line, index) {
                const step = 1 / text_item.length
                if(progress >= index * step && progress < step * (index + 1)) {
                    $(text_item).css('opacity', 0.3)
                    $(line).css('opacity', 1)
                }
            });
        },
        ease: 'none'
    })


    // 滚动播放
    function keyFramesPlay() {
        const canvas = document.getElementById("hero-lightpass");
        const context = canvas.getContext("2d");
        canvas.width = isMobile() ? 750 : 1920;
        canvas.height = isMobile() ? 1500 : 1080;
        const frameCount = isMobile() ? {{section.settings.capture_num_mb}} : {{section.settings.capture_num}};
        let action_tl

        const currentFrame = index => (
            isMobile() ? `{{section.settings.capture_img_mb}}${(index + 1).toString()}.jpg` : `{{section.settings.capture_img}}${(index + 1).toString()}.jpg`
        );

        const images = []
        const airpods = {
            frame: 0
        };

        for (let i = 0; i < frameCount; i++) {
            const img = new Image();
            img.src = currentFrame(i);
            images.push(img);
        }

        if(isMobile()) {
            action_tl = gsap.timeline({ paused: true });
            action_tl
                    .fromTo('.mb-action', { y: 50, x: '-50%', opacity: 0, borderRadius: '40px' }, {y: 0, x: '-50%', opacity: 1, duration: 0.2, borderRadius: '40px', ease: CustomEase.create("custom", "M0,0 C0.843,0 0.499,1 1,1 ")})
                    .fromTo('.progress-list, .mb-action input[type="range"], .jk-seekbar-progress', {scale: 0}, {scale: 1, ease: CustomEase.create("custom", "M0,0 C0.843,0 0.499,1 1,1 ")})
                    .fromTo('.mb-action', {width: '16vw', borderRadius: '8vw'}, {width: '83.46666vw', borderRadius: '4vw', ease: CustomEase.create("custom", "M0,0 C0.843,0 0.499,1 1,1 ")}, '<')
            action_tl.reverse()
        }

        f_key = ScrollTrigger.create({
            trigger: '.cvs-box',
            start: 'top top',
            end: `+=500`,
            scrub: 0,
            ease: 'none',
            pin: true,
            onEnter: function(self) {
                progressbar.style.width = '0%';
                progressbar.setAttribute('aria-valuenow', 0);
                isMobile() && action_tl.play()
            },
            onLeave: function(self) {
                isMobile() && action_tl.reverse()
            },
            onEnterBack: function(self) {
                progressbar.style.width = '0%';
                progressbar.setAttribute('aria-valuenow', 0);
                isMobile() && action_tl.play()
            },
            onLeaveBack: function(self) {
                isMobile() && action_tl.reverse()
            },
            onUpdate: function(self) {
                var progress = self.progress.toFixed(2);
                var currentIndex = Math.floor(progress * frameCount);
                airpods.frame = currentIndex >= frameCount - 1 ? frameCount -1 : currentIndex
                render()

                if(progress == 1) {
                    $(".bg-block").css('z-index', '-1')
                } else {
                    $(".bg-block").css('z-index', '0')
                }

                progressbar.style.width = progress * 100 + '%';
                progressbar.setAttribute('aria-valuenow', progress * 100);
            }
        })

        images[0].onload = render;

        function render() {
            context.clearRect(0, 0, canvas.width, canvas.height);
            try {
                context.drawImage(images[airpods.frame], 0, 0);
            } catch (error) {
                console.error(error)
            }
        }
    }

    // MB progress
    isMobile() && mb_range.addEventListener('input', function () {
        progressbar.style.width = this.value + '%';
        progressbar.setAttribute('aria-valuenow', this.value);
        f_key.scroll(f_key.start + this.value / 100 * (f_key.end - f_key.start))
    });

    keyFramesPlay()
    })
</script>

{% schema %}
{
    "name": "Sunflower Light",
    "tag": "section",
    "class": "second-container",
    "settings": [
        {"type": "text", "id": "title", "label": "Heading", "default": "Sunflower Light Tracking"},
        {"type": "image_picker", "id": "big_title_img", "label": "PC端大标题图片", "info": "建议尺寸：1200 * 257 二倍图"},
        {"type": "image_picker", "id": "bg_1", "label": "过渡背景-大标题部分", "info": "1920 * 1080 二倍图"},
        {"type": "image_picker", "id": "bg_2", "label": "过渡背景-滚动文本部分", "info": "1920 * 1080 二倍图"},
        {"type": "text", "id": "subheading", "label": "SubHeading", "default": "A powerful light-tracking sensor accurately locates the best sunlight irradiation angle. Both the wheels and solar panels automatically rotate towards the sun, canrealizing instant position tracking and fast power storage."},
        {"type": "text", "id": "capture_img", "label": "背景序列图片 JPG", "default": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/sunflower_light_track_"},
        {"type": "text", "id": "capture_num", "label": "背景序列图片总数", "default": "16"},
        {"type": "text", "id": "capture_img_mb", "label": "MB背景序列图片 JPG", "default": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/sunflower_light_track_mb_"},
        {"type": "text", "id": "capture_num_mb", "label": "MB背景序列图片总数", "default": "10"}
    ],
    "blocks": [
        {
            "type": "scroll_item",
            "name": "滚动文本",
            "limit": 15,
            "settings": [
                { "type": "text", "id": "heading", "label": "标题" },
                {
                    "type": "checkbox",
                    "id": "is_heading",
                    "default": false,
                    "label": "是否为标题项？"
                }
            ]
        },
    ]
}
{% endschema %}
