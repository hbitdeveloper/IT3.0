<link rel="stylesheet" href="{{ 'apply-activity-template.min.css' | asset_url }}">

<div class="keyword-subsrcipt" anchor="{{ section.settings.anchor | escape }}">
  {% render 'activity-subscript', settings: section.settings %}
</div>

{% schema %}
    {
      "name": "Keyword Subsrcipt",
      "settings": [
        { "type": "text", "id": "anchor", "label": "锚点定位文案" },
        { "type": "select", "id": "pc_position", "label": "PC端位置",
          "options": [
            { "value": "left_pc", "label": "居左" },
            { "value": "right_pc", "label": "居右" }
          ], "default": "left_pc"

        },
        { "type": "select", "id": "mb_position", "label": "移动端位置",
          "options": [
            { "value": "top_mb", "label": "居上" },
            { "value": "bottom_mb", "label": "居下" }
          ], "default": "bottom_mb"
        },
        { "type": "text",  "id": "klaviyo_id", "label": "绑定Klaviyo的List对象ID" },
        { "type": "text",  "id": "subscript_tag", "label": "来源标签" },
        { "type": "image_picker", "id": "pc_image", "label": "PC图片(必填)", "info": "大小: 1920*640" },
        { "type": "image_picker", "id": "mb_image", "label": "MB图片(必填)", "info": "大小: 750x1416" },
        { "type": "richtext", "id": "title_main", "label": "PC主标题(不超过25字符)" },
        { "type": "richtext", "id": "title_main_mb", "label": "MB主标题(不超过25字符)" },
        { "type": "color", "id": "title_main_color", "label": "主标题突出文案颜色", "default": "#FFFFFF" },
        { "type": "color", "id": "title_main_color_pc", "label": "主标题文案颜色(PC)", "default": "#FFFFFF" },
        { "type": "color", "id": "title_main_color_mb", "label": "主标题文案颜色(MB)", "default": "#FFFFFF" },
        { "type": "number", "id": "font","label": "主标题字号(PC)","default": 16, "info": "默认值为16px"},
        { "type": "number", "id": "font_mb","label": "主标题字号(MB)","default": 28, "info": "默认值为28px"},

        { "type": "richtext", "id": "sub_title", "label": "PC副标题(不超过70字符)" },
        { "type": "richtext", "id": "sub_title_mb", "label": "MB副标题(不超过70字符)" },
        { "type": "color", "id": "sub_title_main_color", "label": "副标题突出文案颜色", "default": "#FFFFFF" },
        { "type": "color", "id": "sub_title_main_color_pc", "label": "副标题文案颜色(PC)", "default": "#FFFFFF" },
        { "type": "color", "id": "sub_title_main_color_mb", "label": "副标题文案颜色(MB)", "default": "#FFFFFF" },
        { "type": "number", "id": "sub_font","label": "副标题字号(PC)","default": 48, "info": "默认值为48px"},
        { "type": "number", "id": "sub_font_mb","label": "副标题字号(MB)","default": 40, "info": "默认值为40px"},
        { "type": "richtext", "id": "des_title", "label": "PC描述(不超过70字符)" },
        { "type": "richtext", "id": "des_title_mb", "label": "MB描述(不超过70字符)" },
        { "type": "color", "id": "des_title_main_color", "label": "描述突出文案颜色", "default": "#FFFFFF" },
        { "type": "color", "id": "des_title_main_color_pc", "label": "描述文案颜色(PC)", "default": "#FFFFFF" },
        { "type": "color", "id": "des_title_main_color_mb", "label": "描述文案颜色(MB)", "default": "#FFFFFF" },
        { "type": "number", "id": "des_font","label": "描述字号(PC)","default": 20, "info": "默认值为20px"},
        { "type": "number", "id": "des_font_mb","label": "描述字号(MB)","default": 32, "info": "默认值为32px"},
        { "type": "color", "id": "subsribe_icon", "label": "订阅模块内文案及icon颜色", "default": "#FFFFFF" },
        { "type": "color_background", "id": "subcribe_bg_color", "label": "订阅模块背景色", "default": "rgba(0, 0, 0, 0.3)" },
        { "type": "richtext", "id": "subcribe_title", "label": "订阅模块标题" },
        { "type": "text", "id": "subcribe_btn", "label": "订阅按钮文本" },
        { "type": "text", "id": "loading_btn", "default": "LOADING", "label": "加载中文案" },
        { "type": "richtext", "id": "privacy_policy", "label": "Privacy Policy" },
        { "type": "text", "id": "winner_btn", "default": "Winner List >", "label": "获奖名单按钮文案" },
        { "type": "text", "id": "subscription_header", "label": "订阅提示header文案" },
        { "type": "richtext", "id": "subscription_tip", "label": "订阅提示文案" },
        { "type": "text", "id": "winner_header", "label": "获奖列表header文案" },
        { "type": "richtext", "id": "winner_list", "label": "获奖列表list文案" }
      ],
    
      "presets": [
        {
          "name": "Keyword Subsrcipt",
          "category": "Keyword"
        }
      ]
    }
    {% endschema %}