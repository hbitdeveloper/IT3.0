<style>
    .index-operating{
        padding-top:{{ section.settings.pc_padding_top }}px;
        padding-bottom:{{ section.settings.pc_padding_bottom }}px;
    }
    .index-operating .title{
        font-size: {{ section.settings.pc_title_size }}px;
    }
    .index-operating .introduction-subtitle{
        font-size: {{ section.settings.pc_subtitle_size }}px;
    }
    @media screen and (min-width: 1024px) and (max-width: 1439.98px){
        .index-operating{
            padding-top: calc( {{ section.settings.pc_padding_top }}  * 100vw / 1440 );
            padding-bottom: calc( {{ section.settings.pc_padding_bottom }}  * 100vw / 1440 );
        }
        .index-operating .title{
            font-size: calc( {{ section.settings.pc_title_size }}  * 100vw / 1440 );
        }
        .index-operating .introduction-subtitle{
            font-size: calc( {{ section.settings.pc_subtitle_size }}  * 100vw / 1440 );
        }
    }
    @media screen and (max-width: 1023.98px){
        .index-operating{
            padding-top: calc( {{ section.settings.mb_padding_top }}  * 100vw / 750 );
            padding-bottom: calc( {{ section.settings.mb_padding_bottom }}  * 100vw / 750 );
        }
        .index-operating .title{
            font-size: calc( {{ section.settings.mb_title_size }}  * 100vw / 750 );
        }
        .index-operating .introduction-subtitle{
            font-size: calc( {{ section.settings.mb_subtitle_size }}  * 100vw / 750 );
        }
    }
    .index-operating {
        --blogs-m: 72px 0;
        --blogs-p: 0px 40px;
        --operating-p: 0px 40px;
        --operating-module-title: 32px;
        --operating-module-title-lh: 40px;
        --operating-module-title-mb: 24px;
    }
    .index-operating .new-main-container{
        width: 1440px;
        margin: 0 auto;
    }
    .index-operating .video-pc-block {
        display: flex !important;
    }
    .index-operating .video-mb-block {
        display: none !important;
    }
    .index-operating .operating {
        padding: var(--blogs-p);
    }
    .index-operating .operating .index-button {
        background: color-mix(in srgb, var(--jds-color-primary), transparent 96%);
        color: var(--primary-color);
        font-weight: 800;
    }
    .index-operating .operating .module-title {
        display: flex;
        justify-content: space-between;
        font-size: var(--operating-module-title);
        color: #1A1A1A;
        line-height: var(--operating-module-title-lh);
        font-weight: 500;
    }
    .index-operating .operating .module-title .title {
        font-size: 32px;
        line-height: var(--operating-module-title-lh);
        padding-bottom: var(--operating-module-title-mb);
        overflow: hidden;
    }
    .index-operating .operating .module-title .title span {
        display: inline-block;
    }
    .index-operating .operating .operating-body {
        border-radius: 12px;
        padding-bottom: 46px;
    }
    .index-operating .operating .operating-body .introduction-video {
        margin: 0 auto 16px;
        width: 1200px;
        height: 320px;
    }
    .index-operating .operating .operating-body .introduction-video .newcomer-video-box {
        padding-bottom: unset;
        height: 100%;
    }
    .index-operating .operating .operating-body .introduction-video .newcomer-video-box .jky-video-poster_container {
        height: 320px;
    }
    .index-operating .operating .operating-body .introduction-video .newcomer-video-box .jky-video-poster_container .jky-video_media {
        height: 320px;
    }
    .index-operating .operating .operating-body .introduction-body {
        padding: 0 118px 0 159px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }
    .index-operating .operating .operating-body .introduction-body .text-content {
        text-align: center;
    }
    .index-operating .operating .operating-body .introduction-body .text-content .introduction-title {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        height: 24px;
    }
    .index-operating .operating .operating-body .introduction-body .text-content .introduction-title .title-index {
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 24px;
        margin-right: 8px;
        width: 24px;
        height: 24px;
        font-weight: 500;
        font-size: 16px;
        line-height: 18px;
        border-radius: 4px;
        background-color: #FF8800;
        color: #FFFFFF;
    }
    .index-operating .operating .operating-body .introduction-body .text-content .introduction-title .pc-title {
        text-align: left;
    }
    .index-operating .operating .operating-body .introduction-body .text-content .introduction-title .pc-title p {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 1;
    }
    .index-operating .operating .operating-body .introduction-body .text-content .introduction-title .title {
        color: #1A1A1A;
        font-weight: 600;
        line-height: 24px;
        -webkit-box-orient: vertical;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        overflow: hidden;
    }
    .index-operating .operating .operating-body .introduction-body .text-content .introduction-subtitle {
        width: 280px;
        margin: 10px auto 0;
        color: #666666;
        font-weight: 400;
        line-height: 22px;
    }
    .index-operating .operating .introduction-description {
        margin: 0 auto;
        width: 800px;
        text-align: center;
        color: rgba(0, 0, 0, 0.4);
        font-size: 14px;
        font-weight: 500;
        line-height: 22px;
    }
    @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
        .index-operating {
            --operating-m: 5vw 0;
            --operating-p: 0px 2.77777778vw;
            --operating-module-title: 2.22222222vw;
            --operating-module-title-lh: 2.77777778vw;
            --operating-module-title-mb: 1.66666667vw;
            margin: var(--operating-m);
        }
        .index-operating .new-main-container{
            width: 100vw;
        }
        .index-operating .operating {
            padding: var(--operating-p);
        }
        .index-operating .operating .index-button {
            background: color-mix(in srgb, var(--jds-color-primary), transparent 96%);
            color: var(--primary-color);
            font-weight: 800;
        }
        .index-operating .operating .module-title {
            display: flex;
            justify-content: space-between;
            font-size: var(--operating-module-title);
            color: #1A1A1A;
            line-height: var(--operating-module-title-lh);
            font-weight: 500;
        }
        .index-operating .operating .module-title .title {
            font-size: 2.22222222vw;
            padding-bottom: var(--operating-module-title-mb);
            overflow: hidden;
        }
        .index-operating .operating .module-title .title span {
            display: inline-block;
        }
        .index-operating .operating .operating-body {
            border-radius: 0.83333333vw;
            padding-bottom: 3.19444444vw;
        }
        .index-operating .operating .operating-body .introduction-video {
            margin: 0 auto 1.11111111vw;
            width: 83.33333333vw;
        }
        .index-operating .operating .operating-body .introduction-video .jky-video-poster_container {
            height: 22.22222222vw !important;
        }
        .index-operating .operating .operating-body .introduction-video .jky-video-poster_container .jky-video_media {
            height: 22.22222222vw;
        }
        .index-operating .operating .operating-body .introduction-body .text-content .introduction-title {
            height: 24px;
        }
        .index-operating .operating .operating-body .introduction-body .text-content .introduction-title .title-index {
            min-width: 1.66666667vw;
            margin-right: 0.55555556vw;
            width: 1.66666667vw;
            height: 1.66666667vw;
            font-size: 1.11111111vw;
            border-radius: 0.27777778vw;
            line-height: 1.25vw;
        }
        .index-operating .operating .operating-body .introduction-body .text-content .introduction-title .title {
            line-height: 1.66666667vw;
        }
        .index-operating .operating .operating-body .introduction-body .text-content .introduction-subtitle {
            width: 19.44444444vw;
            margin: 0.69444444vw auto 0;
            line-height: 1.52777778vw;
        }
        .index-operating .operating .introduction-description {
            width: 55.55555556vw;
            font-size: 0.97222222vw;
            line-height: 1.52777778vw;
        }
    }
    @media screen and (max-width: 1023.98px) {
        .index-operating {
            --operating-m: 19.2vw 0;
            --operating-p: 0 0 0 6.4vw;
            --operating-module-title: 6.4vw;
            --operating-module-title-lh: 8.53333333vw;
            --operating-module-title-mb: 5.33333333vw;
        }
        .index-operating .new-main-container{
            width: 100%;
        }
        .index-operating .video-pc-block {
            display: none !important;
        }
        .index-operating .video-mb-block {
            display: block !important;
        }
        .index-operating .operating {
            padding: unset;
        }
        .index-operating .operating .module-title {
            padding: var(--blogs-p);
        }
        .index-operating .operating .module-title .title {
            font-size: 7.46666667vw;
            width: 87.2vw;
        }
        .index-operating .operating .operating-body {
            display: flex;
            padding-bottom: 0;
            background: unset !important;
        }
        .index-operating .operating .operating-body .introduction-video {
            width: 48vw;
            flex: none;
            height: 152vw;
            margin: 0 2.66666667vw 0 0;
        }
        .index-operating .operating .operating-body .introduction-video .jky-video-poster_container {
            height: auto !important;
        }
        .index-operating .operating .operating-body .introduction-video .jky-video-poster_container .jky-video_media {
            height: auto;
        }
        .index-operating .operating .operating-body .introduction-body {
            position: relative;
            padding: unset;
            flex-direction: column;
            justify-content: unset;
            align-items: center;
            padding-right: 4vw;
            width: 100%;
        }
        .index-operating .operating .operating-body .introduction-body .text-content {
            position: absolute;
            width: 100%;
            margin-bottom: 5.33333333vw;
            text-align: left;
            left: 1.33333333vw;
        }
        .index-operating .operating .operating-body .introduction-body .text-content:nth-child(1) {
            top: 10.66666667vw;
        }
        .index-operating .operating .operating-body .introduction-body .text-content:nth-child(2) {
            top: 53.33333333vw;
        }
        .index-operating .operating .operating-body .introduction-body .text-content:last-child {
            top: 109.33333333vw;
            margin-bottom: 0;
        }
        .index-operating .operating .operating-body .introduction-body .text-content .introduction-title {
            justify-content: unset;
            height: auto;
        }
        .index-operating .operating .operating-body .introduction-body .text-content .introduction-title .title-index {
            margin-right: 1.6vw;
            min-width: 5.33333333vw;
            width: 5.33333333vw;
            height: 5.33333333vw;
            font-weight: 500;
            font-size: 3.73333333vw;
            line-height: 4.26666667vw;
        }
        .index-operating .operating .operating-body .introduction-body .text-content .introduction-title .title {
            font-weight: 500;
            margin-right: 4vw;
            line-height: 6.93333333vw;
        }
        .index-operating .operating .operating-body .introduction-body .text-content .introduction-subtitle {
            width: 45.33333333vw;
            margin: 1.33333333vw 4vw 0 0;
            padding-left: 0;
            color: rgba(0, 0, 0, 0.5);
            font-weight: 400;
            line-height: 5.6vw;
        }
        .index-operating .operating .introduction-description {
            padding: 0 6.4vw;
            margin: 6.4vw 0 0;
            width: 100%;
            font-size: 3.46666667vw;
            font-weight: 400;
            line-height: 5.33333333vw;
        }
        .index-operating .operating .index-button {
            margin: 6.4vw auto 0;
        }
    }

</style>
<div class="index-operating  {% if section.settings.types == 'embed' %}embed-component{% endif %}" data-handle="{{ section.settings.handle }}">
    <div class="new-main-container" data-handls="{{ section.settings.collection }}">
        <div class="operating">
            <div class="module-title">
                <div class="title"> <span class="jky-slideup">{{ section.settings.module_title | escape}}</span></div>
                {%- if section.settings.button_text != blank -%}
                    <a class="pc-block" target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ section.settings.url }}">
                        <button class="index-button">
                            <span>{{ section.settings.button_text | escape}}</span>
                            <div>
                                <div class="arrow">
                                    <svg class="prefix__line" width="20" height="15" viewBox="0 0 20 15" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12.708 0H9.063L15 6.026H0v2.431h15l-5.937 6.026h3.645L20 7.294z" class="svg-arrow" fill="#FFF" fill-rule="nonzero" />
                                    </svg>
                                </div>
                            </div>
                        </button>
                    </a>
                {%- endif -%}
            </div>
            <div class="operating-body" style="background: {{ section.settings.bgColor }}">
                <div class="introduction-video">
                    {% comment %} 视频展示 {% endcomment %}
                    {% if section.settings.videoSrc != blank or section.settings.poster != blank %}
                        {%- render 'jky-video',
                                video_url: section.settings.videoSrc,
                                poster: section.settings.poster,
                                isHidePauseBtn: false,
                                class: 'newcomer-video-box video-pc-block',
                                autoplay: section.settings.autoplay,
                                controls: section.settings.controls,
                                loop: section.settings.loop
                        -%}
                    {% endif %}

                    {% if section.settings.videoSrcMB != blank or section.settings.posterMB != blank %}
                        {%- render 'jky-video',
                                video_url: section.settings.videoSrcMB,
                                poster: section.settings.posterMB,
                                isHidePauseBtn: false,
                                class: 'newcomer-video-box video-mb-block',
                                autoplay: section.settings.autoplay,
                                controls: section.settings.controls,
                                loop: section.settings.loop
                        -%}
                    {% endif %}
                </div>
                <div class="introduction-body">
                    {% for item in section.blocks %}
                        {% if item.settings.title != blank or item.settings.subTitle != blank %}
                            <div class="text-content">
                                <div class="introduction-title">
                                    <div class="title-index video-pc-block">{{ forloop.index }}</div>
                                    <h3 class="title video-pc-block pc-title">{{ item.settings.pc_title }}</h3>
                                    <h3 class="title video-mb-block">{{ item.settings.mb_title }}</h3>
                                </div>
                                <div class="introduction-subtitle">
                                    {{ item.settings.subTitle }}
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% if section.settings.description != blank %}
                <div class="introduction-description">
                    {{ section.settings.description }}
                </div>
            {% endif %}
            {% if section.settings.button_text != blank %}
                <a class="video-mb-block" target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ section.settings.url }}">
                    <button class="index-button">
                        <span>{{ section.settings.button_text | escape}}</span>
                    </button>
                </a>
            {% endif %}
        </div>
    </div>
</div>
{% schema %}
{
  "name":"产品工作原理",
  "settings": [
    {
      "type": "select",
      "id": "types",
      "label": "类型",
      "default": "independent",
      "options": [
        {
          "value": "embed",
          "label": "内嵌使用"
        },
        {
          "value": "independent",
          "label": "独立使用"
        }
      ]
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle（当前页面唯一的handle）",
      "default": "embed-component-01"
    },
    { "type": "number", "id": "pc_padding_top", "label": "上边距PC", "default": 36 },
    { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 36 },
    { "type": "number", "id": "mb_padding_top", "label": "上边距MB", "default": 48 },
    { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 },
    { "type": "text", "id": "module_title", "label": "模块标题(必填)" },
    { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false },
    { "type": "text", "id": "button_text", "label": "按钮文案" },
    { "type": "url", "id": "url", "label": "跳转地址" },
    { "type": "number", "id": "pc_title_size", "label": "PC标题字号", "default": 18 },
    { "type": "number", "id": "mb_title_size", "label": "MB标题字号", "default": 36 },
    { "type": "number", "id": "pc_subtitle_size", "label": "PC描述文案字号", "default": 14 },
    { "type": "number", "id": "mb_subtitle_size", "label": "MB描述文案字号", "default": 28 },
    { "type": "color_background", "id": "bgColor", "label": "PC背景色", "default": "linear-gradient(180deg, #F3F3F3 67%, #FFFFFF 100%)" },
    { "type": "url", "id":"videoSrc", "label": "PC视频源（支持格式: mp4、mov、m4v）" },
    { "type": "image_picker", "id":"poster", "label": "PC视频封面图（1200 x 320 单位px）" },
    { "type": "url", "id":"videoSrcMB", "label": "MB视频源（支持格式: mp4、mov、m4v）" },
    { "type": "image_picker", "id":"posterMB", "label": "MB视频封面图（750 x 320 单位px）" },
    { "type": "checkbox", "id":"autoplay", "default": true, "label": "是否自动播放" },
    { "type": "checkbox", "id":"loop", "default": true, "label": "是否循环播放" },
    { "type": "checkbox", "id":"controls", "default": false, "label": "是否显示控件" },
    { "type": "richtext", "id": "description", "label": "备注文案" }
  ],
  "blocks": [
    {
      "type":"block",
      "name":"产品描述",
      "settings":[
        { "type": "richtext", "id": "pc_title", "label": "pc标题" },
        { "type": "richtext", "id": "mb_title", "label": "mb标题" },
        { "type": "richtext", "id": "subTitle", "label": "描述文案" }
      ]
    }
  ],
  "presets":[
    {
      "name":"首页-工作原理"
    }
  ]
}
{% endschema %}
