{% comment %} 4.0产品详情页内容组件 {% endcomment %}
{{ 'pdp-v4-content.min.css' | asset_url | stylesheet_tag }}

{%- assign blocks_app_size = section.blocks | where: 'type', "@app" | size -%}

{%- assign blocks_pdp_block_size = 0 -%}
{%- for block in section.blocks -%}
    {%- assign blocks_type = block.type -%}
    {%- if blocks_type contains 'pdp' -%}
        {%- assign blocks_pdp_block_size = blocks_pdp_block_size | plus: 1 -%}
    {%- endif -%}
{%- endfor -%}

{%- assign blocks_tech_size = section.blocks | where: 'type', "tech" | size -%}
{%- assign blocks_tech = section.blocks | where: 'type', "tech" -%}

{%- assign blocks_faq_size = section.blocks | where: 'type', "faq" | size -%}
{%- assign blocks_faq = section.blocks | where: 'type', "faq" -%}

{%- assign blocks_reviews_size = section.blocks | where: 'type', "reviews" | size -%}
{%- assign blocks_reviews = section.blocks | where: 'type', "reviews" -%}

{%- assign tabs_num = blocks_faq_size | plus: blocks_tech_size | plus: blocks_reviews_size -%}
{%- if blocks_pdp_block_size > 0 -%}
    {%- assign tabs_num = blocks_faq_size | plus: blocks_tech_size | plus: blocks_reviews_size | plus: 1 -%}
{%- endif -%}

{% comment %} 详情 tab list {% endcomment %}
{%- assign tabs_list = '' -%}
{%- if blocks_pdp_block_size > 0 -%}
    {%- assign tabs_list = section.settings.tab_highlights -%}
{%- endif -%}

{%- if blocks_tech_size > 0 -%}
    {%- assign tabs_list = tabs_list | append: '-' | append: section.settings.tab_tech -%}
{%- endif -%}

{%- if blocks_faq_size > 0 -%}
    {%- assign tabs_list = tabs_list | append: '-' | append: section.settings.tab_faq -%}
{%- endif -%}

{%- if blocks_reviews_size > 0 -%}
    {%- assign tabs_list = tabs_list | append: '-' | append: section.settings.review_faq -%}
{%- endif -%}
{%- assign tabs_list = tabs_list | split: '-' -%}

{% comment %} tab_mode {% endcomment %}
{%- liquid
  assign is_slide = true
  if section.settings.tab_mode == 'column'
    assign is_slide = false
  endif
-%}
{%- render 'diy-tabs', settings: section.settings, title: product.title, list: tabs_list, mode_type: section.settings.tab_mode -%}
{% comment %} 详情 tab list {% endcomment %}

{% comment %} PDP V4各版块 开始 {% endcomment %}

<div class="produc-detail--content">
  <div
    class="inner--container {% if is_slide == false %}inner--container_column{% endif %}"
    {% if is_slide == true %}style="--translate-x-w: {{tabs_num}};--translate-active: 0;"{% endif %}
  >
    {%- if blocks_pdp_block_size > 0 -%}
      <div class="produc-detail--contetn_item pdp-v4-content" section-id="{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'pdp-animated-title' -%}
              {% comment %} 动效标题 {% endcomment %}
              <div class="pdp-animated-title" data-index="{{ forloop.index }}">
                {% render 'new-title',
                  title: block.settings.title,
                  type: block.settings.type,
                  settings: block.settings,
                  color: 'var(--jds-color-primary)',
                  bgColor: '#fff'
                %}
              </div>
            {%- when 'empty-block-box' -%}
              {%- if block.settings.anchor == 'anchor__1' -%}
                {% comment %} 空盒子版块 {% endcomment %}
                {% render 'empty-block-box', settings: block.settings, handle: block.settings.sourceHandle, index: forloop.index %}
              {%- endif -%}
            {%- when 'pdp-calculator' -%}
              {% comment %} 计算器 {% endcomment %}
              {% render 'pdp-calculator', settings: block.settings, index: forloop.index %}
            {%- when 'pdp-single-text-img' -%}
              {% comment %} 单张上文下图 {% endcomment %}
              {% render 'pdp-single-text-img', settings: block.settings, index: forloop.index %}
            {%- when 'pdp-two-text-img' -%}
              {% comment %} 一行两组图文 {% endcomment %}
              {% render 'pdp-two-text-img', settings: block.settings, index: forloop.index %}
            {%- when 'pdp-three-text-img' -%}
              {% comment %} 一行三组图文 {% endcomment %}
              {% render 'pdp-three-text-img', settings: block.settings, index: forloop.index %}
            {%- when 'pdp-left-text-right-img' -%}
              {% comment %} 单张左文右图 {% endcomment %}
              {% render 'pdp-left-text-right-img', settings: block.settings, index: forloop.index %}
            {%- when 'pdp-card-text-img' -%}
              {% comment %} 单张卡片图文{% endcomment %}
              {% render 'pdp-card-text-img', settings: block.settings, index: forloop.index %}
            {%- when 'pdp-matrix' -%}
              {% comment %} 灵活矩阵 {% endcomment %}
              <div class="pdp-matrix section-matrix-graph">
                {% render 'matrix-graph', settings: block.settings, index: forloop.index %}
              </div>
            {%- when 'media_highlight_scense' -%}
              <div class="product-block-section" {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %} data-invert="true"{% endif %}>
                  {% render "diy-media-swiper", settings: block.settings %}
              </div>
            {% comment %} 产品对比 {% endcomment %}
            {%- when 'product-compare' -%}
              {% style %}
                #{{block.id }}{ margin: {{ block.settings.pc_margin_x }}px 0; }
                #{{block.id }} .compare-block-container{ width: 1200px; margin: 0 auto; }
                #{{block.id }} .compare-title{ font-weight: 500; font-size: 40px; color: #1A1A1A; line-height: 48px; text-align: center; margin-bottom: 16px; }
                #{{block.id }} .compare-desc{ font-weight: 500; font-size: 18px; color: #1A1A1A; line-height: 26px; text-align: center; }
                @media screen and (max-width: 1439.98px) {
                  #{{block.id }}{margin: {{ block.settings.pc_margin_x }}px 0}
                  #{{block.id }} .compare-block-container{ width: 83.3333333333333vw; margin: 0 auto; }
                  #{{block.id }} .compare-title{ font-size: 2.77777777777778vw; line-height: 3.33333333333333vw; margin-bottom: 1.11111111111111vw; }
                  #{{block.id }} .compare-desc{ font-size: 1.25vw; line-height: 1.80555555555556vw; }
                }
                @media screen and (max-width: 1023.98px) {
                  #{{block.id }} {margin: {{ block.settings.mb_margin_x }}px 0;}
                  #{{block.id }} .compare-block-container{ width: 88.26666666vw; }
                  #{{block.id }} .compare-title{ font-size: 7.46666666666667vw; line-height: 7.46666666666667vw; text-align: left; margin-bottom: 2.13333333333333vw; }
                  #{{block.id }} .compare-desc{ font-weight: 500; font-size: 4.26666666666667vw; color: #1A1A1A; line-height: 6.4vw; text-align: left; }
                }
              {% endstyle %}
              {% assign current_variant_id = product.selected_or_first_available_variant.id %}

              <div id="{{block.id }}" {{ block.shopify_attributes }}>
                  <div class="compare-block-container">
                    {% if block.settings.title != blank %}
                      <div class="compare-title"> {{ block.settings.title | escape }} </div>
                    {% endif %}

                    {% if block.settings.desc != blank %}
                        <div class="jds-rte compare-desc"> {{ block.settings.desc | replace: '<em>',  '<em style="color: var(--jds-color-primary);">' }} </div>
                    {% endif %}

                    {% render 'compare-content',  type: 2, view_more: block.settings.view_more, current_variant_id: current_variant_id %}
                  </div>
              </div>

              {%- when 'pdp-scroll' -%}
                {% comment %} 滚动高亮 {% endcomment %}
                {% render 'scroll-high-light', settings: block.settings, index: forloop.index %}

              {%- when 'pdp-smart-recommend' -%}
                {% comment %} 智能选购{% endcomment %}
                <div class="smart-box" style="background: #F5F5F5">
                  {% render 'smart-recommend-block', smart: block.settings, index: forloop.index %}
                </div>

              {%- when 'media_highlight_space' -%}
                <div class=" product-media_highlight--block product-block-section"  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %} data-invert="true"{% endif %}>
                    {%- render "diy-scroll-textpic", settings: block.settings -%}
                </div>
              {%- when 'five_kwh_product_videos' -%}
                {% comment %} 用户视频轮播列表 {% endcomment %}
                <div  class="section-five-find-out section-photovolatic-find-out" anchor="{{ block.settings.anchor_id | url_decode | strip | replace: ' ', ''}}" >
                  {%- render "product-detail-videos", settings: block.settings, index: forloop.index -%}
                </div>

              {%- when 'pdp_award' -%}
                {% comment %} 媒体背书 {% endcomment %}
                {% render 'index-award-new', award: block.settings , index: forloop.index %}

              {%- when 'recommend_products' -%}
                {% comment %} 产品推荐 {% endcomment %}
                {%- render 'app-recommend-products', block_settings: block.settings, product: product -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if blocks_tech_size > 0 -%}
      {%- assign blockTech = blocks_tech | first -%}
      <div class="produc-detail--contetn_item product-detail--tech">
        <product-specs
          class="product-block-section"
          {{ blockTech.shopify_attributes }}
          data-product-title="{{ product.title | escape }}"
          data-sku="{{ product.selected_or_first_available_variant.sku | escape }}"
          data-id="{{ product.selected_or_first_available_variant.id | escape }}"
          {% if blockTech.settings.block_bg != blank and blockTech.settings.block_bg != 'rgba(0,0,0,0)' %} data-invert="true"{% endif %}
        >
          <h2 class="section-container text-center tech--title">{{blockTech.settings.title | escape}}</h2>
          {% comment %} 产品端口和尺寸 {% endcomment %}
          <div class="accordion-ul section-container {% if blockTech.settings.part_1_heading == blank %} hidden{% endif %}" style="{% if blockTech.settings.part_1_heading == blank %}display: none;{% endif %}">
            <div class="accordion-header">
              {%- if blockTech.settings.part_1_heading != blank -%}
                <h3 class="jky-text-lg font-bold">{{blockTech.settings.part_1_heading | escape}}</h3>
                <svg class="accordion-close active" viewBox="0 0 1024 1024" width="36" height="36"><path d="M512 671.288889L785.066667 398.222222l-56.888889-62.577778L512 551.822222 295.822222 335.644444 233.244444 398.222222z" fill="#1A1A1A" opacity=".6"></path></svg>
              {%- endif -%}
            </div>

            <div class="accordion-content flex-col">
              {% comment %} 主产品 {% endcomment %}
              {%- if blockTech.settings.part_1_img -%}
                {%- if blockTech.settings.part_1_product_title -%}
                  <div class="accordion-content--title font-500 text-center">{{blockTech.settings.part_1_product_title | escape}}</div>
                {%- endif -%}

                <div class="flex accordion-content--specs-pic justify-center">
                  {% render 'responsive-image', image: blockTech.settings.part_1_img, width: 750, mwidth: 300, image_class: 'specs-img' %}
                  <ul>
                    {%- for i in (0..19) -%}
                      {%- assign key_index = 'part_1_product_desc_' | append: forloop.index -%}

                      {%- if blockTech.settings[key_index] != blank -%}
                        <li class="jky-text-base">{{blockTech.settings[key_index] | escape}}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              {% comment %} 左侧产品图 {% endcomment %}
              {%- if blockTech.settings.part_1_img_2 -%}
                <div class="accordion-content--specs-more-main">
                  {%- if blockTech.settings.part_1_product_2_title -%}
                    <div class="accordion-content--title font-500 text-center">{{blockTech.settings.part_1_product_2_title | escape}}</div>
                  {%- endif -%}

                  <div class="flex accordion-content--specs-pic justify-center">
                    {%- render 'responsive-image', image: blockTech.settings.part_1_img_2, width: 750, mwidth: 300, image_class: 'specs-img' -%}
                    <ul>
                      {%- for i in (0..9) -%}
                        {% assign key_index = 'part_1_product_2_desc_' | append: forloop.index %}

                        {%- if blockTech.settings[key_index] != blank -%}
                          <li class="jky-text-base">{{blockTech.settings[key_index] | escape}}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              {%- endif -%}

              {% comment %} 右侧产品图 {% endcomment %}
              {%- if blockTech.settings.part_1_img_3 -%}
                <div class="accordion-content--specs-more-main">
                  {%- if blockTech.settings.part_1_product_3_title -%}
                    <div class="accordion-content--title font-500 text-center">{{blockTech.settings.part_1_product_3_title | escape}}</div>
                  {%- endif -%}

                  <div class="flex accordion-content--specs-pic justify-center">
                    {% render 'responsive-image', image: blockTech.settings.part_1_img_3, width: 750, mwidth: 300, image_class: 'specs-img' %}
                    <ul>
                      {%- for i in (0..9) -%}
                        {%- assign key_index = 'part_1_product_3_desc_' | append: forloop.index -%}

                        {%- if blockTech.settings[key_index] != blank -%}
                          <li class="jky-text-base">{{blockTech.settings[key_index] | escape}}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              {%- endif -%}

              {% assign bundle_flag = false %}
              {%- if blockTech.settings.part_1_img == blank and blockTech.settings.part_1_img_2 == blank and blockTech.settings.part_1_img_3 == blank -%}
                  {% assign bundle_flag = true %}
              {%- endif -%}

              <ol>
                {% comment %} 组合配件产品 {% endcomment %}
                {%- for i in (0..4) -%}
                  {%- assign bundle_key_index = 'part_1_bundle_img_' | append: forloop.index -%}
                  {%- assign bundle_width_index = 'part_1_bundle_width_' | append: forloop.index -%}
                  {%- assign bundle_title_index = 'part_1_bundle_title_' | append: forloop.index -%}
                  {%- assign bundle_desc_index = 'part_1_bundle_desc_' | append: forloop.index -%}

                  {%- if blockTech.settings[bundle_key_index] -%}
                    <li data-bundle-width="{{blockTech.settings[bundle_width_index]}}" class="accordion-content--specs-pic_bundle" {% if forloop.index == 1 and bundle_flag == true %}  style="margin-top: 0;padding-top: 0;border-top: none;" {{forloop.index  }} {% endif %}>
                      {%- if blockTech.settings[bundle_title_index] -%}
                        <div class="accordion-content--title font-500 text-center">{{blockTech.settings[bundle_title_index] | escape}}</div>
                      {%- endif -%}
                      {% render 'responsive-image', image: blockTech.settings[bundle_key_index], width: 900, mwidth: 300 %}

                      {%- if blockTech.settings[bundle_desc_index] -%}
                        <span class="jky-text-sm">{{blockTech.settings[bundle_desc_index] | escape}}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ol>
            </div>
          </div>

          {% comment %} 产品参数 {% endcomment %}
          <div class="accordion-ul section-container accordion--product-specs {% if blockTech.settings.part_2_heading == blank %} hidden{% endif %}" style="{% if blockTech.settings.part_2_heading == blank %}display: none;{% endif %}">
            <div class="accordion-header">
              {%- if blockTech.settings.part_2_heading != blank -%}
                <h3 class="jky-text-lg font-bold">{{blockTech.settings.part_2_heading | escape}}</h3>
                <svg class="accordion-close active" viewBox="0 0 1024 1024" width="36" height="36"><path d="M512 671.288889L785.066667 398.222222l-56.888889-62.577778L512 551.822222 295.822222 335.644444 233.244444 398.222222z" fill="#1A1A1A" opacity=".6"></path></svg>
              {%- endif -%}
            </div>
            <div class="accordion-content accordion-content--with-child specs">
              <div class="accordion-ul"></div>
            </div>
          </div>

          {% comment %} 加电包信息 {% endcomment %}
          <div class="accordion-ul section-container accordion--whats-in-box {% if blockTech.settings.part_3_heading == blank %} hidden{% endif %}" style="{% if blockTech.settings.part_3_heading == blank %}display: none;{% endif %}">
            <div class="accordion-header">
              {%- if blockTech.settings.part_3_heading != blank -%}
                <h3 class="jky-text-lg font-bold">{{blockTech.settings.part_3_heading | escape}}</h3>
                <svg class="accordion-close active" viewBox="0 0 1024 1024" width="36" height="36"><path d="M512 671.288889L785.066667 398.222222l-56.888889-62.577778L512 551.822222 295.822222 335.644444 233.244444 398.222222z" fill="#1A1A1A" opacity=".6"></path></svg>
              {%- endif -%}
            </div>
            <div class="accordion-content" style="flex-direction: column;padding: 0;">
              {% comment %} 单品-无变体，或者有且只有1个变体 {% endcomment %}
              {%- if product.has_only_default_variant == true or product.variants.size == 1 -%}
                {%- assign what_box = '' -%}
                {%- if product.variants[0].metafields.custom.what_in_the_box_list_4_0 != blank -%}
                  {%- assign what_box = product.variants[0].metafields.custom.what_in_the_box_list_4_0.value -%}
                {%- elsif product.metafields.custom.what_is_in_the_box_4_0 != blank -%}
                  {%- assign what_box = product.metafields.custom.what_is_in_the_box_4_0.value -%}
                {%- endif -%}

                {%- if what_box != blank -%}
                  <what-is-in-the-box only-default-variant data-current-variant-id="{{ product.selected_or_first_available_variant.id }}">
                    {% comment %} PC 端 {% endcomment %}
                    <div class="pc-show-flex single-sku-wrap">
                      {%- for list_item_4_0 in what_box -%}
                        {%- assign quantity = list_item_4_0.name | split: '*' | last -%}
                        {%- assign name = list_item_4_0.name | split: '*' | first -%}
                        <div class="sku-item">
                          <div>
                            <h4>{{ name | strip }}</h4>
                            <span>X{{ quantity | strip }}</span>
                          </div>
                          <img src="{{ list_item_4_0.img | image_url: width: 340, height: 340 }}" alt="" loading="lazy">
                        </div>
                      {%- endfor -%}
                    </div>

                    {% comment %} Mobile 端 {% endcomment %}
                    <div class="mb-show sku-box-wrap">
                      {% comment %} 单品图片 {% endcomment %}
                      {%- assign current_f_img = product.selected_or_first_available_variant.featured_image | image_url: width: 750 -%}
                      {%- if product.selected_or_first_available_variant.featured_image == blank -%}
                        {%- assign current_f_img = product.featured_image | image_url: width: 750 -%}
                      {%- endif -%}
                      <img class="sku-img" src="{{ current_f_img }}" alt="" loading="lazy">
                      <div class="select-sku-variant-name-wrap">
                        <select name="select-sku-variant-name">
                          <option value="{{ product.title | escape }}">{{ product.title | escape}}</option>
                        </select>
                        <svg class="iconfont" viewBox="0 0 1024 1024" width="20" height="20"><path d="M818.07039273 512L329.94971923 23.87932647l-111.86098796 101.69180708L604.51759771 512 218.08873127 898.42886645 329.94971923 1010.28985441z" fill="#00000099"></path></svg>
                      </div>
                      <div class="sku-wrap">
                        {%- for list_item_4_0 in what_box -%}
                          {%- assign quantity = list_item_4_0.name | split: '*' | last -%}
                          {%- assign name = list_item_4_0.name | split: '*' | first -%}
                          <div class="sku-item">
                            <div>
                              <h4>{{ name | strip }}</h4>
                              <span>X{{ quantity | strip }}</span>
                            </div>
                            <img src="{{ list_item_4_0.img | image_url: width: 340, height: 340 }}" alt="" loading="lazy">
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  </what-is-in-the-box>
                {%- endif -%}
              {%- else -%}
                {% comment %} 多变体（>=2） {% endcomment %}
                {% assign variants_json = "" %}
                {% assign product_json = "" %}

                {%- for variant in product.variants -%}
                  {%- assign what_value = '' -%}
                  {%- if variant.metafields.custom.what_in_the_box_list_4_0.value != blank -%}
                    {%- assign what_value = variant.metafields.custom.what_in_the_box_list_4_0.value -%}
                  {%- elsif product.metafields.custom.what_is_in_the_box_4_0 != blank -%}
                    {%- assign what_value = product.metafields.custom.what_is_in_the_box_4_0.value -%}
                  {%- endif -%}
                  {% comment %} 收集sku数据 {% endcomment %}
                  {%- if variants_json != "" -%}
                    {%- assign variants_json = variants_json | append: "," -%}
                  {%- endif -%}
                  {%- assign variant_img = product.featured_image | image_url: width: 360, height: 360 | json -%}
                  {%- if variant.featured_image -%}
                    {%- assign variant_img = variant.featured_image | image_url: width: 360, height: 360 | json -%}
                  {%- endif -%}
                  {%- assign variant_name = variant.title | json -%}
                  {%- assign variant_data = '{' | append: '"skuId":' | append: variant.id | append: ',' | append: '"name":' | append: variant_name | append: ',' | append: '"img":' | append: variant_img | append: '}' -%}
                  {%- assign variants_json = variants_json | append: variant_data -%}

                  {% comment %} 收集spu数据 {% endcomment %}
                  {%- if product_json != "" -%}
                    {%- assign product_json = product_json | append: "," -%}
                  {%- endif -%}

                  {% comment %} 处理 加电包单个类目 {% endcomment %}
                  {%- assign what_box_data = "" -%}
                  {%- if what_value -%}
                    {%- for what_box in what_value -%}
                      {%- if what_box_data != "" -%}
                        {%- assign what_box_data = what_box_data | append: "," -%}
                      {%- endif %}
                      {%- assign img = what_box.img | image_url: width: 360, height: 360 | json -%}
                      {%- assign name = what_box.name | json -%}
                      {%- assign box_data = '{' | append: '"img":' | append: img | append: ',' | append: '"name":' | append: name | append: '}' -%}
                      {%- assign what_box_data = what_box_data | append: box_data -%}
                    {%- endfor -%}
                    {%- assign what_box_data = "[" | append: what_box_data | append: "]" -%}
                  {%- else -%}
                    {%- assign what_box_data = "[]" -%}
                  {%- endif -%}

                  {%- assign product_data = '{' | append: '"skuId":' | append: variant.id | append: ',' | append: '"list":' | append: what_box_data | append: '}' -%}
                  {%- assign product_json = product_json | append: product_data -%}
                {%- endfor -%}

                {%- assign variants_json = "[" | append: variants_json | append: "]" -%}
                {%- assign product_json = "[" | append: product_json | append: "]" -%}

                <what-is-in-the-box data-current-variant-id="{{ product.selected_or_first_available_variant.id }}">
                  {% comment %} PC 端 {% endcomment %}
                  <div class="pc-show-flex" style="flex-direction: column;">
                    <div class="table-container"></div>
                    <div class="table-arrow-wrap" style="display:none">
                      <button class="table-arrow table-left-arrow" disabled aria-label="Scroll table left"></button>
                      <button class="table-arrow table-right-arrow" aria-label="Scroll table right"></button>
                    </div>
                  </div>

                  {% comment %} Mobile 端 {% endcomment %}
                  <div class="mb-show sku-box-wrap">
                    {% comment %} sku图片 {% endcomment %}
                    {%- assign current_f_img = product.selected_or_first_available_variant.featured_image | image_url: width: 750 -%}
                    {%- if product.selected_or_first_available_variant.featured_image == blank -%}
                      {%- assign current_f_img = product.featured_image | image_url: width: 750 -%}
                    {%- endif -%}
                    <img class="sku-img" src="{{ current_f_img }}" alt="" loading="lazy">
                    <div class="select-sku-variant-name-wrap">
                      <select name="select-sku-variant-name">
                        {%- for variant in product.variants -%}
                          <option
                            name="{{ variant.title | escape }}"
                            value="{{ variant.id }}"
                            {% if product.selected_or_first_available_variant.id == variant.id %}selected{% endif %}
                          >{{ variant.title | escape}}</option>
                        {%- endfor -%}
                      </select>
                      <svg class="iconfont" viewBox="0 0 1024 1024" width="20" height="20"><path d="M818.07039273 512L329.94971923 23.87932647l-111.86098796 101.69180708L604.51759771 512 218.08873127 898.42886645 329.94971923 1010.28985441z" fill="#00000099"></path></svg>
                    </div>
                    {%- for variant in product.variants -%}
                      {%- assign what_value = '' -%}
                      {%- if variant.metafields.custom.what_in_the_box_list_4_0.value != blank -%}
                        {%- assign what_value = variant.metafields.custom.what_in_the_box_list_4_0.value -%}
                      {%- elsif product.metafields.custom.what_is_in_the_box_4_0 != blank -%}
                        {%- assign what_value = product.metafields.custom.what_is_in_the_box_4_0.value -%}
                      {%- endif -%}
                      {%- assign what_box_list = what_value -%}
                      <div
                        class="sku-wrap {% if what_box_list == blank %}sku-wrap-no-margin{% endif %}"
                        style="display:{% if product.selected_or_first_available_variant.id == variant.id %}flex{% else %}none{% endif %}"
                        data-sku-id="{{ variant.id }}"
                      >
                        {%- for list_item_4_0 in what_box_list -%}
                          {%- assign quantity = list_item_4_0.name | split: '*' | last -%}
                          {%- assign name = list_item_4_0.name | split: '*' | first -%}
                          <div class="sku-item">
                            <div>
                              <h4>{{ name | strip }}</h4>
                              <span>X{{ quantity | strip }}</span>
                            </div>
                            <img src="{{ list_item_4_0.img | image_url: width: 340, height: 340 }}" alt="" loading="lazy">
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- endfor -%}
                  </div>

                  <script id="variant-what-in-box-4-0" type="application/json">
                    {{ variants_json }}
                  </script>
                  <script id="product-what-in-box-4-0" type="application/json">
                    {{ product_json }}
                  </script>
                </what-is-in-the-box>
              {%- endif -%}
            </div>
          </div>

          {% comment %} 用户手册 {% endcomment %}
          <div class="accordion-ul section-container accordion--manual {% if blockTech.settings.part_4_heading == blank %} hidden{% endif %}" style="{% if blockTech.settings.part_4_heading == blank %}display: none;{% endif %}">
            <div class="accordion-header">
              {%- if blockTech.settings.part_4_heading != blank -%}
                <h3 class="jky-text-lg font-bold">{{blockTech.settings.part_4_heading | escape}}</h3>
                <svg class="accordion-close active" viewBox="0 0 1024 1024" width="36" height="36"><path d="M512 671.288889L785.066667 398.222222l-56.888889-62.577778L512 551.822222 295.822222 335.644444 233.244444 398.222222z" fill="#1A1A1A" opacity=".6"></path></svg>
              {%- endif -%}
            </div>
            <div class="accordion-content accordion-content--with-pdf">
              <div class="manual-item">
                <dl class="manual-list" type="{{blockTech.settings.page_type}}" data-section-title="{{blockTech.settings.part_4_heading | escape}}">
                </dl>
              </div>
            </div>
          </div>
        </product-specs>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'empty-block-box' -%}
              {%- if block.settings.anchor == 'anchor__2' -%}
                {% comment %} 空盒子版块 {% endcomment %}
                {% render 'empty-block-box', settings: block.settings, handle: block.settings.sourceHandle, index: forloop.index %}
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% comment %} FAQ {% endcomment %}
    {%- if blocks_faq_size > 0 -%}
      {%- assign blockFaq = blocks_faq | first -%}

      {%- assign faq_num = 0 -%}
      {%- for item in product.metafields.custom.faq_multiple_columns.value -%}
          {%- assign faq_num = faq_num | plus: 1 -%}
      {%- endfor -%}

      <product-faq-columns {{ blockFaq.shopify_attributes }} class="produc-detail--contetn_item">
        {% comment %} faq {% endcomment %}
        <div class="produc-detail--faq section-container product-block-section" style="max-width:100vw;" {% if blockFaq.settings.block_bg != blank and blockFaq.settings.block_bg != 'rgba(0,0,0,0)' %} data-invert="true"{% endif %} data-show-category="{{blockFaq.settings.faq_show_category}}">
          <h2 class="faq-title">{{blockFaq.settings.title | escape}}</h2>

          {%- assign categories = product.metafields.custom.faq_multiple_columns.value -%}
          {%- assign faq_all = '' -%}
          {%- assign view_more_link = '' -%}
          {% comment %} 初始化计数变量 {% endcomment %}
          {%- assign faq_all_count = 0 -%}

          {% if faq_num > 0 %}
            <div class="produc-detail--faq-wrap flex">
              {% comment %} 需要分类展示 {% endcomment %}
              {%- if blockFaq.settings.faq_show_category -%}
                <div class="produc-detail--faq-left">
                  {%- for faq_category in categories -%}
                    {%- if forloop.index0 == 0 -%}
                      {%- assign view_more_link = faq_category.view_more_link -%}
                    {%- endif -%}
                    <div
                      class="faq-category-name {% if forloop.index0 == 0 %}active{% endif %}"
                      data-product-title="{{ product.title | escape }}"
                      data-index="{{forloop.index0}}"
                      data-view-more-link="{{faq_category.view_more_link}}"
                    >{{ faq_category.column_name | escape }}</div>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="produc-detail--faq-right">
                {% comment %} 需要分类展示 {% endcomment %}
                {%- if blockFaq.settings.faq_show_category -%}
                  {%- for faq_category in categories -%}
                    <ul data-index="{{forloop.index0}}" class="{% if forloop.index0 == 0 %}active{% endif %}">
                      {% comment %} 最多显示 10个 {% endcomment %}
                      {%- for faq_question_and_answer in faq_category.column_content.value limit: 10 -%}
                        <li>
                          <div class="faq-header flex">
                            <h3 class="item-title">{{faq_question_and_answer.question | escape}}</h3>
                            <svg class="toggle_btn active" viewBox="0 0 1024 1024" width="36" height="36"><path d="M512 671.288889L785.066667 398.222222l-56.888889-62.577778L512 551.822222 295.822222 335.644444 233.244444 398.222222z" fill="currentColor" opacity=".6"></path></svg>
                          </div>
                          <div class="faq-content">
                            <div class="rte">{{faq_question_and_answer.answer_text | metafield_tag}}</div>
                            <div>
                              {%- assign media_url = faq_question_and_answer.answer_media | metafield_text -%}
                              {%- if media_url contains ".mp4" or media_url contains ".mov" -%}
                                {% comment %} video {% endcomment %}
                                {%
                                  render 'jky-video',
                                    class: 'w-full h-full faq-video'
                                    video_url: media_url,
                                    autoplay: false,
                                    loop: false,
                                    controls: true
                                %}
                              {%- elsif media_url contains ".jpg" or media_url contains ".jpeg" or media_url contains ".png" or media_url contains ".webp" or media_url contains ".gif" -%}
                                {% comment %} image {% endcomment %}
                                    <div class="pswp-gallery-faq" id="photo-enlarge-gallery-faq">
                                        <a  data-pswp-width="{{ 1200 }}" data-pswp-height="{{ 1200 }}"
                                          >
                                          {% render 'responsive-image', image: faq_question_and_answer.answer_media %}
                                        </a>
                                    </div>

                              {%- endif -%}
                            </div>
                          </div>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endfor -%}
                {%- else -%}
                  <ul data-index="0">
                    {%- for faq_category in categories -%}
                      {%- for faq_question_and_answer in faq_category.column_content.value -%}
                        {% comment %} 只显示前 10 个 {% endcomment %}
                        {%- if faq_all_count < 10 -%}
                          <li>
                            <div class="faq-header flex">
                              <span>{{faq_question_and_answer.question | escape}}</span>
                              <svg class="toggle_btn active" viewBox="0 0 1024 1024" width="36" height="36"><path d="M512 671.288889L785.066667 398.222222l-56.888889-62.577778L512 551.822222 295.822222 335.644444 233.244444 398.222222z" fill="currentColor" opacity=".6"></path></svg>
                            </div>
                            <div class="faq-content">
                              <div class="rte">{{faq_question_and_answer.answer_text | metafield_tag}}</div>
                              <div>
                                {%- assign media_url = faq_question_and_answer.answer_media | metafield_text -%}
                                {%- if media_url contains ".mp4" or media_url contains ".mov" -%}
                                  {% comment %} video {% endcomment %}
                                  {%
                                    render 'jky-video',
                                      class: 'w-full h-full'
                                      video_url: media_url,
                                      autoplay: false,
                                      loop: false,
                                      controls: true
                                  %}
                                {%- elsif media_url contains ".jpg" or media_url contains ".jpeg" or media_url contains ".png" or media_url contains ".webp" or media_url contains ".gif" -%}
                                  <div class="pswp-gallery-faq" id="photo-enlarge-gallery-faq">
                                    <a  data-pswp-width="{{ 1200 }}" data-pswp-height="{{ 1200 }}"
                                      >
                                      {% render 'responsive-image', image: faq_question_and_answer.answer_media %}
                                    </a>
                                </div>
                                {%- endif -%}
                              </div>
                            </div>
                          </li>
                        {%- endif -%}

                        {% comment %} 计数加 1 {% endcomment %}
                        {%- assign faq_all_count = faq_all_count | plus: 1 -%}
                      {%- endfor -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </div>
          {% endif %}
          {% unless settings.enable_faq_schema %}
          <script class="seoai-schema" type="application/ld+json">
            {%- capture faq_list -%}
              {%- assign faq_count = 0 -%}
              {%- for faq_category in categories -%}
                {%- for faq_question_and_answer in faq_category.column_content.value -%}
                  {%- if faq_count >= 10 -%}{%- break -%}{%- endif -%}
                  {%- if faq_count > 0 -%},{%- endif -%}
                  {
                    "@type": "Question",
                    "name": {{ faq_question_and_answer.question | truncate: 180 | strip_html | strip | json }},
                    "acceptedAnswer": {
                      "@type": "Answer",
                      "text": {{ faq_question_and_answer.answer_text | metafield_tag | truncate: 300 | strip_html | strip | json }}
                    }
                  }
                  {%- assign faq_count = faq_count | plus: 1 -%}
                {%- endfor -%}
                {%- if faq_count >= 10 -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              "mainEntity": [{{ faq_list }}]
            }
          </script>
          {% endunless %}
          {% comment %} 不需要分类展示 {% endcomment %}
          {%- if blockFaq.settings.faq_show_category == false and faq_all_count > 10 -%}
            {%- assign view_more_link = blockFaq.settings.faq_show_category_link -%}
          {%- endif -%}

          <a href="{{view_more_link}}" class="faq--more" style="{% if faq_num > 0 and view_more_link != blank %}display:block{% else %}display:none{% endif %}">
            <button class="index-button">
              <span>{{'general.action_text.view_more' | t}}</span>
              <div>
                <div class="arrow">
                  <svg class="line" width="20" height="15" viewBox="0 0 20 15">
                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                      <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                        <g transform="translate(672.000000, 286.000000)">
                          <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                        </g>
                      </g>
                    </g>
                  </svg>
                </div>
              </div>
            </button>
          </a>
        </div>
      </product-faq-columns>
    {%- endif -%}

    {% comment %} Reviews {% endcomment %}
    {%- if blocks_reviews_size > 0 -%}
      {%- assign blockreviews = blocks_faq | first -%}
      <div
        {{ blockreviews.shopify_attributes }}
        class="produc-detail--contetn_item produc-detail--contetn_item__app"
      >
        <div class="section-container product-block-section" {% if blockreviews.settings.block_bg != blank and blockreviews.settings.block_bg != 'rgba(0,0,0,0)' %} data-invert="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<div class="pdp-overlay fixed top-0 left-0 w-full h-full bg-white hidden items-center justify-center" id="overlay">
  <img id="fullImage" class="max-w-full max-h-full">
</div>
{% comment %} PDP V4各版块 结束 {% endcomment %}
<script src="{{ 'jquery-3.6.4.min.js' | asset_url }}" data-cookieconsent="ignore" defer></script>
<script src="{{ 'pdp-v4-content.min.js' | asset_url }}" defer></script>
{% comment %} {{- 'photoswipe.css' | asset_url | stylesheet_tag -}} {% endcomment %}
<script src="{{ 'photoswipe-lightbox.umd.min.js' | asset_url }}" defer></script>
<script src="{{ 'photoswipe.umd.min.js' | asset_url }}" defer></script>
<script src="{{ 'sections-pdp-v4-content.js' | asset_url }}" defer></script>
