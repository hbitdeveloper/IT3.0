{% comment %} 首屏组件 样式内联 性能更好 {% endcomment %}
{% style %}
  .blog-v3-banner .swiper-unload .slide-1,
  .blog-v3-banner .swiper-unload .slide-1 .swiper-title,
  .blog-v3-banner .swiper-slide-active,
  .blog-v3-banner .swiper-slide-active .swiper-title,
  .blog-v3-banner .swiper-slide-duplicate-active,
  .blog-v3-banner .swiper-slide-duplicate-active .swiper-title,
  .blog-v3-banner .swiper-loaded .swiper-bottom {
    opacity: 1;
  }

  /* 适配超大分辨率：等比放大版块大小、轮播图片和相关间距 */
  @media screen and (min-width: 1920px) {
    .blog-v3-banner {
      padding-top: 1.25vw;
      padding-bottom: 2.5vw;
      height: 33.333333vw;
    }
    .blog-v3-banner .swiper-wrapper {
      height: 25vw;
    }
    .blog-v3-banner .swiper-slide {
      margin: 0 0.533854vw;
      width: 37.5vw;
      height: 20vw;
    }
    .blog-v3-banner .swiper-slide-prev {
      padding-left: 7.5vw;
    }
    .blog-v3-banner .swiper-slide-next {
      padding-right: 7.5vw;
    }
    .blog-v3-banner .swiper-slide-active,
    .blog-v3-banner .swiper-slide-duplicate-active {
      width: 37.5vw;
      height: 25vw;
    }
    .blog-v3-banner .swiper-title,
    .blog-v3-banner .swiper-bottom {
      height: 5.833333vw;
    }
    .blog-v3-banner .swiper-title {
      bottom: -5.833333vw;
    }
  }

  @media screen and (min-width: 1024px) and (max-width: 1919.98px) {
    .blog-v3-banner .swiper-slide-prev {
      padding-left: 9rem;
    }
    .blog-v3-banner .swiper-slide-next {
      padding-right: 9rem;
    }
    .blog-v3-banner .swiper-slide-active,
    .blog-v3-banner .swiper-slide-duplicate-active {
      width: 45rem;
      height: 30rem;
    }
  }

  @media screen and (min-width: 1024px) {
    .blog-v3-banner .swiper-arrow::after {
      width: 0.75rem;
      height: 0.75rem;
      content: '';
      border: 2px solid #666;
      border-left: none;
      border-bottom: none;
    }
    .blog-v3-banner .swiper-button-next::after {
      margin-left: -0.25rem;
      margin-top: 0.25rem;
    }
    .blog-v3-banner .swiper-button-prev::after {
      margin-left: -0.25rem;
      margin-top: 0.25rem;
    }
  }

  @media screen and (max-width: 1023.98px) {
    .blog-v3-banner .swiper-slide-active,
    .blog-v3-banner .swiper-slide-duplicate-active {
      width: 21.4375rem;
      height: 14.28125rem;
    }
    .blog-v3-banner .slideshow-pagination.autoplay .slideshow-pagination-item.active .pagination-separator {
      background-color: #ccc;
    }
  }
{% endstyle %}

{% liquid
  assign img_class = 'swiper-img w-full h-full object-cover rounded-xl transition-all duration-500 ease-out'
  assign swiper_arrow_class = 'swiper-arrow w-[3rem] h-[3rem] translate-y-[-50%] mt-0 bg-black/[0.03] hover:bg-black/[0.08] rounded-full'
%}

<div
  id="{{ section.id }}"
  class="blog-v3-banner w-full h-[25rem] lg:h-[40rem] bg-[#f5f5f5] pt-4 pb-6 lg:pt-6 lg:pb-12"
  {% if section.settings.anchor != blank %}
    anchor-target="{{section.settings.anchor | escape}}"
  {% endif %}
  data-autoplay="{{ section.settings.swiper_auto }}"
  data-delay="{{ section.settings.swiper_delay }}"
>
  <div class="swiper swiper-unload h-full">
    <div class="swiper-wrapper items-center h-[14.28125rem] lg:h-[30rem]">
      {% for block in section.blocks %}
        {% liquid
          assign selected_article = block.settings.article

          # 默认展示所选文章的封面图和标题，如果有自定义配置的图片和标题，则展示自定义的封面图或标题
          assign title_text = ''
          assign image_source = ''
          assign image_alt = ''
          if selected_article != blank
            assign title_text = selected_article.title
            assign image_source = selected_article.image
            assign image_alt = selected_article.title | escape
          endif
          if block.settings.title != blank
            assign title_text = block.settings.title
          endif
          if block.settings.img != blank
            assign image_source = block.settings.img
            if block.settings.img.alt != blank
              assign image_alt = block.settings.img.alt
            endif
          endif

          # 判断当前slide是否有效
          assign slide_is_visible = true
          if selected_article == blank and block.settings.img == blank and block.settings.title == blank
            assign slide_is_visible = false
          endif
        %}

        {% if slide_is_visible %}
          <div
            class="
              swiper-slide w-[21.4375rem] lg:w-[45rem] h-[11.425rem] lg:h-[24rem] mx-1 lg:mx-[0.640625rem] flex items-center justify-center
              opacity-30 transition-all duration-600 ease-[cubic-bezier(0.8,0,0.2,1)] slide-{{ forloop.index }}
            "
            data-title="{{ title_text | escape_once }}"
            data-link="{{ selected_article.url }}"
          >
            {% if selected_article != blank %}
              <a
                class="block w-full h-full rounded-xl overflow-hidden"
                href="{{ selected_article.url }}"
                target="{% if section.settings.target %}{{ '_blank' }}{% else %}{{ '_self' }}{% endif %}"
              >
            {% endif %}

            {% if image_source != blank %}
              <img
                class="{{ img_class }}"
                src="{{ image_source | image_url: width:1440 }}"
                alt="{{ image_alt }}"
                loading="lazy"
                width="720"
                height="480"
              >
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: img_class }}
            {% endif %}

            {% if title_text != blank %}
              <div class="swiper-title w-[20.4375rem] lg:w-[54rem] h-[7rem] absolute -bottom-[7rem] left-[50%] translate-x-[-50%] flex justify-center items-center opacity-0 transition-all duration-300 ease-[cubic-bezier(0.8,0,0.2,1)]">
                <div class="content h-max jds-b1 font-medium mt-4 lg:mt-0 lg:pb-[2px] w-full lg:w-[43.75rem] line-clamp-4 lg:line-clamp-3 lg:!leading-[1.275] text-center">
                  {{ title_text | escape_once }}
                </div>
              </div>
            {% endif %}

            {% if selected_article != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="swiper-bottom opacity-0 hidden lg:block relative w-[20.4375rem] lg:w-[54rem] h-[7rem] mx-auto">
      <div class="swiper-button-next {{swiper_arrow_class}} right-0 rotate-45"></div>
      <div class="swiper-button-prev {{swiper_arrow_class}} left-0 rotate-[-135deg]"></div>
    </div>
    <div class="slideshow-pagination block lg:!hidden {% if section.settings.swiper_auto %}autoplay{% endif %}"></div>
  </div>
</div>
<script src="{{ 'sections-blog-v3-banner.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V3博客-博客文章轮播",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "注意：轮播数量有效范围：[3-14]"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "checkbox",
      "id": "target",
      "label": "是否新标签页打开",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "swiper_auto",
      "label": "自动轮播",
      "default": false
    },

    {
      "type": "range",
      "id": "swiper_delay",
      "label": "轮播间隔（单位：秒）",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 7
    }
  ],
  "max_blocks": 14,
  "blocks": [
    {
      "name": "博客文章",
      "type": "slide",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "博客文章",
          "info": "默认展示所选文章的标题和封面"
        },
        {
          "type": "header",
          "content": "自定义博客配置（优先级高于文章配置）"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "博客标题"
        },
        {
          "type": "image_picker",
          "id": "img",
          "label": "博客封面图（720*480）"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V3博客-博客文章轮播",
      "category": "Blog-V3",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "博客标题"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "博客标题"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "博客标题"
          }
        }
      ]
    }
  ]
}
{% endschema %}
