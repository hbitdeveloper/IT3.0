<div {% if section.settings.anchor != blank %} data-anchor="{{section.settings.anchor}}" {% endif %}></div>
<div class="{% if section.settings.include_margins %}page-width w-[21.4375rem] mx-auto lg:w-[82.5rem]{% endif %}">
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "select",
        "id": "anchor",
        "label": "锚点设置",
        "info": "非锚点section请清空此项",
        "options": [
            {
            "value": "",
            "label": "非锚点section"
            },
            {
            "value": "anchor__1",
            "label": "第一个section锚点"
            },
            {
            "value": "anchor__2",
            "label": "第二个section锚点"
            },
            {
            "value": "anchor__3",
            "label": "第三个section锚点"
            },
            {
            "value": "anchor__4",
            "label": "第四个section锚点"
            }
        ],
        "default": ""
    },
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.presets.name"
    }
  ]
}
{% endschema %}