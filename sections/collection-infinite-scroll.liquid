{% comment %} infinite scroll {% endcomment %}
<div id="products-list">
    <div class="w-full lg:j-h-800 overflow-hidden relative after:block after:content-[''] after:absolute after:left-0 after:top-0 after:right-0 after:bottom-0 after:bg-black/60 after:z-0">
        {% comment %} 无缝滚动 {% endcomment %}
        {% for block in section.blocks %}
            <div class="flex gap-6 lg:j-gap-8 scale-[1.2] lg:scale-[1.12] -rotate-12">
                <div class="flex-1 swiper swiper-infinite-scroll-1 h-645 lg:j-h-1273 lg:-j-mt-170">
                    <div class="swiper-wrapper swiper-infinite-scroll-wrapper">
                        <div class="swiper-slide">
                            <picture>
                                <source media="(min-width:1024px)" srcset="{{block.settings.pc_1 | image_url: width: 512}}">
                                <img class="w-full h-auto" src="{{block.settings.pc_1 | image_url: width: 512}}"  alt="{{block.settings.pc_1.alt}}" loading="lazy">
                            </picture>
                        </div>
                    </div>
                </div>
                <div class="flex-1 swiper swiper-infinite-scroll-2 h-645 lg:j-h-1273 lg:-j-mt-70">
                    <div class="swiper-wrapper swiper-infinite-scroll-wrapper">
                        <div class="swiper-slide">
                            <picture>
                                <source media="(min-width:1024px)" srcset="{{block.settings.pc_2 | image_url: width: 512}}">
                                <img class="w-full h-auto" src="{{block.settings.pc_2 | image_url: width: 512}}"  alt="{{block.settings.pc_2.alt}}" loading="lazy">
                            </picture>
                        </div>
                    </div>
                </div>
                <div class="flex-1 swiper swiper-infinite-scroll-1 h-645 lg:j-h-1273 lg:j-mt-30">
                    <div class="swiper-wrapper swiper-infinite-scroll-wrapper">
                        <div class="swiper-slide">
                            <picture>
                                <source media="(min-width:1024px)" srcset="{{block.settings.pc_3 | image_url: width: 512}}">
                                <img class="w-full h-auto" src="{{block.settings.pc_3 | image_url: width: 512}}"  alt="{{block.settings.pc_3.alt}}" loading="lazy">
                            </picture>
                        </div>
                    </div>
                </div>
                <div class="flex-1 swiper swiper-infinite-scroll-2 h-645 lg:j-h-1273 lg:j-mt-80">
                    <div class="swiper-wrapper swiper-infinite-scroll-wrapper">
                        <div class="swiper-slide">
                            <picture>
                                <source media="(min-width:1024px)" srcset="{{block.settings.pc_4 | image_url: width: 512}}">
                                <img class="w-full h-auto" src="{{block.settings.pc_4 | image_url: width: 512}}"  alt="{{block.settings.pc_4.alt}}" loading="lazy">
                            </picture>
                        </div>
                    </div>
                </div>
            </div>

            <div class="w-full lg:j-w-1200 flex-center flex-col absolute left-1/2 top-0 -translate-x-1/2 text-white z-8">
                <h2 class="mt-150 lg:j-mt-240 text-45 leading-66 lg:j-text-40 lg:j-leading-48 font-600">{{block.settings.title | newline_to_br}}</h2>
                <h4 class="mt-15 lg:j-mt-20 text-28 leading-36 lg:j-text-24 lg:j-leading-36 font-600">{{block.settings.collection_type | newline_to_br}}</h4>
                <p class="px-60 lg:j-px-0 text-20 leading-30 lg:j-text-24 lg:j-leading-36 font-300 mt-20 lg:j-mt-10 text-center">{{block.settings.subtitle | newline_to_br}}</p>
            </div>
        {% endfor %}
    </div>
</div>

{% schema %}
    {
      "name": "Solar Generator Main",
      "class": "section section-solar-generator-main section-sp-pps-sg-collection",
      "settings": [],
      "blocks": [
          {
            "type": "product-banner",
            "name": "Product Banner",
            "settings": [
                {"type": "textarea", "id": "title", "label": "Banner title", "default": "Solar Generator Pro"},
                {"type": "textarea", "id": "collection_type", "label": "Collection Product Model", "default": "2000Pro | 1500Pro | 1000Pro"},
                {"type": "textarea", "id": "subtitle", "label": "Collection introduction", "default": "With considerable capacity and high operating power, the powerful High Capacity range gives you the power to run larger appliances and equipment in all the uses you will encounter. It is your first choice for emergency, outdoor work, RV and dry camping."},
                {"type": "image_picker", "id": "pc_1", "label": "background image 1"},
                {"type": "image_picker", "id": "pc_2", "label": "background image 2"},
                {"type": "image_picker", "id": "pc_3", "label": "background image 3"},
                {"type": "image_picker", "id": "pc_4", "label": "background image 4"}
            ]
          }
        ]
    }
{% endschema %}
    
