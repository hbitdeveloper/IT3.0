{% comment %} 反向无缝滚动 {% endcomment %}
<div class="py-80 lg:j-py-120">
    <h2 class="collection-title">{{section.settings.title | newline_to_br}}</h2>
    {% assign index = 0 %}
    {% for block in section.blocks %}
        {% capture index %}{{ index | plus:1 }}{% endcapture %}
        <div class="swiper swiper-explore-{{index}} {% if index != 1 %} mt-16 lg:j-mt-16 {% endif %} swiper-no-swiping">
            <div class="swiper-wrapper swiper-explore-wrapper">
                <div class="swiper-slide w-auto relative">
                    {% if block.settings.link_1 != blank %}
                        <a href="{{block.settings.link_1}}">
                            <img
                                class="w-890 h-530 lg:j-w-570 lg:j-h-339 object-cover rounded-12 lg:j-rounded-12"
                                src="{{block.settings.banner_1 | image_url: width: 1800}}"
                                alt="" loading="lazy"
                            />
                            <h3 class="jky-text-sm text-white font-600 absolute right-60 bottom-30 lg:j-right-45 lg:j-bottom-25">{{block.settings.title_1 | escape}}</h3>
                        </a>
                    {% else %}
                        <div>
                            <img
                                class="w-890 h-530 lg:j-w-570 lg:j-h-339 object-cover rounded-12 lg:j-rounded-12"
                                src="{{block.settings.banner_1 | image_url: width: 1800}}"
                                alt="" loading="lazy"
                            />
                            <h3 class="jky-text-sm text-white font-600 absolute right-60 bottom-30 lg:j-right-45 lg:j-bottom-25">{{block.settings.title_1 | escape}}</h3>
                        </div>
                    {% endif %}
                </div>
                <div class="swiper-slide w-auto relative">
                    {% if block.settings.link_2 != blank %}
                        <a href="{{block.settings.link_2}}">
                            <img
                                class="w-890 h-530 lg:j-w-570 lg:j-h-339 object-cover rounded-12 lg:j-rounded-12"
                                src="{{block.settings.banner_2 | image_url: width: 1800}}"
                                alt="" loading="lazy"
                            />
                            <h3 class="jky-text-sm text-white font-600 absolute right-60 bottom-30 lg:j-right-45 lg:j-bottom-25">{{block.settings.title_2 | escape}}</h3>
                        </a>
                    {% else %}
                        <div>
                            <img
                                class="w-890 h-530 lg:j-w-570 lg:j-h-339 object-cover rounded-12 lg:j-rounded-12"
                                src="{{block.settings.banner_2 | image_url: width: 1800}}"
                                alt="" loading="lazy"
                            />
                            <h3 class="jky-text-sm text-white font-600 absolute right-60 bottom-30 lg:j-right-45 lg:j-bottom-25">{{block.settings.title_2 | escape}}</h3>
                        </div>
                    {% endif %}
                </div>
                <div class="swiper-slide w-auto relative">
                    {% if block.settings.link_3 != blank %}
                        <a href="{{block.settings.link_3}}">
                            <img
                                class="w-890 h-530 lg:j-w-570 lg:j-h-339 object-cover rounded-12 lg:j-rounded-12"
                                src="{{block.settings.banner_3 | image_url: width: 1800}}"
                                alt="" loading="lazy"
                            />
                            <h3 class="jky-text-sm text-white font-600 absolute right-60 bottom-30 lg:j-right-45 lg:j-bottom-25">{{block.settings.title_3 | escape}}</h3>
                        </a>
                    {% else %}
                        <div>
                            <img
                                class="w-890 h-530 lg:j-w-570 lg:j-h-339 object-cover rounded-12 lg:j-rounded-12"
                                src="{{block.settings.banner_3 | image_url: width: 1800}}"
                                alt="" loading="lazy"
                            />
                            <h3 class="jky-text-sm text-white font-600 absolute right-60 bottom-30 lg:j-right-45 lg:j-bottom-25">{{block.settings.title_3 | escape}}</h3>
                        </div>
                    {% endif %}
                </div>
                <div class="swiper-slide w-auto relative">
                    {% if block.settings.link_4 != blank %}
                        <a href="{{block.settings.link_4}}">
                            <img
                                class="w-890 h-530 lg:j-w-570 lg:j-h-339 object-cover rounded-12 lg:j-rounded-12"
                                src="{{block.settings.banner_4 | image_url: width: 1800}}"
                                alt="" loading="lazy"
                            />
                            <h3 class="jky-text-sm text-white font-600 absolute right-60 bottom-30 lg:j-right-45 lg:j-bottom-25">{{block.settings.title_4 | escape}}</h3>
                        </a>
                    {% else %}
                        <div>
                            <img
                                class="w-890 h-530 lg:j-w-570 lg:j-h-339 object-cover rounded-12 lg:j-rounded-12"
                                src="{{block.settings.banner_4 | image_url: width: 1800}}"
                                alt="" loading="lazy"
                            />
                            <h3 class="jky-text-sm text-white font-600 absolute right-60 bottom-30 lg:j-right-45 lg:j-bottom-25">{{block.settings.title_4 | escape}}</h3>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{% schema %}
    {
        "name": "Explore Further",
        "class": "section section-collection-explore-further section-sp-pps-sg-collection",
        "settings": [
            {"type": "textarea", "id": "title", "label": "Explore Title", "default": "Explore Further With Jackery"}
        ],
        "blocks": [
            {
                "type": "explore-banner",
                "name": "Explore Banner",
                "settings": [
                    {"type": "text", "id": "title_1", "label": "Banner 1 title"},
                    {"type": "image_picker", "id": "banner_1", "label": "banner image 1"},
                    {"type": "url", "id": "link_1", "label": "Banner Link"},
                    
                    {"type": "text", "id": "title_2", "label": "Banner 2 title"},
                    {"type": "image_picker", "id": "banner_2", "label": "banner image 2"},
                    {"type": "url", "id": "link_2", "label": "Banner Link"},

                    {"type": "text", "id": "title_3", "label": "Banner 3 title"},
                    {"type": "image_picker", "id": "banner_3", "label": "banner image 3"},
                    {"type": "url", "id": "link_3", "label": "Banner Link"},

                    {"type": "text", "id": "title_4", "label": "Banner 4 title"},
                    {"type": "image_picker", "id": "banner_4", "label": "banner image 4"},
                    {"type": "url", "id": "link_4", "label": "Banner Link"}
                ]
            }
        ]
    }
{% endschema %}
