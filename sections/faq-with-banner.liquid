<style>  
    .faq-container {
        margin-top: 7.5rem;
        position: relative;
        padding-top: 480px;
        padding-bottom: 90px;
    }
    .section-faq-withbanner .faq-container-noimg {
        padding-top: 0;
    }
    .faq-banner {
        width: 100%;
        max-width: 1920px;
        height: var(--faq-img-h-pc, 600px);
        position: absolute;
        object-fit: cover;
        left: 50%;
        transform: translateX(-50%);
        top: 0;
    }
    .faq-main {
        position: relative;
        z-index: 2;
        background: #fff;
        border-radius: 30px;
        padding: 100px 50px 80px;
    }
    .faq-main .main-title {
        margin-bottom: 60px;
    }
    .faq-main .swiper-thumbs .swiper-slide .jky-text-lg {
        font-weight: 400;
    }
    .faq-main .swiper-thumbs {
        border-bottom: 1px solid #CCCCCC;
        padding-bottom: 30px!important;
        margin-bottom: 90px;
    }
    .faq-main .swiper-thumbs .swiper-slide {
        width: max-content;
        padding-right: 80px;
    }
    .faq-main .swiper-thumbs .swiper-slide:last-child {
        padding-right: 0;
    }
    .faq-main .swiper-thumbs .swiper-slide-thumb-active .jky-text-lg {
        border-bottom: 2px solid var(--primary-color);
    }
    .faq-swiper-main {
        width: 100%;
        max-width: 800px;
    }
    .faq-main .z-button-fill-middle {
        margin: 50px auto 0;
    }
    .faq-main .swiper-thumbs .swiper-wrapper {
        padding: 0 30px;
    }
    @media screen and (max-width: 768px) {
        .image-banner-title {
            color: #333!important;
        }
        .faq-container {
            margin-top: 14vw;
            padding-top: 52.4vw;
            padding-bottom: 14.666vw;
        }
        .section-faq-withbanner .faq-container-noimg {
            padding-top: 0;
        }
        .faq-banner {
            max-width: 750px;
            height: calc(var(--faq-img-h-mb, 500) / 7.5 * 1vw);
        }
        .faq-main {
            border-radius: 3.866vw;
            padding: 12vw 0 14.666vw;
            max-width: 94vw!important;
        }
        .faq-main .main-title {
            margin-bottom: 6.666vw;
        }
        .faq-main .swiper {
            margin: 0 10px;
        }
        .faq-main .swiper-thumbs {
            padding-bottom: 3.33vw!important;
            margin-bottom: 6vw;
        }
        .faq-accordion-menu {
            padding: 0 5vw;
        }
        .faq-main .swiper-thumbs .swiper-slide {
            padding-right: 5.333vw;
        }
        .faq-main .swiper-thumbs .swiper-wrapper {
            padding: 0;
        }
        .faq-main .z-button-fill-middle {
            margin: 6.66vw auto 0;
            padding: 1.866vw 6.5vw;
        }
    }

    .faq-accordion-menu {
        width: 100%;
        margin: 0 auto;
    }
    
    .faq-accordion-menu li.open .dropdownlink .jackery-icon-arrow-right {
        transform: rotate(270deg);
    }
    
    .faq-accordion-menu li:last-child .dropdownlink {
        border-bottom: 0;
    }
    
    .dropdownlink {
        cursor: pointer;
        padding: 37px 10px;
        border-bottom: 1px solid #ccc;
        transition: all 0.2s ease-out;
        font-weight: 500;
        text-align: left;
    }
    
    .faq-accordion-menu li.open .dropdownlink {
        border-color: transparent;
    }
    
    .submenu-content {
        text-align: left;
        border-bottom: solid 1px #ccc;
        padding-bottom: 37px;
    }
    
    .dropdownlink .jackery-icon-arrow-right {
        transform: rotate(90deg);
        transition: transform .2s;
    }
    
    .submenuItems {
        display: none;
    }

    .faq-accordion-menu li {
        display: none;
    }

    .faq-accordion-menu.active li {
        display: block;
    }
    
    .faq-accordion-menu li:nth-child(-n+3) {
        display: block;
    }
    @media screen and (max-width: 768px) {
        .dropdownlink {
            padding: 5.2vw 0;
        }
        .submenu-content {
            padding-bottom: 5.2vw;
        }
    }
    .section-faq-withbanner .z-button-fill-middle .iconfont {
        transform: rotate(90deg);
        transition: all .3s;
    }
    .section-faq-withbanner .z-button-fill-middle.active {
        background: transparent!important;
    }
    .section-faq-withbanner .z-button-fill-middle.active .iconfont {
        transform: rotate(270deg);
        color: var(--primary-color)!important;
    }
    .section-faq-withbanner .z-button-fill-middle.active span {
        color: var(--primary-color)!important;
    }
</style>

<div class="faq-container flex justify-center {% if section.settings.faq_image == blank  %} faq-container-noimg{% endif %}" style="background: {{section.settings.bg_color | default: '#F6F6F6'}}; --faq-img-h-pc: {{ section.settings.faq_img_h_pc | default: 600 }}px; --faq-img-h-mb: {{ section.settings.faq_img_h_mb | default: 500 }};">
    {% if section.settings.faq_image != blank %}
        {% render 'responsive-image', image: section.settings.faq_image, mimage: section.settings.faq_image, image_class: 'faq-banner'  %}
    {% endif %}

    {% assign options = '' %}
    <div class="faq-main section-container">
        <h2 class="text-center jky-text-2xl font-bold main-title">FAQ</h2>

        <div class="swiper {% if section.settings.show_cate != false %}swiper-thumbs{% endif %}" {% if section.settings.show_cate == false %}style="display: none;"{% endif %}>
            <div class="swiper-wrapper"> 
                {% for block in section.blocks %}
                    {% assign options = options | append: ',' | append: block.settings.faq_cate %}
                {% endfor %}
                {% assign options = options | remove_first: ',' | split: ',' | uniq %}
                {% for option in options %}
                    <div class="swiper-slide">
                        <div class="jky-text-lg underlines-btn">{{option}}</div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {% if section.settings.show_cate != false %}
        <div class="swiper faq-swiper-main">
            <div class="swiper-wrapper">
                {% for option in options %}
                    <div class="swiper-slide">
                        <ul class="faq-accordion-menu">
                        {% for block in section.blocks %}
                                {% if block.settings.faq_cate == option %}
                                    <li>
                                        <h3 class="dropdownlink jky-text-lg flex justify-between items-center">
                                            {{block.settings.title | newline_to_br}}
                                            {% comment %} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-base"></jds-icon> {% endcomment %}
                                            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-base"></jds-icon>
                                        </h3>
                                        <ul class="submenuItems">
                                            <div class="submenu-content jky-text-base">{{block.settings.faq_content | newline_to_br}}</div>
                                        </ul>
                                    </li>
                                {% endif %}
                        {% endfor %} 
                        </ul>
                    </div> 
                {% endfor %}
            </div>
        </div>
        {% else %}
        <ul class="faq-accordion-menu">
            {% for block in section.blocks %}
                <li>
                    <h3 class="dropdownlink jky-text-lg flex justify-between items-center">
                        {{block.settings.title | newline_to_br}}
                        <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-base"></jds-icon>
                    </h3>
                    <ul class="submenuItems">
                        <div class="submenu-content jky-text-base">{{block.settings.faq_content | newline_to_br}}</div>
                    </ul>
                </li>
            {% endfor %}
        </ul>
        {% endif %}

        <div
            class="z-button-fill-middle"
            data-more="{{'general.action_text.view_more' | t}}"
            data-less="{{'general.action_text.view_less' | t}}"
        >
            <span data-text>{{'general.action_text.view_more' | t}}</span>
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-base"></jds-icon>
        </div>
    </div>
</div>

<script type="module">
    const sectionId = "#shopify-section-{{ section.id }} ";
    const sectionIdNoSpace = "#shopify-section-{{ section.id }}";
    const Accordion = function(el, multiple) {
        this.el = el || null;
        this.multiple = multiple || false;
        if (!this.el) return;

        const firstSubmenu = this.el.querySelector('.submenuItems');
        if (firstSubmenu) {
            this.slideToggle(firstSubmenu);
            firstSubmenu.parentElement?.classList.add('open');
        }

        const dropdownLinks = this.el.querySelectorAll('.dropdownlink');
        dropdownLinks.forEach((dropdown) => {
            if (dropdown.__accordionDropdownHandler) {
                dropdown.removeEventListener('click', dropdown.__accordionDropdownHandler);
            }

            const handler = this.dropdown.bind(this);
            dropdown.__accordionDropdownHandler = handler;
            dropdown.addEventListener('click', handler);
        });
    };

    Accordion.prototype.slideUp = function(target, duration = 300) {
        if (!target) return;
        target.style.height = `${target.offsetHeight}px`;
        target.offsetHeight;
        target.style.transitionProperty = 'height, margin, padding';
        target.style.transitionDuration = `${duration}ms`;
        target.style.overflow = 'hidden';
        target.style.height = '0';
        target.style.paddingTop = '0';
        target.style.paddingBottom = '0';
        target.style.marginTop = '0';
        target.style.marginBottom = '0';

        window.setTimeout(() => {
            target.style.display = 'none';
            target.style.removeProperty('height');
            target.style.removeProperty('padding-top');
            target.style.removeProperty('padding-bottom');
            target.style.removeProperty('margin-top');
            target.style.removeProperty('margin-bottom');
            target.style.removeProperty('overflow');
            target.style.removeProperty('transition-duration');
            target.style.removeProperty('transition-property');
        }, duration);
    };

    Accordion.prototype.slideDown = function(target, duration = 300) {
        if (!target) return;
        target.style.removeProperty('display');
        let display = window.getComputedStyle(target).display;
        if (display === 'none') display = 'block';
        target.style.display = display;

        const height = target.scrollHeight;
        target.style.overflow = 'hidden';
        target.style.height = '0';
        target.style.paddingTop = '0';
        target.style.paddingBottom = '0';
        target.style.marginTop = '0';
        target.style.marginBottom = '0';
        target.offsetHeight;
        target.style.transitionProperty = 'height, margin, padding';
        target.style.transitionDuration = `${duration}ms`;
        target.style.height = `${height}px`;
        target.style.removeProperty('padding-top');
        target.style.removeProperty('padding-bottom');
        target.style.removeProperty('margin-top');
        target.style.removeProperty('margin-bottom');

        window.setTimeout(() => {
            target.style.removeProperty('height');
            target.style.removeProperty('overflow');
            target.style.removeProperty('transition-duration');
            target.style.removeProperty('transition-property');
        }, duration);
    };

    Accordion.prototype.slideToggle = function(target, duration = 300) {
        if (!target) return;
        if (window.getComputedStyle(target).display === 'none') {
            this.slideDown(target, duration);
        } else {
            this.slideUp(target, duration);
        }
    };

    Accordion.prototype.dropdown = function(event) {
        const current = event.currentTarget;
        const next = current?.nextElementSibling;
        this.slideToggle(next);
        current?.parentElement?.classList.toggle('open');

        if (!this.multiple) {
            this.el.querySelectorAll('.submenuItems').forEach((item) => {
                if (item === next) return;
                this.slideUp(item);
                item.parentElement?.classList.remove('open');
            });
        }
    };

    const initFaqWithBanner = function() {
        const sectionRoot = document.querySelector(sectionIdNoSpace);
        if (!sectionRoot) return;

        new Accordion(sectionRoot, false);

        const toggleBtn = sectionRoot.querySelector('.faq-main .z-button-fill-middle');
        const textDOM = toggleBtn?.querySelector('[data-text]');
        const moreText = toggleBtn?.dataset.more || '';
        const viewText = toggleBtn?.dataset.less || '';

        const getActiveSlide = function() {
            return sectionRoot.querySelector('.faq-main .faq-swiper-main .swiper-slide-active');
        };

        const getTargetMenus = function() {
            const activeSlide = getActiveSlide();
            if (activeSlide) return activeSlide.querySelectorAll('.faq-accordion-menu');
            const swiperMenus = sectionRoot.querySelectorAll('.faq-main .faq-swiper-main .swiper-slide .faq-accordion-menu');
            if (swiperMenus.length) return swiperMenus;
            return sectionRoot.querySelectorAll('.faq-main > .faq-accordion-menu');
        };

        const updateToggleBtnDisplay = function() {
            if (!toggleBtn) return;
            const activeSlide = getActiveSlide();
            let count;
            if (activeSlide) {
                count = activeSlide.querySelectorAll('.faq-accordion-menu li').length;
            } else {
                const swiperLis = sectionRoot.querySelectorAll('.faq-swiper-main .swiper-slide .faq-accordion-menu li');
                if (swiperLis.length) {
                    count = swiperLis.length;
                } else {
                    count = sectionRoot.querySelectorAll('.faq-main > .faq-accordion-menu li').length;
                }
            }
            toggleBtn.style.display = count > 3 ? 'flex' : 'none';
        };

        updateToggleBtnDisplay();

        if (toggleBtn) {
            if (toggleBtn.__faqToggleHandler) {
                toggleBtn.removeEventListener('click', toggleBtn.__faqToggleHandler);
            }

            const toggleHandler = function() {
                const isActive = toggleBtn.classList.contains('active');
                const targetMenus = getTargetMenus();

                targetMenus.forEach((menu) => {
                    menu.classList.toggle('active', !isActive);
                });
                toggleBtn.classList.toggle('active', !isActive);
                if (textDOM) textDOM.textContent = isActive ? moreText : viewText;
            };

            toggleBtn.__faqToggleHandler = toggleHandler;
            toggleBtn.addEventListener('click', toggleHandler);
        }

        if (sectionRoot.querySelector('.faq-main .swiper-thumbs')) {
            const swiperFaqCate = new Swiper(sectionIdNoSpace + ".section-faq-withbanner .swiper-thumbs", {
                slidesPerView: 'auto',
                freeMode: true,
                clickable: true,
            });

            new Swiper(sectionIdNoSpace + ".section-faq-withbanner .faq-swiper-main", {
                spaceBetween: 0,
                slidesPerView: 1,
                thumbs: {
                    swiper: swiperFaqCate
                },
                on: {
                    slideChangeTransitionEnd: function() {
                        sectionRoot.querySelectorAll(".faq-main .faq-swiper-main .faq-accordion-menu").forEach((menu) => {
                            menu.classList.remove('active');
                        });
                        toggleBtn?.classList.remove('active');
                        if (textDOM) textDOM.textContent = moreText;
                        updateToggleBtnDisplay();
                    }
                },
            });
        }
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFaqWithBanner, { once: true });
    } else {
        initFaqWithBanner();
    }
</script>

{% schema %}
{
    "name": "Section FAQ",
    "class": "section section-faq-withbanner",
    "settings": [
        {
            "type": "color_background",
            "id": "bg_color",
            "label": "背景颜色",
            "default": "#F6F6F6"
        },
        {"type": "image_picker", "id": "faq_image", "label": "FAQ Banner Image"},
        {"type": "number", "id": "faq_img_h_pc", "label": "FAQ Image PC Height", "default": 600 },
        {"type": "number", "id": "faq_img_h_mb", "label": "FAQ Image MB Height", "default": 500 },
        {"type": "checkbox", "id": "show_cate", "label": "Show category?", "default": true}
    ],
    "blocks": [
        {
            "type": "faq_item", "name": "FAQ item",
            "settings": [
                {"type": "textarea", "id": "title", "label": "FAQ title"},
                {"type": "textarea", "id": "faq_content", "label": "FAQ Answer"},
                {"type": "text", "id": "faq_cate", "label": "FAQ category name", "default": "default cate"}
            ]
        }
    ],
    "presets": [
        {
            "name": "Section FAQ",
            "category": "光伏安装",
            "settings": {
                "show_cate": false
            },
            "blocks": [
                {
                    "type": "faq_item",
                    "name": "FAQ item",
                    "settings": {
                        "title": "Can I use the Jackery portable power station to charge my devices?",
                        "faq_content": "The Jackery power stations can run devices at 110V AC (120V for the Explorer Pro E1000/2000 series) or 12V DC and up to the power capacity of the generator. (For example, an Explorer 240, with 240W power capacity will not run a 1000W appliance).",
                        "faq_cate": "CATE_DEFAULT"
                    }
                },
                {
                    "type": "faq_item",
                    "name": "FAQ item",
                    "settings": {
                        "title": "Is your power bank no longer for sale?",
                        "faq_content": "We are sorry to inform you that we have discontinued the sale and manufacturing of our portable power banks, such as the Bolt/Bar/Giant. Our main product line is the Explorer Power station.",
                        "faq_cate": "CATE_DEFAULT"
                    }
                },
                {
                    "type": "faq_item",
                    "name": "FAQ item",
                    "settings": {
                        "title": "Are the Jackery power stations equipped with MPPT (Maximum Power Point Tracking) ?",
                        "faq_content": "Yes, all Jackery power stations have a built-in MPPT (Maximum Power Point Tracking) controller.",
                        "faq_cate": "CATE_DEFAULT"
                    }
                },
                {
                    "type": "faq_item",
                    "name": "FAQ item",
                    "settings": {
                        "title": "Do you offer a wind turbine as a recharging method?",
                        "faq_content": "We have a conceptual design for a wind turbine that was introduced at the IFA event in Germany earlier this year. Our engineering team is working on fine-tuning the design before we can officially release any additional information.",
                        "faq_cate": "CATE_DEFAULT"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
