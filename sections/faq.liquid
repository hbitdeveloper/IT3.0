{% assign FAQ_SG = section.blocks | where: 'type', "FAQ_SG" %}
{% assign FAQ_PPS = section.blocks | where: 'type', "FAQ_PPS" %}
{% assign FAQ_SP = section.blocks | where: 'type', "FAQ_SP" %}
{% assign FAQ_ACC = section.blocks | where: 'type', "FAQ_ACC" %}

<style>
.accordion {width: 100%;}
.accordion .icon-arrow-down {transition: all 0.3s;}
.accordion ul li {display: flex; flex-flow: column; border-bottom: var(--border-grey); margin-bottom: 2.6042vw;}
.accordion ul li:last-of-type {border-bottom: none;}
.accordion ul li h3, .accordion ul li h4 {font-weight: 500; display: flex; align-items: center; justify-content: space-between;}
.accordion ul li input {opacity: 0; display: none;}
.accordion label {margin-bottom: var(--gap); cursor: pointer;}
.accordion .a_content {max-height: 0; padding-bottom: 0; overflow-y: hidden; transition: all 0.3s;}
.accordion .a_content p {font-size: 18px;}

.accordion ul li input:checked ~ label .icon-arrow-down {transform: rotate(180deg);}
.accordion ul li input:checked ~ .a_content {max-height: 1000px; padding-bottom: 2.6042vw;}

.faq .accordion {max-width: 800px; margin: 0 auto;}

.faq .minimum ul li {display: none;}
.faq .minimum.accordion ul li:nth-child(1),
.faq .minimum.accordion ul li:nth-child(2),
.faq .minimum.accordion ul li:nth-child(3) {display: flex;}

.faq .minimum .z-button-fill-middle span::before {content: "{{ 'general.action_text.view_more' | t }}"}
.faq .z-button-fill-middle span::before {content: "{{ 'general.action_text.view_less' | t }}";}

.accordion:not(.minimum) .z-button-fill-middle .icon-arrow-down {transform: rotate(180deg);}

@media only screen and (max-width: 768px) {
  .accordion .a_content p {font-size: 14px;}
}
</style>

<h2 class="jky-text-2xl">{{ section.settings.title }}</h2>
<div class="tab-container">
  <ul class="tab">
    {% if FAQ_SG.size > 0 %}<li class="jky-text-lg underlines-btn active" data-type="sg">{{ 'collection.solar_generator' | t }}</li>{% endif %}
    {% if FAQ_PPS.size > 0 %}<li class="jky-text-lg underlines-btn" data-type="pps">{{ 'collection.portable_power_station' | t }}</li>{% endif %}
    {% if FAQ_SP.size > 0 %}<li class="jky-text-lg underlines-btn" data-type="sp">{{ 'collection.solar_panel' | t }}</li>{% endif %}
    {% if FAQ_ACC.size > 0 %}<li class="jky-text-lg underlines-btn" data-type="acc">{{ 'collection.accessories' | t }}</li>{% endif %}
  </ul>
</div>

{% if FAQ_SG.size > 0 %}
<div class="accordion tab-content sg active minimum">
  <ul>
    {% for block in FAQ_SG %}
    <li>
      <input type="checkbox" id="{{ block.type }}_{{ forloop.index0 }}">
      <label for="{{ block.type }}_{{ forloop.index0 }}">
        <h3 class="jky-text-lg">{{ block.settings.title }}
          {% comment %} <i class="iconfont jackery-icon-arrowdown"></i> {% endcomment %}
          <jds-icon name="arrow-down" class="iconfont icon-arrow-down"></jds-icon>
        </h3>
      </label>
      <div class="a_content">{{ block.settings.content }}</div>
    </li>
    {% endfor %}
  </ul>

  {% if FAQ_SG.size > 3 %}
  <button class="z-button-fill-middle"><span></span>&nbsp;
    {% comment %} <i class="iconfont jackery-icon-arrowdown"></i> {% endcomment %}
    <jds-icon name="arrow-down" class="iconfont icon-arrow-down"></jds-icon>
  </button>
  {% endif %}
</div>
{% endif %}

