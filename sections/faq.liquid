{% unless settings.enable_faq_schema %}
<script class="seoai-schema" type="application/ld+json">
  {%- capture faq_list -%}
    {%- assign faq_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if faq_count >= 10 -%}{%- break -%}{%- endif -%}
      {%- if faq_count > 0 -%},{%- endif -%}
      {
        "@type": "Question",
        "name": {{ block.settings.title  | strip_html | truncate: 180 | strip | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.content | strip_html | truncate: 300 | strip | json }}
        }
      }
      {%- assign faq_count = faq_count | plus: 1 -%}
    {%- if faq_count >= 10 -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{{ faq_list }}]
  }
</script>
{% endunless %}

{% schema %}
{
  "name": "user guide faq", "class": "layer layer-container manuals faq", "tag": "div",
  "settings": [
    {"type": "text", "id": "title", "label": "title", "default": "FAQ"}
  ],
  "blocks": [
    {
      "type": "FAQ_SG", "name": "Solar Generator FAQ", "settings": [
        {"type": "text", "id": "title", "label": "FAQ title", "default": "title"},
        {"type": "richtext", "id": "content", "label": "FAQ content", "default": "<p>content</p>"}
      ]
    },
    {
      "type": "FAQ_PPS", "name": "Power Station FAQ", "settings": [
        {"type": "text", "id": "title", "label": "FAQ title", "default": "title"},
        {"type": "richtext", "id": "content", "label": "FAQ content", "default": "<p>content</p>"}
      ]
    },
    {
      "type": "FAQ_SP", "name": "Solar Panel FAQ", "settings": [
        {"type": "text", "id": "title", "label": "FAQ title", "default": "title"},
        {"type": "richtext", "id": "content", "label": "FAQ content", "default": "<p>content</p>"}
      ]
    },
    {
      "type": "FAQ_ACC", "name": "Accessories FAQ", "settings": [
        {"type": "text", "id": "title", "label": "FAQ title", "default": "title"},
        {"type": "richtext", "id": "content", "label": "FAQ content", "default": "<p>content</p>"}
      ]
    }
  ]
}
{% endschema %}
