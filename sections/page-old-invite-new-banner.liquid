<section class="w-full bg-white flex-center flex-col px-30 pt-32 pb-40 mb-20 lg:mb-0 lg:j-pt-56 lg:j-pb-85 lg:px-0 xl:a-pt-56 xl:a-pb-85">
  {% comment %} 骨架屏 {% endcomment %}
  <div class="old-invite-new-skeleton-wrap w-full flex flex-col items-end rounded-20 lg:j-w-1376 lg:j-h-560 lg:j-pr-58 lg:j-pt-40 lg:j-pb-30 lg:j-rounded-36 xl:a-w-1376 xl:a-h-560 xl:a-pr-58 xl:a-pt-40 xl:a-pb-30 xl:a-rounded-36 relative">
    <div class="w-full static lg:absolute inset-0 lg:z-0 w-full h-480 rounded-20 lg:j-w-1376 lg:j-h-560 lg:j-rounded-36 xl:a-w-1376 xl:a-h-560 xl:a-rounded-36 old-invite-new-skeleton-wrap-bg"></div>

    <div class="w-full relative z-1 mt-20 px-40 pt-24 pb-65 rounded-20 lg:w-auto lg:rounded-0 lg:mt-0 lg:p-0 lg:bg-transparent old-invite-new-skeleton-content-bg">
      <h2 class="flex flex-col w-full gap-y-8 lg:j-w-452 lg:j-gap-y-10 xl:a-w-452 xl:a-gap-y-10">
        <span class="w-full h-52 lg:j-h-40 xl:a-h-40 skeleton"></span>
        <span class="w-full h-52 lg:j-h-40 xl:a-h-40 skeleton"></span>
        <span class="w-1/2 h-52 lg:j-h-40 xl:a-h-40 skeleton"></span>
      </h2>
      <p class="flex flex-col mt-30 w-full gap-y-12 lg:j-w-452 lg:j-gap-y-10 lg:j-mt-25 xl:a-w-452 xl:a-gap-y-10 xl:a-mt-25 ">
        <span class="w-full h-28 lg:j-h-16 xl:a-h-16 skeleton"></span>
        <span class="w-full h-28 lg:j-h-16 xl:a-h-16 skeleton"></span>
        <span class="w-full h-28 lg:j-h-16 xl:a-h-16 skeleton"></span>
        <span class="w-1/2 h-28 lg:j-h-16 xl:a-h-16 skeleton"></span>
      </p>
      <div class="w-full mt-58 lg:j-w-452 lg:j-mt-50 xl:a-w-452 xl:a-mt-50">
        <span class="w-full flex h-80 rounded-40 lg:j-w-400 xl:a-w-400 lg:j-h-48 lg:j-rounded-24 xl:a-h-48 xl:a-rounded-24 skeleton"></span>
        <span class="w-full flex h-80 rounded-40 mt-24 lg:j-w-400 lg:j-h-48 lg:j-rounded-24 lg:j-mt-16 xl:a-w-400 xl:a-h-48 xl:a-rounded-24 xl:a-mt-16 skeleton"></span>
        <span class="w-full flex h-28 mt-32 lg:j-w-300 lg:j-h-16 lg:j-mt-16 xl:a-w-300 xl:a-h-16 xl:a-mt-16 skeleton"></span>
      </div>
    </div>
  </div>

  {% comment %} Banner 区域 {% endcomment %}
  <div
    class="!hidden old-invite-new-banner-wrap w-full flex flex-col items-end rounded-20 lg:j-w-1376 lg:j-h-560 lg:j-pr-58 lg:j-pt-40 lg:j-pb-30 lg:j-rounded-36 xl:a-w-1376 xl:a-h-560 xl:a-pr-58 xl:a-pt-40 xl:a-pb-30 xl:a-rounded-36 relative"
    data-email-empty-error-text="{{'newsletter.email_empty_info' | t}}"
    data-email-format-error-text="{{'newsletter.email_error_info' | t}}"
    data-email-message-sent="{{'oldInviteNew.email_message_sent' | t}}"
  >
    <div class="w-full static hidden lg:block lg:absolute inset-0 lg:z-0 w-full h-480 rounded-20 lg:j-w-1376 lg:j-h-560 lg:j-rounded-36 xl:a-w-1376 xl:a-h-560 xl:a-rounded-36 old-invite-new-skeleton-wrap-bg"></div>

    <div class="old-invite-new-banner-img-container w-full max-h-480 h-480 lg:j-max-h-560 lg:j-h-560 xl:a-max-h-560 xl:a-h-560 static lg:absolute inset-0 lg:z-0 overflow-hidden transition-max-height duration-300">
      <img class="block lg:hidden w-full h-480 rounded-20" data-banner-img-mb src="" alt="" loading="lazy">
      <img class="hidden lg:block lg:j-w-1376 lg:j-h-560 lg:j-rounded-36 xl:a-w-1376 xl:a-h-560 xl:a-rounded-36" data-banner-img-pc src="" alt="" loading="lazy">
    </div>

    {% comment %} 右边文字部分 {% endcomment %}
    <div class="w-full relative z-1 mt-20 bg-#FDF8F0 px-40 pt-24 pb-65 rounded-20 lg:w-auto lg:rounded-0 lg:mt-0 lg:p-0 lg:bg-transparent" data-old-invite-new-banner-content>
      <h2
        class="font-semibold flex items-end w-full text-52 leading-64 lg:j-w-452 lg:j-text-40 lg:j-leading-50 lg:j-h-152 xl:a-w-452 xl:a-text-40 xl:a-leading-50 xl:a-h-152"
        data-old-invite-new-banner-title
      >
        <span class="lg:line-clamp-3 w-full break-word"></span>
      </h2>
      <p
        class="font-normal mt-30 w-full text-28 leading-40 lg:j-w-452 lg:j-h-104 lg:j-text-16 lg:j-leading-26 lg:j-mt-25 xl:a-w-452 xl:a-h-104 xl:a-text-16 xl:a-leading-26 xl:a-mt-25"
        data-old-invite-new-banner-subtitle
      >
        <span class="lg:line-clamp-4 w-full break-word"></span>
      </p>

      {% comment %} 未登录 | 已登录但是未生成分享链接 {% endcomment %}
      <form class="!hidden w-full mt-58 lg:j-w-452 lg:j-mt-50 xl:a-w-452 xl:a-mt-50" data-old-invite-new-form>
        <input
          class="appearance-none font-normal placeholder:text-#666 w-full flex h-80 border-1 rounded-40 text-left text-#1A1A1A border-#B4B4B4 text-28 leading-52 px-34 text-28 lg:j-w-400 xl:a-w-400 lg:j-h-48 lg:j-border-1 lg:j-rounded-24 lg:j-text-16 lg:j-leading-24 lg:j-px-20 xl:a-h-48 xl:a-border-1 xl:a-rounded-24 xl:a-text-16 xl:a-leading-24 xl:a-px-20"
          type="text"
          maxlength="100"
          placeholder="{{'newsletter.email_placeholder' | t}}"
          data-old-invite-new-form-input
        >
        <p class="hidden text-#FE3B30 font-normal text-28 leading-32 mt-12 lg:j-mt-8 lg:j-text-14 lg:j-leading-24 xl:a-mt-8 xl:a-text-14 xl:a-leading-24" data-email-error-tip></p>
        <button
          class="old-invite-new-button old-invite-new-highlight-button w-full h-80 rounded-40 text-28 mt-24 px-34 lg:j-mt-16 lg:j-w-400 lg:j-h-48 lg:j-px-20 lg:j-rounded-24 lg:j-text-16 lg:j-leading-24 xl:a-mt-16 xl:a-w-400 xl:a-h-48 xl:a-px-20 xl:a-rounded-24 xl:a-text-16 xl:a-leading-24"
          type="submit"
          data-old-invite-new-form-button
        >
          <span class="line-clamp-1 w-full break-all"></span>
        </button>

        <label class="!hidden flex items-start mt-32 lg:j-mt-16 xl:a-mt-16" data-policy-error-text="{{'newsletter.policy_empty_info' | t}}">
          <jds-checkbox id="old-invite-new-agree-checkbox" value="true">
            <span
              class="flex-1 font-normal text-#666 cursor-pointer text-26 leading-40 lg:j-text-14 lg:j-leading-24 xl:a-text-14 xl:a-leading-24"
              data-terms_service="{{ section.settings.terms_service | escape }}"
              data-terms_service_url="{{ section.settings.terms_service_url }}"
              data-privacy_policy="{{ section.settings.privacy_policy | escape }}"
              data-privacy_policy_url="{{ section.settings.privacy_policy_url }}"
            >{{ section.settings.sevice_privacy_text | escape }}</span>
          </jds-checkbox>
          
        </label>
        <p class="hidden text-#FE3B30 font-normal text-28 leading-32 mt-12 lg:j-mt-8 lg:j-text-14 lg:j-leading-24 xl:a-mt-8 xl:a-text-14 xl:a-leading-24" data-policy-error-tip></p>
      </form>

      {% comment %} 已生成分享链接 {% endcomment %}
      <div
        class="!hidden w-full mt-58 lg:j-w-452 lg:j-mt-25 xl:a-w-452 xl:a-mt-25"
        data-email-empty-error-text="{{'newsletter.email_empty_info' | t}}"
        data-email-format-error-text="{{'newsletter.email_error_info' | t}}"
        data-old-invite-new-share
      >
        <div class="w-full flex flex-col gap-y-24 lg:flex-row lg:gap-y-0 lg:bg-white lg:j-rounded-24 xl:a-rounded-24">
          <div
            class="shg-fa w-full font-normal lg:w-auto lg:flex-1 bg-white h-80 rounded-40 leading-80 px-34 lg:j-h-48 lg:j-leading-48 lg:j-rounded-l-24 lg:rounded-r-0 lg:j-pl-16 lg:j-pr-8 xl:a-h-48 xl:a-leading-48 xl:a-rounded-l-24 xl:a-pl-16 xl:a-pr-8 line-clamp-1 break-all"
            data-old-invite-new-share-link
          ></div>
          <button
            class="old-invite-new-button old-invite-new-highlight-button w-full lg:w-fit bg-primary text-white font-semibold relative h-80 rounded-40 lg:j-h-48 lg:j-rounded-24 lg:j-px-24 xl:a-h-48 xl:a-rounded-24 xl:a-px-24 disabled:opacity-50"
            data-old-invite-new-copy
            data-copy-text="{{ 'oldInviteNew.copy' | t }}"
            data-copied-text="{{ 'oldInviteNew.copied' | t }}"
            data-copy-success-tip="{{ 'oldInviteNew.copy_success' | t }}"
          >{{ 'oldInviteNew.copy' | t }}</button>
        </div>
        <p class="w-full flex-center font-normal leading-none mt-68 lg:j-text-14 lg:j-mt-24 xl:a-text-14 xl:a-mt-24" data-old-invite-new-media-desc></p>
        <ul
          class="w-full flex-center flex-wrap gap-x-48 gap-y-40 mt-48 lg:j-w-452 lg:j-gap-24 lg:j-mt-30 xl:a-w-452 xl:a-gap-24 xl:a-mt-30"
          data-old-invite-new-share-icons
          data-instagram-copy-success-tip="{{ 'oldInviteNew.instagram_copy_success_tip' | t }}"
          data-email-placeholder="{{ 'oldInviteNew.friend_email' | t }}"
        >
          <li data-type="facebook" title="facebook" class="!hidden flex-center cursor-pointer rounded-full w-72 h-72 lg:j-w-40 lg:j-h-40 xl:a-w-40 xl:a-h-40 !hover:bg-white" style="background: var(--facebook-color)">
            {% render 'icon-facebook-new', class: 'iconfont icon-facebook-new max-w-full max-h-full', width: 40, height: 40, color: 'var(--facebook-icon-color)' %}
          </li>
          <li data-type="twitter" title="twitter" class="!hidden flex-center cursor-pointer rounded-full w-72 h-72 lg:j-w-40 lg:j-h-40 xl:a-w-40 xl:a-h-40 !hover:bg-white" style="background: var(--twitter-color)">
            {% render 'icon-twitter-new', class: 'iconfont icon-twitter-new max-w-full max-h-full', width: 40, height: 40, color: 'var(--twitter-icon-color)' %}
          </li>
          <li data-type="instagram" title="instagram" class="!hidden flex-center cursor-pointer rounded-full w-72 h-72 lg:j-w-40 lg:j-h-40 xl:a-w-40 xl:a-h-40 !hover:bg-white" style="background: var(--instagram-color)">
            {% render 'icon-instagram-new', class: 'iconfont icon-instagram-new max-w-full max-h-full', width: 40, height: 40, color: 'var(--instagram-icon-color)' %}
          </li>
          <li data-type="line" title="line" class="!hidden flex-center cursor-pointer rounded-full w-72 h-72 lg:j-w-40 lg:j-h-40 xl:a-w-40 xl:a-h-40 !hover:bg-white" style="background: var(--line-color)">
            {% render 'icon-line-new', class: 'iconfont icon-line-new max-w-full max-h-full', width: 40, height: 40, color: 'var(--line-icon-color)' %}
          </li>
          <li data-type="whatsapp" title="whatsapp" class="!hidden flex-center cursor-pointer rounded-full w-72 h-72 lg:j-w-40 lg:j-h-40 xl:a-w-40 xl:a-h-40 !hover:bg-white" style="background: var(--whatsapp-color)">
            {% render 'icon-whatsapp-new', class: 'iconfont icon-whatsapp-new max-w-full max-h-full', width: 40, height: 40, color: 'var(--whatsapp-icon-color)' %}
          </li>
          <li data-type="telegram" title="telegram" class="!hidden flex-center cursor-pointer rounded-full w-72 h-72 lg:j-w-40 lg:j-h-40 xl:a-w-40 xl:a-h-40 !hover:bg-white" style="background: var(--telegram-color)">
            {% render 'icon-telegram-new', class: 'iconfont icon-telegram-new max-w-full max-h-full', width: 40, height: 40, color: 'var(--telegram-icon-color)' %}
          </li>
          <li data-type="email" title="email" class="!hidden flex-center cursor-pointer rounded-full w-72 h-72 lg:j-w-40 lg:j-h-40 xl:a-w-40 xl:a-h-40 !hover:bg-white" style="background: var(--email-color)">
            {% render 'icon-email-new', class: 'iconfont icon-email-new max-w-full max-h-full', width: 40, height: 40, color: 'var(--email-icon-color)' %}
          </li>
        </ul>
      </div>

      {% comment %} 关闭活动出现的div {% endcomment %}
       <div class="close-invite" data-old-invite-new-close>
        <div class="text-[#1A1A1A] lg:text-[1.125rem] text-[1rem] leading-[1.44] lg:mb-[1.5rem] mb-[1rem] w-[30rem] w-[20.4375rem] text-center" data-old-invite-new-close-title></div>
        <div class="lg:text-[2rem] text-[1.25rem] lg:leading-[1.5] leading-[1.4] w-[30rem] w-[20.4375rem] text-center" data-old-invite-new-close-content></div>
       </div>
    </div>
  </div>


  {% comment %} Referrals and Rewards {% endcomment %}
  {% if section.settings.referrals_rewards_title != blank or section.settings.referrals_rewards_content != blank or section.settings.referrals_rewards_button_text != blank %}
    <div
      class="
        coin-wrap w-full flex-center flex-col lg:flex-start lg:flex-row rounded-32 px-40 pt-45 pb-75 mt-20 overflow-hidden relative
        lg:j-w-1376 lg:j-h-106 lg:j-rounded-53 lg:j-gap-x-64 lg:j-pl-136 lg:p-0 lg:j-mt-50
        xl:a-w-1376 xl:a-h-106 xl:a-rounded-53 xl:a-gap-x-64 xl:a-pl-136 xl:a-mt-50
      "
      style="background: linear-gradient( 156deg, #DB9F6F 0%, #EDB283 100%);"
      data-animation-dom
    >
      <span class="coin-more"></span>
      {% if section.settings.referrals_rewards_title != blank or section.settings.referrals_rewards_content != blank %}
        <div class="w-full flex-start flex-col gap-y-32 lg:j-w-780 lg:j-gap-y-4 xl:a-w-780 xl:a-gap-y-4 z-1">
          {% if section.settings.referrals_rewards_title != blank %}
            <h2 class="w-full font-semibold text-white text-40 leading-56 lg:line-clamp-1 lg:j-text-28 lg:j-leading-36 xl:a-text-28 xl:a-leading-36">
              {{ section.settings.referrals_rewards_title | newline_to_br }}
            </h2>
          {% endif %}
          {% if section.settings.referrals_rewards_content != blank %}
            <p class="w-full font-medium text-white text-26 leading-36 lg:line-clamp-2 lg:j-text-14 lg:j-leading-22 lg:leading-normal xl:a-text-14 xl:a-leading-22">
              {{ section.settings.referrals_rewards_content | newline_to_br }}
            </p>
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings.referrals_rewards_button_text != blank %}
        <button
          class="old-invite-new-button old-invite-new-login-button"
          data-reward-title="{{ section.settings.referrals_rewards_title | escape }}"
          data-button-text="{{ section.settings.referrals_rewards_button_text | escape }}"
          data-old-invite-new-my-rewards
        >
          <span class="line-clamp-1 w-full break-all">{{ section.settings.referrals_rewards_button_text | escape }}</span>
        </button>
      {% endif %}
    </div>
  {% endif %}
</section>


{% schema %}
  {
    "name": "Old Invite New Banner",
    "class": "section-old-invite-new section-old-invite-new-banner",
    "settings": [
      {
        "type": "text",
        "id": "sevice_privacy_text",
        "label": "as: I agree to Jackery's {termsService} and {PrivacyPolicy}",
        "default": "I agree to Jackery's {termsService} and {PrivacyPolicy}"
      },
      { "type": "text", "id": "terms_service", "label": "terms service text", "default": "Terms of Service" },
      { "type": "url", "id": "terms_service_url", "label": "terms service url" },
      { "type": "text", "id": "privacy_policy", "label": "privacy Policy text", "default": "Privacy Policy" },
      { "type": "url", "id": "privacy_policy_url", "label": "privacy Policy url" },
      {
        "type": "textarea",
        "id": "referrals_rewards_title",
        "label": "Referrals and Rewards Title",
        "default": "Manage Your Referrals and Rewards"
      },
      {
        "type": "textarea",
        "id": "referrals_rewards_content",
        "label": "Referrals and Rewards Content"
      },
      {
        "type": "text",
        "id": "referrals_rewards_button_text",
        "label": "Referrals and Rewards Button Text",
        "default": "My Rewards"
      }
    ]
  }
{% endschema %}
