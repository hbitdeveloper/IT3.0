<style>
    .jky-ces-solutions {
        --solution-h: 358px;
        --solution-mb: 22px;
        --solution-radius: 15px;
        --solution-content-pt: 48px;
        --solution-content-px: 64px;
        --solution-content-pb: 16px;
        --solution-content-title-color: var(--primary-color);
        --solution-content-title-size: 30px;
        --solution-content-title-mb: 12px;
        --solution-content-sub-size: 14px;
        --solution-content-sub-color: rgb(71, 71, 71);
        --solution-content-tips-size: 0.52vw;
        --solution-content-tips-color: #A3A3A3;
        --solution-content-link-color: var(--primary-color);
        --solution-content-link-size: 14px;
        --solution-content-link-mt: 16px;
    }
    .solutions_item {
        height: var(--solution-h);
        overflow: hidden;
        border-radius: var(--solution-radius);
        box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px;
        line-height: 1.1;
        margin-bottom: var(--solution-mb);
        position: relative;
    }
    .solutions_item:nth-child(even) {
        flex-direction: row-reverse;
    }
    .solutions_item picture {flex: 1}
    .solutions_item .solutions_img {
        object-fit: cover;
        height: 100%;
        width: 100%;
    }
    .solutions_item_content {
        flex: 1;
        flex-direction: column;
        justify-content: space-between;
    }
    .ces_solutions_main {
        padding: var(--solution-content-pt) var(--solution-content-px) 0 var(--solution-content-px);
    }
    .solutions_item_title {
        font-size: var(--solution-content-title-size);
        margin-bottom: var(--solution-content-title-mb);
        color: var(--solution-content-title-color);
    }
    .solutions_item_des {
        font-size: var(--solution-content-sub-size);
        color: var(--solution-content-sub-color);
    }
    .solutions_item_link {
        color: var(--solution-content-link-color);
        font-size: var(--solution-content-link-size);
        text-decoration: underline;
        font-weight: 600;
        display: inline-block;
        margin-top: var(--solution-content-link-mt);
    }

    .solutions_item_tips {
        padding: 0 var(--solution-content-px) var(--solution-content-pb) var(--solution-content-px);
        font-size: var(--solution-content-tips-size);
        color: var(--solution-content-tips-color);
    }
    .solutions_content_swiper {
        display: none;
    }
    @media (max-width: 1024px) {
      .jky-ces-solutions {
        --solution-h: 118vw;
        --solution-mb: 22px;
        --solution-radius: 15px;
        --solution-content-pt: 0;
        --solution-content-px: 0;
        --solution-content-pb: 0;
        --solution-content-title-color: #ffffff;
        --solution-content-title-size: 24px;
        --solution-content-title-mb: 12px;
        --solution-content-sub-size: 12px;
        --solution-content-sub-color: rgb(255, 255, 255);
        --solution-content-tips-size: 2vw;
        --solution-content-tips-color: #A3A3A3;
        --solution-content-link-color: var(--primary-color);
        --solution-content-link-size: 12px;
        --solution-content-link-mt: 0;
      }

      .solutions_item {
            position: relative;
        }
        .solutions_item::after {
            content: "";
            position: absolute;
            width: 100%;
            height: 40%;
            left: 0;
            bottom: 0;
            background: linear-gradient(to bottom, rgba(196, 196, 196, 0), rgb(83, 75, 74));
        }
        .solutions_item_content {
            display: none;
        }
        .solutions_content_swiper .swiper-wrapper {
            align-items: flex-end;
        }
        .solutions_content_swiper {
            display: block;
            position: absolute;
            width: 100%;
            left: 0;
            bottom: 0;
            z-index: 2;
        }
        .solutions_content_swiper .swiper-slide {
            padding: 0 24px;
        }
        .solutions_content_swiper .swiper-slide svg {
            margin-bottom: 76px;
            margin-top: 26px;
        }
        .solutions_content_swiper .solutions_item_des {
            margin-bottom: 14px;
            margin-top: 0;
        }
        .solutions_item_tips {
            font-size: var(--solution-content-tips-size);
            color: var(--solution-content-tips-color);
            margin-bottom: var(--solution-content-title-mb);
        }
        .solutions_item_link {
            font-weight: 500;
            margin-bottom: var(--solution-content-title-mb);
        }
    }
</style>

<div class="section-main section-container section-ces_solutions">
    {% if section.settings.title != blank %}
      <div class="section-container section-title jky-text-3xl font-bold">{{section.settings.title}}</div>
    {% endif %}
    <div>
        {%- for item in section.blocks -%}
            <div class="solutions_item flex">
                {% render "responsive-image", mimage: item.settings.m_ces_img, image: item.settings.ces_img, width: 603, mwidth: 860, image_class: "solutions_img" %}

                <div class="flex solutions_item_content">
                    <div class="ces_solutions_main">
                        <h3 class="solutions_item_title">{{item.settings.title}}</h3>
                        <p class="solutions_item_des">{{item.settings.subtitle}}</p>

                        {% if item.settings.linktext != blank %}
                            <a class="solutions_item_link" href="{{item.settings.link}}">{{item.settings.linktext}}</a>
                        {% endif %}
                    </div>

                    {% if item.settings.tips != blank %}
                        <p class="solutions_item_tips">{{item.settings.tips | newline_to_br}}</p>
                    {% endif %}
                </div>

                <div class="swiper solutions_content_swiper">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <div class="solutions_item_first_slide">
                                <h3 class="solutions_item_title">{{item.settings.title}}</h3>
                                <svg width="41.000000" height="14.875000" viewBox="0 0 41 14.875" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <desc>
                                            Created with Pixso.
                                    </desc>
                                    <defs>
                                        <clipPath id="clip9_285">
                                            <rect id="svg" width="41.000000" height="14.875000" fill="white"/>
                                        </clipPath>
                                    </defs>
                                    <g clip-path="url(#clip9_285)">
                                        <path id="polygon" d="M7.31213 0L0 7.4375L7.31213 14.875L11.5775 14.875L4.26538 7.4375L11.5775 0L7.31213 0Z" fill-rule="nonzero" fill="var(--jds-color-primary)"/>
                                        <path id="polygon" d="M22.0234 0L14.7113 7.4375L22.0234 14.875L26.2888 14.875L18.9767 7.4375L26.2888 0L22.0234 0Z" fill-rule="nonzero" fill="var(--jds-color-primary)"/>
                                        <path id="polygon" d="M41 0L36.7346 0L29.4225 7.4375L36.7346 14.875L41 14.875L33.6879 7.4375L41 0Z" fill-rule="nonzero" fill="var(--jds-color-primary)"/>
                                    </g>
                                </svg>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <p class="solutions_item_des">{{item.settings.subtitle}}</p>

                            {% if item.settings.linktext != blank %}
                                <a class="solutions_item_link"  href="{{item.settings.link}}">{{item.settings.linktext}}</a>
                            {% endif %}

                            {% if item.settings.tips != blank %}
                                <p class="solutions_item_tips">{{item.settings.tips | newline_to_br}}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {%- endfor -%}
    </div>
</div>

<script type="module">
    if (window.innerWidth <= 1024) {
        new Swiper(".section-ces_solutions .solutions_content_swiper", {});
    }
</script>

{% schema %}
  {
    "name": "JKY CES SOLUTIONS",
    "class": "section jky-ces-solutions jky-ces-pre",
    "enabled_on": {
      "templates": ["page"]
    },
    "settings": [
        {"type": "text", "id": "title", "label": "Heading"}
    ],
    "blocks": [{
        "type": "solution", "name": "CES solution item",
        "settings": [
            {"type": "text", "id": "title", "label": "Heading"},
            {"type": "textarea", "id": "subtitle", "label": "Sub heading"},
            {"type": "textarea", "id": "tips", "label": "TIPS"},
            {"type": "image_picker", "id": "ces_img", "label": "PC IMG"},
            {"type": "image_picker", "id": "m_ces_img", "label": "Mobile IMG"},
            {"type": "text", "id": "linktext", "label": "Link text"},
            {"type": "url", "id": "link", "label": "Slide link"}
        ]
    }],
    "presets": [{
        "name": "CES solution"
    }]
  }
{% endschema %}