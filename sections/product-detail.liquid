    { "type": "header", "content": "Featured Summary" },
    { "type": "text", "id": "featured_text", "label": "Featured Title", "default": "Featured Summary" },
    { "type": "image_picker", "id": "summary_pc", "label": "PC Image" },
    { "type": "image_picker", "id": "summary_m", "label": "mobile Image" },

