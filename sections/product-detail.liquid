{%- assign current_variant = product.selected_or_first_available_variant -%}
<script defer>
  document.addEventListener('DOMContentLoaded', function() {
    const productContrastInfo = new ProductContrast({
      currentVariant: {
        "id": {{ current_variant.id | json }},
        "sku": {{ current_variant.sku | json }},
        "availability" : {{ current_variant.available | json }},
        "price" : "{{ current_variant.price | money }}",
        "compare_at_price" : "{{ current_variant.compare_at_price | money }}"
      },
      productVariants: {
        {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "id": {{ variant.id | json }},
          "sku": {{ variant.sku | json }},
          "availability" : {{ variant.available | json }},
          "price" : "{{ variant.price | money }}",
          "compare_at_price" : "{{ variant.compare_at_price | money }}"
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      },
      helpToChoose: {pageType: 'sg_gather', hideRecommended: true}
    })
  })
</script>

{% schema %}
{
  "name": "product detail",
  "class": "product-detail",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Image Plate" },
    { "type": "text", "id": "tabs_five_title", "label": "Tabs Title" },
