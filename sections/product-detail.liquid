<style>
  .mmb {display: none;}
  .product-main-block button[disabled]{    opacity: 0.3;
      pointer-events: none;}
  @media screen and (max-width: 1024px) {
    .mmb {display: block;}
  }

  .content-for-layout {
    --p-top: 100px; --content-distance: 40px; --g-radius: 30px; --gray-color: #F5F5F5;
    --symbol-l-w: 34px; --symbol-l-h: 54px; --symbol-r-w: 46px; --symbol-r-h: 66px;
    --p-detail-t: 120px; --appliance-gap: 32px; --appliance-icon: 100px;
    --running-length: 245px; --running-input: 66px; --running-radius: 33px;
    --media: 580px;
    --video-top: 100px;
  }
  @media screen and (max-width: 1024px) {
    .content-for-layout {
      --p-top: 32px; --content-distance: 30px; --g-radius: 15px;
      --symbol-l-w: 18px; --symbol-l-h: 28px; --symbol-r-w: 24px; --symbol-r-h: 33px;
      --p-detail-t: 55px; --appliance-gap: 25px; --appliance-icon: 50px;
      --running-length: 35vw; --running-input: 34px; --running-radius: 18px;
      --media: 54vw;
      --video-top: 55px;
    }
  }

  .content-for-layout .product-title {margin-bottom: var(--content-distance);}
  .content-for-layout .title {color: var(--text-black); text-align: center;}
  .content-for-layout .title-icon {justify-content: space-between; padding: 0 var(--content-distance);}
  .content-for-layout .title-icon .title-box {width: 72.8%;}
  .content-for-layout .left-icon {width: var(--symbol-l-w); height: var(--symbol-l-h);}
  .content-for-layout .right-icon {width: var(--symbol-r-w); height: var(--symbol-r-h); align-self: flex-end;}

  .content-for-layout .main-color {color: var(--primary-color);}
  .content-for-layout img {max-width: 100%;}

  .content-for-layout .gray-background {background: var(--gray-color);}

  .features {padding: var(--p-top) 0;}
  .video-text-wrap video {
    width: 100%; height: 675px; margin: 0 auto; object-fit: cover;
    display: flex; justify-content: center;
  }
  .video-text-wrap .video-box .vjs-big-play-button {top: 50%; left: 50%; transform: translate(-50%,-50%);}

  .video-text-wrap .text-box {
    padding: 0 var(--content-distance);
    display: flex; justify-content: space-between;
  }
  .video-text-wrap .text-box.layer-container {margin-top: var(--content-distance);}
  .video-text-wrap .text-box span {max-width: 80%; display: inline-block; color: var(--text-black);}
  @media screen and (max-width: 1024px) {
    .video-text-wrap.layer-container, .video-img-box.layer-container {width: 100%;}
    .video-text-wrap video {height: auto;}
    .video-text-wrap .text-box {padding: 0;}
    .video-text-wrap .text-box.layer-container {margin: var(--p-detail-t) auto;}
  }


  .features-summary {padding-top: var(--p-detail-t);}
  .features-summary {text-align: center;}
  .features-summary img {width: calc(100% - 25px); max-width: 1200px; margin: 0 auto;}
  @media screen and (max-width: 1024px) {
    .features-summary {background: var(--normal-color);}
  }


  .appliance {margin-top: var(--p-detail-t); display: flex; flex-direction: column; align-items: center;}
  .appliance figcaption {margin-bottom: var(--content-distance);}
  .appliance .scene {width: 100%;}
  .appliance .scene img {width: 100%; height: 47vw; object-fit: cover; object-position: top;}
  .appliance .icon {display: grid; grid-template-columns: repeat(3, 1fr); grid-row-gap: var(--appliance-gap); margin-top: -170px;}
  @media screen and (min-width: 1025px) {
    .appliance .icon {background: var(--normal-color); border-radius: var(--g-radius); padding: var(--content-distance);}
  }
  .appliance .icon dt {grid-column-start: 1; grid-column-end: 4;}
  .appliance .icon dt .jky-text-2xl {display: none;}
  .appliance .icon dt:after {
    content: ""; display: inline-block; width: 100%; height: 1px;
    background: var(--text-disable-color); margin: var(--content-distance) 0;
  }
  .appliance .icon dd {text-align: center;display: flex;flex-direction: column;align-items: center;justify-content: space-between;}
  .appliance .icon dd img {width: var(--appliance-icon); height: var(--appliance-icon); margin: 0 auto;}
  .appliance .icon dd .name {margin: var(--gap) 0;flex: 1;display: flex;flex-direction: column;align-items: center;justify-content: space-between;}
  .appliance .icon dd .duration {font-size: 32px; font-weight: 600; line-height: 30px; color: var(--primary-color);}
  .more-appliance {margin: 85px auto 0;}

  @media screen and (max-width: 1024px) {
    .appliance {background: #23160E; color: var(--normal-color);}
    .appliance figcaption {display: none;}
    .appliance .scene img {height: 110vw;}
    .appliance .icon {margin: 16px 0;}
    .appliance .icon dt .jky-text-2xl {display: block;}
    .appliance .icon dd .duration {font-size: 16px; line-height: 16px;}
    .more-appliance {margin: 25px auto 50px;}
  }

  .running-time {padding: 70px 20px; text-align: center; background: var(--normal-color); border-radius: var(--g-radius); margin-top: 85px;}
  .running-time .running-title {font-weight: 600; color: var(--text-black);}
  .running-time .running-desc {margin-top: var(--gap);}

  .running-time .time-result {margin-top: 20px;}
  .running-time .time-result .result {font-weight: 500; color: var(--text-black);}
  .running-time .time-result .number {color: var(--primary-color);}

  .running-time .running-tip {color: var(--text-main-color); margin-top: 40px;}

  .running-wrap {margin-top: var(--content-distance);}
  .running-wrap input, .running-wrap .unit {font-size: 36px; font-weight: 500; color: var(--text-black);}
  .running-wrap input {
    width: var(--running-length); height: var(--running-input); line-height: var(--running-input); text-align: center;
    background: var(--normal-color); border-radius: var(--running-radius); border: var(--border-color-link); margin: 0 var(--gap);
  }
  .running-error {display: none; font-size: 18px; font-weight: 500; color: var(--primary-color); line-height: 21px; margin-top: 15px; transition: all .3s ease;}
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none !important;
    margin: 0;
  }
  input[type="number"] {
    -moz-appearance: textfield;
  }
  @media screen and (max-width: 1024px) {
    .running-time {padding: 20px; margin-top: 50px;}
    .running-time .time-result img {width: 32px; margin-right: 5px;}
    .running-time .running-tip {margin-top: 15px;}
    .running-wrap img {width: 20px;}
    .running-wrap input, .running-wrap .unit {font-size: 18px;}
  }

  .solar-wrap {padding-top: var(--p-detail-t); display: flex;}
  .solar-wrap .img-box {width: 50%; object-fit: cover;max-height:820px;}
  .solar-wrap .charg-box {width: 50%; padding: 40px 50px; background: var(--normal-color);}
  .solar-wrap .charg-box .title {color: var(--text-black);}
  .solar-wrap .charg-box .tip {color: var(--text-black);}

  .solar-wrap .table-box {margin-top: var(--content-distance);}
  .solar-wrap .table-head {color: var(--text-main-color); font-weight: 600; text-align: center;}
  .solar-wrap .table-head .left {flex: 1.04;}
  .solar-wrap .table-head .right {flex: 0.96;}
  .solar-wrap .table-item {display: flex; align-items: center;}
  .solar-wrap .table-item:not(:last-child) {margin-bottom: 10px;}
  .solar-wrap .table-item .img-box {height: auto; display: flex; flex-direction: column; align-items: center; flex: 1.04;}
  .solar-wrap .table-item .img-box img {width: 160px;}
  .solar-wrap .table-item .img-box span {font-weight: 500; color: var(--text-main-color); margin-top: 4px;}
  .solar-wrap .table-item .time {text-align: center; font-weight: 500; color: var(--primary-color); flex: 0.96;}
  .solar-wrap .table-box:after {content: ""; display: inline-block; width: 100%; height: 1px; background: var(--text-disable-color); margin: 32px 0 12px;}

  @media screen and (max-width: 1024px) {
    .solar-wrap {flex-wrap: wrap; justify-content: center;}
    .solar-wrap .title:not(.mmb) {display: none;}
    .solar-wrap .title.mmb {margin-bottom: var(--content-distance);}

    .solar-wrap .img-box {width: 100%; height: 75vw;}
    .solar-wrap .charg-box {width: 100%; background: transparent; padding: var(--gap) 30px;}
    .solar-wrap .table-box {margin-top: 0;}
    .solar-wrap .table-box:after {content: none;}
    .solar-wrap .table-head {margin-bottom: var(--gap);}
    .solar-wrap-tips {margin-top: 15px;}
  }

  .bms-wrap {margin-top: var(--p-detail-t);}
  .bms-wrap .desc {color: var(--text-black); margin-top: var(--content-distance);}
  .bms-wrap .bms-img {margin-top: var(--content-distance); border-radius: var(--g-radius);}
  @media screen and (max-width: 1024px) {
    .bms-wrap.layer-container {width: 100%;}
    .bms-wrap .bms-img {border-radius: 0;}
    .bms-wrap .mmb {padding: 0 30px;}
  }

  .tabs-five-video{
    padding-top: var(--video-top);
  }

  .tenth-years {margin-top: var(--p-detail-t);}
  .tenth-years .title {margin-bottom: 74px;}
  .tenth-years .tenth-wrap {background: var(--normal-color); border-radius: var(--g-radius);}
  .tenth-years .tenth-wrap .text {padding: 20px 50px; color: var(--text-black);}
  @media screen and (max-width: 1024px) {
    .tenth-years.layer-container {width: 100%;}
    .tenth-years .title, .tenth-years .tenth-wrap .text {padding: 0 30px;}
    .tenth-years .title, .tenth-years .tenth-wrap img {margin-bottom: var(--content-distance);}
    .tenth-years .tenth-wrap {background: transparent; border-radius: 0;}
    {% comment %} 法站MB自适应 {% endcomment %}
    {%- if shop.id != 69511053598 -%}
      .tenth-years .tenth-wrap img {height: 100vw; object-fit: cover;}
    {%- endif -%}
  }


  .explore-wrap {margin-top: var(--p-detail-t);}
  .explore-wrap .card-swiper, .explore-wrap .slideshow-pagination {margin-top: var(--content-distance);}
  .explore-wrap .card-swiper-container {height: fit-content;}
  .explore-wrap .slideshow-pagination {position: static;}
  @media screen and (max-width: 1024px) {
    .explore-wrap.layer-container {width: 100%;}
    .explore-wrap .mmb {padding: 0 30px;}
    .explore-wrap .desc {margin-top: var(--content-distance);}
  }


  .seem-wrap {margin-top: var(--p-detail-t);}
  .seem-wrap .seem-box img {width: 100%; object-fit: cover;}
  .seem-wrap .seem-card {background: var(--normal-color); border-radius: var(--g-radius); margin-top: -50px;}
  .seem-wrap .seem-card .text {padding: 20px 50px; color: var(--text-black);}
  @media screen and (max-width: 1024px) {
    .seem-wrap .seem-box img {height: 77vw;}
    .seem-wrap .seem-card {background: transparent; margin-top: -15vw; position: relative; z-index: 1;}
    .seem-wrap .seem-card img {border-radius: var(--g-radius);}
    .seem-wrap .seem-card .text {padding: var(--content-distance) 0;}
  }



  .outdoors-wrap .seem-card {margin-top: -50px;}
  .outdoors-wrap .sing-image {margin-top: 24px;}
  .outdoors-wrap .img-with-text {margin-top: 24px; display: flex; background: var(--normal-color); border-radius: var(--g-radius);}
  .outdoors-wrap .img-with-text .right {padding: 0 38px;}
  .outdoors-wrap .img-with-text .title {color: var(--text-black); margin-top: 40px;}
  .outdoors-wrap .img-with-text .desc {color: var(--text-black);  margin-top: 24px;}
  @media screen and (max-width: 1024px) {
    .outdoors-wrap .image {filter: brightness(0.7);}
    .outdoors-wrap .sing-image {margin-top: 0;}

    .sing-image.layer-container {width: 100%;}
    .outdoors-wrap .img-with-text {margin-top: -15vw; flex-wrap: wrap; background: transparent;}
    .outdoors-wrap .img-with-text img {border-radius: var(--g-radius);}
    .outdoors-wrap .img-with-text .title, .outdoors-wrap .img-with-text .desc {margin-top: var(--content-distance);}
    .outdoors-wrap .seem-card {margin-top: -15vw;}
    .outdoors-wrap .img-with-text .right {padding: 0;}
  }


  .need-wrap {margin-top: 70px;}
  @media screen and (max-width: 1024px) {
    .need-wrap {margin-top: 10px;}
  }


  .power-station {
    --content-top: 80px; --content-text: 45px; --flex: 50% 0 0;
    background: var(--normal-color); border-radius: var(--g-radius); padding: 70px 36px;
  }
  .power-station .header {color: var(--text-main-color); text-align: center;}
  .power-station .header > img {float: right; margin-top: 12px; cursor: pointer;}
  .power-station .content {margin-top: var(--content-top); display: flex;}
  .power-station .content .image {flex: var(--flex);}
  .power-station .content .text {margin-left: var(--content-text); flex: auto;}
  .power-station .content .subtitle {color: var(--text-black);}
  .power-station .content .desc {color: var(--text-black); margin-top: var(--gap);}
  @media screen and (max-width: 1024px) {
    .power-station {
      --content-top: 20px; --content-text: 0; --flex: 100% 0 0;
      padding: var(--content-distance) var(--gap);
    }
    .power-station .header {display: flex; flex-direction: column; align-items: center;}
    .power-station .header > img {width: 14px; height: 14px;}
    .power-station .content {flex-wrap: wrap;}
    .power-station .content .image {margin-bottom: var(--content-top);}
    .power-station .content .desc {line-height: 26px;}
  }


  .product-contrast {
    --contrast-gap: 30px; --param-top: 24px; --select: 48px; --repeat: repeat(3, 1fr);
    margin-top: var(--content-distance);
    display: none;
  }
  .product-contrast .display-none {display: none;}
  .contrast-wrap {display: flex; grid-template-columns: var(--repeat); grid-gap: var(--gap); justify-content: center;}
  .contrast-product {background: var(--normal-color);display: flex;flex-direction: column;}
  .contrast-wrap .main-pdt { padding-top: 98px; }
  .contrast-wrap li {width: 33%; background: var(--normal-color); text-align: center; padding: var(--contrast-gap) var(--gap);}
  .contrast-wrap li .name {font-size: 24px; line-height: 39px; font-weight: 500; color: var(--text-main-color); padding: 0 var(--contrast-gap);}
  .contrast-wrap .param {
    padding: 0 var(--contrast-gap); margin-top: var(--param-top); color: var(--text-black);
    display: flex; flex-direction: column; align-items: center;
  }
  .contrast-wrap .select-product {width: 100%; height: var(--select); margin-bottom: var(--gap);}
  .contrast-wrap select.select-product {
    border-radius: var(--radius); border: 1px solid var(--primary-color); padding: 0 var(--contrast-gap) 0 var(--gap);
    -webkit-appearance: none; -moz-appearance: none; appearance: none; text-overflow: ellipsis;
    background: #FFF8F6 url("https://cdn.shopify.com/s/files/1/0550/0524/9633/files/arrow-down.png?v=1679535875") no-repeat right 14px center;
    background-size: 16px;
  }
  .contrast-wrap .text-inherit {color: inherit;}
  .contrast-wrap .more {margin: var(--contrast-gap) auto;}
  .contrast-wrap .more a {color: var(--primary-color);}
  .contrast-wrap .more a:hover {color: var(--normal-color);}
  @media screen and (max-width: 1024px) {
    .product-contrast {
      --param-top: 6px; --repeat: 1fr; --gap: 20px;
    }
    .contrast-wrap {display: block;}
    .contrast-wrap li {width: 100%; margin-bottom: var(--gap);}
    .contrast-wrap li .name {font-size: 18px; line-height: 28px;}
    .contrast-wrap .main-pdt { padding-top: 0; }
    .contrast-product:nth-child(3) {display: none;}
  }

  .reviews {margin-top: var(--content-distance);}
  .image-plate {padding-top:0;padding-bottom:20px;}
  @media screen and (max-width: 1024px) {
    .image-plate {background:none;padding-bottom:24px;}
  }
</style>
<link rel="stylesheet" href="{{ 'pdp-v3-content.min.css' | asset_url }}">
{%- render 'fix-v5-product-style' -%}
{% comment %} tabs 在 JS 重排完成前先不参与 sticky 联动，由 JS 将 data-sticky-ready 置为 true 后再启用 {% endcomment %}
<div class="tabs-header flex cal_scroll_target" data-sticky-ready="false">
  <ul class="section-container J-tabs-point">
    <li class="active" data-point="features">{{ 'products.product.feature' | t }}</li>
    {% if section.settings.tabs_five_title != blank %}
      <li data-point="video">{{ section.settings.tabs_five_title }}</li>
    {% endif %}
    <li data-point="specs">{{ 'products.product.specs' | t }}</li>
    <li data-point="faq">{{ 'products.product.faq' | t }}</li>
    {% if section.settings.is_show_reviews_tab %}
      <li data-point="reviews">{{ 'products.product.review' | t }}</li>
    {% endif %}
  </ul>
</div>

<section id="features" class="features gray-background">
  {%- if section.settings.image_plate_pc -%}
    {%- assign m_img_src = section.settings.image_plate_m | image_url: width: 721 -%}
    {%- unless section.settings.image_plate_m -%}
      {%- assign m_img_src = section.settings.image_plate_pc | image_url: width: 721 -%}
    {%- endunless -%}
    <figure class="features-summary image-plate">
      {% assign plate_title = section.settings.image_plate_title %}
      <h2 class="product-title jky-text-2xl text-center">{{ plate_title }}</h2>
      {% render 'diff-end-img', pc_img: section.settings.image_plate_pc,pc_img_width:1200, mb_img: m_img_src ,mb_img_width: 721, alt: plate_title %}
    </figure>
  {%- endif -%}

  <div class="video-text-wrap layer-container relative">
    {%- if section.settings.feature_video_1 or section.settings.feature_video_poster != blank -%}
      {%- render 'jky-video', video_url: section.settings.feature_video_1, poster: section.settings.feature_video_poster, title: product.title, class: "features-media", autoplay: false, controls: true, loop: false -%}
    {%- endif -%}

    <div class="text-box layer-container">
      <img class="left-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016" alt="jackery symbol" loading="lazy" />
      <span class="jky-text-base">{{ section.settings.feature_intro }}</span>
      <img class="right-icon" src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016" alt="jackery symbol" loading="lazy" />
    </div>
  </div>

  <figure class="features-summary">
    {% assign feature_text = section.settings.featured_text %}
    <h2 class="product-title jky-text-2xl text-center">{{ feature_text }}</h2>
    {% render 'diff-end-img', pc_img: section.settings.summary_pc,pc_img_width:1200, mb_img: section.settings.summary_m ,mb_img_width: 721, alt: feature_text %}
  </figure>

  <figure class="appliance">
    <h2 class="product-title jky-text-2xl text-center">
      {{ section.settings.appliance_title | replace: '<em>', '<em class="main-color">' }}
    </h2>
    <div class="scene">
      {{
        section.settings.appliance_bg
        | image_url: width: 2560
        | image_tag:
          class: '',
          widths: '375,550,750,990,1100,1200,1280,1500,1920,2560',
          sizes: '100vw',
          loading: 'lazy',
          width: section.settings.appliance_bg.width,
          height: section.settings.appliance_bg.height,
          alt: section.settings.appliance_bg.alt
      }}
    </div>

    {% assign appliance_device = section.blocks | where: 'type', "appliance_device" %}
    <dl class="icon layer-container">
      <dt>
        <p class="jky-text-base">{{ section.settings.appliance_intro }}</p>
      </dt>
      {% for block in appliance_device %}
      <dd>
        <img src="{{ block.settings.device_icon | image_url: width: 200 }}" alt="{{ block.settings.device_icon.alt }}" loading="lazy" />
        <p class="name jky-text-sm">
          <span>{{ block.settings.device }}</span>
          <br />
          <span>({{ block.settings.wattage }}W)</span>
        </p>
        <span class="duration">{{ block.settings.duration }}</span>
      </dd>
      {% endfor %}
    </dl>
  </figure>


  {% comment %} 更多电器 {% endcomment %}
  {% assign more_appliances = section.blocks | where: 'type', "more_appliances" %}
  {% render 'product-detail-appliances', title: section.settings.more_appliances_title, subtitle: section.settings.more_appliances_subtitle, blocks: more_appliances, %}

  {% assign capacity = product.metafields.my_fields.wattage %}
  {%- if capacity -%}
    {% comment %} 产品最大功率，单位：W（瓦特） {% endcomment %}
    {% assign max_power = product.metafields.custom.max_power %}
    {% assign efficiency = 0.8 %}
    {% assign ac_consumption = 0 %}
    {%- if capacity >= 100 and capacity < 1000 -%}
      {% assign efficiency = 0.82 %}
      {% assign ac_consumption = 10 %}
    {%- elsif capacity>= 1000 and capacity < 1200 -%}
      {% assign efficiency = 0.82 %}
      {% assign ac_consumption = 15 %}
    {%- elsif capacity>= 1200 and capacity < 2100 -%}
      {% assign efficiency = 0.82 %}
      {% assign ac_consumption = 18 %}
    {%- elsif capacity>= 2100 and capacity < 3050 -%}
      {% assign efficiency = 0.85 %}
      {% assign ac_consumption = 25 %}
    {%- elsif capacity>= 3050 and capacity < 5000 -%}
      {% assign efficiency = 0.85 %}
      {% assign ac_consumption = 22 %}
    {%- elsif capacity>= 5000 -%}
      {% assign efficiency = 0.85 %}
      {% assign ac_consumption = 50 %}
    {%- endif  -%}

    {% if product.metafields.custom.efficiency != blank %}
      {% assign efficiency = product.metafields.custom.efficiency %}
    {% endif %}

    {% if product.metafields.custom.ac_consumption != blank %}
      {% assign ac_consumption = product.metafields.custom.ac_consumption %}
    {% endif %}

    <div class="running-time layer-container J-running-time">
      <p class="running-title jky-text-xl">{{ section.settings.running_title }}</p>

      <p class="running-desc jky-text-lg">
        {{ section.settings.running_product }}
        {{ 'products.product.running_capacity' | t: capacity: capacity }}
        <br>
        {{ section.settings.running_tip }}
        {{ 'products.product.running_not_exceeding' | t: exceeding: max_power }}
      </p>

      <div class="running-wrap flex justify-center items-center">
        <img
          src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_62deaa2a-2d30-4fd8-bbd3-3f5f7067c615.svg?v=1678865782"
          alt="running"
          loading="lazy"
        >
        <input
          aria-label="Input power"
          type="number"
          min="0"
          data-capacity="{{ capacity }}"
          data-maxpower="{{max_power}}"
          data-efficiency="{{ efficiency }}"
