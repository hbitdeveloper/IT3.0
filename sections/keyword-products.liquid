{%- style -%}
  .section-keyword-products {
    background: #f6f6f6;
    margin-bottom: 3.125vw;
  }

  .keyword-products-title {
    font-size: 2.3438vw;
    font-weight: 600;
    color: #000000;
    padding: 3.3854vw 0;
    text-align: center;
  }

  .keyword-product-item {
    display: flex;
    padding: 3.125vw;
    background: #ffffff;
    max-width: 75vw;
    border-radius: 1.5625vw;
    margin-right: auto;
    margin-left: auto;
    margin-bottom: 3.9063vw;
  }

  .keyword-product-item .m-content-title {
    display: none;
  }

  .keyword-product-item .item-image {
    max-width: 35.4167vw;
    height: 100%;
    margin-right: 1.4583vw;
  }

  .keyword-product-item .item-image-m {
    display: none;
  }

  .keyword-product-item .item-image-order {
    max-width: 35.4167vw;
    height: 100%;
    margin-left: 1.4583vw;
    order: 1;
  }

  .keyword-product-item .item-content {
  }

  .keyword-product-item .item-content .item-price {
    padding: 2.6042vw 0;
  }

  .keyword-product-item .item-content .item-price .kwd-price {
    font-size: 1.875vw;
    font-weight: 600;
    color: var(--primary-color);
    padding-right: 1.5625vw;
  }

  .keyword-product-item .item-content .item-price .kwd-old-price {
    text-decoration: line-through;
    font-size: 1.25vw;
    color: #666666;
  }

  .keyword-product-item .item-content .kwd-product-button {
    position: relative;
    align-items: center;
    background: var(--primary-color);
    cursor: pointer;
    display: flex;
    text-decoration: none;
    justify-content: center;
    width: 15.625vw;
    height: 3.4375vw;
    color: #ffffff;
    font-weight: 600;
    font-size: 1.25vw;
    border-radius: var(--theme-btn-border-radius,1.7188vw);
  }

  .keyword-product-item .item-content .content-title {
    font-size: 1.875vw;
    font-weight: 600;
    color: #000000;
    padding-bottom: 1.4063vw;
  }
  .keyword-product-item .item-content .content-subtitle {
    font-size: 1.25vw;
    font-weight: 500;
    color: #333333;
    padding-bottom: 1.25vw;
    line-height: 1.875vw;
  }
  .keyword-product-item .item-content .content-icons {
    display: grid;
  }
  .keyword-product-item .item-content .content-icons-gcol-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5521vw;
  }
  .keyword-product-item .item-content .content-icons-gcol-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5521vw 7.0833vw;
  }
  .keyword-product-item .item-content .content-icons .content-icons-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .keyword-product-item .item-content .content-icons .content-icons-item .icons-item-img {
    width: 5.2083vw;
    height: 5.2083vw;
  }
  .keyword-product-item .item-content .content-icons .content-icons-item .icon-item-subtitle {
    text-align: center;
    font-size: 0.765vw;
    font-weight: 500;
    color: #333333;
    margin-top: 0.5208vw;
  }

  @media screen and (max-width: 768px) {
    .section-keyword-products {
      margin-bottom: 0;
      padding-bottom: 9.3333vw;
    }

    .keyword-product-item {
      margin-left: auto;
      margin-right: auto;
      max-width: 84vw;
      flex-direction: column;
      padding: 4.8vw 4.2667vw 6.4vw 4.2667vw;
    }

    .keyword-products-title {
      font-size: 6vw;
      font-weight: 600;
      color: #000000;
      line-height: 6.4vw;
      padding: 7.7333vw 0;
    }

    .keyword-product-item .m-content-title {
      display: flex;
      text-align: center;
      font-size: 4.8vw;
      font-weight: 600;
      color: #000000;
      line-height: 7.2vw;
    }
    .keyword-product-item .item-content .content-title {
      display: none;
    }
    .keyword-product-item .item-image {
      display: none;
    }

    .keyword-product-item .item-image-order {
      display: none;
    }

    .keyword-product-item .item-image-m {
      display: block;
      max-height: none;
      max-width: 100%;
      margin-right: 0;
      margin-top: 3.7333vw;
    }
    .keyword-product-item .item-content .content-subtitle {
      font-size: 3.2vw;
      font-weight: 600;
      color: #333333;
      line-height: 4.8vw;
      text-align: center;
      padding: 1.3333vw 4vw 3.8667vw 4vw;
    }

    .keyword-product-item .item-content .content-icons .content-icons-item .icons-item-img {
      width: 13.3333vw;
      height: 13.3333vw;
    }

    .keyword-product-item .item-content .content-icons .content-icons-item .icon-item-subtitle {
      margin-top: 3.8667vw;
      font-size: 2.4vw;
      font-weight: 500;
      color: #333333;
      line-height: 3.6vw;
    }

    .keyword-product-item .item-content .content-icons-gcol-4 {
      gap: 8.2667vw;
    }

    .keyword-product-item .item-content .item-price {
      padding-top: 4.6667vw;
      padding-bottom: 6.2667vw;
      text-align: center;
    }

    .keyword-product-item .item-content .item-price .kwd-price {
      font-size: 4.8vw;
      font-weight: 600;
    }

    .keyword-product-item .item-content .item-price .kwd-old-price {
      font-size: 3.2vw;
      text-decoration: line-through;
    }

    .keyword-product-item .item-content .kwd-product-button {
      width: 40vw;
      height: 8.8vw;
      border-radius: var(--theme-btn-border-radius,4.4vw);
      left: 15.7333vw;
      font-size: 3.2vw;
    }
  }

  .keyword-products-title {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .keyword-products-title {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .keyword-products-title {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }
  }
{%- endstyle -%}
<h2 class="keyword-products-title" id="solar-generators" anchor="{{ section.settings.anchor | escape }}"
style="
--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};
--pc-padding-top:{{ section.settings.pc_padding_top }};--mb-padding-top:{{ section.settings.mb_padding_top }};
"
>{{ section.settings.title | escape }}</h2>
{%- if section.settings.sub != blank -%}
 <div class="keyword-products-sub keyword-sub">{{ section.settings.sub }}</div>
{%- endif -%}
{% for block in section.blocks %}
  {% assign itemIndex = forloop.index | modulo: 2 %}
  <div class="keyword-product-item">
    <h3 class="m-content-title">{{ block.settings.product.title | escape }}</h3>
    <img
      src="{{ block.settings.p_img | image_url: width: 1360 }}"
      alt="{{block.settings.p_img.alt}}"
      class="{% if itemIndex == 1 %} item-image {%else%} item-image-order {%endif%}" loading="lazy"
    >
    <img
      src="{{ block.settings.m_img | image_url: width: 750 }}"
      class="item-image-m" loading="lazy" alt="{{block.settings.m_img.alt}}"
    >
    <div class="item-content">
      <h3 class="content-title">{{ block.settings.product.title | escape }}</h3>
      <div class="content-subtitle">
        {{ block.settings.p_subtitle | newline_to_br }}
      </div>
      <dl class="content-icons {%if block.settings.line_icon_number == "4" %} content-icons-gcol-4 {%endif %} {%if block.settings.line_icon_number == "3" %} content-icons-gcol-3 {%endif %}">
        {% if block.settings.icon_1 %}
          <dd class="content-icons-item">
            <img
              src="{{ block.settings.icon_1 | image_url: width: 100 }}"
              alt="{{ block.settings.icon_1.alt }}"
              class="icons-item-img" loading="lazy"
            >
            <span class="icon-item-subtitle">{{ block.settings.icon_t_1 | newline_to_br }}</span>
          </dd>
        {% endif %}
        {% if block.settings.icon_2 %}
          <dd class="content-icons-item">
            <img
              src="{{ block.settings.icon_2 | image_url: width: 100 }}"
              alt="{{ block.settings.icon_2.alt }}"
              class="icons-item-img" loading="lazy"
            >
            <span class="icon-item-subtitle">{{ block.settings.icon_t_2 | newline_to_br }}</span>
          </dd>
        {% endif %}
        {% if block.settings.icon_3 %}
          <dd class="content-icons-item">
            <img
              src="{{ block.settings.icon_3 | image_url: width: 100 }}"
              alt="{{ block.settings.icon_3.alt }}"
              class="icons-item-img" loading="lazy"
            >
            <span class="icon-item-subtitle">{{ block.settings.icon_t_3 | newline_to_br }}</span>
          </dd>
        {% endif %}
        {% if block.settings.icon_4 %}
          <dd class="content-icons-item">
            <img
              src="{{ block.settings.icon_4 | image_url: width: 100 }}"
              alt="{{ block.settings.icon_4.alt }}"
              class="icons-item-img" loading="lazy"
            >
            <span class="icon-item-subtitle">{{ block.settings.icon_t_4 | newline_to_br }}</span>
          </dd>
        {% endif %}
        {% if block.settings.icon_5 %}
          <dd class="content-icons-item">
            <img
              src="{{ block.settings.icon_5 | image_url: width: 100 }}"
              alt="{{ block.settings.icon_5.alt }}"
              class="icons-item-img" loading="lazy"
            >
            <span class="icon-item-subtitle">{{ block.settings.icon_t_5 | newline_to_br }}</span>
          </dd>
        {% endif %}
        {% if block.settings.icon_6 %}
          <dd class="content-icons-item">
            <img
              src="{{ block.settings.icon_6 | image_url: width: 100 }}"
              alt="{{ block.settings.icon_6.alt }}"
              class="icons-item-img" loading="lazy"
            >
            <span class="icon-item-subtitle">{{ block.settings.icon_t_6 | newline_to_br }}</span>
          </dd>
        {% endif %}
        {% if block.settings.icon_7 %}
          <dd class="content-icons-item">
            <img
              src="{{ block.settings.icon_7 | image_url: width: 100 }}"
              alt="{{ block.settings.icon_7.alt }}"
              class="icons-item-img" loading="lazy"
            >
            <span class="icon-item-subtitle">{{ block.settings.icon_t_7 | newline_to_br }}</span>
          </dd>
        {% endif %}
        {% if block.settings.icon_8 %}
          <dd class="content-icons-item">
            <img
              src="{{ block.settings.icon_8 | image_url: width: 100 }}"
              alt="{{ block.settings.icon_8.alt }}"
              class="icons-item-img" loading="lazy"
            >
            <span class="icon-item-subtitle">{{ block.settings.icon_t_8 | newline_to_br }}</span>
          </dd>
        {% endif %}
      </dl>
      {% assign target = block.settings.product.selected_or_first_available_variant %}
      {% assign compare_at_price = target.compare_at_price %}
      {% assign price = target.price | default: 1999 %}
      {% assign money_price = price | money %}
      {% if target == block.settings.product and block.settings.product.price_varies %}
        {% assign money_price = 'products.product.price.from_price_html' | t: price: money_price %}
      {% endif %}
      <div class="item-price">
        {% comment %} <span class="kwd-price">{{ money_price }}</span>
        {%- unless block.settings.product.price_varies == false and block.settings.product.compare_at_price_varies %}
          <span class="kwd-old-price">{{ compare_at_price | money }}</span>
        {%- endunless -%} {% endcomment %}

        {% render 'product-sale-price', product: block.settings.product %}
      </div>
      <a
        class="kwd-product-button"
        data-href="{{block.settings.product.url}}"
        data-title="{{ block.settings.product.title }}"
        data-price="{{ money_price }}"
        data-compare_at_price="{{ compare_at_price | money }}"
      >
        {{- 'general.action_text.learn_more' | t }}
        <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
      </a>
    </div>
  </div>
{% endfor %}

<script defer>
  function keywordProductsInit() {
    const buttons = document.querySelectorAll('.kwd-product-button');
    buttons.forEach(function (button) {
      button.addEventListener('click', function (e) {
        let targetDom;
        if (e.target.localName == 'span') {
          targetDom = e.target.offsetParent;
        } else {
          targetDom = e.target;
        }

        let href = targetDom.dataset.href;
        let title = targetDom.dataset.title;
        let price = targetDom.dataset.price;
        let compare_at_price = targetDom.dataset.compare_at_price;

        window.dataLayer.push({ event_parameters: null });
        window.dataLayer.push({
          event: 'ga4Event',
          event_name: 'learn_more',
          event_parameters: {
            current_page: location.pathname,
            title: title,
            price: price,
            origin_price: compare_at_price,
            currency: window.Shopify.currency.active,
            product_url: href,
          },
        });
        window.open(href, "_blank");
      });
    });
  }

  window.addEventListener('DOMContentLoaded', function () {
    keywordProductsInit();
  });
</script>
{% schema %}
{
  "name": "Keyword Products",
  "class": "section-keyword-products",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },
  { "type": "text", "id": "title", "label": "Title" },{ "type": "richtext", "id": "sub", "label": "SubTitle" },
  { "type": "number", "id": "pc_padding_top", "label": "上边距PC" },
  { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 40 },
  { "type": "number", "id": "mb_padding_top", "label": "上边距MB" },
  { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 48 }
  ],
  "blocks": [
    {
      "type": "products-item",
      "name": "Products Item",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "p_img", "label": "Product PC image" },
        { "type": "image_picker", "id": "m_img", "label": "Product Mobile image" },
        { "type": "textarea", "id": "p_subtitle", "label": "Product Subtitle" },
        {
          "type": "select",
          "id": "line_icon_number",
          "label": "Icon Quantity Per Row",
          "options": [
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" }
          ]
        },

        { "type": "image_picker", "id": "icon_1", "label": "Product icon 1" },
        { "type": "textarea", "id": "icon_t_1", "label": "Product advantage 1" },

        { "type": "image_picker", "id": "icon_2", "label": "Product icon 2" },
        { "type": "textarea", "id": "icon_t_2", "label": "Product advantage 2" },

        { "type": "image_picker", "id": "icon_3", "label": "Product icon 3" },
        { "type": "textarea", "id": "icon_t_3", "label": "Product advantage 3" },

        { "type": "image_picker", "id": "icon_4", "label": "Product icon 4" },
        { "type": "textarea", "id": "icon_t_4", "label": "Product advantage 4" },

        { "type": "image_picker", "id": "icon_5", "label": "Product icon 5" },
        { "type": "textarea", "id": "icon_t_5", "label": "Product advantage 5" },

        { "type": "image_picker", "id": "icon_6", "label": "Product icon 6" },
        { "type": "textarea", "id": "icon_t_6", "label": "Product advantage 6" },

        { "type": "image_picker", "id": "icon_7", "label": "Product icon 7" },
        { "type": "textarea", "id": "icon_t_7", "label": "Product advantage 7" },

        { "type": "image_picker", "id": "icon_8", "label": "Product icon 8" },
        { "type": "textarea", "id": "icon_t_8", "label": "Product advantage 8" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keyword Products",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
