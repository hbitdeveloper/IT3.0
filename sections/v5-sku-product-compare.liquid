{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

{%- liquid
  assign product_count = 0
  for block in section.blocks
    if block.type != 'item'
      continue
    endif
    if block.settings.product != blank
      assign product_count = product_count | plus: 1
    endif
  endfor
-%}

<section class="section-padding" style="{{ style }}" {{ section.shopify_attributes }}>
  <div class="section-container-lg">
    {% if section.settings.title != blank %}
      <div class="text-center font-semibold text-[#1A1A1A] text-xl leading-tight lg:text-4xl lg:w-[51rem] m-auto">
        {{ section.settings.title }}
      </div>
    {% endif %}

    {% if section.settings.desc != blank %}
      <div class="mt-3 lg:mt-12 text-[#1A1A1A] text-sm leading-normal lg:text-base">
        {{ section.settings.desc }}
      </div>
    {% endif %}

    {% if product_count > 0 %}
      <div id="v5-sku-product-compare-{{ section.id }}" class="mt-4 lg:mt-12 overflow-x-auto overflow-y-hidden lg:overflow-x-visible">
        <div class="min-w-max bg-white">
          <style>
            html[lang=ja] #v5-sku-product-compare-{{ section.id }} .v5spc-grid .product-title{
              line-height: 1.3 !important;
            }

            #v5-sku-product-compare-{{ section.id }} .v5spc-grid {
              display: grid;
              grid-template-columns: repeat({{ product_count }}, 150px);
            }
            @media (min-width: 1024px) {
              #v5-sku-product-compare-{{ section.id }} .v5spc-grid {
                grid-template-columns: repeat({{ product_count }}, 1fr);
              }
            }
          </style>

          <div class="v5spc-grid border-b border-solid border-[#EDEDED]">
            {% for block in section.blocks %}
              {% if block.type != 'item' or block.settings.product == blank %}
                {% continue %}
              {% endif %}

              {%- liquid
                assign p = block.settings.product
                assign sku = block.settings.sku | strip
                assign v = blank
                if sku != blank
                  assign v = p.variants | where: 'sku', sku | first
                endif
                if v == blank
                  assign v = p.selected_or_first_available_variant
                endif

                assign img = v.featured_image | default: p.featured_image
                assign title_text = block.settings.title | strip
                if title_text == blank
                  assign title_text = p.title
                endif
              -%}

              <div class="lg:pt-4 lg:pb-6 py-0 px-2 min-w-0 overflow-hidden" {{ block.shopify_attributes }}>
                <div class="max-w-[18rem] min-w-0">
                  {% if img != blank %}
                    <a href="{{ p.url }}?variant={{ v.id }}" {% if section.settings.open_new_window %}target="_blank"{% endif %} class="block lg:w-[8.75rem] lg:h-[8.75rem] w-[7.5rem] h-[7.5rem]">
                      <div class="bg-[#F6F6F6] w-full aspect-square flex items-center justify-center">
                        <img src="{{ img | image_url: width: 320 }}" alt="{{ title_text | escape }}" loading="lazy" class="lg:w-[8.75rem] lg:h-[8.75rem] w-[7.5rem] h-[7.5rem] object-contain">
                      </div>
                    </a>
                  {% endif %}

                  <div class="product-title mt-2 text-[#242F20] text-sm !leading-[1.3] font-semibold lg:line-clamp-2 line-clamp-3 lg:min-h-[2.6em] min-h-[3.375rem] text-left break-words">
                    {{ title_text | escape }}
                  </div>

                  <jds-button
                    size="medium"
                    variant="secondary"
                    class="lg:mt-3 mt-2 w-fit"
                    data-sku-compare-add
                    data-variant-id="{{ v.id }}"
                    {% unless v.available %}disabled{% endunless %}
                  >
                    {{ section.settings.add_to_cart_text | escape }}
                  </jds-button>

                  <a href="{{ p.url }}?variant={{ v.id }}" {% if section.settings.open_new_window %}target="_blank"{% endif %} class="lg:p-3.5 mt-4 flex items-center gap-1 text-[#FD5000] lg:text-base text-sm font-medium lg:mb-0 mb-6">
                    {{ section.settings.view_detail_text | escape }}
                    {% comment %} <span aria-hidden="true">></span> {% endcomment %}
                     {% render 'icon-arrow', class: 'w-3.5', color: '#FD5000' %}
                  </a>
                </div>
              </div>
            {% endfor %}
          </div>

          {%- assign label_rows = 'price,capacity,output,weight,charge_time' | split: ',' -%}
          {% for key in label_rows %}
            <div class="v5spc-grid border-b border-solid border-[#EDEDED]">
              {%- assign cell_index = 0 -%}
              {% for block in section.blocks %}
                {% if block.type != 'item' or block.settings.product == blank %}
                  {% continue %}
                {% endif %}
                {%- assign cell_index = cell_index | plus: 1 -%}

                {%- liquid
                  assign p = block.settings.product
                  assign sku = block.settings.sku | strip
                  assign v = blank
                  if sku != blank
                    assign v = p.variants | where: 'sku', sku | first
                  endif
                  if v == blank
                    assign v = p.selected_or_first_available_variant
                  endif
                -%}

                <div class="lg:px-5 lg:py-4 pt-1.5 pb-4 pl-2 text-[#1A1A1A] min-w-0 overflow-hidden">
                  <div class="grid grid-rows-[1rem_auto]">
                    <div class="text-[#1A1A1A] text-sm font-medium leading-none">
                      {% if cell_index == 1 %}
                        {% case key %}
                          {% when 'price' %}{{ section.settings.label_price | escape }}
                          {% when 'capacity' %}{{ section.settings.label_capacity | escape }}
                          {% when 'output' %}{{ section.settings.label_output | escape }}
                          {% when 'weight' %}{{ section.settings.label_weight | escape }}
                          {% when 'charge_time' %}{{ section.settings.label_charge_time | escape }}
                        {% endcase %}
                      {% endif %}
                    </div>
                    <div class="mt-2 text-base lg:text-xl">
                      {% case key %}
                        {% when 'price' %}
                          {{ v.price | money }}
                        {% when 'capacity' %}
                          {{ block.settings.capacity | escape }}
                        {% when 'output' %}
                          {{ block.settings.output | escape }}
                        {% when 'weight' %}
                          {{ block.settings.weight | escape }}
                        {% when 'charge_time' %}
                          {{ block.settings.charge_time | escape }}
                      {% endcase %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>

      <script defer>
        (function () {
          var rootId = "v5-sku-product-compare-{{ section.id }}";
          function init(root) {
            if (!root) return;
            var buttons = root.querySelectorAll("[data-sku-compare-add]");
            buttons.forEach(function (btn) {
              if (btn.dataset.bound === "1") return;
              btn.dataset.bound = "1";
              btn.addEventListener("click", function () {
                var id = Number(btn.getAttribute("data-variant-id"));
                if (!id) return;
                btn.classList.add("loading");
                btn.setAttribute("disabled", "disabled");
                var cart = document.querySelector("cart-notification") || document.querySelector("cart-drawer");
                fetch("/cart/add.js", {
                  credentials: "same-origin",
                  headers: { "X-Requested-With": "XMLHttpRequest", "Content-Type": "application/json" },
                  method: "POST",
                  body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
                })
                  .then(function (r) { return r.json(); })
                  .then(function (data) {
                    if (cart && cart.renderContents) cart.renderContents(data);
                    else window.location.href = "/cart";
                  })
                  .catch(function () { window.location.href = "/cart"; })
                  .finally(function () {
                    btn.classList.remove("loading");
                    btn.removeAttribute("disabled");
                    if (cart && cart.classList && cart.classList.contains("is-empty")) cart.classList.remove("is-empty");
                  });
              });
            });
          }
          function boot() {
            init(document.getElementById(rootId));
          }
          document.addEventListener("DOMContentLoaded", boot);
          document.addEventListener("shopify:section:load", function (e) {
            if (e && e.detail && e.detail.sectionId === "{{ section.id }}") boot();
          });
        })();
      </script>

    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "V5 SKU Product Compare",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "通用" },
    { "type": "richtext", "id": "title", "label": "标题", "default": "<p>ポータブル電源容量別 家電製品連続使用時間比較一覧表</p>" },
    { "type": "textarea", "id": "desc", "label": "描述", "default": "BCP対策から日常業務まで幅広く活用される「ポータブル電源+ソーラーパネル」の組み合わせ。従来の非常用電源では得られない数々の利点があります。" },
    { "type": "checkbox", "id": "open_new_window", "label": "详情页新窗口打开", "default": false },
    { "type": "text", "id": "add_to_cart_text", "label": "加购按钮文案", "default": "カートに追加" },
    { "type": "text", "id": "view_detail_text", "label": "详情链接文案", "default": "詳しく見る" },
    { "type": "header", "content": "参数行标题" },
    { "type": "text", "id": "label_price", "label": "行标题：価格", "default": "価格" },
    { "type": "text", "id": "label_capacity", "label": "行标题：容量", "default": "容量" },
    { "type": "text", "id": "label_output", "label": "行标题：出力", "default": "出力" },
    { "type": "text", "id": "label_weight", "label": "行标题：重量", "default": "重量" },
    { "type": "text", "id": "label_charge_time", "label": "行标题：充電時間", "default": "充電時間" },
    { "type": "header", "content": "间距" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "PC上边距", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "PC下边距", "default": 64 },
    { "type": "range", "id": "padding_left", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "PC左边距", "default": 0 },
    { "type": "range", "id": "padding_right", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "PC右边距", "default": 0 },
    { "type": "select", "id": "mb_padding_type", "label": "MB边距", "options": [ { "value": "default", "label": "与PC一致" }, { "value": "custom", "label": "单独配置" } ], "default": "custom" },
    { "type": "range", "id": "padding_top_mb", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "MB上边距", "default": 40, "visible_if": "{{section.settings.mb_padding_type == 'custom' }}" },
    { "type": "range", "id": "padding_bottom_mb", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "MB下边距", "default": 40, "visible_if": "{{section.settings.mb_padding_type == 'custom' }}" },
    { "type": "range", "id": "padding_left_mb", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "MB左边距", "default": 0, "visible_if": "{{section.settings.mb_padding_type == 'custom' }}" },
    { "type": "range", "id": "padding_right_mb", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "MB右边距", "default": 0, "visible_if": "{{section.settings.mb_padding_type == 'custom' }}" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "产品列",
      "settings": [
        { "type": "product", "id": "product", "label": "产品" },
        { "type": "text", "id": "sku", "label": "SKU（用于选中变体）"},
        { "type": "text", "id": "title", "label": "标题覆盖（可选）"},
        { "type": "text", "id": "capacity", "label": "容量", "default": "2000Wh" },
        { "type": "text", "id": "output", "label": "出力", "default": "2000W" },
        { "type": "text", "id": "weight", "label": "重量", "default": "18kg" },
        { "type": "text", "id": "charge_time", "label": "充電時間", "default": "約6時間" }
      ]
    }
  ],
  "presets": [
    { "name": "V5 SKU Product Compare", "category": "V5.0" }
  ]
}
{% endschema %}
