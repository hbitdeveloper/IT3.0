<style>
    .legal-person-blog{
        padding-bottom: calc(var(--pc-padding-bottom) * 1px);
    }
    @media screen and (min-width: 1024px) and (max-width: 1439.98px){
        .legal-person-blog{
            padding-bottom: calc( var(--pc-padding-bottom)  * 100vw / 1440 );
        }
    }
    @media screen and (max-width: 1023.98px){
        .legal-person-blog{
            padding-bottom: calc( var(--mb-padding-bottom) * 100vw / 750 );
        }
    }
</style>

<div class="olight-prnews legal-person legal-person-blog jky-12th-promotion" anchor="{{ section.settings.anchor | escape }}"
style="background: {{ section.settings.bg_color }};--pc-padding-bottom:{{ section.settings.pc_padding_bottom }};--mb-padding-bottom:{{ section.settings.mb_padding_bottom }};"
>
  <div class="jky-12th-container">
    <div class="title">{{ section.settings.title }}</div>
    {%- if section.settings.pc_image != blank -%}
      <a
        target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}"
        href="{{ section.settings.link }}"
        data-ga-event="section_single_banner_user_clicks"
        data-ga-action="click"
        data-ga-params-module="Single Banner"
        data-ga-params-link="{{section.settings.link}}"
        data-ga-params-url="{{section.settings.pc_image | img_url: 'master'}}"
      >
        {% render 'responsive-image', image: section.settings.pc_image, mimage: section.settings.mb_image %}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
    {
      "name": "Legal Person Blog",
      "tag": "section",
      "settings": [
        { "type": "text", "id": "anchor", "label": "二级标题定位锚点", "info": "搭配二级导航锚点定位未使用到定位则不配置" },
        { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false },
        { "type": "number", "id": "pc_padding_bottom", "label": "下边距PC", "default": 72},
        { "type": "number", "id": "mb_padding_bottom", "label": "下边距MB", "default": 120},
        { "type": "color_background", "id": "bg_color", "label": "背景颜色" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "跳转地址" },
        { "type": "image_picker", "id": "pc_image", "label": "PC图(1280*420)"},
        { "type": "image_picker", "id": "mb_image", "label": "MB图(654*500)"}

      ],
      "presets": [
        {
          "name": "Legal Person Blog"
        }
      ]
    }
    {% endschema %}