{% comment %} 悬浮 icon {% endcomment %}
{%- assign fixed_icons = section.blocks | where: 'type', 'fixed_icon' -%}
{%- assign has_new_customer_plugin = false -%}

{%- if fixed_icons.size > 0 -%}
  {%- assign filter_icons_str = '' -%}
  {%- assign full_page_url = request.origin | append: request.path -%}

  {%- for block in fixed_icons -%}
    {%- if block.settings.icon_type == 'new_customer_plugin' -%}
      {%- assign has_new_customer_plugin = true -%}
    {%- endif -%}

    {%- assign all_exclude_page_url_str = block.settings.exclude_page_url -%}
    {%- assign all_exclude_page_url = all_exclude_page_url_str | split: ',' -%}

    {% comment %} 假设该 block 应该被包含 {% endcomment %}
    {%- assign should_include = true -%}

    {% comment %} 检查是否应该排除该 block {% endcomment %}
    {%- if all_exclude_page_url.size > 0 -%}
      {%- for exclude_url in all_exclude_page_url -%}
        {%- assign exclude_url_trim = exclude_url | strip -%}
        {%- if full_page_url contains exclude_url_trim -%}
          {% comment %} 如果匹配到任何排除 URL，设置为不包含 {% endcomment %}
          {%- assign should_include = false -%}
          {% comment %} 找到匹配排除项后退出循环 {% endcomment %}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {% comment %} 将符合条件的 block 添加到过滤数组 {% endcomment %}
    {%- if should_include -%}
      {%- assign type_part = 'type:::' | append: block.settings.icon_type | append: ';' -%}
      {%- assign icon_image = '' -%}
      {%- if block.settings.icon_image != blank -%}
        {%- assign icon_image = block.settings.icon_image | image_url: width: 44, height: 44 -%}
      {%- endif -%}
      {%- assign image_part = 'image:::' | append: icon_image | append: ';' -%}
      {%- assign tips_part = 'tips:::' | append: block.settings.icon_tips | append: ';' -%}
      {%- assign link_part = 'link:::' | append: block.settings.icon_link -%}

      {%- if filter_icons_str == '' -%}
        {%- assign filter_icons_str = type_part | append: image_part | append: tips_part | append: link_part -%}
      {%- else -%}
        {%- assign filter_icons_str = filter_icons_str
          | append: '^+^'
          | append: type_part
          | append: image_part
          | append: tips_part
          | append: link_part
        -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign filter_icons = filter_icons_str | split: '^+^' -%}
  {%- if filter_icons.size > 0 -%}
    {%- render 'fixed-icons', full_icons: fixed_icons, icons: filter_icons -%}

    {% comment %} 拉新插件 {% endcomment %}
    {%- if settings.open_new_customer -%}
      {%- assign initShow = false -%}
      {%- unless filter_icons_str contains 'type:::new_customer_plugin' and has_new_customer_plugin == true -%}
        {%- assign initShow = true -%}
      {%- endunless -%}
      {% render 'new-customer-pop', initShow: initShow %}
    {%- endif -%}
  {%- else -%}
    {% comment %} 拉新插件 {% endcomment %}
    {%- if settings.open_new_customer -%}
      {% render 'new-customer-pop', initShow: true %}
    {%- endif -%}
  {%- endif -%}
{%- else -%}
  {% comment %} 拉新插件 {% endcomment %}
  {%- if settings.open_new_customer -%}
    {% render 'new-customer-pop', initShow: true %}
  {%- endif -%}
{%- endif -%}

<script>
  /**
   * 原生 JS 动画版 footerMenuToggle
   */
  function footerMenuToggle(el = document, multiple = false) {
    const container = el?.jquery ? el[0] : el;
    if (!container || container.dataset.footerAccordionBound === 'true') return;

    container.dataset.footerAccordionBound = 'true';
    const mobileQuery = window.matchMedia('(max-width: 1023.98px)');
    const titleSelector = '.mb-waterfall > .title, .help-footer-item > div > .title';
    const duration = 260;
    const easing = 'cubic-bezier(0.4, 0, 0.2, 1)';
    const getContent = (item) => item?.querySelector('.footer-column');
    const getTitle = (item) => item?.querySelector('.title');

    function clearAnimation(content) {
      if (content._footerAccordionEnd) {
        content.removeEventListener('transitionend', content._footerAccordionEnd);
        content._footerAccordionEnd = null;
      }
      if (content._footerAccordionTimer) {
        window.clearTimeout(content._footerAccordionTimer);
        content._footerAccordionTimer = null;
      }
      if (content._footerAccordionRaf) {
        window.cancelAnimationFrame(content._footerAccordionRaf);
        content._footerAccordionRaf = null;
      }
    }

    function clearStyles(content) {
      Object.assign(content.style, {
        transition: '', overflow: '', height: '', opacity: '', paddingTop: '', paddingBottom: '', boxSizing: '',
      });
    }

    function finish(content, isOpen) {
      clearAnimation(content);
      clearStyles(content);
      content.style.display = isOpen ? 'block' : 'none';
    }

    function getExpandedPadding(content) {
      const { paddingTop, paddingBottom } = content.style;
      content.style.paddingTop = content.style.paddingBottom = '';
      const style = window.getComputedStyle(content);
      const padding = {
        top: Number.parseFloat(style.paddingTop) || 0,
        bottom: Number.parseFloat(style.paddingBottom) || 0,
      };
      content.style.paddingTop = paddingTop;
      content.style.paddingBottom = paddingBottom;
      return padding;
    }

    function slide(content, isOpen) {
      if (!content) return;
      clearAnimation(content);

      const style = window.getComputedStyle(content);
      const isHidden = style.display === 'none';
      if (!isOpen && isHidden) return finish(content, false);

      const startHeight = isHidden ? 0 : Math.round(content.getBoundingClientRect().height);
      const startOpacity = isHidden ? 0 : Number.parseFloat(style.opacity);
      const startPadding = isHidden
        ? { top: 0, bottom: 0 }
        : { top: Number.parseFloat(style.paddingTop) || 0, bottom: Number.parseFloat(style.paddingBottom) || 0 };

      if (isHidden) content.style.display = 'block';
      const targetPadding = isOpen ? getExpandedPadding(content) : { top: 0, bottom: 0 };
      const targetHeight = isOpen ? content.scrollHeight : 0;

      Object.assign(content.style, {
        overflow: 'hidden', transition: 'none', boxSizing: 'border-box', height: `${startHeight}px`,
        opacity: Number.isNaN(startOpacity) ? 1 : startOpacity,
        paddingTop: `${startPadding.top}px`, paddingBottom: `${startPadding.bottom}px`,
      });
      void content.offsetHeight;

      const done = () => finish(content, isOpen);
      content._footerAccordionEnd = (event) => {
        if (event.target === content && event.propertyName === 'height') done();
      };
      content.addEventListener('transitionend', content._footerAccordionEnd);
      content._footerAccordionRaf = window.requestAnimationFrame(() => {
        content.style.transition = `height ${duration}ms ${easing}, padding-top ${duration}ms ${easing}, padding-bottom ${duration}ms ${easing}, opacity 200ms ease-out`;
        content._footerAccordionRaf = window.requestAnimationFrame(() => {
          content._footerAccordionRaf = null;
          Object.assign(content.style, {
            height: `${targetHeight}px`, opacity: isOpen ? 1 : 0,
            paddingTop: `${targetPadding.top}px`, paddingBottom: `${targetPadding.bottom}px`,
          });
          content._footerAccordionTimer = window.setTimeout(done, duration + 80);
        });
      });
    }

    function setState(item, isOpen) {
      item.classList.toggle('open', isOpen);
      getTitle(item)?.setAttribute('aria-expanded', String(isOpen));
      getContent(item)?.setAttribute('aria-hidden', String(!isOpen));
      slide(getContent(item), isOpen);
    }

    function resetForViewport() {
      container.querySelectorAll('.footer-item').forEach((item) => {
        const content = getContent(item);
        if (!content) return;
        clearAnimation(content);
        clearStyles(content);
        content.style.display = '';
        item.classList.remove('open');
        if (mobileQuery.matches) {
          getTitle(item)?.setAttribute('aria-expanded', 'false');
          content.setAttribute('aria-hidden', 'true');
        } else {
          getTitle(item)?.removeAttribute('aria-expanded');
          content.removeAttribute('aria-hidden');
        }
      });
    }

    resetForViewport();
    mobileQuery.addEventListener('change', resetForViewport);
    container.addEventListener('click', (event) => {
      if (!mobileQuery.matches) return;
      const title = event.target.closest(titleSelector);
      const currentItem = title?.closest('.footer-item');
      if (!currentItem || !container.contains(title)) return;

      if (!multiple) {
        container.querySelectorAll('.footer-item.open').forEach((item) => {
          if (item !== currentItem) setState(item, false);
        });
      }
      setState(currentItem, !currentItem.classList.contains('open'));
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('footer-menu-waterfall')
    const columnParsed = parseInt(container?.getAttribute('data-column') || '5', 10)
    const columnCount = isNaN(columnParsed) ? 5 : Math.max(1, columnParsed)

    function applyMasonryLayout() {
      if (!container) return;
      const items = Array.from(container.getElementsByClassName('footer-item'));
      if (!items.length) return;
      if (window.innerWidth >= 1024) {
        const gapX = 8; // 与 CSS 保持一致
        const gapY = 24; // 与 CSS 保持一致
        const containerWidth = container.clientWidth;
        const columnWidth = Math.floor((containerWidth - gapX * (columnCount - 1)) / columnCount);
        items.forEach((item) => {
          item.style.width = `${columnWidth}px`;
        });
        const columnHeights = Array(columnCount).fill(0);
        items.forEach((item) => {
          const minHeight = Math.min(...columnHeights);
          const columnIndex = columnHeights.indexOf(minHeight);
          item.style.top = `${minHeight}px`;
          item.style.left = `${columnIndex * (columnWidth + gapX)}px`;
          columnHeights[columnIndex] += item.offsetHeight + gapY;
        });
        container.style.height = `${Math.max(...columnHeights)}px`;
        container.classList.add('masonry-initialized');
      } else {
        // 移动端菜单点击事件
        footerMenuToggle(document.querySelector('.footer-menu'));

        container.classList.remove('masonry-initialized');
        items.forEach((item) => {
          item.style.top = '';
          item.style.left = '';
          item.style.width = '';
        });
        container.style.height = '';
      }
    }

    requestAnimationFrame(applyMasonryLayout);
    if (window.ResizeObserver && container) {
      const ro = new ResizeObserver(() => requestAnimationFrame(applyMasonryLayout));
      ro.observe(container);
      window.addEventListener('pagehide', () => ro.disconnect());
    } else {
      window.addEventListener('resize', () => requestAnimationFrame(applyMasonryLayout));
    }

    let loading_btn = 'LOADING';
    const submitEl = document.querySelector('footer .newbee-form_submit');
    if (submitEl) {
      const attr = submitEl.getAttribute('data-loading');
      if (attr) loading_btn = attr;
    }

    const styleEl = document.createElement('style');
    styleEl.textContent = `footer button.loading::after { content: "${loading_btn}"; }`;
    document.head.appendChild(styleEl);

    const navItems = document.querySelectorAll('footer .help-footer-item .nav-item');
    navItems.forEach((el) => {
      if (!el.textContent.includes('@')) {
        el.classList.add('no-hover');
      }
    });

    // 埋码
    function toGA(data) {
      if (data.response && data.response.code === 200) {
        const msg =
          document.querySelector('.footer-new .newbee-form_submit button')?.getAttribute?.('data-success') ||
          data.response.message;
        pushSuccessMessage(msg);
        const button_name = document.querySelector('.footer-new .newbee-form_submit button')?.textContent || '';

        // 数据埋码
        gaPushDataLayer('footer_user_clicks4.0', {
          module: 'Footer Subscribe',
          button_name: button_name,
        });

        // 更新 订阅状态
        setTimeout(() => {
          document
            .querySelector('v5-membership-get-benefit')
            ?.getLoggedStatus?.(['email_subscription', 'sms_subscription']);
        }, 3000);
      }
    }
    window.toGA = toGA;
  });
</script>

