{{ 'common-footer.min.css' | asset_url | stylesheet_tag }}
{{ 'sections-footer-new.css' | asset_url | stylesheet_tag }}

{%- if settings.open_delivery_instructions != true -%}
<style>
  a[href="#delivery-instructions-freight"],
  a[href="#delivery-instructions-time"],
  a[href="#delivery-instructions-areas"]{
    cursor: default;
    text-decoration: none;
    color: inherit;
    outline: none;
    pointer-events: none;
  }
</style>
{%- endif -%}
{%- assign footer_menu = linklists[section.settings.footer_link_list] -%}
<footer class="section-footer-container footer-new {%- if settings.open_footerSubscribe == false -%}section-footer-no-subscribe{% endif %}">
  {%- if settings.open_footerSubscribe == true -%}
    <div class="footer-subscribe-container section-container">
      <div class="footer-subscribe-mini flex justify-between">
        <div class="left-mini">
          <h2 class="jky-text-xl font-500">{{ section.settings.newsletter_heading | escape }}</h2>
          <p class="jky-text-base font-400">{{ section.settings.newsletter_subheading | newline_to_br }}</p>
        </div>
        <div class="right-mini">
          <div class="subscribe-main">
            <jky-form
              onsubmitcall="(e)=>toGA(e)"
              jky-form-id="footer-email-subscribe"
              class="subscribe-email footer-subscribe-box"
            >
              <form data-action="/osconsumerapi/v1/notice/subscribe">
                <div class="form-container newbee-form newbee-form_{{section.id}}">
                  {% comment %} 邮箱 {% endcomment %}
                  <div class="form-row flex  full">
                    <div class="form-item bg-white required" data-field="input">
                      <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="{{'newsletter.email_placeholder' | t}}"
                        data-error="{{'newsletter.email_empty_info' | t}}"
                        data-value="email"
                        data-reg="email"
                        data-regerror="{{'newsletter.email_error_info' | t}}"
                      >
                      <div class="required-box">
                        <div class="required-star">*</div>
                      </div>
                    </div>
                  </div>

                  {% comment %} 电话 {% endcomment %}
                  <div class="form-row flex full">
                    <div
                      class="form-item bg-white"
                      data-field="phone_input"
                    >
                      {% render "jky-formField-phoneSelect", id: section.id, required: true, error_text: {{'newsletter.phone_error_info' | t}}, value: 'phone' %}
                    </div>
                  </div>
                  {% comment %} 隐私协议 {% endcomment %}
                  <div class="form-row privacy form-row_check_box flex full">
                    <div
                      class="form-item required"
                      data-field="check_box"
                      data-error="{{'newsletter.policy_empty_info' | t}}"
                    >
                      {% render 'jky-formField-checkbox',
                        key: section.settings.privacy_policy,
                        value: 'agree_recevie'
                      %}
                    </div>
                  </div>

                  <div style="display: none;" class="form-row flex  full">
                    <div class="form-item form-item_const" data-field="input">
                      <input
                        type="text"
                        id="tags"
                        name="tags"
                        data-error=""
                        data-value="tags"
                        data-reg=""
                        value="FOOT-Email-Subcribe"
                        data-regerror=""
                      >
                    </div>
                  </div>

                  <div class="newbee-form_submit flex full" data-loading="{{section.settings.loading_btn}}">
                    <button
                      class="form_sub_btn z-button-middle footer-new-submit"
                      data-success="{{'newsletter.success' | t}}"
                    >
                      {{ section.settings.subcribe_btn }}
                    </button>
                  </div>
                </div>
              </form>
            </jky-form>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
  <div class="category-background">
    <div class="footer-category section-container">
      <div class="footer-menu">
        {% comment %} 瀑布流box {% endcomment %}
        <div
          class="footer-menu-waterfall"
          id="footer-menu-waterfall"
          data-column="{{ section.settings.menu-column }}"
          style="--columns:{{ section.settings.menu-column }};"
        >
          {% for link in footer_menu.links %}
            <div class="footer-item">
              <p class="title font-600 jky-text-base">{{ link.title }}</p>
              <ul class="footer-column">
                {% for childlink in link.links %}
                  <li class="nav-item">
                    {% if childlink.url == '#' %}
                      <span class="jky-text-xs">{{ childlink.title }}</span>
                    {% else %}
                      <a href="{{childlink.url}}" class="jky-text-xs font-500">{{ childlink.title }}</a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endfor %}
        </div>
        {% comment %} mb {% endcomment %}
        {% for link in footer_menu.links %}
          <div class="footer-item mb-waterfall">
            <p
              class="title font-500 jky-text-base"
              {% if settings.jky_theme_version == 'v4' and forloop.index == 1 %}
                style="border-top:0"
              {% endif %}
            >
              {{ link.title }}
              <jds-icon name="arrow-down" class="icon-arrow-down"></jds-icon>
            </p>
            <ul class="footer-column">
              {% for childlink in link.links %}
                <li class="nav-item">
                  {% if childlink.url == '#' %}
                    <span class="jky-text-xs font-500">{{ childlink.title }}</span>
                  {% else %}
                    <a href="{{childlink.url}}" class="jky-text-xs font-500">{{ childlink.title }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
        <div class="footer-item help-footer-item">
          <div>
            <p class="title font-500 jky-text-base">
              {{ section.settings.contact_title | escape }}
            </p>
            <ul class="footer-column">
              {% comment %} 悬浮 icon {% endcomment %}
              {%- assign help_items = section.blocks | where: 'type', 'contact_item' -%}
              {% for block in help_items %}
                <li class="nav-item jky-text-xs font-500">
                  {{ block.settings.text | replace: '<em>', '<em class="special">' }}
                </li>
              {% endfor %}
            </ul>
          </div>
          {% comment %} 社交媒体 {% endcomment %}
          <div class="footer-medias flex section-container gap-4 mb-4">
            {%- if settings.social_facebook_link != blank -%}
              <div class="footer-media-item icon-facebook-box">
                <a
                  href="{{ settings.social_facebook_link }}"
                  title="jackery on Facebook"
                  data-name="Facebook"
                  class="iconfont"
                >
                  {% render 'icon-facebook-new',
                    class: 'iconfont icon-facebook-new',
                    width: 32,
                    height: 32,
                    color: 'var(--icon-color)'
                  %}
                </a>
              </div>
            {%- endif -%}

            {%- if settings.social_instagram_link != blank -%}
              <div class="footer-media-item icon-instagram-box">
                <a
                  href="{{ settings.social_instagram_link }}"
                  title="jackery on Instagram"
                  data-name="Instagram"
                  class="iconfont"
                >
                  {% render 'icon-instagram-new',
                    class: 'iconfont icon-instagram-new',
                    width: 32,
                    height: 32,
                    color: 'var(--icon-color)'
                  %}
                </a>
              </div>
            {%- endif -%}

            {%- if settings.social_twitter_link != blank -%}
              <div class="footer-media-item icon-twitter-box">
                <a href="{{ settings.social_twitter_link }}" title="jackery on X" data-name="X" class="iconfont">
                  {% render 'icon-twitter-new',
                    class: 'iconfont icon-twitter-new',
                    width: 32,
                    height: 32,
                    color: 'var(--icon-color)'
                  %}
                </a>
              </div>
            {%- endif -%}

            {%- if settings.social_linkedin_link != blank -%}
              <div class="footer-media-item icon-linkedin-box">
                <a
                  href="{{ settings.social_linkedin_link }}"
                  title="jackery on LinkedIn"
                  data-name="LinkedIn"
                  class="iconfont"
                >
                  {% render 'icon-linkedin-new',
                    class: 'iconfont icon-linkedin-new',
                    width: 32,
                    height: 32,
                    color: 'var(--icon-color)'
                  %}
                </a>
              </div>
            {%- endif -%}

            {%- if settings.social_youtube_link != blank -%}
              <div class="footer-media-item icon-youtube-box">
                <a
                  href="{{ settings.social_youtube_link }}"
                  title="jackery on YouTube"
                  data-name="YouTube"
                  class="iconfont"
                >
                  {% render 'icon-youtube-new',
                    class: 'iconfont icon-youtube-new',
                    width: 32,
                    height: 32,
                    color: 'var(--icon-color)'
                  %}
                </a>
              </div>
            {%- endif -%}

            {%- if settings.social_tiktok_link != blank -%}
              <div class="footer-media-item icon-tiktok-box">
                <a
                  href="{{ settings.social_tiktok_link }}"
                  title="jackery on TikTok"
                  data-name="TikTok"
                  class="iconfont"
                >
                  {% render 'icon-tiktok-new',
                    class: 'iconfont icon-tiktok-new',
                    width: 32,
                    height: 32,
                    color: 'var(--icon-color)'
                  %}
                </a>
              </div>
            {%- endif -%}

            {%- if settings.social_pinterest_link != blank -%}
              <div class="footer-media-item icon-pinterest-box">
                <a
                  href="{{ settings.social_pinterest_link }}"
                  title="jackery on Pinterest"
                  data-name="Pinterest"
                  class="iconfont"
                >
                  {% render 'icon-pinterest-new',
                    class: 'iconfont icon-pinterest-new',
                    width: 32,
                    height: 32,
                    color: 'var(--icon-color)'
                  %}
                </a>
              </div>
            {%- endif -%}

            {%- if settings.social_reddit_link != blank -%}
              <div class="footer-media-item icon-reddit-box">
                <a
                  href="{{ settings.social_reddit_link }}"
                  title="jackery on Reddit"
                  data-name="Reddit"
                  class="iconfont"
                >
                  {% render 'icon-reddit-new',
                    class: 'iconfont icon-reddit-new',
                    width: 32,
                    height: 32,
                    color: 'var(--icon-color)'
                  %}
                </a>
              </div>
            {%- endif -%}

            {%- if settings.social_line_link != blank -%}
              <div class="footer-media-item icon-line-box">
                <a href="{{ settings.social_line_link }}" title="jackery on LINE" data-name="LINE" class="iconfont">
                  {% render 'icon-line-new',
                    class: 'iconfont icon-line-new',
                    width: 32,
                    height: 32,
                    color: 'var(--icon-color)'
                  %}
                </a>
              </div>
            {%- endif -%}

            {%- if settings.social_threads_link != blank -%}
              <div class="footer-media-item icon-threads-box">
                <a
                  href="{{ settings.social_threads_link }}"
                  title="jackery on threads"
                  data-name="threads"
                  class="leading-none"
                >
                  <jds-icon name="threads" class="iconfont icon-threads align-middle"></jds-icon>
                </a>
              </div>
