          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-container section-container flex">
      <div class="footer-policy-des">
        {{ section.settings.footer_copyright }}
      </div>
      <ul class="footer-supply flex" style="flex-wrap: wrap;">
        {% unless shop.enabled_payment_types == empty %}
          {% if section.settings.show_ideal_icon %}
            <li class="icon--payment">
              {%- render 'icon-ideal-pay' -%}
            </li>
          {% endif %}

          {% if section.settings.show_klarna_icon %}
            <li class="icon--payment">
              <svg
                class="icon icon--full-color"
                role="img"
                width="38"
                height="24"
                viewBox="0 0 38 24"
                aria-labelledby="pi-klarna"
              >
                <title id="pi-klarna">Klarna</title>
                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
