{% schema %}
{ 
  "name": "Banner Subscride",
  "tag": "section",
  "class": "banner-subscride-component",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "sub-title",
      "label": "SubTitle"
    },
    {
      "type": "richtext",
      "id": "privacy_policy",
      "label": "Privacy policy"
    },
    {
      "type": "text",
      "id": "subcribe_btn",
      "label": "Subscribe Btn"
    },
    {
      "type": "text",
      "id": "loading_btn",
      "default": "LOADING",
      "label": "LOADING Btn"
    }
  ],
  "presets": [
    {
      "name": "banner subscride"
    }
  ]
}
{% endschema %}

<style>
  .banner {
    height: auto;
    margin: 0 auto;
    width: 1360px;
    background: #ffffff;
    display: flex;
    justify-content: space-between;
  }
  .banner .banner-subscride-box {
    height: 100%;
    width: 444px;
    background: linear-gradient(180deg, #ffffff 0%, #ede5d4 100%);
    border-radius: 24px;
    padding: 32px;
  }
  .banner .banner-subscride-box .title {
    font-weight: 500;
    font-size: 24px;
    color: #1a1a1a;
    line-height: 32px;
    text-align: center;
    margin-bottom: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
  .banner .banner-subscride-box .sub-title {
    font-size: 16px;
    color: #1a1a1a;
    line-height: 22px;
    text-align: center;
    margin-bottom: 24px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .banner .banner-subscride-box jky-checkbox {
    padding-right: 0;
  }
  .banner .banner-subscride-box .newbee-form .form-row .form-item input {
    background: #ffffff;
    padding-left: 36px;
    border: 1px solid #c8c8c8;
    border-radius: 8px;
  }
  .banner .banner-subscride-box .newbee-form .form-row .jky-phoneselect .form-item input {
    padding-left: 135px;
    background: #ffffff;
    border: 1px solid #c8c8c8 !important;
    border-radius: 8px;
  }
  .banner .banner-subscride-box .required-box {
    position: relative;
  }
  .banner .banner-subscride-box .required-box .required-star {
    position: absolute;
    color: var(--jds-color-primary);
    font-size: 28px;
    left: 12px;
    height: 48px;
    line-height: 60px;
    bottom: 0;
  }
  .banner .banner-subscride-box .newbee-form .form-row .form-item.error input {
    border: 1px solid var(--jds-color-primary) !important;
  }
  .banner .banner-subscride-box .newbee-form .form-row .field_error-tips {
    color: var(--jds-color-primary);
    font-size: 14px;
  }
  .banner .banner-subscride-box .newbee-form .form-row.form-row_check_box .field_error-tips {
    position: relative;
    bottom: 0;
  }
  .banner .banner-subscride-box .newbee-form .form-row .form-item label {
    margin-bottom: 16px;
  }
  .banner .banner-subscride-box .newbee-form .form-row .field_error-tips:first-of-type {
    -webkit-line-clamp: 2;
  }
  .banner .banner-subscride-box .jky-checkbox-label .jky-agree {
    color: #666666;
    font-size: 14px;
    line-height: 20px;
  }
  .banner .banner-subscride-box .jky-checkbox-label .jky-agree p {
    color: #666666;
  }
  .banner .banner-subscride-box .jky-checkbox-label .jky-agree p a {
    color: #666666;
  }
  .banner .banner-subscride-box .form_sub_btn {
    height: 48px;
    width: 100%;
    border-radius: 8px;
    font-size: 18px;
    font-weight: 600;
  }
  
  .banner-subscride-component {
    overflow: visible;
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
  }
  @media screen and (max-width: 1023.98px) {
    .banner {
      width: 100%;
      flex-direction: column-reverse;
    }
    .banner .subscride-mb {
      margin: 0 4.26666667vw;
    }
    .banner .banner-subscride-box {
      width: 100%;
      border-radius: 3.2vw;
      padding: 4.26666667vw;
    }
    .banner .banner-subscride-box .title {
      font-size: 4.8vw;
      line-height: 6.93333333vw;
      margin-bottom: 1.06666667vw;
    }
    .banner .banner-subscride-box .sub-title {
      font-size: 3.46666667vw;
      line-height: 5.6vw;
      margin-bottom: 3.2vw;
    }
    .banner .banner-subscride-box .newbee-form .form-row .form-item input {
      padding-left: 7.2vw;
      height: 10.66666667vw;
      line-height: 10.66666667vw;
      border-radius: 1.6vw;
    }
    .banner .banner-subscride-box .newbee-form .form-row .form-item input::placeholder {
      font-size: 3.46666667vw;
    }
    .banner .banner-subscride-box .newbee-form .form-row .jky-phoneselect .form-item input {
      padding-left: 30.66666667vw;
      height: 10.66666667vw;
      line-height: 10.66666667vw;
      border-radius: 1.6vw;
    }
    .banner .banner-subscride-box .phone_select_prefix {
      height: 10.66666667vw;
      left: 2.66666667vw;
    }
    .banner .banner-subscride-box .required-box .required-star {
      font-size: 6.4vw;
      left: 2.66666667vw;
      height: 10.66666667vw;
      line-height: 13.06666667vw;
    }
    .banner .banner-subscride-box .newbee-form .form-row .field_error-tips {
      font-size: 3.2vw;
    }
    .banner .banner-subscride-box .newbee-form .form-row.form-row_check_box .field_error-tips {
      bottom: -15px;
    }
    .banner .banner-subscride-box .newbee-form .form-row .form-item label {
      margin-bottom: 2.13333333vw;
    }
    .banner .banner-subscride-box .jky-checkbox-label .jky-agree {
      font-size: 3.2vw;
      line-height: 4.26666667vw;
    }
    .banner .banner-subscride-box .form_sub_btn {
      height: 10.66666667vw;
      border-radius: 1.6vw;
      font-size: 4vw;
    }
  }
</style>

<div class="banner">
  <div class="banner-subscride-box">
    <div class="title">{{ section.settings.title }}</div>
    <div class="sub-title">{{ section.settings['sub-title'] }}</div>
    <div class="subscribe-main">
      <jky-form
        onsubmitcall=""
        jky-form-id="footer-email-subscribe"
        class="subscribe-email footer-subscribe-box"
      >
        <form data-action="/osconsumerapi/v1/notice/subscribe">
          <div class="form-container newbee-form newbee-form_{{section.id}}">
            {% comment %} 邮箱 {% endcomment %}
            <div class="form-row flex  full">
              <div class="form-item bg-white required" data-field="input">
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="{{'newsletter.email_placeholder' | t}}"
                  data-error="{{'newsletter.email_empty_info' | t}}"
                  data-value="email"
                  data-reg="email"
                  data-regerror="{{'newsletter.email_error_info' | t}}"
                >
                <div class="required-box">
                  <div class="required-star">*</div>
                </div>
              </div>
            </div>

            {% comment %} 电话 {% endcomment %}
            <div class="form-row flex full">
              <div
                class="form-item bg-white"
                data-field="phone_input"
              >
                {% render "jky-formField-phoneSelect", id: section.id, required: true, error_text: {{'newsletter.phone_error_info' | t}}, value: 'phone' %}
              </div>
            </div>
            {% comment %} 隐私协议 {% endcomment %}
            <div class="form-row privacy form-row_check_box flex full">
              <div
                class="form-item required"
                data-field="check_box"
                data-error="{{'newsletter.policy_empty_info' | t}}"
              >
                {% render 'jky-formField-checkbox', key: section.settings.privacy_policy, value: 'agree_recevie' %}
              </div>
            </div>

            <div style="display: none;" class="form-row flex  full">
              <div class="form-item form-item_const" data-field="input">
                <input
                  type="text"
                  id="tags"
                  name="tags"
                  data-error=""
                  data-value="tags"
                  data-reg=""
                  value="Simple-Subscribe"
                  data-regerror=""
                >
              </div>
            </div>

            <div style="display: none;" class="form-row flex  full">
              <div class="form-item form-item_const" data-field="input">
                <input
                  type="text"
                  id="componentName"
                  name="componentName"
                  data-value="componentName"
                  value="订阅banner"
                >
              </div>
            </div>

            <div style="display: none;" class="form-row flex full page-url">
              <div class="form-item form-item_const" data-field="input">
                <input
                  type="text"
                  id="pageUrl"
                  name="pageUrl"
                  data-value="pageUrl"
                  value=""
                >
              </div>
            </div>

            <div class="newbee-form_submit flex full" data-loading="{{section.settings.loading_btn}}">
              <button class="form_sub_btn z-button-middle">{{ section.settings.subcribe_btn }}</button>
            </div>
          </div>
        </form>
      </jky-form>
    </div>
  </div>
</div>

<script defer>
  (function () {
    const init = function () {
      const pageUrlInput = document.querySelector('.banner-subscride-box .page-url input');
      if (pageUrlInput) {
        pageUrlInput.value = window.location.href;
      }

      const submitWrap = document.querySelector('.banner-subscride-box .newbee-form_submit');
      const loadingBtn = submitWrap ? (submitWrap.getAttribute('data-loading') || 'LOADING') : 'LOADING';

      const styleEl = document.createElement('style');
      styleEl.textContent = `.banner-subscride-box button.loading::after { content: "${String(loadingBtn).replace(/"/g, '\\"')}"; }`;
      document.head.appendChild(styleEl);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
