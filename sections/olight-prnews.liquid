<div class="olight-prnews jky-12th-promotion" anchor="{{ section.settings.anchor | escape }}" style="background: {{ section.settings.bg_color }}">
  <div class="jky-12th-container">
    <div class="title">{{ section.settings.title }}</div>
    {%- if section.settings.pc_image != blank -%}
      <a
        target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}"
        href="{{ section.settings.link }}"
        data-ga-event="section_single_banner_user_clicks"
        data-ga-action="click"
        data-ga-params-module="Single Banner"
        data-ga-params-link="{{section.settings.link}}"
        data-ga-params-url="{{section.settings.pc_image | img_url: 'master'}}"
      >
        {% render 'responsive-image', image: section.settings.pc_image, mimage: section.settings.mb_image %}
      </a>
    {%- endif -%}

    <div class="list-box">
      {% for block in section.blocks %}
        {% if block.settings.img != blank %}
          <div class="news-item">
            {% render 'responsive-image', image: block.settings.img, image_class: 'pr-img' %}
            <div class="bottom-box">
              <div class="text text-overflow-2">{{ block.settings.title }}</div>
              {%- if block.settings.link != blank -%}
                <a
                  target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}"
                  href="{{ block.settings.link }}"
                  data-ga-event="section_blog_user_clicks"
                  data-ga-action="click"
                  data-ga-params-module="Blog"
                  data-ga-params-position="{{ block.settings.title }}"
                  data-ga-params-button_name="Circle Button"
                  data-ga-params-link="{{ block.settings.link }}"
                >
                  <div class="link">
                    <svg
                      class="line"
                      width="20"
                      height="15"
                      viewBox="0 0 20 15"
                      version="1.1"
                      xmlns="http://www.w3.org/2000/svg"
                      xmlns:xlink="http://www.w3.org/1999/xlink"
                    >
                      <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                          <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                              <g transform="translate(672.000000, 286.000000)">
                                  <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                              </g>
                          </g>
                      </g>
                    </svg>
                  </div>
                </a>
              {%- endif -%}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Olight Prnews",
  "tag": "section",
  "settings": [
    { "type": "text",  "id": "anchor", "label": "二级标题定位锚点" },
    { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false },
    { "type": "color_background", "id": "bg_color", "label": "背景颜色" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "url", "id": "link", "label": "跳转地址" },
    { "type": "image_picker", "id": "pc_image", "label": "PC图(1280*420)" },
    { "type": "image_picker", "id": "mb_image", "label": "MB图(654*500)" }
  ],
  "blocks": [
    {
      "name": "pr Item",
      "type": "slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "图片"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "按钮跳转链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Olight Prnews"
    }
  ]
}
{% endschema %}
