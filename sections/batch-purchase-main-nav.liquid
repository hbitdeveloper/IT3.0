<div class="batch-purchase-unit-off"
  data-unit="{{section.settings.unit}}"
  data-off="{{section.settings.off}}"
  data-orMore="{{section.settings.orMore}}">
    <div class="batch-purchase-container">
        <div class="nav-block">
            {%- for item in section.blocks -%}
              <div class="nav-item"
                :class="[active === '{{item.settings.select}}' ? 'nav-active' :'']"
                @click="handleNav('{{item.settings.select}}', '{{item.settings.title}}')">{{ item.settings.title | escape}}</div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% schema %}
  {
    "name": "Batch Purchase Nav",
    "tag": "div",
    "class": "batch-purchase--nav cal_scroll_target",
    "settings": [
      {
        "type": "text",
        "id": "unit",
        "label": "Pcs",
        "default": "pcs"
      }, {
        "type": "text",
        "id": "off",
        "label": "OFF",
        "default": "OFF"
      }, {
        "type": "text",
        "id": "orMore",
        "label": "Or More",
        "default": "or more"
      }
    ],
    "blocks": [
      {
        "type": "block_nav",
        "name": "Nav",
        "settings": [
          { "type": "text", "id": "title", "label": "标题名称" },
          { "type": "select", "id": "select", "label": "选择集合类型",
            "options": [
              { "value": "pps", "label": "Portable Power Station" },
              { "value": "sg", "label": "Solar Generator" },
              { "value": "sp", "label": "Solar Panels" },
              { "value": "acc", "label": "Accessories" }
            ]
          }
        ]
      }
    ]
  }
{% endschema %}