
{% comment %}
    @description: 为什么选择我们？
{% endcomment %}

{% style %}
    .why-choose {
        background: #fff;
    }
    .why-choose .container{
        width: 1312px;
        margin: 36px auto;
        padding-bottom: 36px;
    }
   .why-choose .section-title {
        text-align: center;
        margin-bottom: 40px;
        font-weight: 500;
        font-size: 40px;
        color: #1A1A1A;
        line-height: 48px;
    }
    .why-choose .choose-list{
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-gap: 20px;
    }
    .why-choose .choose-list .why-choose-item{
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
    }
    .why-choose .choose-list .why-choose-item .item-icon{
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
    }
    .why-choose .choose-list .why-choose-item .item-icon img{
        width: 80px;
        height: 80px;
    }
    .why-choose .choose-list .why-choose-item .item-title{
        font-weight: 600;
        font-size: 20px;
        color: #1A1A1A;
        line-height: 32px;
        margin-bottom: 20px;
        text-align: center;
    }
    .why-choose .choose-list .why-choose-item .item-desc{
        font-weight: 400;
        font-size: 16px;
        color: #666666;
        line-height: 24px;
        text-align: center;
    }

    @media screen and (max-width: 1440px) {
        .why-choose .container{
            width: 91.11vw;
            margin: 2.5vw auto;
            padding-bottom: 2.5vw;
        }
        .why-choose .section-title {
            margin-bottom: 2.78vw;
            font-size: 2.78vw;
            line-height: 3.33vw;
        }
        .why-choose .choose-list{
            display: grid;
            grid-gap: 1.39vw;
        }
        .why-choose .choose-list .why-choose-item .item-icon{
            height: 10.42vw;
            margin-bottom: 1.25vw;
        }
        .why-choose .choose-list .why-choose-item .item-icon img{
            width: 5.56vw;;
            height: 5.56vw;;
        }
        .why-choose .choose-list .why-choose-item .item-title{
            font-size: 1.39vw;
            line-height: 2.22vw;
            margin-bottom: 1.39vw;
        }
        .why-choose .choose-list .why-choose-item .item-desc{
            font-size: 1.11vw;
            line-height: 1.67vw;
        }
    }

    @media screen and (max-width: 1024px) {
        .why-choose .container{
            width: 91.47vw;
            margin: 9.6vw auto;
            padding-bottom: 2.5vw;
        }
        .why-choose .section-title {
            font-size: 7.47vw;
            margin-bottom: 6.4vw;
            line-height: 9.6vw;
        }
        .why-choose .choose-list{
            grid-gap: 4.26vw;
            grid-template-columns: repeat(2, 1fr);
        }
        .why-choose .choose-list .why-choose-item .item-icon{
            height: 16vw;
            margin-bottom: 2.67vw;
        }
        .why-choose .choose-list .why-choose-item .item-icon img{
            width: 13.33vw;
            height: 13.33vw;
        }
        .why-choose .choose-list .why-choose-item .item-title{
            font-size: 3.73vw;
            line-height: 5.33vw;
            margin-bottom: 2.13vw;
        }
        .why-choose .choose-list .why-choose-item .item-desc{
            font-size: 3.47vw;
            line-height: 4.53vw;
        }
    }

{% endstyle %}

<div class="why-choose" id="{{ section.settings.anchor | escape  }}" data-handle="{{ section.settings.anchor | escape }}">
    <div class="container">
        <div class="section-title"> <h2>{{ section.settings.title | escape}}</h2></div>
        <div class="choose-list">
            {% for block in section.blocks %}
            <div class="why-choose-item">
                <div class="item-icon">
                    {% render 'responsive-image', image: block.settings.icon, width: 80, height: 80 %}
                </div>
                <div class="item-title">{{ block.settings.title | escape}}</div>
                <div class="item-desc rte">{{ block.settings.description | replace: '<em>', '<em style="color: var(--jds-color-primary)">' }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "为什么选择我们？",
        "settings": [
            { "type": "text", "id": "anchor", "label": "版块锚点", "info": "当前模板需要具有唯一值" },
            { "type": "text", "id": "title", "label": "标题", "default": "为什么选择我们？" }
        ],
        "blocks": [
            {
                "type": "why-choose-item",
                "name": "Item",
                "settings": [
                    { "type": "image_picker", "id": "icon", "label": "图标（80 * 80）" },
                    { "type": "text", "id": "title", "label": "标题", "default": "标题" },
                    { "type": "richtext", "id": "description", "label": "描述" }
                ]
            }
        ],
        "presets": [
            {
                "name": "为什么选择我们？",
                "settings": {
                    "title": "Why Choose Jackery's Official Website?"
                },
                "blocks": [
                    {
                        "type": "why-choose-item",
                        "settings": {
                            "title": "Free & Fast Shipping",
                            "description": "<p>Orders are usually processed and delivered within 3–4 business days</p>"
                        }
                    }
                ]
            }
        ]
    }
{% endschema %}
