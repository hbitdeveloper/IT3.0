{% render 'new-title', title: section.settings.title, type: section.settings.type, bgColor: section.settings.background, color: section.settings.color %}

{% schema %}
    {
        "name": "动效标题",
        "disabled_on": {
            "templates": ["collection"]
        },
        "settings": [
            { "type": "text",  "id": "title", "label": "标题" },
            { "type": "select", "id": "type", "label": "标题类型", "options": [
                { "value": "1", "label": "小档" },
                { "value": "2", "label": "大档" }
            ], "default": "1"},
            { "type": "color", "id": "color", "label": "文本颜色", "default": "#000"},
            { "type": "color", "id": "background", "label": "Background", "default": "#fff" }

        ],
        "presets": [
            {
                "name": "动效标题"
            }
        ]
    }
{% endschema %}
