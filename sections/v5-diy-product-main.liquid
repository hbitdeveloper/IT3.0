{{ 'section-v5-main-product.min.css' | asset_url | stylesheet_tag }}

{% comment %} dev css {% endcomment %}
<style>
    v5-diy-main {
        --text-main-color: rgba(36,47,32,1);
        --text-sub-color: rgba(0,0,0,0.65);
        --text-thin-color: #999999;
    }
    v5-diy-main .text-main-color {
        color: var(--text-main-color);
    }
    v5-diy-main .text-main-bg {
      background: var(--text-main-color);
  }
    v5-diy-main .text-sub-color {
        color: var(--text-sub-color);
    }
    v5-diy-main .text-thin-color {
        color: var(--text-thin-color);
    }
    v5-diy-main .inset-1 {
        inset: 0.25rem;
    }

    v5-diy-main .diy-tabs-item:not(.active) {
        opacity: 0.8;
    }
    v5-diy-main .tabSlide_line-wrapper .tabSlide_line-line, v5-diy-main .diy-tabs-item {
        transition: all .3s ease;
    }

    .diy-product-summary-main {
        background: #f5f5f3;
    }

    .diy-product-summary-lineItem:not(:first-child) {
      padding-top: 1rem;
    }
    .diy-product-summary-lineItem:not(:last-child) {
      border-bottom: dashed 1px rgb(217, 217, 217);
    }
    .diy-product-summary-footer {
      border-top: solid 1px var(--text-thin-color);
    }


    {% comment %} 购买按钮 {% endcomment %}
    @media (min-width: 1024px) {
      v5-diy-main .product-form__buttons {
        column-gap: 1rem;
      }
    }
    v5-diy-main .product-form__buttons .jky-v5-button-ghost {
      flex: 1;
    }
    {% comment %} 购买按钮 {% endcomment %}
     @media screen and (max-width:1023px) {
      .product-tax_fee_explanation{
        max-width: 91.4666666666667vw;
        width: 91.4666666666667vw;
        margin: 0 auto;
      }
    }
</style>
{% comment %} dev css {% endcomment %}

{%- liquid
  assign model_3d = product.media | where: 'media_type', 'model'
  if product.metafields.custom.modals_list.value != blank
    assign model_3d = product.metafields.custom.modals_list.value
  endif

  assign first_video_media = false
  assign first_video_media = product.media | where: 'media_type', 'video' | first
  if first_video_media == false or first_video_media == blank
    assign first_video_media = product.media | where: 'media_type', 'external_video' | first
  endif

  assign icon_text_block = section.blocks | where: 'type', 'icon_text'


  assign main_product_price = blank
  assign main_product_origin_price = blank

  # 欧洲站点，需要修改产品标签、标题的默认字体大小
  assign need_modify_size = false
  assign iso_code = settings.shop_cr | default: localization.country.iso_code | default: 'US'
  if iso_code == 'GB' or iso_code == 'DE' or iso_code == 'FR' or iso_code == 'ES' or iso_code == 'EU' or iso_code == 'NL'
    assign need_modify_size = true
  endif
-%}


<div data-version="v5" style="max-width:100%;width:82.5rem;margin:0 auto;display:flex;justify-content:space-between;" class="flex-col lg:flex-row pt-6 pb-10 lg:py-[3.75rem]">
  {% comment %} 图片、视频、3D、延保信息 {% endcomment %}
  <div class="v5-product-gallery-wrapper flex flex-col self-start relative lg:sticky lg:top-[calc(var(--jky-header-h)+2.25vh)] w-[21.4375rem] mx-auto lg:w-[40.5rem] lg:mx-0 lg:gap-y-3">
    {% comment %} 商品图、视频、3D {% endcomment %}
    <div class="w-full lg:w-[40.5rem]">
      {%- render
        "v5-product-gallery",
          img_product_tag_position_pc: section.settings.img_product_tag_position_pc,
          img_product_tag_width_pc: section.settings.img_product_tag_width_pc,
          img_product_tag_width_mb: section.settings.img_product_tag_width_mb,

          photos_i18n: section.settings.product_photos_i18n | escape,
          video_i18n: section.settings.product_video_i18n | escape,
          model_i18n: section.settings.product_3d_model_i18n | escape,

          show_3d_model_unfold: section.settings.product_3d_model_show_unfold,
          unfolded_i18n: section.settings.product_unfolded_i18n | escape,
          folded_i18n: section.settings.product_folded_i18n | escape,

          first_video_media: first_video_media,
          model_3d: model_3d,

          is_diy: true
      -%}
    </div>

    {% comment %} 技术证书 {% endcomment %}
    {%- for block in icon_text_block -%}
      {%- if block.settings.position == 'pos_1' -%}
        {%- render 'v5-app-pdp-icon-text', block: block, class: 'hidden lg:flex' -%}
      {%- endif -%}
    {%- endfor -%}

    {% comment %} 特征图片 {% endcomment %}
    {%- assign feature_image_list = product.metafields.custom.feature_image_list.value -%}
    {%- if feature_image_list -%}
      <div class="w-full hidden lg:flex flex-col gap-y-2 mt-8 lg:gap-y-3 lg:mt-0">
        {%- for image in feature_image_list limit: 2 -%}
          {%- render 'diff-end-img',
            class: 'w-full h-auto lg:w-[40.5rem] object-cover',
            pc_img: image,
            mb_img: image,
            pc_img_width: 648,
            mb_img_width: 375,
            placeholder_name: 'hero-apparel-1'
          -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div>
    {% comment %} DIY 推荐-商品信息 {% endcomment %}
    <div class="v5-product-info-wrapper w-[21.4375rem] mx-auto lg:w-[40.5rem] lg:mx-0 lg:pl-6" onlyVariant="{{ product.has_only_default_variant }}">
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {% comment %} 插件 {% endcomment %}
                {%- when '@app' -%}
                <div {{ block.shopify_attributes }}>{% render block %}</div>

                {% comment %} 标题 {% endcomment %}
                {%- when 'title' -%}
                {%- capture pdp_title_style -%}
                    {% render 'spacing-padding', settings: block.settings %}
                {%- endcapture -%}

                {%- assign title_parts = product.title | escape | split: '  ' -%}
                {%- if title_parts.size > 1 and need_modify_size == false -%}
                    <h1 class="flex flex-col gap-y-1.5 lg:gap-y-3.5 section-padding" style="{{ pdp_title_style }}" {{ block.shopify_attributes }}>
                      <span class="font-semibold text-[#242F20]/90 text-base lg:text-2xl">{{ title_parts[0] }}</span>
                      <span
                        style="
                          --title-size-pc: calc({% if block.settings.title_size_pc > 0 %}{{ block.settings.title_size_pc }}{% else %}48{% endif %} / 16 * 1rem);
                          --title-size-mb: calc({% if block.settings.title_size_mb > 0 %}{{ block.settings.title_size_mb }}{% else %}28{% endif %} / 16 * 1rem);
                          line-height:1.25;
                        "
                        class="font-semibold text-[#242F20] !text-[length:var(--title-size-mb)] lg:!text-[length:var(--title-size-pc)]"
                      >{{ title_parts[1] }}</span>
                    </h1>
                {%- else -%}
                    <h1
                      {% if need_modify_size %}
                        style="
                          --title-size-pc: calc({% if block.settings.title_size_pc > 0 %}{{ block.settings.title_size_pc }}{% else %}32{% endif %} / 16 * 1rem);
                          --title-size-mb: calc({% if block.settings.title_size_mb > 0 %}{{ block.settings.title_size_mb }}{% else %}24{% endif %} / 16 * 1rem);
                          line-height:1.25;
                        "
                      {% else %}
                        style="
                          --title-size-pc: calc({% if block.settings.title_size_pc > 0 %}{{ block.settings.title_size_pc }}{% else %}48{% endif %} / 16 * 1rem);
                          --title-size-mb: calc({% if block.settings.title_size_mb > 0 %}{{ block.settings.title_size_mb }}{% else %}28{% endif %} / 16 * 1rem);
                          line-height:1.25;
                        "
                      {% endif %}
                      class="font-semibold text-[#242F20] !text-[length:var(--title-size-mb)] lg:!text-[length:var(--title-size-pc)]"
                    {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
                {%- endif -%}

                {% comment %} 价格 {% endcomment %}
                {%- when 'price' -%}
                {%-
                    render 'v5-app-pdp-product-price',
                    show_product_direct_way: section.settings.show_product_direct_way | default: false,
                    product_direct_way: section.settings.product_direct_way | default: 'way_one',
                    product_direct_way_three_text: section.settings.product_direct_way_three_text | default: 'Final Price',
                    product: product,
                    block: block,
                    sectionId: section.id,
                    tax_fee_explanation: section.settings.tax_fee_explanation
                -%}

                {% comment %} 配送与服务说明设置 {% endcomment %}
                {%- when 'delivery_instructions' %}
                  {%- render 'delivery-instructions', block: block -%}

                {% comment %} 促销文案机动版块 {% endcomment %}
                {%- when 'text_promotion' -%}
                  {% render 'app-text-promotion', block: block %}

                {% comment %} 特性文案 {% endcomment %}
                {%- when 'product_feature_text' -%}
                {%- render 'v5-app-pdp-product-feature-text', product: product, block: block -%}

                {% comment %} 会员价 {% endcomment %}
                {%- when 'membership_price_coupon' -%}
                {% render 'v5-app-membership-price-coupon', block: block, sectionId: section.id %}

                {% comment %} 优惠券 {% endcomment %}
                {%- when 'coupon' -%}
                {% render 'v5-app-coupon', block: block %}

                {% comment %} 商品描述 {% endcomment %}
                {%- when 'description' -%}
                {% comment %} 技术证书 {% endcomment %}
                {%- for block in icon_text_block -%}
                    {%- if block.settings.position == 'pos_1' -%}
                    {%- render 'v5-app-pdp-icon-text', block: block, class: 'flex lg:hidden' -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- render 'v5-app-pdp-description', product: product, block: block -%}

                {% comment %} 买赠 {% endcomment %}
                {%- when 'free_gift' -%}
                {%- render 'v5-app-pdp-free-gift', block: block -%}
            {%- endcase -%}
        {%- endfor -%}


        <v5-diy-main class="block lg:pt-10 pt-8" data-price-format="{{ settings.discount_amount_format }}">
            <div class="h-11 lg:h-14 flex relative bg-[#E8E8E5] diy-tabs-wrapper w-full">
              <div style="width:50%;" class="w-1/2 diy-tabs-item relative z-[1] text-center text-[#242F20] flex items-center justify-center font-semibold text-sm lg:text-xl cursor-pointer" data-tab="diy-custom-info">{{ section.settings.text_recommend }}</div>

              <div style="width:50%;" class="w-1/2 diy-tabs-item relative z-[1] text-center text-[#242F20] flex items-center justify-center font-semibold text-sm lg:text-xl cursor-pointer active" data-tab="diy-recommend-info">{{ section.settings.text_combination }}</div>

                <div class="tabSlide_line-wrapper absolute inset-1">
                    <div class="tabSlide_line-line bg-white absolute top-0 bottom-0 overflow-hidden">
                    </div>
                </div>
            </div>

            <div class="diy-custom-info lg:pt-16 pt-8 hidden">
              <div class="font-semibold text-xl lg:text-xl text-main-color lg:pb-5 pb-3" data-diy-custom-info-title>{{ section.settings.text_wir_emp | escape }}</div>
              <div class="flex flex-col gap-y-5">
                {%- if product.metafields.custom.diy.value.recommends.value != blank -%}
                  {%- for recommend_product in  product.metafields.custom.diy.value.recommends.value -%}
                    <div 
                      data-variant="{{ recommend_product.id }}" 
                      {% if recommend_product.featured_media != blank %}
                        data-media="{{ recommend_product.featured_media.src | image_url: width: 750 }}"
                      {% endif %}
                      class="diy-variant-select variant-select {% if product.selected_or_first_available_variant.id == recommend_product.id %}active{% endif %}"
                    >
                      <div
                        class="diy-variant-select-wrapper relative cursor-pointer flex flex-wrap lg:px-4 px-3 py-4 min-h-[5.4375rem] lg:min-h-[6.125rem] {% unless recommend_product.available %}disabled{% endunless %}"
                      >
                        {%- assign variant_tag = recommend_product.metafields.custom.variant_tag -%}
                        <div class="w-full flex items-center gap-x-1 {% if variant_tag != blank %} justify-between {% else %} justify-end {% endif %}">
                          {%- if variant_tag != blank -%}
                            <span class="text-white bg-[#242F20] font-semibold text-xs lg:text-base px-2 lg:px-3 lg:py-0.5 py-1">{{ variant_tag | escape }}</span>
                          {%- endif -%}
                          <div class="option-price flex items-center gap-x-1" data-product-id="{{ product.id }}" data-variant-id="{{ recommend_product.id }}">
                            {%- assign l_variant = recommend_product -%}
                            {%- assign l_price = l_variant.price -%}
                            {%- assign l_origin_price = l_variant.compare_at_price | default: l_price -%}
                            {%- if settings.open_auto_discount_price and settings.display_auto_discount_price_in_sku -%}
                              {%- assign l_auto_discount_price = l_variant.metafields.custom.auto_discount_price | times: 1 -%}
                              {%- if l_auto_discount_price > 0 and l_auto_discount_price < l_variant.price -%}
                                {%- assign l_price = l_auto_discount_price -%}
                              {%- endif -%}
                            {%- endif -%}
                            {%- if l_origin_price < l_variant.price -%}
                              {%- assign l_origin_price = l_variant.price -%}
                            {%- endif -%}
                            <span class="price text-base lg:text-xl text-[#1A1A1A] font-semibold whitespace-nowrap">{{ l_price | money }}</span>
                            {%- if l_origin_price > l_price -%}
                              <span class="origin-price text-xs lg:text-sm text-black/65 line-through whitespace-nowrap">{{ l_origin_price | money }}</span>
                            {%- endif -%}
                          </div>
                        </div>
                        <div class="w-full flex items-start pt-4 lg:pt-5">
                          <h2 class="flex-1 text-[#242F20] font-semibold text-base lg:text-xl">
                            {%- if recommend_product.option2 == section.settings.without_option -%}
                              {%- assign target_value = recommend_product.option1 -%}

                              {%- assign option1 = product.options_with_values[0] -%}
                              {%- assign target_index = nil -%}
                              
                              {%- for value in option1.values -%}
                                {% if value == target_value %}
                                  {%- assign target_index = forloop.index -%}
                                  {%- break -%}
                                {% endif %}
                              {%- endfor -%}

                              {%-liquid
                                assign variant_metafields = nil
                                for custom_variant in  product.metafields.custom.diy.value.main_product.value
                                    if target_index == forloop.index
                                        assign variant_metafields = custom_variant
                                        break
                                    endif
                                endfor  
                              -%}

                              {%- render 'variant-name', variant: variant_metafields -%}
                            {%- else -%}
                              {%- if recommend_product.metafields.custom.shortname != blank -%}
                                {{ recommend_product.metafields.custom.shortname }}
                              {%- else -%}
                                {{ recommend_product.option1}} + {{ recommend_product.option3}} {{ recommend_product.option2}}
                              {%- endif -%}
                            {%- endif -%}
                          </h2>
                          <span class="font-semibold pl-5 text-sm leading-6 lg:text-base {% if recommend_product.available == true %}visually-hidden{% endif %}">{{ 'products.product.sold_out' | t }}</span>
                        </div>
                        {% if recommend_product.metafields.custom.variant_desc != blank %}
                          <div class="variant-richtext-wrap">
                            <div class="variant-richtext">
                              {{ recommend_product.metafields.custom.variant_desc | metafield_tag }}
                            </div>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>

            <div class="diy-recommend-info">
              {%- for block in section.blocks -%}
                  {%- case block.type -%}
                      {% comment %} 多变体切换 {% endcomment %}
                      {%- when 'variant_picker' -%}
                      {%- render 'diy-variant-picker', product: product, block: block, sectionId: section.id -%}

                      {% comment %} 快捷入口 {% endcomment %}
                      {%- when 'quike_chat' -%}
                      {%- render 'v5-app-pdp-quick-chat', block: block -%}

                      {% comment %} 产品推荐 {% endcomment %}
                      {%- when 'recommend_products' -%}
                      {%- render 'v5-app-recommend-products', product: product, block: block -%}

                      {% comment %} 自动延保 {% endcomment %}
                      {%- when 'auto_extended_warranty' -%}
                      {%- render 'v5-app-pdp-auto-warranty', block: block -%}

                      {% comment %} 促销文案折叠组件 {% endcomment %}
                      {%- when 'text_promotion_fold' -%}
                      {% render 'app-text-promotion-fold', block: block %}

                      {% comment %} 自定义liquid {% endcomment %}
                      {%- when 'custom_liquid' -%}
                      {%- render 'v5-app-custom-liquid', block: block -%}
                  {%- endcase -%}
              {%- endfor -%}

              {%- if product.has_only_default_variant == true -%}
                  {%- render "product-variants-json", variant: product.selected_or_first_available_variant, id: "selected-variant", show_discount_price: settings.display_auto_discount_price_in_sku -%}
              {%- else -%}
                  {%- render "product-variants-json", variants: product.variants, id: "selected-variant", show_discount_price: settings.display_auto_discount_price_in_sku -%}
              {%- endif -%}
          </div>

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'bundled_sale' -%}
                {%- render 'v5-app-bundled-sale', product: product, block: block, is_diy: true -%}
              {%- endcase -%}
          {%- endfor -%}

            <div>
              <div 
                class="diy-product-summary flex flex-col gap-y-6 pt-4 lg:pt-8"
              >
                  <div class="font-semibold text-xl text-main-color">{{ section.settings.select_items_label | escape }}</div>
                  <div class="diy-product-summary-main lg:px-6 px-3 lg:py-6 py-4">
                      <div class="diy-product-summary-lines">
                        {% comment %} 当前变体产品 {% endcomment %}
                          {%- if product.selected_or_first_available_variant != blank -%}
                            {%- liquid
                              if product.selected_or_first_available_variant.featured_media
                                assign current_media = product.selected_or_first_available_variant.featured_media
                              else
                                assign current_media = product.featured_media
                              endif
                            -%}
                          <div class="diy-product-summary-lineItem diy-product-summary-lineItem__selectedVariants flex gap-x-4 pb-4 relative flex-col lg:flex-row">
                              <div class="flex-1 flex lg:gap-x-6 gap-x-3">
                                  <img
                                    src="{{ current_media | image_url: width: 300 }}"
                                    class="lg:w-20 w-14 lg:h-20 h-14 object-contain"
                                    alt="{{ current_media.alt | escape }}"
                                    loading="lazy"
                                    width="150"
                                    height="{{ 150 | divided_by: current_media.aspect_ratio | ceil }}"
                                  >

                                    {%- assign target_value = product.selected_or_first_available_variant.option1 -%}

                                    {%- assign option1 = product.options_with_values[0] -%}
                                    {%- assign target_index = nil -%}
                                    
                                    {%- for value in option1.values -%}
                                      {% if value == target_value %}
                                        {%- assign target_index = forloop.index -%}
                                        {%- break -%}
                                      {% endif %}
                                    {%- endfor -%}

                                    {%-liquid
                                      assign variant_metafields = nil
                                      for custom_variant in  product.metafields.custom.diy.value.main_product.value
                                          if target_index == forloop.index
                                              assign variant_metafields = custom_variant
                                              break
                                          endif
                                      endfor  
                                    -%}

                                  <div class="flex flex-col gap-y-4 pt-4">
                                      <div class="font-semibold lg:text-base text-sm text-main-color lineitem__title">
                                        {%- if product.selected_or_first_available_variant.option2 == section.settings.without_option -%}
                                          {%- assign target_value = product.selected_or_first_available_variant.option1 -%}

                                          {%- assign option1 = product.options_with_values[0] -%}
                                          {%- assign target_index = nil -%}
                                          
                                          {%- for value in option1.values -%}
                                            {% if value == target_value %}
                                              {%- assign target_index = forloop.index -%}
                                              {%- break -%}
                                            {% endif %}
                                          {%- endfor -%}

                                          {%-liquid
                                            assign variant_metafields = nil
                                            for custom_variant in  product.metafields.custom.diy.value.main_product.value
                                                if target_index == forloop.index
                                                    assign variant_metafields = custom_variant
                                                    break
                                                endif
                                            endfor  
                                          -%}

                                          {% comment %} {%- if variant_metafields.product.has_only_default_variant -%}
                                            {%- if variant_metafields.product.metafields.custom.shortname != blank -%}
                                              {{ variant_metafields.product.metafields.custom.shortname }}
                                            {%- else -%}
                                              {{ variant_metafields.product.title }}
                                            {%- endif -%}
                                          {%- else -%}
                                            {%- if variant_metafields.metafields.custom.shortname != blank -%}
                                              {{ variant_metafields.metafields.custom.shortname }}
                                            {%- else -%}
                                              {{ variant_metafields.title }}
                                            {%- endif -%}
                                          {%- endif -%} {% endcomment %}

                                          {%- render "variant-name", variant: variant_metafields -%}
                                        {%- else -%}
                                          {{ product.selected_or_first_available_variant.option1}} + {{ product.selected_or_first_available_variant.option3}} {{ product.selected_or_first_available_variant.option2}}
                                        {%- endif -%}
                                      </div>
                                      <div class="font-semibold text-lg text-sub-color">x1</div>
                                  </div>
                              </div>

                              <div class="flex flex-col text-right gap-y-1 lg:pt-4">
                                  {%- assign selected_variant = product.selected_or_first_available_variant -%}
                                  <div 
                                    class="absolute lg:static bottom-4 right-0 option-price flex gap-y-1 lg:flex-col flex-row lg:items-end gap-x-1 lg:gap-x-0 lg:justify-end items-baseline" data-variant-id="{{ selected_variant.id }}">
                                    {%- assign l_variant = selected_variant -%}
                                    {%- assign l_price = l_variant.price -%}
                                    {%- assign l_origin_price = l_variant.compare_at_price | default: l_price -%}
                                    {%- if settings.open_auto_discount_price and settings.display_auto_discount_price_in_sku -%}
                                      {%- assign l_auto_discount_price = l_variant.metafields.custom.auto_discount_price | times: 1 -%}
                                      {%- if l_auto_discount_price > 0 and l_auto_discount_price < l_variant.price -%}
                                        {%- assign l_price = l_auto_discount_price -%}
                                      {%- endif -%}
                                    {%- endif -%}
                                    {%- if l_origin_price < l_variant.price -%}
                                      {%- assign l_origin_price = l_variant.price -%}
                                    {%- endif -%}
                                    <span class="price font-semibold lg:text-xl text-base text-main-color">{{ l_price | money }}</span>
                                    {%- if l_origin_price > l_price -%}
                                      {% assign main_product_price = l_price %}
                                      {% assign main_product_origin_price = l_origin_price %}
                                      <span class="origin-price text-thin-color lg:text-base text-xs font-medium line-through">{{ l_origin_price | money }}</span>
                                    {%- endif -%}
                                  </div>
                              </div>
                          </div>
                          {%- endif -%}
                      </div>
                      <div 
                        class="diy-product-summary-footer pt-6"
                        data-currentVariant="{{ product.selected_or_first_available_variant.id }}"
                        data-addedon=""
                      >
                        {%-liquid
                          assign summary_f_price = main_product_price
                          assign summary_f_origin_price = main_product_origin_price

                          if summary_f_price == blank
                            assign summary_f_price = product.selected_or_first_available_variant.price
                          endif

                          if summary_f_origin_price == blank
                            assign summary_f_origin_price = product.selected_or_first_available_variant.compare_at_price
                          endif
                        -%}
                        <div class="flex lg:flex-col flex-row items-center justify-end lg:justify-start">
                          <div class="flex lg:gap-x-4 gap-x-3 lg:w-full justify-end items-center">
                            <div class="summary-footer__price-save text-main-bg font-medium text-xs text-white px-3 py-1 {% unless summary_f_origin_price > summary_f_price %}hidden{% endunless %}">
                              {%- assign amount_discount = summary_f_origin_price | minus: summary_f_price | divided_by: 100 | floor | times: 100 | money_without_trailing_zeros -%}
                              {{settings.discount_amount_format | replace: '()', amount_discount}}
                            </div>
                            <div class="summary-footer__price text-main-color font-semibold lg:text-3xl text-xl" data-mm="{{ summary_f_price }}">{{ summary_f_price | money }}</div>
                          </div>
                          <div class="summary-footer__origin-price flex lg:w-full justify-end origin-price text-thin-color lg:text-base text-xs font-medium line-through pl-1 lg:pl-0" data-mm="{{ summary_f_origin_price }}">{% if summary_f_origin_price > product.selected_or_first_available_variant.price %}{{ summary_f_origin_price | money }}{% endif %}</div>
                        </div>

                        <div class="diy-product-summary-footer__buy">
                          {%- for block in section.blocks -%}
                            {%- case block.type -%}
                                {% comment %} 加购、立即购买 {% endcomment %}
                                {%- when 'buy_buttons' -%}
                                  {%- render 'v5-app-pdp-buy-buttons', product: product, block: block, sectionId: section.id, is_diy: true -%}

                                {% comment %} 加购和购买前，免税弹窗提示 {% endcomment %}
                                {%- when 'tax_free_popup' -%}
                                  {% render 'tax-free-popup', block: block %}

                                {%- when 'klarna' -%}
                                  {% comment %} klarna 支付 {% endcomment %}
                                  <div class="product-info_block lg:py-4 py-2" {{ block.shopify_attributes }}>
                                    {% render 'app-klarna' %}
                                  </div>
                            {%- endcase -%}
                          {%- endfor -%}
                        </div>
                      </div>
                  </div>
              </div>

              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {% comment %} 产品对比 {% endcomment %}
                {%- when 'product-compare' -%}
                  <style>
                    .v5-product-info-wrapper .product-head-compare {
                      margin-bottom: 0;
                      padding: 0;
                    }
                    .v5-product-info-wrapper .product-head-compare .flex-between {
                      color: rgba(36, 47, 32, 0.9);
                      border-radius: 0;
                      background: #FFF;
                      font-size: 1rem;
                      line-height: 1.5rem;
                      font-weight: 500;
                      border: 1px solid rgba(0, 0, 0, 0.3);
                      padding: 0.75rem 1rem;
                      column-gap: 1rem;
                    }
                    .v5-product-info-wrapper .product-head-compare .flex-between svg {
                      width: 1rem;
                      height: 1rem;
                    }
                    @media screen and (max-width: 1023.98px) {
                      .v5-product-info-wrapper .product-head-compare .flex-between {
                        line-height: 1.2;
                        padding: 0.625rem 0.75rem;
                      }
                    }
                  </style>
                  {%- capture compare_style -%}
                    {% render 'spacing-padding', settings: block.settings %}
                  {%- endcapture -%}
                  {% assign current_variant_id = product.selected_or_first_available_variant.id %}
                  <div {{ block.shopify_attributes }} class="w-full section-padding" style="{{ compare_style }}">
                    {% render 'product-head-compare', id: block.id, compare_text: block.settings.compare_text, current_variant_id: current_variant_id, color: 'rgba(36, 47, 32, 0.9)' %}
                  </div>

                {%- when 'icon_text' -%}
                  {% comment %} 服务优势 {% endcomment %}
                  {%- if block.settings.position == 'pos_2' -%}
                      {%- render 'v5-app-pdp-icon-text', block: block, class: 'flex' -%}
                  {%- endif -%}

                  {% comment %} 权益文案 {% endcomment %}
                  {%- when 'benefit_text' -%}
                  {%- render 'v5-app-pdp-benefit-text', section: section, block: block -%}
                {%- endcase -%}
              {%- endfor -%}
            </div>
        </v5-diy-main>
    </div>
  </div>
</div>

