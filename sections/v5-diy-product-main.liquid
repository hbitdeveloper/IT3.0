<script type="module">
  {% comment %} 注册 Judge.me 插件的点击事件监听器 {% endcomment %}
  function registerJdgmPluginClickEvent() {
    const jdgmDOM = document.querySelector('.jdgm-prev-badge');
    {% comment %} 如果已经找到元素，并且它还没有注册过事件（通过检查自定义属性） {% endcomment %}
    if (jdgmDOM && !jdgmDOM.dataset.eventRegistered) {
      jdgmDOM.addEventListener('click', function() {
        {% comment %} 1. 查找导航容器 {% endcomment %}
        const navigationContainer = document.querySelector('jky-navigation')?.querySelector('.navigation--container')
        if (navigationContainer) {
          {% comment %} 2. 使用 querySelectorAll 获取所有动态导航块 {% endcomment %}
          const blocks = navigationContainer.querySelectorAll('.shopify-block')
          {% comment %} 3. 检查是否有块，并点击最后一个（通常是 REVIEWS 评论） {% endcomment %}
          if (blocks.length > 0) {
            const lastBlock = blocks[blocks.length - 1]
            {% comment %} 确保找到的块是可见的且可点击的，然后触发点击 {% endcomment %}
            if (lastBlock) {
              lastBlock.querySelector('.navigation-item').click()
            }
            {% comment %} 4. 数据埋码 (使用模板字符串优化可读性) {% endcomment %}
            gaPushDataLayer('5.0_products_details_page_user_clicks', {
              product_spu_name: '{{ product.title | escape }}',
              module: "Product Review", 
              button_name: jdgmDOM.querySelector('span.jdgm-prev-badge__text')?.textContent?.trim() || 'Click to Reviews',
            })
          }
        }
      })
      {% comment %} 标记该元素已注册事件，防止 MutationObserver 重复注册 {% endcomment %}
      jdgmDOM.dataset.eventRegistered = 'true'
    }
  }

  {% comment %} 使用 MutationObserver 确保在动态加载的内容中也能找到 .jdgm-prev-badge {% endcomment %}
  document.addEventListener('DOMContentLoaded', function() {
    const productInfoWrapper = document.querySelector('.v5-product-info-wrapper')
    {% comment %} 首次检查并注册 {% endcomment %}
    registerJdgmPluginClickEvent()

    if (productInfoWrapper) {
      const observer = new MutationObserver(function(mutations, obs) {
        {% comment %} 优化：只在 .jdgm-prev-badge 不存在且发生 DOM 变化时才尝试重新注册 {% endcomment %}
        if (!document.querySelector('.jdgm-prev-badge[data-event-registered="true"]')) {
          registerJdgmPluginClickEvent();
          {% comment %} 
            一旦找到并注册成功，可以断开观察，以节省资源。
            如果 jdgmDOM 在整个生命周期内可能被移除并重新添加，则不要断开。 
          {% endcomment %}
          if (document.querySelector('.jdgm-prev-badge[data-event-registered="true"]')) {
            obs.disconnect()
          }
        }
      })
      {% comment %} 观察 product info wrapper 内的子节点变化，确保捕捉到 Judge.me 插件的加载 {% endcomment %}
      observer.observe(productInfoWrapper, { 
        childList: true, 
        {% comment %} 插件通常在深层嵌套 {% endcomment %}
        subtree: true
      })
    }
  })
</script>

<script>
    if (!customElements.get('v5-diy-main')) {
        class V5DiyMain extends HTMLElement {
            constructor() {
                super();
            }
            connectedCallback() {
                this.diyRecommendInfo = this.querySelector(".diy-recommend-info");
                this.diyCustomInfo = this.querySelector(".diy-custom-info");

                this.summary__selectedVariants = this.querySelector(".diy-product-summary-lineItem__selectedVariants");

                this.container = this.querySelector('.diy-tabs-wrapper');
                this.slideline = this.querySelector('.tabSlide_line-wrapper');
                this.items = this.querySelectorAll('.diy-tabs-item');
                this.lineInner= this.querySelector('.tabSlide_line-line');

                this.active = this.items[0];

                this.handleTabClick = this.handleTabClick.bind(this);
                this.init();
            }
            disconnectedCallback() {}
            init() {
                this.updateUnderLine();
                this.items.forEach((item) => item.addEventListener('click', this.handleTabClick));

                this.initTabFromUrl();
                this.handleVariantChange();
                this.getBundleData();
                setTimeout(() => this.getVariants(), 500);
            }
            handleTabClick(e) {
                this.active = e.target;
                this.items.forEach((item) => item.classList.remove('active'));
                this.active.classList.add('active');
                this.updateUnderLine();
                this.handleTabChange(this.active);
                this.changeUrlParams('diy_tab', this.active.getAttribute('data-tab'));

                // 数据埋码
                gaPushDataLayer('user_interaction', {
                  module_name: 'Product Selection',
                  section_name: 'V5-DIY-PDP-橱窗产品信息',
                  section_title: '',
                  content_name: '',
                  button_name: e.target.textContent.trim(),
                  element_type: 'tab',
                  interaction_type: 'click',
                  interaction_effect: 'tab_switch',
                  to_url: '',
                  product_name: document.querySelector('.v5-product-info-wrapper')?.querySelector('h1')?.innerText?.replace(/\n/g, ' ') || '',
                });
            }
            updateUnderLine() {
                if (!this.lineInner || !this.items.length || !this.active) return;
                const activeRect = this.active.getBoundingClientRect();
                const containerRect = this.container.getBoundingClientRect();

                {% comment %} this.lineInner.style.width = `${(activeRect.width - 8) / 16}rem`; {% endcomment %}
                this.lineInner.style.width = `${activeRect.width - 8}px`;
                this.lineInner.style.left = `${activeRect.left - containerRect.left}px`;
            }
            handleTabChange(tab) {
              if (tab.getAttribute('data-tab') === 'diy-recommend-info') {
                  this.diyRecommendInfo.style.display = 'block';
                  this.diyCustomInfo.style.display = 'none';
              } else {
                  this.diyRecommendInfo.style.display = 'none';
                  this.diyCustomInfo.style.display = 'block';
              }
            }
            changeUrlParams(key, value) {
                const url = new URL(window.location);
                url.searchParams.set(key, value);
                window.history.replaceState({}, '', url);
            }
            getUrlParams(key) {
                const urlParams = new URLSearchParams(window.location.search);
                return urlParams.get(key);
            }
            {% comment %} 初始化当前Tab {% endcomment %}
            initTabFromUrl() {
                const urlTab = this.getUrlParams('diy_tab');
                if (urlTab) {
                    const targetTab = Array.from(this.items).find(item => item.getAttribute('data-tab') === urlTab);
                    if (targetTab) {
                        targetTab.click();
                    }
                } else {
                  try {
                    this.items[0].click()
                  } catch (error) {
                    console.log('diy init error:', error);
                  }
                }
            }
            handleVariantChange() {
              document.addEventListener('diyVariantChangeEvent', (e) => {
                {% comment %} 更新选中变体信息 {% endcomment %}
                const variant = e.detail.variant;
                const html = e.detail.html;
                const selectedVariantDOM = html.querySelector('.diy-product-summary-lineItem__selectedVariants');

                selectedVariantDOM && (this.summary__selectedVariants.innerHTML = selectedVariantDOM.innerHTML);

                this.handleChangeGallary(variant, html);
              });
            }
            {% comment %} 获取配件列表 {% endcomment %}
            getBundleData() {
              document.addEventListener('bundleLoadedEvent', (e) => {
                const bundleData = e.detail.list;
                this.bundleData = bundleData || [];
              });
            }
            {% comment %} 获取当前产品所有变体数据 {% endcomment %}
            getVariants() {
              try {
                this.variants = document.querySelector("variant-fields").getVariantData() || [];
              } catch (error) {
                setTimeout(() => {
                  this.variants = document.querySelector("variant-fields")?.getVariantData() || []
                }, 1500);
              }
            }

            {% comment %} DIY 切割多变体图片 - 只处理显示当前多变体主图 {% endcomment %}
            handleChangeGallary(variant, html) {
              const gallery = document.querySelector('v5-product-gallery');
              const mainGalleryVarriant = gallery?.querySelector('.product_gallery-imagebox .swiper-slide');
              const mainGalleryVarriantThumb = gallery?.querySelector('.product-image-thumbs .swiper-slide');
              const nextMainGalleryVarriant = html.querySelector('v5-product-gallery .product_gallery-imagebox .swiper-slide');
              const nextMainGalleryVarriantThumb = html.querySelector('v5-product-gallery .product-image-thumbs .swiper-slide');
              const nextDiyTagWrapper = html.querySelector('.diy-tag-wrapper');

              const syncGalleryNode = (target, source) => {
                if (!target || !source) return false;

                const sourceAttrs = new Map(Array.from(source.attributes, (attr) => [attr.name, attr.value]));
                Array.from(target.attributes).forEach((attr) => {
                  if (!sourceAttrs.has(attr.name)) {
                    target.removeAttribute(attr.name);
                  }
                });
                sourceAttrs.forEach((value, name) => target.setAttribute(name, value));
                target.innerHTML = source.innerHTML;

                return true;
              };

              if (syncGalleryNode(mainGalleryVarriant, nextMainGalleryVarriant)) {
                syncGalleryNode(mainGalleryVarriantThumb, nextMainGalleryVarriantThumb);

                if (gallery) {
                  const currentVariantMediaId = nextMainGalleryVarriant.getAttribute('media-id');
                  if (currentVariantMediaId) {
                    gallery.currentVariantMediaId = currentVariantMediaId;
                    gallery.dataset.currentVariantMediaId = currentVariantMediaId;
                  }

                  gallery.product_gallery?.update();
                  gallery.gallery_thumb?.update();
                  gallery.updateLcpPriority?.();
                  setTimeout(() => gallery.product_gallery?.slideTo(0, 300), 200);
                }
              }

              const diyTagWrapper = document.querySelector('.diy-tag-wrapper');
              if (diyTagWrapper && nextDiyTagWrapper) {
                diyTagWrapper.innerHTML = nextDiyTagWrapper.innerHTML;
              }
            }
        }
        customElements.define('v5-diy-main', V5DiyMain);
    }
</script>

