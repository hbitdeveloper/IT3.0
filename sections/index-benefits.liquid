{{ 'section-index-benefits.css' | asset_url | stylesheet_tag }}
<div class="index-benefits jp-offer" anchor="{{ section.settings.anchor | escape }}">
    <div class="new-main-container">
        <div class="benefits">
            <div class="module-title">
                <div class="title {{ section.settings.title_align }}"> <span class="jky-slideup">{{ section.settings.module_title | escape}}</span></div>
                {%- if section.settings.button_text != blank -%}
                    <a
                        data-ga-event="home_page_exclusive_advantage4.0"
                        data-ga-action="click"
                        data-ga-params-module="{{ section.settings.module_title | escape }}"
                        data-ga-params-link="{{ section.settings.url }}"
                        data-ga-params-button_name="{{ section.settings.button_text | escape}}"
                        data-ga-params-type="Exclusive advantage"
                        class="pc-block" target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ section.settings.url }}">
                        <button class="index-button">
                            <span>{{ section.settings.button_text | escape}}</span>
                            <div>
                                <div class="arrow">
                                    <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                            <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                                <g transform="translate(672.000000, 286.000000)">
                                                    <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                                </g>
                                            </g>
                                        </g>
                                    </svg>
                                </div>
                            </div>
                        </button>
                    </a>
                {%- endif -%}
            </div>
            <div class="box">
                {%- for item in section.blocks -%}
                    <div class="box-item" {{ block.shopify_attributes }}>
                        <div class="box-content">
                            {%- render 'responsive-image' image: item.settings.icon, width: 80, mwidth: 50 -%}
                            <div class="title line-clamp-2">{{ item.settings.title }}</div>
                            <div class="sub-title line-clamp-2">{{ item.settings.sub_title }}</div>
                        </div>
                    </div>
                {%- endfor -%}
            </div>
            {%- if section.settings.button_text != blank -%}
                <div class="view-more">
                    <a
                        data-ga-event="home_page_exclusive_advantage4.0"
                        data-ga-action="click"
                        data-ga-params-module="{{ section.settings.module_title | escape }}"
                        data-ga-params-link="{{ section.settings.url }}"
                        data-ga-params-button_name="{{ section.settings.button_text }}"
                        data-ga-params-type="Exclusive advantage"
                        class="mobile-block flex-1"  target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ section.settings.url }}">
                        <button class="index-button">
                            <span>{{ section.settings.button_text | escape}}</span>
                        </button>
                    </a>
                </div>
            {%- endif -%}
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "独家优势",
        "enabled_on": {
            "templates": ["index", "product", "page"]
        },
        "settings": [
            { "type": "text", "id": "anchor", "label": "二级标题定位锚点", "info": "搭配二级导航锚点定位未使用到定位则不配置" },
            { "type": "text", "id": "module_title", "label": "模块标题(必填)" },
            { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false },
            { "type": "text", "id": "button_text", "label": "按钮文案" },
            { "type": "url", "id": "url", "label": "跳转地址" },
            {"type": "select","id": "title_align", "label": "模块标题对齐方式","default": "left",
                "options": [
                    { "value": "left", "label": "居左" },
                    { "value": "center", "label": "居中" }
                ]
            }
        ],
        "blocks": [
            {
                "type": "block",
                "name": "独家优势",
                "settings": [
                    { "type": "image_picker", "id": "icon", "label": "图标", "info": "图片100*100" },
                    {"type": "text", "id": "title", "label": "标题(不超过20字符)" },
                    {"type": "textarea", "id": "sub_title", "label": "描述(不超过50字符)" }
                ]
            },

        ],
        "presets": [
            {
                "name": "首页-独家优势",
                "settings": {
                    "module_title": "Why Buy Jackery Direct?",
                    "new_window": false,
                    "button_text": "View More"
                },
                "blocks": [
                    {
                        "type": "block"
                    }
                ]
            }
        ]
    }
{% endschema %}

