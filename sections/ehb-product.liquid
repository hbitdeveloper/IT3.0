
<link
  rel="stylesheet"
  href="{{ 'sections-ehb-product.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

<noscript>
  {{ 'sections-ehb-product.css' | asset_url | stylesheet_tag }}
</noscript>

<style>
    #shopify-section-{{section.id}} {
        background: {{section.settings.bg_color | default: 'transparent' }};
    }
</style>
<div
    class="{{section.settings.page_width}} pt-3 pb-6 lg:pt-4 lg:pb-9"
    {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
>
    {% render 'indoor-product',
        product: section.settings,
        index: 1,
        new_window: section.settings.new_window
    %}
</div>

{% schema %}
{
    "name": "EHB产品",
    "tag": "section",
    "class": "ehb-products",
    "enabled_on": {
      "templates": ["page"]
    },
    "settings": [
        { "type": "header", "content": "组件交互配置" },
        { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": false },
        { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },

        { "type": "header", "content": "组件样式配置" },
        {
            "type": "select",
            "id": "page_width",
            "options": [
                {
                "value": "section-container",
                "label": "版心/1200px"
                },
                {
                "value": "section-container-lg",
                "label": "大版心/1312px"
                },
                {
                "value": "w-full",
                "label": "铺满/100%"
