            "label": "PC的组件宽度",
            "info": "MB端组件宽度固定和设计稿一致，不可修改"
        },
        {
            "type": "color_background",
            "id": "bg_color",
            "label": "背景颜色",
            "default": "rgba(217, 217, 217, 0.3)"
        },
        {
          "type": "select",
          "id": "position",
          "label": "PC样式选择",
          "default": "columns-3",
          "visible_if": "{{ section.settings.page_width == 'custom' }}",
          "options": [
            {
              "value": "columns-3",
              "label": "1行3个"
            },
            {
