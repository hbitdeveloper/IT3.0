<script type="module">
  document.addEventListener('DOMContentLoaded', function() {
    // 初始化产品轮播
    const productCarousels = document.querySelectorAll('.product-carousel-swiper');

    productCarousels.forEach((carousel, index) => {
      const anchor = carousel.closest('.product-carousel-container').dataset.anchor;
      const uniqueId = `product-carousel-${anchor}-${index}`;

      // 为每个轮播添加唯一ID
      carousel.setAttribute('id', uniqueId);

      // 计算初始化索引：如果有2个及以上，则默认展示第二个
      const slides = carousel.querySelectorAll('.swiper-slide');
      const defaultIndexAttr = carousel.getAttribute('data-default-index');
      const parsedDefault = defaultIndexAttr ? parseInt(defaultIndexAttr, 10) : 0;
      const initialIndex = Math.min(slides.length - 1, Math.max(0, isNaN(parsedDefault) ? 0 : parsedDefault));

      // 初始化Swiper
      const swiper = new Swiper(`#${uniqueId}`, {
        slidesPerView: 1,
        loopAdditionalSlides: 2,
        loop: true,
        autoplay: false,
        centeredSlides: true,
        initialSlide: initialIndex,
        navigation: {
          nextEl: `#${uniqueId} .icon-arrow-right`,
          prevEl: `#${uniqueId} .icon-arrow-left`,
        },
        // pagination: {
        //   el: `#${uniqueId} .swiper-pagination`,
        //   clickable: true,
        //   bulletClass: 'swiper-pagination-bullet',
        //   bulletActiveClass: 'swiper-pagination-bullet-active',
        // },
      });

      // 存储swiper实例以便后续销毁
      carousel.swiperInstance = swiper;
    });
  });

  // 页面卸载时销毁所有swiper实例
  window.addEventListener('beforeunload', function() {
    const productCarousels = document.querySelectorAll('.product-carousel-swiper');
    productCarousels.forEach(carousel => {
      if (carousel.swiperInstance) {
        carousel.swiperInstance.destroy(true, true);
      }
    });
  });
</script>

<style>
  .product-carousel-container {
    position: relative;
    width: 100%;
  }

  .product-carousel-swiper {
    width: 100%;
    position: relative;
  }

  .product-carousel-swiper .swiper-slide {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .product-carousel-swiper .swiper-button-right,
  .product-carousel-swiper .swiper-button-left {
    color: #1A1A1A;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    margin-top: -20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .product-carousel-swiper .swiper-button-rgiht:after,
  .product-carousel-swiper .swiper-button-left:after {
    font-size: 16px;
    font-weight: bold;
  }

  .product-carousel-swiper .swiper-pagination {
    position: relative;
    margin-top: 1rem;
  }

  .product-carousel-swiper .swiper-pagination-bullet {
    background: #ccc;
    opacity: 1;
    margin: 0 4px;
  }

  .product-carousel-swiper .swiper-pagination-bullet-active {
    background: var(--jds-color-primary);
  }

  @media screen and (max-width: 768px) {
    .product-carousel-swiper .swiper-button-right,
    .product-carousel-swiper .swiper-button-left {
      width: 32px;
      height: 32px;
      margin-top: -16px;
    }

    .product-carousel-swiper .swiper-button-rgiht:after,
    .product-carousel-swiper .swiper-button-left:after {
      font-size: 14px;
    }
  }
</style>
