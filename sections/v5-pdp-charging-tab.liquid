<style>
        @media screen and (min-width: 1024px) {
            .v5-pdp-charging-tab .v-image-child-container {
                display: flex;
                justify-content: flex-end;
                max-width: 75rem;
            }

            .v5-pdp-charging-tab .v-image-child-container .blocks-heading-content {
                width: auto;
                max-width: 37.5rem;
            }
            .v5-pdp-charging-tab .v-image-child-container > div:not(:last-child) {
                border-right: 1px solid var(--border-color);
                padding-right: 1.5rem;
            }
            .v5-pdp-charging-tab .v-image-child-container > div:not(:first-child) {
                padding-left: 1.5rem;
            }
        }
        @media screen and (max-width: 1023.98px) {
            .v5-pdp-charging-tab .tabs-content-container {
                overflow: visible;
            }
            .v5-pdp-charging-tab .v-image-child-container {
                width: 100%;
            }
            .v5-pdp-charging-tab .v-image-child-container .blocks-text p {
                color: #242f20 !important;
            }
            .v5-pdp-charging-tab .v-image-child-container > div {
                padding-top: 1.5rem;
                padding-bottom: 1.5rem;
            }
            .v5-pdp-charging-tab .v-image-child-container > div:not(:last-child) {
                border-bottom: 1px solid #C6C7C8;
            }
        }
</style>

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
  class="blocks-tabs-blocks{% if section.settings.type == 'embed' %} embed-component{% endif %}"
  style="background: {{section.settings.bg_color | default: 'transparent' }};"
  {% if section.settings.type == 'embed' and section.settings.anchor != blank %}
    data-anchor="{{section.settings.anchor}}" anchor="{{section.settings.anchor}}"
  {% endif %}
  {% if section.settings.type == 'embed' and section.settings.handle != blank %}
    data-handle="{{ section.settings.handle }}"
  {% endif %}
>
  <div class="section-padding {{section.settings.page_width}}" style="{{ style }}">
    {% content_for 'blocks' %}
  </div>
</div>

<script type="module">

    function applyOne(item) {

        const sub = item.querySelector('.blocks-content-subheading');
        if (sub) {
            item.style.setProperty('--border-color', getComputedStyle(sub).color);
        }

        const parent = item.parentElement;
        if (!parent) return;

        const updatePadding = () => {
            if (Jackery.Utils.isLessThan1024Screen()) {
                const h = item.getBoundingClientRect().height;
                parent.style.paddingBottom = `${h}px`;
            }
        };

        // run now (next paint) and also after fonts are ready
        requestAnimationFrame(updatePadding);
        if (document.fonts?.ready) document.fonts.ready.then(() => requestAnimationFrame(updatePadding));

        // keep it correct if height changes later (lazy images / sliders / tab switches)
        const ro = new ResizeObserver(() => updatePadding());
        ro.observe(item);
    }

    function init() {
        document.querySelectorAll(".v5-pdp-charging-tab .v-image-child-container").forEach(applyOne);
    }

    document.addEventListener('DOMContentLoaded', init);

</script>

