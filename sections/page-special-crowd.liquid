    <style>
        .special-crowd-learn-more {
            margin-top: 6.25vw;
        }
        .collection-product {
            padding: 0 0 86px 0;
        }
        .collection-product-title {
            margin-bottom: 80px;
        }
        .collection-product-item {
            width: 390px;
            height: 467px;
        }
        .collection-product-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .collection-product-item-content {
            padding: 56px 52px;
        }
        .collection-product-item-subtitle {
            margin: 12px auto 20px;
        }
        .collection-product-item-content .a-button-fill {
            line-height: unset!important;
            padding: 8px 32px;
        }
        .collection-product-item .collection-product-item-pimg {
            z-index: 2;
            height: 180px;
            width: auto;
            left: 20px;
            bottom: 0;
            transform: translateY(50%);
        }

        .product-recommend {
            margin-top: 80px;
            margin-bottom: 6.25vw;
            background-color: #DDD5C5;
        }
        .product-recommend-b {
            flex: 1;
        }
        .product-recommend-box {
            max-width: 500px;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        .product-recommend-b img {
            width: 100%;
            object-fit: cover;
        }
        .product-recommend-b:nth-child(2) {
            padding-left: 4.47917vw;
        }
        .product-recommend-title {
            margin-bottom: 40px;
        }

        @media screen and (max-width: 768px) {
            .special-crowd-learn-more {
                margin-bottom: -8vw;
            }
            .collection-product-item img {
                width: 100%;
                height: 112vw;
                object-fit: cover;
            }
            .collection-product {
                padding: 14vw 0 32.2vw;
                padding-bottom: 0;
            }
            .collection-product-title {
                margin-bottom: 5vw;
            }
            .collection-product-item-subtitle {
                margin: 1.6vw auto 6vw;
            }
            .collection-product-item .collection-product-item-pimg {
                height: 38vw;
            }
            .collection-product-item-content {
                padding: 13.3vw 12vw;
            }
            .collection-product-list {
                flex-direction: column;
            }
            .collection-product-item {
                width: 100%;
                height: 112vw;
                margin-bottom: 33vw;
            }

            .product-recommend {
                margin-top: 0;
                margin-bottom: 0;
                flex-direction: column;
                position: relative;
            }
            .product-recommend-box {
                width: 100%;
            }
            .product-recommend-title {
                margin-bottom: 6.5vw;
                color: #fff;
                text-align: center;
            }
            .product-recommend-b:nth-child(2) {
                position: absolute;
                padding: 15.3vw 18vw 0 18vw;
                display: flex;
                align-items: center;
                width: 100%;
            }
            .faq-container .faq-content{
                z-index: unset;
            }
        }
    </style>

    <div class="image-banner-container">
        <div class="section-container">
            <h2 class="image-banner-container-title jky-text-xl text-center">{{section.settings.page_title | newline_to_br}}</h2>

            <div class="image-banner-brand-content relative">
                <img class="absolute left-0 top-0"
                    src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016"
                    alt="jackery" loading="lazy">

                <img class="absolute bottom-0 right-0"
                    src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016"
                    alt="jackery" loading="lazy">

                <span class="jky-text-sm">{{section.settings.page_sub_title | newline_to_br}}</span>
            </div>
        </div>
    </div>


    <div class="how-it-work section-container">
        <h2 class="jky-text-2xl text-center font-bold">{{section.settings.step_title | escape}}</h2>
        <ul class="flex justify-between">
            {% for block in section.blocks %}
                {% case block.type %}
                {% when 'introduce_step' %}
                <li class="flex flex-col items-center">
                    <div class="relative how-item-img">
                        <img src="{{block.settings.introduce_icon | image_url: width: 146}}"  alt="{{block.settings.introduce_icon.alt | escape}}" loading="lazy">
                    </div>
                    <h3 class="how-item-name jky-text-lg">{{block.settings.title | escape}}</h3>
                    <div class="how-item-content text-center jky-text-sm">{{block.settings.step_info | newline_to_br}}</div>
                </li>
                {% endcase %}
            {% endfor %}
        </ul>
    </div>

    <div class="verify-status section-container overflow-x-hidden">
        <h2 class="jky-text-2xl text-center font-bold">{{section.settings.status_title | escape}}</h2>

        <div class="swiper verify-menu swiper-thumbs">
            <div class="swiper-wrapper justify-between">
                {% for block in section.blocks %}
                    {% case block.type %}
                    {% when 'verify_status' %}
                    <div class="swiper-slide">
                        <div class="verify-menu-name jky-text-lg">{{block.settings.title | escape}}</div>
                    </div>
                    {% endcase %}
                {% endfor %}
            </div>
        </div>

        <div class="swiper verify-main">
            <div class="swiper-wrapper">
                {% for block in section.blocks %}
                    {% case block.type %}
                    {% when 'verify_status' %}
                    <div class="swiper-slide">
                        <div class="verify-item-content flex flex-col items-center overflow-hidden">
                            <div class="banner focus-zoom-container overflow-hidden">
                                {% render 'responsive-image', image: block.settings.image, mimage: block.settings.m_image, image_class: 'focus-zoom' %}
                            </div>
                            <div class="jky-text-xl">{{block.settings.title}}</div>
                            <a class="z-button-fill-middle" href="{{block.settings.status_url}}">
                                {{section.settings.status_btn}}
                                <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
                            </a>
                        </div>
                    </div>
                    {% endcase %}
                {% endfor %}
            </div>
        </div>
    </div>


    {% assign collectionItems = section.blocks | where: 'type', "collection_item" %}

    {% if section.settings.collection_title != blank or collectionItems.size > 0 %}
        <div class="collection-product section-container special-crowd-learn-more">
            {% if section.settings.collection_title != blank %}
                <h2 class="collection-product-title font-bold text-center jky-text-2xl">{{section.settings.collection_title | newline_to_br}}</h2>
            {% endif %}
            <div class="collection-product-list flex justify-between">
                {% for block in collectionItems %}
                    <div class="collection-product-item relative focus-zoom-container">
                        <div class="collection-product-item-content absolute top-0 bottom-0 left-0 right-0 overflow-hidden flex items-center flex-col text-center">
                            <div class="flex items-center flex-col text-center relative" style="z-index: 3;">
                                <div class="collection-product-item-title jky-text-sm font-bold">{{block.settings.title}}</div>
                                <div class="collection-product-item-subtitle jky-text-xs">{{block.settings.subtitle | newline_to_br}}</div>
                                <a class="z-button-fill-middle" href="{{block.settings.collection_link}}">{{section.settings.collection_btn}} <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon></a>
                            </div>
                            <img class="focus-zoom absolute top-0 left-0 right-0 bottom-0" src="{{block.settings.image | image_url: width: 750}}" alt="block.settings.image.alt" loading="lazy">
                        </div>

                        <img class="absolute collection-product-item-pimg" src="{{block.settings.p_image | image_url: width: 318}}" alt="{{block.settings.p_image.alt}}" loading="lazy">
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="benefits relative">
        <img class="pc-block" src="{{section.settings.join_image | image_url: width: 1920}}" alt="{{section.settings.join_image.alt}}" loading="lazy">
        <img class="mobile-block" src="{{section.settings.join_m_image | image_url: width: 750}}" alt="{{section.settings.join_m_image.alt}}" loading="lazy">
        <div class="benefits-content absolute flex flex-col top-0 bottom-0 justify-center items-center">
            <h2 class="benefits-title section-container text-center font-bold jky-text-2xl">{{section.settings.join_title | escape}}</h2>
            <h3 class="benefits-subtitle jky-text-sm text-center">{{section.settings.join_sub_title | newline_to_br}}</h3>
            <a class="z-button-big" href="{{section.settings.join_link}}">
                {{section.settings.join_txt | escape}}
                <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
            </a>
        </div>
    </div>

    <div class="card-swiper page-section-swiper relative">
        <div class="jky-text-2xl section-container text-center font-bold">{{section.settings.product_title | escape}}</div>
        <div class="card-swiper-container relative swiper">
            <div class="swiper-wrapper">
                {% for collection in section.settings.collection_list %}
                    <div class="swiper-slide">
                        <div class="flex flex-col justify-center items-center">
                            <div class="m-reverse text-center">
                                <div class="m-reverse-v text-center">
                                    <div class="product-item-title jky-text-xl text-center text-overflow-2">{{collection.title}}</div>
                                </div>
                                <img class="product-img" src="{{collection.featured_image | image_url: width: 234}}" alt="{{collection.title}}" loading="lazy">
                            </div>
                            <a class="z-button-fill-middle" href="{% if collection.metafields.custom.landing_page_url != blank %}{{collection.metafields.custom.landing_page_url}}{%else%}{{collection.url}}{%endif%}">
                                {{section.settings.product_btn | escape}}
                                <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-base"></jds-icon>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="index-container absolute slideshow-navigation">
                <div class="slideshow-navigation-button prev">
                    {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
                </div>
                <div class="slideshow-navigation-button next">
                    {% render 'icon-arrow-right-long', class: 'iconfont icon-arrow-right-long' %}
                </div>
            </div>
        </div>
        <div class="slideshow-pagination page-section-swiper"></div>
    </div>


    <div class="faq-container flex">
        <div class="faq-banner">
            <img src="{{section.settings.faq_img | image_url: width: 960}}" alt="{{section.settings.faq_img.alt}}" loading="lazy">
        </div>

        <div class="faq-content flex flex-col">
            <h2 class="faq-content-title jky-text-2xl font-bold">FAQ</h2>
            {% render 'accordion-menu', blocks: section.blocks %}
        </div>
    </div>

    {% schema %}
    {
        "name": "Page specialCrowd main",
        "class": "section section-specialCrowd-main",
        "settings": [
            {"type": "textarea", "id": "page_title", "label": "Page title", "default": "In honor of your contribution, We Offer you special savings for Jackery products."},
            {"type": "textarea", "id": "page_sub_title", "label": "Page subtitle"},
            {"type": "text", "id": "step_title", "label": "Introduce Title", "default": "HOW IT WORKS"},
            {"type": "text", "id": "status_title", "label": "Status swiper Title", "default": "VERIFY YOUR STATUS"},
            {"type": "text", "id": "status_btn", "label": "Status button text", "default": "VERIFY"},
            {"type": "text", "id": "collection_title", "label": "Collection title", "default": "Learn more about Jackery's products"},
            {"type": "text", "id": "collection_btn", "label": "collection button text", "default": "LEARN MORE"},
            {"type": "text", "id": "join_title", "label": "Join Title", "default": "JOIN OUR MENBER CLUB FOR MORE BENEFITS"},
            {"type": "textarea", "id": "join_sub_title", "label": "Join subtitle"},
            {"type": "url", "id": "join_link", "label": "Join Link"},
            {"type": "text", "id": "join_txt", "label": "Join Button Text", "default": "REGISTER NOW"},
            {"type": "image_picker", "id": "join_image", "label": "PC JOIN Image"},
            {"type": "image_picker", "id": "join_m_image", "label": "Mobile JOIN Image"},
            {"type": "text", "id": "product_title", "label": "Jackery Product Title", "default": "GET MORE OOU OF JACKERY"},
            {
                "type": "collection_list",
                "id": "collection_list",
                "label": "Collections",
                "limit": 6
            },
            {"type": "text", "id": "product_btn", "label": "Jackery Product Button text", "default": "LEARN MORE"},
            {"type": "image_picker", "id": "faq_img", "label": "FAQ Image"}
        ],
        "blocks": [
            {
                "type": "introduce_step", "name": "Introduce Step",
                "settings": [
                    {"type": "text", "id": "title", "label": "Step title"},
                    {"type": "textarea", "id": "step_info", "label": "Step description"},
                    {"type": "image_picker", "id": "introduce_icon", "label": "Step Icon"}
                ]
            },
            {
                "type": "verify_status", "name": "Status",
                "settings": [
                    {"type": "text", "id": "title", "label": "Status name"},
                    {"type": "url", "id": "status_url", "label": "Status Link"},
                    {"type": "image_picker", "id": "image", "label": "PC Status Image"},
                    {"type": "image_picker", "id": "m_image", "label": "Mobile Status Image"}
                ]
            },
            {
                "type": "collection_item", "name": "collection item",
                "settings": [
                    {"type": "text", "id": "title", "label": "collection name"},
                    {"type": "textarea", "id": "subtitle", "label": "collection Heading"},
                    {"type": "url", "id": "collection_link", "label": "collection link"},
                    {"type": "image_picker", "id": "image", "label": "collection Image"},
                    {"type": "image_picker", "id": "p_image", "label": "collection product Image"}
                ]
            },
            {
                "type": "faq_item", "name": "FAQ Item",
                "settings": [
                    {"type": "text", "id": "title", "label": "FAQ name"},
                    {"type": "textarea", "id": "faq_content", "label": "FAQ answer"}
                ]
            }
        ]
    }
    {% endschema %}