<style>
.swiper-wrapper.disabled {
    transform: translate3d(0px, 0, 0) !important;
}
</style>

{% comment %} How it work {% endcomment %}
{% assign size = section.blocks.size %}
<div id="how-it-works" class="how-it-work image-text-swiper relative swiper">
<div class="swiper-wrapper {% if size == 1 %} disabled {% endif %}">
        {% for block in section.blocks %}
            
            <div class="how-work-container swiper-slide relative">
                {%- 
                    render 'responsive-image', 
                    image: block.settings.banner_img, 
                    mimage: block.settings.m_banner_img,
                    image_class: "how-work-banner"
                -%}
        
        
                <div class="section-container absolute">
                    <h2 class="image-banner-container-title text-left lg:text-center text-45 leading-66 lg:j-text-40 lg:j-leading-48 font-600 gs_reveal">{{block.settings.title | newline_to_br}}</h2>
                    <div class="text-28 leading-36 lg:j-text-24 lg:j-leading-36 text-left lg:text-center font-300 gs_reveal collection-imagetext-subtitle">{{block.settings.subtitle | newline_to_br}}</div>
        
                    <img class="absolute left-60 lg:left-0 top-0 left-top"
                        src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016"
                        alt="jackery" loading="lazy" width="49" height="77">
        
                    <img class="absolute bottom-0 right-60 lg:j-right-0 right-bottom"
                        src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016"
                        alt="jackery" loading="lazy" width="65" height="68">
                </div>
            </div>
        {% endfor %}
    </div>
    {% if size > 1 %}
        <div class="slideshow-pagination flex"></div>
    {% endif %}
</div>

{% schema %}
{
  "name": "How It Works",
  "class": "section section-how-it-works section-sp-pps-sg-collection",
  "settings": [],
  "max_blocks": 3,
  "blocks": [
      {
        "type": "how-it-work",
        "name": "How It Works",
        "settings": [
            {"type": "textarea", "id": "title", "label": "Slide title"},
            {"type": "textarea", "id": "subtitle", "label": "Slide description"},
            {"type": "image_picker", "id": "banner_img", "label": "PC banner image"},
            {"type": "image_picker", "id": "m_banner_img", "label": "Mobile banner image"}
        ]
      }
    ]
}
{% endschema %}