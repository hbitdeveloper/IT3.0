      padding-bottom: 4vw;
    }
  }
  .produc-detail--contetn_item .diy-matrix.section-matrix-graph:first-of-type {
    padding-top: 14.4vw;
  }
  @media screen and (min-width: 1024px) {
    .produc-detail--contetn_item .diy-matrix.section-matrix-graph:first-of-type {
      padding-top: 4.44444444444444vw;
