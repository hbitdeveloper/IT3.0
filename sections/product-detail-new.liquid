                  <div class="faq-content rte">{{ item.answer | escape }}</div>
                </li>
              {%- endfor -%}
            </ul>

            {% if section.settings.is_unfold == false %}
              {%- if faq_num_new > 3 -%}
                <div class="z-button-fill-middle faq--more gap-2" style="display:flex;">
                  <span>{{ 'general.action_text.view_more' | t }}</span>
                  <jds-icon name="arrow-down" class="iconfont icon-arrow-down"></jds-icon>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        </product-faq>
      {%- endif -%}
    {%- endif -%}

    {% comment %} Reviews {% endcomment %}
    {%- if blocks_reviews_size > 0 -%}
      {%- assign blockReviews = blocks_reviews | first -%}

      <div class="produc-detail--contetn_item produc-detail--contetn_item__app">
        <div
          class="section-container product-block-section"
          {% if blockreviews.settings.block_bg != blank and blockreviews.settings.block_bg != 'rgba(0,0,0,0)' %}
            data-invert="true"
          {% endif %}
        >
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script type="module">
  /* 图文轮播版块 */
  if (window.innerWidth < 1024 && document.querySelector('.media_highlight_text_swiper')) {
    new Swiper('.media_highlight_text_swiper .swiper', {
      pagination: {
        el: '.media_highlight_text_swiper .swiper-pagination',
        type: 'progressbar',
      },
      slidesPerView: 'auto',
    });
  }
  /* 图文轮播版块 */
  if (document.querySelector('.media_highlight_animate')) {
    class ProdcutDetailVideo {
      constructor({ el }) {
        this.DOM = document.querySelector(el);
        this.el = el;

        // 当前播放视频的索引
        this.curIndex = 0;

        if (this.DOM) {
          this.jkyVideos = this.DOM.querySelectorAll('jky-video');

          // 是否都配置的 mp4 格式的视频
          const mp4Video = Array.from(this.jkyVideos).filter((item) => item.getAttribute('video-type') === 'mp4');
          this.isAllMp4 = mp4Video.length === this.jkyVideos.length;

          // 修正 this 指向，方便新增和移除事件
          this.videoEndedPlayEvent = this.videoEndedPlayEvent.bind(this);

          this.init();
          this.observe();
        }
      }
      init() {
        this.jkyVideos.forEach((item, index) => {
          const posterWrap = item.querySelector('.jky-video-poster_container');
          posterWrap.onclick = () => {
            this.curIndex = index;

            // 暂停全部
            this.jkyVideos.forEach((it) => {
              if (it && it.pause) {
                it.videoInfo.autoplay = false;
                it.pause();
              }
            });

            // 播放当前
            this.playVideo(item);
          };
        });
      }
      playVideo(curVideo) {
        if (curVideo && curVideo.loadContent) {
          curVideo.videoInfo.autoplay = true;
          curVideo.loadContent(false);

          if (this.isAllMp4) {
            // 监听视频播放完成事件
            curVideo.querySelector('video').addEventListener('ended', this.videoEndedPlayEvent);
          }
        }
      }
      // 视频播放完成事件
      videoEndedPlayEvent() {
        this.curIndex++;
        this.playVideo(this.jkyVideos[this.curIndex]);
      }
      observe() {
        // 视频进入视口监听播放
        const Observer = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                if (this.curIndex !== this.jkyVideos.length - 1) {
                  // 播放视频
                  const curVideo = this.jkyVideos[this.curIndex];
                  this.playVideo(curVideo);
                }
              } else {
                // 暂停播放
                const curVideo = this.jkyVideos[this.curIndex];
                if (curVideo && curVideo.pause) {
                  curVideo.videoInfo.autoplay = false;
                  curVideo.pause();

                  if (this.isAllMp4) {
                    // 移除当前视频播放完成事件
                    curVideo.querySelector('video')?.removeEventListener('ended', this.videoEndedPlayEvent);
                  }
                }
              }
            });
          },
          {
            root: null,
            rootMargin: '0px',
            threshold: 0.25, // 设置阈值为80%，即视频可见面积超过50%触发播放
          }
        );

        Observer.observe(this.DOM);
      }
    }
  }
  const parseBoolean = (value) => {
    if (value === true) return true;
    if (value === false) return false;
    if (value == null) return false;
    const str = String(value).trim().toLowerCase();
    return str === '' || str === 'true' || str === '1' || str === 'yes';
  };

  const getSlideDisplayValue = (el) => {
    const cached = el.dataset.slideDisplay;
    if (cached) return cached;
    const computed = window.getComputedStyle(el).display;
    if (computed && computed !== 'none') {
      el.dataset.slideDisplay = computed;
      return computed;
    }
    return 'block';
  };

  const slideUp = (el, duration = 400) => {
    if (!el) return;
    if (duration === 0) {
      el.style.display = 'none';
      return;
    }

    el.dataset.slideDisplay =
      window.getComputedStyle(el).display !== 'none' ? window.getComputedStyle(el).display : getSlideDisplayValue(el);
    el.style.boxSizing = 'border-box';
    el.style.height = `${el.offsetHeight}px`;
    el.style.overflow = 'hidden';
    el.style.transitionProperty = 'height, margin, padding';
    el.style.transitionDuration = `${duration}ms`;

    el.offsetHeight;
    el.style.height = '0';
    el.style.paddingTop = '0';
    el.style.paddingBottom = '0';
    el.style.marginTop = '0';
    el.style.marginBottom = '0';

    window.setTimeout(() => {
      el.style.display = 'none';
      el.style.removeProperty('height');
      el.style.removeProperty('padding-top');
      el.style.removeProperty('padding-bottom');
      el.style.removeProperty('margin-top');
      el.style.removeProperty('margin-bottom');
      el.style.removeProperty('overflow');
      el.style.removeProperty('transition-duration');
      el.style.removeProperty('transition-property');
    }, duration);
  };

  const slideDown = (el, duration = 400) => {
    if (!el) return;
    const display = getSlideDisplayValue(el);

    if (duration === 0) {
      el.style.display = display;
      return;
    }

    el.style.removeProperty('display');
    if (window.getComputedStyle(el).display === 'none') {
      el.style.display = display;
    }

    const computed = window.getComputedStyle(el);
    const paddingTop = computed.paddingTop;
    const paddingBottom = computed.paddingBottom;
    const marginTop = computed.marginTop;
    const marginBottom = computed.marginBottom;
    const height = el.scrollHeight;

    el.style.overflow = 'hidden';
    el.style.height = '0';
    el.style.paddingTop = '0';
    el.style.paddingBottom = '0';
    el.style.marginTop = '0';
    el.style.marginBottom = '0';
    el.style.transitionProperty = 'height, margin, padding';
    el.style.transitionDuration = `${duration}ms`;
    el.offsetHeight;
    el.style.height = `${height}px`;
    el.style.paddingTop = paddingTop;
    el.style.paddingBottom = paddingBottom;
    el.style.marginTop = marginTop;
    el.style.marginBottom = marginBottom;

    window.setTimeout(() => {
      el.style.removeProperty('height');
      el.style.removeProperty('overflow');
      el.style.removeProperty('transition-duration');
      el.style.removeProperty('transition-property');
      el.style.removeProperty('padding-top');
      el.style.removeProperty('padding-bottom');
      el.style.removeProperty('margin-top');
      el.style.removeProperty('margin-bottom');
    }, duration);
  };

  const slideToggle = (el, duration = 400) => {
    if (!el) return;
    if (window.getComputedStyle(el).display === 'none') {
      slideDown(el, duration);
    } else {
      slideUp(el, duration);
    }
  };

  if (!customElements.get('product-specs')) {
    customElements.define(
      'product-specs',
      class ProductSpecs extends HTMLElement {
        constructor() {
          super();
          this.selectors = {
            accordion_header: this.querySelectorAll('.accordion-ul .accordion-header'),
            swiper_dom: this.querySelector('.user-guide-swiper'),
            swiper_num: this.querySelectorAll('.user-guide-swiper .swiper-slide').length,
            specs_dom: this.querySelector('.accordion-content--with-child.specs'),
            manual: this.querySelector('.manual-list'),
          };
          this.init();
          this?.getSpecsInfo();
          this?.getUserManual();
        }

        init() {
          this.specVariant();
          // accordion toggle
          this.selectors.accordion_header.forEach((header) => {
            header.addEventListener('click', (e) => {
              const target = e.currentTarget;
              const content = target?.nextElementSibling;
              if (content && content.classList.contains('accordion-content')) {
                slideToggle(content);
              }
              target?.querySelector('.accordion-close')?.classList.toggle('active');
            });
          });

          // video pics swiper
          if (this.selectors.swiper_num) {
            let that = this;
            this.swiper = new Swiper(this.selectors.swiper_dom, {
              slidesPerView: 'auto',
              spaceBetween: 0,
              centeredSlides: true,
              followFinger: false,
              pagination: {
                el: this.selectors.swiper_dom.querySelector('.slideshow-pagination'),
                clickable: true,
                bulletClass: 'slideshow-pagination-item',
                bulletActiveClass: 'active pagination-active',
                clickableClass: 'slideshow-pagination-clickable',
                modifierClass: 'slideshow-pagination-',
                renderBullet: function (index, className) {
                  var slideIndex = index,
                    number = index <= 8 ? '0' + (slideIndex + 1) : slideIndex + 1;

                  var paginationItem = '<span class="slideshow-pagination-item">';
                  paginationItem =
                    index <= 8
                      ? paginationItem +
                        '<span class="pagination-separator"><span class="pagination-separator-loader"></span></span>'
                      : paginationItem;
                  paginationItem += '</span>';
                  return paginationItem;
                },
              },
              on: {
                resize: function () {
                  setTimeout(() => {
                    that.swiper.update();
                  }, 600);
                },
                slideChange: function () {
                  var activeIndex = this.activeIndex;
                  Array.from(this.slides).forEach(function (slide, index) {
                    if (index !== activeIndex) {
                      var video = slide.querySelector('jky-video');
                      if (video && video.pause) {
                        video.pause();
                      }
                    } else {
                      var video = slide.querySelector('jky-video');
                      if (video && video.loadContent) {
                        video.loadContent();
                      }
                    }
                  });
                },
              },
            });
          }
        }

        specVariant(init = true) {
          // 加点包
          document.querySelectorAll('.accordion-header--variant:not(.active)').forEach((header) => {
            const content = header.nextElementSibling;
            if (content && content.classList.contains('accordion-content')) {
              slideUp(content, 0);
            }
            header.querySelector('.accordion-close')?.classList.remove('active');
          });

          if (!init) {
            document.querySelectorAll('.accordion-header--variant.active').forEach((header) => {
              const content = header.nextElementSibling;
              if (content && content.classList.contains('accordion-content')) {
                slideDown(content, 0);
              }
              header.querySelector('.accordion-close')?.classList.add('active');
            });
          }
        }

        creatSpecsItemDom(obj) {
          let html = '';
          for (let n in obj) {
            if (typeof obj[n] === 'string') {
              html += `
                <div class="specs-item">
                    <span class="key">${n}${obj[n] ? ':' : ''}</span>
                    <span class="value">${this.replaceLineBreak(obj[n])}</span>
                </div>
                `;
            } else {
              html += this.creatSpecsItemDom(obj[n]);
            }
          }
          return html;
        }

        replaceLineBreak(str) {
          if (str.includes('\n')) {
            return str.replace(/\n/g, '<br>');
          }
          return str;
        }

        creatSpecsDom(data = []) {
          let box = '';
          data.map((item) => {
            if (item.baseInfos) {
              // 过滤特殊逻辑
              Object.keys(item.baseInfos).forEach((key) => {
                if (['Price', 'In The Box', 'Solar Charging Time'].includes(key)) {
                  delete item.baseInfos[key];
                }
              });

              let row = '';
              for (let i in item.baseInfos) {
                let col = '';
                if (item.baseInfos[i]) {
                  let obj = item.baseInfos[i];
                  if (typeof obj === 'string') {
                    col += `
                                      <div class="specs-item">
                                          <span class="key">${obj}</span>
                                      </div>
                                    `;
                  } else {
                    col += this.creatSpecsItemDom(obj);
                  }
                }
                row += `
                              <div class="specs-row">
                                  <div class="title">${i}</div>
                                  <div class="specs-wrap">
                                      ${col}
                                  </div>
                              </div>
                            `;
              }
              box += `
                          <div class="accordion-ul">
                              <div class="accordion-header">
                                  <h3 class="jky-text-lg font-bold">${item.title}</h3>
                                  <img class="accordion-close active"
                                  src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_4.svg?v=1678936033"
                                  alt="accordion-icon" loading="lazy" width="28" height="28">
                              </div>

                              <div class="accordion-content">
                                  <div class="item-box-content">${row}</div>
                              </div>
                          </div>
                        `;
            }
          });
          return box;
        }

        // 产品参数获取
        getSpecsInfo(skuId) {
          var sku_id = skuId;
          if (!skuId) {
            sku_id = document.querySelector('product-form')?.querySelector('[name=id]')?.value;
          }

          fetch(
            `${pageInfo.api}/osconsumerapi/app-product-comparison/consumer/detail?shopifyShopId=${pageInfo.shopId}&skuId=${sku_id}`
          )
            .then((response) => response.json())
            .then((res) => {
              let data = res.data;
              let dom = this.creatSpecsDom(data);
              if (data && Array.isArray(data) && data.length) {
                document.querySelector('.accordion--product-specs') &&
                  document.querySelector('.accordion--product-specs').classList.remove('hidden');
                if (this.selectors.specs_dom) {
                  this.selectors.specs_dom.innerHTML = dom;
                  this.selectors.specs_dom.querySelectorAll('.accordion-header').forEach((header) => {
                    header.addEventListener('click', (e) => {
                      const target = e.currentTarget;
                      const content = target?.nextElementSibling;
                      if (content && content.classList.contains('accordion-content')) {
                        slideToggle(content);
                      }
                      target?.querySelector('.accordion-close')?.classList.toggle('active');
                    });
                  });
                }
              } else {
                this.selectors.specs_dom?.querySelector('.accordion-ul') &&
                  (this.selectors.specs_dom.querySelector('.accordion-ul').innerHTML = '');
                document.querySelector('.accordion--product-specs') &&
                  document.querySelector('.accordion--product-specs').classList.add('hidden');
              }
            })
            .catch((e) => {
              console.error('Fetch error: getSpecsInfo', e);
            });
        }

        // 说明书
        getUserManual(sku) {
          var sku_id = sku;
          if (!sku) {
            sku_id = document.querySelector('product-form').querySelector('[name=id]').getAttribute('data-sku');
          }
          this.selectors.manual?.querySelectorAll('dd:not(.not-manual)')?.forEach((el) => el.remove());

          // 如果shopify元字段有配置，则取shopify的，没有则取接口
          const _currentVariant =
            window.product.productVariants[
              document.querySelector('product-form').querySelector('[name=id]').getAttribute('value')
            ];
          const batteryInfos = _currentVariant.batteryInfos || [];
          if (batteryInfos.length > 0) {
            document.querySelector('.accordion--manual') &&
              document.querySelector('.accordion--manual').classList.remove('hidden');

            let dd = '';
            batteryInfos.forEach((item) => {
              dd += `
                    <dd>
                        <p class="jky-text-sm font-500"><jds-icon name="pdf" class="icon-pdf"></jds-icon>${item.title}</p>
                        <a href="${item.url}" class="z-button-fill-middle"><jds-icon name="download" class="icon-download"></jds-icon>&nbsp;<span>${window.pageInfo.strings.product.download}</span></a>
                    </dd>
                    `;
            });
            this.selectors.manual?.insertAdjacentHTML('afterbegin', dd);
            return;
          } else {
            document.querySelector('.accordion--manual') &&
              document.querySelector('.accordion--manual').classList.add('hidden');
          }

          // 判断是套装还是单品, 套装查询getPackagedInfo, 单品查询getGoodsInfo
          if (this.selectors.manual?.getAttribute('type') === 'sg_gather') {
            fetch(
              `${pageInfo.api}/osconsumerapi/v1/goods/packaged-info?shopify_shop_id=${pageInfo.shopId}&sku=${sku_id}`
            )
              .then((response) => response.json())
              .then((res) => {
                let dd = '';
                res.data
                  .filter((item) => !!item.introduceBookUrlDesc)
                  .forEach((item) => {
                    dd += `
                        <dd>
                            <p class="jky-text-sm font-500"><jds-icon name="pdf" class="icon-pdf"></jds-icon>${item.title}</p>
                            <a href="${item.introduceBookUrlDesc}" download class="z-button-fill-middle"><jds-icon name="download" class="icon-download"></jds-icon>&nbsp;<span>${window.pageInfo.strings.product.download}</span></a>
                        </dd>
                        `;
                  });

                this.selectors.manual?.insertAdjacentHTML('afterbegin', dd);
                if (document.querySelector('.accordion--manual')) {
                  document.querySelectorAll('.accordion--manual dl dd').length > 0 &&
                    document.querySelector('.accordion--manual').classList.remove('hidden');
                }
              });
          } else {
            fetch(`${pageInfo.api}/osconsumerapi/v1/goods/info?shopify_shop_id=${pageInfo.shopId}&sku=${sku_id}`)
              .then((response) => response.json())
              .then((r) => {
                if (r.data && r.data.introduceBookUrlDesc) {
                  const d_html = `
                            <dd>
                            <p class="jky-text-sm font-500"><jds-icon name="pdf" class="icon-pdf"></jds-icon>${r.data.title}</p>
                            <a href="${r.data.introduceBookUrlDesc}" class="z-button-fill-middle"><jds-icon name="download" class="icon-download"></jds-icon>&nbsp;<span>${window.pageInfo.strings.product.download}</span></a>
                            </dd>
                        `;
                  this.selectors.manual?.insertAdjacentHTML('afterbegin', d_html);
                  if (document.querySelector('.accordion--manual')) {
                    document.querySelectorAll('.accordion--manual dl dd').length > 0 &&
                      document.querySelector('.accordion--manual').classList.remove('hidden');
                  }
                }
              });
          }
        }
      }
    );
  }

  if (!customElements.get('product-faq')) {
    customElements.define(
      'product-faq',
      class ProductFaq extends HTMLElement {
        constructor() {
          super();
          this.selectors = {
            faq_header: this.querySelectorAll('.produc-detail--faq li .faq-header'),
            faq_num: this.querySelectorAll('.produc-detail--faq li').length,
            more_btn: this.querySelector('.faq--more'),
          };
          this.init();
        }

        init() {
          const allFaqLis = Array.from(this.querySelectorAll('.produc-detail--faq ul li'));
          const extraLis = allFaqLis.slice(3);
          extraLis.forEach((li) => {
            li.style.display = 'none';
          });
          const isunfold = parseBoolean(this.dataset?.isunfold);
          if (isunfold) {
            extraLis.forEach((li) => {
              li.style.display = 'block';
            });
          }

          this.selectors.faq_header.forEach((header) => {
            header.addEventListener('click', (e) => {
              const target = e.currentTarget;
              const content = target?.nextElementSibling;
              if (content && content.classList.contains('faq-content')) {
                slideToggle(content);
              }
              target?.classList.toggle('active');
            });
          });

          this.selectors.more_btn?.addEventListener('click', (e) => {
            const btn = e.currentTarget;
            const parentFaq = btn?.closest('.produc-detail--faq');
            const listItems = parentFaq ? Array.from(parentFaq.querySelectorAll('ul li')).slice(3) : [];
            if (btn?.classList.contains('active')) {
              listItems.forEach((li) => {
                li.style.display = 'none';
              });
              if (btn) btn.querySelector('span').textContent = pageInfo.strings.product.viewMore;
            } else {
              listItems.forEach((li) => {
                li.style.display = 'block';
              });
              if (btn) btn.querySelector('span').textContent = pageInfo.strings.product.viewLess;
            }
            btn?.classList.toggle('active');
          });
        }
      }
    );
  }

  if (document.querySelector('.media_highlight_plugs')) {
    function renderMediaDom(videoSrc, controls, loop) {
      const type = videoSrc.includes('youtube.com') ? 'youtube' : 'mp4';

      let youtube_id = '';
      let youtube_embed = '';

      if (type === 'youtube') {
        if (videoSrc.indexOf('/embed/') !== -1) {
          youtube_id = videoSrc.replace('https://www.youtube.com/embed/', '');
        } else {
          youtube_id = videoSrc.replace('https://www.youtube.com/watch?v=', '');
        }
        youtube_embed = `https://www.youtube.com/embed/${youtube_id}`;
      }

      let media_dom = '';
      switch (type) {
        case 'mp4':
          media_dom = `
                    <video
                        class="jky-video_media"
                        x5-video-player-type="h5-page"
                        webkit-playsinline="playsinline"
                        playsinline="playsinline"
                        autoplay="autoplay"
                        muted="muted"
                        ${controls ? 'controls="controls"' : ''}
                        preload="metadata"
                        ${loop ? 'loop' : ''} "&width=1500"
                    >
                        <source src="${videoSrc}" type="video/mp4">
                    </video>
                `;
          break;
        case 'youtube':
          media_dom = `
                    <iframe
                        class="jky-video_media jky-media_youtube rounded-24"
                        src="${youtube_embed}?enablejsapi=1&autoplay=1&${
            loop ? 'loop=1' : ''
          }&playlist=${youtube_id}&mute=1"
                        class="js-youtube global-settings-popup"
                        allow="''; encrypted-media"
                        allowfullscreen=""
                    ></iframe>
                `;
        default:
          break;
      }
      return media_dom;
    }
    document.querySelectorAll('.media_highlight_plugs .button-title').forEach((btn) => {
      btn.addEventListener('click', () => {
        const videoSrc = btn.dataset.video || '';
        const controls = parseBoolean(btn.dataset.controls);
        const loop = parseBoolean(btn.dataset.loop);
        const popupHtml = renderMediaDom(videoSrc, controls, loop);
        ZModle.getInstance(popupHtml, {
          id: 'header-xvideo',
          class: 'header__changeLocal',
        });
      });
    });
  }

  if (document.querySelector('.media_highlight_matrix')) {
    let domWidth = document.body.scrollWidth;
    document.querySelectorAll('.media_highlight_matrix').forEach((wrap) => {
      const matrixGraphList = wrap.querySelector('.product-detail-matrix-graph .matrix-graph-list');
      if (matrixGraphList && matrixGraphList.children.length === 0) {
        wrap.remove();
        return;
      }
      const pclist = wrap.querySelector('.matrix-graph-content.pc-block .matrix-graph-list');
      const mblist = wrap.querySelector('.matrix-graph-content.mb-block .matrix-graph-list');
      if (domWidth > 1024) {
        if (pclist && pclist.children.length === 0) {
          const graph = wrap.querySelector('.product-detail-matrix-graph');
          if (graph) graph.style.marginBottom = '0';
        }
      } else {
        if (mblist && mblist.children.length === 0) {
          const graph = wrap.querySelector('.product-detail-matrix-graph');
          if (graph) graph.style.marginBottom = '0';
        }
      }
    });
    const diyMatrixList = document.querySelectorAll('.diy-matrix');
    const lastMediaHighlight = diyMatrixList.length ? diyMatrixList[diyMatrixList.length - 1] : null;
    const firstMediaHighlight = diyMatrixList.length ? diyMatrixList[0] : null;
    const matrixEl = document.querySelector('.diy-matrix .product-detail-matrix');
    const pcTop = Number(matrixEl?.dataset?.topPc || 0);
    const pcBottom = Number(matrixEl?.dataset?.bottomPc || 0);
    const mbTop = Number(matrixEl?.dataset?.topMb || 0);
    const mbBottom = Number(matrixEl?.dataset?.bottomMb || 0);
    if (domWidth > 1024) {
      if (pcBottom > 0) {
        if (lastMediaHighlight) lastMediaHighlight.style.marginBottom = `${pcBottom}px`;
      }
      if (pcTop > 0) {
        if (firstMediaHighlight) firstMediaHighlight.style.paddingTop = `${pcTop}px`;
      }
    } else {
      if (mbBottom > 0) {
        if (lastMediaHighlight) lastMediaHighlight.style.paddingBottom = `${mbBottom}vw`;
      }
      if (mbTop > 0) {
        if (firstMediaHighlight) firstMediaHighlight.style.paddingTop = `${mbTop}vw`;
      }
    }
    document.querySelectorAll('.section-matrix-graph .product-detail-matrix-graph').forEach((section) => {
      let columnTemplate, items, gridList;
      if (domWidth > 1024) {
        gridList = section.querySelector('.pc-block .matrix-graph-list');
        columnTemplate = gridList?.getAttribute('data-grid-columns') || '';
        items = Array.from(section.querySelectorAll('.pc-block .matrix-graph-item'));
        if (gridList) gridList.style.gridTemplateColumns = columnTemplate;
        const columnCount = columnTemplate ? columnTemplate.split(' ').length : 0;
        items.forEach((item, index) => {
          item.style.display = index < columnCount ? 'block' : 'none';
        });
      } else {
        gridList = section.querySelector('.mb-block .matrix-graph-list');
        columnTemplate = gridList?.getAttribute('data-grid-columns') || '';
        items = Array.from(section.querySelectorAll('.mb-block .matrix-graph-item'));
        if (gridList) gridList.style.gridTemplateColumns = 'repeat(2, 1fr)';
        const columnTemplateNum = Number(columnTemplate);
        if (columnTemplateNum > 1 && columnTemplateNum < 4) {
          switch (columnTemplateNum) {
            case 2:
              if (items[0]) items[0].style.gridColumn = '1 / 3';
              break;
            case 3:
              if (items[2]) items[2].style.gridColumn = '1 / 3';
              break;
          }
          if (items[3]) items[3].style.display = 'none';
        }
        if (columnTemplateNum == 4) {
          items.forEach((item) => {
            item.style.gridColumn = 'span 2';
          });
          if (items[2]) items[2].style.display = 'none';
        }
      }
    });

    document.querySelectorAll('.media_highlight_matrix').forEach((el) => {
      el.style.visibility = 'visible';
    });
  }

  /* 对比版块 */
  if (document.querySelector('.media_highlight_vs')) {
    var swipereee = new Swiper('.media_highlight_vs .swiper-thumbs', {
      spaceBetween: 0,
      slidesPerView: 'auto',
      slidesPerView: 1,
      freeMode: true,
      watchSlidesProgress: true,
    });

    new Swiper('.media_highlight_vs .main-swiper', {
      scrollbar: {
        el: '.media_highlight_vs .swiper-scrollbar',
      },
      spaceBetween: 10,
      navigation: {
        nextEl: '.media_highlight_vs .swiper-button-next',
        prevEl: '.media_highlight_vs .swiper-button-prev',
      },
      pagination: {
        el: '.media_highlight_vs .swiper-pagination',
        clickable: true,
      },
      thumbs: {
        swiper: swipereee,
      },
      autoplay:
        document.querySelector('.media_highlight_vs').getAttribute('data-autoplay') === 'true'
          ? {
              delay: Number(document.querySelector('.media_highlight_vs').getAttribute('data-speed')) * 1000,
              disableOnInteraction: false,
            }
          : false,
    });

    document.querySelectorAll('.media_highlight_vs .swiper-slide .toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.classList.toggle('active');
        btn.parentElement?.classList.toggle('active');
      });
    });
  }
  /* 对比版块 */
</script>

