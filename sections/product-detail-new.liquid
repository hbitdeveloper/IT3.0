{%- assign blocks_highlight_size = 0 -%}
{%- for block in section.blocks -%}
  {%- assign blocks_type = block.type -%}
  {%- if blocks_type contains 'media_highlight' -%}
    {%- assign blocks_highlight_size = blocks_highlight_size | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- assign blocks_tech_size = section.blocks | where: 'type', 'tech' | size -%}
{%- assign blocks_tech = section.blocks | where: 'type', 'tech' -%}

{%- assign blocks_faq_size = section.blocks | where: 'type', 'faq' | size -%}
{%- assign blocks_faq = section.blocks | where: 'type', 'faq' -%}

{% comment %} new {% endcomment %}
{%- assign blocks_faq_size_new = section.blocks | where: 'type', 'faq_new' | size -%}
{%- assign blocks_faq_new = section.blocks | where: 'type', 'faq_new' -%}

{%- assign blocks_reviews_size = section.blocks | where: 'type', 'reviews' | size -%}
{%- assign blocks_reviews = section.blocks | where: 'type', 'reviews' -%}

{%- assign tabs_num = blocks_faq_size | plus: blocks_tech_size | plus: blocks_reviews_size -%}
{%- if product.metafields.custom.is_show_new_faq -%}
  {%- assign tabs_num = blocks_faq_size_new
    | plus: blocks_faq_size
    | plus: blocks_tech_size
    | plus: blocks_reviews_size
  -%}
{%- endif -%}
{%- if blocks_highlight_size > 0 -%}
  {%- assign tabs_num = blocks_faq_size | plus: blocks_tech_size | plus: blocks_reviews_size | plus: 1 -%}
  {%- if product.metafields.custom.is_show_new_faq -%}
    {%- assign tabs_num = blocks_faq_size_new
      | plus: blocks_faq_size
      | plus: blocks_tech_size
      | plus: blocks_reviews_size
      | plus: 1
    -%}
  {%- endif -%}
{%- endif -%}

{% comment %} 详情 tab list {% endcomment %}
{%- assign tabs_list = '' -%}
{%- if blocks_highlight_size > 0 -%}
  {%- assign tabs_list = section.settings.tab_highlights -%}
{%- endif -%}

{%- if blocks_tech_size > 0 -%}
  {%- assign tabs_list = tabs_list | append: '-' | append: section.settings.tab_tech -%}
{%- endif -%}

{%- if blocks_faq_size > 0 -%}
  {%- assign tabs_list = tabs_list | append: '-' | append: section.settings.tab_faq -%}
{%- endif -%}

{%- if blocks_faq_size_new > 0 and product.metafields.custom.is_show_new_faq -%}
  {%- assign tabs_list = tabs_list | append: '-' | append: section.settings.tab_faq_new -%}
{%- endif -%}

{%- if blocks_reviews_size > 0 -%}
  {%- assign tabs_list = tabs_list | append: '-' | append: section.settings.review_faq -%}
{%- endif -%}
{%- assign tabs_list = tabs_list | split: '-' -%}
{%- render 'diy-tabs', settings: section.settings, title: product.title, list: tabs_list -%}
{% comment %} 详情 tab list {% endcomment %}

<div class="produc-detail--content">
  <div class="inner--container" style="--translate-x-w: {{tabs_num}};--translate-active: 0;">
    {%- if blocks_highlight_size > 0 -%}
      <div class="produc-detail--contetn_item">
        {%- for block in section.blocks -%}
          {%- assign blocks_type = block.type -%}
          {%- if blocks_type contains 'media_highlight' -%}
            {%- case block.type -%}
              {%- when 'media_highlight_scense' -%}
                <div
                  style="width: 100vw;"
                  class="product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  {% render 'diy-media-swiper', settings: block.settings %}
                </div>

              {%- when 'media_highlight_pic' -%}
                {%- if block.settings.pc_img -%}
                  <div
                    class="block--media_highlight_pic section-container product-media_highlight--block product-block-section"
                    {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                      data-invert="true"
                    {% endif %}
                  >
                    {%- if block.settings.title and block.settings.pos == 'out-pic' -%}
                      <div class="highlight_pic--title">{{ block.settings.title | newline_to_br }}</div>
                    {%- endif -%}

                    {%- if block.settings.subtitle and block.settings.pos == 'out-pic' -%}
                      <div class="highlight_pic--subtitle">{{ block.settings.subtitle | newline_to_br }}</div>
                    {%- endif -%}

                    <div class="relative highlight_pic-box">
                      {% render 'responsive-image',
                        image: block.settings.pc_img,
                        width: 1200,
                        mimage: block.settings.mb_img,
                        mwidth: 400,
                        image_class: 'w-full object-cover'
                      %}

                      {%- if block.settings.title and block.settings.pos == 'in-pic' -%}
                        <div class="inner-title absolute" style="color: {{block.settings.t_color}};">
                          {{ block.settings.title | newline_to_br }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'media_highlight_plugs' -%}
                {%- if block.settings.img_pc -%}
                  <div class="media_highlight_plugs block--media_highlight_plugs product-media_highlight--block section-container">
                    <div class="plugs-left">
                      {% render 'responsive-image',
                        image: block.settings.img_pc,
                        mimage: block.settings.img_mb,
                        width: 600,
                        mwidth: 320
                      %}
                      {%- if block.settings.bottomtitle -%}
                        <div class="bottom-mobile-subtitle">{{ block.settings.bottomtitle | escape }}</div>
                      {%- endif -%}
                    </div>
                    <div class="media_highlight_plugs-content">
                      <div class="plugs-content-top">
                        {%- if block.settings.title -%}
                          <div class="title">{{ block.settings.title | escape }}</div>
                        {%- endif -%}
                        {%- if block.settings.subtitle -%}
                          <div class="subtitle">{{ block.settings.subtitle | escape }}</div>
                        {%- endif -%}
                        {%- if block.settings.buttonName != blank and block.settings.video_url != blank -%}
                          <div
                            class="button-title"
                            data-video="{{ block.settings.video_url }}"
                            data-controls="{{ block.settings.controls }}"
                            data-loop="{{ block.settings.loop }}"
                          >
                            <div class="bottom-video-title">
                              {{ block.settings.buttonName | escape }}
                            </div>
                            <svg
                              width="34"
                              height="34"
                              viewBox="0 0 34 34"
                              fill="none"
                            >
                              <path fill-rule="evenodd" clip-rule="evenodd" d="M23.4118 32.5357C21.3832 33.4187 19.2216 33.8602 16.927 33.8602C14.6212 33.8602 12.4541 33.4187 10.4255 32.5357C8.39689 31.6527 6.60663 30.4365 5.0547 28.8871C3.50277 27.3377 2.28894 25.5439 1.41321 23.5058C0.537475 21.4677 0.0996094 19.2991 0.0996094 16.9999C0.0996094 14.7008 0.540247 12.5322 1.42152 10.4941C2.3028 8.45595 3.51385 6.66218 5.0547 5.11277C6.59554 3.56335 8.38026 2.34715 10.4089 1.46415C12.4375 0.581148 14.6046 0.139648 16.9103 0.139648C19.2161 0.139648 21.3832 0.581148 23.4118 1.46415C25.4404 2.34715 27.2307 3.56335 28.7826 5.11277C30.3345 6.66218 31.5511 8.45595 32.4324 10.4941C33.3137 12.5322 33.7543 14.7008 33.7543 16.9999C33.7543 19.2991 33.3137 21.4677 32.4324 23.5058C31.5511 25.5439 30.3345 27.3377 28.7826 28.8871C27.2307 30.4365 25.4404 31.6527 23.4118 32.5357ZM12.6449 23.7968C12.9941 23.9523 13.3571 23.9134 13.734 23.6801L23.4779 17.9157C23.8215 17.7046 23.9906 17.4075 23.985 17.0243C23.9795 16.6411 23.8104 16.3496 23.4779 16.1497L13.734 10.3352C13.3904 10.1353 13.0356 10.1047 12.6698 10.2436C12.304 10.3824 12.1211 10.6462 12.1211 11.0349V22.9971C12.1211 23.3747 12.2957 23.6413 12.6449 23.7968Z" fill="white"/>
                            </svg>
                          </div>
                          <jky-modalstatic modal-id="highlight">
                            <div class="highlight_modal modalstatic"></div>
                            <div class="highlight_modal_mask"></div>
                          </jky-modalstatic>
                        {%- endif -%}
                      </div>
                      {%- if block.settings.bottomtitle -%}
                        <div class="bottom-pc-subtitle">{{ block.settings.bottomtitle | escape }}</div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- when 'media_highlight_fullImg' -%}
                {%- if block.settings.full_title -%}
                  <div
                    class="block--media_highlight_full_img product-media_highlight--block "
                    style="position:relative;background:{{ block.settings.bg_color }}"
                  >
                    {% render 'responsive-image',
                      image: block.settings.full_img_pc,
                      mimage: block.settings.full_img_mb,
                      image_class: 'highlight_full--image'
                    %}
                    {%- if block.settings.full_title -%}
                      <div class="full-title section-container">
                        <div class="title" style="color:{{ block.settings.title_color }}">
                          {{ block.settings.full_title }}
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'media_highlight_swiper' -%}
                <div
                  class="media_highlight_text_swiper section-container product-media_highlight--block product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  <div class="swiper">
                    <div class="swiper-wrapper">
                      {%- for i in (0..3) -%}
                        {% assign title_index = 'title_' | append: forloop.index %}
                        {% assign subtitle_index = 'subtitle_' | append: forloop.index %}
                        {% assign bottomtitle_index = 'bottomtitle_' | append: forloop.index %}
                        {% assign img_pc_index = 'img_pc_' | append: forloop.index %}
                        {% assign img_mb_index = 'img_mb_' | append: forloop.index %}
                        {% assign icon_img_index = 'icon_img_' | append: forloop.index %}
                        {% assign pos_index = 'pos_' | append: forloop.index %}
                        {%- if block.settings[img_pc_index] != blank -%}
                          <div class="swiper-slide">
                            <div class="media_highlight_text_swiper--item {{ block.settings[pos_index]}}">
                              {% render 'responsive-image',
                                image: block.settings[img_pc_index],
                                mimage: block.settings[img_mb_index],
                                width: 600,
                                mwidth: 320
                              %}

                              <div class="media_highlight_text_swiper--item_content">
                                <div class="title">{{ block.settings[title_index] | escape }}</div>
                                <div class="subtitle">{{ block.settings[subtitle_index] | escape }}</div>
                                <div class="bottom-subtitle">{{ block.settings[bottomtitle_index] | escape }}</div>

                                {%- if block.settings[icon_img_index] -%}
                                  <img
                                    class="icon"
                                    src="{{block.settings[icon_img_index] | image_url: width: 400}}"
                                    alt="{{block.settings[icon_img_index].alt | escape}}"
                                    width="200"
                                    height="76"
                                    loading="lazy"
                                  >
                                {%- endif -%}
                              </div>
                            </div>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                    <div class="swiper-pagination"></div>
                  </div>
                </div>
              {%- when 'media_highlight_banner' -%}
                {% comment %} banner版块 {% endcomment %}
                {% render 'five-kwh-banner', banner: block.settings, new_window: block.settings.new_window %}

              {%- when 'media_highlight_bar' -%}
                <div
                  class="section-photovolatic section-photovolatic-save-electricity product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  {% render 'product-detail-costbar', settings: block.settings %}
                </div>

              {%- when 'media_highlight_space' -%}
                <div
                  class=" product-media_highlight--block product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  {%- render 'diy-scroll-textpic', settings: block.settings -%}
                </div>
              {%- when 'media_highlight_videos' -%}
                <div
                  class="section-photovolatic section-photovolatic-find-out product-media_highlight--block product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  {% render 'product-detail-videos', settings: block.settings %}
                </div>

              {%- when 'media_highlight_comment' -%}
                <div
                  class="section-photovolatic section-photovolatic-comment-list product-media_highlight_comment--block product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  {% render 'product-detail-comment', settings: block.settings %}
                </div>

              {%- when 'media_highlight_img' -%}
                <div
                  class="section-photovolatic section-photovolatic-advertising-image product-media_highlight--block product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  {% render 'product-detail-advertising', settings: block.settings %}
                </div>

              {%- when 'media_highlight_setups' -%}
                <div
                  class="section-photovolatic section-photovolatic-setup product-media_highlight--block product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  {% render 'product-detail-setupvideo', settings: block.settings %}
                </div>

              {%- when 'media_highlight_full' -%}
                <div
                  class="product-block-section product-media_highlight--block"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  {%- render 'diy-video',
                    mbPoster: block.settings.mbPoster,
                    mbUrl: block.settings.mbUrl,
                    pcPoster: block.settings.pcPoster,
                    pcUrl: block.settings.pcUrl,
                    text: block.settings.text,
                    autoplay: block.settings.autoplay,
                    loop: block.settings.loop,
                    controls: block.settings.controls
                  -%}
                </div>

              {%- when 'media_highlight_2pic' -%}
                <div
                  class="media_highlight_2pic section-container product-media_highlight--block product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  <div
                    class="media_highlight_2pic--item"
                    style="background-image:url({{ block.settings.img_pc_left | image_url: width: 600 }})"
                  >
                    <div class="title">{{ block.settings.title_left | escape }}</div>
                    <div class="subtitle">{{ block.settings.subtitle_left | escape }}</div>
                    {% render 'responsive-image',
                      image: block.settings.img_pc_left,
                      mimage: block.settings.img_mb_left,
                      width: 300,
                      mwidth: 180
                    %}
                  </div>

                  <div
                    class="media_highlight_2pic--item"
                    style="background-image:url({{ block.settings.img_pc_right | image_url: width: 600 }})"
                  >
                    <div class="title">{{ block.settings.title_right | escape }}</div>
                    <div class="subtitle">{{ block.settings.subtitle_right | escape }}</div>
                    {% render 'responsive-image',
                      image: block.settings.img_pc_right,
                      mimage: block.settings.img_mb_right,
                      width: 300,
                      mwidth: 180
                    %}
                  </div>
                </div>

              {%- when 'media_highlight_vs' -%}
                <div
                  class="media_highlight_vs product-media_highlight--block product-block-section"
                  data-autoplay="{{block.settings.autoplay}}"
                  data-speed="{{block.settings.autoplay_speed}}"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  <div class="section-container relative">
                    <div class="title text-center">{{ block.settings.title | escape }}</div>
                    <div class="swiper-thumbs swiper">
                      <div class="swiper-wrapper">
                        {%- for i in (0..5) -%}
                          {% assign vtitle_index = 'vtitle_' | append: forloop.index %}

                          {%- if block.settings[vtitle_index] != blank -%}
                            <div class="swiper-slide">{{ block.settings[vtitle_index] | escape }}</div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>

                    <div class="swiper main-swiper">
                      <div class="swiper-wrapper">
                        {%- for i in (0..5) -%}
                          {% assign vtitle_index = 'vtitle_' | append: forloop.index %}
                          {% assign vimg_left_index = 'vimg_left_' | append: forloop.index %}
                          {% assign vdes_left_index = 'vdes_left_' | append: forloop.index %}
                          {% assign vimg_right_index = 'vimg_right_' | append: forloop.index %}
                          {% assign vdes_right_index = 'vdes_right_' | append: forloop.index %}

                          {%- if block.settings[vtitle_index] != blank -%}
                            <div class="swiper-slide relative">
                              <div class="mb-tab">{{ block.settings[vtitle_index] | escape }}</div>
                              <div class="slide--item active">
                                <div
                                  class="toggle-btn absolute active"
                                  data-ga-event="photovoltaics_user_clicks"
                                  data-ga-action="click"
                                  data-ga-params-button_name="left"
                                  data-ga-params-position="{{forloop.index}}"
                                  data-ga-params-link="{{block.settings[vimg_left_index] | image_url: width: block.settings[vimg_left_index].width}}"
                                  data-ga-params-module="Mul_tap Product Compare"
                                ></div>
                                <div class="toggle-content">{{ block.settings[vdes_left_index] | escape }}</div>
                                {% render 'responsive-image',
                                  class: 'rounded-24',
                                  image: block.settings[vimg_left_index],
                                  width: 600,
                                  mwidth: 350
                                %}
                              </div>

                              <div class="slide--item active">
                                <div
                                  class="toggle-btn absolute active"
                                  data-ga-event="photovoltaics_user_clicks"
                                  data-ga-action="click"
                                  data-ga-params-button_name="right"
                                  data-ga-params-position="{{forloop.index}}"
                                  data-ga-params-link="{{block.settings[vimg_right_index] | image_url: width: block.settings[vimg_right_index].width}}"
                                  data-ga-params-module="Mul_tap Product Compare"
                                ></div>
                                <div class="toggle-content">{{ block.settings[vdes_right_index] | escape }}</div>
                                {% render 'responsive-image',
                                  image_class: 'rounded-24',
                                  image: block.settings[vimg_right_index],
                                  width: 600,
                                  mwidth: 350
                                %}
                              </div>

                              <div class="vs absolute">VS</div>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>

                      <div class="swiper-scrollbar"></div>
                      <div class="swiper-pagination"></div>

                      <div class="swiper-button-next swiper--pagebtn"></div>
                      <div class="swiper-button-prev swiper--pagebtn"></div>
                    </div>
                  </div>
                </div>

              {%- when 'media_highlight_animate' -%}
                <div
                  dat-bg="{{block.settings.block_bg}}"
                  class="media_highlight_animate section-container section-photovolatic section-photovolatic-for-home product-media_highlight--block product-block-section"
                  {% if block.settings.block_bg != blank and block.settings.block_bg != 'rgba(0,0,0,0)' %}
                    data-invert="true"
                  {% endif %}
                >
                  {% render 'product-detail-animate', settings: block.settings %}
                </div>

              {%- when 'media_highlight_award' -%}
                {% comment %} 媒体背书 {% endcomment %}
                {% render 'index-award-new', award: block.settings, index: forloop.index %}

              {%- when 'media_highlight_matrix' -%}
                <div class="media_highlight_matrix section-matrix-graph diy-matrix">
                  {% render 'matrix-graph', settings: block.settings %}
                </div>

              {%- when 'media_highlight_button' -%}
                {% comment %} 通用按钮 {% endcomment %}
                {% render 'common-button', block: block %}

              {%- when 'media_highlight_single' -%}
                {% comment %} 单张上文下图 {% endcomment %}
                <div class="pdp-v4-content">
                  {% render 'pdp-single-text-img', settings: block.settings, index: forloop.index %}
                </div>
              {%- when 'media_highlight_two' -%}
                {% comment %} 一行两组图文 {% endcomment %}
                <div class="pdp-v4-content">
                  {% render 'pdp-two-text-img', settings: block.settings, index: forloop.index %}
                </div>
              {%- when 'media_highlight_three' -%}
                {% comment %} 一行三组图文 {% endcomment %}
                <div class="pdp-v4-content">
                  {% render 'pdp-three-text-img', settings: block.settings, index: forloop.index %}
                </div>
              {%- when 'media_highlight_calc' -%}
                {% comment %} 计算器 {% endcomment %}
                <div class="pdp-v4-content">
                  {% render 'pdp-calculator', settings: block.settings, index: forloop.index %}
                </div>
              {%- when 'media_highlight_empty' -%}
                {% comment %} 空盒子版块 {% endcomment %}
                {% render 'empty-block-box',
                  settings: block.settings,
                  handle: block.settings.sourceHandle,
                  index: forloop.index
                %}
                {% comment %} 富文本版块 {% endcomment %}
              {%- when 'media_highlight_des' -%}
                {%- render 'activity-description', settings: block.settings -%}

              {%- when 'media_highlight_recommend' -%}
                {% comment %} 智能选购{% endcomment %}
                <div class="smart-box" style="background: {{ block.settings.bg_color }}">
                  {% render 'smart-recommend-block', smart: block.settings, index: forloop.index %}
                </div>

                {% comment %} 产品对比 {% endcomment %}
              {%- when 'media_highlight_compare' -%}
                {% style %}
                  #{{block.id }}{ margin: {{ block.settings.pc_margin_x }}px 0; }
                  #{{block.id }} .compare-block-container{ width: 1200px; margin: 0 auto; }
                  #{{block.id }} .compare-title{ font-weight: 500; font-size: 40px; color: #1A1A1A; line-height: 48px; text-align: center; margin-bottom: 16px; }
                  #{{block.id }} .compare-desc{ font-weight: 500; font-size: 18px; color: #1A1A1A; line-height: 26px; text-align: center; }
                  @media screen and (max-width: 1440px) {
                    #{{block.id }}{margin: {{ block.settings.pc_margin_x }}px 0}
                    #{{block.id }} .compare-block-container{ width: 83.3333333333333vw; margin: 0 auto; }
                    #{{block.id }} .compare-title{ font-size: 2.77777777777778vw; line-height: 3.33333333333333vw; margin-bottom: 1.11111111111111vw; }
                    #{{block.id }} .compare-desc{ font-size: 1.25vw; line-height: 1.80555555555556vw; }
                  }
                  @media screen and (max-width: 1024px) {
                    #{{block.id }} {margin: {{ block.settings.mb_margin_x }}px 0;}
                    #{{block.id }} .compare-block-container{ width: 88.26666666vw; }
                    #{{block.id }} .compare-title{ font-size: 7.46666666666667vw; line-height: 7.46666666666667vw; text-align: left; margin-bottom: 2.13333333333333vw; }
                    #{{block.id }} .compare-desc{ font-weight: 500; font-size: 4.26666666666667vw; color: #1A1A1A; line-height: 6.4vw; text-align: left; }
                  }
                {% endstyle %}
                {% assign current_variant_id = product.selected_or_first_available_variant.id %}

                <div id="{{block.id }}" {{ block.shopify_attributes }}>
                  <div class="compare-block-container">
                    {% if block.settings.title != blank %}
                      <div class="compare-title">{{ block.settings.title | escape }}</div>
                    {% endif %}

                    {% if block.settings.desc != blank %}
                      <div class="jds-rte compare-desc">
                        {{ block.settings.desc | replace: '<em>', '<em style="color: var(--jds-color-primary);">' }}
                      </div>
                    {% endif %}
                    {% render 'compare-content',
                      type: 2,
                      view_more: block.settings.view_more,
                      current_variant_id: current_variant_id
                    %}
                  </div>
                </div>

              {%- when 'media_highlight_products' -%}
                {% comment %} 产品推荐 {% endcomment %}
                {%- render 'app-recommend-products', block_settings: block.settings, product: product -%}
            {%- endcase -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if blocks_tech_size > 0 -%}
      {%- assign blockTech = blocks_tech | first -%}
      <div class="produc-detail--contetn_item product-detail--tech">
        <product-specs
          class="product-block-section"
          {{ blockTech.shopify_attributes }}
          {% if blockTech.settings.block_bg != blank and blockTech.settings.block_bg != 'rgba(0,0,0,0)' %}
            data-invert="true"
          {% endif %}
        >
          <h2 class="section-container jky-text-2xl text-center tech--title">
            {{ blockTech.settings.title | escape }}
          </h2>
          {% comment %} 产品spec pics - 产品端口和尺寸 {% endcomment %}
          <div
            class="accordion-ul section-container {% if blockTech.settings.part_1_heading == blank %} hidden{% endif %}"
            style="{% if blockTech.settings.part_1_heading == blank %}display: none;{% endif %}"
          >
            <div class="accordion-header">
              {%- if blockTech.settings.part_1_heading != blank -%}
                <h3 class="jky-text-lg font-bold">{{ blockTech.settings.part_1_heading | escape }}</h3>

                <img
                  class="accordion-close active"
                  src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_4.svg?v=1678936033"
                  alt="accordion-icon"
                  loading="lazy"
                  width="28"
                  height="28"
                >
              {%- endif -%}
            </div>

            <div class="accordion-content flex-col">
              {% comment %} 主产品 {% endcomment %}
              {%- if blockTech.settings.part_1_img -%}
                {%- if blockTech.settings.part_1_product_title -%}
                  <div class="accordion-content--title jky-text-xl font-500 text-center">
                    {{ blockTech.settings.part_1_product_title | escape }}
                  </div>
                {%- endif -%}

                <div class="flex accordion-content--specs-pic justify-center">
                  {% render 'responsive-image',
                    image: blockTech.settings.part_1_img,
                    width: 750,
                    mwidth: 300,
                    image_class: 'specs-img'
                  %}
                  <ul>
                    {%- for i in (0..9) -%}
                      {% assign key_index = 'part_1_product_desc_' | append: forloop.index %}

                      {%- if blockTech.settings[key_index] != blank -%}
                        <li class="jky-text-base">{{ blockTech.settings[key_index] | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
              {% comment %} 左侧产品图 {% endcomment %}
              {%- if blockTech.settings.part_1_img_2 -%}
                {%- if blockTech.settings.part_1_product_2_title -%}
                  <div class="accordion-content--title jky-text-xl font-500 text-center">
                    {{ blockTech.settings.part_1_product_2_title | escape }}
                  </div>
                {%- endif -%}

                <div class="flex accordion-content--specs-pic justify-center">
                  {% render 'responsive-image',
                    image: blockTech.settings.part_1_img_2,
                    width: 750,
                    mwidth: 300,
                    image_class: 'specs-img'
                  %}
                  <ul>
                    {%- for i in (0..9) -%}
                      {% assign key_index = 'part_1_product_2_desc_' | append: forloop.index %}

                      {%- if blockTech.settings[key_index] != blank -%}
                        <li class="jky-text-base">{{ blockTech.settings[key_index] | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              {% comment %} 右侧产品图 {% endcomment %}
              {%- if blockTech.settings.part_1_img_3 -%}
                {%- if blockTech.settings.part_1_product_3_title -%}
                  <div class="accordion-content--title jky-text-xl font-500 text-center">
                    {{ blockTech.settings.part_1_product_3_title | escape }}
                  </div>
                {%- endif -%}

                <div class="flex accordion-content--specs-pic justify-center">
                  {% render 'responsive-image',
                    image: blockTech.settings.part_1_img_3,
                    width: 750,
                    mwidth: 300,
                    image_class: 'specs-img'
                  %}
                  <ul>
                    {%- for i in (0..9) -%}
                      {% assign key_index = 'part_1_product_3_desc_' | append: forloop.index %}

                      {%- if blockTech.settings[key_index] != blank -%}
                        <li class="jky-text-base">{{ blockTech.settings[key_index] | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
              {% assign bundle_flag = false %}
              {%- if blockTech.settings.part_1_img == blank
                and blockTech.settings.part_1_img_2 == blank
                and blockTech.settings.part_1_img_3 == blank
              -%}
                {% assign bundle_flag = true %}
              {%- endif -%}

              {% comment %} 组合配件产品 {% endcomment %}
              {%- for i in (0..4) -%}
                {% assign bundle_key_index = 'part_1_bundle_img_' | append: forloop.index %}
                {% assign bundle_title_index = 'part_1_bundle_title_' | append: forloop.index %}
                {% assign bundle_desc_index = 'part_1_bundle_desc_' | append: forloop.index %}

                {%- if blockTech.settings[bundle_key_index] -%}
                  <div
                    class="accordion-content--specs-pic_bundle"
                    {% if forloop.index == 1 and bundle_flag == true %}
                      style="margin-top: 0;padding-top: 0;border-top: none;" {{ forloop.index }}
                    {% endif %}
                  >
                    {%- if blockTech.settings[bundle_title_index] -%}
                      <div class="accordion-content--title jky-text-xl font-500 text-center">
                        {{ blockTech.settings[bundle_title_index] | escape }}
                      </div>
                    {%- endif -%}
                    {% render 'responsive-image',
                      image: blockTech.settings[bundle_key_index],
                      width: 900,
                      mwidth: 300,
                      image_class: 'specs-img'
                    %}

                    {%- if blockTech.settings[bundle_desc_index] -%}
                      <span class="jky-text-sm">{{ blockTech.settings[bundle_desc_index] | escape }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          {% comment %} 产品spec pics - 产品端口和尺寸 {% endcomment %}

          {% comment %} 产品参数 {% endcomment %}
          <div
            class="accordion-ul section-container accordion--product-specs {% if blockTech.settings.part_2_heading == blank %} hidden{% endif %}"
            style="{% if blockTech.settings.part_2_heading == blank %}display: none;{% endif %}"
          >
            <div class="accordion-header">
              {%- if blockTech.settings.part_2_heading != blank -%}
                <h3 class="jky-text-lg font-bold">{{ blockTech.settings.part_2_heading | escape }}</h3>
                <img
                  class="accordion-close active"
                  src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_4.svg?v=1678936033"
                  alt="accordion-icon"
                  loading="lazy"
                  height="28"
                  width="28"
                >
              {%- endif -%}
            </div>
            <div class="accordion-content accordion-content--with-child specs">
              <div class="accordion-ul"></div>
            </div>
          </div>
          {% comment %} 产品参数 {% endcomment %}

          {% comment %} 加电包信息 {% endcomment %}
          {%- assign show_whatsbox = true -%}
          {%- if product.has_only_default_variant == true and product.metafields.custom.what_in_box.value == blank -%}
            {%- assign show_whatsbox = false -%}
          {%- endif -%}
          <div
            class="accordion-ul section-container accordion--whats-in-box {% if blockTech.settings.part_3_heading == blank and show_whatsbox == false %} hidden{% endif %}"
            style="{% if blockTech.settings.part_3_heading == blank %}display: none;{% endif %}"
          >
            <div class="accordion-header">
              <h3 class="jky-text-lg font-bold">{{ blockTech.settings.part_3_heading | escape }}</h3>
              <img
                class="accordion-close active"
                src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_4.svg?v=1678936033"
                alt="accordion-icon"
                loading="lazy"
                height="28"
                width="28"
              >
            </div>
            <div class="accordion-content" style="flex-direction: column;padding: 0;">
              {%- if product.has_only_default_variant == false -%}
                {%- for variant in product.variants -%}
                  {%- if variant.metafields.custom.what_in_box != blank -%}
                    {%- assign what_box = variant.metafields.custom.what_in_box.value -%}
                    <div class="accordion-content accordion-content--with-notes accordion-content--with-child">
                      <div class="accordion-ul">
                        <div
                          data-id="{{variant.id}}"
                          class="accordion-header accordion-header--variant {% if product.selected_or_first_available_variant.id == variant.id %} active{% endif %}"
                        >
                          <h3 class="jky-text-lg font-bold">{{ variant.title }}</h3>
                          <img
                            class="accordion-close active"
                            src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_4.svg?v=1678936033"
                            alt="accordion-icon"
                            loading="lazy"
                            width="28"
                            height="28"
                          >
                        </div>
                        <div class="accordion-content accordion-content_whatsbox accordion-content_whatsbox--variant">
                          <div class="note-accordion-content">
                            <img
                              class="specs-img"
                              src="{{what_box.pic | image_url: width: 680}}"
                              alt="{{what_box.pic.alt | escape}}"
                            >
                            <ul>
                              {%- assign items_list = what_box.items.value -%}
                              {%- for i in items_list -%}
                                <li class="jky-text-xs">{{ i }}</li>
                              {%- endfor -%}
                            </ul>
                          </div>

                          {{ what_box.notes | metafield_tag | replace: '<p>', '<p class="notes jky-text-base">' }}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {% comment %} 单品-无变体 {% endcomment %}
                {%- if product.metafields.custom.what_in_box != blank -%}
                  {%- assign what_box = product.metafields.custom.what_in_box.value -%}
                  <div class="accordion-content accordion-content--with-notes">
                    <div class="accordion-ul">
                      <div class="accordion-content accordion-content_whatsbox" style="flex-direction: column;">
                        <div class="note-accordion-content">
                          {% render 'responsive-image',
                            image: what_box.pic,
                            width: 900,
                            mwidth: 300,
                            image_class: 'specs-img'
                          %}
                          <ul>
                            {%- assign items_list = what_box.items.value -%}
                            {%- for i in items_list -%}
                              <li class="jky-text-xs">{{ i }}</li>
                            {%- endfor -%}
                          </ul>
                        </div>

                        {{ what_box.notes | metafield_tag | replace: '<p>', '<p class="notes jky-text-base">' }}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>

          <div
            class="accordion-ul section-container"
            style="{% if blockTech.settings.part_4_heading == blank %}display: none;{% endif %}"
          >
            <div class="accordion-header">
              {%- if blockTech.settings.part_4_heading != blank -%}
                <h3 class="jky-text-lg font-bold">{{ blockTech.settings.part_4_heading | escape }}</h3>
                <img
                  class="accordion-close active"
                  src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_4.svg?v=1678936033"
                  alt="accordion-icon"
                  loading="lazy"
                  height="28"
                  width="28"
                >
              {%- endif -%}
            </div>
            <div class="accordion-content accordion-content--with-notes">
              <div class="manual-item">
                {%- if blockTech.settings.part_4_subheading -%}
                  <div class="sub_title jky-text-lg">{{ blockTech.settings.part_4_subheading | escape }}</div>
                {%- endif -%}
                <dl class="manual-list" type="{{blockTech.settings.page_type}}">
                  {%- if blockTech.settings.part_4_note != blank -%}
                    <dd class="not-manual">
                      {{ blockTech.settings.part_4_note | replace: '<p>', '<p class="item-box-content jky-text-sm">' }}
                    </dd>
                  {%- endif -%}

                  <dd class="dd--guide-swiper not-manual">
                    {%- if blockTech.settings.part_4_sub_2 != blank -%}
                      <div class="sub_title jky-text-lg">{{ blockTech.settings.part_4_sub_2 | escape }}</div>
                    {%- endif -%}
                    <div class="user-guide-swiper swiper" style="width:100%;">
                      <div class="swiper-wrapper">
                        {%- for i in (0..2) -%}
                          {% assign video_key_index = 'part_4_media_' | append: forloop.index %}
                          {% assign poster_key_index = 'part_4_manual_' | append: forloop.index %}
                          {% assign tips_key_index = 'part_4_tips_' | append: forloop.index %}

                          {%- if blockTech.settings[video_key_index] != blank
                            or blockTech.settings[poster_key_index] != blank
                          -%}
                            <div class="swiper-slide flex flex-col">
                              {%- render 'jky-video',
                                video_url: blockTech.settings[video_key_index],
                                poster: blockTech.settings[poster_key_index],
                                title: product.title,
                                class: '',
                                autoplay: false,
                                controls: true,
                                loop: false
                              -%}

                              <div class="text jky-text-sm">{{ blockTech.settings[tips_key_index] | escape }}</div>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                      <div class="slideshow-pagination relative"></div>
                    </div>
                  </dd>
                </dl>
              </div>
            </div>
          </div>
        </product-specs>
      </div>
    {%- endif -%}

    {% comment %} FAQ {% endcomment %}
    {%- if blocks_faq_size > 0 -%}
      {%- assign blockFaq = blocks_faq | first -%}
      {%- if blockFaq.settings.faq_show_category == true -%}
        {%- assign faq_num = 0 -%}
        {%- for item in product.metafields.custom.faq_multiple_columns.value -%}
          {%- assign faq_num = faq_num | plus: 1 -%}
        {%- endfor -%}

        <product-faq-columns
          {{ blockFaq.shopify_attributes }}
          class="produc-detail--contetn_item produc-detail--faq-multi produc-detail--faq-multi_origin"
        >
          <div
            class="produc-detail--faq section-container product-block-section"
            {% if blockFaq.settings.block_bg != blank and blockFaq.settings.block_bg != 'rgba(0,0,0,0)' %}
              data-invert="true"
            {% endif %}
            data-show-category="{{blockFaq.settings.faq_show_category}}"
          >
            <div class="faq-title">{{ blockFaq.settings.title | escape }}</div>

            {%- assign categories = product.metafields.custom.faq_multiple_columns.value -%}
            {%- assign faq_all = '' -%}
            {%- assign view_more_link = '' -%}
            {%- assign faq_all_count = 0 -%}

            {% if faq_num > 0 %}
              <div class="produc-detail--faq-wrap flex">
                {% comment %} 需要分类展示 {% endcomment %}
                {%- if blockFaq.settings.faq_show_category -%}
                  <div class="produc-detail--faq-left">
                    {%- for faq_category in categories -%}
                      {%- if forloop.index0 == 0 -%}
                        {%- assign view_more_link = faq_category.view_more_link -%}
                      {%- endif -%}
                      <div
                        class="faq-category-name {% if forloop.index0 == 0 %}active{% endif %}"
                        data-product-title="{{ product.title | escape }}"
                        data-index="{{forloop.index0}}"
                        data-view-more-link="{{faq_category.view_more_link}}"
                      >
                        {{ faq_category.column_name | escape }}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="produc-detail--faq-right">
                  {% comment %} 需要分类展示 {% endcomment %}
                  {%- if blockFaq.settings.faq_show_category -%}
                    {%- for faq_category in categories -%}
                      <ul data-index="{{forloop.index0}}" class="{% if forloop.index0 == 0 %}active{% endif %}">
                        {% comment %} 最多显示 10个 {% endcomment %}
                        {%- for faq_question_and_answer in faq_category.column_content.value limit: 10 -%}
                          <li>
                            <div class="faq-header flex">
                              <span>{{ faq_question_and_answer.question | escape }}</span>
                              <svg
                                class="toggle_btn active"
                                viewBox="0 0 1024 1024"
                                width="36"
                                height="36"
                              >
                                <path d="M512 671.288889L785.066667 398.222222l-56.888889-62.577778L512 551.822222 295.822222 335.644444 233.244444 398.222222z" fill="currentColor" opacity=".6"></path>
                              </svg>
                            </div>
                            <div class="faq-content">
                              <div class="rte">{{ faq_question_and_answer.answer_text | metafield_tag }}</div>
                              <div>
                                {%- assign media_url = faq_question_and_answer.answer_media | metafield_text -%}
                                {%- if media_url contains '.mp4' or media_url contains '.mov' -%}
                                  {% comment %} video {% endcomment %}
                                  {% render 'jky-video',
                                    class: 'w-full h-full faq-video',
                                    video_url: media_url,
                                    autoplay: false,
                                    loop: false,
                                    controls: true
                                  %}
                                {%- elsif media_url contains '.jpg'
                                  or media_url contains '.jpeg'
                                  or media_url contains '.png'
                                  or media_url contains '.webp'
                                  or media_url contains '.gif'
                                -%}
                                  {% comment %} image {% endcomment %}
                                  <div class="pswp-gallery-faq" id="photo-enlarge-gallery-faq">
                                    <a data-pswp-width="{{ 1200 }}" data-pswp-height="{{ 1200 }}">
                                      {% render 'responsive-image', image: faq_question_and_answer.answer_media %}
                                    </a>
                                  </div>
                                {%- endif -%}
                              </div>
                            </div>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endfor -%}
                  {%- else -%}
                    <ul data-index="0">
                      {%- for faq_category in categories -%}
                        {%- for faq_question_and_answer in faq_category.column_content.value -%}
                          {% comment %} 只显示前 10 个 {% endcomment %}
                          {%- if faq_all_count < 10 -%}
                            <li>
                              <div class="faq-header flex">
                                <span>{{ faq_question_and_answer.question | escape }}</span>
                                <svg
                                  class="toggle_btn active"
                                  viewBox="0 0 1024 1024"
                                  width="36"
                                  height="36"
                                >
                                  <path d="M512 671.288889L785.066667 398.222222l-56.888889-62.577778L512 551.822222 295.822222 335.644444 233.244444 398.222222z" fill="#1A1A1A" opacity=".6"></path>
                                </svg>
                              </div>
                              <div class="faq-content">
                                <div class="rte">{{ faq_question_and_answer.answer_text | metafield_tag }}</div>
                                <div>
                                  {%- assign media_url = faq_question_and_answer.answer_media | metafield_text -%}
                                  {%- if media_url contains '.mp4' or media_url contains '.mov' -%}
                                    {% comment %} video {% endcomment %}
                                    {% render 'jky-video',
                                      class: 'w-full h-full',
                                      video_url: media_url,
                                      autoplay: false,
                                      loop: false,
                                      controls: true
                                    %}
                                  {%- elsif media_url contains '.jpg'
                                    or media_url contains '.jpeg'
                                    or media_url contains '.png'
                                    or media_url contains '.webp'
                                    or media_url contains '.gif'
                                  -%}
                                    <div class="pswp-gallery-faq" id="photo-enlarge-gallery-faq">
                                      <a data-pswp-width="{{ 1200 }}" data-pswp-height="{{ 1200 }}">
                                        {% render 'responsive-image', image: faq_question_and_answer.answer_media %}
                                      </a>
                                    </div>
                                  {%- endif -%}
                                </div>
                              </div>
                            </li>
                          {%- endif -%}

                          {% comment %} 计数加 1 {% endcomment %}
                          {%- assign faq_all_count = faq_all_count | plus: 1 -%}
                        {%- endfor -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </div>
            {% endif %}
           {% unless settings.enable_faq_schema %}
            <script class="seoai-schema" type="application/ld+json">
              {%- capture faq_list -%}
                {%- assign faq_count = 0 -%}
                {%- for faq_category in categories -%}
                  {%- for faq_question_and_answer in faq_category.column_content.value -%}
                    {%- if faq_count >= 10 -%}{%- break -%}{%- endif -%}
                    {%- if faq_count > 0 -%},{%- endif -%}
                    {
                      "@type": "Question",
                      "name": {{ faq_question_and_answer.question | truncate: 180 | strip_html | strip | json }},
                      "acceptedAnswer": {
                        "@type": "Answer",
                        "text": {{ faq_question_and_answer.answer_text | metafield_tag | truncate: 300 | strip_html | strip | json }}
                      }
                    }
                    {%- assign faq_count = faq_count | plus: 1 -%}
                  {%- endfor -%}
                  {%- if faq_count >= 10 -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
