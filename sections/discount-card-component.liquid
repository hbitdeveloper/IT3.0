{% comment %} 折扣卡介绍组件 {% endcomment %}
{% schema %}
{
  "name": "Discount Card Component",
  "tag": "section",
  "class": "discount-card-component",
  "settings": [
    {
      "type": "html",
      "id": "discountTitle",
      "label": "Discount Title",
      "default": "Spend $1,"
    },
    {
      "type": "html",
      "id": "discountContent",
      "label": "Discount Content",
      "default": "GET UP TO $330 OFF"
    },
    {
      "type": "html",
      "id": "discountIntro",
      "label": "Discount Introduction",
      "default": "Lock in your early-bird disount with only $1 and save up to $330 on the new Solar Generator 2000 Plus Series!    Get Limited Time Deal"
    },
    {
      "type": "text",
      "id": "btnText",
      "label": "Button Text",
      "default": "Claim Early-Bird Deal"
    },
    {
      "type": "url",
      "id": "btnLink",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "pcCardImg",
      "label": "PC Card Image"
    },
    {
      "type": "image_picker",
      "id": "mbCardImg",
      "label": "Mobile Card Image"
    },
    {
      "type": "html",
      "id": "moreDetails",
      "label": "More Details"
    }
  ]
}
{% endschema %}

<div class="discount-card-box layer-container section-container">
  <div class="content-box">
    <div class="card-img">
      <img
        class="pc-img"
        loading="lazy"
        src="{{ section.settings.pcCardImg | image_url: width: 570 }}"
        alt="{{ section.settings.pcCardImg.alt | escape }}"
      >
      <img
        class="mb-img"
        loading="lazy"
        src="{{ section.settings.mbCardImg | image_url: width: 686 }}"
        alt="{{ section.settings.mbCardImg.alt | escape }}"
      >
    </div>
    <div class="card-info">
      {% if section.settings.discountTitle != blank %}
        <div class="title">{{ section.settings.discountTitle }}</div>
      {% endif %}
      {% if section.settings.discountContent != blank %}
        <div class="content">{{ section.settings.discountContent }}</div>
      {% endif %}
      {% if section.settings.discountIntro != blank %}
        <div class="intro">{{ section.settings.discountIntro }}</div>
      {% endif -%}
      {%- if section.settings.btnText != blank %}
        <a href="{{ section.settings.btnLink }}" class="btn-link">
          {{- section.settings.btnText -}}
        </a>
      {%- endif %}
    </div>
  </div>
  {%- if section.settings.moreDetails != blank %}
    <div class="more-details">
      {{ section.settings.moreDetails }}
    </div>
  {%- endif %}
</div>
