{%- style -%}
  .section-keyword-video {
    margin-bottom: 6.3021vw;
    max-width: 75vw;
    margin-left: auto;
    margin-right: auto;
  }

  .section-keyword-video .keyword-video {
    height: 42.1875vw;
    width: 100%;
  }

  .section-keyword-video .section-container {
    width: max-content;
    height: max-content;
  }

  @media screen and (max-width: 768px) {
    .section-keyword-video {
      max-width: 100%;
    }
    .section-container {
      margin: 0;
      max-width: 100%;
    }
    .section-keyword-video .section-container {
      width: max-content;
      height: max-content;
    }
  }
{%- endstyle -%}
<div class="keyword-video" anchor="{{ section.settings.anchor | escape }}">
  {% if section.settings.keyword_video contains 'youtube.com' or section.settings.keyword_video contains 'youtu.be' %}
    <iframe
      width="100%"
      height="100%"
      src="{{ section.settings.keyword_video }}"
      title="{{ section.settings.keyword_video_title }}"
      frameborder="0"
      allow="autoplay;encrypted-media;web-share"
      allowfullscreen
    ></iframe>
  {% else %}
    <video
      class="section-container"
      name="media"
      muted=""
      loop=""
      class="slide-video pc-block"
      src="{{ section.settings.keyword_video }}"
      preload="none"
      poster="{{ section.settings.keyword_video_poster | image_url: width: 1600 }}"
    ></video>
  {% endif %}
</div>
{% schema %}
{
  "name": "Keyword Video",
  "class": "section-keyword-video",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位文案" },
    { "type": "url", "id": "keyword_video", "label": "keyword video" },
    { "type": "image_picker", "id": "keyword_video_poster", "label": "keyword video poster" },
    { "type": "text", "id": "keyword_video_title", "label": "keyword video title" }
  ],
  "presets": [
    {
      "name": "Keyword Video",
      "category": "Keyword"
    }
  ]
}
{% endschema %}
