<div
  {% if section.settings.anchor != blank %}
    anchor-target="{{ section.settings.anchor | escape}}"
  {% endif %}
  style="background-color: {{ section.settings.bg_color | escape | default: '#FFFFFF' }};"
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "通用表格",
  "class": "common-table",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    { "type": "color", "id": "bg_color", "label": "背景颜色", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "product-table"
    }
  ],
  "presets": [
    {
      "name": "通用表格",
      "settings": {},
      "blocks": [
        {
          "type": "product-table",
          "blocks": [
            {
              "type": "_product-table-head",
              "blocks": [
                {
                  "type": "_product-table-head-td",
                  "settings": {
                    "td": "表头Text1"
                  }
                },
                {
                  "type": "_product-table-head-td",
                  "settings": {
                    "td": "表头Text2"
                  }
                }
              ]
            },
            {
              "type": "_product-table-body",
              "blocks": [
                {
                  "type": "_product-table-body-row",
                  "blocks": [
                    {
                      "type": "_product-table-body-td"
                    },
                    {
                      "type": "_product-table-body-td"
                    }
                  ]
                },
                {
                  "type": "_product-table-body-row",
                  "blocks": [
                    {
                      "type": "_product-table-body-td"
                    },
                    {
                      "type": "_product-table-body-td"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
