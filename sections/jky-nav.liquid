{%- assign blocks_nav = section.blocks | where: 'type', "jky_nav" -%}
{%- render 'jky-nav', tabs: blocks_nav, open_trigger: section.settings.open_trigger, trigger_event: section.settings.trigger_event -%}

{% schema %}
  {
    "name": "JKY nav tabs",
    "class": "cal_scroll_target  section-jky-nav",
    "settings": [
      { "type": "header", "content": "数据埋点相关"},
      { "type": "checkbox", "id": "open_trigger", "label": "是否开启埋点", "default": false },
      { "type": "text", "id": "trigger_event", "label": "埋点事件名称" }
    ],
    "blocks": [
      {
          "type": "jky_nav",
          "name": "Nav导航栏",
          "limit": 10,
          "settings": [
            {"type": "text", "id": "title", "label": "导航栏名称"},
            {"type": "text", "id": "anchor", "label": "导航栏锚点"}
        ]
      }
    ]
  }
{% endschema %}
