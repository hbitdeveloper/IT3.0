<link
  rel="stylesheet"
  rel="preload"
  href="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/swiper-bundle.min.css?v=1670922528">
<link href="https://vjs.zencdn.net/7.20.3/video-js.css" rel="stylesheet" />
<script src="https://vjs.zencdn.net/7.20.3/video.min.js"></script>

<style>
  .page-accessories-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #FFFFFF;
  }
  .page-accessories-main video {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .page-accessories-main h2 {
    font-size: 45px;
    font-family: Gilroy-SemiBold, Gilroy;
    font-weight: 600;
    color: #000000;
    line-height: 66px;
    margin-top: 120px;
    max-width: 1200px;
    text-align: center;
    padding: 13px 200px;
    position: relative;
  }
  .page-accessories-main h2::before {
    display: block;
    content: '';
    width: 46px;
    height: 70px;
    background-image: url('https://cdn.shopify.com/s/files/1/0550/0524/9633/files/1_d4621f27-b474-43ea-902e-f00f790cf09b.png?v=1670915016');
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    position: absolute;
    left: 0;
    top: 0;
  }
  .page-accessories-main h2::after {
    display: block;
    content: '';
    width: 61px;
    height: 89px;
    background-image: url('https://cdn.shopify.com/s/files/1/0550/0524/9633/files/2_55109115-cdac-4786-9031-e7168f04d355.png?v=1670915016');
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    position: absolute;
    right: 0;
    bottom: 0;
  }
  @media only screen and (max-width: 768px) {
    .page-accessories-main h2 {
      max-width: calc(100% - 8vw);
      font-size: 4.266666666666667vw;
      font-weight: 500;
      line-height: 6.4vw;
      margin-top: 8.8vw;
      padding: 1.3333333333333333vw 9.066666666666666vw;
    }
    .page-accessories-main h2::before {
      width: 4.8vw;
      height: 7.466666666666667vw;
    }
    .page-accessories-main h2::after {
      width: 6.4vw;
      height: 9.333333333333334vw;
    }
  }
</style>

<div class="page-accessories-main">
    <video
        src="{{section.settings.video_url}}"
        autoplay
        loop
        muted
    ></video>

    <h2>{{section.settings.checkout_title}}</h2>
</div>

{{ 'page-accessories.bundle.js' | asset_url | script_tag }}

{% schema %}
  {
    "name": "Page Accessories main",
    "class": "section-page-accessories",
    "settings": [
      {"type": "url", "id": "video_url", "label": "Video url"},
      {"type": "image_picker", "id": "video_pic", "label": "Mobile Image"},
      {"type": "textarea", "id": "title", "label": "Heading", "default": "JACKERY ACCESSORY"},
      {"type": "textarea","id": "subtitle","label": "Sub title", "default": "Adapters, cables, connectors, carrying case bags- all the Jackery accessories you want are here!"},
      {"type": "textarea", "id": "checkout_title", "label": "Check out title", "default": "Check out the accessories that meet your solat needs"}
    ]
  }
{% endschema %}