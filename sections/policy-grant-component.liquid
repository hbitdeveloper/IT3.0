<div class="policy-grant-container section-container">
    <div class="grant-left">
        {% if section.settings.title != blank%}
            <div class="grant-title grant-text">{{ section.settings.title }}</div>
        {% endif %}
        {% if section.settings.subtitle != blank%}
            <div class="grant-sub grant-text">{{ section.settings.subtitle }}</div>
        {% endif %}
    </div>
    <div class="grant-right">
        {% render 'responsive-image',
                image: section.settings.p_image,
                mimage: section.settings.m_image,
                image_class: 'policy-grant-img'
        %}
    </div>
</div>
{% comment %} policy-grant-component component of photovolatic poicy page {% endcomment %}
{% schema %}
{
  "name": "Policy Grant",
  "tag": "section",
  "class": "section policy-grant-component",
  "settings": [
    {"type": "textarea", "id": "title", "label": "Policy Grant Title", "default": "Regional funding grant "},
    {"type": "textarea", "id": "subtitle", "label": "Policy Grant Subtitle", "default": "In 2023, funding of up to €750 for balcony power plants is available nationwide, across regions and urban areas"},
    {"type": "image_picker", "id": "p_image", "label": "PC Image (540 * 410)"},
    {"type": "image_picker", "id": "m_image", "label": "Mobile Image (680 * 438)"}
  ]
}
{% endschema %}
