{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
  class="blocks-tabs-blocks"
  style="background: {{section.settings.bg_color | default: 'transparent' }};"
>
  <div class="section-padding {{section.settings.page_width}}" style="{{ style }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
  {
    "name": "V-Tabs组件（关联blocks）",
    "class": "section-v-tabs-blocks",
    "tag": "section",
    "settings": [
      { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" }, 
      {
        "type": "select",
        "id": "page_width",
        "options": [
          {
            "value": "section-container",
            "label": "版心/1200px"
          },
          {
            "value": "section-container-lg",
            "label": "大版心/1320px"
          },
          {
            "value": "w-full",
            "label": "铺满/100%"
          }
        ],
        "default": "w-full",
        "label": "组件宽度",
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#FFFFFF" },

      { "type": "header", "content": "PC边距", "visible_if": "{{ settings.customize_vcomponents == true }}" },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "上边距",
        "default": 36,
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "下边距",
        "default": 36,
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      {
        "type": "range",
        "id": "padding_left",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "左边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      {
        "type": "range",
        "id": "padding_right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "右边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },

      { "type": "header", "content": "MB边距", "visible_if": "{{ settings.customize_vcomponents == true }}" },
      {
        "type": "select",
        "id": "mb_padding_type",
        "options": [
          {
            "value": "default",
            "label": "默认"
          },
          {
            "value": "custom",
            "label": "自定义"
          }
        ],
        "default": "default",
        "label": "MB边距",
        "visible_if": "{{ settings.customize_vcomponents == true }}"
      },
      {
        "type": "number",
        "id": "padding_top_mb",
        "label": "上边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true and section.settings.mb_padding_type == 'custom' }}"
      },
      {
        "type": "number",
        "id": "padding_bottom_mb",
        "label": "下边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true and section.settings.mb_padding_type == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding_left_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "左边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true and section.settings.mb_padding_type == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding_right_mb",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "右边距",
        "default": 0,
        "visible_if": "{{ settings.customize_vcomponents == true and section.settings.mb_padding_type == 'custom' }}"
      }
    ],
    "blocks": [{ "type": "v-heading-content" }, { "type": "_tab-wrap" }],
    "presets": [
      {
        "name": "V-Tabs组件（关联blocks）",
        "category": "Tabs",
        "blocks": [
          {
            "type": "v-heading-content",
            "settings": {
              "padding_top": 0,
              "padding_bottom": 32,
              "padding_left": 0,
              "padding_right": 0,
              "radius_1": 0,
              "radius_2": 0,
              "radius_3": 0,
              "radius_4": 0
            },
            "blocks": [
              {
                "type": "_v-heading-content-heading",
                "settings": {
                  "heading": "<p>Jackery Solar</p><p>Generator 3000 Pro</p>",
                  "mb_heading": "<p>Jackery Solar</p><p>Generator 3000 Pro</p>",
                  "padding_top": 0,
                  "padding_bottom": 16,
                  "alignment": "center",
                  "alignment_mb": "left",
                  "text_color": "#1A1A1A"
                }
              },
              {
                "type": "_v-heading-content-subheading",
                "settings": {
                  "heading": "<p>All You Need For Off-grid Living and Blackouts</p>",
                  "mb_heading": "<p>All You Need For Off-grid Living and Blackouts</p>",
                  "padding_top": 0,
                  "padding_bottom": 0,
                  "alignment": "center",
                  "alignment_mb": "left",
                  "text_color": "#666666"
                }
              }
            ]
          },
          {
            "type": "_tab-wrap",
            "blocks": [
              {
                "type": "_tab-item",
                "settings": {
                  "tab_name": "<p>Tab Name 1</p>",
                  "highlight_color": "#fd5000"
                }
              },
              {
                "type": "_tab-item",
                "settings": {
                  "tab_name": "<p>Tab Name 2</p>",
                  "highlight_color": "#fd5000"
                }
              },
              {
                "type": "_tab-item",
                "settings": {
                  "tab_name": "<p>Tab Name 3</p>",
                  "highlight_color": "#fd5000"
                }
              }
            ]
          }
        ]
      }
    ]
  }
{% endschema %}
