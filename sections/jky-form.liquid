
{% style %}
    .newbee-form_{{section.id}}.newbee-form {
        --error: {{section.settings.error_color}};
        --label-col-distance: {{section.settings.label_distance_y}}px;
        --input-border-color: {{section.settings.input_border_color}};
    }

    @media screen and (max-width: 1024px) {
        .newbee-form_{{section.id}}.newbee-form {
            --label-col-distance: {{section.settings.label_distance_y | divided_by: 2}}px;
        }
    }
{% endstyle %}

<jky-form onsubmitcall="{{section.settings.submit_cb}}" jky-form-id="{{section.settings.form_id | handleize}}">
    <form data-action="{{section.settings.action_url}}" data-extras="{{section.settings.extra_params}}">
        <div class="form-container newbee-form section-container newbee-form_{{section.id}}" style="max-width: {{section.settings.form_container_max}}px;padding: {{section.settings.form_container_padding}}px;">
            {% if section.settings.form_title != blank %}
            <h3 class="newbee-form-title">{{section.settings.form_title | escape}}</h3>
            {% endif %}

            {% for block in section.blocks %}
                {% case block.type %}
                    {% comment %} 输入框 {% endcomment %}
                    {% when 'input' %}
                    <div class="form-row flex {% if block.settings.full_line %} full{% else %} half-full{% endif %}">
                        <div
                            class="form-item {% if block.settings.required %} required{% endif %}"
                            data-field="input"
                        >
                            <label for="{{block.settings.value | handleize}}">{{block.settings.key}}</label>
                            <input
                                type="{{block.settings.input_type}}"
                                id="{{block.settings.value | handleize}}"
                                name="{{block.settings.value | handleize}}"
                                placeholder="{% if block.settings.placeholder != blank %}{{block.settings.placeholder}}{% else %}{{block.settings.key}}{% endif %}"
                                data-error="{{block.settings.error | escape}}"
                                data-value="{{block.settings.value | escape}}"
                                data-reg="{{block.settings.reg_rule}}"
                                data-regError="{{block.settings.reg_error | escape}}"
                            />
                        </div>
                    </div>

                    {% comment %} 手机号码输入（带区号和国旗） {% endcomment %}
                    {% when 'phone_input' %}
                    <div class="form-row flex {% if block.settings.full_line %} full{% else %} half-full{% endif %}">
                        <div
                            class="form-item {% if block.settings.required %} required{% endif %}"
                            data-field="phone_input"
                        >
                            {% render "jky-formField-phoneSelect", id: section.id, required: block.settings.required, error_text: block.settings.error, value: block.settings.value, key: block.settings.key %}
                        </div>
                    </div>

                    {% comment %} 多选（数量） {% endcomment %}
                    {% when 'open_drop' %}
                    <div class="form-row flex {% if block.settings.full_line %} full{% else %} half-full{% endif %}">
                        <div
                            class="form-item {% if block.settings.required %} required{% endif %}"
                            data-field="open_drop"
                        >
                            {% render "jky-formField-select_open", id: section.id, required: block.settings.required, error_text: block.settings.error, value: block.settings.value, key: block.settings.key, options: block.settings.options, extra_type: block.settings.extra_type, max_height: block.settings.max_height, placeholder:block.settings.placeholder %}
                        </div>
                    </div>

                    {% comment %} 下拉 {% endcomment %}
                    {% when 'dropmenu' %}
                    <div class="form-row flex {% if block.settings.full_line %} full{% else %} half-full{% endif %}">
                        <div
                            class="form-item {% if block.settings.required %} required{% endif %}"
                            data-field="dropmenu"
                        >
                            {% render "jky-formField-menu_drop", id: section.id, required: block.settings.required, error_text: block.settings.error, value: block.settings.value, key: block.settings.key, options: block.settings.options, placeholder: block.settings.placeholder %}
                        </div>
                    </div>

                    {% comment %} 勾选框 {% endcomment %}
                    {% when 'check_box' %}
                    <div style="margin-top: {{block.settings.field_top}}px;" class="form-row form-row_check_box flex {% if block.settings.full_line %} full{% else %} half-full{% endif %}">
                        <div
                            class="form-item {% if block.settings.required %} required{% endif %}"
                            data-field="check_box"
                            data-error="{{block.settings.error}}"
                        >
                            {% render "jky-formField-checkbox", key: block.settings.key, value: block.settings.value %}
                        </div>
                    </div>

                    {% comment %} radio单选 {% endcomment %}
                    {% when 'radio' %}
                    <div class="form-row form-row_radio flex {% if block.settings.full_line %} full{% else %} half-full{% endif %}">
                        <div
                            class="form-item {% if block.settings.required %} required{% endif %}"
                            data-error="{{block.settings.error}}"
                            data-field="radio"
                            data-value="{{block.settings.value}}"
                        >
                            <label for="{{block.settings.value}}">{{block.settings.key | escape}}</label>

                            <div class="radio-list">
                                {% assign optionList = block.settings.options | split: '&&' %}
                                {% for option in optionList %}
                                    {% assign option_item = option | split: ':' %}
                                    <li class="jky-option-item flex">
                                        <label class="radio-label flex items-center">
                                        <input
                                          type="radio"
                                          name="{{block.settings.value | handleize}}"
                                          {% if forloop.index == 1 -%} checked{% endif %}
                                          value="{{option_item[0]}}">
                                            {{option_item[1]}}
                                        </label>
                                    </li>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endcase %}
            {% endfor %}


            <div class="newbee-form_submit flex" style="justify-content: {{section.settings.submit_placement}};">
                {% if section.settings.show_reset == true %}
                <button class="form_reset {{section.settings.reset_button_type}}">{{section.settings.reset_text | escape}}</button>
                {% endif %}
                <button class="form_sub_btn {{section.settings.button_type}}">{{section.settings.submit_text | escape}}</button>
            </div>
        </div>
    </form>
</jky-form>

