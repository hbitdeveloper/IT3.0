
{% style %}
    .index-category {
        --new-main-container: 1440px;
        --category-m: 72px 0;
        --category-p: 0 40px;
        --category-text: 28px;
        --category-text-m: 30px 0 0;
        --category-text-p: 0 0 30px;
        --category-lh: 36px;
        --category-content-mb: 64px;
        --category-content-w: 670px;
        --category-content-img-h: 332px;
        --category-content-img-r: 12px;
        --category-content-svg-hover-w: 30px;
        --category-content-arrow-b: 24px;
        --category-content-arrow-r: 24px;
        --category-content-title: 32px;
        --category-content-title-lh: 40px;
        --category-content-title-mt: 20px;
        --category-hr-mt: 5px;
        margin: var(--category-m);
    }
    .index-category .new-main-container{
        width: var(--new-main-container);
        margin: 0 auto;
    }
    .index-category .category {
        padding: var(--category-p);
    }
    .index-category .category .title {
        color: #1a1a1a;
        line-height: var(--category-lh);
        margin: var(--category-text-m);
        padding: var(--category-text-p);
        overflow: hidden;
    }
    .index-category .category .title span {
        font-size: var(--category-text);
        font-weight: 500;
        display: inline-block;
    }
    .index-category .category .box {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        flex-wrap: wrap;
    }
    .index-category .category .box .content {
        display: block;
        margin-bottom: var(--category-content-mb);
        width: var(--category-content-w);
    }
    .index-category .category .box .content .content-image {
        height: var(--category-content-img-h);
        border-radius: var(--category-content-img-r);
        overflow: hidden;
        cursor: pointer;
        position: relative;
    }
    .index-category .category .box .content .content-image img {
        width: 100%;
        transition: all 0.3s;
        height: 100%;
        object-fit: cover;
        border-radius: var(--category-content-img-r);
    }
    .index-category .category .box .content .content-image img:hover {
        transform: scale(1.03);
    }

    .index-category .category .box .content .content-image .index-arrow {
        --arrow-w: var(--theme-arrow-btn-size,64px);
        --arrow-h: var(--theme-arrow-btn-size,64px);
        --arrow-svg-l: 16px;
        --arrow-svg-hover-l: 16px;
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--arrow-w);
        height: var(--arrow-h);
        border-radius: var(--theme-btn-border-radius,50%);
        background: var(--primary-color);
        transform-origin: center center;
        transform: scale(0);
        transition: all 0.5s cubic-bezier(0.8, 0, 0.2, 1);
        overflow: hidden;
        cursor: pointer;
    }
    .index-category .category .box .content .content-image .index-arrow {
        bottom: var(--category-content-arrow-b);
        right: var(--category-content-arrow-r);
    }
    .index-category .category .box .content .content-image .index-arrow svg {
        width: var(--category-content-svg-hover-w);
        transform: translateX(calc(0px - var(--arrow-w)));
        transition: transform 0.5s cubic-bezier(0.8, 0, 0.2, 1);
        /* left: var(--arrow-svg-l); */
        z-index: 1;
    }
    .index-category .category .box .content .content-image:hover .index-arrow {
        transform: scale(1);
    }
    .index-category .category .box .content .content-image:hover .index-arrow svg {
        transform: translateX(0);
    }
    .index-category .category .box .content .content-title {
        font-weight: 500;
        font-size: var(--category-content-title);
        color: #1a1a1a;
        line-height: var(--category-content-title-lh);
        margin-top: var(--category-content-title-mt);
    }
    .index-category .category hr {
        border: 1px solid #EAEAEA;
        margin-top: var(--category-hr-mt);
    }
    @media screen and (max-width: 1440px) {
        .index-category {
            --new-main-container: 100vw;
            --category-m: 5vw 0;
            --category-p: 0 2.77777778vw;
            --category-text: 1.94444444vw;
            --category-text-m: 2.08333333vw 0 0;
            --category-text-p: 0 0 2.08333333vw;
            --category-lh: 2.5vw;
            --category-content-mb: 4.44444444vw;
            --category-content-w: 46.52777778vw;
            --category-content-img-h: 23.05555556vw;
            --category-content-img-r: 0.83333333vw;
            --category-content-svg-hover-w: 2.08333333vw;
            --category-content-arrow-b: 1.66666667vw;
            --category-content-arrow-r: 1.66666667vw;
            --category-content-title: 2.22222222vw;
            --category-content-title-lh: 2.77777778vw;
            --category-content-title-mt: 1.38888889vw;
            --category-hr-mt: 0.34722222vw;
        }
        .index-arrow {
            --arrow-w: 4.44444444444444vw;
            --arrow-h: 4.44444444444444vw;
            --arrow-svg-l: 1.11111111111111vw;
            --arrow-svg-hover-l: 1.11111111111111vw;
        }
    }
    @media screen and (max-width: 1023.98px) {
        .index-category {
            --new-main-container: 100%;
            --category-m: 19.2vw 0;
            --category-p: 0 6.4vw;
            --category-text: 5.33333333vw;
            --category-lh: 7.46666667vw;
            --category-text-m: 2.08333333vw 0;
            --category-text-p: 0 0 2.08333333vw;
            --category-content-mb: 8.53333333vw;
            --category-content-w: 100%;
            --category-content-img-h: 65.73333333vw;
            --category-content-img-r: 3.2vw;
            --category-content-svg-hover-w: 106666666666667vw;
            --category-content-arrow-b: 2.66666667vw;
            --category-content-arrow-r: 2.66666667vw;
            --category-content-title: 6.4vw;
            --category-content-title-lh: 7.46666667vw;
            --category-content-title-mt: 3.2vw;
            --category-hr-mt: 1.33333333vw;
        }
        .index-category .category .title span {
            animation: none;
        }
        .index-category .category .box {
            display: block;
        }
        .index-category .category .box .content .content-image .index-arrow {
            --arrow-w: 10.6666666666667vw;
            --arrow-h: 10.6666666666667vw;
            transform: scale(1);
        }
        .index-category .category .box .content .content-image .index-arrow svg {
            position: static;
            transform: translateX(0);
        }
        .index-category .category .box .content .content-image:hover .index-arrow {
            transform: scale(1);
        }
        .index-category .category .box .content .content-image:hover .index-arrow svg {
            transform: translateX(0);
        }
    }
{% endstyle %}

{% if section.settings.module_centralize == "1200" %}
    <style>
        .index-category {
            --category-m: 12.8vw 0;
        }
        @media screen and (min-width: 1024px) {
            .index-category {
                --category-m: 5vw 0;
            }
            .index-category .new-main-container{
                zoom: 0.88234;
            }
        }
        @media screen and (min-width: 1440px) {
            .index-category {
                --category-m: 72px 0;
            }
        }
    </style>
{% endif %}

<div class="index-category">
    <div class="new-main-container">
        <div class="category">
            <div class="title"><span class="jky-slideup">{{ section.settings.module_title | escape }}</span></div>
            <div class="box">
                {% for item in section.blocks %}
                    <a
                        data-ga-event="button_clicks"
                        data-ga-action="click"
                        data-ga-params-title="{{ section.settings.module_title | escape }}"
                        data-ga-params-module="{{ item.settings.title | escape }}"
                        data-ga-params-button_name="Image_link"
                        data-ga-params-link="{{ item.settings.url }}"
                        class="content" target="{% if section.settings.new_window %}_blank{% else %}_self{% endif %}" href="{{ item.settings.url }}">
                        <div class="content-image" >
                            {% render 'responsive-image' image: item.settings.pc_image, mimage: item.settings.mb_image, width: 670, mwidth: 654 %}
                            <div class="index-arrow">
                                <svg class="line" width="20" height="15" viewBox="0 0 20 15">
                                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                        <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                            <g transform="translate(672.000000, 286.000000)">
                                                <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                            </g>
                                        </g>
                                    </g>
                                </svg>
                            </div>
                        </div>
                        <div class="content-title line-clamp-2">{{ item.settings.title | escape }}</div>
                    </a>
                {% endfor %}
            </div>
            {% if section.settings.module_centralize == "1440" %}
                <hr>
            {% endif %}
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "首页-品类教育",
        "disabled_on": {
            "templates": ["collection"]
        },
        "settings": [
            {
                "type": "select",
                "id": "module_centralize",
                "label": "模块宽度(必填)",
                "options": [
                    {
                        "value": "1440",
                        "label": "1440px"
                    },
                    {
                        "value": "1200",
                        "label": "1200px"
                    }
                ],
                "default": "1440"
            },
            { "type": "text", "id": "module_title", "label": "模块标题(必填)" },
            { "type": "checkbox", "id": "new_window", "label": "新开标签", "default": true }
        ],
        "blocks": [
            {
                "type": "block",
                "name": "品类教育",
                "settings": [
                    { "type": "text", "id": "title", "label": "标题(必填)" },
                    { "type": "url", "id": "url", "label": "跳转地址(必填)" },
                    { "type": "image_picker", "id": "pc_image", "label": "PC 图片(必填)", "info": "大小: 670*332"},
                    { "type": "image_picker", "id": "mb_image", "label": "MB 图片(必填)", "info": "大小: 654*493" }
                ]
            }
        ],
        "max_blocks": 4,
        "presets": [
            {
                "name": "首页-品类教育",
                "settings": {
                    "module_title": "Shop by Category",
                    "new_window": false
                },
                "blocks": [
                    {
                        "type": "block",
                        "settings": {
                            "title": "Jackery Solar Generator",
                        }

                    }
                ]
            }
        ]
    }
{% endschema %}

