{%- style -%}
  .v5-why-choose-jackery .hover-text ul li,
  .v5-why-choose-jackery .hover-text ol li {
    list-style-type: disc;
  }
  .v5-why-choose-jackery .hover-text ul,
  .v5-why-choose-jackery .hover-text ol {
    padding-left: 1rem;
  }
{%- endstyle -%}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  class="v5-why-choose-jackery section-padding"
  {{ section.shopify_attributes }}
  style="background: {{section.settings.bg_color | default: '#F5F5F3' }};{{style}}"
  {% if section.settings.anchor != blank %}
    anchor-target="{{section.settings.anchor | escape}}"
  {% endif %}
>
  <div class="mx-auto lg:max-w-[82.5rem] max-w-[91.46vw] v5-sg-two">
    <div class="grid lg:gap-6 gap-[0.75rem] lg:grid-cols-3">
      {% for block in section.blocks %}
        {%- if block.settings.title != blank -%}
          <div class="normal-item flex overflow-hidden lg:flex-col lg:border-0 border border-solid border-[#C6C7C8] {% if forloop.first %}lg:col-span-2{% endif %}">
            <div
              class="
                shrink-0 text-white grid place-items-center
                lg:basis-auto
                relative group overflow-hidden
              "
            >
              {% if forloop.first %}
                {%- render 'diff-end-img',
                  pc_img: block.settings.img_pc,
                  mb_img: block.settings.img_mb,
                  class: 'sg-two-img object-cover w-[7.5rem] lg:w-[54.5rem] h-[14.625rem] lg:h-[19.875rem]',
                  pc_img_width: 872,
                  mb_img_width: 120
                -%}

              {%- else -%}
                {%- render 'diff-end-img',
                  pc_img: block.settings.img_pc,
                  mb_img: block.settings.img_mb,
                  class: 'sg-two-img object-cover w-[7.5rem] lg:w-[26.5rem] h-[10rem] lg:h-[19.875rem]',
                  pc_img_width: 424,
                  mb_img_width: 120
                -%}
              {% endif %}

              {% comment %} 蒙层 {% endcomment %}
              <div
                class="
                  absolute inset-0 bg-black/50
                  opacity-0 lg:group-hover:opacity-100
                  transition-opacity duration-300
                "
              ></div>

              {% comment %} hover文案 {% endcomment %}
              <div
                class=" 
                  hover-text absolute left-1/2 top-1/2
                  -translate-x-1/2 -translate-y-1/2
                  text-[0.875rem] leading-[1.375]
                  opacity-0 lg:group-hover:opacity-100
                  transition-opacity duration-300
                  z-10{% if forloop.first %} text-left lg:w-[34.5rem] lg:-translate-x-0 lg:left-[2rem]{%- else -%}text-center lg:w-[20rem]{% endif %}
                "
              >
                {{ block.settings.tip }}
              </div>
            </div>
            <div class="py-[0.85rem] px-[0.8125rem] lg:p-[1.5rem] lg:bg-[#F5F5F5] bg-white flex-1">
              {% if block.settings.number != blank %}
                <div
                  class="text-[#242F20] font-semibold lg:text-[1.5rem] text-[1rem] grid lg:mb-[2.5rem] mb-[1rem]"
                >
                  {{ block.settings.number }}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="font-semibold text-[#242F20] lg:text-[1.25rem] text-[0.875rem]">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              <ul class="lg:mt-[1rem] mt-[0.75rem] space-y-2 {% if forloop.first %}grid lg:grid-cols-2{% endif %}">
                {%- if block.settings.one != blank -%}
                  <li class="flex items-center lg:text-sm text-[0.75rem] text-[rgba(36, 47, 32, 0.9)] leading-none">
                    <div class="icon-box mr-2 inline-block lg:h-[2rem] lg:w-[2rem] w-6 h-6 shrink-0">
                      {%- if block.settings.icon_1 != blank -%}
                        <img
                          src="{{ block.settings.icon_1 | image_url: width: 64 }}"
                          alt="{{ block.settings.icon_1.alt }}"
                          class="lg:h-[2rem] lg:w-[2rem] w-6 h-6 object-contain"
                        >
                      {%- endif -%}
                    </div>
                    {{ block.settings.one }}
                  </li>
                {%- endif -%}
                {%- if block.settings.two != blank -%}
                  <li class="flex items-center lg:text-sm text-[0.75rem] text-[rgba(36, 47, 32, 0.9)] leading-none">
                    <div class="icon-box mr-2 inline-block lg:h-[2rem] lg:w-[2rem] w-6 h-6 shrink-0">
                      {%- if block.settings.icon_2 != blank -%}
                        <img
                          src="{{ block.settings.icon_2 | image_url: width: 64 }}"
                          alt="{{ block.settings.icon_2.alt }}"
                          class="lg:h-[2rem] lg:w-[2rem] w-6 h-6 object-contain"
                        >
                      {%- endif -%}
                    </div>
                    {{ block.settings.two }}
                  </li>
                {%- endif -%}

                {% if forloop.first %}
                  {%- if block.settings.three != blank -%}
                    <li class="flex items-center lg:text-sm text-[0.75rem] text-[rgba(36, 47, 32, 0.9)] leading-1 leading-none">
                      <div class="icon-box mr-2 inline-block lg:h-[2rem] lg:w-[2rem] w-6 h-6 shrink-0">
                        {%- if block.settings.icon_3 != blank -%}
                          <img
                            src="{{ block.settings.icon_3 | image_url: width: 64 }}"
                            alt="{{ block.settings.icon_3.alt }}"
                            class="lg:h-[2rem] lg:w-[2rem] w-6 h-6 object-contain"
                          >
                        {%- endif -%}
                      </div>
                      {{ block.settings.three }}
                    </li>
                  {%- endif -%}

                  {%- if block.settings.four != blank -%}
                    <li class="flex items-center lg:text-sm text-[0.75rem] text-[rgba(36, 47, 32, 0.9)] leading-none">
                      <div class="icon-box mr-2 inline-block lg:h-[2rem] lg:w-[2rem] w-6 h-6 shrink-0">
                        {%- if block.settings.icon_4 != blank -%}
                          <img
                            src="{{ block.settings.icon_4 | image_url: width: 64 }}"
                            alt="{{ block.settings.icon_4.alt }}"
                            class="lg:h-[2rem] lg:w-[2rem] w-6 h-6 object-contain"
                          >
                        {%- endif -%}
                      </div>
                      {{ block.settings.four }}
                    </li>
                  {%- endif -%}
                {%- endif -%}
              </ul>
            </div>
          </div>
        {%- endif -%}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "V5-Why-Choose-JKY(PPS/SP)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    { "type": "color_background", "id": "bg_color", "label": "版块背景色", "default": "#F5F5F3" },
    { "type": "header", "content": "PC边距" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0
    },
    { "type": "header", "content": "MB边距" },
    {
      "type": "select",
      "id": "mb_padding_type",
      "label": "MB边距",
      "options": [
        { "value": "default", "label": "与PC一致" },
        { "value": "custom", "label": "单独配置" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 64,
      "visible_if": "{{section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 64,
      "visible_if": "{{section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0,
      "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0,
      "visible_if": "{{ section.settings.mb_padding_type == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "图文",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "图文布局",
          "default": "top",
          "options": [
            { "value": "top", "label": "上图下文" },
            { "value": "bottom", "label": "下图上文" }
          ]
        },
        { "type": "text", "id": "number", "label": "数字序号" },
        { "type": "text", "id": "title", "label": "图文标题" },
        { "type": "text", "id": "one", "label": "图文描述一" },
        { "type": "text", "id": "two", "label": "图文描述二" },
        { "type": "text", "id": "three", "label": "图文描述三" },
        { "type": "text", "id": "four", "label": "图文描述四" },
        { "type": "image_picker", "id": "icon_1", "label": "icon1", "info": "图片推荐尺寸：32*32" },
        { "type": "image_picker", "id": "icon_2", "label": "icon2", "info": "图片推荐尺寸：32*32" },
        { "type": "image_picker", "id": "icon_3", "label": "icon3", "info": "图片推荐尺寸：32*32" },
        { "type": "image_picker", "id": "icon_4", "label": "icon4", "info": "图片推荐尺寸：32*32" },
        { "type": "image_picker", "id": "img_pc", "label": "封面图PC", "info": "图片推荐尺寸：424*318(大图872 *318)" },
        { "type": "image_picker", "id": "img_mb", "label": "封面图MB", "info": "图片推荐尺寸：120 *160(大图120 *234)" },
        { "type": "richtext", "id": "tip", "label": "hover文案" }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5-Why-Choose-JKY(PPS/SP)",
      "category": "内容展示",
      "settings": {}
    }
  ]
}
{% endschema %}
