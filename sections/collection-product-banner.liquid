{% comment %} Product Banner {% endcomment %}
<div id="products-list" class="relative">
    <div class="w-full h-800 lg:j-h-800">
        {% comment %} image {% endcomment %}
        {%-liquid
            assign is_lcp = false
            if section.index < 2
                assign is_lcp = true
            endif
        -%}
        {%- 
            render 'responsive-image', 
            image: section.settings.product_banner_img, 
            mimage: section.settings.m_product_banner_img,
            fcp: is_lcp,
            image_class: "object-cover w-full"
        -%}
    </div>
    <div class="w-full lg:j-w-1200 h-auto flex flex-col items-center absolute left-1/2 -translate-x-1/2 top-120 lg:j-top-40 px-60 lg:j-px-60 z-1">
        <h2 class="text-45 leading-66 lg:j-text-40 lg:j-leading-48 font-600 text-center text-black">{{section.settings.banner_title | newline_to_br}}</h2>
        <h4 class="text-28 leading-36 lg:j-text-24 lg:j-leading-36 font-600 text-center text-black mt-20 lg:j-mt-20">{{section.settings.banner_sub_title | newline_to_br}}</h4>
        <p class="text-24 leading-36 lg:j-text-18 lg:j-leading-27 font-300 text-sub text-center mt-20 lg:j-mt-10">{{section.settings.banner_details | newline_to_br}}</p>
    </div>
</div>

{% schema %}
    {
        "name": "Product Banner",
        "class": "section section-collection-product-banner section-sp-pps-sg-collection",
        "settings": [
            {"type": "textarea", "id": "banner_title", "label": "Product Banner Title"},
            {"type": "textarea", "id": "banner_sub_title", "label": "Product Banner Sub Title"},
            {"type": "textarea", "id": "banner_details", "label": "Product Banner Details"},
            {"type": "image_picker", "id": "product_banner_img", "label": "Introduc Product Banner"},
            {"type": "image_picker", "id": "m_product_banner_img", "label": "Mobile Introduc Product Banner"}
        ]
    }
{% endschema %}
