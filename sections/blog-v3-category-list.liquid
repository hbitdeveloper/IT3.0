{% comment %}
    @description: 博客分类标签列表
{% endcomment %}

{% style %}
    .category-list .intro a{ text-decoration: underline; }
{% endstyle %}

<div class="category-list">
    {%- assign container_class = 'lg:w-[66.75rem] w-[20.4375rem] mx-auto' -%}
    <div class="border-b-[rgba(0,0,0,0.07)] border-b-[1px] border-solid bread-crumbs">
        <div class="{{ container_class }}">
            {% render 'bread-crumbs', is_show_home: true, str: section.settings.title | escape%}
        </div>
    </div>
    <div class="bg-[#F5F5F5] py-6 lg:py-8 ">
        <div class="{{ container_class }}">
            <h1 class="text-[#1a1a1a] font-medium text-[2rem] leading-[2.5rem] -tracking-[0.04rem] mb-2 lg:mb-4 lg:text-[3rem] lg:leading-[3.5rem] lg:-tracking-[0.06rem]">{{ section.settings.title | escape}}</h1>
            {%- if section.settings.intro != blank -%}
                <div class="text-[#666666] font-normal text-[0.8125rem] leading-[1.3125rem] lg:text-[0.875rem] lg:leading-[1.375rem] intro">{{ section.settings.intro | replace: '<em>', '<em style="color: var(--jds-color-primary);">' }}</div>
            {%- endif -%}
        </div>
    </div>
    <div class="category-content">
        <div class="{{ container_class }}">
            <div class="block lg:grid lg:my-[2.5rem] lg:grid-cols-3 lg:gap-x-[3rem] lg:gap-y-[2.5rem]">
                {%- for link in section.settings.list.links -%}
                    {% assign blog = link.object %}
                    <div class="my-[2rem] lg:my-0">
                        <div class="pb-[0.5rem] lg:pb-[0.75rem] border-solid border-b-[0.125rem] border-[rgba(0,0,0,0.07)] category-blog-title">
                            <a
                                class="line-clamp-1 text-[1.125rem] font-semibold leading-[1.625rem] text-[#000000] lg:text-[#171717]"
                                href="{{ blog.url }}" {% if section.settings.new_window %}target="_blank"{% endif %}
                                aria-label="{{ blog.title | escape }}"
                                data-ga-event="blogs_collection_user_clicks"
                                data-ga-action="click"
                                data-ga-params-module="{{ section.settings.title | escape }}"
                                data-ga-params-position="{{ blog.title | escape }}"
                                data-ga-params-link="{{ request.origin | append: blog.url }}"
                            >{{ blog.title | escape }}</a>
                        </div>
                        <ul>
                            {%- for tag in blog.all_tags -%}
                                {%- assign handle = tag | handle -%}
                                {%- assign tag_url = blog.url | append: '/tagged/' | append: handle -%}
                                <li class="pt-[1rem] pb-[0.625rem] border-0 border-solid border-b-[1px] border-[rgba(0,0,0,0.07)] category-blog-tag-title">
                                    <a
                                        class="line-clamp-1 font-normal text-[#666666] leading-[1.25rem]"
                                        href="{{ tag_url }}" {% if section.settings.new_window %}target="_blank"{% endif %}
                                        aria-label="{{ tag | escape }}"
                                        data-ga-event="blogs_collection_user_clicks"
                                        data-ga-action="click"
                                        data-ga-params-module="{{ section.settings.title | escape }}"
                                        data-ga-params-position="{{ blog.title | escape }}"
                                        data-ga-params-button_name="{{ tag }} "
                                        data-ga-params-link="{{ request.origin | append: tag_url }}"
                                    > {{ tag }} </a>
                                </li>
                            {%- endfor -%}
                        </ul>
                    </div>
                {%- endfor -%}
            </div>
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "分类标签列表",
        "settings": [
            { "type": "text", "id": "title", "label": "分类名称", "default": "Category List" },
            { "type": "richtext", "id": "intro", "label": "介绍文案", "default": "<p></p>" },
            { "type": "link_list", "id": "list", "label": "博客列表" },
            { "type": "checkbox", "id": "new_window", "label": "新开标签页", "default": false }
        ]
    }
{% endschema %}
