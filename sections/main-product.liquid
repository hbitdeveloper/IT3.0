                    {% break %}
                  {%- endif -%}
                {% endfor %}
              {% endif %}
            <dd>
              <input type="radio" {% if variant.id == product.selected_or_first_available_variant.id %} checked="checked"{% endif %} value="{{ variant.id }}" data-index="option{{ forloop.index0 }}" name="id" id="{{ variant.title | handleize }}" data-full-gift-obj={{ variant.metafields.custom.full_gift_list.value | json }} money="{{variant.price | money}}">
              <label for="{{ variant.title | handleize }}"{% unless variant.available %} class="disabled"{% endunless %} data-product-label="{{ variant.id }}" data-price="{{ variant.price }}" data-product-media="{{variant.featured_media.position}}" ppp="{{info}}">
                <span class='goods-title'>{{ variant.title | escape }}</span>
                <i class='goods-price'>{% if variant.available %}{{ variant.price | money }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</i>
              </label>
            </dd>
          {% endfor %}
        </dl>

        {%- unless settings.hide_cart_icon or template == 'product.nosale' -%}
