              {%- endif -%}
            {% else %}
              <div class="buy-it-now-action {% if settings.hide_buynow == true or section.settings.hide_buy_now == true %}!hidden{% endif %}" name="buy-it-now" style="display: {%- if current_full_gift -%} none {% else %} flex {%- endif -%};">
                {{ form | payment_button }}
              </div>
            {% endif %}
          </div>

        {%- endunless -%}
      {% endform %}

    {%- unless settings.hide_cart_icon -%}
