{%- liquid
  assign payment_icon_list = shop.metaobjects.payment_icon_list.values
  assign first_icon_list = payment_icon_list | first
  assign section_position = first_icon_list.section_position
  assign pc_pay_position = section.settings.pc_pay_position

  assign position = 'left'
  if section.settings.is_show_new_pay == true
    if pc_pay_position == 'left' or pc_pay_position == 'right'
      assign position = pc_pay_position
    endif
  elsif section_position == 'left' or section_position == 'right'
    assign position = section_position
  endif
  assign credential_a = section.settings.credential_a
  assign credential_b = section.settings.credential_b
  assign credential_c = section.settings.credential_c
  assign credential_d = section.settings.credential_d
  assign has_credential = false
  if credential_a != blank or credential_b != blank or credential_c != blank or credential_d != blank
    assign has_credential = true
  endif
  assign warranty_enable = first_icon_list.warranty_enable | default: true, allow_false: true
  assign pay_enable = first_icon_list.pay_enable | default: true, allow_false: true
  assign both_enable = true
  if warranty_enable == false and pay_enable == false and has_credential == false
    assign both_enable = false
  endif
-%}

{% comment %}
  defind circuit changer: shortage / current product defulat variant / preorder
{% endcomment %}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- if current_variant == blank and product.variants[0] != blank -%}
  {%- assign current_variant = product.variants[0] -%}
{%- endif -%}
{%- liquid
  assign shortage = false
  assign preorderCart_flag = false

  if settings.enable_shortage_reminds == true and current_variant.inventory_quantity <= 0
    assign shortage = true
  endif

  if current_variant.available == true and current_variant.inventory_quantity <= 0
    assign preorderCart_flag = true
  endif
-%}

{%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}

{%- if first_3d_model != blank -%}
  {% assign model_url = '' %}
  {% assign model_preview_image = first_3d_model.preview_image %}
  {% for model_source in first_3d_model.sources %}
    {% if model_source.format == 'glb' %}
      {% assign model_url = model_source.url %}
    {% endif %}
  {% endfor %}
{%- endif -%}
{%- if product.metafields.custom.modals_list.value != blank -%}
  {%- assign first_3d_model = product.metafields.custom.modals_list.value | first -%}
  {% assign model_url = first_3d_model.url %}
  {% assign model_preview_image = first_3d_model.preview_image %}
{%- endif -%}

<div data-version="v3" class="layer-container flex product-main-block" data-price="{{current_variant.price}}" data-id="{{current_variant.id}}" data-goodsId="{{ product.id }}" data-section-id="{{ section.id }}" data-url="{{ product.url }}">
  {% comment %} product images and credential {% endcomment %}
  <figure class="gallery relative">
    {% comment %} 面包屑 {% endcomment %}
    {%- render 'pdp-breadcrumbs', class: 'text-sm max-w-[21.4375rem] mx-auto my-4 lg:max-w-max lg:my-0 lg:absolute left-0 lg:-top-10' -%}

    <div class="pswp-gallery" id="photo-enlarge-gallery">
      <div class="swiper photo">
        <div class="swiper-wrapper">
          {%- for image in product.media -%}
            {%- if image.media_type == "image" -%}
              {% assign image_variant = image.preview_image.variants | first %}
              {% assign image_url = image.src | image_url: width: 3840 %}
              <div class="swiper-slide relative" data-id="{{ image.id }}" data-index="{{ forloop.index0 }}" data-media="{{image.position}}">
                <a href="{{ image_url }}" data-pswp-width="{{ image.preview_image.width | default: 1800 }}" data-pswp-height="{{ image.preview_image.height | default: 1800 }}">
                  {% render 'responsive-image', image: image, width: 580, mwidth: 345 %}

                  {% assign matched_variant = nil %}

                  {% comment %} 直接查找匹配的变体，避免嵌套循环 {% endcomment %}
                  {% if product.variants[0].title != 'Default Title' %}
                    {% for variant in product.variants %}
                      {% if variant.featured_media and variant.featured_media.position == image.position %}
                        {% assign matched_variant = variant %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}

                  {% comment %} 优化变体标签渲染逻辑 {% endcomment %}
                  {% if product.variants[0].title == 'Default Title' %}
                    {% if forloop.index0 == 0  %}
                      {% render 'product-tag', product: product, variant: current_variant %}
                    {% endif %}
                  {% else %}
                    {% if forloop.index0 == 0 %}
                      {% if matched_variant %}
                        {% render 'product-tag', product: product, variant: matched_variant %}
                      {% else %}
                        {% render 'product-tag', product: product, variant: current_variant %}
                      {% endif %}
                    {% elsif matched_variant %}
                      {% render 'product-tag', product: product, variant: matched_variant %}
                    {% endif %}
                  {% endif %}
                </a>
              </div>
            {%- endif -%}
          {% endfor %}
          {% comment %} 3d 模型渲染 {% endcomment %}
          {%- if first_3d_model -%}
            <div class="swiper-slide relative">
              {%- if first_3d_model -%}
                {%- assign modals = product.media | where: 'media_type', 'model' -%}
                {%- if product.metafields.custom.modals.value != blank -%}
                {%- assign modals = product.metafields.custom.modals.value -%}
                {%- endif -%}
                <script type="application/json" id="ProductJSON-{{ product.id }}">
                  {{ modals | json }}
                </script>
              {%- endif -%}
              {%- render "jky-3dmodal", url: model_url, preview_image: model_preview_image -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- assign thumbs_media_count = product.media | where: 'media_type', 'image' | size -%}
      {%- if first_3d_model -%}
        {%- assign thumbs_media_count = thumbs_media_count | plus: 1 -%}
      {%- endif -%}
      <div class="thumbs">
        <div class="swiper-button-next"></div>
        <div class="swiper">
          <div class="swiper-wrapper {% if thumbs_media_count > 4 %}lg:justify-start{% else %}lg:justify-center{% endif %}">
            {%- for image in product.media -%}
              {%- if image.media_type == "image" -%}
                <div class="swiper-slide">
                  {% render 'responsive-image', image: image, width: 72, mwidth: 72 %}
                </div>
              {%- endif -%}
            {% endfor %}
            {% comment %} 3d 模型缩略图 {% endcomment %}
            {%- if first_3d_model -%}
              <div class="swiper-slide relative">
                <svg style="height: 70px;width: 70px;top: 55%;z-index: 2;transform:translate(-50%, -50%);" class="icon-3d-model absolute rounded-md left-1/2" width="72" height="72" viewBox="0 0 72 72">
                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                        <g transform="translate(-817.000000, -1020.000000)">
                            <g transform="translate(817.000000, 1020.000000)">
                                <path d="M0,0 L72,0 L72,72 L0,72 Z"></path>
                                <circle stroke="#666666" stroke-width="0.54" fill="#FFFFFF" cx="35.5" cy="35.5" r="22.23"></circle>
                                <path d="M36.2300027,25 L36.3563621,25.0567573 L46,29.3259845 L45.9803211,29.7634068 L45.9803211,41.4379196 L35.5561885,47 L26,42.075329 L26,29.7634068 L26.4344899,29.519742 L26.6742621,29.3964418 L35.9948914,25.0689894 L36.2300027,25 Z M27.0922095,31.0743922 L27.0918868,41.5299833 L35.5658136,45.8975189 L35.5659683,35.1123244 C34.711537,34.7479051 31.8869507,33.4019277 27.0922095,31.0743922 Z M36.1579218,26.1056481 L27.9718618,29.9508371 L27.506,30.179 L36.138,34.426 L44.8050749,29.9508371 L36.1579218,26.1056481 Z" fill="#1A1A1A" fill-rule="nonzero"></path>
                            </g>
                        </g>
                    </g>
                </svg>

                {% render 'responsive-image', image: first_3d_model.preview_image, width: 72, mwidth: 72 %}
              </div>
            {%- endif -%}
          </div>
        </div>
        <div class="swiper-button-prev"></div>
      </div>

      {% comment %} pc左边 {% endcomment %}
      {%- if position == 'left' -%}
        <figcaption class="credential pc">

         {%- if has_credential == true -%}
           {% if credential_a != blank %}
          <p>
            {% render 'responsive-image', image: section.settings.credential_a_icon, width: 50, mwidth: 1 %}
            <span class="jky-text-xs">{{ credential_a }}</span>
          </p>
        {% endif %}
        {% if credential_b != blank %}
          <p>
            {% render 'responsive-image', image: section.settings.credential_b_icon, width: 50, mwidth: 1 %}
            <span class="jky-text-xs">{{credential_b}}</span>
          </p>
        {% endif %}
        {% if credential_c != blank %}
          <p>
            {% render 'responsive-image', image: section.settings.credential_c_icon, width: 50, mwidth: 1 %}
            <span class="jky-text-xs">{{ credential_c }}</span>
          </p>
        {% endif %}
        {% if credential_d != blank %}
          <p>
            {% render 'responsive-image', image: section.settings.credential_d_icon, width: 50, mwidth: 1 %}
            <span class="jky-text-xs">{{ credential_d }}</span>
          </p>
        {% endif %}
          {%- else -%}
            {%- if warranty_enable -%}
             {% for item in first_icon_list.warranty_list.value %}
              {% if item.title != blank %}
                 <p>
                  {% render 'responsive-image', image: item.icon %}
                  <span class="text-xs">{{ item.title }}</span>
                </p>
              {%- endif -%}
            {% endfor %}
            {%- endif -%}
          {%- endif -%}

        </figcaption>
        {% if first_icon_list.pay_enable %}
          <div class="total-icon-box">
              {%- if first_icon_list.total_icon != blank -%}
                <img src="{{first_icon_list.total_icon | image_url: width: 80}}" alt="{{first_icon_list.total_icon.alt | escape}}" width="24" height="24" loading="lazy">
              {%- endif -%}
