          const PhotoSwipeLightbox = module.default;
          ensurePhotoSwipeStyle()

          const options = {
            gallery: "#photo-enlarge-gallery",
            arrowPrevSVG: leftArrowSVGString,
            arrowNextSVG: rightArrowSVGString,
            closeSVG: closeSVGString,
            children: "a",
            wheelToZoom: true,
            zoom: false,
            padding: {
              top: 32, bottom: 184, left: 0, right: 0
            },
            counter: false,
            bgOpacity: 1,
            pswpModule: () => import('{{ photoswipe }}'),
          };

          const lightbox = new PhotoSwipeLightbox(options);

          lightbox.on("uiRegister", function () {
            lightbox.pswp.ui.registerElement({
              name: "bulletsIndicator",
              className: "pswp__bullets-indicator",
              appendTo: "wrapper",
              onInit: (el, pswp) => {
                const bullets = [];
                let prevIndex = -1;

                const anchorTags = galleryRoot.querySelectorAll('a');
                const imageUrls = [];
                anchorTags.forEach(function (anchorTag) {
                  const imgElement = anchorTag.querySelector('img');
                  if (imgElement) {
                    imageUrls.push(imgElement.getAttribute('src'));
                  }
                });

                for (let i = 0; i < pswp.getNumItems(); i++) {
                  let bullet = document.createElement("div");
                  bullet.className = "pswp__bullet";
                  bullet.setAttribute('data-index', i);

                  bullet.onclick = () => {
                    const index = parseInt(bullet.getAttribute('data-index'), 10);
                    pswp.goTo(index);
                  };

                  let imgElementDOM = document.createElement('img');
                  imgElementDOM.setAttribute('src', imageUrls[i]);
                  imgElementDOM.setAttribute('alt', 'Dynamic Image');
                  bullet.appendChild(imgElementDOM);

                  el.appendChild(bullet);
                  bullets.push(bullet);
                }

                pswp.on("change", () => {
                  if (prevIndex >= 0) {
                    bullets[prevIndex].classList.remove("pswp__bullet--active");
                  }
                  bullets[pswp.currIndex].classList.add("pswp__bullet--active");
                  prevIndex = pswp.currIndex;
                  const activeBullet = bullets[pswp.currIndex];

                  const parentContainer = activeBullet?.parentNode;
                  if (!parentContainer || parentContainer.nodeType !== 1) return;
                  const containerEl = parentContainer;
                  const maxScrollLeft = Math.max(0, containerEl.scrollWidth - containerEl.clientWidth);
                  const targetScrollLeft = activeBullet.offsetLeft - (containerEl.clientWidth - activeBullet.clientWidth) / 2;
                  const nextLeft = Math.max(0, Math.min(targetScrollLeft, maxScrollLeft));
                  containerEl.scrollTo({ left: nextLeft, behavior: 'smooth' });
                });
              },
            });
          });
          lightbox.on('openingAnimationStart',() => {
            let pswpBullets = document.querySelector('.pswp__bullets-indicator');
            if (!pswpBullets) return
            let pswpBulletsWidth = pswpBullets.offsetWidth;
            let pswpBulletList = pswpBullets.querySelectorAll('.pswp__bullet');
            if (!pswpBulletList.length) return
            let pswpBulletListALLWidth = pswpBulletList[0].offsetWidth * pswpBulletList.length;
            pswpBullets.style.justifyContent = pswpBulletListALLWidth > pswpBulletsWidth ? 'flex-start' : 'center';
          })
          lightbox.init();
          lightboxInstance = lightbox
          return lightbox
        }).catch((error) => {
          console.error('Error loading PhotoSwipeLightbox:', error);
          throw error
        });
      }

      return lightboxPromise
    }

    galleryRoot.addEventListener('click', async (event) => {
      const anchor = event.target.closest('a')
      if (!anchor || replayClick) return
      if (lightboxInstance) return

      event.preventDefault()

      try {
        await ensureLightbox()
        replayClick = true
        requestAnimationFrame(() => {
          anchor.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }))
          replayClick = false
        })
      } catch (error) {
        replayClick = false
      }
    }, true)
  }
</script>

<script defer>
  const initMainProductEvents = function() {
    const mainProduct = new MainProduct({
      propertiesWarranty: "properties[{{ properties_warranty_key }}]",
      warrantyContent: "{{ properties_warranty }}",
      currentVariant: {
        "id": {{ current_variant.id | json }},
        "sku": {{ current_variant.sku | json }},
        "availability": {{ current_variant.available | json }},
        "price": "{{ current_variant.price | money }}",
        "price_nomoney": "{{ current_variant.price }}",
        "compare_at_price": "{{ current_variant.compare_at_price | money }}",
        "compare_at_price_nomoney": "{{ current_variant.compare_at_price }}",
        "title": "{{ current_variant.title | escape }}",
        "media_id": "{{ current_variant.featured_media.position }}",
        "inventory_quantity": "{{current_variant.inventory_quantity}}",
        "full_gift_obj": {{ current_variant.metafields.custom.full_gift_list.value | json }}
      },
      productVariants: {
        {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "id": {{ variant.id | json }},
          "sku": {{ variant.sku | json }},
          "availability": {{ variant.available | json }},
          "price": "{{ variant.price | money }}",
          "price_nomoney": "{{ variant.price }}",
          "price_value": "{{ variant.price | money_without_currency }}",
          "compare_at_price": "{{ variant.compare_at_price | money }}",
          "compare_at_price_nomoney": "{{ variant.compare_at_price }}",
          "title": "{{ variant.title | escape }}",
          "media_id": "{{ variant.featured_media.position }}",
          "inventory_quantity": "{{variant.inventory_quantity}}",
          "full_gift_obj": {{ variant.metafields.custom.full_gift_list.value | json }}
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      },
      copyCodeSuccess: "{{ 'gift_cards.issued.copy_code_success' | t }}",
      addToCart: "{{ 'products.product.add_to_cart' | t }}",
      soldOut: "{{ 'products.product.sold_out' | t }}",
      shortageObj: {
        collection: "{{ product.collections[0].title }}",
        success: "{{ section.settings.shortage_reminds_success }}",
        error: "{{ section.settings.shortage_reminds_error }}"
      }
    })

    // 注册 jdgm 插件事件
    function registerJdgmPluginEvent() {
      const badge = document.querySelector('.jdgm-prev-badge');
      if (!badge) return;

      if (badge.__jdgmClickHandler) {
        badge.removeEventListener('click', badge.__jdgmClickHandler);
      }

      const handler = function() {
        // 4.0 商详页
        const navliList = document.querySelectorAll('.navli[data-cate]');
        navliList[navliList.length - 1]?.click();

        const tabsList = document.querySelectorAll('.jky-tabs-item[data-cate]');
        tabsList[tabsList.length - 1]?.click();

        // 3.0 商详页
        const reviewTab = document.querySelector('.J-tabs-point li[data-point="reviews"]');
        reviewTab?.click();
      };

      badge.__jdgmClickHandler = handler;
      badge.addEventListener('click', handler);
    }
    // Initial check
    registerJdgmPluginEvent()

    if (document.querySelector('.jdgm-widget').length > 0) {
      new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.type === 'childList') {
            registerJdgmPluginEvent();
          }
        })
      }).observe(document.querySelector('.jdgm-widget'), { childList: true, subtree: true, attributes: true })
    }

    // 购买意向表单 拉起按钮
    if(document.querySelector('.btn-for-pif')){
      document.querySelector('.btn-for-pif').addEventListener('click', function(e) {
        const pifDialog = document.querySelector('.pif-dialog')
      if(pifDialog){
          pifDialog.setAttribute('open', true)

          gaPushDataLayer('form_user_clicks', {
            module: "NormalExpertForm",// 固定模块命名NormalExpertForm
            button_name: e.target.textContent.trim(), // 识别按钮文字text，根据按钮实际文案而定
          });
        }
      })
    }

    {% comment %} 支付标题换行加类名 {% endcomment %}
     if (document.querySelectorAll('.total-icon-box .payment-icon-list-title p').length > 1) {
      document.querySelectorAll('.total-icon-box > img').forEach((img) => {
        img.classList.add('total-icon-center');
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMainProductEvents, { once: true });
  } else {
    initMainProductEvents();
  }
</script>

