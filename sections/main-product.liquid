              {% render 'icon-plus', class: 'icon-operate icon-plus', method: 'plus' %}
            </span>
          </div>
          <div class="add_cart_error_wrapper hidden"></div>

          <hr>
          {% comment %} 捆绑销售, 动态插入产品后，需要调用essential function {% endcomment %}
