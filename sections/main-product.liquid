          {% else %}
            {% assign extended_warranty = 1 %}
          {% endif %}

          {% if product.metafields.my_fields.default_warranty %}
            {% assign default_warranty = product.metafields.my_fields.default_warranty.value | first %}
          {% else %}
            {% assign default_warranty = 2 %}
          {% endif %}

          {% assign total_warranty = default_warranty | plus: extended_warranty %}

          {% capture product_warranty_title %}{{ 'products.product.warranty_title' | t: extended: extended_warranty }}{% endcapture %}
          {% capture properties_warranty %}{{ 'products.product.properties_warranty' | t: total: total_warranty, extended: extended_warranty }}{% endcapture %}
