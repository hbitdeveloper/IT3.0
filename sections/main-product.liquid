      {% endunless %}
    {%- endif -%}

    {% comment %} 标明含税及包邮的提醒导致让客户有所误解，使页面更具合规性及避免用户投诉 {% endcomment %}
    {% if section.settings.product_extra_txt or section.settings.product_extra_link_txt %}
      <div style="margin: 10px 0;">
        {% if section.settings.product_extra_txt != blank %}
          <span>{{ section.settings.product_extra_txt | escape }}</span>
        {% endif %}
        {% if section.settings.product_extra_link_txt != blank %}
          <a style="text-decoration:underline;color:inherit;" href="{{section.settings.product_extra_link}}">{{section.settings.product_extra_link_txt | escape }}</a>
        {% endif %}
      </div>
