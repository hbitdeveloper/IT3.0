          </div>
        {% endif %}
      {%- endif -%}
    </div>
  </figure>

  <div class="meta">
    <h1 class="jky-text-xl font-bold">{{ product.title }}</h1>

    {% comment %} Start of Judge.me code {% endcomment %}
    <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'> {{ product.metafields.judgeme.badge }} </div>
    {% comment %} End of Judge.me code {% endcomment %}
    <br>
    {% comment %} End Areviews Collection Rating Code {% endcomment %}

    <div class="main-product__price_box"{% unless settings.enable_product_schema and product.metafields.schema.config.value.use_new_schema.value == true %} itemprop="offers" itemscope itemtype="http://schema.org/Offer"{% endunless %}>
      <div>
        <b class="price jky-text-xl barnd-color main-producr__price">
          {{ current_variant.price | money }} {% if shop.id == 10015375438 or shop.id == 56124375224 %}<span class="jky-text-sm">(税込)</span>{% endif %}
        </b>
        <span
          data-compare-price
          class="product-price--compare"
          data-show-discount-amount="{{settings.show_discount_amount}}"
          data-discount-amount-format="{{settings.discount_amount_format | escape}}"
        >
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="compare-price {% if shop.id == 10015375438 or shop.id == 56124375224 %} jky-text-xl{% else %} jky-text-sm{% endif %}">{{ current_variant.compare_at_price | money }}</span>
          {% endif %}
        </span>

        {%- if settings.show_discount_amount -%}
          {%- if current_variant.compare_at_price > current_variant.price %}
            {% comment %} <span class="product-price--discount_amount">{{current_variant.compare_at_price | minus: current_variant.price | money}} OFF</span> {% endcomment %}
            <span class="product-price--discount_amount"></span>
          {%- endif -%}
        {%- endif -%}

        {% comment %} product description including tax {% endcomment %}
