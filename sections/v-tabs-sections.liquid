{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

<div
  {% if section.settings.anchor != blank %}anchor-target="{{section.settings.anchor | escape}}"{% endif %}
  class="blocks-tabs-sections"
  style="background: {{section.settings.bg_color | default: 'transparent' }};"
>
  <div class="section-padding {{section.settings.page_width}}" style="{{ style }}">
    {% content_for 'blocks' %}
    <jky-v-tabs-content class="block w-full overflow-x-clip">
      <div class="tab-content-wrap flex flex-nowrap items-start transition-transform duration-300"></div>
    </jky-v-tabs-content>
  </div>
</div>
<script src="{{ 'sections-v-tabs-sections.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "V-Tabs组件（关联sections）",
    "class": "section-v-tabs-sections",
    "tag": "section",
    "settings": [
      {
        "type": "header",
        "content": "功能说明："
      },
      {
        "type": "paragraph",
        "content": "1. 编辑模式下，不将所关联的内容进行收纳到对应Tab下，以方便配置。"
      },
      {
        "type": "paragraph",
        "content": "2. 基础功能：支持配置1个一级导航"
      },
      {
        "type": "paragraph",
        "content": "3. 新增功能：支持配置1个一级导航+多个2级导航的两层导航"
      },
      {
        "type": "header",
        "content": "基础配置"
      },
      { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" }, 
      {
        "type": "select",
        "id": "page_width",
        "options": [
          {
            "value": "section-container",
            "label": "版心/1200px"
          },
          {
            "value": "section-container-lg",
            "label": "大版心/1320px"
          },
          {
            "value": "w-full",
            "label": "铺满/100%"
          }
        ],
        "default": "w-full",
        "label": "组件宽度"
      },
      { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#FFFFFF" },
      { "type": "header", "content": "上下边距" },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "上边距",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "下边距",
        "default": 36
      }
    ],
    "blocks": [{ "type": "v-heading-content" }, { "type": "_tab-navigation" }],
    "presets": [
      {
        "name": "V-Tabs组件（关联sections）",
        "category": "Tabs",
        "blocks": [
          {
            "type": "v-heading-content",
            "settings": {
              "padding_top": 0,
              "padding_bottom": 32,
              "padding_left": 0,
              "padding_right": 0,
              "radius_1": 0,
              "radius_2": 0,
              "radius_3": 0,
              "radius_4": 0
            },
            "blocks": [
              {
                "type": "_v-heading-content-heading",
                "settings": {
                  "heading": "<p>Jackery Solar</p><p>Generator 3000 Pro</p>",
                  "mb_heading": "<p>Jackery Solar</p><p>Generator 3000 Pro</p>",
                  "padding_top": 0,
                  "padding_bottom": 16,
                  "alignment": "center",
                  "alignment_mb": "left",
                  "text_color": "#1A1A1A"
                }
              },
              {
                "type": "_v-heading-content-subheading",
                "settings": {
                  "heading": "<p>All You Need For Off-grid Living and Blackouts</p>",
                  "mb_heading": "<p>All You Need For Off-grid Living and Blackouts</p>",
                  "padding_top": 0,
                  "padding_bottom": 0,
                  "alignment": "center",
                  "alignment_mb": "left",
                  "text_color": "#666666"
                }
              }
            ]
          },
          {
            "type": "_tab-navigation",
            "blocks": [
              {
                "type": "_tab-nav-item",
                "settings": {
                  "tab_name": "<p>Section Group 1</p>",
                  "section_group": "section_group_1"
                }
              },
              {
                "type": "_tab-nav-item",
                "settings": {
                  "tab_name": "<p>Section Group 2</p>",
                  "section_group": "section_group_2"
                }
              },
              {
                "type": "_tab-nav-item",
                "settings": {
                  "tab_name": "<p>Section Group 3</p>",
                  "section_group": "section_group_3"
                }
              }
            ]
          }
        ]
      }
    ]
  }
{% endschema %}
