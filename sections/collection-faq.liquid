<style>
    .section-collection-faq {margin-bottom: -70px;}
    .section-collection-faq .z-button-fill-middle.active {color: var(--primary-color);background: transparent;}
    .section-collection-faq .z-button-fill-middle:hover,
    .section-collection-faq .z-button-fill-middle.active:hover {background: var(--primary-color);color: #fff;}
</style>

{% comment %} FAQ {% endcomment %}
<div class="pb-165 lg:j-pb-160 bg-f5">
    {%- 
        render 'responsive-image', 
        image: section.settings.faq_image, 
        mimage: section.settings.m_faq_image,
        image_class: "w-full object-cover"
    -%}
    
    <div class="w-full px-25 lg:px-0">
        <div class="w-full lg:j-w-1200 mx-auto pt-105 pb-60 lg:j-pt-100 lg:j-pb-90 -mt-120 -lg:j-mt-100 bg-white rounded-30 lg:j-rounded-30 relative">
            <h2 class="w-full text-center text-45 leading-66 lg:j-text-40 lg:j-leading-48 font-600 text-main">{{section.settings.faq_title | newline_to_br}}</h2>
            <ul class="accordion-menu">
                {% for block in section.blocks %}
                    <li class="border-0 border-b-[1px] border-solid border-[#CCC]">
                        <h3 class="dropdownlink text-32 leading-48 lg:j-text-26 lg:j-leading-39 flex justify-between items-center border-none">
                            {{block.settings.faq_title | newline_to_br}}
                            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-3xl lg:text-2xl"></jds-icon>
                        </h3>
                        <ul class="submenuItems pb-40 lg:j-pb-50">
                            <div class="submenu-content text-28 leading-39 lg:j-text-18 lg:j-leading-27">{{block.settings.faq_content | newline_to_br}}</div>
                        </ul>
                    </li>
                {% endfor %} 
            </ul>
            <div
                class="z-button-fill-middle"
                data-more-text="{{ 'general.action_text.view_more' | t }}"
                data-less-text="{{ 'general.action_text.view_less' | t }}"
            >
                <span>{{ 'general.action_text.view_more' | t }}</span>
                <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-3xl lg:text-2xl"></jds-icon>
            </div>
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "FAQ",
        "class": "section section-collection-faq section-sp-pps-sg-collection",
        "settings": [
            {"type": "image_picker", "id": "faq_image", "label": "FAQ PC Banner Image"},
            {"type": "image_picker", "id": "m_faq_image", "label": "FAQ Mobile Banner Image"},
            {"type": "textarea", "id": "faq_title", "label": "FAQ Title", "default": "FAQ"}
        ],
        "blocks": [
            {
                "type": "faq_item",
                "name": "FAQ item",
                "settings": [
                    {"type": "textarea", "id": "faq_title", "label": "FAQ title"},
                    {"type": "textarea", "id": "faq_content", "label": "FAQ Answer"}
                ]
            }
        ]
    }
{% endschema %}
