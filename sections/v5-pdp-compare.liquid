{% comment %} V5 产品对比 {% endcomment %}

{%- capture style -%}
  {% render 'spacing-padding', settings: section.settings %}
{%- endcapture -%}

{%- assign num = 0 -%}
{% for block in section.blocks %}
    {% if block.settings.product != blank%}
        {% assign product = block.settings.product %}
        {% if product.available %}
            {%- assign num = num | plus: 1-%}
        {% endif %}
    {% endif %}
{% endfor %}

<div 
    {{ section.shopify_attributes }}
    class="section-padding section-v5-pdp-compare"
    {% if section.settings.anchor != blank %} anchor-target="{{section.settings.anchor | escape}}" {% endif %} 
    style="background: {{section.settings.bg_color}};{{style}}"
>   
    <v5-pdp-compare data-num="{{ num }}">
        <div class="w-full lg:w-[82rem] mx-auto">
            {% comment %} PC {% endcomment %}
            <div class="hidden lg:flex w-full justify-center gap-x-6">
                {% for block in section.blocks %}
                    {% if block.settings.product != blank%}
                        {% assign product = block.settings.product %}
                        {% if product.available %}
                            {% render 'v5-pdp-compare-product-card', setting: block.settings,  variant_id: block.settings.variant_id, product: product %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            </div>

            {% comment %} MB {% endcomment %}
            <div class="lg:hidden">
                <div class="pl-4 {% if num > 1 %} swiper v5-pdp-compare-swiper {% else %} flex justify-center pr-4 {% endif %}">
                    {% if num > 1 %} <div class="swiper-wrapper">{% endif %}
                        {% for block in section.blocks %}
                            {% if block.settings.product != blank%}
                                {% assign product = block.settings.product %}
                                {% if product.available %}
                                    {% if num > 1 %} <div class="swiper-slide"> {% endif %}
                                        {% render 'v5-pdp-compare-product-card', setting: block.settings,  variant_id: block.settings.variant_id, product: product %}
                                    {% if num > 1 %} </div> {% endif %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    {% if num > 1 %} </div> {% endif %}
                </div>
            </div>
        </div>
    </v5-pdp-compare>
</div>
<script src="{{ 'sections-v5-pdp-compare.js' | asset_url }}" defer></script>
{% schema %}
    {
        "name": "V5-PDP-产品对比",
        "enabled_on": {
            "templates": ["product"]
        },
        "limit": 1,
        "settings": [
            {
                "type": "select",
                "id": "style_type",
                "options": [
                    {
                    "value": "default",
                    "label": "默认"
                    },
                    {
                    "value": "custom",
                    "label": "自定义"
                    }
                ],
                "default": "default",
                "label": "样式类型"
            },
            { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
            { "type": "color_background", "id": "bg_color", "label": "背景颜色", "default": "#F9F7F3" },
            { "type": "header", "content": "PC边距", "visible_if": "{{ section.settings.style_type == 'custom' }}" },
            {
                "type": "range",
                "id": "padding_top",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "上边距",
                "default": 40,
                "visible_if": "{{ section.settings.style_type == 'custom' }}"
            },
            {
                "type": "range",
                "id": "padding_bottom",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "下边距",
                "default": 80,
                "visible_if": "{{ section.settings.style_type == 'custom' }}"
            },
            {
                "type": "range",
                "id": "padding_left",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "左边距",
                "default": 0,
                "visible_if": "{{ section.settings.style_type == 'custom' }}"
            },
            {
                "type": "range",
                "id": "padding_right",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "右边距",
                "default": 0,
                "visible_if": "{{ section.settings.style_type == 'custom' }}"
            },

            { "type": "header", "content": "MB边距", "visible_if": "{{ section.settings.style_type == 'custom' }}" },
            {
                "type": "select",
                "id": "mb_padding_type",
                "options": [
                    {
                    "value": "default",
                    "label": "默认"
                    },
                    {
                    "value": "custom",
                    "label": "自定义"
                    }
                ],
                "default": "custom",
                "label": "MB边距",
                "visible_if": "{{ section.settings.style_type == 'custom' }}"
            },
            {
                "type": "range",
                "id": "padding_top_mb",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "上边距",
                "default": 64,
                "visible_if": "{{ section.settings.style_type == 'custom' and section.settings.mb_padding_type == 'custom' }}"
            },
            {
                "type": "range",
                "id": "padding_bottom_mb",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "下边距",
                "default": 64,
                "visible_if": "{{ section.settings.style_type == 'custom' and section.settings.mb_padding_type == 'custom' }}"
            },
            {
                "type": "range",
                "id": "padding_left_mb",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "左边距",
                "default": 0,
                "visible_if": "{{ section.settings.style_type == 'custom' and section.settings.mb_padding_type == 'custom' }}"
            },
            {
                "type": "range",
                "id": "padding_right_mb",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "右边距",
                "default": 0,
                "visible_if": "{{ section.settings.style_type == 'custom' and section.settings.mb_padding_type == 'custom' }}"
            }
        ],
        "blocks": [
            {
                "type": "product",
                "name": "产品",
                "limit": 4,
                "settings": [
                    { "type": "product", "id": "product", "label": "选择产品" },
                    { "type": "number", "id": "variant_id", "label": "变体ID", "visible_if": "{{ block.settings.product != blank }}" },
                    { "type": "text", "id": "tag", "label": "产品标签", "visible_if": "{{ block.settings.product != blank }}" },
                    { "type": "image_picker", "id": "pc_compare_image", "label": "对比图PC", "visible_if": "{{ block.settings.product != blank }}" },
                    { "type": "image_picker", "id": "mb_compare_image", "label": "对比图MB", "visible_if": "{{ block.settings.product != blank }}" }
                ]
            }
        ],
        "presets": [
            {
                "name": "V5-PDP-产品对比",
                "category": "V5.0"
            }
        ]

    }
{% endschema %}
