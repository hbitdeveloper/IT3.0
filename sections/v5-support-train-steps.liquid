<div class="train-in-container lg:px-0 {{section.settings.page_width}}" data-train-in-steps-container>
  <div class="text-center font-bold text-[#000]  mt-[1.7188rem] text-[1.5rem] lg:text-[3rem] lg:mt-[5.5rem]">
    {{ section.settings.heading }}
  </div>

  <div class="text-[#000]  font-semibold text-left mt-[0.75rem] text-[0.9375rem] leading-[1.125rem] mb-[1.5rem] lg:mt-[1.5rem] lg:text-[1.625rem] lg:leading-[2.25rem] lg:mb-[4.8125rem]">
    {{ section.settings.description }}
  </div>

  <div class="grid gap-5 grid-cols-2 lg:grid-cols-4 lg:mt-[3.125rem]">
    {% for block in section.blocks %}
      {% if block.type == 'step' %}
        <div class="bg-[#F5F5F5] px-[0.9375rem] pt-[1.875rem] pb-[0.9375rem] lg:py-[3.125rem] lg:px-[0.9375rem]" {{ block.shopify_attributes }}>
          <div class="flex items-center justify-center">
            {% if block.settings.icon != blank %}
              <img
                class="w-[3.4375rem] lg:w-[6.875rem]"
                src="{{ block.settings.icon | image_url: width: 220 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {% elsif block.settings.icon_url != blank %}
              <img
                class="w-[3.4375rem] lg:w-[6.875rem]"
                src="{{ block.settings.icon_url }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {% endif %}
          </div>

          <div class="text-left text-[#333]  text-[0.625rem] leading-[0.75rem] mt-[1.5625rem] lg:text-[1.25rem] lg:leading-[1.875rem] lg:mt-[3.125rem]">
            {{ section.settings.step_prefix }}{{ forloop.index }}<br>
            <span class="font-bold text-[0.75rem] lg:text-[1.5rem]">{{ block.settings.title }}</span>
          </div>

          <div class="text-left  text-[0.6875rem] leading-[0.8125rem] mt-[0.8125rem] lg:text-[1.375rem] lg:leading-[1.625rem] lg:mt-[1.25rem]">
            {{ block.settings.text }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.show_button %}
    <div class="flex items-center w-full justify-center py-[0.4667rem] lg:pt-[2.5rem]">
      <button
        type="button"
        class="text-white font-bold cursor-pointer px-[0.8rem] py-[0.5333rem] bg-[#FF5000] lg:text-[1.75rem]  text-[0.8rem] lg:px-[1.5rem] lg:py-[0.625rem]"
        {% if section.settings.open_modal_data_attr %}data-train-in-open{% endif %}
      >
        {{ section.settings.button_text }}
      </button>
    </div>
  {% endif %}
</div>

<style>
  @media (min-width: 1024px) {
    [data-train-in-steps-container] {
      max-width: var(--train-in-steps-container-pc);
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

{% schema %}
{
  "name": "V5 Support Train Steps",
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1312px"
        },
        {
          "value": "w-full",
          "label": "铺满/100%"
        }
      ],
      "default": "section-container",
      "label": "组件宽度"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In Just Four Easy Steps"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Regardless of whether you purchased from Amazon, our official website, or from a third party retailer, you’ll still be eligible for a train in by following the instructions below. From getting an estimate to returning your product, we’ll help every step of the way."
    },
    {
      "type": "text",
      "id": "step_prefix",
      "label": "Step label prefix",
      "default": "Step"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_url",
          "label": "Icon URL (fallback)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fill in Table"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Fill in the questionnaire online and we’ll give you a quote for what your current device is worth."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "V5 Support Train Steps",
      "category": "V5.0 Support",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon_url": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/apply.png?v=1693815666",
            "title": "Fill in Table",
            "text": "Fill in the questionnaire online and we’ll give you a quote for what your current device is worth."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_url": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/ship.png?v=1693815666",
            "title": "Ship",
            "text": "We’ll then send you an email with a shipping label confirmation that you can use to return the product with."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_url": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/tool.png?v=1693815666",
            "title": "Evaluate",
            "text": "The Jackery team will start the product valuation and then send you a final quote."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_url": "https://cdn.shopify.com/s/files/1/0550/0524/9633/files/gift_card.png?v=1693815666",
            "title": "Get your Gift Card",
            "text": "We will send the Jackery Gift Card to your email, which you can use to purchase any Jackery products at any time."
          }
        }
      ]
    }
  ]
}
{% endschema %}
