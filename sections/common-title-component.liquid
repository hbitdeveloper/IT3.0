{% comment %} 通用标题组件 {% endcomment %}
{% schema %}
{
  "name": "Common Title Component",
  "tag": "section",
  "class": "common-title-component",
  "settings": [
    {
      "type": "text",
      "id": "anchorID",
      "label": "Anchor ID"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "html",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "color",
      "id": "bgColor",
      "label": "Background Color"
    }
  ]
}
{% endschema %}
{% comment %} 锚点设置 {% endcomment %}
{% if section.settings.anchorID != blank %}
  <div id="{{ section.settings.anchorID }}" class="anchor-id"></div>
{% endif %}
{% if section.settings.title != blank or section.settings.subtitle != blank %}
	<div class="common-title-box">
		{% if section.settings.title != blank %}
			<h2 class="title">{{ section.settings.title }}</h2>
		{% endif %}
		{% if section.settings.subtitle != blank %}
			<h3 class="subtitle" data-txt="{{ section.settings.subtitle }}"></h3>
		{% endif %}
	</div>
{% endif %}
<style>
  #shopify-section-{{ section.id }}{
    background-color: {{ section.settings.bgColor }};
  }
</style>
