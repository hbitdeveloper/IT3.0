{%- if block.settings.tab_name != '' or block.settings.tab_name != blank -%}
  {%- assign highlight_text = '<em style="--highlight-color:'
    | append: block.settings.highlight_color
    | append: '">'
  -%}
  <div
    {{ block.shopify_attributes }}
    class="navigation-item shrink-0 flex flex-row items-center cursor-pointer transition-colors duration-300"
    {% if block.settings.anchor != blank %}
      anchor-target="{{ block.settings.anchor | escape }}"
    {% endif %}
    {% if block.settings.handle != blank %}
      data-handle="{{block.settings.handle | escape}}"
    {% endif %}
    {% if block.settings.section_group != blank %}
      data-group-name="{{block.settings.section_group | escape}}"
    {% endif %}
  >
    {% if block.settings.icon_type != blank %}
      <jds-icon class="relative -top-[0.0625rem] lg:-top-[0.125rem] text-[2rem] mr-1.5" name="{{block.settings.icon_type}}"></jds-icon>
    {% endif %}
    {{ block.settings.tab_name | replace: '<em>', highlight_text }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Section组导航项",
  "class": "blocks-navigation-item",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "基础配置"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "info": "用于下一级别Tab绑定。要确保唯一性,禁止空格和-符号。"
    },
    { 
      "type": "text", 
      "id": "section_group", 
      "label": "关联的组件(确保唯一性,禁止空格和-符号)" 
    },
    {
      "type": "header",
      "content": "内容样式"
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "图标类型",
      "options": [
        { "value": "", "label": "无" },
        { "value": "home-line-1", "label": "房屋1" },
        { "value": "home-line-2", "label": "房屋2" },
        { "value": "battery-line", "label": "电池" },
        { "value": "calendar-line", "label": "日历" },
        { "value": "lamp-line", "label": "灯" },
        { "value": "tent-line", "label": "帐篷" },
        { "value": "truck-line-1", "label": "卡车1" },
        { "value": "truck-line-2", "label": "卡车2" }
      ],
      "default": ""
    },
    { "type": "richtext", "id": "tab_name", "label": "Tab Name" },
    { "type": "color", "id": "highlight_color", "label": "文本强调颜色", "default": "#fd5000" }
    
  ],
  "presets": [
    {
      "name": "Section组导航项"
    }
  ]
}
{% endschema %}
