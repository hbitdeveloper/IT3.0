{% doc %} 
    description: 博客聚合页 -- 精选博客文章item
    @param {string} [title] 标题
{% enddoc %}
<div {{ block.shopify_attributes }}>
    <div>
        {% for i in (1..10) %}
            {% assign setting_key = 'article_' | append: i %}
            {% assign article = block.settings[setting_key] %}
            {% if article != blank %}
                {% render 'article-snippet', article: article, title: title %}
            {% endif %}
        {% endfor %}
    </div>
</div>

{% schema %}
    {
        "name": "V3博客聚合页-精选文章item",
