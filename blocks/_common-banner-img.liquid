      "options": [
        {
          "value": "vertical-top",
          "label": "顶部"
        },
        {
          "value": "vertical-center",
          "label": "中间"
        },
        {
          "value": "vertical-bottom",
          "label": "底部"
        }
      ]
    },
    {
