      "options": [
        {
          "value": "vertical-top-mb",
          "label": "顶部"
        },
        {
          "value": "vertical-center-mb",
          "label": "中间"
        },
        {
          "value": "vertical-bottom-mb",
          "label": "底部"
        }
      ]
    },
