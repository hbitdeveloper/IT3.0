
<p class="font-bold text-[1.3125rem] md:text-[2.8125rem] leading-[1.3]">{{ block.settings.heading_tit }}</p>
<p class="font-normal text-[0.75rem] md:text-[1.375rem] leading-[1.3]">{{ block.settings.heading_desc | replace: '\n', '<br>' | strip }}</p>


{% schema %}
{
	"name": "核心卖点",
  "class": "text-center text-white",
	"settings": [
    {
      "type": "text",
      "id": "heading_tit",
      "label": "标题",
      "default": "1.766 €"
    },
    {
      "type": "text",
      "id": "heading_desc",
      "label": "描述",
      "default": "Jährliche Ersparnis",
      "info": "需要换行，请使用 \\n "
    }
	],
	"presets": [
    {
      "name": "核心卖点"
    }
  ]
}
{% endschema %}