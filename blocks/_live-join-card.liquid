<div class="live-join-card flex flex-col justify-between lg:w-[26.5rem] lg:h-full lg:min-h-[21rem] lg:rounded-[0.75rem] rounded-[0.75rem] w-[21.4375rem] bg-white lg:p-[2rem] pt-[1rem] pr-[0.46875rem] pb-[0.75rem] pl-[0.75rem]">
  <div class="live-join-content lg:mb-[1rem]">
    {% if block.settings.heading != blank %}
      {% assign titleColor = '<em style="color: ' | append: block.settings.active_title_color | append: '">' %}
      <div class="live-join-title jds-h5 lg:font-medium font-semibold line-clamp-3 lg:mb-[0.375rem] mb-[0.5rem]">{{ block.settings.heading | replace: '<em>', titleColor }}</div>
    {% endif %}
    {% if block.settings.sub_heading != blank %}
      {% assign subTitleColor = '<em style="color: ' | append: block.settings.active_sub_color | append: '">' %}
      <div class="hidden live-join-title text_b2 lg:line-clamp-3 line-clamp-4">{{ block.settings.sub_heading | replace: '<em>', subTitleColor }}</div>
    {% endif %}
  </div>
  <div class="live-join-img flex lg:justify-end justify-between">
    {% if block.settings.sub_heading != blank %}
      {% assign subTitleColor = '<em style="color: ' | append: block.settings.active_sub_color | append: '">' %}
      <div class="lg:hidden live-join-title w-[14.4375rem] mr-[0.78125rem] text_b2 lg:line-clamp-3 line-clamp-4">{{ block.settings.sub_heading | replace: '<em>', subTitleColor }}</div>
    {% endif %}
    <div class="live-join-img-box flex items-start">
      {%- if block.settings.img != blank -%}
        {%- 
          render 'responsive-image', 
          image: block.settings.img, 
          width: 140, 
          mwidth: 80, 
          image_class: "join-img lg:w-[8.75rem] lg:h-[8.75rem] w-[5rem] h-[5rem] min-w-[5rem] min-h-[5rem] object-cover flex items-end" 
        -%}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg lg:w-[8.75rem] lg:h-[8.75rem]  w-[5rem] h-[5rem] min-w-[5rem] min-h-[5rem] object-cover flex items-end' }}
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Why Join Jackery",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "标题",
      "default": "<p>默认标题内容</p>",
      "info": "该处富文本功能只支持换行和斜体高亮标记"
    },
    { "type": "color", "id": "text_title_color", "label": "标题颜色", "default": "#333333" },
    { "type": "color", "id": "active_title_color", "label": "标题强调颜色", "default": "#fd5000" },
    {
      "type": "richtext",
      "id": "sub_heading",
      "label": "副标题",
      "default": "<p>默认副标题内容</p>",
      "info": "该处富文本功能只支持换行和斜体高亮标记"
    },
    { "type": "color", "id": "text_sub_color", "label": "副标题颜色", "default": "#333333" },
    { "type": "color", "id": "active_sub_color", "label": "副标题强调颜色", "default": "#fd5000" },
    { "type": "image_picker", "id": "img", "label": "图片地址", "info": "推荐尺寸：160 * 160"}
  ],
  "presets": [
    {
      "name": "Join Jackery Item",
      "settings": {
        "heading": "<p>Limited Time Promotions</p>",
        "text_title_color": "#333333",
        "active_title_color": "#fd5000",
        "sub_heading": "<p>Orders are usually processed and delivered within 3–4 business days are usually processed and delivered within 3–4 business</p>",
        "text_sub_color": "#333333",
        "active_sub_color": "#fd5000"
      }
    }
  ]
}
{% endschema %}
