{% style %}
  .v5-scroll-pic-3 {
    position: relative;
    overflow: hidden;
  }
  .v5-scroll-pic-3 .v5-scroll-pic-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .v5-scroll-pic-3 .v5-scroll-pic-content {
    position: relative;
    z-index: 1;
  }
{% endstyle %}
{%- liquid
  assign container_id = block.settings.anchor | default: block.id
  assign pc_bg_image = block.settings.parallax_bg_pc
  assign mb_bg_image = block.settings.parallax_bg_mb
-%}

<jky-v5-scroll-pic-3 {{ block.shopify_attributes }} id="{{ container_id }}"
  {% if block.settings.anchor != blank %} anchor-target="{{block.settings.anchor | escape}}" {% endif %}
  class="v5-scroll-pic-3 block section-padding max-w-full {{ page_width }}">
  <div class="hidden lg:block v5-scroll-pic-bg lg:h-[75rem]"
         style="{% if pc_bg_image %}background-image:url({{ pc_bg_image | image_url }});{% endif %}"
         ></div>
  <div class="lg:hidden block v5-scroll-pic-bg h-[76.25rem]"
       style="{% if mb_bg_image %}background-image:url({{ mb_bg_image | image_url }});{% endif %}"
  ></div>

  <div class="v5-scroll-pic-content relative lg:h-[75rem] h-[76.25rem] lg:w-[82.5rem] w-[21.4375rem] my-0 mx-auto lg:pl-[2.5rem] flex flex-col                                               ">
    {%- comment -%}
      左侧竖线 + 导航圆点（PC显示），滚动时高亮当前区域
    {%- endcomment -%}
    <div class="v5-scroll-pic-nav absolute left-0 top-0 h-full w-[2px]">
      <div class="absolute left-0 top-0 bottom-0 z-2 w-[2px] bg-white/40"></div>
      <ul class="absolute left-0 top-0 translate-y-0 z-3 lg:top-1/2 lg:-translate-y-1/2 space-y-4">
        <li class="v5-scroll-pic-dot v5-scroll-pic-dot-1 w-[2px] rounded-full bg-white cursor-pointer" style="margin-top:0;"></li>
        <li class="v5-scroll-pic-dot v5-scroll-pic-dot-2 w-[2px] rounded-full bg-white cursor-pointer" style="margin-top:0;"></li>
      </ul>
    </div>
    <div class="v5-scroll-pic-slide-1 text-left lg:h-[37.5rem] h-[35.625rem] my-0 flex-1 flex flex-col justify-end lg:py-[3.125rem] py-[1.25rem]">
      <div class="v5-scroll-pic-content-pc w-full h-full hidden lg:flex flex-col justify-end">
        {% if block.settings.scroll_text_title_1 != blank %}
          <div class="v5-scroll-title-1 w-full text-[#FFFFFF] v5-font-oxm font-extrabold lg:text-[5.25rem] lg:leading-[5.775rem] text-[3rem] leading-[3rem] lg:mb-[2.5rem] mb-[1.25rem]">{{ block.settings.scroll_text_title_1 }}</div>
        {% endif %}
        {% if block.settings.scroll_text_subtitle_1 != blank %}
          <div class="v5-scroll-subtitle-1 w-full font-semibold text-[#FFFFFF] lg:text-[2rem] lg:leading-[2.2rem] text-[1.75rem] leading-[1.75rem ] lg:mb-[2.5rem] mb-[1.25rem]">{{ block.settings.scroll_text_subtitle_1 }}</div>
        {% endif %}
        {% if block.settings.scroll_img_pc_1 != blank or block.settings.scroll_img_mb_1 != blank %}
          {%- render 'responsive-image', image: block.settings.scroll_img_pc_1, mimage: block.settings.scroll_img_mb_1, image_class: 'w-full h-full lg:w-auto lg:h-auto object-cover lg:mb-[2.5rem] lg:max-h-[12.5rem] mb-[1.25rem]' -%}
        {% endif %}
        {% if block.settings.scroll_text_sub_1 != blank %}
          <div class="v5-scroll-text-1 w-full font-normal lg:text-[0.875rem] lg:leading-[0.875rem] text-[0.75rem] leading-[0.75rem] text-[#FFFFFF]">{{ block.settings.scroll_text_sub_1 }}</div>
        {% endif %}
      </div>
      <div class="v5-scroll-pic-content-mb w-full h-full lg:hidden flex flex-col justify-between">
        <div class="content-top pl-[0.625rem]">
          {% if block.settings.scroll_text_title_1 != blank %}
            <div class="v5-scroll-title-1 w-full text-[#FFFFFF] v5-font-oxm font-extrabold lg:text-[5.25rem] lg:leading-[5.775rem] text-[3rem] leading-[3rem] lg:mb-[2.5rem] mb-[1.25rem]">{{ block.settings.scroll_text_title_1 }}</div>
          {% endif %}
          {% if block.settings.scroll_text_subtitle_1 != blank %}
            <div class="v5-scroll-subtitle-1 w-full font-semibold text-[#FFFFFF] lg:text-[2rem] lg:leading-[2.2rem] text-[1.75rem] leading-[1.75rem ] lg:mb-[2.5rem] mb-[1.25rem]">{{ block.settings.scroll_text_subtitle_1 }}</div>
          {% endif %}
          {% if block.settings.scroll_text_sub_1 != blank %}
            <div class="v5-scroll-text-1 w-full font-normal lg:text-[0.875rem] lg:leading-[0.875rem] text-[0.75rem] leading-[0.75rem] text-[#FFFFFF]">{{ block.settings.scroll_text_sub_1 }}</div>
          {% endif %}
        </div>
        {% if block.settings.scroll_img_mb_1 != blank %}
          <img
            class="w-full h-full lg:w-auto lg:h-auto object-cover lg:mb-[2.5rem] lg:max-h-[12.5rem] mb-[1.25rem]"
            alt="{{block.settings.scroll_text_title_1}}"
            loading="lazy"
            src="{{ block.settings.scroll_img_mb_1 }}"
          />
        {% endif %}
      </div>
    </div>

    <div class="v5-scroll-pic-slide-2 text-left lg:h-[37.5rem] h-[35.625rem] my-0 flex-1 flex flex-col justify-end lg:py-[3.125rem] py-[1.25rem]">
      <div class="v5-scroll-pic-content-pc w-full h-full hidden lg:flex flex-col justify-end">
        {% if block.settings.scroll_text_title_2 != blank %}
          <div class="v5-scroll-title-2 w-full text-[#FFFFFF] v5-font-oxm font-extrabold lg:text-[5.25rem] lg:leading-[5.775rem] text-[3rem] leading-[3rem] lg:mb-[2.5rem] mb-[1.25rem]">{{ block.settings.scroll_text_title_2 }}</div>
        {% endif %}
        {% if block.settings.scroll_text_subtitle_2 != blank %}
          <div class="v5-scroll-subtitle-2 w-full font-semibold text-[#FFFFFF] lg:text-[2rem] lg:leading-[2.2rem] text-[1.75rem] leading-[1.75rem ] lg:mb-[2.5rem] mb-[1.25rem]">{{ block.settings.scroll_text_subtitle_2 }}</div>
        {% endif %}
        {% if block.settings.scroll_img_pc_2 != blank or block.settings.scroll_img_mb_2 != blank %}
          {%- render 'responsive-image', image: block.settings.scroll_img_pc_2, mimage: block.settings.scroll_img_mb_2, image_class: 'w-full h-full lg:w-auto lg:h-auto object-cover lg:mb-[2.5rem] lg:max-h-[12.5rem] mb-[1.25rem]' -%}
        {% endif %}
        {% if block.settings.scroll_text_sub_2 != blank %}
          <div class="v5-scroll-text-2 w-full font-normal lg:text-[0.875rem] lg:leading-[0.875rem] text-[0.75rem] leading-[0.75rem] text-[#FFFFFF]">{{ block.settings.scroll_text_sub_2 }}</div>
        {% endif %}
      </div>
      <div class="v5-scroll-pic-content-mb w-full h-full lg:hidden flex flex-col justify-between">
        <div class="content-top pl-[0.625rem]">
          {% if block.settings.scroll_text_title_2 != blank %}
            <div class="v5-scroll-title-2 w-full text-[#FFFFFF] v5-font-oxm font-extrabold lg:text-[5.25rem] lg:leading-[5.775rem] text-[3rem] leading-[3rem] lg:mb-[2.5rem] mb-[1.25rem]">{{ block.settings.scroll_text_title_2 }}</div>
          {% endif %}
          {% if block.settings.scroll_text_subtitle_2 != blank %}
            <div class="v5-scroll-subtitle-2 w-full font-semibold text-[#FFFFFF] lg:text-[2rem] lg:leading-[2.2rem] text-[1.75rem] leading-[1.75rem ] lg:mb-[2.5rem] mb-[1.25rem]">{{ block.settings.scroll_text_subtitle_2 }}</div>
          {% endif %}
          {% if block.settings.scroll_text_sub_2 != blank %}
            <div class="v5-scroll-text-2 w-full font-normal lg:text-[0.875rem] lg:leading-[0.875rem] text-[0.75rem] leading-[0.75rem] text-[#FFFFFF]">{{ block.settings.scroll_text_sub_2 }}</div>
          {% endif %}
        </div>
        {% if block.settings.scroll_img_mb_2 != blank %}
          <img
            class="w-full h-full lg:w-auto lg:h-auto object-cover lg:mb-[2.5rem] lg:max-h-[12.5rem] mb-[1.25rem]"
            alt="{{block.settings.scroll_text_title_2}}"
            loading="lazy"
            src="{{ block.settings.scroll_img_mb_2 }}"
          />
        {% endif %}
      </div>
    </div>
  </div>
</jky-v5-scroll-pic-3>




<script src="{{ 'gsap.js' | asset_url }}" defer></script>
<script src="{{ 'scrollTrigger.js' | asset_url }}" defer></script>
<script src="{{ 'block-v5-scroll-pic-3.min.js' | asset_url }}" defer></script>


{% schema %}
{
  "name": "V5-图文动效3",
  "class": "v5-scroll-pic-3",
  "blocks": [],
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    { "type": "image_picker", "id": "parallax_bg_pc", "label": "背景图pc", "info": "宽1440px，高1200px" },
    { "type": "image_picker", "id": "parallax_bg_mb", "label": "背景图mb", "info": "宽750px，高2440px" },

    { "type": "header", "content": "第一屏内容" },
    { "type": "text", "id": "scroll_text_title_1", "label": "主标题", "default": "COZY HOME POWERED" },
    { "type": "text", "id": "scroll_text_subtitle_1", "label": "副标题", "default": "Supporting 99% Home Devices*" },
    { "type": "image_picker", "id": "scroll_img_pc_1", "label": "PC图片", "info": "最大宽度1280px, 最大高度200px" },
    { "type": "text", "id": "scroll_text_sub_1", "label": "描述文案", "default": "* Figures shown are estimates; actual usage varies." },

    { "type": "header", "content": "第二屏内容" },
    { "type": "text", "id": "scroll_text_title_2", "label": "主标题", "default": "COZY HOME POWERED" },
    { "type": "text", "id": "scroll_text_subtitle_2", "label": "副标题", "default": "Supporting 99% Home Devices*" },
    { "type": "image_picker", "id": "scroll_img_pc_2", "label": "PC图片", "info": "最大宽度1280px, 最大高度200px" },
    { "type": "text", "id": "scroll_text_sub_2", "label": "描述文案", "default": "* Figures shown are estimates; actual usage varies." }
  ]
}
{% endschema %}
