{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}

<div
  class="button-wrapper scroll-trigger animate--slide-in"
  {% if block.settings.anchor != blank %}
    anchor-target="{{block.settings.anchor | escape}}"
  {% endif %}
  style="background: {{block.settings.bg_color}};"
>
  <div
    class="section-padding max-w-full {{block.settings.page_width}} text-{{block.settings.content_align}}"
    style="{{ style }}"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "V-通用按钮",
  "tag": null,
  "blocks": [{ "type": "_button-group" }, { "type": "_button-group-btn" }, { "type": "_button-group-btn-and-dialog" }, {"type": "_product-action-buttons"}],
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "select",
      "id": "page_width",
      "visible_if": "{{ settings.customize_vcomponents == true }}",
      "label": "组件宽度",
      "default": "section-container-lg",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1320px"
        },
        {
          "value": "w-full",
          "label": "铺满/100%"
        }
      ]
    },
    {
      "type": "text_alignment",
      "id": "content_align",
      "label": "内容对齐",
      "default": "center"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "背景颜色"
    },
    {
      "type": "header",
      "visible_if": "{{ settings.customize_vcomponents == true }}",
      "content": "内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ settings.customize_vcomponents == true }}",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "上边距",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ settings.customize_vcomponents == true }}",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "下边距",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_left",
      "visible_if": "{{ settings.customize_vcomponents == true }}",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "visible_if": "{{ settings.customize_vcomponents == true }}",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0
    },

    {
      "type": "header",
      "visible_if": "{{ settings.customize_vcomponents == true }}",
      "content": "MB边距"
    },
    {
      "type": "select",
      "id": "mb_padding_type",
      "visible_if": "{{ settings.customize_vcomponents == true }}",
      "options": [
        {
          "value": "default",
          "label": "默认"
        },
        {
          "value": "custom",
          "label": "自定义"
        }
      ],
      "default": "default",
      "label": "MB边距"
    },
    {
      "type": "number",
      "id": "padding_top_mb",
      "label": "上边距",
      "visible_if": "{{ settings.customize_vcomponents == true and block.settings.mb_padding_type == 'custom' }}",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom_mb",
      "label": "下边距",
      "visible_if": "{{ settings.customize_vcomponents == true and block.settings.mb_padding_type == 'custom' }}",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_left_mb",
      "label": "左边距",
      "visible_if": "{{ settings.customize_vcomponents == true and block.settings.mb_padding_type == 'custom' }}",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_right_mb",
      "label": "右边距",
      "visible_if": "{{ settings.customize_vcomponents == true and block.settings.mb_padding_type == 'custom' }}",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "V-通用按钮",
      "category": "内容展示",
      "blocks": [
        {
          "type": "_button-group",
          "settings": {
            "padding_top": 8,
            "padding_bottom": 8
          },
          "blocks": [
            {
              "type": "_button-group-btn",
              "settings": {
                "content": "实心按钮"
              }
            },
            {
              "type": "_button-group-btn",
              "settings": {
                "content": "实心胶囊动效按钮",
                "variant": "primary",
                "animated": true
              }
            },
            {
              "type": "_button-group-btn",
              "settings": {
                "content": "空心按钮",
                "variant": "secondary"
              }
            },
            {
              "type": "_button-group-btn",
              "settings": {
                "content": "文本按钮",
                "variant": "text"
              }
            },
            {
              "type": "_button-group-btn",
              "settings": {
                "content": "文本按钮 + 箭头",
                "variant": "text",
                "icon": "arrow-right"
              }
            },
            {
              "type": "_button-group-btn",
              "settings": {
                "content": "实心按钮 + 超链接",
                "href": "/collections/all"
              }
            },
            {
              "type": "_button-group-btn",
              "settings": {
                "content": "自定义颜色按钮",
                "kind": "custom",
                "custom_color": "#0000FF"
              }
            },
            {
              "type": "_button-group-btn-and-dialog"
            }
          ]
        },
        {
          "type": "_button-group-btn",
          "settings": {
            "padding_top": 8,
            "padding_bottom": 8,
            "content": "标准按钮"
          }
        },
        {
          "type": "_button-group-btn-and-dialog",
          "settings": {
            "padding_top": 8,
            "padding_bottom": 8,
            "content": "点击显示弹窗"
          }
        }
      ]
    }
  ]
}
{% endschema %}
