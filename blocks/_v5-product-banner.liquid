{% comment %} v5-产品banner {% endcomment %}

<div class="v5-product-banner w-full h-full relative overflow-hidden">
  {% render 'diff-end-img',
    class: 'banner-img w-full h-full object-cover',
    pc_img: block.settings.pc_banner_img,
    mb_img: block.settings.mb_banner_img,
    pc_img_width: banner_pc_width,
    mb_img_width: 750,
    placeholder_name: 'hero-apparel-1'
  %}

  <div class="absolute top-6 lg:top-14 left-4 lg:left-10 right-10 flex flex-col vertical-top">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "v5-产品banner",
  "tag": null,
  "blocks": [{ "type": "v-heading-content" }],
  "settings": [
    {
      "type": "header",
      "content": "图片"
    },
    {
      "type": "image_picker",
      "id": "pc_banner_img",
      "label": "PC图",
      "info": "推荐尺寸：1320x300、872x691、424x691"
    },
    {
      "type": "image_picker",
      "id": "mb_banner_img",
      "label": "MB图",
      "info": "推荐尺寸：750x320（2倍图）"
    }
  ],
  "presets": [
    {
      "name": "v5-产品banner",
      "blocks": [
        {
          "type": "v-heading-content",
          "settings": {
            "content_width": "custom",
            "custom_content_width": 500,
            "content_alignment": "lg:justify-start",
            "padding_top": 0,
            "padding_bottom": 0,
            "padding_left": 0,
            "padding_right": 0,
            "radius_3": 0,
            "radius_4": 0
          },
          "blocks": [
            {
              "type": "_v-heading-content-heading",
              "settings": {
                "heading": "<p>Home Power</p>",
                "mb_heading": "<p>Home Power</p>",
                "padding_top": 0,
                "padding_bottom": 16,
                "alignment": "left",
                "alignment_mb": "left",
                "text_color": "#ffffff",
                "heading_size": "heading_2",
                "font_weight": "font-semibold",
                "mb_content_type": "custom",
                "mb_heading_size": "heading_4",
                "mb_font_weight": "font-semibold"
              }
            },
            {
              "type": "_v-heading-content-des",
              "settings": {
                "heading": "<p>Lightweight, solar-ready systems for long outdoor stays.</p>",
                "mb_heading": "<p>Lightweight, solar-ready systems for long outdoor stays.</p>",
                "padding_top": 0,
                "padding_bottom": 0,
                "alignment": "left",
                "alignment_mb": "left",
                "text_color": "#ffffff",
                "heading_size": "text_b1",
                "font_weight": "font-normal"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
