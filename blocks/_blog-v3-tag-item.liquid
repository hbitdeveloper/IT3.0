{% comment %}
  博客标签导航组件 (Blog V3)

  功能说明:
  - 展示博客标签的导航列表
  - 最多支持4个标签组合
  - 每组包含:
    * 标签名称设置
  - 交互效果:
    * 点击跳转至对应标签页面
{% endcomment %}

{% for i in (1..4) %}
  {% assign category_setting = 'blog_category_' | append: i %}
  {% assign tag_setting = 'blog_tag_' | append: i %}
  {% assign blog = block.settings[category_setting] %}

  {% if blog != blank %}
    <li class="blog-v3-tag-item border-solid border-0 border-b-[1px] border-[#EFEFEF]">
      {% assign tag = block.settings[tag_setting] | escape_once %}
      {% assign link_class = 'flex items-center h-[3.125rem] lg:h-[3.625rem]' %}

      <a
        href="{{ blog.url }}{% if tag != blank %}/tagged/{{ tag | handle }}{% endif %}"
        {% if settings.article_new_blank %}target="_blank"{% endif %}
        class="{{ link_class }}"
        data-content="{{ tag | default: blog.title | escape_once }}"
      >
        {% assign icon_setting = 'icon_' | append: i %}
        {% assign icon = block.settings[icon_setting] %}
        {% if icon %}
          <img
            src="{{ icon.src | image_url:width:32,height:32 }}"
            alt="{{ icon.alt }}"
            class="tag-item-icon w-8 h-8 mr-2.5 inline-block"
            loading="lazy"
            width="32"
            height="32"
            decoding="async"
          >
        {% endif %}
        <span class="tag-text text-[0.875rem] font-medium text-[#313131] leading-[1.375] lg:leading-[1.3572] line-clamp-1">
          {{ tag | default: blog.title | escape_once }}
        </span>
      </a>
    </li>
  {% endif %}
{% endfor %}

