<div
  {{ block.shopify_attributes }}
  class="v-data-card flex flex-col items-center justify-center p-2 lg:p-4 text-center"
>
  <div class="v-data-tag jds-b3 lg:jds-h5" style="--jds-rte-text-color: #fff;">{{ block.settings.title }}</div>
</div>

{% schema %}
{
  "name": "V-数据卡片-仅标签",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "title",
      "label": "标签",
      "default": "<p>Global Awards</p>"
    }
  ],
  "presets": [
    {
      "name": "V-数据卡片-仅标签"
    }
  ]
}
{% endschema %}
