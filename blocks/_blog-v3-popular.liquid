{% doc %} 
    受欢迎的博客
{% enddoc %}

{%- assign blog = block.settings.blog -%}
{%- assign title = block.settings.title | default: blog.title -%}
{% if blog != blank%}
    <div class="mb-[3rem] lg:mb-[4rem] blog-v3-popular" {{ block.shopify_attributes }} 
        data-block-type="_blog-v3-popular"
        anchor-target="{{ block.settings.anchor | escape }}">
        <div class="flex items-center justify-between mb-3 lg:mb-4 title">
            <h2 class="blog-v3-h2 flex-1 line-clamp-1">{{ title | escape }}</h2>
            <div class="hidden lg:block">
                <div class="flex items-center">
                    {%- if block.settings.view_more != blank -%}
                        <a class="font-semibold text-[0.875rem] leading-[1.5rem] text-[var(--jds-color-primary)] relative after:content-[''] after:absolute after:left-0 after:bottom-0  after:h-[1px] after:w-0 after:bg-[var(--jds-color-primary)] after:transition-all after:duration-300 after:ease-in-out
                            hover:after:w-full" href="{{ blog.url }}" 
                            {%- if settings.article_new_blank -%} target="__blank" {%- endif -%}
                            aria-label="{{ title | escape }}"
                            data-ga-event="blogs_collection_user_clicks" 
                            data-ga-action="click" 
                            data-ga-params-module="{{ title | escape }}" 
                            data-ga-params-position="ViewAll"
                            data-ga-params-link="{{ request.origin | append: blog.url }}"
                        >
                            {{ block.settings.view_more | escape }}
                        </a>
                        {% render 'icon-arrow', width: 12, height: 12, color: 'var(--jds-color-primary)', class: 'pl-[0.25rem]' %}
                    {%- endif -%}
                </div>
            </div>
        </div>

        {%- assign col = block.settings.col | default: '3' -%}
        {%- assign grid_class = 'block lg:grid lg:grid-cols-3 lg:gap-3' -%}
        {%- assign image_class = 'mb-3' -%}
        {%- assign title_class = 'text-[0.8125rem] leading-[1.0625rem] lg:text-[0.875rem] lg:leading-5' -%}
        {%- assign image_width = 686 -%}
        {%- if col == '4'  -%}
            {%- assign image_class = 'mb-2' -%}
            {%- assign title_class = 'text-[0.815rem] leading-5 lg:text-3 lg:leading-4' -%}
            {%- assign grid_class = 'grid grid-cols-2 gap-[0.75rem] lg:grid-cols-4 lg:gap-4' -%}
            {%- assign image_width = 331 -%}
        {%- endif -%}

        <div class="{{ grid_class }}">
            {%- assign articles = blog.articles | sort: "updated_at" | reverse -%}
            {%- for article in articles limit: col -%}
                <div class="flex flex-col justify-between flex-start mb-4 lg:mb-0">
                    <a 
                        href="{{ article.url }}" 
                        {%- if settings.article_new_blank -%} target="__blank" {%- endif -%}  
                        class="block"
                        aria-label="{{ article.title | escape }}"
                        data-ga-event="blogs_collection_user_clicks" 
                        data-ga-action="click" 
                        data-ga-params-module="{{ title | escape }}" 
                        data-ga-params-position="{{  article.title | escape }}"
                        data-ga-params-link="{{ request.origin | append: article.url }}"
                    >
                        <div class="relative aspect-[225/150] overflow-hidden rounded {{ image_class }}">
                            {%- if article.image != blank -%}
                            {{ article.image | image_url: width: image_width | image_tag: loading: 'lazy',  class: 'w-full h-full object-cover' }}
                            {%- else -%}
                            {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-gray-100' }}
                            {%- endif -%}
                      </div>
                      <div class="font-medium line-clamp-3 mb-2 text-[#1a1a1a] {{ title_class }}">{{ article.title }}</div>
                    </a>
                    <div class="text-[#999] text-[0.625rem] leading-[0.625rem] lg:text-3 lg:leading-4">{{ article.updated_at | time_tag: format: 'date' }}</div>
                </div>
            {%- endfor -%}
        </div>
        {%- if block.settings.view_more != blank -%}
            <a class="flex items-center justify-center mt-[2rem] lg:hidden" 
                href="{{ blog.url }}"
                {%- if settings.article_new_blank -%} target="__blank" {%- endif -%}
                aria-label="{{ title | escape }}"
                data-ga-event="blogs_collection_user_clicks" 
                data-ga-action="click" 
                data-ga-params-module="{{ title | escape }}" 
                data-ga-params-position="ViewAll"
                data-ga-params-button_name="{{ block.settings.view_more | escape }}"
                data-ga-params-link="{{ request.origin | append: blog.url }}"
            >
                <div class="flex items-center justify-center h-[2.5rem] px-[1.125rem] font-medium text-[0.875rem] text-[var(--jds-color-primary)] border-solid border-[var(--jds-color-primary)] border-2 rounded-3xl"> {{ block.settings.view_more | escape }} </div>
            </a>
        {%- endif -%}
    </div>
{% endif %}

{% schema %}
    {
        "name": "聚合页 - 主要大分类博客",
        "tag": null,
        "settings": [
            { "type": "text", "id": "anchor", "label": "锚点定位ID", "info": "(确保唯一性,禁止空格和-符号)" },
            { "type": "blog", "id": "blog", "label": "博客" },
            { "type": "text", "id": "title", "label": "标题", "info": "如果未配置则取博客的标题"},
            {
                "type": "select", "id": "col", "label": "显示几列",
                "options": [
                    { "value": "3", "label": "PC 3列 MB 1列" },
                    { "value": "4", "label": "PC 4列 MB 2列" }
                ],
                "default": "3"
            },
            { "type": "text", "id": "view_more", "label": "View More", "default": "View More"}
        ],
        "presets": [
            {
                "name": "聚合页 - 主要大分类博客",
                "category": "Blog-V3",
                "settings": {
                    "anchor": "blog-v3-popular-1",
                    "blog": "buying-advice",
                    "title": "Most Popular Blogs",
                    "col": "3",
                    "view_more": "View More"
                }
            }
        ]
    }
{% endschema %}

