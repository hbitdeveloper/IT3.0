
{%- if block.settings.tab_name != '' or block.settings.tab_name != blank -%}
  <div
    {{ block.shopify_attributes }}
    class="blocks-tab-item shrink-0 flex flex-col invisible"
  >
    {%- assign highlight_text = '<em style="--highlight-color:' | append: block.settings.highlight_color | append: '">' -%}
    <div class="tab-nav hidden">{{ block.settings.tab_name | replace: '<em>', highlight_text }}</div>
    <div class="tab-content shrink-0" data-tab-name="{{ block.settings.tab_name | strip_html | escape }}">
      {% content_for 'blocks' %}
    </div>
  </div>
{%- endif -%}

{% schema %}
  {
    "name": "Tab Item",
    "class": "blocks-tab-item",
    "tag": null,
    "settings": [
      { "type": "header", "content": "内容样式"},
      { "type": "richtext", "id": "tab_name", "label": "Tab Name" },
      { "type": "color", "id": "highlight_color", "label": "文本强调颜色", "default": "#fd5000" }
    ],
    "blocks": [{"type": "@app"}, {"type": "@theme"}, {"type": "_5000plus_tab_scene_appliance"}, {"type": "v5-category-edu-usage-scenario"}],
    "presets": [
      {
        "name": "Tab Item"
      }
    ]
  }
{% endschema %}
