<jky-shop-category-item class="shop-category-item group cursor-pointer relative flex lg:block items-center lg:items-start justify-between lg:justify-start w-full bg-white lg:bg-transparent rounded-lg lg:rounded-none py-[0.25rem] lg:py-0 pr-[0.75rem] lg:pr-0 pl-[0.5rem] lg:pl-0">
  {%- if block.settings.link != blank -%}
    <a
      class="absolute z-10 inset-0"
      {%- if block.settings.new_window -%}
      target="_blank"
      rel="noopener noreferrer"
      {%- endif -%}
      role="link"
      href="{{block.settings.link}}"></a>
  {%- endif -%}
  <div class="shop-category-content flex lg:flex-col items-center">
    <div class="live-category-img-box">
      {%- if block.settings.category_img != blank -%}
        <img
          loading="lazy"
          class="category-img lg:w-[9rem] lg:h-[9rem] w-[4.5rem] h-[4.5rem] lg:mb-[1rem] mr-[0.5rem] object-cover group-hover:scale-[1.03] transition-transform duration-300"
          src="{{block.settings.category_img | image_url: width: 144}}"
          alt="{{ block.settings.category_img.alt }}">
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg lg:w-[9rem] lg:h-[9rem] w-[4.5rem] h-[4.5rem] lg:mb-[1rem] mr-[0.5rem] object-cover flex items-end group-hover:scale-[1.03] transition-transform duration-300' }}
      {%- endif -%}
    </div>
    {%- if block.settings.shop_category_name != blank -%}
      <div class="live-category-name jds-h6 line-clamp-2 lg:text-center lg:w-[16.25rem] w-[13.6875rem] group-hover:text-[var(--jds-color-primary)]">
        {{ block.settings.shop_category_name }}
      </div>
    {%- endif -%}
  </div>
  <jds-icon class="lg:hidden block text-[1rem]" name="arrow-right"></jds-icon>
</jky-shop-category-item>
<script src="{{ 'blocks-_shop-category-item.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "Preview Schedule Item",
    "class": "lg:w-fit w-full",
    "settings": [
      {
        "type": "checkbox",
        "id": "new_window",
        "label": "新开标签",
        "default": false
      },
      {
        "type": "header",
        "content": "商品分类相关配置"
      },
      {
        "type": "image_picker",
        "id": "category_img",
        "label": "商品分类图片",
        "info": "推荐尺寸：144 * 144"
      },
      {
        "type": "text",
        "id": "shop_category_name",
        "label": "商品分类名",
        "default": "Portable Power Station"
      }, {
        "type": "url",
        "id": "link",
        "label": "链接地址"
      }
    ],
    "presets": [
      {
        "name": "Shop Category Item",
        "settings": {
          "new_window": false,
          "shop_category_name": "Portable Power Station"
        }
      }
    ]
  }
{% endschema %}
