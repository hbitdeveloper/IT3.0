
{%- liquid
  # 判断是否登录
  assign is_login = false
  if customer
    assign is_login = true
  endif

  # 判断是否为德国、法国、荷兰站点
  assign is_eu_site = false
  if shop.id == 57272172741 or shop.id == 64525172955 or shop.id == 75730714917 or shop.id == 69511053598 or shop.id == 6506092962
    assign is_eu_site = true
  endif

  # 判断是否展示模块
  assign module_show_timing = block.settings.module_show_timing | default: 'default'
  assign show_module = true
  if module_show_timing == 'show_before_login' and is_login == true
    assign show_module = false
  endif
  if module_show_timing == 'show_after_login' and is_login == false
    assign show_module = false
  endif

  if show_module == true
    # 历史数据配置 转换为 新class
    capture text_size
      render 'v-font-size-class', fs: block.settings.heading_size, default_class: 'text_b1'
    endcapture

    # 排版
    assign pc_heading_class = text_size | strip
    assign mb_heading_class = block.settings.mb_heading_size

    assign mb_content_type = block.settings.mb_content_type | default: 'default'
    if mb_content_type == 'default'
      assign mb_heading_class = pc_heading_class
    endif

    # 换算字重
    capture pc_end_font_weight
      render 'v-font-weight-number', fw: block.settings.font_weight
    endcapture
    assign pc_end_font_weight = pc_end_font_weight | strip
    if pc_end_font_weight != blank
      assign pc_style = '--jds-font-weight:' | append: pc_end_font_weight | append: ';'
    endif

    if mb_content_type == 'default'
      assign mb_style = pc_style
    else
      capture mb_end_font_weight
        render 'v-font-weight-number', fw: block.settings.mb_font_weight
      endcapture
      assign mb_end_font_weight = mb_end_font_weight | strip
      if mb_end_font_weight != blank
        assign mb_style = '--jds-font-weight:' | append: mb_end_font_weight | append: ';'
      endif
    endif

    assign italic_class = ''
    if block.settings.show_italic == true
      assign italic_class = 'jds-rte--italic'
    endif

    # 对齐方式
    assign pc_align = block.settings.alignment
    assign mb_align = block.settings.alignment_mb
    assign align_class = ''
    if mb_align != blank
      assign align_class = 'text-' | append: mb_align | append: ' lg:text-' | append: pc_align
    endif

    assign justify_class = 'justify-center lg:justify-center'
    if mb_align == 'left'
      assign justify_class = 'justify-start lg:justify-center'
    elsif mb_align == 'right'
      assign justify_class = 'justify-end lg:justify-center'
    endif

    if pc_align == 'left'
      assign justify_class = justify_class | replace: 'lg:justify-center', 'lg:justify-start'
    elsif pc_align == 'right'
      assign justify_class = justify_class | replace: 'lg:justify-center', 'lg:justify-end'
    endif

    assign desc_suffix_image = block.settings.desc_suffix_image
  endif
-%}
{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
  {% if is_eu_site %}
    hyphens: auto;
    -webkit-hyphens: auto;
    -moz-hyphens: auto;
    -ms-hyphens: auto;
    word-break: normal;
    overflow-wrap: break-word;
  {% endif %}
{%- endcapture -%}
{% if show_module == true %}
  <div
    {{ block.shopify_attributes }}
    class="blocks-text blocks-content-des section-padding {{ italic_class }} {{ align_class }}"
    style="color: {{block.settings.text_color}};--jds-rte-text-color:{{block.settings.text_color}};--active-color: {{block.settings.active_color}};{{style}}"
  >
    <div class="flex flex-wrap items-center gap-x-2 gap-y-2 {{ justify_class }}">
      <div
        class="hidden lg:inline-block jds-rte {{ pc_heading_class }}"
        {% if pc_style != blank %}
          style="{{ pc_style }}"
        {% endif %}
      >
        {{ block.settings.heading | newline_to_br }}
      </div>
      <div
        class="inline-block lg:hidden jds-rte {{ mb_heading_class }}"
        {% if mb_style != blank %}
          style="{{ mb_style }}"
        {% endif %}
      >
        {{ block.settings.mb_heading | newline_to_br }}
      </div>
      {%- if desc_suffix_image != blank -%}
        <div class="shrink-0">
          <img
            src="{{ desc_suffix_image | image_url: width: 160 }}"
            alt="{{ desc_suffix_image.alt | escape }}"
            loading="lazy"
            class="block h-auto max-w-full"
          >
        </div>
      {%- endif -%}
    </div>
  </div>
{% endif %}

