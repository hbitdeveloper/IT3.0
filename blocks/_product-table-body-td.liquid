<td class="table-row" {{ block.shopify_attributes }}>   
  {% if block.settings.text != blank %}
    <div>{{block.settings.text | newline_to_br}}</div> 
  {% endif %}

  {% if block.settings.img != blank %}
    {% render 'responsive-image', image: block.settings.img, width: 300, mwidth: 240 %}
  {% endif %}
</td>

{% schema %}
{
  "name": "表格行单元格",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>单元格文案</p>",
      "label": "单元格文案"
    },
    {"type": "image_picker", "id": "img", "label": "图片"}
  ],
  "presets": [
    {
      "name": "表格行单元格"
    }
  ]
}
{% endschema %}
