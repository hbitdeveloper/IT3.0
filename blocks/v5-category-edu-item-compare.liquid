<style>
  .v5-category-edu-item-compare {
    hyphens: auto;
    overflow-wrap: anywhere;
  }
</style>

{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}

<div {% if block.settings.anchor != blank %}anchor-target="{{ block.settings.anchor | escape }}"{% endif %} style="{{ style }}" class="section-padding  v5-category-edu-item-compare" {{ block.shopify_attributes }}>
  <div class="section-container-lg">
    <div class="hidden lg:block">
      <div class="rounded-none bg-white px-[4.5625rem]">
        <div class="grid grid-cols-[18.34rem_18.34rem_18.34rem_18.34rem] items-start">
          <div></div>
          {%- for col in (1..3) -%}
            {%- liquid
              assign prefix = 'p' | append: col | append: '_'
              assign title_key = prefix | append: 'title'
              assign title_color_key = prefix | append: 'title_color'
              assign link_key = prefix | append: 'link'
              assign pcimage_key = prefix | append: 'pcimage'
              assign mimage_key = prefix | append: 'mimage'
              assign title = block.settings[title_key]
              assign title_color = block.settings[title_color_key]
              assign link = block.settings[link_key]
              assign pcimage = block.settings[pcimage_key]
              assign mimage = block.settings[mimage_key]
            -%}
            <div class="flex flex-col items-start">
              <div class="mb-[1.4375rem] h-[5.5rem] w-[5.5rem]">
                  {%- render 'diff-end-img',
                    pc_img: pcimage,
                    mb_img: mimage,
                    class: 'h-[5.5rem] w-[5.5rem] object-cover'
                    pc_img_width: 88,
                    mb_img_width: 88
                  -%}
              </div>
              <div class="pr-[1rem] text-left text-[1.25rem] font-semibold leading-[1.6875rem] text-black" style="color: {{ title_color }};">
                {% if link != blank %}
                  <a href="{{ link }}">
                {% endif %}
                {{ title }}
                {% if link != blank %}
                  </a>
                {% endif %}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="mt-[2.625rem]">
          <div class="grid grid-cols-[18.34rem_18.34rem_18.34rem_18.34rem]">
            {%- for i in (1..20) -%}
              {%- assign label_key = 'label_' | append: i -%}
              {%- assign label_value = block.settings[label_key] | strip -%}
              {% assign isOdd = i | modulo: 2 %}
              {% liquid
                assign bgClass = 'bg-[#efefef]'
                if isOdd == 0
                  assign bgClass = "bg-white"
                endif
              %}
              {% if label_value != blank %}
                <div class="{{ bgClass }} lg:py-[1.25rem] lg:leading-[1.2] pl-[2.75rem] pr-[1rem] flex items-center text-left text-[1rem] font-medium leading-[3.3125rem] text-black">{{ label_value }}</div>
                {%- for col in (1..3) -%}
                  {%- liquid
                    assign prefix = 'p' | append: col | append: '_'
                    assign value_key = prefix | append: 'value_' | append: i
                    assign value = block.settings[value_key]
                  -%}
                  <div class="{{ bgClass }} lg:py-[1.25rem] lg:leading-[1.2] pl-[0.3125rem] pr-[1rem] flex items-center text-left text-[1rem] font-medium leading-[3.3125rem] text-black">{{ value }}</div>
                {%- endfor -%}
              {% endif %}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="mx-auto mt-[2.5rem] w-[69.25rem] text-left text-[1rem] font-medium leading-[1.6875rem] text-[rgba(0,0,0,0.3)]">
        {{ block.settings.footnote }}
      </div>
    </div>

    <div class="lg:hidden">
      <div class="">
        <div class="grid grid-cols-[4.98rem_4.98rem_4.98rem_4.98rem] items-start gap-x-[0.5rem]">
          <div></div>
          {%- for col in (1..3) -%}
            {%- liquid
              assign prefix = 'p' | append: col | append: '_'
              assign title_key = prefix | append: 'title'
              assign title_color_key = prefix | append: 'title_color'
              assign link_key = prefix | append: 'link'
              assign pcimage_key = prefix | append: 'pcimage'
              assign mimage_key = prefix | append: 'mimage'
              assign title = block.settings[title_key]
              assign title_color = block.settings[title_color_key]
              assign link = block.settings[link_key]
              assign pcimage = block.settings[pcimage_key]
              assign mimage = block.settings[mimage_key]
            -%}
            <div class="flex flex-col items-start">
              <div class="mb-[0.625rem] h-[2.75rem] w-[2.75rem]">
                {%- if pcimage != blank or mimage != blank -%}
                  {%- render 'diff-end-img',
                    pc_img: pcimage,
                    mb_img: mimage,
                    class: 'h-[2.75rem] w-[2.75rem] object-cover',
                    pc_img_width: 44,
                    mb_img_width: 44
                  -%}
                {%- endif -%}
              </div>
              <div class="min-h-6 w-full text-left text-[0.625rem] font-semibold leading-[0.84375rem]" style="color: {{ title_color }};">
                {% if link != blank %}
                  <a href="{{ link }}">
                {% endif %}
                {{ title }}
                {% if link != blank %}
                  </a>
                {% endif %}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="mt-[0.65625rem]">
          {%- for i in (1..20) -%}
            {%- assign label_key = 'label_' | append: i -%}
            {%- assign label_value = block.settings[label_key] | strip -%}
            {% assign isOdd = i | modulo: 2 %}
            {% liquid
              assign bgClass = 'bg-[#efefef]'
              if isOdd == 0
                assign bgClass = "bg-white"
              endif
            %}
            {% if label_value != blank %}
              <div class="grid grid-cols-[4.98rem_4.98rem_4.98rem_4.98rem] gap-x-[0.5rem] py-[0.625rem] {{ bgClass }}">
                <div class="flex items-center px-[0.4375rem] text-left text-[0.625rem] font-medium leading-[0.84375rem] text-black">{{ label_value }}</div>
                {%- for col in (1..3) -%}
                  {%- liquid
                    assign prefix = 'p' | append: col | append: '_'
                    assign value_key = prefix | append: 'value_' | append: i
                    assign value = block.settings[value_key]
                  -%}
                  <div class="flex items-center px-[0.4375rem] text-left text-[0.625rem] font-medium leading-[0.84375rem] text-black">{{ value }}</div>
                {%- endfor -%}
              </div>
            {% endif %}
          {%- endfor -%}
        </div>
      </div>

      <div class="mt-[1.8125rem] w-full text-center text-[0.625rem] font-medium leading-[0.84375rem] text-[rgba(0,0,0,0.3)]">
        {{ block.settings.footnote }}
      </div>
    </div>

    {% content_for 'blocks' %}
  </div>
</div>

