{% comment %} V5-吸底产品对比模块 {% endcomment %}
{%- render 'v5-collection-sticky-bottom-compare',
    show_compare: true,
    collection_wrapper_selector: block.settings.collection_wrapper_selector,
    product_compare_selector: block.settings.product_compare_selector
-%}

{% schema %}
{
  "name": "V5-吸底产品对比模块",
  "class": "v5-collection-sticky-bottom-compare",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "面向开发配置"
    },
    {
        "type": "text",
        "id": "collection_wrapper_selector",
        "label": "绑定产品列表父容器选择器类名",
        "default": ".section-v-tabs-sections",
        "info": "用于控制父容器添加max-num类名，达到上限不可选效果"
    },
    {
        "type": "text",
        "id": "product_compare_selector",
        "label": "绑定产品对比checkbox选择器类名",
        "default": ".v5-product-compare",
        "info": "用于监听产品对比checkbox变化，需要data-sku、data-image、data-title属性"
    },
  ],
  "presets": [
    {
      "name": "v5-吸底产品对比模块",
      "category": "V5.0",
      "settings": {
        "collection_wrapper_selector": ".section-v-tabs-sections",
        "product_compare_selector": ".v5-product-compare"
      }
    }
  ]
}
{% endschema %}