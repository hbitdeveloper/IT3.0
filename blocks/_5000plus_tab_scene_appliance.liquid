<style>

    @media screen and (min-width: 1024px) {
        .v5000plus_tab_scene_appliance .texts > div:not(:last-child) {
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #FFFFFF;
        }

        .v5000plus_tab_scene_appliance .texts > div:not(:first-child) {
            padding-top: 1.5rem;
        }
    }

    @media screen and (max-width: 1023.98px) {
        .v5000plus_tab_scene_appliance .texts > div:not(:last-child) {
            padding-bottom: 1rem;
            border-bottom: 1px solid #E8E8E5;
        }

        .v5000plus_tab_scene_appliance .texts > div:not(:first-child) {
            padding-top: 1rem;
        }
    }

</style>

<div class="v-blocks-image relative" {{ block.shopify_attributes }}>

    <div class="block blocks-image-wrap relative overflow-hidden pb-[28.625rem] lg:pb-[33.5rem]">
        {%- if block.settings.pcimage != blank or block.settings.mimage != blank -%}
            {% render 'responsive-image', image: block.settings.pcimage, image_class: 'blocks-image-pic w-full h-full top-0 left-0 absolute object-cover', mimage: block.settings.mimage %}
        {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder w-full h-full top-0 left-0 absolute object-cover' }}
        {%- endif -%}
    </div>

</div>

<div class="texts lg:absolute lg:right-[4rem] lg:top-[4.75rem]  lg:px-[1rem] lg:py-[1.5rem] lg:text-white text-[#242F20]
        mt-[1.5rem] lg:mt-0 flex flex-col lg:border lg:border-solid lg:border-[white] backdrop-blur-md ">
    {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "V5营销页-Tab场景电器-Item",
  "class": "v5000plus_tab_scene_appliance relative",
  "settings": [
    {
      "type": "image_picker",
      "id": "pcimage",
      "label": "PC图片",
      "info": "建议尺寸：1320 x 536"
    },
    {
      "type": "image_picker",
      "id": "mimage",
      "label": "MB图片",
      "info": "建议尺寸：686 x 916"
    }
  ],
  "blocks": [
    {
      "type": "_5000plus_tab_scene_appliance_text"
    }
  ],
  "presets": [
    {
      "name": "V5营销页-Tab场景电器-Item",
      "category": "V-Tabs Items",
      "blocks": [
        {
          "type": "_5000plus_tab_scene_appliance_text"
        }
      ]
    }
  ]
}
{% endschema %}
