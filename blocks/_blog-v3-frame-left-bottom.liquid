<div class="blog-v3-frame-left-bottom lg:w-[43.75rem]" {{ block.shopify_attributes }}>
  {% if template == 'page.blog-v3-index' %}
    {% content_for 'blocks' %}
    {% content_for 'block', type: '_blog-v3-other-categories', id: 'blogV3OtherCategories' %}
  {% endif %}

  {% content_for 'block', type: '_blog-v3-other-pages', id: 'blogV3OtherPages' %}
</div>

{% schema %}
{
  "name": "V3博客内容区 - 左下区",
  "tag": null,
  "blocks": [{ "type": "_blog-v3-popular" }],
  "settings": [],
  "presets": [
    {
      "name": "V3博客内容 - 左下区",
      "category": "Blog-V3",
      "blocks": [
        {
          "type": "_blog-v3-popular"
        },
        {
          "id": "blogV3OtherCategories",
          "type": "_blog-v3-other-categories",
          "static": true,
          "blocks": [
            {
              "type": "_blog-v3-other-category-item"
            }
          ]
        },
        {
          "id": "blogV3OtherPages",
          "type": "_blog-v3-other-pages",
          "static": true
        }
      ]
    }
  ]
}
{% endschema %}
