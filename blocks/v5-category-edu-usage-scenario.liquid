<style>
    #shopify-block-{{ block.id }} {
        background: {{ block.settings.bg_color }};
        --v5-usage-card-value-mb: {{ block.settings.card_value_font_size_mb | times: 1.0 | divided_by: 16 }}rem;
        --v5-usage-card-value-pc: {{ block.settings.card_value_font_size_pc | times: 1.0 | divided_by: 16 }}rem;
    }

    #shopify-block-{{ block.id }} .v5-usage-card-value {
        font-size: var(--v5-usage-card-value-mb, 1.40625rem);
    }

    @media (min-width: 1024px) {
        #shopify-block-{{ block.id }} .v5-usage-card-value {
            font-size: var(--v5-usage-card-value-pc, 2.1875rem);
        }
    }
</style>

{%- capture style -%}
    {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}

{%- assign pcimage = block.settings.pcimage -%}
{%- assign mimage = block.settings.mimage -%}
{%- assign device_image = block.settings.device_image -%}

<div {% if block.settings.anchor != blank %}anchor-target="{{block.settings.anchor | escape}}"{% endif %} style="{{ style }}" class="section-padding">
    <div class="v5-category-edu-usage-scenario relative">
        <div class="relative section-container-lg">
            <div class="relative flex flex-col lg:flex-row lg:items-start">

                {% comment %} Image {% endcomment %}
                <div class="order-1">
                    <div class="relative lg:w-[43rem] w-full h-[21.25rem] lg:h-[30.9375rem]">
                        {%- render 'diff-end-img',
                          pc_img: pcimage,
                          mb_img: mimage,
                          pc_img_width: 688,
                          mb_img_width: 343,
                          class: 'w-full h-full object-cover'
                        -%}
                    </div>
                </div>

                {% comment %} Text {% endcomment %}
                <div class="order-2 w-full px-[0.53125rem] pt-6 pb-[1.625rem] lg:w-[28.6875rem] lg:px-0 lg:pt-[2.375rem] lg:pb-0 lg:ml-[3.25rem]">
                    <p class="text-[#242f20] font-medium leading-[1.1] text-[0.9375rem] lg:leading-[1.14] lg:text-[1.375rem]">
                        {{ block.settings.title }}
                    </p>

                    <p class="mt-[1.3125rem] text-[#242f20] font-semibold leading-[1.22] text-xl lg:mt-[1.875rem] lg:text-[2.0625rem]" style="color: {{ block.settings.subtitle_color }};">
                      {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}" {% if block.settings.link_new_tab %}target="_blank" rel="noopener"{% endif %}>
                      {% endif %}
                        {{ block.settings.subtitle }}
                      {% if block.settings.link != blank %}
                        </a>
                      {% endif %}
                    </p>
                    <div class="flex mt-[1.3125rem] lg:mt-8">
                        <div class="flex flex-col gap-[0.375rem] justify-center">
                            {%- for i in (1..2) -%}
                                {%- assign card_label_key = 'card' | append: i | append: '_label' -%}
                                {%- assign card_value_key = 'card' | append: i | append: '_value' -%}
                                {% if block.settings[card_value_key] != blank %}
                                    <div class="lg:min-h-[6.5625rem] min-h-[4.09375rem] rounded lg:rounded-lg bg-gradient-to-b from-[#fff8ed] from-[33.974%] to-[#ffe9cc] flex items-center justify-center px-[0.6875rem] lg:px-[0.3125rem] lg:w-[14.1875rem] w-[9.9375rem]">
                                        <div class="text-center text-[#595959] font-medium leading-[1.19] w-full max-w-[17.125rem] lg:max-w-[14.75rem]">
                                            <p class="mb-0 text-[0.5625rem] lg:text-[0.8125rem] leading-[1.2]">
                                                {{ block.settings[card_label_key] }}
                                            </p>
                                            <p class="text-[#ff6727] font-700 leading-[1.2] v5-usage-card-value">
                                                {{ block.settings[card_value_key] }}
                                            </p>
                                        </div>
                                    </div>
                                {%endif%}
                            {%- endfor -%}
                        </div>
                        <div class="relative w-[8.5625rem] h-[8.5625rem] lg:w-[13.875rem] lg:h-[13.875rem] ml-[0.53125rem] lg:ml-[0.625rem]">
                            {%- render 'diff-end-img',
                              pc_img: device_image,
                              mb_img: device_image,
                              pc_img_width: 222,
                              mb_img_width: 137,
                              class: 'w-full h-full object-cover'
                            -%}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "V5品类教育页-家庭用电场景-Item",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "PC上边距",
      "default": 24
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "PC下边距",
      "default": 24
    },
    {
      "type": "text",
      "id": "mb_padding_type",
      "default": "custom",
      "label": "MB边距",
      "visible_if": "{{ false }}"
    },
    {
      "type": "number",
      "id": "padding_top_mb",
      "label": "MB上边距",
      "default": 96
    },
    {
      "type": "number",
      "id": "padding_bottom_mb",
      "label": "MB下边距",
      "default": 96
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "背景颜色"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Maison à forte consommation d’énergie"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "产品名称",
      "default": "SolarVault 3 Pro Max x1 + batteries additionnelles ×2 + 500 W x 4"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "产品名称颜色"
    },
    {
      "type": "url",
      "id": "link",
      "label": "产品名称跳转链接"
    },
    {
      "type": "checkbox",
      "id": "link_new_tab",
      "label": "产品名称链接新开页签",
      "default": false
    },
    {
      "type": "text",
      "id": "card1_label",
      "label": "卡片1文案",
      "default": "Consommation électrique annuelle"
    },
    {
      "type": "text",
      "id": "card1_value",
      "label": "卡片1数值",
      "default": "4000 kWh"
    },
    {
      "type": "text",
      "id": "card2_label",
      "label": "卡片2文案",
      "default": "Économies maximales annuelles"
    },
    {
      "type": "text",
      "id": "card2_value",
      "label": "卡片2数值",
      "default": "€470"
    },
    {
      "type": "range",
      "id": "card_value_font_size_pc",
      "label": "卡片数值字号(PC)",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_value_font_size_mb",
      "label": "卡片数值字号(MB)",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "image_picker",
      "id": "device_image",
      "info": "建议尺寸：274x274",
      "label": "产品图片"
    },
    {
      "type": "image_picker",
      "id": "pcimage",
      "info": "建议尺寸：688x495",
      "label": "PC主图"
    },
    {
      "type": "image_picker",
      "id": "mimage",
      "info": "建议尺寸：686x680",
      "label": "MB主图"
    }
  ],
  "presets": [
    {
      "category": "V-Tabs Items",
      "name": "V5品类教育页-家庭用电场景-Item"
    }
  ]
}
{% endschema %}
