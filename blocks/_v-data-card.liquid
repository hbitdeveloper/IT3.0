{%- liquid
  assign style = block.settings.style | default: 'default'
-%}

{% if style == 'default' %}
  <div
    {{ block.shopify_attributes }}
    class="v-data-card flex flex-col items-center justify-center lg:px-3.5 lg:py-2.5 w-[8.5rem] lg:w-[10.875rem] text-center"
  >
    <div
      class="v-data-default v-data-number jds-h2 text-[1.875rem] lg:text-2xl lg:jds-h5 mb-3 leading-none v5-font-oxm lg:v5-font-default"
      style="--jds-rte-text-color: #fff;"
    >
      {{ block.settings.number }}
    </div>
    <div class="v-data-default v-data-tag jds-b3 lg:jds-b3 lg:jds-b2" style="--jds-rte-text-color: #fff;">
      {{ block.settings.title }}
    </div>
  </div>
{% else %}
  <div
    {{ block.shopify_attributes }}
    class="v-data-card flex flex-col items-center justify-center p-2 lg:p-4 text-center"
  >
    <div
      class="v-data-border v-data-number mb-1 lg:mb-1.5 jds-b1 lg:jds-h3 leading-none"
      style="--jds-rte-text-color: #fff;"
    >
      {{ block.settings.number }}
    </div>
    <div class="v-data-border v-data-tag jds-b3 lg:jds-b2" style="--jds-rte-text-color: #fff;">
      {{ block.settings.title }}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "V-数据卡片-默认（数字+标签）",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "样式",
      "options": [
        {
          "label": "默认（固定宽度）",
          "value": "default"
        },
        {
          "label": "样式二（等分宽度+PC端字号更大）",
          "value": "style2"
        }
      ],
      "default": "default"
    },
    {
      "type": "number",
      "id": "number",
      "label": "数字",
      "default": 100
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "标签",
      "default": "<p>Global Awards</p>"
    }
  ],
  "presets": [
    {
      "name": "V-数据卡片-默认（数字+标签）"
    }
  ]
}
{% endschema %}
