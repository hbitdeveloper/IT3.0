
<link
        rel="stylesheet"
        href="{{ 'blocks-image-text-three-column.css' | asset_url }}"
        media="print"
        onload="this.media='all'">
<noscript>
  {{ 'blocks-image-text-three-column.css' | asset_url | stylesheet_tag }}
</noscript>

<script src="{{ 'blocks-image-text-three-column.js' | asset_url }}" defer></script>

<div style="background-color: {{ block.settings.bg_color }};">
  <div {{ block.shopify_attributes }} {% if block.settings.anchor != blank %}anchor-target="{{block.settings.anchor | escape}}"{% endif %}
          class="image-text-three-column max-w-full {{ block.settings.page_width }} {% if settings.enable_animations_scroll %}scroll-trigger animate--slide-in{% endif %}">
      {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "V-一行三组图文",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1320px"
        }
      ],
      "default": "section-container-lg",
      "label": "组件宽度"
    },
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景颜色"
    }
  ],
  "presets": [
    {
      "name": "V-一行三组图文",
      "category": "图文组合",
      "blocks": [
        {
          "type": "v-heading-content",
          "settings": {
            "page_width": "w-full",
            "padding_top": 36,
            "padding_bottom": 32
          },
          "blocks": [
            {
