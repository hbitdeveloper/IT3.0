                "alignment": "left",
                "padding_top": 0,
                "padding_bottom": 0,
                "alignment_mb": "left",
                "text_color": "#666666"
              }
            }
          ]
        },
        {
          "type": "column-layout",
          "name": "图文",
          "settings": {
            "gap": 25
          },
          "blocks": [
            {
              "type": "block-container",
              "name": "第一组",
              "blocks": [
                {
