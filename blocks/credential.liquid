{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}

<div
  {{ block.shopify_attributes }}
  class="block-credential {% if settings.enable_animations_scroll %}scroll-trigger animate--slide-in{% endif %}"
  {% if block.settings.bg_color != blank %}
    style="background: {{block.settings.bg_color}};"
  {% endif %}
>
  <div
    class="section-padding max-w-full {{block.settings.page_width}}"
    {% if block.settings.anchor != blank %}
      anchor-target="{{block.settings.anchor | escape}}"
    {% endif %}
    style="{{ style }}"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "V-信任状",
  "tag": null,
  "blocks": [{ "type": "_credential-text" }, { "type": "_credential-img" }],
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "PC的组件宽度",
      "info": "MB端组件宽度固定和设计稿一致，不可修改",
      "default": "section-container-lg",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1312px"
        }
      ]
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "背景颜色"
    },
    {
      "type": "header",
      "content": "内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "上边距",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "下边距",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "V-信任状",
      "category": "内容展示",
      "blocks": [
        {
          "type": "_credential-text"
        }
      ]
    }
  ]
}
{% endschema %}
