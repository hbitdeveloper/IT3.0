
<div class="flex__item h-[19.125rem] lg:h-[28rem] w-[10.47rem] lg:w-[19.5625rem]" {{ block.shopify_attributes }}>
    <div class="relative rounded-md lg:rounded-xl flex flex-col justify-between px-[0.5rem] lg:px-5 bg-white h-full">
        {% liquid
            assign variants = block.settings.product.variants
            for variant in variants
                if variant.sku == block.settings.skuId
                    assign current_variant = variant
                    break
                endif
            endfor
            unless current_variant
                assign current_variant = block.settings.product.variants | first
            endunless
            assign image = block.settings.product_img
            if image == blank
                assign image = block.settings.product.featured_image
                if current_variant.featured_image != blank
                    assign image = current_variant.featured_image
                endif
            endif
        %}


        {% liquid
            assign product_url = block.settings.button_link
            if product_url == blank
                assign product_url = current_variant.url
            endif
        %}

        <a href="{{ product_url }}">
            <div class="product-img focus-zoom-container overflow-hidden pt-[0.25rem] lg:pt-0 w-[8.25rem] lg:w-[16.25rem] h-[8.25rem] lg:h-[16.25rem] mx-[0.625rem] lg:mx-[0.375rem]">
                {% if image == blank %}
                    {{ 'product-1' | placeholder_svg_tag }}
                {% else %}
                    {%- render 'responsive-image', image: image, image_class: 'object-cover focus-zoom w-full', width: 260, mwidth: 132 -%}
                {%endif%}
            </div>
        </a>

        <div class="product-content flex flex-col pt-[0.125rem] lg:pt-[0.5625rem]">
            <div class="product-content-main flex flex-col justify-between">
                <div class="product-title h-[2.6875rem] lg:h-[3.5rem] font-medium text-[0.875rem] leading-[1.375rem] lg:text-[1rem] text-[#1A1A1A] lg:leading-[1.625rem] text-overflow-2 mb-[0.78rem] lg:mb-4">
                    {% liquid

                        assign title = block.settings.product_title
                        if title == blank
                            if block.settings.product.metafields.custom.shortname != blank
                                assign title = block.settings.product.metafields.custom.shortname | strip_html
                            else
                                assign title = block.settings.product.title
                                if current_variant.title != 'Default Title'
                                    assign title = current_variant.title
                                endif
                            endif
                        endif
                    %}
                    {{ title }}
                </div>

                <div class="product-prices flex flex-col lg:flex-row lg:items-center gap-[0.5rem] lg:gap-2">

                    {% comment %} 如果开启了自动计算折扣价 {% endcomment %}
                    {%- if settings.open_auto_discount_price -%}
                        {% comment %} 自动计算 - 折后价格 {% endcomment %}
                        {%- assign auto_discount_price = current_variant.metafields.custom.auto_discount_price | times: 1 -%}
                        {%- if auto_discount_price > 0 -%}
                            {% comment %} 当前价格 {% endcomment %}
                            {% assign current_price = current_variant.price %}
                            {% comment %} 如果自动折扣价 小于 当前价，则取 自动折扣价 {% endcomment %}
                            {%- if auto_discount_price < current_variant.price -%}
                                {% assign current_price = auto_discount_price %}
                            {%- endif -%}
                        {%- else -%}
                            {% assign current_price = current_variant.price %}
                        {%- endif -%}
                    {%- else -%}
                        {% assign current_price = current_variant.price %}
                    {%- endif -%}

                    <div class="price price--on-sale font-semibold text-[1.125rem] lg:text-2xl text-[var(--jds-color-primary)] leading-[1.5rem] lg:leading-8">
                            <div class="real-price">{{ current_price | money }}</div>
                    </div>

                    <div class="origin-price font-400 origin-compare-price font-normal text-[0.875rem] lg:text-base text-[#999999] lg-[0.75rem] lg:leading-6 line-through">
                        {%- if current_variant.compare_at_price > current_price -%}
                             {{ current_variant.compare_at_price | money }}
                        {%- else -%}
                            {%- if current_variant.price > current_price -%}
                                {{ current_variant.price | money }}
                            {%- else -%}
                                <span class="opacity-0">&nbsp;</span>
                            {%- endif -%}
                        {%- endif -%}
                    </div>
                </div>
            </div>

            <a class="flex items-center justify-center w-full h-[2rem] lg:h-9 border rounded-[1.125rem] bg-[var(--jds-color-primary)] border-solid border-[var(--jds-color-primary)] mt-[0.5rem] mb-[1rem] lg:mt-[1rem] lg:mb-6
                font-medium lg:font-semibold lg:text-base text-[0.75rem] text-white leading-[1.25rem] lg:leading-4"
               href="{{ product_url }}">{{ section.settings.product_button_text }}</a>
        </div>

        {% render 'product-tag', product: block.settings.product, variant: current_variant %}
    </div>
</div>

{% schema %}
{
  "name": "BC Product Card",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "skuId",
      "label": "Product Sku"
    },
    {
      "type": "image_picker",
      "id": "product_img",
      "label": "Product Image"
    },
    {
      "type": "textarea",
      "id": "product_title",
      "label": "Product Title"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "商品按钮链接"
    }
  ],
  "presets": [
    {
      "name": "Product Card"
    }
  ]
}
{% endschema %}
