<div class="flex items-center lg:p-[0.75rem] bg-white/20 backdrop-blur-[6px] gap-[0.75rem] py-[1.5rem]">
    {%- render 'responsive-image', image: block.settings.icon, image_class: 'lg:w-[2.25rem] lg:h-[2.25rem] w-[1.25rem] h-[1.25rem] object-cover', mimage: block.settings.micon, width: 36 -%}
    <span class="font-semibold lg:text-[3rem] text-[1.75rem] lg:leading-[110%]">{{ block.settings.time }}</span>
    <div class="font-normal leading-[100%] lg:text-[1.25rem] text-[1rem]">
        <div>{{ block.settings.device }}</div>
        <div>{{ block.settings.power }}</div>
    </div>
</div>

{% schema %}
{
  "name": "Parameter",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "PC图标",
      "info": "建议尺寸：36 x 36"
    },
    {
      "type": "image_picker",
      "id": "micon",
      "label": "MB图标",
      "info": "建议尺寸：36 x 36"
    },
    {
      "type": "text",
      "id": "time",
      "label": "时间",
      "default": "7H"
    },
    {
      "type": "text",
      "id": "device",
      "label": "设备",
      "default": "AC Conditioner"
    },
    {
      "type": "text",
      "id": "power",
      "label": "功率",
      "default": "xxxx W"
    }
  ],
  "presets": [
    {
      "name": "Parameter"
    }
  ]
}
{% endschema %}
