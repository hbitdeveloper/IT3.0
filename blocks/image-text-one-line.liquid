<style>
    #shopify-block-{{ block.id }} {
        background-color: {{ block.settings.bg_color }};
    }

    @media screen and (min-width: 1024px) {
        #shopify-block-{{ block.id }} .v-column-layout-container .tile > div:first-child {
            flex: 0 0{{ block.settings.left_width | divided_by: 16.0 | append: "rem"}};
        }
    }

    @media screen and (max-width: 1023.98px) {
      {% if block.settings.mb_reverse %}
        #shopify-block-{{ block.id }} .v-column-layout-container .tile {
          flex-direction: column-reverse;
        }
      {%endif%}
    }
</style>

<div {{ block.shopify_attributes }} {% if block.settings.anchor != blank %}anchor-target="{{ block.settings.anchor | escape }}"{% endif %}
        class="max-w-full {{ block.settings.page_width }} {% if settings.enable_animations_scroll %}scroll-trigger animate--slide-in{% endif %} {% if block.settings.mb_reverse %}mb-reverse{% endif %}">
    {% content_for 'blocks' %}
</div>


{% schema %}
{
  "name": "V-图文并排",
  "class": "v-image-text-one-line-block",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1320px"
        },
        {
          "value": "w-full",
          "label": "铺满/100%"
        }
      ],
      "default": "section-container-lg",
      "label": "组件宽度"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景颜色"
    },
    {
      "type": "number",
      "id": "left_width",
      "label": "PC左边宽度",
      "default": 656
    },
    {
      "type": "checkbox",
      "id": "mb_reverse",
      "label": "MB反转图文顺序",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "V-图文并排",
      "category": "图文组合",
      "blocks": [
        {
          "type": "column-layout",
          "name": "图文",
          "settings": {
            "gap": 0,
            "gap_mb": 0,
            "padding_top": 36,
            "padding_bottom": 36
          },
          "blocks": [
            {
              "type": "v-image",
              "name": "图片 pc:655x400,mb:686x381",
              "settings": {
                "page_width": "w-full",
                "padding_top": 0,
                "pc_height": 400,
                "mb_height": 381,
                "padding_bottom": 0,
                "radius_1": 12,
                "radius_2": 0,
                "radius_3": 0,
                "radius_4": 12,
                "mb_radius_type": "custom",
                "radius_mb_1": 24,
                "radius_mb_2": 24,
                "radius_mb_3": 0,
                "radius_mb_4": 0
              }
            },
            {
              "type": "block-container",
              "name": "文案和按钮",
              "settings": {
                "justify_content": "center",
                "bg_color": "#f5f5f5",
                "padding_left": 80,
                "padding_right": 80,
                "padding_top_mb": 40,
                "padding_bottom_mb": 40,
                "padding_left_mb": 48,
                "padding_right_mb": 48,
                "radius_1": 0,
                "radius_2": 12,
                "radius_3": 12,
                "radius_4": 0,
                "mb_radius_type": "custom",
                "mb_padding_type": "custom",
                "radius_mb_1": 0,
                "radius_mb_2": 0,
                "radius_mb_3": 24,
                "radius_mb_4": 24
              },
              "blocks": [
                {
                  "type": "v-heading-content",
                  "settings": {
                    "page_width": "w-full",
                    "padding_top": 0,
                    "padding_bottom": 0
                  },
                  "blocks": [
                    {
                      "type": "_v-heading-content-heading",
                      "settings": {
                        "padding_bottom": 0,
                        "padding_top": 0,
                        "heading_size": "heading_4",
                        "alignment_mb": "left",
                        "alignment": "left",
                        "text_color": "#1A1A1A"
                      }
                    },
                    {
                      "type": "_v-heading-content-des",
                      "settings": {
                        "heading_size": "text_b2",
                        "padding_top": 8,
                        "padding_bottom": 0,
                        "alignment_mb": "left",
                        "alignment": "left",
                        "text_color": "#1A1A1A"
                      }
                    }
                  ]
                },
                {
                  "type": "button",
                  "name": "按钮组",
                  "settings": {
                    "page_width": "w-full",
                    "content_align": "left",
                    "padding_top": 24,
                    "padding_bottom": 0
                  },
                  "blocks": [
                    {
                      "type": "_button-group-btn",
                      "settings": {
                        "padding_top": 0,
                        "padding_bottom": 0,
                        "size": "medium"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
