{%- liquid
  case block.settings.country_type
    when 'us'
      assign country_display = 'US'
    when 'jp'
      assign country_display = 'JP'
    when 'uk'
      assign country_display = 'UK'
    when 'de'
      assign country_display = 'DE'
    when 'global'
      assign country_display = 'csr.global' | t
    else
      assign country_display = 'US'
  endcase
-%}
{%- capture padding-style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}
{%- capture radius-style -%}
  {% render 'size-radius', settings: block.settings %}
{%- endcapture -%}
{%- if block.settings.button_url != blank -%}
<a href="{{ block.settings.button_url }}"
  target="{% if section.settings.open_in_new_tab %}{{ '_blank' }}{% else %}{{ '_self' }}{% endif %}"
  data-country="{{block.settings.country_type}}"
  class="item-box block w-full lg:w-[26.5rem] overflow-hidden blocks-radius hover:opacity-90 transition-opacity duration-200 group" style="{{ radius-style }}">
{%- else -%}
<div class="item-box w-full lg:w-[26.5rem] overflow-hidden blocks-radius" data-country="{{block.settings.country_type}}" style="{{ radius-style }}">
{%- endif -%}
  <div
    class="blocks-image relative {{block.settings.page_width}}"
    style="background: {{block.settings.bg_color | default: 'transparent' }};">
      {%- liquid
          assign image = block.settings.image_poster
      -%}
      <div
        class="blocks-image-wrap relative overflow-hidden pb-[var(--mb-height)] lg:pb-[var(--pc-height)] transition-transform duration-300" style="--pc-height:{{block.settings.pc_height}}px;--mb-height: {{block.settings.mb_height | divided_by: 7.5}}vw;">
          {%- if image != blank -%}
              {% render 'responsive-image', image: image, image_class: 'blocks-image-pic w-full h-full top-0 left-0 absolute object-cover group-hover:scale-[1.03] transition-transform duration-300', mimage: image %}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder w-full h-full top-0 left-0 absolute object-cover group-hover:scale-[1.03] transition-transform duration-300' }}
          {%- endif -%}
      </div>
      {% comment %} 标签 {% endcomment %}
       <div style="--jds-rte-text-color:#666666;" class="absolute jds-c1 bg-white border-#EAEAEA lg:border border-2 lg:top-[0.625rem] lg:right-[0.625rem] lg:rounded-[0.25rem] lg:px-[0.375rem] lg:py-[0.25rem] top-[0.625rem] right-[0.625rem] rounded-[0.25rem] px-[0.375rem] py-[0.25rem]">{{ country_display }}</div>
  </div>
  <div class="section-padding bg-white lg:max-h-[15.125rem] lg:h-[15.125rem] max-h-[56rem] h-auto flex flex-col justify-between" style="{{padding-style}}">
    <div class="heading">
      <div
        class="jds-h6 blocks-text blocks-content-heading mb-[0.25rem] lg:mb-[0.25rem]"
        style="color: {{block.settings.text_color}};--active-color: {{block.settings.active_color}};"
      >
        {%- if block.settings.heading != blank -%}
        <div class="hidden lg:block"><div class="lg:line-clamp-2">{{ block.settings.heading }}</div></div>
        {%- endif -%}
        {%- if block.settings.mb_heading != blank -%}
        <div class="block lg:hidden">{{ block.settings.mb_heading }}</div>
        {%- endif -%}
      </div>
      <div
        class="jds-b3 font-medium blocks-content-subheading"
        style="color: {{block.settings.text_color_des}};--active-color: {{block.settings.active_color_des}};"
      >
        {%- if block.settings.heading_des != blank -%}
        <div class="hidden lg:block"><div class="lg:line-clamp-3">{{ block.settings.heading_des }}</div></div>
        {%- endif -%}
        {%- if block.settings.mb_heading_des != blank -%}
        <div class="block lg:hidden">{{ block.settings.mb_heading_des }}</div>
        {%- endif -%}
      </div>
    </div>
    <div class="flex justify-between items-center mt-[0.75rem] lg:mt-[1.125rem]">
      <div class="heading-bottom">
        <div
          class="jds-b3 font-medium blocks-content-subheading text-overflow-1 mb-[0.25rem] lg:mb-[0.375rem]"
          style="color: {{block.settings.text_color_time}};--active-color: {{block.settings.active_color_time}};"
        >
          {%- if block.settings.heading_time != blank -%}
          <div class="hidden lg:block">{{ block.settings.heading_time }}</div>
          {%- endif -%}
          {%- if block.settings.mb_heading_time != blank -%}
          <div class="block lg:hidden">{{ block.settings.mb_heading_time }}</div>
          {%- endif -%}
        </div>
        <div
          class="jds-c1 blocks-content-subheading text-overflow-1"
          style="color: {{block.settings.text_color_source}};--active-color: {{block.settings.active_color_source}};"
        >
          {%- if block.settings.heading_source != blank -%}
          <div class="hidden lg:block">{{ block.settings.heading_source }}</div>
          {%- endif -%}
          {%- if block.settings.mb_heading_source != blank -%}
          <div class="block lg:hidden">{{ block.settings.mb_heading_source }}</div>
          {%- endif -%}
        </div>
      </div>
      {%- if block.settings.button_text != blank -%}
        <jds-button href="{{ block.settings.button_url }}" target="{% if section.settings.open_in_new_tab %}{{ '_blank' }}{% else %}{{ '_self' }}{% endif %}" size="medium" class="ml-[0.75rem] lg:ml-[1rem]">{{ block.settings.button_text }}</jds-button>
      {%- endif -%}
    </div>
  </div>
{%- if block.settings.button_url != blank -%}
</a>
{%- else -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "通用卡片",
  "class": "block-cards",
  "settings": [
    {
      "type": "select",
      "id": "style_type",
      "options": [
        {
          "value": "default",
          "label": "基础配置"
        },
        {
          "value": "custom",
          "label": "开发者配置"
        }
      ],
      "default": "default",
      "label": "配置类型"
    },
    { "type": "color", "id": "bg_color", "label": "背景颜色", "visible_if": "{{ block.settings.style_type == 'custom' }}"},
    {
      "type": "header",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "content": "卡片圆角"
    },
    {
      "type": "range",
      "id": "radius_1",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "左上角圆角",
      "default": 0,
      "info": "移动端默认为设置的数值×0.75"
    },
    {
      "type": "range",
      "id": "radius_2",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "右上角圆角",
      "default": 0,
      "info": "移动端默认为设置的数值×0.75"
    },
    {
      "type": "range",
      "id": "radius_3",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "右下角圆角",
      "default": 0,
      "info": "移动端默认为设置的数值×0.75"
    },
    {
      "type": "range",
      "id": "radius_4",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "左下角圆角",
      "default": 0,
      "info": "移动端默认为设置的数值×0.75"
    },
    {
      "type": "header",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "content": "文本内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_left",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "visible_if": "{{ block.settings.style_type == 'custom' }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0
    },
    {
      "type": "header",
      "content": "图片配置"
    },
    { "type": "image_picker", "id": "image_poster", "label": "图片地址"},
    {
      "type": "number",
      "id": "pc_height",
      "label": "PC图片高度",
      "default": 282
    },
    {
      "type": "number",
      "id": "mb_height",
      "label": "MB图片高度",
      "default": 456
    },
    {
      "type": "header",
      "content": "内容配置"
    },
    {
      "type": "select",
      "id": "country_type",
      "options": [
        {
          "value": "us",
          "label": "US"
        },
        {
          "value": "jp",
          "label": "JP"
        },
        {
          "value": "uk",
          "label": "UK"
        },
        {
          "value": "de",
          "label": "DE"
        },
        {
          "value": "global",
          "label": "Global"
        }
      ],
      "default": "us",
      "label": "样式类型",
      "info": "请下拉选择切换国家"
    },
    { "type": "richtext", "id": "heading", "label": "PC Heading", "default": "<p>PC 默认标题内容</p>", "info": "该处富文本功能只支持换行和高亮标记" },
    { "type": "richtext", "id": "mb_heading", "label": "MB Heading", "default": "<p>MB 默认标题内容</p>", "info": "该处富文本功能只支持换行和高亮标记" },
    { "type": "color", "id": "text_color", "label": "标题文本颜色", "default": "#333333" },
    { "type": "color", "id": "active_color", "label": "标题文本强调颜色", "default": "#fd5000" },

    { "type": "richtext", "id": "heading_des", "label": "PC Heading Des", "default": "<p>PC 默认描述文案内容</p>" },
    { "type": "richtext", "id": "mb_heading_des", "label": "MB Heading Des", "default": "<p>MB 默认描述文案内容</p>" },
    { "type": "color", "id": "text_color_des", "label": "描述文本颜色", "default": "#333333" },
    { "type": "color", "id": "active_color_des", "label": "描述文本强调颜色", "default": "#fd5000" },

    { "type": "richtext", "id": "heading_time", "label": "PC Heading Time", "default": "<p>PC 默认标题内容</p>", "info": "该处富文本功能只支持换行和高亮标记" },
    { "type": "richtext", "id": "mb_heading_time", "label": "MB Heading Time", "default": "<p>MB 默认标题内容</p>", "info": "该处富文本功能只支持换行和高亮标记" },
    { "type": "color", "id": "text_color_time", "label": "年份文本颜色", "default": "#333333" },
    { "type": "color", "id": "active_color_time", "label": "年份文本强调颜色", "default": "#fd5000" },

    { "type": "richtext", "id": "heading_source", "label": "PC Heading Source", "default": "<p>PC 默认标题内容</p>", "info": "该处富文本功能只支持换行和高亮标记" },
    { "type": "richtext", "id": "mb_heading_source", "label": "MB Heading Source", "default": "<p>MB 默认标题内容</p>", "info": "该处富文本功能只支持换行和高亮标记" },
    { "type": "color", "id": "text_color_source", "label": "来源文本颜色", "default": "#333333" },
    { "type": "color", "id": "active_color_source", "label": "来源文本强调颜色", "default": "#fd5000" },

    { "type": "text", "id": "button_text", "label": "按钮文案", "default": "VIEW MORE" },
    { "type": "url", "id": "button_url", "label": "跳转链接" }
  ],
  "presets": [
    {
      "name": "Card Item",
      "settings": {
            "style_type": "custom",
            "bg_color": "",
            "radius_1": 12,
            "radius_2": 12,
            "radius_3": 12,
            "radius_4": 12,
            "padding_top": 20,
            "padding_bottom": 24,
            "padding_left": 24,
            "padding_right": 24,
            "image_poster": "shopify://shop_images/972x650.png",
            "pc_height": 282,
            "mb_height": 456,
            "country_type": "us",
            "heading": "<p>我是PC卡片的主标题</p>",
            "mb_heading": "<p>我是MB卡片的主标题</p>",
            "text_color": "#333333",
            "active_color": "#fd5000",
            "heading_des": "<p>我是PC卡片的描述</p>",
            "mb_heading_des": "<p>我是MB卡片的描述</p>",
            "text_color_des": "#333333",
            "active_color_des": "#fd5000",
            "heading_time": "<p>我是PC卡片的时间</p>",
            "mb_heading_time": "<p>我是MB卡片的时间</p>",
            "text_color_time": "#333333",
            "active_color_time": "#fd5000",
            "heading_source": "<p>我是PC卡片的出处</p>",
            "mb_heading_source": "<p>我是MB卡片的出处</p>",
            "text_color_source": "#333333",
            "active_color_source": "#fd5000",
            "button_text": "VIEW MORE",
            "button_url": ""
          }
    }
  ]
}
{% endschema %}
