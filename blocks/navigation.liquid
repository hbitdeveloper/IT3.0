{% style %}
    jky-navigation {display: block;}
    #blocks-navs-{{block.id}} .navigation-item:not(.navigation-item.active) {
        color: {{block.settings.tab_color}};
    }

    {% comment %} 超出样式 {% endcomment %}
    .blocks-navs .navigation-inner.navigation-inner--overflow {
        padding: 0 2.5rem;
    }
    @media screen and (max-width: 1024px) {
        .blocks-navs .navigation-inner:not(.mode-nav--button_line .section-container-lg) {
            width: 100%;
        }
    }
    .blocks-navs .navigation-inner:not(.blocks-navs .navigation-inner.navigation-inner--overflow) .navigation-action {
        display: none;
    }

    .navigation-action {
        background: var(--tab-bg);
    }
    .navigation-action.navigation--prev {
        box-shadow: 2px 0px 5px 0px rgba(0, 0, 0, 0.1);
    }
    .navigation-action.navigation--next {
        box-shadow: -2px 0px 5px 0px rgba(0, 0, 0, 0.1);
    }

    .blocks-navs .overflow-x-auto::-webkit-scrollbar {
        height: 0px;
        width: 0px;
    }

    .blocks-navs .overflow-x-auto::-webkit-scrollbar-track {
        background-color: transparent;
    }

    .blocks-navs .overflow-x-auto::-webkit-scrollbar-thumb {
        background-color: transparent;
        border-radius: 0px;
        box-shadow: none;
    }

    .blocks-navs .overflow-x-auto::-webkit-scrollbar-thumb:hover {
        background-color: transparent;
    }
    {% comment %} 超出样式 {% endcomment %}


    {% comment %} 胶囊样式 {% endcomment %}
    .mode-nav--button .navigation-slideline {
        top: 0.5rem;
        bottom: 0.5rem;
    }
    .mode-nav--button .navigation-slideline--inner {
        top: 0;
        bottom: 0;
        border-radius: 9999px;
    }
    @media screen and (max-width: 1024px) {
        .mode-nav--button .navigation-slideline {
            top: 0.375rem;
            bottom: 0.375rem;
        }
    }

    #blocks-navs-{{block.id}}.mode-nav--button .navigation-item.active {
        color: {{block.settings.active_tab_color}};
    }
    #blocks-navs-{{block.id}}.mode-nav--button .navigation-slideline--inner {
        background: {{block.settings.active_tab_bg}};
    }
    {% comment %} 胶囊样式 {% endcomment %}


    {% comment %} 长方形样式 {% endcomment %}
    .mode-nav--button_rectangle .navigation-slideline {
        top: 0.5rem;
        bottom: 0.5rem;
    }
    .mode-nav--button_rectangle .navigation-slideline--inner {
        top: 0;
        bottom: 0;
        border-radius: 0;
    }
    @media screen and (max-width: 1024px) {
        .mode-nav--button_rectangle .navigation-slideline {
            top: 0.375rem;
            bottom: 0.375rem;
        }
    }

    #blocks-navs-{{block.id}}.mode-nav--button_rectangle .navigation-item.active {
        color: {{block.settings.active_tab_color}};
    }
    #blocks-navs-{{block.id}}.mode-nav--button_rectangle .navigation-slideline--inner {
        background: {{block.settings.active_tab_bg}};
    }
    {% comment %} 长方形样式 {% endcomment %}

    {% comment %} 下划线样式 {% endcomment %}
    #blocks-navs-{{block.id}}.mode-nav--line .navigation-item.active, #blocks-navs-{{block.id}}.mode-nav--button_line .navigation-item.active {
        color: {{block.settings.active_tab_color}};
    }
    .type-type_page_nav .navigation-item.active {
        color: {{block.settings.active_tab_color}}!important;
    }

    #blocks-navs-{{block.id}}.mode-nav--line .navigation-slideline--inner, #blocks-navs-{{block.id}}.mode-nav--button_line .navigation-slideline--inner {
        background: {{block.settings.active_tab_bg}};
    }

    .mode-nav--line .navigation-slideline, .mode-nav--button_line .navigation-slideline {
        top: calc(100% - 0.25rem);
        bottom: 0;
    }
    .mode-nav--line .navigation-slideline--inner, .mode-nav--button_line .navigation-slideline--inner {
        top: 0;
        bottom: 0;
    }
    {% comment %} 下划线样式 {% endcomment %}

    jky-navigation.is-first .navigation-action.navigation--prev, jky-navigation.is-last .navigation-action.navigation--next {
        display: none!important;
    }
    @media screen and (max-width: 1024px) {
        .mode-nav--button.blocks-navs .navigation-inner.navigation-inner--overflow, .mode-nav--line.blocks-navs .navigation-inner.navigation-inner--overflow {
            padding: 0;
        }
        .blocks-navs .navigation-action:not(.mode-nav--button_line .navigation-action) {
            z-index: 10;
            width: 1.25rem;
            justify-content: flex-start;
        }
        .blocks-navs .navigation-action:not(.mode-nav--button_line .navigation-action)::before {
            content: '';
            position: absolute;
            width: 1.25rem;
            top: 0;
            bottom: 0;
            background: blue;
        }
        .blocks-navs .navigation-action.navigation--next:not(.mode-nav--button_line .navigation-action)::before {
            left: -1.24rem;
            transform: rotate(180deg);
            background: linear-gradient(-90deg, var(--light-bg) 0%, var(--tab-bg) 100%);
        }
        .blocks-navs .navigation-action.navigation--prev:not(.mode-nav--button_line .navigation-action)::before {
            right: -1.25rem;
            background: linear-gradient(-90deg, var(--light-bg) 0%, var(--tab-bg) 100%);
        }
        .blocks-navs .navigation-action.navigation--prev, .blocks-navs .navigation-action.navigation--next {
            box-shadow: none;
        }
    }

    {% comment %} JP样式 {% endcomment %}
    @media screen and (max-width: 1024px) {
        .mode-nav--button_line .navigation-action, .mode-nav--button_line .navigation-slideline {
            display: none;
        }

        .mode-nav--button_line.blocks-navs {
            position: static!important;
            opacity: 1!important;
        }
        .mode-nav--button_line.blocks-navs .navigation-inner {
            background: transparent;
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
        .mode-nav--button_line.blocks-navs {
            background: transparent!important;
        }
        .mode-nav--button_line.blocks-navs .navigation--container {
            flex-wrap: wrap;
            width: 100%;
            height: auto;
            column-gap: 0.5rem;
            row-gap: 0.625rem;
        }
        .mode-nav--button_line .navigation-item {
            height: 2.5rem;
            border: 1px solid #DDDDDD;
            box-shadow: 0px 4px 4px 0px rgba(0,0,0,0.06);
            border-radius: 0.25rem;
            font-size: 0.875rem;
            line-height: 1rem;
        }
        .mode-nav--button_line .navigation-item:not(.navigation-item.active) {
            color: #1A1A1A!important;
            background: #FFFFFF!important;
        }

        #blocks-navs-{{block.id}}.mode-nav--button_line .navigation-item.active {
            color: #fff!important;
            background: var(--jds-color-primary)!important;
            border: solid 1px transparent;
        }
    }
    {% comment %} JP样式 {% endcomment %}


    .blocks-navs.pos_show {
        position: fixed;
        top: 0;
        z-index: 98;
        left: 0;
        right: 0;
    }
    .blocks-navs:not([loaded]) {
        opacity: 0;
    }
{% endstyle %}

<div
    {{ block.shopify_attributes }}
    class="cal_scroll_target type-{{block.settings.nav_type}} {% if block.settings.show_type == 'pos_overflow' %}hidden{% endif %} blocks-navs mode-{{block.settings.nav_mode}} px-3 lg:px-0" id="blocks-navs-{{block.id}}"
    style="--light-bg:{{block.settings.bg_color | color_modify: 'alpha', 0}};--tab-bg:{{block.settings.bg_color}};--active-tab-bg:{{block.settings.active_tab_bg}};--active-tab-color:{{block.settings.active_tab_color}};--tab-color:{{block.settings.tab_color}};background:{{block.settings.bg_color}};"
>
    <jky-navigation
        mode="{{block.settings.nav_mode}}"
        show-type="{{block.settings.show_type}}"
        type="{{block.settings.nav_type}}"
        {% if block.settings.last_hide == true %}last-hide=""{% endif %}
        class=" {% if block.settings.is_border == true %} border-b border-[#C6C7C8] border-solid border-t-0 border-l-0 border-r-0{% endif %} {% if block.settings.nav_type == 'type_page_nav' %}block section-container-lg flex flex-wrap lg:flex-nowrap{% endif %}"
    >
        {% comment %} 页面标题 {% endcomment %}
        {%- if block.settings.nav_type == 'type_page_nav' and block.settings.heading != blank -%}
            <div class="text_b2 flex lg:block flex-auto lg:flex-1 items-center lg:!leading-[3.25rem] text-[#1A1A1A]">
                <span class="flex-1 text-ellipsis-1">{{block.settings.heading}}</span>
                {%- if block.settings.btn_text != blank -%}
                    <a {% if block.settings.open_in_new_tab %}
                            target="_blank" rel="noopener noreferrer"
                        {% endif %}
                        {% if block.settings.btn_url != blank %}href="{{block.settings.btn_url}}"{% endif %}
                        class="flex lg:hidden text_b2 ml-5 rounded my-[0.375rem] items-center justify-center px-2 py-1"
                        style="background:{{block.settings.btn_bg}};color:{{block.settings.btn_color}};">{{block.settings.btn_text}}</a>
                {%- endif -%}
            </div>
        {%- endif -%}

        {% comment %} 导航主体 {% endcomment %}
        <div
            class="{% if block.settings.nav_type == 'type_page_nav' %}max-w-screen-md{% else %}section-container-lg{% endif %} navigation-inner overflow-hidden box-border relative"
        >
            <div class="w-full overflow-x-auto">
                <div class="navigation--container relative
            items-center {{block.settings.desktop_layout}} {{block.settings.mobile_layout}} w-max
            flex h-11 lg:h-[3.25rem]">
                    {% content_for 'blocks' %}
                    <div class="navigation-slideline absolute left-0 right-0">
                        <div class="navigation-slideline--inner absolute transition-all"></div>
                    </div>
                </div>
            </div>

            <div class="navigation-action navigation--prev absolute w-10 left-0 top-0 bottom-0 cursor-pointer flex items-center justify-center">
                {% render 'icon-arrow', class: 'w-4 h-4 rotate-180', color: block.settings.tab_color %}
            </div>
            <div class="navigation-action navigation--next absolute w-10 right-0 top-0 bottom-0 cursor-pointer flex items-center justify-center">
                {% render 'icon-arrow', class: 'w-4 h-4', color: block.settings.tab_color  %}
            </div>
        </div>

        {%- if block.settings.nav_type == 'type_page_nav' and block.settings.btn_text != blank -%}
            <a
                {% if block.settings.btn_url != blank %}href="{{block.settings.btn_url }}"{% endif %} {% if block.settings.open_in_new_tab %}
                    target="_blank" rel="noopener noreferrer"
                {% endif %}
                class="hidden ml-12 rounded my-2.5 lg:flex items-center justify-center px-4"
                style="background:{{block.settings.btn_bg}};color:{{block.settings.btn_color}};"
            >{{block.settings.btn_text}}</a>
        {%- endif -%}
    </jky-navigation>
</div>
<script src="{{ 'blocks-navigation.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "V-导航栏",
  "class": "blocks-nav-main",
  "blocks": [{"type": "_nav-item"}],
  "settings": [
    { "type": "header", "content": "类型配置" },
    {
        "type": "select",
        "id": "nav_type",
        "options": [
            {
                "value": "type_nav",
                "label": "样式一（无标题按钮）"
            },
            {
                "value": "type_page_nav",
                "label": "样式二（含标题按钮）"
            }
        ],
        "default": "type_nav",
        "label": "组件类型"
    },

    { "type": "header", "content": "页面导航配置" },
    { "type": "text", "id": "heading", "label": "导航标题", "default": "Jackery Solar Generator 5000 Plus", "visible_if": "{{ block.settings.nav_type == 'type_page_nav' }}" },
    { "type": "text", "id": "btn_text", "label": "导航按钮文案", "default": "Shop Now", "visible_if": "{{ block.settings.nav_type == 'type_page_nav' }}" },
    { "type": "url", "id": "btn_url", "label": "导航按钮链接", "visible_if": "{{ block.settings.nav_type == 'type_page_nav' and block.settings.btn_text != blank }}" },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "是否新开标签页", "default": false, "visible_if": "{{ block.settings.nav_type == 'type_page_nav' and block.settings.btn_text != blank }}" },
    { "type": "color", "id": "btn_bg", "label": "导航按钮背景颜色", "default": "#fd5000", "visible_if": "{{ block.settings.nav_type == 'type_page_nav' and block.settings.btn_text != blank }}" },
    { "type": "color", "id": "btn_color", "label": "导航按钮文案颜色", "default": "#FFFFFF", "visible_if": "{{ block.settings.nav_type == 'type_page_nav' and block.settings.btn_text != blank }}" },


    { "type": "header", "content": "导航样式配置" },
    {
        "type": "select",
        "id": "nav_mode",
        "options": [
            {
                "value": "nav--button",
                "label": "PC/MB胶囊"
            },
            {
                "value": "nav--line",
                "label": "PC/MB下划线"
            },
            {
                "value": "nav--button_line",
                "label": "PC下划线/MB长方形平铺"
            },
            {
                "value": "nav--button_rectangle",
                "label": "PC/MB长方形"
            }
        ],
        "default": "nav--button",
        "label": "导航样式"
    },
    {
        "type": "select",
        "id": "show_type",
        "options": [
            {
                "value": "pos_overflow",
                "label": "超过第一屏后"
            },
            {
                "value": "pos_sticky",
                "label": "固定位置"
            }
        ],
        "default": "pos_overflow",
        "label": "出现形式",
        "info": "导航样式为：PC下划线/MB长方形时，必须选中固定位置"
    },
    {
        "type": "checkbox",
        "id": "last_hide",
        "label": "是否隐藏",
        "default": false,
        "info": "超过最后一个锚点内容后，是否隐藏导航",
        "visible_if": "{{ block.settings.nav_type != 'type_nav' or block.settings.nav_mode != 'nav--button_line' }}"
    },
    {
        "type": "select",
        "id": "desktop_layout",
        "options": [
            {
                "value": "lg:mr-auto lg:ml-0",
                "label": "左"
            },
            {
                "value": "lg:mx-auto",
                "label": "中"
            },
            {
                "value": "lg:ml-auto lg:mr-0",
                "label": "右"
            }
        ],
        "default": "lg:mx-auto",
        "label": "PC布局",
        "visible_if": "{{ block.settings.nav_type != 'type_page_nav' }}"
    },
    {
        "type": "select",
        "id": "mobile_layout",
        "options": [
            {
                "value": "mr-auto ml-0",
                "label": "左"
            },
            {
                "value": "mx-auto",
                "label": "中"
            },
            {
                "value": "ml-auto mr-0",
                "label": "右"
            }
        ],
        "default": "mx-auto",
        "label": "MB布局",
        "visible_if": "{{ block.settings.nav_type != 'type_nav' or block.settings.nav_mode != 'nav--button_line' }}"
    },
    { "type": "color", "id": "bg_color", "label": "背景颜色", "default": "#fd5000" },
    { "type": "color", "id": "active_tab_bg", "label": "选中Tab背景颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "active_tab_color", "label": "选中Tab文字颜色", "default": "#fd5000" },
    { "type": "color", "id": "tab_color", "label": "Tab文字颜色", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "is_border", "label": "是否加下边框线", "default": false},
  ],
  "presets": [
    {
      "name": "V-导航栏",
      "category": "导航",
      "blocks": [
          {"type": "_nav-item"},
          {"type": "_nav-item"}
      ]
    }
  ]
}
{% endschema %}
