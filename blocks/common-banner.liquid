{% liquid
    assign pc_height = block.settings.pc_height
    assign mb_height = block.settings.mb_height

    if block.settings.enable_custom_pc_height
        assign pc_height = block.settings.custom_pc_height
    endif
    if block.settings.enable_custom_mb_height
        assign mb_height = block.settings.custom_mb_height
    endif
%}

{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}

{{ 'block-v-common-banner.min.css' | asset_url | stylesheet_tag }}

<div
  class="common-banner-wrapper w-full section-padding {% if settings.enable_animations_scroll %}scroll-trigger animate--slide-in{% endif %}"
  {% if block.settings.anchor != blank %}
    anchor-target="{{block.settings.anchor | escape}}"
  {% endif %}
  data-autoplay="{{ block.settings.swiper_auto }}"
  data-loop="{{ block.settings.swiper_loop }}"
  data-delay="{{ block.settings.swiper_delay }}"
  style="--pc-banner-h:{{ pc_height}};--mb-banner-h:{{ mb_height}};{{ style }}"
>
  <div class="swiper">
    <div class="swiper-wrapper">
      {% content_for 'blocks' %}
    </div>
    <div class="swiper-arrow swiper-button-next hidden"></div>
    <div class="swiper-arrow swiper-button-prev hidden"></div>
    <div class="slideshow-pagination"></div>
  </div>
</div>

<script type="module">
  const COMMON_BANNER_SCRIPT_ID = 'block-v-common-banner-script';
  const COMMON_BANNER_SCRIPT_SRC = '{{ "block-v-common-banner.min.js" | asset_url }}';

  {% comment %} 单例 Promise 方案 {% endcomment %}
  if (!window.commonBannerLoadPromise) {
    window.commonBannerLoadPromise = new Promise((resolve, reject) => {
      const existingScript = document.getElementById(COMMON_BANNER_SCRIPT_ID);

      if (existingScript) {
        if (existingScript.dataset.loaded === 'true') {
          resolve();
          return;
        }

        existingScript.addEventListener('load', resolve, { once: true });
        existingScript.addEventListener('error', reject, { once: true });
        return;
      }

      const script = document.createElement('script');
      script.id = COMMON_BANNER_SCRIPT_ID;
      script.src = COMMON_BANNER_SCRIPT_SRC;
      script.async = true;

      script.addEventListener('load', () => {
        script.dataset.loaded = 'true';
        resolve();
      }, { once: true });

      script.addEventListener('error', (event) => {
        console.warn('CommonBanner: script load failed.', event);
        reject(event);
      }, { once: true });

      document.body.appendChild(script);
    });
  }
</script>
