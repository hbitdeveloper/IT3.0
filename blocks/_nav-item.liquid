<div
    {{ block.shopify_attributes }}
    class="navigation-item text-sm lg:text-lg font-medium cursor-pointer px-3 lg:px-7 h-full flex items-center select-none"
    style="--nav-item-background-color: {{ block.settings.bg_color }}; --nav-item-background-image: url({{ block.settings.bg_image | image_url: width: 440 }}); --nav-item-background-image-mb: url({{ block.settings.bg_image_mb | image_url: width: 256 }});"
    target="{{block.settings.anchor | escape}}"
    {% if block.settings.anchor != blank %}
      data-anchor="{{block.settings.anchor | escape}}"
    {% endif %}
    data-ga-event="5.0_products_details_page_user_clicks" 
    data-ga-action="click" 
    data-ga-params-module="Directory" 
    data-ga-params-position="{{block.settings.heading | escape}}"
    data-ga-params-product_spu_name="{{ product.title | escape }}"
>
    {{block.settings.heading | escape}}
</div>

{% schema %}
{
  "name": "导航项",
  "class": "h-full w-fit relative z-10",
  "settings": [
    { "type": "text", "id": "heading", "label": "导航名称", "default": "FEATURES" },
    { "type": "text", "id": "anchor", "label": "锚点", "default": "FEATURES" },
    { "type": "color", "id": "bg_color", "label": "背景颜色", "info": "只在‘V5-活动页-导航’下生效" },
    { "type": "image_picker", "id": "bg_image", "label": "PC背景图片" , "info": "只在‘V5-活动页-导航’下生效，推荐尺寸：440x176" },
    { "type": "image_picker", "id": "bg_image_mb", "label": "MB背景图片" , "info": "只在‘V5-活动页-导航’下生效，推荐尺寸：256x152" }
  ],
  "presets": [
    {
      "name": "导航项"
    }
  ]
}
{% endschema %}
