{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}

{%- liquid
  # 判断是否登录
  assign is_login = false
  if customer
    assign is_login = true
  endif

  # 判断是否展示模块
  assign module_show_timing = block.settings.module_show_timing | default: 'default'
  assign show_module = true
  if module_show_timing == 'show_before_login' and is_login == true
    assign show_module = false
  endif
  if module_show_timing == 'show_after_login' and is_login == false
    assign show_module = false
  endif

  if show_module == true
    # 排版
    # 历史数据配置 转换为 JDS的字号class
    capture pc_text_size
      render 'v-font-size-class', fs: block.settings.heading_size, default_class: 'heading_4'
    endcapture
    assign pc_heading_class = pc_text_size | strip

    capture mb_text_size
      render 'v-font-size-class', fs: block.settings.mb_heading_size, default_class: 'heading_4'
    endcapture
    assign mb_heading_class = mb_text_size | strip

    assign mb_content_type = block.settings.mb_content_type | default: 'default'
    if mb_content_type == 'default'
      assign mb_heading_class = pc_heading_class
    endif

    # 换算字重
    capture pc_end_font_weight
      render 'v-font-weight-number', fw: block.settings.font_weight
    endcapture
    assign pc_end_font_weight = pc_end_font_weight | strip
    if pc_end_font_weight != blank
      assign pc_style = '--jds-font-weight:' | append: pc_end_font_weight | append: ';'
    endif

    if mb_content_type == 'default'
      assign mb_style = pc_style
    else
      capture mb_end_font_weight
        render 'v-font-weight-number', fw: block.settings.mb_font_weight
      endcapture
      assign mb_end_font_weight = mb_end_font_weight | strip
      if mb_end_font_weight != blank
        assign mb_style = '--jds-font-weight:' | append: mb_end_font_weight | append: ';'
      endif
    endif

    # 对齐方式
    assign pc_align = block.settings.alignment
    assign mb_align = block.settings.alignment_mb
    assign align_class = ''
    if mb_align != blank
      assign align_class = 'text-' | append: mb_align | append: ' lg:text-' | append: pc_align
    endif
  endif
-%}

{% if show_module == true %}
  <div
    {{ block.shopify_attributes }}
    class="blocks-text blocks-content-subheading section-padding {{ block.settings.font_family }} {{ align_class }}"
    style="color: {{block.settings.text_color}};--jds-rte-text-color: {{block.settings.text_color}};--active-color: {{block.settings.active_color}};{{style}}"
  >
    <div
      class="hidden lg:block {{ pc_heading_class }}"
      {% if pc_style != blank %}
        style="{{ pc_style }}"
      {% endif %}
    >
      {{ block.settings.heading | newline_to_br }}
    </div>
    <div
      class="block lg:hidden {{ mb_heading_class }}"
      {% if mb_style != blank %}
        style="{{ mb_style }}"
      {% endif %}
    >
      {{ block.settings.mb_heading | newline_to_br }}
    </div>
  </div>
{% endif %}

