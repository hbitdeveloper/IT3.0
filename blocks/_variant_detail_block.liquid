{%- assign sid = product.selected_or_first_available_variant.id | append: '' -%}
  <div pid="{{block.settings.variant_id}}" class="product-blocks-detail__variant_block {% if sid != block.settings.variant_id %}hide{% endif %}" {{ block.shopify_attributes }}>
      {% content_for 'blocks' %} 
  </div>
{% schema %}
  {
    "name": "多变体功能块",
    "settings": [
      { "type": "text", "id": "heading", "label": "变体名称标识", "info": "仅用于后台自定义配置时" },
      { "type": "text", "id": "variant_id", "label": "变体id", "info": "只会在对应的变体下显示" },
    ],
    "blocks": [{
      "type": "product-table"
    },{
      "type": "heading-content"
    },{
      "type": "video"
    },{
      "type": "image"
    },{
      "type": "richtext"
    }],
    "presets": [
      {
        "name": "多变体功能块"
      }
    ]
  }
{% endschema %}