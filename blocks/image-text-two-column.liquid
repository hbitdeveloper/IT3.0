<style>
    #shopify-block-{{ block.id }} {
        background-color: {{ block.settings.bg_color }};
    }
</style>

<div {{ block.shopify_attributes }} {% if block.settings.anchor != blank %}anchor-target="{{block.settings.anchor | escape}}"{% endif %}
        class="max-w-full {{ block.settings.page_width }} {% if settings.enable_animations_scroll %}scroll-trigger animate--slide-in{% endif %}">
    {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "V-一行两组图文",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
          "value": "section-container-lg",
          "label": "大版心/1320px"
        }
      ],
      "default": "section-container-lg",
      "label": "组件宽度"
    },
    { "type": "text", "id": "anchor", "label": "锚点定位ID(确保唯一性,禁止空格和-符号)" },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景颜色"
    }
  ],
  "presets": [
    {
      "name": "V-一行两组图文",
      "category": "图文组合",
      "blocks": [
        {
          "type": "v-heading-content",
          "settings": {
            "page_width": "w-full",
            "padding_top": 36,
            "padding_bottom": 32
          },
          "blocks": [
            {
              "type": "_v-heading-content-heading",
              "settings": {
                "padding_bottom": 16,
                "padding_top": 0,
                "alignment": "left",
                "heading_size": "heading_3",
                "alignment_mb": "left",
                "text_color": "#1A1A1A"
              }
            },
            {
              "type": "_v-heading-content-des",
              "settings": {
                "alignment": "left",
                "padding_top": 0,
                "padding_bottom": 0,
                "alignment_mb": "left",
                "text_color": "#666666"
              }
            }
          ]
        },
        {
          "type": "column-layout",
          "name": "图文",
          "settings": {
            "gap": 25
          },
          "blocks": [
            {
              "type": "block-container",
              "name": "第一组",
              "blocks": [
                {
                  "type": "v-image",
                  "name": "图片 pc:646x480,mb:686x644",
                  "settings": {
                    "radius_1": 12,
                    "radius_2": 12,
                    "radius_3": 12,
                    "radius_4": 12,
                    "page_width": "w-full",
                    "padding_top": 0,
                    "pc_height": 480,
                    "mb_height": 644,
                    "padding_bottom": 0
                  }
                },
                {
                  "type": "v-heading-content",
                  "settings": {
                    "page_width": "w-full",
                    "padding_top": 32,
                    "padding_bottom": 36
                  },
                  "blocks": [
                    {
                      "type": "_v-heading-content-heading",
                      "settings": {
                        "alignment": "left",
                        "heading_size": "heading_4",
                        "padding_bottom": 8,
                        "padding_top": 0,
                        "alignment_mb": "left",
                        "text_color": "#1A1A1A"
                      }
                    },
                    {
                      "type": "_v-heading-content-des",
                      "settings": {
                        "alignment": "left",
                        "heading_size": "text_b2",
                        "padding_top": 0,
                        "padding_bottom": 0,
                        "alignment_mb": "left",
                        "text_color": "#1A1A1A"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "block-container",
              "name": "第二组",
              "blocks": [
                {
                  "type": "v-image",
                  "name": "图片 pc:646x480,mb:686x644",
                  "settings": {
                    "radius_1": 12,
                    "radius_2": 12,
                    "radius_3": 12,
                    "radius_4": 12,
                    "page_width": "w-full",
                    "padding_top": 0,
                    "pc_height": 480,
                    "mb_height": 644,
                    "padding_bottom": 0
                  }
                },
                {
                  "type": "v-heading-content",
                  "settings": {
                    "page_width": "w-full",
                    "padding_top": 32,
                    "padding_bottom": 36
                  },
                  "blocks": [
                    {
                      "type": "_v-heading-content-heading",
                      "settings": {
                        "alignment": "left",
                        "heading_size": "heading_4",
                        "padding_bottom": 8,
                        "padding_top": 0,
                        "alignment_mb": "left",
                        "text_color": "#1A1A1A"
                      }
                    },
                    {
                      "type": "_v-heading-content-des",
                      "settings": {
                        "alignment": "left",
                        "heading_size": "text_b2",
                        "padding_top": 0,
                        "padding_bottom": 0,
                        "alignment_mb": "left",
                        "text_color": "#1A1A1A"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
