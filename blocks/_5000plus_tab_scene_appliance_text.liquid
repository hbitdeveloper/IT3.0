<div class="lg:text-[0.875rem] text-[0.75rem] font-400 flex lg:flex-col lg:items-start items-center gap-[1rem] justify-between">
    <div class="flex items-center w-[8.5rem] lg:w-auto">
        <div class="min-w-5 w-5 h-5 lg:w-6 lg:h-6 mr-[0.375rem]">
            {% if block.settings.pcimage != blank %}
                {% render 'responsive-image', image: block.settings.pcimage, image_class: 'w-full h-full object-cover', mimage: block.settings.mimage %}
            {% else %}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder w-full h-full object-cover' }}
            {% endif %}
        </div>
        <div class="flex items-center lg:items-baseline">
            <span class="lg:text-[1.75rem] font-600 text-[1.25rem] lg:mr-[0.5rem] mr-[0.375rem] lg:leading-[110%] leading-[100%]">{{ block.settings.hours }}</span>
            <span class="leading-[100%]">{{ block.settings.appliance }}</span>
        </div>
    </div>
    <div class="hidden lg:block leading-[100%] w-[12.125rem] lg:w-auto">{{ block.settings.note }}</div>
    <div class="lg:hidden leading-[100%] w-[12.125rem] lg:w-auto">{{ block.settings.mb_note | default: block.settings.note }}</div>
</div>

{% schema %}
{
  "name": "V5营销页-Tab场景电器-Item文案",
  "settings": [
    {
      "type": "image_picker",
      "id": "pcimage",
      "label": "PC图标",
      "info": "建议尺寸：48 x 48"
    },
    {
      "type": "image_picker",
      "id": "mimage",
      "label": "MB图标",
      "info": "建议尺寸：40 x 40"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "时间",
      "default": "30H"
    },
    {
      "type": "text",
      "id": "appliance",
      "label": "设备名称",
      "default": "Light"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "PC描述文案",
      "default": "<p>Support light from<br> xxW to xx W for<br> xxxH to xxxH</p>"
    },
    {
      "type": "richtext",
      "id": "mb_note",
      "label": "MB描述文案",
      "default": "<p>Support light from<br> xxW to xx W for<br> xxxH to xxxH</p>"
    }
  ],
  "presets": [
    {
      "name": "文案"
    }
  ]
}
{% endschema %}
