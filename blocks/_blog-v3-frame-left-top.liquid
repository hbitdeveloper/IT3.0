{% doc %}
  @description V3博客内容区 - 左上区
  @param { string } h1_title 标题，仅博客聚合页使用
{% enddoc %}

<div class="blog-v3-frame-left-top lg:w-[43.75rem]" {{ block.shopify_attributes }}>
  {% if template == 'blog.blog-v3-category-detail' %}
    {% content_for 'block', type: '_blog-v3-detail-feature', id: 'blogV3DetailFeature' %}
  {% else %}
    {% content_for 'block', type: '_blog-v3-feature', id: 'blogV3Feature', h1_title: h1_title %}
  {% endif %}
</div>

{% schema %}
{
  "name": "V3博客内容区 - 左上区",
  "tag": null,
  "blocks": [],
  "settings": [],
  "presets": [
    {
      "name": "V3博客内容 - 左上区",
      "category": "Blog-V3",
      "blocks": [
        {
          "id": "blogV3Feature",
          "type": "_blog-v3-feature",
          "static": true,
          "name": "博客聚合页-精选文章"
        },
        {
          "id": "blogV3DetailFeature",
          "type": "_blog-v3-detail-feature",
          "name": "博客分类页-精选文章",
          "static": true
        }
      ]
    }
  ]
}
{% endschema %}
