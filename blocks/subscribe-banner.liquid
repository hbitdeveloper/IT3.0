{%- liquid
    assign time_now = 'now' | date: '%s'
    assign is_show = false
    assign begin_time = 0
    if block.settings.begin_time != blank
      assign begin_time = block.settings.begin_time | date: '%s'
    endif

    assign end_time = 0
    if block.settings.end_time != blank
      assign end_time = block.settings.end_time | date: '%s'
    endif

    if begin_time == 0 and end_time == 0
      assign is_show = true
    endif

    if begin_time != 0 and end_time == 0 and begin_time < time_now
      assign is_show = true
    endif

    if begin_time == 0 and end_time != 0 and end_time > time_now
      assign is_show = true
    endif

    if begin_time != 0 and end_time != 0 and end_time > time_now and begin_time < time_now
      assign is_show = true
    endif
-%}

{%- if is_show == true -%}
  {% style %}
    .blocks-subscribe-banner .field_error-tips {
      position: absolute;
      top: calc(100% + 1px);font-size: 12px;font-weight: 400;color: var(--error-color);
    }

    .blocks-subscribe-banner jky-checkbox {
      flex: unset;
    }

    @media screen and (max-width: 1024px) {
      .subscribe-banner-content .blocks-heading-content:not(.blocks-subscribe-banner-form .blocks-heading-content) .blocks-content-subheading, .subscribe-banner-content .blocks-heading-content:not(.blocks-subscribe-banner-form .blocks-heading-content) .blocks-content-heading {
        text-align: center;
      }
    }

    {%- if block.settings.align_right == 'right' -%}
      @media screen and (min-width: 1024px) {
        .subscribe-banner-content.subs-banner-right-group .blocks-heading-content:not(.blocks-subscribe-banner-form .blocks-heading-content) .blocks-content-subheading,.subscribe-banner-content.subs-banner-right-group .blocks-heading-content:not(.blocks-subscribe-banner-form .blocks-heading-content) .blocks-content-heading {
          text-align: right;
        }
      }
    {%- endif -%}

    .type-subs_mode_pic .subs_mode_pic--show {
      display: block;
    }
  {% endstyle %}

  {%- capture style -%}
    {% render 'spacing-padding', settings: block.settings %}
  {%- endcapture -%}
  <div
      {% if block.settings.anchor != blank %}anchor-target="{{block.settings.anchor | escape}}"{% endif %}
      class="group blocks-subscribe-banner section-padding responsive-h w-full type-subs_mode_pic-{{section.id}} type-subs_mode_pic
      relative flex justify-center items-center {% if settings.enable_animations_scroll %}scroll-trigger animate--slide-in{% endif %}"
      style="--desktop-height:{{block.settings.pc_height | divided_by: 16.0}}rem;--mobile-height:{{block.settings.mb_height | divided_by: 32.0}}rem;{{style}}"
      {{ block.shopify_attributes }}
  >

    {%- if block.settings.img_pc != blank -%}
      {%- assign mimage = block.settings.img_pc -%}
      {%- if block.settings.img_mb != blank -%}
          {%- assign mimage = block.settings.img_mb -%}
      {%- endif -%}
      {% render 'responsive-image', image: block.settings.img_pc, image_class: 'blocks-image-pic w-full h-full inset-0 absolute object-cover', mimage: mimage %}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full inset-0 absolute object-cover' }}
    {%- endif -%}

    <div class="subscribe-banner-content section-container-lg relative z-2
    {% if block.settings.align_right == 'right' %}subs-banner-right-group items-end{% endif %}
    h-full lg:h-fit pt-14 lg:pt-0 pb-16 lg:pb-0 lg:justify-between flex flex-col {% if block.settings.align_top_mb == 'top' %}subs-banner-top_mb justify-start{% else %}justify-between{% endif %}
    "
    >
        {% content_for 'blocks' %}
    </div>
  </div>
{%- endif -%}

