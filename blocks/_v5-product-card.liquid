{% render 'v5-base-product-card',
  product: block.settings.product,
  variant_id: block.settings.variant_id,
  block_settings: block.settings,
  link_target: section.settings.link_target,
  product_show_num: section.blocks.size,
  show_compare: section.settings.show_compare
%}

{% schema %}
{
  "name": "v5-产品卡片",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "选择产品"
    },
    {
      "type": "number",
      "id": "variant_id",
      "label": "变体ID",
      "visible_if": "{{ block.settings.product != blank }}"
    },
    {
      "type": "image_picker",
      "id": "product_scene_img",
      "label": "场景图（仅PC端显示）",
      "visible_if": "{{ block.settings.product != blank }}",
      "info": "推荐尺寸：648 x 424、424 x 424"
    },
    {
      "type": "image_picker",
      "id": "product_info_img_pc",
      "label": "PC端设备信息图",
      "visible_if": "{{ block.settings.product != blank }}",
      "info": "推荐尺寸：608 x 82、392 x 82"
    },
    {
      "type": "image_picker",
      "id": "product_info_img_mb",
      "label": "移动端设备信息图",
      "visible_if": "{{ block.settings.product != blank }}",
      "info": "推荐尺寸：638 x 138（2倍图）"
    }
  ],
  "presets": [
    {
      "name": "v5-产品卡片",
      "category": "Basic"
    }
  ]
}
{% endschema %}
