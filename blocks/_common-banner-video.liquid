{% comment %} 通用Banner - 视频 - 后续开发 {% endcomment %}
<div>
  {% content_for 'blocks' %}
</div>


{% schema %}
  {
    "name": "通用Banner - 视频",
    "blocks": [{ "type": "v-heading-content" },{"type": "_button-group"}],
    "settings": [
      {
        "type": "header",
        "content": "视频"
      },
      {
        "type": "header",
        "content": "桌面端视频相关配置"
      },
      {
        "type": "image_picker",
        "id": "poster_pc",
        "label": "封面地址",
        "info": "请按照组件选择的高度配置，推荐尺寸: 1920x800 或 1920x640"
      },
      {
        "type": "url",
        "id": "video_pc_url",
        "label": "视频地址",
        "info": "本地视频建议视频大小不超过10MB，不配置则显示图片，youtube视频地址格式：https://www.youtube.com/embed//视频ID?si=跟踪ID"
      },
      {
        "type": "header",
        "content": "移动端视频相关配置"
      },
      {
        "type": "image_picker",
        "id": "poster_mb",
        "label": "封面地址",
        "info": "推荐尺寸: 750x1000"
      },
      {
        "type": "url",
        "id": "video_mb_url",
        "label": "视频地址",
        "info": "本地视频建议视频大小不超过10MB，不配置则显示图片，youtube视频地址格式：https://www.youtube.com/embed//视频ID?si=跟踪ID"
      }
    ],
    "presets": [
      {
        "name": "通用Banner - 视频",
        "settings": {
        }
      }
    ]
  }
{% endschema %}