{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}
<div {{ block.shopify_attributes }} class="no-supported blocks-text blocks-content-heading section-padding" style="--text-size: {{block.settings.heading_size}}px;color: {{block.settings.text_color}};--font-weight: {{block.settings.font_weight}};--active-color: {{block.settings.active_color}};{{style}}">{{ block.settings.heading | replace: "\n", "<br>" | strip}}</div> 

{% schema %}
{
  "name": "标题",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "默认标题内容", "info": "需要换行，请使用 \\n " },
    {
      "type": "header",
      "content": "内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0
    },
    {
      "type": "header",
      "content": "内容样式"
    },
    { "type": "color", "id": "text_color", "label": "文本颜色", "default": "#333333" },
    { "type": "color", "id": "active_color", "label": "文本强调颜色", "default": "#fd5000" },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "字体大小",
      "info": "注：移动端字号0.75倍显示",
      "default": 40
    },
    {
        "type": "select",
        "id": "font_weight",
        "options": [
            {
                "value": "700",
                "label": "700"
            },
            {
                "value": "600",
                "label": "600"
            },
            {
                "value": "500",
                "label": "500"
            },
            {
                "value": "400",
                "label": "400"
            },
            {
                "value": "300",
                "label": "300"
            },
        ],
        "default": "600",
        "label": "字重"
    }
  ],
  "presets": [
    {
      "name": "标题"
    }
  ]
}
{% endschema %}
