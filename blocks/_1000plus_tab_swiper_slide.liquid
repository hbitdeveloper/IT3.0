
<div class="swiper-slide lg:w-[62.5rem] w-[21.4375rem]">
    <div class="relative">
        {% comment %} background image {% endcomment %}
        {%- if block.settings.pcImage != blank or block.settings.mbImage != blank -%}
            {% render 'responsive-image', image: block.settings.pcImage, image_class: 'w-full lg:h-[37.5rem] h-[9.75rem] object-cover', mimage: block.settings.mbImage, width: 1000, mwidth: 680 %}
        {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder w-full lg:h-[37.5rem] h-[38.125rem] object-cover' }}
        {%- endif -%}

        {% comment %} bottom content block {% endcomment %}
        <div class="lg:absolute inset-x-0 bottom-0 lg:text-white text-[#242F20]">
            <div class="lg:m-[3.75rem] mt-[1rem]">
                {% comment %} title {% endcomment %}
                <h2 class="font-semibold lg:text-[1.75rem] text-[1.25rem] lg:leading-[110%] lg:mb-[2.5rem] mb-[1rem] line-clamp-2">
                    {{ block.settings.title }}
                </h2>

                {% comment %} spec list {% endcomment %}
                <div class="flex flex-wrap flex-col lg:flex-row lg:gap-[2.5rem] gap-0 parameter-container">
                    {% content_for 'blocks' %}
                </div>
            </div>
        </div>
    </div>

    {% comment %} note under slide {% endcomment %}
    <p class="font-normal lg:text-[1.25rem] text-[1rem] lg:mt-[1.5rem] mt-0 lg:ml-[3.75rem] text-[#242f20] pb-[0.25rem]">
        {{ block.settings.note  | replace: "\n", "<br>" }}
    </p>
</div>

{% schema %}
{
  "name": "Slide",
  "tag": null,
  "class": "V5_1000plus_tab_swiper_slide",
  "settings": [
    {
      "type": "image_picker",
      "id": "pcImage",
      "label": "PC图片",
      "info": "建议尺寸：铺满1320*600，非铺满1000*600"
    },
    {
      "type": "image_picker",
      "id": "mbImage",
      "label": "MB图片",
      "info": "建议尺寸：686 x 312"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Power Your RV Essentials. Anywhere."
    },
    {
      "type": "inline_richtext",
      "id": "note",
      "label": "提示文案",
      "default": "*Note: this is calculated based on lab test"
    }
  ],
  "blocks": [
    {
      "type": "_1000plus_tab_slide_parameter"
    }
  ],
  "presets": [
    {
      "name": "Slide",
      "blocks": [
        {
          "type": "_1000plus_tab_slide_parameter"
        },
        {
          "type": "_1000plus_tab_slide_parameter"
        },
        {
          "type": "_1000plus_tab_slide_parameter"
        }
      ]
    }
  ]
}
{% endschema %}
