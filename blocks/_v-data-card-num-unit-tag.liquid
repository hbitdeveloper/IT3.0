<div
  {{ block.shopify_attributes }}
  class="v-data-card flex flex-col items-center justify-center p-2 lg:p-4 text-center"
>
  <div class="v-data-top mb-1 lg:mb-1.5">
    <span class="v-data-number jds-b1 lg:jds-h3 leading-none" style="--jds-rte-text-color: #fff;">{{ block.settings.number }}</span>
    <span class="v-data-unit jds-b3 lg:jds-h5 lg:!font-normal leading-none" style="--jds-rte-text-color: #fff;">{{ block.settings.unit }}</span>
  </div>
  <div class="v-data-tag jds-b3 lg:jds-b2" style="--jds-rte-text-color: #fff;">{{ block.settings.title }}</div>
</div>

{% schema %}
{
  "name": "V-数据卡片-数字+单位+标签",
  "tag": null,
  "settings": [
    {
      "type": "number",
      "id": "number",
      "label": "数字",
      "default": 100,
    },
    {
      "type": "text",
      "id": "unit",
      "label": "单位",
      "default": "Wh",
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "标签",
      "default": "<p>Global Awards</p>"
    }
  ],
  "presets": [
    {
      "name": "V-数据卡片-数字+单位+标签"
    }
  ]
}
{% endschema %}
