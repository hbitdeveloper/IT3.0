<div class="credential-text" id="{{block.id }}" {{ block.shopify_attributes }}
  {% if block.settings.anchor != blank %}anchor-target="{{block.settings.anchor | escape}}"{% endif %}>

  {{ 'blocks-_credential-text.css' | asset_url | stylesheet_tag }}

  <div class="common-box title-box" style="color: {{ block.settings.title_color }}">
    {% if block.settings.pc_title != blank %}
      <div class="title hidden lg:block">
        {{ block.settings.pc_title }}
      </div>
    {% endif %}

    {% if block.settings.mb_title != blank %}
      <div class="title lg:hidden">
        {{ block.settings.mb_title }}
      </div>
    {% endif %}
  </div>

  <div class="common-box desc-box" style="color: {{ block.settings.desc_color }}">
    {% if block.settings.pc_desc != blank %}
      <div class="desc hidden lg:block">
        {{ block.settings.pc_desc }}
      </div>
    {% endif %}

    {% if block.settings.mb_desc != blank %}
      <div class="desc lg:hidden">
        {{ block.settings.mb_desc }}
      </div>
    {% endif %}
  </div>

  <script src="{{ 'blocks-_credential-text.js' | asset_url }}" defer></script>
</div>

{% schema %}
{
  "name": "信任状-动效文本",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "锚点定位ID(确保唯一性,禁止空格和-符号)"
    },
    {
      "type": "richtext",
      "id": "pc_title",
      "label": "PC标题（必填）",
      "default": "<p>Jackery, Global Leading Brand</p><p>5 Million Units x 200+ Media</p>"
    },
    {
      "type": "richtext",
      "id": "mb_title",
      "label": "MB标题（必填）",
      "default": "<p>Jackery,</p><p>Global Leading Brand</p><p>5 Million Units</p><p>200+ Media</p>"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#fd5000"
    },
    {
      "type": "richtext",
      "id": "pc_desc",
      "label": "PC描述",
      "default": "<p>The accumulative sales volume reached 5 million units (2018.1 - 2024.11). *Data source: The parent group's 2024 third-quarter report and company sales surveys.</p><p>Jackery's been recognized by The New York Times, Wall Street Journal, Forbes and over 200 media and organizations globally. (As of Nov. 30, 2024)</p>"
    },
    {
      "type": "richtext",
      "id": "mb_desc",
      "label": "MB描述",
      "default": "<p>The accumulative sales volume reached 5 million units (2018.1 - 2024.11). *Data source: The parent group's 2024 third-quarter report and company sales surveys.</p><p>Jackery's been recognized by The New York Times, Wall Street Journal, Forbes and over 200 media and organizations globally. (As of Nov. 30, 2024)</p>"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "描述文案颜色",
      "default": "#999999"
    }
  ],
  "presets": [
    {
      "name": "信任状-动效文本"
    }
  ]
}
{% endschema %}
