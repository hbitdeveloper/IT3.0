{% style %}
	#img-text-separation-{{ block.id }} .v5-img-text-separation-li{
		border-bottom: 1px solid #ccc
	}

	#img-text-separation-{{ block.id }} .v5-img-text-separation-li:last-child {
		border: none;
		padding-bottom: 0;
	}

	@media (min-width: 1439.98px) { 
		#img-text-separation-{{ block.id }} h2{
			max-width: 1440px;
			margin-left: auto;
			margin-right: auto;
		}
	}
	@media (min-width: 768.98px) and (max-width: 1439.97px) { 
		#img-text-separation-{{ block.id }} h2{
			max-width: 98%;
			margin-left: auto;
			margin-right: auto;
		}
	}
	@media (max-width: 767.97px) { 
		#img-text-separation-{{ block.id }} h2{
			max-width: 96%;
			margin-left: auto;
			margin-right: auto;
		}
	}

	@media (min-width: 1320.98px) {
		#img-text-separation-{{ block.id }} .v5-img-text-separation-container{
			width: 1320px;
			margin: 0 auto;
		}
	}
	@media (max-width: 1320.97px) {
		#img-text-separation-{{ block.id }} .v5-img-text-separation-container{
			width: 91.46%;
			margin: 0 auto;
		}
	}

{% endstyle %}

{%- liquid
  assign set = block.settings
  assign list_class = "w-full flex flex-col items-start justify-start gap-y-[1.125rem] lg:gap-y-[1.375rem] p-[1rem] lg:py-[2.6875rem] lg:px-[3.4375rem] "
  assign list_item_class = "v5-img-text-separation-li compare-item w-full flex items-start justify-between gap-x-[1.5625rem] lg:gap-x-[1.25rem] pb-[0.74946rem] md:pb-[1.625rem]"
  assign text_class = "text-[12px] font-medium leading-[1.4] text-[#242F20] md:text-[22px] md:leading-[1.5]"
  assign icon_class = "block overflow-hidden mt-0.5 md:mt-2 shrink-0 h-[1.0625rem] w-[1.0625rem] lg:h-10 lg:w-10"
-%}

<div id="img-text-separation-{{ block.id }}" class="v5-img-text-separation py-[1.5rem] md:py-[4rem]" {{ block.shopify_attributes }}>
	{%- if set.heading_title != blank -%}
		<h2 class="font-semibold lg:text-5xl/[1.3] md:text-4xl text-[1.75rem] leading-[1.2] text-[#333] text-center lg:mb-16 mb-8">
			{{ set.heading_title | replace: '\n', '<br>' | strip }}
		</h2>
  	{%- endif -%}

	<div class="v5-img-text-separation-container">
		{% if set.comparison_layout == "single" %}
			<div class="rounded-[1.25rem]" style="background: {{ set.left_bg_color }}">
				<ul class="{{ list_class }}">
          {%- for i in (1..10) -%}
            {%- assign left_key = 'row_' | append: i | append: '_left_pro_desc' -%}
            {%- assign left_text = set[left_key] | strip -%}
            {%- if left_text != blank -%}
              <li class="{{ list_item_class }}">
                <div class="{{ text_class }}">
                  {{ left_text }}
                </div>
								<svg class="icon {{ icon_class }}" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
									<path d="M511.999994 0C229.205543 0 0.020822 229.226376 0.020822 512.020827c0 282.752797 229.184721 511.979173 511.979173 511.979173s511.979173-229.226376 511.979173-511.979173C1023.979167 229.226376 794.794446 0 511.999994 0zM815.371918 318.95082l-346.651263 461.201969c-10.830249 14.370907-27.32555 23.409999-45.27877 24.742952-1.582882 0.124964-3.12411 0.166619-4.665338 0.166619-16.328682 0-32.074198-6.373185-43.779197-17.911565l-192.903389-189.44604c-24.617988-24.20144-24.992881-63.731847-0.791441-88.349835 24.20144-24.659643 63.731847-24.951226 88.349835-0.833096l142.042875 139.501932 303.788472-404.2182c20.744091-27.575479 59.899605-33.115568 87.516739-12.413131C830.534266 252.219827 836.116009 291.375341 815.371918 318.95082z" fill="#1afa29"></path>
								</svg>
              </li>
            {%- endif -%}
          {%- endfor -%}
				</ul>
			</div>
		{% else %}
		<div class="v5-img-text-separation-layout grid grid-cols-1 md:grid-cols-2 gap-6 compare-wrapper">
			<div class="rounded-[1.25rem]" style="background: {{ set.left_bg_color }}">
				<ul class="{{ list_class }} compare-left">
          {%- for i in (1..10) -%}
            {%- assign left_key = 'row_' | append: i | append: '_left_pro_desc' -%}
            {%- assign left_text = set[left_key] | strip -%}
            {%- if left_text != blank -%}
              <li class="{{ list_item_class }}">
                <div class="{{ text_class }}">
                  {{ left_text }}
                </div>
								<svg class="icon {{ icon_class }}" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
									<path d="M511.999994 0C229.205543 0 0.020822 229.226376 0.020822 512.020827c0 282.752797 229.184721 511.979173 511.979173 511.979173s511.979173-229.226376 511.979173-511.979173C1023.979167 229.226376 794.794446 0 511.999994 0zM815.371918 318.95082l-346.651263 461.201969c-10.830249 14.370907-27.32555 23.409999-45.27877 24.742952-1.582882 0.124964-3.12411 0.166619-4.665338 0.166619-16.328682 0-32.074198-6.373185-43.779197-17.911565l-192.903389-189.44604c-24.617988-24.20144-24.992881-63.731847-0.791441-88.349835 24.20144-24.659643 63.731847-24.951226 88.349835-0.833096l142.042875 139.501932 303.788472-404.2182c20.744091-27.575479 59.899605-33.115568 87.516739-12.413131C830.534266 252.219827 836.116009 291.375341 815.371918 318.95082z" fill="#1afa29"></path>
								</svg>
              </li>
            {%- endif -%}
          {%- endfor -%}
				</ul>
			</div>
			<div class="rounded-[1.25rem]"style="background: {{ set.right_bg_color }}">
				<ul class="{{ list_class }} compare-right">
          {%- for i in (1..10) -%}
            {%- assign right_key = 'row_' | append: i | append: '_right_pro_desc' -%}
            {%- assign right_text = set[right_key] | strip -%}
            {%- if right_text != blank -%}
              <li class="{{ list_item_class }}">
                <div class="{{ text_class }}">
                  {{ right_text }}
                </div>
								<svg class="icon {{ icon_class }}" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
									<path d="M 506.56 25.92 C 239.68 25.92 23.36 242.24 23.36 509.12 s 216.32 483.2 483.2 483.2 s 483.2 -216.32 483.2 -483.2 C 989.44 242.24 773.12 25.92 506.56 25.92 Z m 239.04 663.68 l -81.28 81.28 l -157.76 -157.76 l -157.76 157.76 l -81.28 -81.28 l 157.76 -157.76 l -157.76 -157.76 l 81.28 -81.28 l 157.76 157.76 l 157.76 -157.76 l 81.28 81.28 l -157.76 157.76 l 157.76 157.76 Z" fill="#d81e06"></path>
								</svg>
              </li>
            {%- endif -%}
          {%- endfor -%}
				</ul>
			</div>
		</div>
		{% endif %}
	</div>
</div>

<script>
	document.addEventListener("DOMContentLoaded",function(){
		if (!window.matchMedia("(min-width: 768px)").matches) return;

		const wrapper = document.querySelector("#img-text-separation-{{ block.id }}");
		if(!wrapper) return;

		const leftItems = wrapper.querySelectorAll(".compare-left .compare-item");
		const rightItems = wrapper.querySelectorAll(".compare-right .compare-item");
		if(!leftItems.length || !rightItems.length) return;
		
		leftItems.forEach((leftItem,index)=>{
			const rightItem = rightItems[index];
			if(!rightItem) return;
			const height = Math.max(leftItem.offsetHeight,rightItem.offsetHeight);
			leftItem.style.height = height + "px";
			rightItem.style.height = height + "px";
		});
	});
</script>

{% schema %}
{
	"name": "v5-对比表格",
	"tag": null,
	"class": "v5-img-text-separation",
	"settings": [
		{
      "type": "select",
      "id": "background_type",
      "label": "背景类型",
      "options": [
        { "value": "color", "label": "背景颜色" },
        { "value": "image", "label": "背景图片" }
      ],
      "default": "color"
    },
		{
      "type": "image_picker",
      "id": "bg_image",
      "label": "背景图片",
      "visible_if": "{{ block.settings.background_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "背景颜色",
			"default": "#fff",
      "visible_if": "{{ block.settings.background_type == 'color' }}"
    },
		{
      "type": "text",
      "id": "heading_title",
      "label": "标题文案",
      "default": "产品功能对比",
    	"info": "需要换行，请使用 \\n"
    },
		{
			"type": "select",
			"id": "comparison_layout",
			"label": "产品对比布局",
			"options": [
				{
					"value": "single",
					"label": "无对比"
				},
				{
					"value": "double",
					"label": "对比"
				}
			],
			"default": "double"
		},
		{
			"type": "color_background",
			"id": "left_bg_color",
			"label": "产品背景颜色",
			"default": "linear-gradient(to bottom, #FFF3E4, #FFFAF4)"
		},
		{
			"type": "color_background",
			"id": "right_bg_color",
			"label": "产品对比背景颜色",
			"default": "linear-gradient(to bottom, #FFF3E4, #FFFAF4)",
			"visible_if": "{{ block.settings.comparison_layout == 'double' }}"
		},
		{ "type": "header", "content": "行1" },
		{ "type": "text", "id": "row_1_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_1_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" },
		{ "type": "header", "content": "行2" },
		{ "type": "text", "id": "row_2_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_2_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" },
		{ "type": "header", "content": "行3" },
		{ "type": "text", "id": "row_3_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_3_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" },
		{ "type": "header", "content": "行4" },
		{ "type": "text", "id": "row_4_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_4_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" },
		{ "type": "header", "content": "行5" },
		{ "type": "text", "id": "row_5_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_5_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" },
		{ "type": "header", "content": "行6" },
		{ "type": "text", "id": "row_6_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_6_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" },
		{ "type": "header", "content": "行7" },
		{ "type": "text", "id": "row_7_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_7_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" },
		{ "type": "header", "content": "行8" },
		{ "type": "text", "id": "row_8_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_8_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" },
		{ "type": "header", "content": "行9" },
		{ "type": "text", "id": "row_9_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_9_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" },
		{ "type": "header", "content": "行10" },
		{ "type": "text", "id": "row_10_left_pro_desc", "label": "左侧文案" },
		{ "type": "text", "id": "row_10_right_pro_desc", "label": "右侧文案", "visible_if": "{{ block.settings.comparison_layout == 'double' }}" }
	],
	"blocks": [
		{ "type": "@theme" }
	],
	"presets": [
    {
      "name": "v5-对比表格",
      "category": "V5.0"
    }
  ]
