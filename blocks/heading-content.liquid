{{ 'heading-content.css' | asset_url | stylesheet_tag }}

{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
  {% render 'size-radius', settings: block.settings %}
{%- endcapture -%}
<div
  class="blocks-heading-content section-padding blocks-radius text-{{block.settings.alignment}} mb-text-{{block.settings.alignment_mb}} max-w-full {{block.settings.page_width}}" {{ block.shopify_attributes }}
  style="background: {{block.settings.bg_color | default: 'transparent' }};{{style}}">
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "文本组",
  "blocks": [{"type": "_heading-content-heading"}, {"type": "_heading-content-subheading"}, {"type": "_heading-content-des"}],
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "section-container",
          "label": "版心/1200px"
        },
        {
            "value": "section-container-lg",
            "label": "大版心/1312px"
        },
        {
          "value": "container-fluid",
          "label": "拉伸/铺满两边留白"
        },
        {
          "value": "w-full",
          "label": "铺满/100%"
        }
      ],
      "default": "section-container",
      "label": "PC的组件宽度",
      "info": "MB端组件宽度固定和设计稿一致，不可修改"
    },
    { "type": "color", "id": "bg_color", "label": "背景颜色", "default": "#FFFFFF" },
    {
      "type": "header",
      "content": "内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上边距",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下边距",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "左边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "右边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "横向边距",
      "default": 0,
      "info": "未设置左右边距情况下，可以通过该配置设置水平间距"
    },
    {
      "type": "header",
      "content": "圆角"
    },
    {
      "type": "range",
      "id": "radius_1",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "左上角圆角",
      "default": 0,
      "info": "移动端默认为设置的数值×0.75"
    },
    {
      "type": "range",
      "id": "radius_2",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "右上角圆角",
      "default": 0,
      "info": "移动端默认为设置的数值×0.75"
    },
    {
      "type": "range",
      "id": "radius_3",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "右下角圆角",
      "default": 30,
      "info": "移动端默认为设置的数值×0.75"
    },
    {
      "type": "range",
      "id": "radius_4",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "左下角圆角",
      "default": 30,
      "info": "移动端默认为设置的数值×0.75"
    },

    {
      "type": "header",
      "content": "内容样式"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "PC端对齐方式",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "alignment_mb",
      "label": "移动端对齐方式",
      "default": "left"
    },
  ],
  "presets": [
    {
      "name": "文本组"
    }
  ]
}
{% endschema %}
