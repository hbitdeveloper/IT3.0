{% comment %}
    Renders icon user (用户图标 - 小人)

    Accepts:
    - width: {Number} 宽度
    - height: {Number} 高度
    - color: {String} 填充颜色
    - class: {String} 样式类名

    Usage:
    {% render 'icon-twitter-new', class: 'iconfont header__section_search zzl-tt', width: 32, height: 32, color: '#FFF' %}
{% endcomment %}

<svg class="icon {{class}}" width="{{width}}" height="{{height}}" viewBox="0 0 32 32">
    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
        <g transform="translate(-290.000000, -953.000000)">
            <g transform="translate(290.000000, 953.000000)">
                <circle cx="16" cy="16" r="16"></circle>
                <path d="M8.8,9.6 L14.1868792,16.8412842 L9.12300768,22.8 L11.3162933,22.8 L15.2129877,18.2206318 L18.6036384,22.7784719 L23.2,22.7784719 L17.5347992,15.1631134 L22.3272641,9.62147958 L20.1339308,9.62147958 L16.5392125,13.813682 L16.5352542,13.819452 L13.3963616,9.6 L8.8,9.6 Z M11.3855398,10.8592947 L12.7007958,10.8377667 L20.6625799,21.4671026 L19.3472762,21.4885821 L11.3855398,10.8592947 Z" id="Fill-1备份" fill="{{color}}"></path>
            </g>
