{%- style -%}
    .pdp-matrix .product-detail-matrix-graph,
    .media_highlight_matrix .product-detail-matrix-graph
    {padding-top: 0;padding-bottom: 0;margin-top: 0;margin-bottom: 10px;}
    .matrix-graph-title{font-size: 40px;color: #1A1A1A;line-height: 48px;margin-bottom: 34px;}
    .matrix-graph-item{height: 313px;}
    .matrix-graph-item:first-child{margin-left: 0;}
    .matrix-graph-general{z-index: 4;padding: 28px;}
    .pc-block{display: block;}
    .mb-block{display: none;}
    .matrix-graph-item__title.large{font-size: 32px;line-height: 40px;}
    .matrix-graph-item__title.middle{font-size: 28px;line-height: 36px;}
    .matrix-graph-item__title.small{font-size: 24px;line-height: 32px;}
    .matrix-graph-item__subtitle.large{font-size: 18px;line-height: 26px;}
    .matrix-graph-item__subtitle.middle{font-size: 16px;line-height: 24px;}
    .matrix-graph-item__subtitle.small{font-size: 14px;line-height: 22px;}
    @media screen and (min-width: 1024px) and (max-width: 1439.98px){
        .pdp-matrix .product-detail-matrix-graph,
        .media_highlight_matrix .product-detail-matrix-graph
        {margin-top: 0;margin-bottom: 0.694444vw;}
        .matrix-graph-title{font-size: 2.777778vw;line-height: 3.333333vw;margin-bottom: 2.3611111vw;}
        .matrix-graph-item{height: 21.7361111vw;}
        .matrix-graph-general{padding: 1.944444vw;}
        .matrix-graph-item__title.large{font-size: 2.22222vw;line-height: 2.77778vw;}
        .matrix-graph-item__title.middle{font-size: 1.94444vw;line-height: 2.5vw;}
        .matrix-graph-item__title.small{font-size: 1.666667vw;line-height: 2.22222vw;}
        .matrix-graph-item__subtitle.large{font-size: 1.25vw;line-height: 1.805556vw;}
        .matrix-graph-item__subtitle.middle{font-size: 1.111111vw;line-height: 1.66667vw;}
        .matrix-graph-item__subtitle.small{font-size: 0.972222vw;line-height: 1.5277778vw;}
    }
    @media screen and (max-width: 1024px){
        .pdp-matrix .product-detail-matrix-graph,
        .media_highlight_matrix .product-detail-matrix-graph
        {margin-top: 0;margin-bottom: 3.2vw;}
        .matrix-graph-title{font-size: 8.533333vw;line-height: 10.666667vw;margin-bottom: 4.33333vw;padding: 0 4.2666667vw;}
        .matrix-graph-list{column-gap: 3.2vw;row-gap: 3.2vw;}
        .matrix-graph-item{height: 44.133333vw;}
        .matrix-graph-general{padding: 4.266667vw;}
        .matrix-graph-video video{border-radius: 3.2vw;}
        .matrix-graph-item:first-child{margin-left: 0;}
        .pc-block{display: none;}
        .mb-block{display: block;}
        .matrix-graph-item__title.large{font-size: 5.3333vw;line-height: 7.46667vw;}
        .matrix-graph-item__title.middle{font-size: 4.533333vw;line-height: 6.666667vw;}
        .matrix-graph-item__title.small{font-size: 3.733333vw;line-height: 5.866667vw;}
        .matrix-graph-item__subtitle.large{font-size: 3.733333vw;line-height: 4.8vw;}
        .matrix-graph-item__subtitle.middle{font-size: 3.2vw;line-height: 4.266667vw;}
        .matrix-graph-item__subtitle.small{font-size: 2.666667vw;line-height: 3.7333333vw;}
    }
    @media only screen and (min-width: 1178px) and (max-width: 1182px) and (orientation: landscape)  and (-webkit-min-device-pixel-ratio: 2) {
        .matrix-graph-item-ipad.matrix-graph-item {
            height: 790px;
            display: block;
            background-size: contain;
            background-repeat: no-repeat;
            padding: 0;
        }
    }
{%- endstyle -%}

<section style="background-color: {{ settings.bgColor }};" class="product-detail-matrix-graph lg:py-2.5 py-1.5 product-detail-matrix-graph-{{ index }}">
    <div class="product-detail-matrix section-container-lg"  data-top-pc="{{ settings.matrix_top_pc }}" data-bottom-pc="{{ settings.matrix_bottom_pc }}" data-top-mb="{{ settings.matrix_top_mb | divided_by: 7.5 }}" data-bottom-mb="{{ settings.matrix_bottom_mb | divided_by: 7.5}}">
        {%- if settings.matrix_title != blank -%}
            <h2 class="matrix-graph-title font-medium">{{ settings.matrix_title | newline_to_br }}</h2>
        {%- endif -%}
        <div class="matrix-graph-content pc-block">
            <div class="matrix-graph-list grid" data-grid-columns="{{ settings.matrix_pc }}">
                {%- for i in (0..3) -%}
                    {% assign matrix_position_index = 'part_title_position_' | append: forloop.index %}
                    {% assign matrix_color_index = 'part_title_color_' | append: forloop.index %}
                    {% assign matrix_title_index = 'part_title_' | append: forloop.index %}
                    {% assign matrix_title_size_index = 'part_title_size_' | append: forloop.index %}
                    {% assign matrix_subtitle_index = 'part_subtitle_' | append: forloop.index %}
                    {% assign matrix_subtitle_size_index = 'part_subtitle_size_' | append: forloop.index %}
                    {% assign matrix_video_pc_index = 'part_video_pc_' | append: forloop.index %}
                    {% assign matrix_loop_pc_index = 'part_loop_pc_' | append: forloop.index %}
                    {% assign matrix_image_pc_index = 'part_image_pc_' | append: forloop.index %}
                    {%- if settings[matrix_image_pc_index] != blank or settings[matrix_video_pc_index] != blank -%}
                        <div class="matrix-graph-item-ipad matrix-graph-item rounded-xl bg-cover bg-no-repeat relative lg:p-5 p-4 lg:ml-5 ml-0"
                            style="
                                text-align: {{ settings[matrix_position_index] }};
                                background-image: url({{settings[matrix_image_pc_index] | image_url: width: 656 }});
                                height:{{ settings.matrix_height_pc }}px;
                            ">
                            <div class="matrix-graph-general absolute w-full h-full top-0 left-0" style="color:{{ settings[matrix_color_index] }}">
                                <div class="matrix-graph-item__title {{ settings[matrix_title_size_index] }} font-600">{{ settings[matrix_title_index] | newline_to_br }}</div>
                                <div class="matrix-graph-item__subtitle {{ settings[matrix_subtitle_size_index] }} font-600">{{ settings[matrix_subtitle_index] | newline_to_br }}</div>
                            </div>
                            {%- if settings[matrix_video_pc_index] != blank -%}
                                {%- render 'jky-video', class:"matrix-graph-video absolute top-0 left-0 w-full h-full pb-0 rounded-xl",video_url:settings[matrix_video_pc_index],autoplay:true,controls:false,loop:settings[matrix_loop_pc_index] -%}
                            {%- endif -%}
                        </div>
                    {%- endif -%}
                {%- endfor -%}
            </div>
        </div>
        <div class="matrix-graph-content mb-block">
            <div class="matrix-graph-list grid" data-grid-columns="{{ settings.matrix_mb }}">
                {%- for i in (0..3) -%}
                    {% assign matrix_position_index = 'part_title_position_' | append: forloop.index %}
                    {% assign matrix_color_index = 'part_title_color_' | append: forloop.index %}
                    {% assign matrix_title_index = 'part_title_' | append: forloop.index %}
                    {% assign matrix_title_size_index = 'part_title_size_' | append: forloop.index %}
                    {% assign matrix_subtitle_index = 'part_subtitle_' | append: forloop.index %}
                    {% assign matrix_subtitle_size_index = 'part_subtitle_size_' | append: forloop.index %}
                    {% assign matrix_video_mb_index = 'part_video_mb_' | append: forloop.index %}
                    {% assign matrix_loop_mb_index = 'part_loop_mb_' | append: forloop.index %}
                    {% assign matrix_image_mb_index = 'part_image_mb_' | append: forloop.index %}
                    {%- if settings[matrix_image_mb_index] or settings[matrix_video_mb_index] -%}
                        <div class="matrix-graph-item rounded-xl bg-cover bg-no-repeat relative lg:p-5 p-4 lg:ml-5 ml-0" style="text-align: {{ settings[matrix_position_index] }};background-image: url({{settings[matrix_image_mb_index] | image_url: width: 686 }});height:calc(({{ settings.matrix_height_mb }}/750)*100vw);">
                            <div class="matrix-graph-general absolute w-full h-full top-0 left-" style="color:{{ settings[matrix_color_index] }}">
                                <div class="matrix-graph-item__title {{ settings[matrix_title_size_index] }} font-600 lg:mb-2 mb-1">{{ settings[matrix_title_index] | newline_to_br }}</div>
                                <div class="matrix-graph-item__subtitle {{ settings[matrix_subtitle_size_index] }} font-600">{{ settings[matrix_subtitle_index] | newline_to_br }}</div>
                            </div>
                            {%- render 'jky-video', class:"matrix-graph-video absolute top-0 left-0 w-full h-full pb-0 rounded-xl",video_url:settings[matrix_video_mb_index],autoplay:true,controls:false,loop:settings[matrix_loop_mb_index] -%}
                        </div>
                    {%- endif -%}
                {%- endfor -%}
            </div>
        </div>
    </div>
</section>
