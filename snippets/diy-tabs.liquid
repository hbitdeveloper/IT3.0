{%- style -%}
    .product-detail-new .produc-detail--content .inner--container {height: auto;}
    .page-container {width: 1440px;}
    .product-tabs-box {margin-top: 54px;top: -1px;z-index: 9;border-top: 1px solid rgba(0, 0, 0, 0.12);border-bottom: 1px solid rgba(0, 0, 0, 0.12);background-color: rgba(255, 255, 255, 1);}
    .product-tabs-box.inverted {background: rgba(0, 0, 0, 0.6);border-bottom: 1px solid rgba(210, 248, 253, 0.3);}
    .product-tabs-box.inverted .product-name {color: rgba(255, 255, 255, 0.8);}
    .product-tabs-box.inverted .subnav-list {color: rgba(255, 255, 255, 0.5);}
    .product-tabs-container {height: 64px;gap: 64px;}
    .product-tabs-container .product-name {color: #222226;letter-spacing: -0.4px;}
    .product-tabs-container .subnav-list {transition: color 0.3s ease;color: rgba(0, 0, 0, 0.5);}
    .product-tabs-container .subnav-list .navli::after {content: '';position: absolute;bottom: -1px;left: 0;width: 100%;height: 2px;background: transparent;}
    .product-tabs-container .subnav-list .navli.active {color: var(--primary-color);}

    @media screen and (max-width: 1440px) {
        .page-container {width: 100%;}
        .product-tabs-container {height: 4.4444vw;padding: 0 2.777778vw;gap: 4.4444vw;}
    }
    @media screen and (max-width: 1024px) {
        .product-tabs-container {height: 12.8vw;padding: 0 6.4vw;gap: 0;border-bottom: transparent;}
        .product-tabs-container jky-tabs .jky-tabs-scroll .next-action {width: 36px;padding-right: 6px;right: -6.4vw;}
        .product-tabs-container jky-tabs .jky-tabs-scroll .prev-action {width: 36px;padding-left: 6px;}
    }

    jky-tabs .jky-tabs-scroll .jky-tabs-item{color:rgba(0, 0, 0, 0.5);}
    jky-tabs .jky-tabs-scroll .jky-tabs-item.active {color: var(--primary-color);}
    jky-tabs .jky-tabs-scroll .next-action {right: 0;width: 60px;background: linear-gradient(267deg, #FFFFFF 61%, rgba(255, 255, 255, 0) 100%);padding-right: 20px;transition: opacity 0.24s ease;}
    jky-tabs .jky-tabs-scroll .next-action.unvisible {opacity: 0;}
    jky-tabs .jky-tabs-scroll .prev-action {left: -6.4vw;width: 60px;background: linear-gradient(267deg, #FFFFFF 61%, rgba(255, 255, 255, 0) 100%);padding-right: 6px;transition: opacity 0.24s ease;}
    jky-tabs .jky-tabs-scroll .prev-action.unvisible {opacity: 0;}
    .product-tabs-box.inverted jky-tabs .jky-tabs-scroll .jky-tabs-item:not(.active) {color: rgba(255, 255, 255, 0.5);}
    .product-tabs-box.inverted jky-tabs .jky-tabs-scroll .next-action {background: linear-gradient(267deg, #000000 61%, rgba(0, 0, 0, 0) 100%);}
    .product-tabs-box.inverted jky-tabs .jky-tabs-scroll .prev-action {background: linear-gradient(267deg, #000000 61%, rgba(0, 0, 0, 0) 100%);}
    .product-tabs-box.inverted jky-tabs .jky-tabs-scroll svg path {fill: rgba(255, 255, 255, 0.5);}

    /* 5.0 样式 */
    .jky-v5 .product-tabs-box {border-top: 1px solid rgba(255, 255, 255, 0.12);border-bottom: 1px solid rgba(255, 255, 255, 0.12);background-color: #242F20;}
    .jky-v5 .product-tabs-container .product-name {color: #FFF;}
    .jky-v5 .product-tabs-container .subnav-list {color: #FFF;}
    .jky-v5 .product-tabs-box jky-tabs .jky-tabs-scroll .next-action {background: linear-gradient(267deg, #242F20 61%, rgba(36, 47, 32, 0) 100%);}
    .jky-v5 .product-tabs-box jky-tabs .jky-tabs-scroll .prev-action {background: linear-gradient(267deg, #242F20 61%, rgba(36, 47, 32, 0) 100%);}
    .jky-v5 .product-tabs-box jky-tabs .jky-tabs-scroll svg path {fill: #FFF;}
    .jky-v5 .product-tabs-box jky-tabs .jky-tabs-scroll .jky-tabs-item{color:#FFF;}
    .jky-v5 .product-tabs-box jky-tabs .jky-tabs-scroll .jky-tabs-item.active {color: var(--primary-color);}
    .jky-v5 .product-tabs-box.inverted jky-tabs .jky-tabs-scroll .jky-tabs-item:not(.active) {color: rgba(0, 0, 0, 0.5);}
    .jky-v5 .product-tabs-box.inverted jky-tabs .jky-tabs-scroll .next-action {background: linear-gradient(267deg, #FFF 61%, rgba(255, 255, 255, 0) 100%);}
    .jky-v5 .product-tabs-box.inverted jky-tabs .jky-tabs-scroll .prev-action {background: linear-gradient(267deg, #FFF 61%, rgba(255, 255, 255, 0) 100%);}
    .jky-v5 .product-tabs-box.inverted jky-tabs .jky-tabs-scroll svg path {fill: rgba(0, 0, 0, 0.5);}
{%- endstyle -%}

{%- liquid
    assign a_mode_type = 'slide'
    if mode_type == 'column'
        assign a_mode_type = 'column'
    endif
-%}

<div a_mode_type="{{a_mode_type}}" class="product-tabs-box cal_scroll_target sticky lg:px-10 px-0">
    <div class="product-detail-variants page-container max-w-full mx-auto">
        <div class="product-tabs-container flex items-center justify-between">
            {%- if title != blank -%}
                <h1 class="product-name text-overflow-1 flex-1 lg:block hidden font-medium text-xl">{{title | escape}}</h1>
            {%- endif -%}

            <ul class="subnav-list relative lg:flex hidden font-semibold items-center text-center h-full text-base gap-7">
                {%- for item in list -%}
                    <li
                        class="navli {% if forloop.index0 == 0 %} active{% endif %} h-full cursor-pointer flex items-center relative shrink-0"
                        data-cate="product_tab_{{forloop.index0}}"
                        data-ga-event="products_details_page_user_clicks"
                        data-ga-action="click"
                        data-ga-params-product_spu_name="{{ product.title }}"
                        data-ga-params-module="Directory"
                        data-ga-params-content="{{title | escape}}"
                        data-ga-params-position="{{item}}"
                    >{{item}}</li>
                {%- endfor -%}

                <div class="slider-main absolute h-0.5 -bottom-px bg-primary left-0 transition-all duration-200"></div>
            </ul>

            <jky-tabs class="lg:hidden block w-full h-full max-h-full">
                <div class="jky-tabs-scroll relative h-full">
                    <div class="action-btn prev-action unvisible absolute h-full top-0 flex items-center justify-end z-[2] rotate-180">
                        <svg class="cursor-pointer lg:w-5 w-4 lg:h-5 h-4" fill="#1a1a1a" width="16" height="16" viewBox="0 0 1024 1024">
                            <path
                                d="M332.501333 183.168a42.666667 42.666667 0 0 1 57.621334-2.496l2.709333 2.496 298.666667 298.666667a42.666667 42.666667 0 0 1 2.496 57.621333l-2.496 2.709333-298.666667 298.666667a42.666667 42.666667 0 0 1-62.826667-57.621333l2.496-2.709334L600.96 512 332.501333 243.498667a42.666667 42.666667 0 0 1-2.496-57.621334l2.496-2.709333z"
                                fill="#1a1a1a"></path>
                        </svg>
                    </div>

                    <div class="jky-tabs-scroll-inner relative h-full overflow-hidden flex justify-between flex-nowrap gap-7 will-change-auto">
                        <div class="inner-w flex justify-between flex-nowrap will-change-auto gap-7 relative h-full">
                            {%- for item in list -%}
                                <div
                                    style="--tw-text-opacity:0.5;"
                                    class="jky-tabs-item {% if forloop.index0 == 0 %} active curr_tab{% endif %} flex items-center font-semibold lg:text-base text-sm lg:py-1 py-0.5 transition-all duration-200 ease-in-out lg:w-full w-max"
                                    data-cate="product_tab_{{forloop.index0}}"
                                    data-ga-event="products_details_page_user_clicks"
                                    data-ga-action="click"
                                    data-ga-params-product_spu_name="{{ product.title }}"
                                    data-ga-params-module="Directory"
                                    data-ga-params-content="{{title | escape}}"
                                    data-ga-params-position="{{item}}"
                                >{{item}}</div>
                            {%- endfor -%}

                            <div class="jky-tabs-slideline absolute left-0 right-0 z-[2] h-0.5 -bottom-px">
                                <div class="jky-tabs-slideline--inner absolute left-0 h-0.5 bg-primary transition-all duration-200 ease-in"></div>
                            </div>
                        </div>
                    </div>


                    <div class="action-btn next-action absolute h-full flex items-center justify-end top-0 z-[2]">
                        <svg class="cursor-pointer lg:w-5 w-4 lg:h-5 h-4" fill="#1a1a1a" width="16" height="16" viewBox="0 0 1024 1024">
                            <path
                                d="M332.501333 183.168a42.666667 42.666667 0 0 1 57.621334-2.496l2.709333 2.496 298.666667 298.666667a42.666667 42.666667 0 0 1 2.496 57.621333l-2.496 2.709333-298.666667 298.666667a42.666667 42.666667 0 0 1-62.826667-57.621333l2.496-2.709334L600.96 512 332.501333 243.498667a42.666667 42.666667 0 0 1-2.496-57.621334l2.496-2.709333z"
                                fill="#1a1a1a"></path>
                        </svg>
                    </div>
                </div>
            </jky-tabs>
        </div>
    </div>
</div>
<script src="{{ 'diy-tabs.js' | asset_url }}" data-cookieconsent="ignore" defer></script>
