{% comment %} 宫格 {% endcomment %}
<div class="index-grid-banner">
    <div class="new-main-container">
        <div class="pc-block">
            <div class="box">
                {%- for item in grid_list -%}
                    {% if item.settings.link != blank %}
                        <a 
                            data-ga-event="home_page_banner4.0" 
                            data-ga-action="click" 
                            data-ga-params-module="{{ item.settings.title_main | strip_html }}" 
                            data-ga-params-link="{{ item.settings.link }}"
                            data-ga-params-piclink="{{ item.settings.pc_image | img_url: 'master' }}"
                            data-ga-params-type="lattice_ban"
                            class="content" 
                            target="{% if new_window %}_blank{% else %}_self{% endif %}" href="{{ item.settings.link }}"
                            style="{% if item.settings.row != '1' %}grid-row: span {{item.settings.row}}/span {{item.settings.row}};{% endif %} {% if item.settings.col != 1 %}grid-column: span {{item.settings.col}}/span {{item.settings.col}};{% endif %}">
                            {% render 'responsive-image', image: item.settings.pc_image, mimage: item.settings.mb_image  %}
                            <div class="info">
                                <div class="info-content">
                                    {% assign titleColor = '<em style="color: ' | append: item.settings.title_main_color | append: '">' %}
                                    <div class="title">{{ item.settings.title_main | replace: '<em>', titleColor }}</div>
                                    {% assign subTitleColor = '<em style="color: ' | append: item.settings.sub_title_main_color | append: '">' %}
                                    <div class="sub-title">{{ item.settings.sub_title | replace: '<em>', subTitleColor }}</div>
                                </div>
                            </div>
                            <div class="index-arrow">
                                <div class="circle"></div>
                                <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                        <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                            <g transform="translate(672.000000, 286.000000)">
                                                <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                            </g>
                                        </g>
                                    </g>
                                </svg>
                            </div>
                        </a> 
                    {% endif %}
                    
                {%- endfor -%}
                
            </div>
        </div>
        <div class="mobile-block">
            <div class="box">
                {%- for item in grid_list -%}
                    {% if item.settings.link != blank %}
                        <a class="content" 
                            target="{% if new_window %}_blank{% else %}_self{% endif %}" href="{{ item.settings.link }}"
                            style="{% if item.settings.row != '1' %}grid-row: span {{item.settings.row}};{% endif %} ">
                            {% render 'responsive-image', image: item.settings.pc_image, mimage: item.settings.mb_image  %}
                            <div class="info">
                                <div class="info-content">
                                    {% assign titleColor = '<em style="color: ' | append: item.settings.title_main_color | append: '">' %}
                                    <div class="title">{{ item.settings.title_main | replace: '<em>', titleColor }}</div>
                                    {% assign subTitleColor = '<em style="color: ' | append: item.settings.sub_title_main_color | append: '">' %}
                                    <div class="sub-title">{{ item.settings.sub_title | replace: '<em>', subTitleColor }}</div>
                                </div>
                            </div>
                            <div class="index-arrow">
                                <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                        <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                            <g transform="translate(672.000000, 286.000000)">
                                                <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                            </g>
                                        </g>
                                    </g>
                                </svg>
                            </div>
                        </a> 
                    {% endif %}
                    
                {%- endfor -%}
                
            </div>
        </div>
    </div>
</div>