        jky-landing-product-jp.landing-grid--mb-2 .landing-block--product-ptitle {text-align: left;}

        .landing-col-grid--mb-2 .landing-block--product-cate:not(.swiper_mode .landing-block--product-cate) {gap: 12px!important;}
        .landing-grid--2-col-desktop .landing-block--product-ptitle {-webkit-line-clamp:2;}
         jky-landing-product-jp.landing-grid--mb-2 .landing-block--product-ptitle {-webkit-line-clamp:3;}
        .landing-grid--2-col-desktop .landing-block--product-ptitle,.landing-grid--2-col-desktop .landing-block--product-psubtitle {text-align:left;}

        .landing-block--product {padding-top: calc(var(--padding-top) / 2);padding-bottom:calc(var(--padding-bottom) / 2);}
        .landing-product--block-title {font-size:calc(var(--block_title_size) / 2);padding-bottom:calc(var(--block_title_bottom) / 2)!important;}
        .landing-product--block-sub-title {font-size:calc(var(--block_sub_title_size) / 2);padding-bottom:calc(var(--block_sub_title_bottom) / 2)!important;}
    }
</style>
{%- endif -%}

{%- assign p_cates = shop.metaobjects.landing_product_block[schema_settings.handle] -%}
<div
    data-style="JP"
    class="landing-block--product color-{{ schema_settings.color_scheme }}"
    {%if schema_settings.anchor_id != blank%}anchor={{schema_settings.anchor_id | escape}}{%endif%}
    style="background:var(--color-background);--padding-bottom:{{schema_settings.padding_bottom}}px;--padding-top:{{schema_settings.padding_top}}px;--columns-gap:{{schema_settings.columns_gap}}px;--btns-font-size:{{schema_settings.btns_font_size}}px;--pc-bg-img:url('{{schema_settings.pc_bg_img | image_url: width: 1920 }}');--mb-bg-img:url('{{schema_settings.mb_bg_img | image_url: width: 750 }}');"
    {% if schema_settings.pc_bg_img != blank%}has-pc-bg{%endif%}
    {% if schema_settings.mb_bg_img != blank%}has-mb-bg{%endif%}
>
    {%- if schema_settings.block_title != blank -%}
        <div class="section-container landing-product--block-title" style="color: {{schema_settings.block_title_color}};--block_title_size:{{schema_settings.block_title_size}}px;--block_title_bottom:{{schema_settings.block_title_bottom}}px;">{{schema_settings.block_title | newline_to_br}}</div>
    {%- endif -%}

    {%- if schema_settings.block_sub_title != blank -%}
        <div class="section-container landing-product--block-sub-title" style="color: {{schema_settings.block_sub_title_color}};--block_sub_title_size:{{schema_settings.block_sub_title_size}}px;--block_sub_title_bottom:{{schema_settings.block_sub_title_bottom}}px;">{{schema_settings.block_sub_title | newline_to_br}}</div>
    {%- endif -%}

    {%- assign sb_types = 'Multiple_tags' -%}
    {%- if schema_settings.show_tabs == false -%}
        {%- assign sb_types = 'Single_tags' -%}
    {%- endif -%}

    <jky-landing-collections-jp>
        <div class="landing-block--product-main section-container {%if schema_settings.mb_colums_2==true%} landing-col-grid--mb-2{%endif%}">
            {%- if schema_settings.show_tabs == true -%}
            <div class="landing-block--product-tabs color-{{ schema_settings.color_scheme_tab }}">
                {%- if schema_settings.all_txt != blank -%}
                    <div class="landing-block--product-tab active" data-handle="all" data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}">{{schema_settings.all_txt | escape}}</div>
                {%- endif -%}
                {%- for cate in p_cates.cate_list.value -%}
                    <div class="landing-block--product-tab" data-handle="{{cate.title | handleize}}" data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}">{{cate.title | escape}}</div>
                {%- endfor -%}
            </div>
            {%- endif -%}

            {%- if schema_settings.all_txt != blank and schema_settings.show_tabs == true -%}
                {%- assign all_items = '' -%}
                {%- for cate in p_cates.cate_list.value -%}
                    {%- for card in cate.list.value -%}
                        {%- if card.variant.value.id != blank -%}
                            {%- assign _id_handle = card.variant.value.id | handle -%}
                            {%- if all_items contains _id_handle -%}{%- else -%}
                                {%- assign all_items = all_items | append: _id_handle | append: ',' -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                {%- endfor -%}

                <jky-landing-collectionitem-jp target-handle="all" class="active">
                    <div class="landing-block--product-cate">
                        {%- for cate in p_cates.cate_list.value -%}
                            {%- for card in cate.list.value -%}
                                {%- if card.variant.value.id != blank -%}
                                    {%- if all_items contains card.variant.value.id -%}
                                    {%- assign all_items = all_items | replace: card.variant.value.id, '' -%}
                                    {% assign act_time_end = card.act_time_end.value | date: '%s' %}
                                    {% assign act_time_start = card.act_time.value | date: '%s' %}
                                    {%- assign time_now = 'now' | date: '%s' -%}
                                    {%- assign product_card = card.variant.value -%}

                                    {% comment %} 活动是否进行 {% endcomment %}
                                    {%- assign has_act = false -%}
                                    {% comment %} 是否有活动 {% endcomment %}
                                    {%- assign has_act_active = false -%}
                                    {%- if card.act_time.value != blank and card.act_time_end.value != blank -%}
                                        {%- assign has_act_active = true -%}
                                        {%- if act_time_start < time_now and act_time_end > time_now and act_time_start < act_time_end -%}
                                            {% comment %} 活动进行中 {% endcomment %}
                                            {%- assign has_act = true -%}
                                        {%- endif -%}
                                    {%- endif -%}

                                    <jky-landing-product-jp card_style="cards_style_2" pid="{{product_card.id}}" has_act_active="{{has_act_active}}" has_act="{{has_act}}" {%if card.act_time.value != blank%}data-start="{{act_time_start}}" {%endif%} {%if card.act_time_end.value != blank%} data-end="{{act_time_end}}" {%endif%} data-actprice="{%if card.price.value != blank%}{{card.price.value | times: 100.00 | money | remove_last: '.00'}}{%else%}{{product_card.price | money | remove_last: '.00'}}{%endif%}" class="landing-grid--{{schema_settings.columns_desktop}}-col-desktop  p-cards_style_2 {%if schema_settings.mb_colums_2==true%} landing-grid--mb-2{%endif%}" data-price="{{product_card.price | money | remove_last: '.00'}}" style="border: {{ schema_settings.border }}px solid var(--primary-color);">
                                        <div class="landing-block--product-card flex 5555">
                                            <div class="landing-block--product-media relative">
                                                {% comment %} 样式2折扣角标（US）- 左上 / 样式2折扣角标（US）- 右上 {% endcomment %}
                                                {%- if card.awards_icon.value != blank -%}
                                                    <img class="absolute landing-block--product-awards-img--2" src="{{card.awards_icon.value | image_url: width: 240}}" alt="{{card.awards_icon.value.alt | escape}}" loading="lazy" width="{{ card.awards_icon.value.width }}" height="{{ card.awards_icon.value.height }}" />
                                                {%- endif -%}

                                                {%- if card.card_right_tag_2.value != blank -%}
                                                    <div class="absolute flex landing-block--product-discount-tag--jp">
                                                        <div class="ribbon ribbon-top-right">
                                                            <span class="text--primary">{{card.card_right_tag_2.value}}</span>
                                                        </div>
                                                    </div>
                                                {%- endif -%}

                                                {%- if card.product_img.value != blank -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{%endif%} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{card.product_img.value | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: card.product_img.value,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg pc-show'
                                                        -%}
                                                    </a>
                                                {%- else -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{%endif%} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{product_card.featured_image | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: product_card.featured_image,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg p--link pc-show'
                                                        -%}
                                                    </a>
                                                {%- endif -%}

                                                {% comment %} pcmb区分图片 {% endcomment %}
                                                {%- if card.product_mb_img.value != blank -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{%endif%} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{card.product_mb_img.value | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: card.product_mb_img.value,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg mb-show'
                                                        -%}
                                                    </a>
                                                {%- elsif card.product_img.value != blank -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{%endif%} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{card.product_img.value | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: card.product_img.value,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg mb-show'
                                                        -%}
                                                    </a>
                                                {%- else -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{%endif%} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{product_card.featured_image | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: product_card.featured_image,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg p--link mb-show'
                                                        -%}
                                                    </a>
                                                {%- endif -%}
                                            </div>
                                            <div class="landing-block--product-content flex">
                                                <div class="landing-block--product-content--top">
                                                    <a href="{{product_card.url}}" class="landing-block--product-ptitle text-overflow-2" {%if schema_settings.link_blank == true%} target="_blank"{%endif%} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-type="{{sb_types}}">
                                                        {%- if card.title.value != blank -%}
                                                            {{card.title.value | escape}}
                                                        {%- else -%}
                                                            {{product_card.title | escape | strip | replace: 'Jackery', ''}}
                                                        {%- endif -%}
                                                    </a>
                                                    {%- if card.subtitle.value != blank -%}
                                                        <div class="landing-block--product-psubtitle text-overflow-2">{{card.subtitle.value | escape | strip}}</div>
                                                    {%- endif -%}
                                                </div>

                                                <div class="landing-block--product-content--bottom flex">
                                                    <div class="landing-block--product-pmain--top">
                                                        <div class="landing-block--product-price flex flex-wrap" >
                                                            <span class="p-price">
                                                                {%- if card.price.value == blank -%}
                                                                    {{product_card.price | money | remove_last: '.00'}}
                                                                {%- else -%}
                                                                    {%- if has_act == true -%}
                                                                        <span data-price="{{card.price.value | times: 100.00 | money | remove_last: '.00'}}">{{card.price.value | times: 100.00 | money | remove_last: '.00'}}</span>
                                                                    {%- else -%}
                                                                        {{product_card.price | money | remove_last: '.00'}}
                                                                    {%- endif -%}
                                                                {%- endif -%}
                                                            </span>

                                                            {%- assign act_price_times = card.price.value | times: 100.00 -%}
                                                            {%- assign act_origin_price_times = card.origin_price.value | times: 100.00 -%}

                                                            {%- if card.origin_price.value != blank and card.price.value != blank -%}
                                                                {%- if card.origin_price.value > card.price.value and card.price.value != blank and card.origin_price.value != blank -%}
                                                                    {%- assign _a = card.origin_price.value | minus: card.price.value | floor | times: 100.00 | money | remove_last: '.00' -%}
                                                                    {%- assign display_act_discount_num = card.amount_discount.value | replace: '{amount}', _a -%}
                                                                {%- else -%}
                                                                    {%- assign display_act_discount_num = '' -%}
                                                                {%- endif -%}
                                                            {%- else -%}
                                                                {%- if product_card.compare_at_price > act_price_times -%}
                                                                    {%- assign _a = product_card.compare_at_price | divided_by: 100.00 | minus: card.price.value |floor | times: 100.00 | money | remove_last: '.00' -%}
                                                                    {%- assign display_act_discount_num = card.amount_discount.value | replace: '{amount}', _a -%}
                                                                {%- else -%}
                                                                    {%- assign display_act_discount_num = '' -%}
                                                                {%- endif -%}
                                                            {%- endif -%}


                                                            {%- if product_card.compare_at_price > product_card.price -%}
                                                                {%- assign _a_act = product_card.compare_at_price | minus: product_card.price | divided_by: 100.00 | floor | times: 100 | money | remove_last: '.00' -%}
                                                                {%- assign display_discount_num = card.amount_discount.value | replace: '{amount}', _a_act -%}
                                                            {%- else -%}
                                                                {%- assign _a_act = '' -%}
                                                                {%- assign display_discount_num = '' -%}
                                                            {%- endif -%}
                                                            <script type="application/json">
                                                                {
                                                                    "has_act_active": {{has_act_active}},
                                                                    "has_act": {{has_act_active}},
                                                                    "display_discount_num": "{{display_discount_num}}",

                                                                    {%- if card.origin_price.value != blank -%}
                                                                    "display_origin_act": "{{card.origin_price.value | times: 100.00 | money | remove_last: '.00'}}",
                                                                    {%- else -%}
                                                                        {%- if product_card.price < product_card.compare_at_price -%}
                                                                        "display_origin_act": "{{product_card.compare_at_price | money | remove_last: '.00'}}",
                                                                        {%- endif -%}
                                                                    {%- endif -%}

                                                                    {%- if product_card.price < product_card.compare_at_price -%}
                                                                    "display_origin": "{{product_card.compare_at_price | money | remove_last: '.00'}}",
                                                                    {%- endif -%}

                                                                    "display_act_discount_num": "{{display_act_discount_num}}",
                                                                    "Installment_text": "{{card.Installment_text.value}}",
                                                                    {%-if card.price.value-%}
                                                                    "price_act_num": {{card.price}},
                                                                    {%-endif-%}
                                                                    {%- if card.init_num.value != blank -%}
                                                                    "init_num": {{card.init_num.value}},
                                                                    {%- endif -%}
                                                                    {%- if card.act_time.value != blank -%}
                                                                    "act_time": {{card.act_time.value | date: '%s' }},
                                                                    {%- endif -%}
                                                                    {%- if card.act_time_end.value != blank -%}
                                                                    "act_time_end": {{card.act_time_end.value | date: '%s' }},
                                                                    {%- endif -%}
                                                                    {%- if card.unavailable_sold_txt.value != blank -%}
                                                                    "unavailable_sold_txt": "{{card.unavailable_sold_txt.value }}",
                                                                    {%- endif -%}
                                                                    {%- if card.available_sold_txt.value != blank -%}
                                                                    "available_sold_txt": "{{card.available_sold_txt.value }}",
                                                                    {%- endif -%}
                                                                    "price_num": {{product_card.price | divided_by: 100.00}},
                                                                    "id": {{product_card.id}},
                                                                    "full_gift_obj": {{product_card.metafields.custom.full_gift_list.value | json}}
                                                                }
                                                            </script>

                                                                <span class="p-origin-price">
                                                                </span>
                                                                {%- if card.amount_discount.value != blank -%}
                                                                    <span class="p-discount">
                                                                    </span>
                                                                {%- endif -%}
                                                        </div>

                                                        {%- if product_card.metafields.custom.discount_tag_time != blank -%}
                                                            <div class="coupon__time">{{product_card.metafields.custom.discount_tag_time}}</div>
                                                        {%- endif -%}
                                                        {%- if schema_settings.progress_coupon == "coupon" -%}
                                                            {%- if card.coupon_code.value != blank -%}
                                                                <product-coupon {% if schema_settings.mb_colums_2 == true %} hide--mb {% endif %} data-success="{{schema_settings.copy_success_text}}" data-success-tip="{{schema_settings.copy_success_tip_text}}" data-code="{{card.coupon_code.value}}">
                                                                    {% render 'icon-coupon-bg', color: 'var(--jds-color-primary)', text: card.coupon_code.value, copy: schema_settings.copy_text, coupon_text: schema_settings.coupon_before %}
                                                                </product-coupon>

                                                                {%- if schema_settings.mb_colums_2 == true -%}
                                                                    <product-coupon show--mb data-success="{{schema_settings.copy_success_text}}" data-success-tip="{{schema_settings.copy_success_tip_text}}" data-code="{{card.coupon_code.value}}">
                                                                        {% render 'icon-coupon-bg-mb', color: 'var(--jds-color-primary)', text: card.coupon_code.value, copy: schema_settings.copy_text, coupon_text: schema_settings.coupon_before %}
                                                                    </product-coupon>
                                                                {%- endif -%}
                                                            {%- else -%}
                                                                <div class="coupon__empty"></div>
                                                            {%- endif -%}
                                                        {%- endif -%}

                                                        {%- if card.available_sold_txt.value != blank or card.unavailable_sold_txt.value != blank -%}
                                                            {%- if schema_settings.progress_coupon == "progress" -%}
                                                            <div class="landing-block--product-progress relative {%if has_act == true%} active{%endif%}">
                                                                <input type="range" value="0" min="0.5" max="99.99">
                                                                <div class="jk-seekbar-progress" style="translate: none; rotate: none; scale: none; transform: translate(0px, 0px);">
                                                                    <div role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width: 0%;background:var(--jds-color-primary);--before-col:var(--jds-color-primary);"></div>
                                                                </div>
                                                                <div class="landing-block--product-progress--content flex">
                                                                    {%- assign un_sold = card.unavailable_sold_txt.value | replace: '{num}', card.init_num.value -%}
                                                                    {%- assign _u = 100 | minus: card.init_num.value -%}
                                                                    {%- assign a_sold = card.available_sold_txt.value | replace: '{num}', _u -%}
                                                                    {%- if card.unavailable_sold_txt.value != blank -%}
                                                                    <span class="landing-block--product--sold">{{un_sold}}</span>
                                                                    {%- endif -%}

                                                                    {%- if card.available_sold_txt.value != blank -%}
                                                                    <span class="landing-block--product--unsold">{{a_sold}}</span>
                                                                    {%- endif -%}
                                                                </div>
                                                            </div>
                                                            {%- endif -%}
                                                        {%- endif -%}

                                                        {%- if card.Installment_text.value != blank -%}
                                                        <div class="landing-block--product-affirm flex">
                                                            <span>{{card.Installment_text.value | escape}}</span>
                                                            {%- if card.Installment_icon.value != blank -%}
                                                                <img src="{{card.Installment_icon.value | image_url: width: 72}}" alt="{{card.Installment_text.value | escape}}" loading="lazy" width="{{ card.Installment_icon.value.width }}" height="{{ card.Installment_icon.value.height }}" />
                                                            {%- endif -%}
                                                        </div>
                                                        {%- endif -%}
                                                    </div>
                                                    <div class="landing-block--product-pmain--bottom flex" style="--a-col:var(--jds-color-primary);--a-bg:var(--jds-color-primary);--a-solid-bg:#ffffff;">
                                                        {% comment %} 加入购物车 {% endcomment %}
                                                        {%- if schema_settings.add_to_cart != blank -%}
                                                            <a {%if product_card.available != true%}disabled{%endif%} btn-action="addtocart"
                                                                date-loading data-ga-event="activity_page_user_clicks"
                                                                data-ga-action="click" data-ga-params-module="Product Display"
                                                                data-ga-params-content="{{schema_settings.all_txt | escape}}"
                                                                data-ga-params-position="{{product_card.sku}}"
                                                                data-ga-params-button_name="{{schema_settings.add_to_cart | escape}}"
                                                                data-ga-params-link="" data-ga-params-type="{{sb_types}}"
                                                                {% if schema_settings.add_cart_solid == true %}
                                                                    btn-solid
                                                                    class="{% if product_card.available != true %} sold-out {% endif %}"
                                                                {% endif %}

                                                            >
                                                                {%- if product_card.available != true -%}
                                                                    {{ 'products.product.sold_out' | t }}
                                                                {%- else -%}
                                                                    <span> {{schema_settings.add_to_cart | escape}}</span>
                                                                {%- endif -%}
                                                                <div class="loading__spinner loading__spinner__dark">
                                                                    <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                                                                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                                                                    </svg>
                                                                </div>
                                                            </a>
                                                        {%- endif -%}

