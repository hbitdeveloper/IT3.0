{%- comment -%} v4 {%- endcomment -%}
{% style %}
  @media screen and (max-width: 1023.98px) {
    .pay-wrannty.v4{
      max-width: 91.4666666666667vw;
      width: 91.4666666666667vw;
      margin: 6.4vw auto 6.4vw;
    }
  }
{% endstyle %}

<div class="pay-wrannty v4 {{ block_class }}">
  <div class="pay-wrannty-title">{{ first_icon_list.section_title }}</div>
  <div class="pay-wrannty-list">
    {%- if warranty_list.size > 0 -%}
      {%- for zitem in warranty_list -%}
        {% if zitem.settings.title != blank %}
          <div class="pay-wrannty-item flex items-center">
            {%- render 'responsive-image', image: zitem.settings.icon, width: 24, mwidth: 24 -%}
            <span class="text-overflow-1">{{ zitem.settings.title }}</span>
          </div>
        {%- endif -%}
      {% endfor %}
    {%- elsif warranty_enable -%}
      {% for item in first_icon_list.warranty_list.value %}
        {% if item.title != blank %}
          <div class="pay-wrannty-item flex items-center">
            {%- render 'responsive-image', image: item.icon, width: 24, mwidth: 24 -%}
            <span class="text-overflow-1">{{ item.title }}</span>
          </div>
        {%- endif -%}
      {% endfor %}
    {%- endif -%}
  </div>
  {%- if pay_enable and first_icon_list.link_list != blank -%}
    <div class="new-pay-box flex lg:pt-2.5 pt-1 gap-3.5">
      {%- if first_icon_list.total_icon != blank -%}
        <img class="w-6 h-6 max-w-none" src="{{first_icon_list.total_icon  | image_url: width: 80}}" alt="{{first_icon_list.total_icon.alt | escape}}" width="24" height="24" loading="lazy">
      {%- endif -%}
      {% render 'payment-icons' %}
    </div>
  {%- endif -%}
</div>
