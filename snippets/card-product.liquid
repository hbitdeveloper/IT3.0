<div class="{% if main == true %}blog-cate-first{% else %}article-card{% endif %} blog-card focus-zoom-container flex flex-col">
    <div class="blog-img product">
        <img class="object-cover focus-zoom"
            src="{{card_product.featured_media | image_url: width: 388}}"
            alt="{{card_product.featured_media.alt}}"
            {% unless lazy_load == false %}
              loading="lazy"
            {% endunless %}
        >
    </div>
    <div class="blog-info-card flex flex-col flex-1">
        <div class="blog-tags flex"></div>
        <div class="flex flex-col justify-between flex-1">
            <div class="blog-content">
                {% if card_product.url %}
                    <div class="blog-item-title {% if main == true %}jky-text-xl{% else %}jky-text-base{% endif %} font-bold">
                        <a class="text-black" href="{{card_product.url}}">{{card_product.title | escape}}</a>
                    </div>
                {% else %}
                    <div class="blog-item-title {% if main == true %}jky-text-xl{% else %}jky-text-base{% endif %} font-bold">{{card_product.title | escape}}</div>
                {% endif %}
            </div>
            <div class="blog-item-detail flex justify-between items-center">
                <div class="blog-item-date {% if main == true %}jky-text-base{% else %}jky-text-xs{% endif %}"></div>
                <a class="z-button-fill-middle" href="{{card_product.url}}" data-analytics-title="{{ card_product.title | escape }}">
                    {{ 'general.action_text.view_more' | t }}
                    <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
                </a>
            </div>
        </div>
    </div>
</div>