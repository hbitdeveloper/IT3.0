<div id="red-packet">
    <div
        class="
            packet hidden select-none fixed right-20 bottom-1/2 w-122 h-120 cursor-pointer z-99999
            lg:j-w-112 lg:j-h-110
            xl:a-w-112 xl:a-h-110
        "
        style="display:none;"
    >
        {% comment %} 关闭按钮 {% endcomment %}
        <img
            id="red-packet-close"
            class="
                select-none gift-close absolute right-0 top-0 w-32 h-32 z-1
                lg:j-w-24 lg:j-h-24
                xl:a-w-24 xl:a-h-24
            "
            src="https://cdn.shopify.com/s/files/1/0550/0524/9633/files/982d51fb107b78fb06274504042f214f.png?v=1688981230" loading="lazy"
        >
    
        {% comment %} 背景动画 {% endcomment %}
        <img class="select-none gift-bg-reverse img-fixed"
            src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/3_88fa3099-3324-4c5f-a519-7c911304f2a4.png?v=1684809566"
            alt="" loading="lazy"
        >
        {% comment %} 固定背景 {% endcomment %}
        <img
            class="select-none img-fixed"
            src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/1_8e720c13-117b-4c47-bd18-ac9da057b5c8.png?v=1684745586"
            alt="" loading="lazy"
        >

        <div class="w-120 px-6">
            {% comment %} 手势动画 {% endcomment %}
            <img
                class="select-none click-guide"
                src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/357008c57ba906080e2460a3dea27eae.png?v=1684745586"
                alt="" loading="lazy"
            >
            <div class="gift-bg">
                <div class="hidden" data-points>
                    <img
                        class="select-none img-fixed lazyload"
                        data-src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/2_c1744176-5c87-4521-b168-e722fdf7f767.png?v=1684745586"
                        alt="membership"
                        loading="lazy"
                    >
                    <div
                        class="
                            w-full absolute left-1/2 top-40 -translate-x-1/2 items-end flex-col font-bold text-primary -rotate-18 z-1
                            lg:j-top-28
                            xl:a-top-28
                        "
                    >
                        <span
                            class="
                                block w-full text-right text-12 leading-12 mb-8 pr-28 scale-83.33333333333
                                lg:j-text-12 lg:j-leading-12 lg:j-mt-4 lg:j-mb-2 lg:j-pr-26
                                xl:a-text-12 xl:a-leading-12 xl:a-mt-4 xl:a-mb-2 xl:a-pr-26
                            "
                        >{{ 'gift_cards.off' | t }}</span>
                        <span
                            class="
                                block w-full text-center text-14 leading-14 pr-20
                                lg:j-text-16 lg:j-leading-16 lg:j-pl-4 lg:j-pr-12
                                xl:a-text-16 xl:a-leading-16 xl:a-pl-4 xl:a-pr-12
                            "
                            data-point-value
                        ></span>
                        <span
                            class="
                                block w-full text-center text-14 leading-14 pr-20
                                lg:j-text-18 lg:j-leading-20 lg:j-pl-4 lg:j-pr-12
                                xl:a-text-18 xl:a-leading-20 xl:a-pl-4 xl:a-pr-12
                            "
                            data-percenter
                        ></span>
                    </div>
                </div>

                <div class="hidden" data-giftcard>
                    <img
                        class="select-none img-fixed"
                        src="https://cdn.shopifycdn.net/s/files/1/0550/0524/9633/files/2_0d18b5fb-f218-4d4a-a288-d9fa602c0cb0.png?v=1684745586"
                        alt="" loading="lazy"
                    >

                    <div
                        class="
                            w-full text-center absolute left-1/2 top-28 -translate-x-1/2 pr-20 font-bold text-primary -rotate-15 z-1
                            lg:j-top-32 lg:j-pl-4 lg:j-pr-12
                            xl:a-top-32 xl:a-pl-4 xl:a-pr-12
                        "
                    >
                        <span
                            class="
                                text-20 leading-20
                                lg:j-text-20 lg:j-leading-20
                                xl:a-text-20 xl:a-leading-20
                            "
                            data-giftcard-value
                        ></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

