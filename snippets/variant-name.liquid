{% comment %}
  Renders a list of product's title

  Accepts:
  - product: {Object} Product variant Liquid object (optional)
 
  Usage:
  {% render 'variant-name', variant: variant %}
{% endcomment %}

{%- if variant -%}
    {%- if variant.metafields.custom.shortname != blank -%}
        {{ variant.metafields.custom.shortname }}
    {%- else -%}
        {%- if variant.title == 'Default Title' -%}
            {{ variant.product.title }}
        {%- else -%}
            {{ variant.title }}
        {%- endif -%}
    {%- endif -%}
{%- endif -%}