{% comment %} 4.0商详页内容组件（Product Detail Page V4 Content） - 一行三组图文 {% endcomment %}
{{ 'pdp-three-text-img.min.css' | asset_url | stylesheet_tag }}

{% if settings.swiper %}
  <style>
    .pdp-three-text-img.keyword .quality-swiper-container {
      position: relative;
    }
    .pdp-three-text-img.keyword .quality-pagination {
      width: 482px;
      background: #fff;
      margin: 40px auto 0;
      height: 6px;
      border-radius: 3px;
      display: flex;
    }
    .pdp-three-text-img.keyword .quality-pagination .swiper-pagination-bullet {
      z-index: 1;
      flex: 1;
      margin: 0;
      height: 6px;
      border-radius: 3px;
      background-color: #FFFFFF;
    }
    .pdp-three-text-img.keyword .quality-pagination .swiper-pagination-bullet-active {
      border-radius: 3px;
      margin: 0;
      height: 6px;
      background-color: var(--jds-color-primary);
    }
    .pdp-three-text-img.keyword .swiper-navigation .swiper-activity-button-prev,
    .pdp-three-text-img.keyword .swiper-navigation .swiper-activity-button-next {
      top: unset;
      background-color: #7a7a7d;
      border-radius: 50%;
      color: #fff;
      bottom: -15px;
      height: 40px;
      transition: transform 0.5s ease, border-color 0.5s ease;
      width: 40px;
    }
    .pdp-three-text-img.keyword .swiper-navigation .swiper-activity-button-prev:after,
    .pdp-three-text-img.keyword .swiper-navigation .swiper-activity-button-next:after {
      font-size: 17px;
      font-weight: bold;
      transition: none;
    }
    .pdp-three-text-img.keyword .swiper-navigation .swiper-button-disabled {
      opacity: 1;
      background-color: #bcbcbe !important;
      pointer-events: unset !important;
    }

    .keyword-three-text-img .pdp-three-text-img .card-list img {
      height: 421px;
    }

    .keyword-three-text-img .pdp-three-text-img .card-list .three-video-box{
      height: 421px;
    }

    @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
      .keyword-three-text-img .pdp-three-text-img .card-list img {
        height: 29.2361111vw;
      }
      .keyword-three-text-img .pdp-three-text-img .card-list .three-video-box{
        height: 29.2361111vw;
      }
    }
    @media screen and (max-width: 1023.98px) {
      .pdp-three-text-img.keyword {
        width: 100%;
        margin: 0;
      }
      .pdp-three-text-img.keyword .quality-swiper-container {
        padding: 0;
      }
      .pdp-three-text-img.keyword .quality-swiper-container .card-list {
        flex-direction: inherit;
        align-items: inherit;
      }
      .pdp-three-text-img.keyword .quality-swiper-container .card-list .swiper-slide {
        width: 100%;
      }
      .pdp-three-text-img.keyword .quality-swiper-container .card-list .three-video-box {
        width: 100%;
      }
      .pdp-three-text-img.keyword .quality-swiper-container .card-list .three-video-box img {
        width: 100%;
        height: 100%;
        margin-left: 0;
        margin-right: 0;
      }
      .pdp-three-text-img.keyword .quality-swiper-container .card-list .info-text {
        width: 100%;
      }
      .pdp-three-text-img.keyword .card-list img {
        width: 100%;
        margin-left: unset;
        margin-right: unset;
      }
      .pdp-three-text-img.keyword .card-list .three-video-box {
        width: 100%;
        height: 72.164vw;
        margin-left: unset;
        margin-right: unset;
      }
      .pdp-three-text-img.keyword .card-list .info-text {
        width: auto;
      }
      .pdp-three-text-img.keyword .quality-swiper-container {
        padding-left: 4.26666667vw;
        position: relative;
      }
      .pdp-three-text-img.keyword .quality-pagination {
        width: 70.66666667vw;
        background: #D8D8D8;
        margin: 5.33333333vw auto 0;
        height: 4px;
        border-radius: 3px;
        display: flex;
      }
      .pdp-three-text-img.keyword .quality-pagination .swiper-pagination-bullet {
        height: 4px;
        border-radius: 3px;
      }
      .pdp-three-text-img.keyword .quality-pagination .swiper-pagination-bullet-active {
        border-radius: 3px;
        height: 4px;
      }
      .pdp-three-text-img.keyword .swiper-navigation {
        display: none;
      }

      .keyword-three-text-img .pdp-three-text-img .card-list img {
        height: 72.164vw;
      }
    }
  </style>
{% endif %}

<div class="pdp-three-text-img  pdp-three-text-img-{{ section.id }} pdp-container {% if settings.swiper == true %} keyword {% endif %}" data-play-video-by-order="{{ settings.play_by_order }}">
  {% assign brand_color = '<em style="color: var(--jds-color-primary)">' %}

  {% if settings.sectionTitle != blank %}
    <h2 class="section-title">
      {{ settings.sectionTitle | replace: '<em>', brand_color }}
    </h2>
  {% endif %}

  {% if settings.sub != blank %}
    <div class="keyword-sub">
      {{ settings.sub }}
    </div>
  {% endif %}

  {% assign pcHeight = 395 %}
  {% if settings.swiper %}
    {% assign pcHeight = 421 %}
  {% endif %}

  <div class="{% if settings.swiper == true %} quality-swiper-container {% else %} pdp-three-normal {% endif %}">
    <div class="{% if settings.swiper == true %} swiper quality-introduction-swiper {% endif %}">
      <div class="card-list flex {% if settings.swiper == true %} swiper-wrapper {% endif %} ">
        <div class="card-item swiper-slide">
          {% comment %} 视频展示 {% endcomment %}
          {% if settings.videoSrc != blank %}
            {%- assign autoplay = settings.autoplay -%}
            {%- assign loop = settings.loop -%}
            {%- if settings.play_by_order == true -%}
              {%- assign autoplay = false -%}
              {%- assign loop = false -%}
            {%- endif -%}
    
            {%- render 'jky-video',
              video_url: settings.videoSrc,
              poster: settings.poster,
              isHidePauseBtn: false,
              class: 'three-video-box pc-show',
              autoplay: autoplay,
              controls: settings.controls,
              loop: loop,
            -%}
          {% else %}
            <div class="pc-show">
              {% render 'pdp-picture-card',
                cardTitle: settings.title,
                pcEmptyShowBlank: true,
                pcImg: settings.partOnePCImg,
                pcWidth: 421,
                pcHeight: pcHeight,
                mbEmptyShowBlank: false,
                mbImg: settings.partOneMBImg,
                mbWidth: 686,
                mbHeight: 644
              %}
            </div>
          {% endif %}
    
          {% if settings.videoSrcMB != blank %}
            {%- assign autoplay = settings.autoplay -%}
            {%- assign loop = settings.loop -%}
            {%- if settings.play_by_order == true -%}
              {%- assign autoplay = false -%}
              {%- assign loop = false -%}
            {%- endif -%}
    
            {%- render 'jky-video',
              video_url: settings.videoSrcMB,
              poster: settings.posterMB,
              isHidePauseBtn: false,
              class: 'three-video-box mb-show',
              autoplay: autoplay,
              controls: settings.controls,
              loop: loop,
            -%}
          {% else %}
            <div class="mb-show">
              {% render 'pdp-picture-card',
                cardTitle: settings.title,
                pcEmptyShowBlank: true,
                pcImg: settings.partOnePCImg,
                pcWidth: 421,
                pcHeight: pcHeight,
                mbEmptyShowBlank: false,
                mbImg: settings.partOneMBImg,
                mbWidth: 686,
                mbHeight: 644
              %}
            </div>
          {% endif %}
    
          {% if settings.partOneTitle != blank %}
            <h3 class="title info-text">
              {{ settings.partOneTitle | replace: '<em>', brand_color }}
            </h3>
          {% endif %}
          {% if settings.partOneSubtitle != blank %}
            <div class="subtitle info-text">
              {{ settings.partOneSubtitle | replace: '<em>', brand_color }}
            </div>
          {% endif %}
        </div>
        <div class="card-item swiper-slide">
          {% comment %} 视频展示 {% endcomment %}
          {% if settings.videoSrcTwo != blank %}
            {%- assign autoplayTwo = settings.autoplayTwo -%}
            {%- assign loopTwo = settings.loopTwo -%}
            {%- if settings.play_by_order == true -%}
              {%- assign autoplayTwo = false -%}
              {%- assign loopTwo = false -%}
            {%- endif -%}
    
            {%- render 'jky-video',
              video_url: settings.videoSrcTwo,
              poster: settings.posterTwo,
              isHidePauseBtn: false,
              class: 'three-video-box pc-show',
              autoplay: autoplayTwo,
              controls: settings.controlsTwo,
              loop: loopTwo
            -%}
          {% else %}
            <div class="pc-show">
              {% render 'pdp-picture-card',
                cardTitle: settings.title,
                pcEmptyShowBlank: true,
                pcImg: settings.partTwoPCImg,
                pcWidth: 421,
                pcHeight: pcHeight,
                mbEmptyShowBlank: false,
                mbImg: settings.partTwoMBImg,
                mbWidth: 686,
                mbHeight: 644
              %}
            </div>
          {% endif %}
    
          {% if settings.videoSrcMBTwo != blank %}
            {%- assign autoplayTwo = settings.autoplayTwo -%}
            {%- assign loopTwo = settings.loopTwo -%}
            {%- if settings.play_by_order == true -%}
              {%- assign autoplayTwo = false -%}
              {%- assign loopTwo = false -%}
            {%- endif -%}
    
            {%- render 'jky-video',
              video_url: settings.videoSrcMBTwo,
              poster: settings.posterMBTwo,
              isHidePauseBtn: false,
              class: 'three-video-box mb-show',
              autoplay: autoplayTwo,
              controls: settings.controlsTwo,
              loop: loopTwo
            -%}
          {% else %}
            <div class="mb-show">
              {% render 'pdp-picture-card',
                cardTitle: settings.title,
                pcEmptyShowBlank: true,
                pcImg: settings.partTwoPCImg,
                pcWidth: 421,
                pcHeight: pcHeight,
                mbEmptyShowBlank: false,
                mbImg: settings.partTwoMBImg,
                mbWidth: 686,
                mbHeight: 644
              %}
            </div>
          {% endif %}
    
          {% if settings.partTwoTitle != blank %}
            <h3 class="title info-text">
              {{ settings.partTwoTitle | replace: '<em>', brand_color }}
            </h3>
          {% endif %}
          {% if settings.partTwoSubtitle != blank %}
            <div class="subtitle info-text">
              {{ settings.partTwoSubtitle | replace: '<em>', brand_color }}
            </div>
          {% endif %}
        </div>
        <div class="card-item swiper-slide">
          {% comment %} 视频展示 {% endcomment %}
          {%- if settings.videoSrcThree != blank -%}
            {%- assign autoplayThree = settings.autoplayThree -%}
            {%- assign loopThree = settings.loopThree -%}
            {%- if settings.play_by_order == true -%}
              {%- assign autoplayThree = false -%}
              {%- assign loopThree = false -%}
            {%- endif -%}
    
            {%- render 'jky-video',
              video_url: settings.videoSrcThree,
              poster: settings.posterThree,
              isHidePauseBtn: false,
              class: 'three-video-box pc-show',
              autoplay: autoplayThree,
              controls: settings.controlsThree,
              loop: loopThree
            -%}
          {% else %}
            <div class="pc-show">
              {% render 'pdp-picture-card',
                cardTitle: settings.title,
                pcEmptyShowBlank: true,
                pcImg: settings.partThreePCImg,
                pcWidth: 421,
                pcHeight: pcHeight,
                mbEmptyShowBlank: false,
                mbImg: settings.partThreeMBImg,
                mbWidth: 686,
                mbHeight: 644
              %}
            </div>
          {% endif %}
    
          {% if settings.videoSrcMBThree != blank %}
            {%- assign autoplayThree = settings.autoplayThree -%}
            {%- assign loopThree = settings.loopThree -%}
            {%- if settings.play_by_order == true -%}
              {%- assign autoplayThree = false -%}
              {%- assign loopThree = false -%}
            {%- endif -%}
    
            {%- render 'jky-video',
              video_url: settings.videoSrcMBThree,
              poster: settings.posterMBThree,
              isHidePauseBtn: false,
              class: 'three-video-box mb-show',
              autoplay: autoplayThree,
              controls: settings.controlsThree,
              loop: loopThree
            -%}
          {% else %}
            <div class="mb-show">
              {% render 'pdp-picture-card',
                cardTitle: settings.title,
                pcEmptyShowBlank: true,
                pcImg: settings.partThreePCImg,
                pcWidth: 421,
                pcHeight: pcHeight,
                mbEmptyShowBlank: false,
                mbImg: settings.partThreeMBImg,
                mbWidth: 686,
                mbHeight: 644
              %}
            </div>
          {% endif %}
    
          {% if settings.partThreeTitle != blank %}
            <h3 class="title info-text">
              {{ settings.partThreeTitle | replace: '<em>', brand_color }}
            </h3>
          {% endif %}
          {% if settings.partThreeSubtitle != blank %}
            <div class="subtitle info-text">
              {{ settings.partThreeSubtitle | replace: '<em>', brand_color }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    
    {% if settings.swiper == true %}
      <div class="quality-pagination"></div>
    {% endif %}
  </div>


</div>

<script defer src="{{ 'pdp-three-text-img.min.js' | asset_url }}"></script>
