<section class="photovolatic-for-balcony-wrap w-full bg-white lg:bg-#F5F3EF flex-center flex-col p-40 lg:px-0 lg:j-pt-80 lg:j-pb-108">
    <h2 class="w-full text-center font-600 text-black lg:j-w-1280 xl:a-w-1280 text-48 leading-68 mb-24 lg:j-text-40 lg:j-leading-64 lg:j-mb-20 xl:a-text-40 xl:a-leading-64 xl:a-mb-20">
      {{ settings.title | newline_to_br }}
    </h2>
    <h3 class="w-full text-center font-400 text-#626262 text-32 leading-48 -mt-20 mb-40 lg:j-text-18 lg:j-leading-26 -lg:j-mt-15 lg:j-mb-30 xl:a-text-18 xl:a-leading-26 -xl:a-mt-15 xl:a-mb-30">
      {{ settings.sub_title | newline_to_br }}
    </h3>

    {%- assign sizes = 0 -%}
    {%- for i in (0..3) -%}
        {% assign heading_index = 'heading_' | append: forloop.index %}
        {% assign pc_img_index = 'pc_img_' | append: forloop.index %}

        {%- if settings[heading_index] and settings[pc_img_index] -%}
            {%- assign sizes = sizes | plus: 1 -%}
        {%- endif -%}
    {%- endfor -%} 

    {% comment %} PC 端 Product Swiper {% endcomment %}
    <div
      class="!hidden swiper-left-right-wrap flex items-start justify-start lg:j-w-1280 lg:j-gap-x-20 xl:a-w-1280 xl:a-gap-x-20"
      data-autoplay="{{ settings.autoplay }}"
      data-autoplay-delay="{{ settings.autoplay_delay }}"
      data-size="{{sizes}}"
    >
        <div class="swiper-thumbs-small-images lg:j-w-185 lg:j-h-562 xl:a-w-185 xl:a-h-562">
            <div class="swiper-wrapper w-full flex-col lg:j-gap-y-14 xl:a-gap-y-14">
              {%- for i in (0..3) -%}
                  {% assign heading_index = 'heading_' | append: forloop.index %}
                  {% assign icon_index = 'icon_' | append: forloop.index %}
                  {% assign pc_img_index = 'pc_img_' | append: forloop.index %}
              
                  {%- if settings[heading_index] and settings[pc_img_index] -%}
                      <div class="swiper-slide flex-center flex-col border-transparent border-solid !lg:j-w-185 !lg:j-h-130 lg:j-rounded-12 lg:j-border-3 lg:j-px-10 lg:j-pt-10 !xl:a-w-185 !xl:a-h-130 xl:a-rounded-12 xl:a-border-3 xl:a-pt-10 xl:a-px-10 bg-white cursor-pointer">
                        {%- if settings[icon_index] -%}
                        <img class="lg:j-w-92 lg:j-h-64 xl:a-w-92 xl:a-h-64" src="{{ settings[icon_index] | image_url: width: 200 }}" alt="{{settings[heading_index] | escape}}" width="92" width="64" loading="lazy" />
                        {%- endif -%}
                        
                        <h2 class="font-400 text-#666 lg:j-text-18 lg:j-leading-40 xl:a-text-18 xl:a-leading-40">{{ settings[heading_index] | escape }}</h2>
                      </div>
                  {%- endif -%}
              {%- endfor -%} 
            </div>
        </div>
        <div class="swiper swiper-main-content-images flex-1 lg:j-rounded-12 xl:a-rounded-12 lg:j-h-562 xl:a-h-562">
            <div class="swiper-wrapper">
              {%- for i in (0..3) -%}
                  {% assign heading_index = 'heading_' | append: forloop.index %}
                  {% assign description_index = 'description_' | append: forloop.index %}
                  {% assign icon_index = 'icon_' | append: forloop.index %}
                  {% assign pc_img_index = 'pc_img_' | append: forloop.index %}
                  {% assign mb_img_index = 'mb_img_' | append: forloop.index %}

                  {%- if settings[heading_index] and settings[pc_img_index] -%}
                    <div class="swiper-slide relative">
                      <div class="w-full h-full rounded-24 lg:j-rounded-12 xl:a-rounded-12 overflow-hidden relative">
                        {% comment %} image {% endcomment %}
                        <picture class="w-full h-full block">
                          <source media="(min-width:1024px)" srcset="{{ settings[pc_img_index] | image_url: width: 1920 }}">
                          <img
                            class="w-full h-full object-cover"
                            src="{{ settings[mb_img_index] | image_url: width: 750 }}"
                            alt="{{ settings[mb_img_index].alt | escape }}"
                            loading="lazy"
                          >
                        </picture>
                        <div class="absolute lg:j-left-50 lg:j-top-50 lg:j-w-627 xl:a-left-50 xl:a-top-50 xl:a-w-627">
                          <h2 class="font-600 text-white/90 lg:j-text-32 lg:j-leading-40 lg:j-mb-10 xl:a-text-32 xl:a-leading-40 xl:a-mb-10">{{ settings[heading_index] | escape }}</h2>
                          <p class="font-500 text-white lg:j-text-16 lg:j-leading-24 xl:a-text-16 xl:a-leading-24">{{ settings[description_index] | newline_to_br }}</p>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
              {%- endfor -%} 
            </div>
        </div>
    </div>

    {% comment %} MB 端 Product Swiper {% endcomment %}
    <div class="hidden w-full swiper swiper-main-content-mb">
        <div class="swiper-wrapper">
          {%- for i in (0..3) -%}
              {% assign heading_index = 'heading_' | append: forloop.index %}
              {% assign description_index = 'description_' | append: forloop.index %}
              {% assign icon_index = 'icon_' | append: forloop.index %}
              {% assign pc_img_index = 'pc_img_' | append: forloop.index %}
              {% assign mb_img_index = 'mb_img_' | append: forloop.index %}

              {%- if settings[heading_index] and settings[pc_img_index] -%}
                <div class="swiper-slide">
                    <div class="w-full h-600 relative">
                        {% comment %} image {% endcomment %}
                        <picture>
                          <source media="(min-width:1024px)" srcset="{{ settings[pc_img_index] | image_url: width: 1920 }}">
                          <img
                            class="w-full h-600 object-cover"
                            src="{{ settings[mb_img_index] | image_url: width: 750 }}"
                            alt="{{settings[mb_img_index].alt | escape}}"
                            loading="lazy"
                          >
                        </picture>
                    </div>
                    <h2 class="font-bold text-40 leading-80 mt-30">{{ settings[heading_index] | escape }}</h2>
                    <p class="w-full text-32 leading-44 text-left">{{ settings[description_index] | newline_to_br }}</p>
                </div>
              {%- endif -%}
          {%- endfor -%} 
        </div>
        <div class="swiper-pagination swiper-photovolatic-pagination"></div>
        <div class="swiper-button-next swiper-photovolatic-button-next"></div>
        <div class="swiper-button-prev swiper-photovolatic-button-prev"></div>
    </div>
</section>