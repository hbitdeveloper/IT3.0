{% comment %}
    value_jackery:jackery&&value_shopify:Shopify
{% endcomment %}
{% assign optionList = options | split: '&&' %}

<jky-drop-menu data-error="{{error_text | escape}}" class="{{ class }}">
    <label for="{{value | handleize}}">{{key}}</label>

    <details-disclosure>
        <details id="gejhnvmk">
            <summary
                class="jky_drop_menu_field list-menu__item link focus-inset"
                role="button" aria-expanded="false"
            >
                <input
                    type="text"
                    readonly
                    id="{{value | handleize}}"
                    name="{{value | handleize}}"
                    placeholder="{% if placeholder != blank %}{{placeholder}}{% else %}{{key}}{% endif %}"
                    data-value="{{value | escape}}"
                />

                <svg focusable="false" class="jky_drop_menu_field_arrow absolute" data-icon="down" width="1em" height="1em" fill="#333" aria-hidden="true" viewBox="64 64 896 896"><path d="M884 256h-75c-5.1 0-9.9 2.5-12.9 6.6L512 654.2 227.9 262.6c-3-4.1-7.8-6.6-12.9-6.6h-75c-6.5 0-10.3 7.4-6.5 12.7l352.6 486.1c12.8 17.6 39 17.6 51.7 0l352.6-486.1c3.9-5.3.1-12.7-6.4-12.7z"></path></svg>
            </summary>

            <ul class="list-menu--disclosure" tabindex="-1">
                {% for option in optionList %}
                    {% assign option_item = option | split: ':' %}
                    <li data-key="{{option_item[0]}}" data-label="{{option_item[1]}}">
                        {{option_item[1]}}
                    </li>
                {% endfor %}
            </ul>
            <div class="jky-overlay" style="z-index: 2025;"></div>
        </details>
    </details-disclosure>
</jky-drop-menu>
