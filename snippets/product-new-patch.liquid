<script defer>
    document.addEventListener('DOMContentLoaded', () => {
        function insertAfter(newNode, referenceNode) {
            if (!newNode || !referenceNode) return;
            const parent = referenceNode?.parentNode;
            const nextNode = referenceNode?.nextSibling;
            if (nextNode) {
                parent.insertBefore(newNode, nextNode);
            } else {
                parent.appendChild(newNode);
            }
        }

        function getAnchor(selector, fallbackSelector) {
            return document.querySelector(selector) || document.querySelector(fallbackSelector);
        }

        function slideToggle(element, callback) {
            if (!element) return;
            const isHidden = window.getComputedStyle(element).display === 'none';
            element.classList.add('animating');
            element.style.overflow = 'hidden';
            element.style.transition = 'height 0.3s ease';

            if (isHidden) {
                element.style.display = 'block';
                const height = element.scrollHeight;
                element.style.height = '0px';
                requestAnimationFrame(() => {
                    element.style.height = `${height}px`;
                });
                window.setTimeout(() => {
                    element.style.height = '';
                    element.style.overflow = '';
                    element.style.transition = '';
                    element.classList.remove('animating');
                    callback && callback();
                }, 300);
            } else {
                element.style.height = `${element.scrollHeight}px`;
                requestAnimationFrame(() => {
                    element.style.height = '0px';
                });
                window.setTimeout(() => {
                    element.style.display = 'none';
                    element.style.height = '';
                    element.style.overflow = '';
                    element.style.transition = '';
                    element.classList.remove('animating');
                    callback && callback();
                }, 300);
            }
        }

        insertAfter(document.querySelector('.tabs-header'), document.querySelector('.section-product-main-new'));
        document.querySelectorAll('.J-tabs-point li').forEach((item) => {
            item.addEventListener('click', function() {
                const siblings = this.parentElement ? Array.from(this.parentElement.children) : [];
                siblings.forEach((li) => li.classList.remove('active'));
                this.classList.add('active');
                let point = this.dataset.point;
                let top = null;

                // 兼容设置/自定义anchor
                let anchor_1 = getAnchor("[data-anchor='anchor__1']", '#features');
                let anchor_2 = getAnchor("[data-anchor='anchor__2']", '#specs');
                let anchor_3 = getAnchor("[data-anchor='anchor__3']", '.shopify-section.faq');
                let anchor_4 = getAnchor("[data-anchor='anchor__4']", '.shopify-section.reviews');
                let anchor_5 = getAnchor("[data-anchor='anchor__5']", '.tabs-five-video');

                switch (point) {
                    case "features": top = anchor_1?.offsetTop; break;
                    case "specs": top = anchor_2?.offsetTop; break;
                    case "faq": top = anchor_3?.offsetTop; break;
                    case "reviews": top = anchor_4?.offsetTop; break;
                    case "video": top = anchor_5?.offsetTop; break;
                }
                if (typeof top === 'number') scrollToTop(top);
            });
        });

        document.querySelectorAll('.J-header-slide').forEach((item) => {
            if (item?.dataset?.jkyHeaderSlideClickBound === '1') return;
            if (item?.dataset) item.dataset.jkyHeaderSlideClickBound = '1';
            item.addEventListener('click', function() {
                const content = this.parentElement?.parentElement?.querySelector('.content');
                if (content?.classList.contains('animating')) return;
                slideToggle(content);
                if (this.classList.contains('slide-up')) {
                    this.setAttribute('src', 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_4.svg?v=1678936033');
                    this.classList.remove('slide-up');
                } else {
                    this.setAttribute('src', 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033');
                    this.classList.add('slide-up');
                }
            });
        });

        document.querySelectorAll('.J-header-item-slide').forEach((item) => {
            if (item?.dataset?.jkyHeaderItemSlideClickBound === '1') return;
            if (item?.dataset) item.dataset.jkyHeaderItemSlideClickBound = '1';
            item.addEventListener('click', function() {
                const itemBoxContent = this.parentElement?.parentElement?.querySelector('.item-box-content');
                slideToggle(itemBoxContent);
                if (this.classList.contains('slide-up')) {
                    this.setAttribute('src', 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon_4.svg?v=1678936033');
                    this.classList.remove('slide-up');
                } else {
                    this.setAttribute('src', 'https://cdn.shopify.com/s/files/1/0550/0524/9633/files/icon-_5.svg?v=1678936033');
                    this.classList.add('slide-up');
                }
            });
        });

        // charge quickly
        document.querySelectorAll('.J-charge-quickly').forEach((chargeQuicklyEl) => {
            const tableItems = Array.from(chargeQuicklyEl.querySelectorAll('.table-item'));
            const mobTabs = Array.from(chargeQuicklyEl.querySelectorAll('.mob-tabs li'));
            const mobItems = Array.from(chargeQuicklyEl.querySelectorAll('.mob-items .table-item'));
            const imgBox = chargeQuicklyEl.querySelector('.img-box');

            tableItems.forEach((tableItem, index) => {
                tableItem.addEventListener('click', function() {
                    tableItems.forEach((el) => el.classList.remove('active'));
                    this.classList.add('active');
                    const src = this.dataset.bgImg || '';
                    if (imgBox) imgBox.setAttribute('src', src);
                    mobTabs.forEach((el) => el.classList.remove('active'));
                    mobTabs[index]?.classList.add('active');
                });
            });

            mobTabs.forEach((mobTab, index) => {
                mobTab.addEventListener('click', function() {
                    mobTabs.forEach((el) => el.classList.remove('active'));
                    this.classList.add('active');
                    const src = mobItems[index]?.dataset?.bgImg || '';
                    if (imgBox) imgBox.setAttribute('src', src);
                    mobItems.forEach((el) => el.classList.remove('active'));
                    mobItems[index]?.classList.add('active');
                });
            });
        });
    });
    function scrollToTop(position){
        if (!window.requestAnimationFrame) {
            window.requestAnimationFrame = function (cb) {
                return setTimeout(cb, 17)
            }
        }

        let scrollTop = document.documentElement.scrollTop || document.body.scrollTop || window.pageYOffset;

        const step = function () {
            const distance = position - scrollTop;
            scrollTop += distance / 5;
            if (Math.abs(distance) < 1) {
                window.scrollTo(0, position)
            } else {
                window.scrollTo(0, scrollTop);
                requestAnimationFrame(step)
            }
        };
        step()
    }
</script>
