<jky-bfcm>
  <div class="bfcm-box">
    <div class="flex pc-form">
      <div class="pf-form">
        {% assign titleColorSuccess = '<em style="color: ' | append: bfcm.bfcm_title_success_color | append: '">' %}
        <div class="lock_success">{{ bfcm.bfcm_title_success | replace: '<em>', titleColorSuccess }}</div>

        {% assign titleColor = '<em style="color: ' | append: bfcm.bfcm_title_color | append: '">' %}
        <div class="title">{{ bfcm.bfcm_title | replace: '<em>', titleColor }}</div>

        <div class="pf-form-container">
          <form>
            <div class="pf-form-row">
              <input
                type="email"
                name="email"
                class="field__input"
                value=""
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ bfcm.bfcm_placeholder }}"
                required
              >
              <div class="pf-row-btn pf-row-btn--disabled" style="background: {{ bfcm.bfcm_submit_bg }};">
                {{ bfcm.bfcm_submit }}
              </div>
            </div>
            {% comment %} <div class="pf-row-btn pf-row-btn--disabled" style="background: {{ bfcm.bfcm_submit_bg }};">{{ bfcm.bfcm_submit }}</div> {% endcomment %}
            <div class="form-emai-error" data-require="{{ bfcm.bfcm_required }}" data-rule="{{ bfcm.bfcm_error }}">
              <span>{{ bfcm.bfcm_error }}</span>
            </div>

            <label class="pf-form-checkbox">
              <div class="checkbox-container">
                <input type="checkbox" name="agree_policy">
                <span class="pf-checkbox-inner"></span>
              </div>
              <span class="pf-checkbox-info">{{ bfcm.bfcm_privacy }}</span>
              <span class="pf-checkbox-error">{{ bfcm.bfcm_privacy_error }}</span>
            </label>
          </form>
        </div>
      </div>
    </div>
  </div>

  {% comment %} 弹窗 {% endcomment %}
  <div class="bfcm-dialog">
    <div class="bfcm-dialog-sticky">
      {% assign titleColorModal = '<em style="color: ' | append: bfcm.bfcm_modal_title_color | append: '">' %}
      <div class="dialog-title text-overflow-2">{{ bfcm.bfcm_modal_title | replace: '<em>', titleColorModal }}</div>
      <div class="dialog-subtitle text-overflow-2">{{ bfcm.bfcm_modal_sub_title }}</div>
    </div>

    {% if new_product %}
      {% comment %} diy模板 {% endcomment %}
      <div class="product-list">
        {% for i in (0..3) %}
        {% assign product_id_index = 'product_id_' | append: forloop.index %}
        {% assign product_img_index = 'product_img_' | append: forloop.index %}
        {% assign product_title_index = 'product_title_' | append: forloop.index %}
        {% assign product_price_index = 'product_price_' | append: forloop.index %}
        {% assign product_origin_price_index = 'product_origin_price_' | append: forloop.index %}
        {% assign product_detail_index = 'product_detail_' | append: forloop.index %}
        {%- if bfcm[product_id_index] -%}
              <div class="product-list-item">
                <div class="product-media" data-src="{{ bfcm[product_detail_index] }}">
                  <img
                    src="{{  bfcm[product_img_index] | image_url: width: 170}}"
                    alt="{{ bfcm[product_img_index].alt }}"
                    class="product-img"
                    loading="lazy"
                  >
                </div>
                <div class="product-content">
                  <div class="product-title text-overflow-2" data-src="{{ bfcm[product_detail_index] }}">
                    {{ bfcm[product_title_index] }}
                  </div>
                  <div class="price-content">
                    <div class="discount-price">
                      <div class="price" data-discount-price="{{ bfcm[product_price_index] }}">
                        {{ bfcm[product_price_index] }}
                      </div>
                      <div class="price-tag">{{ bfcm.bfcm_modal_price }}</div>
                    </div>
                    <div class="origin-price">
                      <span>{{ bfcm[product_origin_price_index] }}</span>{{ bfcm.bfcm_modal_origin_price }}
                    </div>
                    <div class="add-cart" data-variant="{{ bfcm[product_id_index] }}">
                      {{ bfcm.bfcm_modal_cart }}
                    </div>
                  </div>
                </div>
              </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {% else %}
    {% comment %} 3.0模板 {% endcomment %}
      <div class="product-list">
        {%- for block in bfcmblocks -%}
          {%- case block.type -%}
            {%- when 'slide' -%}
              <div class="product-list-item">
                <div class="product-media" data-src="{{ block.settings.product_detail }}">
                  <img
                    src="{{  block.settings.product_img | image_url: width: 170}}"
                    alt="{{ block.settings.product_img.alt }}"
                    class="product-img"
                    loading="lazy"
                  >
                </div>
                <div class="product-content">
                  <div class="product-title text-overflow-2" data-src="{{ block.settings.product_detail }}">
                    {{ block.settings.product_title }}
                  </div>
                  <div class="price-content">
                    <div class="discount-price">
                      <div class="price" data-discount-price="{{ block.settings.product_price }}">
                        {{ block.settings.product_price }}
                      </div>
                      <div class="price-tag">{{ bfcm.bfcm_modal_price }}</div>
                    </div>
                    <div class="origin-price">
                      <span>{{ block.settings.product_origin_price }}</span>{{ bfcm.bfcm_modal_origin_price }}
                    </div>
                    <div class="add-cart" data-variant="{{ block.settings.product_id }}">
                      {{ bfcm.bfcm_modal_cart }}
                    </div>
                  </div>
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
</jky-bfcm>

<script defer>
  if (!customElements.get('jky-bfcm')) {
    customElements.define(
      'jky-bfcm',
      class JkyActivePf extends HTMLElement {
        constructor() {
          super();
          this.checked = false;
          this.is_new = false;
          this.innerDOM = document.createElement('div');
          this.innerDOM.classList.add('container');
          if (sessionStorage.getItem('__bfcm_subscribe')) {
            this.handleUnlock(sessionStorage.getItem('__bfcm_subscribe'));
          } else {
            this.initEvents();
          }

          this.querySelectorAll(
            '.product-list .product-list-item .product-media, .product-list .product-list-item .product-content .product-title'
          ).forEach((item) => {
            item.addEventListener('click', () => {
              const src = item.getAttribute('data-src');
              if (src) {
                try {
                  window.open(src, '_blank');
                } catch (error) {
                  window.location.href = src;
                }
              }
            });
          });
        }

        isiOS() {
          !!navigator.userAgent.match(/\(i[^;]+;( U;)? CPU.+Mac OS X/);
        }

        handleEmail() {
          this.email = this.querySelector('input[type=email]');
          this.email_error = this.querySelector('.form-emai-error');
          this.email_error_span = this.querySelector('.form-emai-error span');
          this.email_error_span.classList.remove('error');
          const value = this.email.value;

          if (!value) {
            this.email_error_span.innerText =
              (this.email_error && this.email_error.getAttribute('data-require')) || 'Enter Your Email Address';
            this.email_error_span.classList.add('error');
            return false;
          }

          if (value.indexOf('@') === -1) {
            this.email_error_span.innerText =
              (this.email_error && this.email_error.getAttribute('data-rule')) || 'Enter Correct Email Address';
            this.email_error_span.classList.add('error');
            return false;
          }
          return true;
        }

        handlePolicy() {
          this.checkbox = this.querySelector('input[type=checkbox]');
          this.checkbox_error = this.querySelector('.pf-checkbox-error');
          this.checkbox_error.classList.remove('error');
          const value = this.checkbox.checked;
          if (!value) {
            this.checkbox_error.classList.add('error');
            return false;
          }
          return true;
        }

        handleUnlock(email) {
          this.form_container = this.querySelector('.lock_success');
          this.form_container.classList.add('lock');
          this.querySelector('.pf-form-container').style.display = 'none';
          this.querySelector('.pf-form .title').style.display = 'none';
          this.querySelectorAll('.product-list .product-list-item').forEach((item) => {
            item.querySelector('.add-cart').addEventListener('click', (e) => {
              let cart_id = Number(e.target.getAttribute('data-variant'));
              let cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
              const item = [
                {
                  id: cart_id,
                  quantity: 1,
                  properties: {},
                },
              ];

              fetch('/cart/add.js', {
                credentials: 'same-origin',
                headers: {
                  'X-Requested-With': 'XMLHttpRequest',
                  'Content-Type': 'application/json;',
                },
                method: 'POST',
                body: JSON.stringify({ items: item }),
              })
                .then((res) => {
                  if (!res.ok) throw res;
                  if (cart && cart.renderContents) {
                    cart.renderContents(res);
                  }
                })
                .finally(() => {
                  if (cart && cart.classList.contains('is-empty')) cart.classList.remove('is-empty');

                  document
                    .querySelectorAll('[data-advantage-add-to-cart]')
                    .forEach((it) => it.classList.remove('btn--loading'));
                  document
                    .querySelectorAll('[data-end-add-to-cart]')
                    .forEach((it) => it.classList.remove('btn--loading'));
                });
            });
          });
        }

        handleSubscribe(email) {
          const tags = this.is_new ? 'BFCM-Subscribe,BFCM-Unlock' : 'BFCM-Unlock';
          fetch(`${window.pageInfo.api}/osconsumerapi/v1/notice/subscribe`, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
              cr: window?.pageInfo?.cr,
              lang: window?.pageInfo?.lang,
            },
            body: JSON.stringify({
              email,
              shopify_shop_id: window.pageInfo.shopId,
              tags,
              propertyValue: 'BFCM-Unlock',
            }),
          })
            .then((response) => response.json())
            .then((res) => {
              if (res.code === 200) {
                sessionStorage.setItem('__bfcm_subscribe', email);
                this.handleUnlock(email);
                const popupHtml = this.querySelector('.bfcm-dialog');
                const uniqueId = `bfcm-modal-id`;
                ZModle.getInstance(popupHtml, {
                  id: uniqueId,
                  class: 'bfcm-modal',
                  clickOutsideToClose: false
                });

              } else {
                window?.pushErrorMessage(res.message || 'Network Error');
              }
            })
            .catch((e) => {
              window?.pushErrorMessage(e);
            });
        }

        initEvents() {
          this.submit = this.querySelectorAll('.pf-row-btn');
          this.form = this.querySelector('form');
          this.email = this.querySelector('input[type=email]');
          this.checkbox = this.querySelector('input[type=checkbox]');
          this.submit.forEach((item) => {
            item.addEventListener('click', (e) => {
              e.preventDefault();
              if (!this.checked) return;
              const r_1 = this.handlePolicy();
              const r_2 = this.handleEmail();
              if (r_1 && r_2) {
                this.handleSubscribe(this.email.value);
              }
            });
          });
          this.email.addEventListener('input', (e) => {
            this.checked = false;
            this.is_new = false;
            this.querySelectorAll('.pf-row-btn').forEach((item) => {
              item.classList.add('pf-row-btn--disabled');
            });
            this.handleEmail();
          });

          this.email.addEventListener('blur', (e) => {
            if (this.handleEmail()) {
              this.checkLoginUserIsSubscribe(this.email.value)
                .then((res) => {
                  this.checked = true;
                  this.querySelectorAll('.pf-row-btn').forEach((item) => {
                    item.classList.remove('pf-row-btn--disabled');
                  });
                  this.is_new = !res;
                })
                .catch((e) => {
                  window?.pushErrorMessage(e);
                });
            }
          });

          this.checkbox.addEventListener('change', (e) => {
            this.handlePolicy();
          });
        }

        checkLoginUserIsSubscribe(email) {
          return fetch(
            `${window.pageInfo.api}/osconsumerapi/v1/notice/getUserSubscribe?email=${email}&shopifyShopId=${window.pageInfo.shopId}`,
            {
              headers: {
                cr: window?.pageInfo?.cr,
                lang: window?.pageInfo?.lang,
              },
            }
          )
            .then((response) => response.json())
            .then((res) => {
              if (res.data && res.data.emailSubscribe) {
                return Promise.resolve(true);
              } else {
                return Promise.resolve(false);
              }
            })
            .catch((e) => {
              return Promise.reject(e);
            });
        }
      }
    );
  }
</script>
