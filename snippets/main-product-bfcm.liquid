<style>
  .modal-container.bfcm-modal.modal .modal-content {
    width: 1080px;
    background: linear-gradient(180deg, #fee7ca 0%, #fbeddb 100%);
    border-radius: 16px;
  }

  .modal-container.bfcm-modal.modal .moadal-header {
    border-bottom: unset;
    height: 0;
  }

  @media screen and (max-width: 1024px) {
    .modal-container.bfcm-modal.modal .moadal-header {
      height: calc(60vw / 750 * 100);
      padding-top: 0;
      background: unset;
    }
    .modal-container.bfcm-modal.modal .modal-content {
      max-height: 86vh;
      border-radius: var(--theme-dialog-border-radius, calc(20vw / 750 * 100));
    }

    .modal-container.bfcm-modal.modal .moadal-header .modal__close {
      top: 16px !important;
    }
  }

  .bfcm-box .pc-form {
    display: flex;
    overflow: hidden;
    margin-bottom: 24px;
  }
  .bfcm-box .pc-form .pf-form {
    flex: 1;
    margin-top: 0 !important;
  }
  .bfcm-box .pc-form .pf-form .pf-form-container {
    width: 100%;
  }
  .bfcm-box .pc-form .pf-form .pf-form-container {
    height: 100%;
    padding: 0;
    display: flex;
    justify-content: space-between;
    box-sizing: border-box;
  }
  .bfcm-box .pf-form {
    margin-top: 54px;
    background: #ffffff;
    position: relative;
  }
  .bfcm-box .pf-form .title {
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    margin-bottom: 24px;
    text-align: left;
    color: #1A1A1A;
  }
  .bfcm-box .pf-form .pf-form-container {
    margin: 0 auto;
  }
  .bfcm-box .pf-form .pf-form-container h2 {
    display: none;
  }
  .bfcm-box .pf-form .pf-form-container .pf-form-title {
    font-size: 28px;
    line-height: 1.428;
    margin-bottom: 12px;
    font-weight: 600;
    color: #1a1a1a;
    text-align: left;
    max-width: 696px;
    margin-bottom: 10px;
  }
  .bfcm-box .pf-form .pf-form-container form {
    width: 100%;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-row {
    position: relative;
    height: 48px;
    border-radius: 8px;
    border: solid 1px #d8d8d8;
    display: flex;
    justify-content: space-between;
    align-items: center;
    overflow: hidden;
    box-sizing: border-box;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-row.error {
    border: solid 1px #fe3b30;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-row input {
    outline: none;
    border: none;
    flex: 1;
    min-width: 0;
    height: 100%;
    text-indent: 24px;
    font-size: 18px;
    line-height: 48px;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-row input::placeholder {
    font-size: 18px;
    line-height: 48px;
    color: #666666;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-row input:-internal-autofill-selected {
    background-color: #ffffff !important;
    transition: background-color 5000s ease-in-out 0s !important;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-row .pf-row-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--jds-color-primary), transparent 10%);
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    height: 48px;
    border-radius: 8px;
    line-height: 48px;
    padding: 0 24px;
    cursor: pointer;
    transition: background 0.24s ease;
    user-select: none;
    white-space: nowrap;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-row .pf-row-btn:not(.pf-row-btn--disabled):active {
    background: var(--jds-color-primary);
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-row .pf-row-btn.pf-row-btn--disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-row-btn {
    display: none;
  }
  .bfcm-box .pf-form .pf-form-container form .form-emai-error {
    margin: 6px 0 10px 0;
  }
  .bfcm-box .pf-form .pf-form-container form .form-emai-error span {
    display: none;
    color: #fe3b30;
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
  }
  .bfcm-box .pf-form .pf-form-container form .form-emai-error span.error {
    display: inline-block;
  }
  .bfcm-box .pf-form .pf-form-container form .form-emai-error.error span {
    display: inline-block;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox {
    cursor: pointer;
    /* line-height: 16px; */
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox:hover .checkbox-container .pf-checkbox-inner {
    border-color: #fe3b30;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .checkbox-container {
    display: inline-block;
    position: relative;
    height: 16px;
    width: 16px;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .checkbox-container input {
    opacity: 0;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0;
    margin: 0;
    z-index: 6;
    cursor: pointer;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .checkbox-container input:checked ~ .pf-checkbox-inner {
    border-color: #fe3b30;
  }
  .bfcm-box
    .pf-form
    .pf-form-container
    form
    .pf-form-checkbox
    .checkbox-container
    input:checked
    ~ .pf-checkbox-inner::after {
    opacity: 1;
    transform: rotate(45deg) scale(1) translate(-50%, -50%);
    transition: all 0.2s cubic-bezier(0.12, 0.4, 0.29, 1.256) 0.1s;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .checkbox-container .pf-checkbox-inner {
    border-radius: 4px;
    border: 1px solid #999999;
    display: inline-block;
    height: 16px;
    width: 16px;
    box-sizing: border-box;
    transition: all 0.3s ease;
    position: relative;
    transform: translateY(2px);
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .checkbox-container .pf-checkbox-inner::after {
    content: '';
    display: inline-block;
    border: 2px solid red;
    border-left: 0;
    border-top: 0;
    box-sizing: border-box;
    display: table;
    height: 9px;
    left: 25%;
    opacity: 0;
    position: absolute;
    top: 50%;
    transform: rotate(45deg) scale(0) translate(-50%, -50%);
    transition: all 0.1s cubic-bezier(0.71, -0.46, 0.88, 0.6), opacity 0.1s;
    width: 6px;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .pf-checkbox-info {
    font-size: 14px;
    color: #333333;
    font-weight: 400;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .pf-checkbox-info p {
    display: inline;
    line-height: 16px;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .pf-checkbox-info p a {
    color: #333333;
    text-decoration: underline;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .pf-checkbox-error {
    color: #fe3b30;
    font-weight: 400;
    font-size: 14px;
    margin-top: 6px;
    display: none;
  }
  .bfcm-box .pf-form .pf-form-container form .pf-form-checkbox .pf-checkbox-error.error {
    display: block;
  }
  .bfcm-box .pf-form .lock_success {
    justify-content: center;
    align-items: center;
    z-index: 1;
    display: none;
    font-size: 24px;
    color: #1a1a1a;
    line-height: 40px;
    font-weight: 600;
  }
  .bfcm-box .pf-form .lock_success.lock {
    display: flex;
    padding-top: 24px;
    text-align: left;
    line-height: 1.33;
  }
  .bfcm-dialog {
    display: none;
    /* padding: 32px 42px 64px; */
    /* width: 1080px; */
    background: linear-gradient(180deg, #fee7ca 0%, #fbeddb 100%);
  }

  .bfcm-modal .bfcm-dialog {
    display: block;
  }

  .bfcm-dialog .bfcm-dialog-sticky {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bfcm-dialog .text-overflow-2 {
    -webkit-box-orient: vertical;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .bfcm-dialog .dialog-title {
    font-size: 28px;
    line-height: 36px;
    font-weight: 600;
    margin-bottom: 10px;
    text-align: center;
    max-width: 870px;
  }
  .bfcm-dialog .dialog-subtitle {
    font-size: 16px;
    line-height: 26px;
    margin-bottom: 10px;
    text-align: center;
    max-width: 928px;
    font-weight: 500;
  }
  .bfcm-dialog .product-list {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .bfcm-dialog .product-list .product-list-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: 16px;
    padding-bottom: 18px;
  }
  .bfcm-dialog .product-list .product-list-item .product-media {
    position: relative;
    height: auto;
    cursor: pointer;
    display: flex;
    justify-content: center;
  }
  .bfcm-dialog .product-list .product-list-item .product-media .product-img {
    width: 170px;
    height: 170px;
    object-fit: contain;
  }
  .bfcm-dialog .product-list .product-list-item .product-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0 16px;
    text-align: left;
    gap: 6px;
  }
  .bfcm-dialog .product-list .product-list-item .product-content .areviews_main_header_container {
    display: none;
  }
  .bfcm-dialog .product-list .product-list-item .product-content .product-title {
    line-height: 24px;
    font-size: 16px;
    font-weight: 500;
    color: #1a1a1a;
    text-align: left;
