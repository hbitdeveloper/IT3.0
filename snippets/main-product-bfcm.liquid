  }
  .bfcm-dialog .product-list .product-list-item .product-content .price-content .origin-price {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #666666;
    line-height: 16px;
    margin-bottom: 10px;
  }
  .bfcm-dialog .product-list .product-list-item .product-content .price-content .add-cart {
    background: linear-gradient(95deg, #e3b75e 0%, #a76a32 100%);
    text-align: center;
    height: 32px;
    line-height: 32px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 14px;
    color: #ffffff;
    cursor: pointer;
    user-select: none;
    transition: background 0.24s ease;
    padding: 0 12px;
    display: block;
    width: max-content; /* 按内容宽度撑开 */
    margin: 0 auto;
  }
  .bfcm-dialog .product-list .product-list-item .product-content .price-content .add-cart:active {
    /* background: var(--jds-color-primary); */
  }

