<div
  class="newcomer-main-container newcomer-education-smart newcomer-education-smart-{{ index }}"
  anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', ''}}"
>
  <div class="smart-box">
    <div class="left-smart">
      {% assign titleColor = '<em style="color: ' | append: settings['title-color'] | append: '">' %}
      <div class="title">
        {{ settings.title | replace: '<em>', titleColor }}
      </div>

      {% if settings.description != blank %}
        <div class="description">
          {{ settings.description }}
        </div>
      {% endif %}
    </div>
    <div class="right-smart">
      <a
        data-ga-event="new_education_user_clicks"
        data-ga-action="click"
        data-ga-params-module="Text Block"
        data-ga-params-link="{{ settings.link }}"
        data-ga-params-button_name="{{ settings.btn }}"
        data-ga-params-position="{{ settings.title | strip_html }}"
        href="{{ settings.link }}"
        target="{% if new_window %}_blank{% else %}_self{% endif %}"
      >
        <button class="index-button">
          <span>{{ settings.btn }}</span>
          <div>
            <div class="arrow">
              <svg
                class="line"
                width="20"
                height="15"
                viewBox="0 0 20 15"
                version="1.1"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
              >
                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                  <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                    <g transform="translate(672.000000, 286.000000)">
                      <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                    </g>
                  </g>
                </g>
              </svg>
            </div>
          </div>
        </button>
      </a>
    </div>
  </div>
</div>

<style>
  .newcomer-education-smart-{{ index }}{
      padding-top:{{ settings.pc_padding_top }}px;
      padding-bottom:{{ settings.pc_padding_bottom }}px;
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px){
      .newcomer-education-smart-{{ index }}{
          padding-top: calc( {{ settings.pc_padding_top }}  * 100vw / 1440 );
          padding-bottom: calc( {{ settings.pc_padding_bottom }}  * 100vw / 1440 );
      }
  }
  @media screen and (max-width: 1023.98px){
      .newcomer-education-smart-{{ index }}{
          padding-top: calc( {{ settings.mb_padding_top }}  * 100vw / 750 );
          padding-bottom: calc( {{ settings.mb_padding_bottom }}  * 100vw / 750 );
      }
  }
</style>
