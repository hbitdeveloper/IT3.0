{% comment %}
    产品详情页 - 添加捆绑销售
    Accepts: product, block, is_diy (optional)
    Usage: {% render 'v5-app-bundled-sale', product: product, block: block, is_diy: true %}
{% endcomment %}

{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}

{%- liquid
  assign is_diy = is_diy | default: false
-%}

{% comment %} open_bundled_sale {% endcomment %}
{%- if settings.open_bundled_sale == true -%}
  {% assign current_variant = product.selected_or_first_available_variant %}
  {% capture bundled_sale_root_id %}bundled-sale-{{ section.id }}-{{ block.id }}{% endcapture %}
  {% assign bundle_info = current_variant.metafields.custom.bundle_info.value %}
  {% assign bundle_title = '' %}
  {% assign bundle_total = 0 %}
  {% assign bundle_goods_list = blank %}
  {% assign show_bundle_sale = false %}
  {% if bundle_info != blank %}
    {% assign bundle_title = bundle_info.title | default: '' %}
    {% assign bundle_goods_list = bundle_info.bundleGoodsList %}
    {% assign bundle_total = bundle_info.total | default: bundle_goods_list.size | plus: 0 %}
    {% if bundle_goods_list != blank and bundle_total > 0 %}
      {% assign show_bundle_sale = true %}
    {% endif %}
  {% endif %}

  <div id="{{ bundled_sale_root_id }}" class="w-full"{% unless show_bundle_sale %} style="display:none;"{% endunless %}>
    {% style %}
      jky-v5-app-bundled-sale [data-app-bundled-sale-title] pre {
        white-space: normal;
      }
      jky-v5-app-bundled-sale input[type="checkbox"] {
        cursor: pointer;
        position: relative;
      }
      jky-v5-app-bundled-sale input[type="checkbox"]::after {
        content: ' ';
        width: 100%;
        height: 100%;
        border-radius: 2px;
        background-color: #fff;
        border: 1px solid #D8D8D8;
        visibility: visible;
        position: absolute;
        top: 0;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
      }
      jky-v5-app-bundled-sale input[type="checkbox"]::before {
        content: '';
        width: 35%;
        height: 55%;
        border: solid #fff;
        border-width: 0 2px 2px 0;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -60%) rotate(45deg);
        opacity: 0;
        z-index: 1;
        box-sizing: border-box;
      }
      jky-v5-app-bundled-sale input[type="checkbox"]:checked::before {
        opacity: 1;
      }
      jky-v5-app-bundled-sale input[type="checkbox"]:checked::after {
        content: ' ';
        background-color: #242F20;
        border: none;
      }
      jky-v5-app-bundled-sale input[type="checkbox"]:active,
      jky-v5-app-bundled-sale input[type="checkbox"]:focus {
        background-color: transparent;
        -webkit-tap-highlight-color: rgba(255, 255, 255, 0);
        -webkit-user-select: none;
        -moz-user-focus: none;
        -moz-user-select: none;
        user-select: none;
      }
      jky-v5-app-bundled-sale ul {
        width: calc(100% + 1rem);
      }
      jky-v5-app-bundled-sale ul > :last-child {
        margin-bottom: 1px;
      }
      jky-v5-app-bundled-sale ul label.active{
        border: solid 1px #242F20;
        box-shadow: inset 0 0 0 0.5px #242F20;
      }
      /* 滚动条宽度 */
      jky-v5-app-bundled-sale ul::-webkit-scrollbar {
        width: 0.375rem;
      }
      /* 滚动条滑块 */
      jky-v5-app-bundled-sale ul::-webkit-scrollbar-thumb {
        background-color: #C9C9CB; /* 滑块颜色 */
        border-radius: 10px; /* 滑块圆角 */
      }
      /* 滚动条轨道 */
      jky-v5-app-bundled-sale ul::-webkit-scrollbar-track {
        background-color: transparent; /* 滚动条轨道透明 */
      }
      @media screen and (max-width: 1023.98px) {
        jky-v5-app-bundled-sale ul {
          width: calc(100% + 0.75rem);
        }
      }

      jky-v5-app-bundled-sale [data-bundle-variant-templates] {
        display: none;
      }
    {% endstyle %}

    <jky-v5-app-bundled-sale
      class="flex flex-col gap-y-4 lg:gap-y-6 section-padding"
      style="{{ style }}"
      data-product-title="{{ product.title | escape }}"
      data-variant-id="{{ current_variant.id }}"
      data-variant-title="{{ current_variant.title | escape }}"
      data-is-diy="{{ is_diy }}"
    >
      <div data-bundle-body>
        {% if show_bundle_sale %}
          <div class="font-semibold text-[#242F20] text-xl lg:text-2xl mb-4" data-app-bundled-sale-title>{{ bundle_title }}</div>
          <ul class="flex flex-col max-h-[16.875rem] gap-y-4 pr-1 overflow-y-auto lg:max-h-[23.3125rem] lg:pr-2.5" data-app-bundled-sale-list>
            {% if is_diy %}
              {% for item in bundle_goods_list %}
                {% assign index = forloop.index0 %}
                {% assign item_title = item.sellerName | default: item.title %}
                {% assign item_price = item.price | default: 0 %}
                {% assign item_origin_price = item.originPrice | default: 0 %}
                {% assign item_price_cents = item_price | times: 100 %}
                {% assign item_origin_price_cents = item_origin_price | times: 100 %}
                {% assign item_stock = item.stock | default: 1 | plus: 0 %}
                {% assign item_sku_id = item.skuId | default: 0 %}
                {% assign item_goods_id = item.goodsId | default: 0 %}
                {% assign item_default_chosen = item.defaultChosen | default: 0 | plus: 0 %}
                {% assign item_positioning_tag = item.positioningTag | default: '' %}
                {% assign item_positioning_desc = item.positioningDesc | default: '' %}
                {% assign item_positioning_desc_color = item.positioningDescColor | default: '#999999' %}
                {% assign item_image = item.image | default: '' | remove: '`' | strip %}
                {% assign item_image_base = item_image | split: '?' | first %}
                {% capture item_product_json %}{"goodsId":{{ item_goods_id | json }},"title":{{ item_title | json }},"price":{{ item_price | json }},"originPrice":{{ item_origin_price | json }},"image":{{ item_image | json }}}{% endcapture %}

                <label skuId="{{ item_sku_id }}" for="add-on-{{ item_sku_id }}--{{ index }}" class="w-full flex shrink-0 items-start lg:items-center flex-row border-solid border-[#C6C7C8] gap-x-3 border min-h-[6.375rem] lg:gap-x-4 px-2.5 pb-5 lg:px-4 lg:pb-6 {% if item_positioning_tag != blank %}pt-10 lg:pt-10{% else %}pt-5 lg:pt-6{% endif %} lg:min-h-[7.5rem] cursor-pointer relative {% if item_default_chosen == 1 %}active{% endif %}">
                  {% if item_positioning_tag != blank %}
                    <span class="absolute right-[-1px] top-[-1px] bg-[#242F20] text-white font-semibold text-[0.75rem] lg:text-[1rem] leading-[1.75rem] h-7 px-2 lg:px-3">{{ item_positioning_tag }}</span>
                  {% endif %}
                  <div class="flex items-center gap-x-2.5 lg:gap-x-4">
                    <input skuId="{{ item_sku_id }}" type="checkbox" id="add-on-{{ item_sku_id }}--{{ index }}" title="{{ item_title | escape }}" price="{{ item_price_cents | money | escape }}" class="w-4 h-4 lg:w-5 lg:h-5" {% if item_default_chosen == 1 %}checked{% endif %}>
                    <img class="w-12 h-12 lg:w-[4.5rem] lg:h-[4.5rem] object-contain cursor-pointer" src="{{ item_image_base }}?width=144" alt="{{ item_title | escape }}" loading="lazy" data-product="{{ item_product_json | escape }}" data-action="show-modal">
                  </div>
                  <div class="flex flex-col flex-1">
                    <h4 class="text-[#242F20] font-semibold text-sm lg:text-xl cursor-pointer" data-product="{{ item_product_json | escape }}" data-action="show-modal">{{ item_title }}</h4>
                    <p class="flex flex-row items-center lg:hidden mt-2">
                      <em class="text-[#242F20] font-semibold not-italic text-base lg:text-xl">{{ item_price_cents | money }}</em>
                      {% if item_origin_price > item_price %}
                        <span class="text-[#999999] font-normal text-xs ml-2 line-through lg:text-base">{{ item_origin_price_cents | money }}</span>
                      {% endif %}
                    </p>
                    {% if item_positioning_desc != blank %}
                      <p class="text-[#999999] font-semibold mt-3 lg:mt-0 text-xs lg:text-base" style="color:{{ item_positioning_desc_color }};">{{ item_positioning_desc }}</p>
                    {% endif %}
                    <div class="w-full lg:hidden {% if item_default_chosen == 1 %}flex{% else %}hidden{% endif %} justify-end mt-3 lg:mt-1" data-quantity-input-wrap-mb>
                      <div class="flex border-solid border-[#E2E3E3] border">
                        <button
                          aria-label="Decrease quantity for {{ item_title | escape }}"
                          class="appearance-none bg-[#F5F5F5] flex-center w-7 h-7 lg:w-8 lg:h-8 disabled:opacity-40 disabled:cursor-not-allowed"
                          disabled
                          data-button-minus
                          data-sku-title="{{ item_title | escape }}"
                          data-sku-price="{{ item_price_cents | money | escape }}"
                        >
                          <svg class="text-[#242F20] w-3.5 h-3.5" viewBox="0 0 56 56" version="1.1" xmlns="http://www.w3.org/2000/svg">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                              <g transform="translate(-1053.000000, -594.000000)">
                                <g transform="translate(1053.000000, 594.000000)">
                                  <rect x="0" y="0" width="56" height="56"></rect>
                                  <g transform="translate(7.000000, 26.000000)" fill="#333" fill-rule="nonzero">
                                    <path d="M2.24098777,4.36809816 L39.3054147,4.36809816 C39.7082889,4.36809816 40.0817869,4.27048703 40.4259086,4.07526476 C40.7700303,3.8800425 41.0428097,3.61567902 41.2442468,3.28217432 C41.445684,2.94866961 41.5464025,2.57856074 41.5464025,2.17184769 C41.5464025,1.78140316 41.445684,1.41942855 41.2442468,1.08592384 C41.0428097,0.752419143 40.7700303,0.48805566 40.4259086,0.292833396 C40.0817869,0.0976111321 39.7082889,0 39.3054147,0 L2.24098777,0 C1.83811357,0 1.46881221,0.0976111321 1.1330837,0.292833396 C0.7973552,0.48805566 0.524575789,0.752419143 0.314745474,1.08592384 C0.104915158,1.41942855 0,1.78140316 0,2.17184769 C0,2.57856074 0.104915158,2.94866961 0.314745474,3.28217432 C0.524575789,3.61567902 0.7973552,3.8800425 1.1330837,4.07526476 C1.46881221,4.27048703 1.83811357,4.36809816 2.24098777,4.36809816 Z"></path>
                                  </g>
                                </g>
                              </g>
                            </g>
                          </svg>
                        </button>
                        <input
                          aria-label="purchase quantity"
                          class="flex-center font-semibold text-center border-0 border-solid border-[#E2E3E3] border-x-[1px] w-8 h-7 lg:w-11 lg:h-8 text-base lg:text-xl"
                          type="number"
                          value="1"
                          readonly
                          data-quantity-input
                          data-max="{{ item_stock }}"
                          data-sku-id="{{ item_sku_id }}"
                          data-sku-title="{{ item_title | escape }}"
                          data-sku-price="{{ item_price_cents | money | escape }}"
                        />
                        <button
                          class="appearance-none bg-[#F5F5F5] flex-center w-7 h-7 lg:w-8 lg:h-8 disabled:opacity-40 disabled:cursor-not-allowed"
                          {% if item_stock <= 1 %}disabled{% endif %}
                          aria-label="Increase quantity for {{ item_title | escape }}"
                          data-button-plus
                          data-sku-title="{{ item_title | escape }}"
                          data-sku-price="{{ item_price_cents | money | escape }}"
                        >
                          <svg class="text-[#242F20] w-3.5 h-3.5" viewBox="0 0 56 56" version="1.1" xmlns="http://www.w3.org/2000/svg">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                              <g transform="translate(-931.000000, -594.000000)">
                                <g transform="translate(931.000000, 594.000000)">
                                  <rect x="0" y="0" width="56" height="56"></rect>
                                  <g transform="translate(7.000000, 7.000000)" fill="#333" fill-rule="nonzero">
                                    <path d="M0,20.7484663 C0,21.3688244 0.222420135,21.8969672 0.667260404,22.3328946 C1.11210067,22.768822 1.63667646,22.9867856 2.24098777,22.9867856 L18.5322135,22.9867856 L18.5322135,39.2586131 C18.5322135,39.8622049 18.750437,40.386156 19.1868841,40.8304666 C19.6233311,41.2747772 20.1521035,41.4969325 20.7732013,41.4969325 C21.394299,41.4969325 21.927268,41.2747772 22.3721083,40.8304666 C22.8169485,40.386156 23.0393687,39.8622049 23.0393687,39.2586131 L23.0393687,22.9867856 L39.3054147,22.9867856 C39.909726,22.9867856 40.4343018,22.768822 40.8791421,22.3328946 C41.3239824,21.8969672 41.5464025,21.3688244 41.5464025,20.7484663 C41.5464025,20.1281081 41.3239824,19.5957737 40.8791421,19.1514631 C40.4343018,18.7071525 39.909726,18.4849972 39.3054147,18.4849972 L23.0393687,18.4849972 L23.0393687,2.23831939 C23.0393687,1.63472764 22.8169485,1.11077648 22.3721083,0.666465886 C21.927268,0.222155295 21.394299,0 20.7732013,0 C20.1521035,0 19.6233311,0.222155295 19.1868841,0.666465886 C18.750437,1.11077648 18.5322135,1.63472764 18.5322135,2.23831939 L18.5322135,18.4849972 L2.24098777,18.4849972 C1.63667646,18.4849972 1.11210067,18.7071525 0.667260404,19.1514631 C0.222420135,19.5957737 0,20.1281081 0,20.7484663 Z"></path>
                                  </g>
                                </g>
                              </g>
                            </g>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                  <div class="hidden lg:flex flex-col items-end lg:gap-y-1 lg:min-w-[6.875rem]">
                    <em class="text-[#242F20] font-semibold not-italic lg:text-xl">{{ item_price_cents | money }}</em>
                    {% if item_origin_price > item_price %}
                      <span class="text-[#999999] font-normal line-through lg:text-base">{{ item_origin_price_cents | money }}</span>
                    {% endif %}
                    <div class="mt-3 lg:mt-1 hidden {% if item_default_chosen == 1 %}lg:flex{% endif %}" data-quantity-input-wrap-pc>
                      <div class="flex border-solid border-[#E2E3E3] border">
                        <button
                          class="appearance-none bg-[#F5F5F5] flex-center w-7 h-7 lg:w-8 lg:h-8 disabled:opacity-40 disabled:cursor-not-allowed"
                          disabled
                          aria-label="Decrease quantity for {{ item_title | escape }}"
                          data-button-minus
                          data-sku-title="{{ item_title | escape }}"
                          data-sku-price="{{ item_price_cents | money | escape }}"
                        >
                          <svg class="text-[#242F20] w-3.5 h-3.5" viewBox="0 0 56 56" version="1.1" xmlns="http://www.w3.org/2000/svg">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                              <g transform="translate(-1053.000000, -594.000000)">
                                <g transform="translate(1053.000000, 594.000000)">
                                  <rect x="0" y="0" width="56" height="56"></rect>
                                  <g transform="translate(7.000000, 26.000000)" fill="#333" fill-rule="nonzero">
                                    <path d="M2.24098777,4.36809816 L39.3054147,4.36809816 C39.7082889,4.36809816 40.0817869,4.27048703 40.4259086,4.07526476 C40.7700303,3.8800425 41.0428097,3.61567902 41.2442468,3.28217432 C41.445684,2.94866961 41.5464025,2.57856074 41.5464025,2.17184769 C41.5464025,1.78140316 41.445684,1.41942855 41.2442468,1.08592384 C41.0428097,0.752419143 40.7700303,0.48805566 40.4259086,0.292833396 C40.0817869,0.0976111321 39.7082889,0 39.3054147,0 L2.24098777,0 C1.83811357,0 1.46881221,0.0976111321 1.1330837,0.292833396 C0.7973552,0.48805566 0.524575789,0.752419143 0.314745474,1.08592384 C0.104915158,1.41942855 0,1.78140316 0,2.17184769 C0,2.57856074 0.104915158,2.94866961 0.314745474,3.28217432 C0.524575789,3.61567902 0.7973552,3.8800425 1.1330837,4.07526476 C1.46881221,4.27048703 1.83811357,4.36809816 2.24098777,4.36809816 Z"></path>
                                  </g>
                                </g>
                              </g>
                            </g>
                          </svg>
                        </button>
                        <input
                          aria-label="purchase quantity"
                          class="flex-center font-semibold text-center border-0 border-solid border-[#E2E3E3] border-x-[1px] w-8 h-7 lg:w-11 lg:h-8 text-base lg:text-xl"
                          type="number"
                          value="1"
                          readonly
                          data-quantity-input
                          data-max="{{ item_stock }}"
                          data-sku-id="{{ item_sku_id }}"
                          data-sku-title="{{ item_title | escape }}"
                          data-sku-price="{{ item_price_cents | money | escape }}"
                        />
                        <button
                          class="appearance-none bg-[#F5F5F5] flex-center w-7 h-7 lg:w-8 lg:h-8 disabled:opacity-40 disabled:cursor-not-allowed"
                          {% if item_stock <= 1 %}disabled{% endif %}
                          aria-label="Increase quantity for {{ item_title | escape }}"
                          data-button-plus
                          data-sku-title="{{ item_title | escape }}"
                          data-sku-price="{{ item_price_cents | money | escape }}"
                        >
                          <svg class="text-[#242F20] w-3.5 h-3.5" viewBox="0 0 56 56" version="1.1" xmlns="http://www.w3.org/2000/svg">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                              <g transform="translate(-931.000000, -594.000000)">
                                <g transform="translate(931.000000, 594.000000)">
                                  <rect x="0" y="0" width="56" height="56"></rect>
                                  <g transform="translate(7.000000, 7.000000)" fill="#333" fill-rule="nonzero">
                                    <path d="M0,20.7484663 C0,21.3688244 0.222420135,21.8969672 0.667260404,22.3328946 C1.11210067,22.768822 1.63667646,22.9867856 2.24098777,22.9867856 L18.5322135,22.9867856 L18.5322135,39.2586131 C18.5322135,39.8622049 18.750437,40.386156 19.1868841,40.8304666 C19.6233311,41.2747772 20.1521035,41.4969325 20.7732013,41.4969325 C21.394299,41.4969325 21.927268,41.2747772 22.3721083,40.8304666 C22.8169485,40.386156 23.0393687,39.8622049 23.0393687,39.2586131 L23.0393687,22.9867856 L39.3054147,22.9867856 C39.909726,22.9867856 40.4343018,22.768822 40.8791421,22.3328946 C41.3239824,21.8969672 41.5464025,21.3688244 41.5464025,20.7484663 C41.5464025,20.1281081 41.3239824,19.5957737 40.8791421,19.1514631 C40.4343018,18.7071525 39.909726,18.4849972 39.3054147,18.4849972 L23.0393687,18.4849972 L23.0393687,2.23831939 C23.0393687,1.63472764 22.8169485,1.11077648 22.3721083,0.666465886 C21.927268,0.222155295 21.394299,0 20.7732013,0 C20.1521035,0 19.6233311,0.222155295 19.1868841,0.666465886 C18.750437,1.11077648 18.5322135,1.63472764 18.5322135,2.23831939 L18.5322135,18.4849972 L2.24098777,18.4849972 C1.63667646,18.4849972 1.11210067,18.7071525 0.667260404,19.1514631 C0.222420135,19.5957737 0,20.1281081 0,20.7484663 Z"></path>
                                  </g>
                                </g>
                              </g>
                            </g>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </label>
              {% endfor %}
            {% else %}
              {% for item in bundle_goods_list %}
                {% assign index = forloop.index0 %}
                {% assign item_title = item.sellerName | default: item.title %}
                {% assign item_price = item.price | default: 0 %}
                {% assign item_origin_price = item.originPrice | default: 0 %}
                {% assign item_price_cents = item_price | times: 100 %}
                {% assign item_origin_price_cents = item_origin_price | times: 100 %}
                {% assign item_stock = item.stock | default: 1 | plus: 0 %}
                {% assign item_sku_id = item.skuId | default: 0 %}
                {% assign item_goods_id = item.goodsId | default: 0 %}
                {% assign item_positioning_desc = item.positioningDesc | default: '' %}
                {% assign item_positioning_desc_color = item.positioningDescColor | default: '#999999' %}
                {% assign item_image = item.image | default: '' | remove: '`' | strip %}
                {% capture item_product_json %}{"goodsId":{{ item_goods_id | json }},"title":{{ item_title | json }},"price":{{ item_price | json }},"originPrice":{{ item_origin_price | json }},"image":{{ item_image | json }}}{% endcapture %}

                <li class="w-full flex shrink-0 items-start lg:items-center flex-row border-0 border-solid border-b-[1px] border-[#E2E3E3] pb-4 gap-x-2 lg:gap-x-4">
                  <script type="application/json" id="BundleList-{{ index }}">{"skuId":{{ item_sku_id }},"goodsId":{{ item_goods_id }},"title":{{ item_title | json }},"price":{{ item_price }},"originPrice":{{ item_origin_price }},"positioningDesc":{{ item_positioning_desc | json }},"positioningDescColor":{{ item_positioning_desc_color | json }},"image":{{ item_image | json }},"stock":{{ item_stock }}}</script>
                  <img class="w-[4.5rem] h-[4.5rem] lg:w-24 lg:h-24 object-contain cursor-pointer" src="{{ item_image }}" alt="" loading="lazy" data-product="{{ item_product_json | escape }}" data-action="show-modal">
                  <div class="flex flex-col justify-between min-h-[4.5rem] lg:min-h-24 flex-1">
                    <h4 class="w-full text-[#242F20] font-semibold text-sm lg:text-xl line-clamp-2 cursor-pointer" title="{{ item_title | escape }}" data-product="{{ item_product_json | escape }}" data-action="show-modal">{{ item_title }}</h4>
                    {% if item_positioning_desc != blank %}
                      <p class="text-[#999999] mt-2 text-xs lg:text-sm" style="color:{{ item_positioning_desc_color }};">{{ item_positioning_desc }}</p>
