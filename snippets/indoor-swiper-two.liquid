<style>
  .indoor-swiper-two {
    background-image: url({{ swipertwo.pc-img | image_url }});
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
  }
  @media screen and (max-width: 1024px) {
    .indoor-swiper-two {
      background-image: url({{ swipertwo.mb-img | image_url }});
    }
  }
</style>
<div
  class="indoor-swiper-two"
  anchor="{{ swipertwo.anchor_id  | url_decode | strip | replace: ' ', ''}}"
  data-autoplay="{{ swipertwo.autoplay }}"
  data-delay="{{ swipertwo.swiperInterval }}"
>
  <div class="swiper-two-box">
    <div class="text-box">
      <h2 class="big-text show-pc" style="color:{{ swipertwo.title-color }}">
        {{ swipertwo.title}}
      </h2>
      <h2 class="big-text show-mb" style="color:{{ swipertwo.title-color }}">
        {% if swipertwo['mb-title'] != blank %}
          {{ swipertwo['mb-title']}}
        {% else %}
          {{ swipertwo.title}}
        {% endif %}
      </h2>
      <h2 class="small-text show-pc" style="color:{{ swipertwo.sub-title-color }}">
        {{ swipertwo['sub-title']}}
      </h2>
      <h2 class="small-text show-mb" style="color:{{ swipertwo.sub-title-color }}">
        {% if swipertwo['mb-sub-title'] != blank %}
          {{ swipertwo['mb-sub-title']}}
        {% else %}
          {{ swipertwo['sub-title']}}
        {% endif %}
      </h2>
    </div>

    {% comment %} Swiper pc {% endcomment %}
    <div class="swiper mySwiper show-pc">
      <div class="swiper-wrapper">
        {%- for i in (0..2) -%}
          {% assign img-one-index = 'img-one-' | append: forloop.index %}
          {% assign img-two-index = 'img-two-' | append: forloop.index %}
          {% assign img-three-index = 'img-three-' | append: forloop.index %}
          {% assign img-four-index = 'img-four-' | append: forloop.index %}
          {%- if swipertwo[img-one-index] != blank -%}
            <div class="swiper-slide">
              <div class="img-box">
                {% render 'responsive-image', image: swipertwo[img-one-index], image_class: 'swiper-two-image' %}
                {% render 'responsive-image', image: swipertwo[img-two-index], image_class: 'swiper-two-image' %}
                {% render 'responsive-image', image: swipertwo[img-three-index], image_class: 'swiper-two-image' %}
                {% render 'responsive-image', image: swipertwo[img-four-index], image_class: 'swiper-two-image' %}
              </div>
            </div>
          {%- endif -%}
        {% endfor %}
      </div>

      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>

    {% comment %} Swiper mb {% endcomment %}
    <div
      class="five-kwh-two-carousel-mb show-mb swiper"

      data-size="{{ sizes }}"
    >
      <div class="swiper-wrapper">
        {% assign sizes = 0 %}
        {%- for i in (0..2) -%}
          {% assign img-one-index = 'img-one-' | append: forloop.index %}
          {% assign img-two-index = 'img-two-' | append: forloop.index %}
          {% assign img-three-index = 'img-three-' | append: forloop.index %}
          {% assign img-four-index = 'img-four-' | append: forloop.index %}

          {%- if swipertwo[img-one-index] != blank -%}
            {% assign sizes = sizes | plus: 1 %}
            <div class="swiper-slide">
              {% render 'responsive-image', image: swipertwo[img-one-index], image_class: 'swiper-two-image' %}
            </div>
          {%- endif -%}

          {%- if swipertwo[img-two-index] != blank -%}
            {% assign sizes = sizes | plus: 1 %}
            <div class="swiper-slide">
              {% render 'responsive-image', image: swipertwo[img-two-index], image_class: 'swiper-two-image' %}
            </div>
          {%- endif -%}

          {%- if swipertwo[img-three-index] != blank -%}
            {% assign sizes = sizes | plus: 1 %}
            <div class="swiper-slide">
              {% render 'responsive-image', image: swipertwo[img-three-index], image_class: 'swiper-two-image' %}
            </div>
          {%- endif -%}

          {%- if swipertwo[img-four-index] != blank -%}
            {% assign sizes = sizes | plus: 1 %}
            
            <div class="swiper-slide">
              {% render 'responsive-image', image: swipertwo[img-four-index], image_class: 'swiper-two-image' %}
            </div>
          {%- endif -%}
        {% endfor %}
      </div>
    </div>

    <div class="five-kwh-pagination show-mb"></div>
    {% comment %} <div class="five-kwh-change show-mb">
      {% if sizes > 1 %}
      <div
        class="swiper-button-next swiper-two-mb-button-next swiper-tab-vs-pc-button"
      ></div>
      <div
        class="swiper-button-prev swiper-two-mb-button-prev swiper-tab-vs-pc-button"
      ></div>
      {% endif %}
    </div> {% endcomment %}
  </div>
</div>
