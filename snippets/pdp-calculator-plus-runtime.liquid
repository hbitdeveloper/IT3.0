{%- liquid
  assign use_energy_dropdown = section.settings.runtime_use_energy_dropdown
  assign fixed_capacity = product.metafields.my_fields.wattage
  assign fixed_max_power = product.metafields.custom.max_power
  assign fixed_efficiency = 0.8
  assign fixed_ac_consumption = 0

  if fixed_capacity != blank
    if fixed_capacity >= 100 and fixed_capacity < 1000
      assign fixed_efficiency = 0.82
      assign fixed_ac_consumption = 10
    elsif fixed_capacity >= 1000 and fixed_capacity < 1200
      assign fixed_efficiency = 0.82
      assign fixed_ac_consumption = 15
    elsif fixed_capacity >= 1200 and fixed_capacity < 2100
      assign fixed_efficiency = 0.82
      assign fixed_ac_consumption = 18
    elsif fixed_capacity >= 2100 and fixed_capacity < 3050
      assign fixed_efficiency = 0.85
      assign fixed_ac_consumption = 25
    elsif fixed_capacity >= 3050 and fixed_capacity < 5000
      assign fixed_efficiency = 0.85
      assign fixed_ac_consumption = 22
    elsif fixed_capacity >= 5000
      assign fixed_efficiency = 0.85
      assign fixed_ac_consumption = 50
    endif

    if product.metafields.custom.efficiency != blank
      assign fixed_efficiency = product.metafields.custom.efficiency
    endif
    if product.metafields.custom.ac_consumption != blank
      assign fixed_ac_consumption = product.metafields.custom.ac_consumption
    endif
  endif
-%}

{% if use_energy_dropdown or fixed_capacity != blank %}
<div
  class="pyp-card py-5 lg:py-5"
  data-pyp-runtime
  data-pyp-fixed-capacity="{{ fixed_capacity | default: 0 }}"
  data-pyp-fixed-max-power="{{ fixed_max_power | default: 0 }}"
  data-pyp-fixed-efficiency="{{ fixed_efficiency }}"
  data-pyp-fixed-ac-consumption="{{ fixed_ac_consumption }}"
  data-pyp-runtime-use-energy-dropdown="{{ section.settings.runtime_use_energy_dropdown }}"
>
  <div class="font-semibold text-base text-[#242F20] jky-ipad-text">
    {{ section.settings.runtime_question }}
  </div> 
  <div class="mt-4 lg:mt-5 grid grid-cols-1 lg:grid-cols-[1fr_26.8125rem] gap-4 lg:gap-6 lg:gap-y-0">
    <div>

      {% if section.settings.runtime_use_energy_dropdown %}
        <div class="font-semibold text-base text-[#242F20] jky-ipad-text">
          {{ section.settings.solar_choose_solar_label | escape }}
        </div>
        <div class="mt-4 pyp-dropdown border border-[#e8e8e5] border-solid" data-pyp-runtime-energy-dropdown>
          <div class="w-full flex items-center justify-between lg:h-12 h-11 px-4" data-pyp-dropdown-selected>
            <span class="font-normal text-base text-[rgba(0, 0, 0, 0.65)] line-clamp-1 leading-[1.4] jky-ipad-text" data-pyp-dropdown-label>
              {{ section.settings.solar_select_placeholder }}
            </span>
            {%- render 'icon-select' -%}
          </div>
          <div class="pyp-dropdown-menu" data-pyp-dropdown-list></div>
        </div>
      {% endif %}

      <div class="mt-4 lg:mt-5 grid grid-cols-2 lg:grid-cols-5 lg:gap-2 gap-x-2.5 gap-y-3">
        {% assign rendered = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'runtime_card' %}
            {% assign rendered = rendered | plus: 1 %}
            <div
              class="pyp-device-card border border-solid border-[#e8e8e5] flex flex-col items-center justify-between pt-3 lg:pt-6"
              data-pyp-device-card
              data-pyp-card-wattage="{{ block.settings.wattage | default: 0 }}"
              data-pyp-card-qty="0"
              {{ block.shopify_attributes }}
            >
              <div class="w-full flex flex-col items-center">
                <div class="h-8 w-8 flex items-center justify-center">
                  {% if block.settings.icon != blank %}
                    <img
                      src="{{ block.settings.icon | image_url: width: 64 }}"
                      alt=""
                      width="32"
                      height="32"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
                <div class="mt-3 text-center text-sm lg:text-base leading-none text-[#242F20] font-medium">
                  {{ block.settings.title }}
                </div>
                <div class="mt-3 text-center text-sm lg:text-base text-[#242F20]">
                  {% if block.settings.editable_wattage %}
                    <div class="pyp-wattage-input-row">
                      <input
                        class="pyp-wattage-input"
                        type="number"
                        min="0"
                        step="1"
                        value="{{ block.settings.wattage | default: 0 }}"
                        data-pyp-card-wattage-input
                      >
                      <span class="pyp-wattage-unit">W</span>
                    </div>
                  {% else %}
                    {{ block.settings.wattage }}W
                  {% endif %}
                </div>
              </div>

              <div class="lg:mt-2 mt-3.5 grid grid-cols-3 items-center border border-solid border-[#EEEEEE] w-28 card-add-sub lg:text-base">
                <button type="button" class="h-8 leading-8 text-[rgba(36, 47, 32, 0.2)] disabled:text-[rgba(36, 47, 32, 0.2)] bg-transparent text-3xl lg:text-2xl" data-pyp-card-minus aria-label="minus">−</button>
                <div class="h-8 flex items-center justify-center text-base font-semibold text-[#242F20] jky-ipad-text" data-pyp-card-qty>0</div>
                <button type="button" class="h-8 leading-8 text-[#242F20] bg-transparent text-3xl lg:text-2xl" data-pyp-card-plus aria-label="plus">+</button>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button
        type="button"
        class="cal-btn mt-4 w-full h-10 bg-[#242F20] text-white font-semibold text-base disabled:cursor-not-allowed jky-ipad-text"
        data-pyp-runtime-calc
        disabled
      >
        {{ section.settings.runtime_calculate_text | escape }}
      </button>
    </div>

    <div class=" bg-white p-4 lg:px-10 flex flex-col justify-center">
      <div class="text-sm lg:text-base text-[#242F20] font-medium">
        {{ section.settings.runtime_right_title }}
      </div>
      <div class="mt-6 flex items-baseline gap-2">
        <span class="pyp-result-num v5-font-oxm font-bold text-[#242f20] text-5xl lg:text-7xl leading-none" data-pyp-result-num>0.0</span>
        <span class="font-semibold text-sm lg:text-2xl text-[#242f20]">
          {{ section.settings.runtime_result_unit }}
        </span>
      </div>
      <div class="lg:my-8 my-7 right-box-border"></div>
      <div class="grid lg:gap-4 gap-5 lg:text-base text-sm">
        <div class="flex items-center justify-between">
          <span class="text-[rgba(0,0,0,0.65)]">{{ section.settings.runtime_battery_capacity_label }}</span>
          <span class="font-semibold text-[#242F20] text-base jky-ipad-text"><span data-pyp-battery-capacity>0</span> Wh</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-[rgba(0,0,0,0.65)]">{{ section.settings.runtime_usable_capacity_label }}</span>
          <span class="font-semibold text-[#242F20] text-base jky-ipad-text"><span data-pyp-usable-capacity>0</span> Wh</span>
        </div>
      </div>
    </div>

    <p class="none lg:mt-3 mt-0 font-normal text-sm leading-normal text-[#f52317]" data-pyp-error>
      {{ section.settings.runtime_error_text }}
    </p>
    <span class="hidden" data-pyp-error-no-device>{{ section.settings.runtime_error_text_no_device }}</span>
  </div>
</div>

<script src="{{ 'section-pdp-calculator-plus-runtime.min.js' | asset_url }}" defer></script>
{% endif %}
