{% comment %} form-field：checkbox（勾选框） {% endcomment %}
{% comment %} jky-formField-checkbox.css {% endcomment %}

{% comment %} 
    key: option 显示文本
    value: option 选中的value
    class: 样式类
{% endcomment %}

{% if value == blank %}
    {% assign value = key %}
{% endif %}

<jky-checkbox class="jky-checkbox_{{id}} jky-checkbox {{class}}">
    <label class="jky-checkbox">
        <span class="jky-checkbox-input">
          <input type="checkbox" class="jky-checkbox-original" data-value="{{value | escape}}">
          <span class="jky-checkbox-inner">
          </span>
        </span>
      
        <span class="jky-checkbox-label">
          <span class="jky-agree">
            {{key}}
          </span>
        </span>
    </label>
</jky-checkbox>