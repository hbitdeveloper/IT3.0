<div
  class="five-kwh-item five-kwh-scroll-trigger"
  anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', '' }}"
  data-index="{{ index }}"
>
  {% if settings.title != blank %}
    {% assign titleColor = '<em style="color: ' | append: settings.title_color | append: '">' %}
    <div class="five-kwh-title">{{ settings.title | replace: '<em>', titleColor}}</div>
  {% endif %}

  {% if settings.subtitle != blank %}
    {% assign subTitleColor = '<em style="color: ' | append: settings.sub_title_color | append: '">' %}
    <div class="five-kwh-subtitle">{{ settings.subtitle | replace: '<em>', subTitleColor}}</div>
  {% endif %}

  <div
    id="five-kwh-scroll-trigger-{{ index }}"
    class="scroll-trigger-box"
    data-first-pc-img="{{ settings.firstPCImg | image_url: width: 1920 }}"
    data-pc-img-name-prefix="{{ settings.pcImgNamePrefix }}"
    data-pc-img-total="{{ settings.pcImgTotal }}"
    data-pc-img-format="{{ settings.pcImgFormat }}"
    data-pc-fps="{{ settings.pcFPS }}"
    data-first-mb-img="{{ settings.firstMBImg | image_url: width: 750 }}"
    data-mb-img-name-prefix="{{ settings.mbImgNamePrefix }}"
    data-mb-img-total="{{ settings.mbImgTotal }}"
    data-mb-img-format="{{ settings.mbImgFormat }}"
    data-content-align="{{ settings.contentAlign }}"
    data-mb-fps="{{ settings.mbFPS }}"
  >
    <picture>
      <source media="(min-width: 1024px)" data-srcset="{{ settings.firstPCImg | image_url: width: 1920 }}">
      <img class="bg-img hide" data-src="{{ settings.firstMBImg | image_url: width: 750 }}" alt="Scroll image">
    </picture>
    <canvas class="sp-img-sequence pc-img-sequence pc-show" width="1920" height="680"></canvas>
    <canvas class="sp-img-sequence mb-img-sequence mb-show" width="750" height="1000"></canvas>
  </div>
</div>
