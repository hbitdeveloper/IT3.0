{%- if hide != true -%}
<style>
  .help-to-choose button[data-select-btn] .jackery-icon-arrow-right {
    display: inline-block;
    transform: rotate(90deg);
    font-size: 1.725vw;
  }
  @media screen and (max-width: 768px) {
    .help-to-choose button[data-select-btn] .jackery-icon-arrow-right {
      font-size: 24px;
    }
    .product-recommendation .z-button-fill-middle {
      width: 32vw;
      padding: 0;
      font-size: 3.2vw !important;
    }
  }
  
  html[lang='de'] .de-min-width {
    min-width: 330px;
  }
  @media screen and (max-width:1023px) {
    html[lang='de'] .de-min-width {
      min-width: 50vw;
    }
  }
</style>
{%- endif -%}

{% comment %} 智能选购 {% endcomment %}
<div class="hidden help-to-choose product-help-to-choose-wrap" {% if hide == true %}style="display: none;"{% endif %}>
  <div class="px-60 pt-60 lg:j-px-0 lg:j-pt-60 pb-60 lg:j-pb-120 bg-f5">
    <h3 class="collection-title">{{ title }}</h3>
    <div class="w-full lg:j-w-1200 mx-auto grid grid-cols-1 lg:grid-cols-2 lg:j-gap-x-95">
      <div class="flex-center flex-col">
        <img
          loading="lazy"
          class="w-150 h-auto lg:j-w-223 lg:j-h-169 object-cover"
          src="{{chooseIpImage | image_url: width: 223 }}"
          alt=""
        />
        <div class="group/data w-full mt-20 mb-35 lg:j-my-70 text-28 lg:j-text-24 font-300 relative input-select">
          <input
            class="w-full h-70 lg:j-h-68 rounded-full pl-30 lg:j-pl-30 lg:j-text-24 pr-150 lg:j-pr-180 bg-white border-2 border-solid border-[#DDD] text-black line-clamp-1 text-ellipsis"
            type="text"
            readonly
            value=""
            placeholder="please select portable power station"
            data-energy-input
          />
          <button
            class="
              w-150 h-70 lg:j-w-148 lg:j-h-68 bg-primary absolute right-0 top-0 rounded-r-full text-white disabled:cursor-not-allowed disabled:bg-[rgba(253,80,0,0.2)]
              disabled:border-[rgba(253,80,0,0.2)]
            "
            data-select-btn
          >
            <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right"></jds-icon>
          </button>

          <ul
            class="w-480 lg:j-w-404 absolute left-0 right-0 top-80 lg:j-top-80 bg-white z-0 max-h-0 opacity-0 group-[.active]/data:opacity-100 group-[.active]/data:max-h-210 lg:group-[.active]/data:j-max-h-206 group-[.active]/data:border border-solid border-[#DDD] pl-30 pr-0 lg:j-px-30 overflow-y-auto transition-all duration-300"
            style="z-index:1;"
            data-energy-list-wrap
          ></ul>
        </div>

        <div class="w-full hidden lg:flex items-center lg:j-gap-30 mt-40 lg:j-mt-20">
          <div class="inline-flex lg:j-w-230 flex-row flex-wrap items-center">
            <img
              loading="lazy"
              class="w-66 h-66 lg:j-w-66 lg:j-h-66"
              src="{{rechargingIcon | image_url: width: 90 }}"
              alt="">
            <span class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">
              <em class="inline-block mx-5 lg:j-ml-10 lg:j-mr-5 text-45 leading-66 lg:j-text-45 lg:j-leading-66 text-primary font-600 not-italic" data-recharging-number>0</em>
              {{ 'helpToChoose.hours_unit' | t }}
            </span>
            <span class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">{{ 'helpToChoose.recharging_time' | t }}</span>
          </div>
          <div class="flex-center lg:j-w-300 flex-row flex-wrap">
            <img
              loading="lazy"
              class="w-66 h-66 lg:j-w-66 lg:j-h-66"
              src="{{savingIcon | image_url: width: 90 }}"
              alt="">
            <span class="text-22 leading-39 lg:j-text-22 lg:j-leading-36 text-black font-500">
              <em class="inline-block mx-5 lg:j-ml-10 lg:j-mr-5 text-45 leading-66 lg:j-text-45 lg:j-leading-66 text-primary font-600 not-italic" data-saving-energy-number>0</em>
              {{ 'helpToChoose.wattage_hour_unit' | t }}
            </span>
            <span class="de-min-width text-22 leading-39 lg:j-text-22 lg:j-leading-36 text-black font-500">{{ 'helpToChoose.energy_saving' | t }}</span>
          </div>
        </div>
        {% if carbonIcon != blank %}
          <div class="w-full hidden lg:flex items-center lg:j-gap-30 mt-40 lg:j-mt-20">
            <div class="inline-flex items-start">
              <img
                loading="lazy"
                class="w-66 h-66 lg:j-w-66 lg:j-h-66"
                src="{{carbonIcon | image_url: width: 90 }}"
                alt="">
              <span class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">
                <em class="inline-block mx-5 lg:j-ml-10 lg:j-mr-5 text-45 leading-66 lg:j-text-45 lg:j-leading-66 text-primary font-600 not-italic" data-carbon-number>0</em>
                {{ 'helpToChoose.carbon_unit' | t }}
              </span>
            </div>
            <span class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">{{ 'helpToChoose.carbon_footprint_reduction' | t }}</span>
          </div>
        {% endif %}
         {% if des != blank %}
         <div class="choose-des hidden lg:block mt-[0.5rem] text-[0.75rem] lg:text-[1rem]">
          {{ des }}
          </div>
          {% endif %}
      </div>
      <div class="lg:j-w-539">
        <h3 class="text-center text-primary font-500 text-26 leading-30 my-32 lg:j-text-26 lg:j-leading-30 lg:j-mt-0 lg:j-mb-40">{{ 'helpToChoose.choose_one_type' | t }}</h3>
        <ul class="grid grid-cols-1 gap-20 lg:j-gap-20" data-solar-list-wrap></ul>
        <div class="flex lg:hidden items-center mt-40 lg:j-mt-20">
          <div class="flex-1 flex-center flex-col">
            <div class="flex-center">
              <img
                loading="lazy"
                class="w-66 h-66 lg:j-w-66 lg:j-h-66"
                src="{{rechargingIcon | image_url: width: 90 }}"
                alt="" />
              <span class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">
                <em class="inline-block mx-5 lg:j-ml-10 lg:j-mr-5 text-45 leading-66 lg:j-text-45 lg:j-leading-66 text-primary font-600 not-italic" data-recharging-number>0</em>
                {{ 'helpToChoose.hours_unit' | t }}
              </span>
            </div>
            <p class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">{{ 'helpToChoose.recharging_time' | t }}</p>
          </div>
          <div class="flex-1 flex-center flex-col">
            <div class="flex-center">
              <img
                loading="lazy"
                class="w-66 h-66 lg:j-w-66 lg:j-h-66"
                src="{{savingIcon | image_url: width: 90 }}"
                alt="" />
              <span class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">
                <em class="inline-block mx-5 lg:j-ml-10 lg:j-mr-5 text-45 leading-66 lg:j-text-45 lg:j-leading-66 text-primary font-600 not-italic" data-saving-energy-number>0</em>
                {{ 'helpToChoose.wattage_hour_unit' | t }}
              </span>
            </div>
            <p class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">{{ 'helpToChoose.energy_saving' | t }}</p>
          </div>
        </div>
        {% if carbonIcon != blank %}
          <div class="flex lg:hidden items-center mt-40 lg:j-mt-20">
            <div class="flex flex-col" style="width:50%;margin-left:8.6vmin;">
              <div class="flex" style="margin-left:3vmin;">
                <img
                  loading="lazy"
                  class="w-66 h-66 lg:j-w-66 lg:j-h-66"
                  src="{{carbonIcon | image_url: width: 90 }}"
                  alt="" />
                <span class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">
                  <em class="inline-block mx-5 lg:j-ml-10 lg:j-mr-5 text-45 leading-66 lg:j-text-45 lg:j-leading-66 text-primary font-600 not-italic" data-carbon-number>0</em>
                  {{ 'helpToChoose.carbon_unit' | t }}
                </span>
              </div>
              <p class="text-24 leading-39 lg:j-text-24 lg:j-leading-36 text-black font-500">{{ 'helpToChoose.carbon_footprint_reduction' | t }}</p>
            </div>
          </div>
        {% endif %}
        {% if des != blank %}
         <div class="choose-des block lg:hidden mt-[0.5rem] text-[0.75rem] lg:text-[1rem]">
          {{ des }}
          </div>
          {% endif %}
      </div>
    </div>
  </div>


  {% comment %} Product Recommendation {% endcomment %}
  <div class="product-recommendation pb-55 lg:j-pb-120 bg-f5" data-product-recommendation>
    <h2
      class="w-full lg:j-w-1200 mx-auto text-center px-50 pt-60 pb-60 lg:j-px-0 lg:j-pt-60 lg:j-pb-70 font-600 text-black text-36 leading-54 lg:j-text-36 lg:j-leading-54"
      data-product-recommend-title
    >{{ 'helpToChoose.product_recommendation_title' | t }}</h2>
    <div
      data-section-title="{{ 'helpToChoose.product_recommendation_title' | t }}"
      data-coming-soon="{{ 'helpToChoose.new_product_coming_soon' | t }}"
      data-add-cart-text="{{ 'helpToChoose.add_to_cart' | t }}"
      data-product-recommend
    ></div>
    {% if carbonIcon != blank %}
      <div class="w-full lg:j-w-1200 mx-auto text-20 leading-30 lg:j-text-14 lg:j-leading-21 text-info px-60 py-30 lg:j-p-20">
        <p class="mb-20 lg:mb-0">● {{ 'helpToChoose.carbon_text_1' | t }}</p>
        <p>● {{ 'helpToChoose.carbon_text_2' | t }}</p>
      </div>
    {% endif %}
  </div>
</div>

<script defer>
  const howToChoose = {
    warrantyKey: "{{'products.product.properties_warranty_key' | t}}",
    warrantyContent: "{{'products.product.properties_warranty' | t}}"
  }
</script>
