<style>
  .scroll-high-light {
    padding-top: 36px;
    padding-bottom: 36px;
    background: #fff;
  }
  .scroll-high-light .scroll-container {
    width: 1312px;
    margin: 32px auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .scroll-high-light .scroll-container .title {
    width: 1000px;
    font-weight: 500;
    font-size: 40px;
    color: #1a1a1a;
    line-height: 48px;
    margin-bottom: 16px;
  }

  .scroll-high-light .scroll-container ul {
    width: 1000px;
  }
  .scroll-high-light .scroll-container ul li {
    display: inline;
  }
  .scroll-high-light .scroll-container ul li h5 {
    font-size: 32px;
    color: #999;
    display: inline;
    line-height: 1.3333;
    font-weight: 500;
  }
  .scroll-high-light .scroll-container.center {
    text-align: center;
    align-items: center;
  }
  .scroll-high-light .scroll-container.left {
    align-items: flex-start;
    text-align: left;
  }
  .scroll-high-light .scroll-container.right {
    align-items: flex-end;
    text-align: right;
  }

  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .scroll-high-light {
      padding-top: 2.5vw;
      padding-bottom: 2.5vw;
    }
    .scroll-high-light .scroll-container {
      width: 91.11111111vw;
      margin: 2.22222222vw auto;
    }
    .scroll-high-light .scroll-container .title {
      width: 69.44444444vw;
      font-size: 2.77777778vw;
      line-height: 3.33333333vw;
      margin-bottom: 1.11111111vw;
    }

    .scroll-high-light .scroll-container ul {
      width: 69.44444444vw;
    }
    .scroll-high-light .scroll-container ul li h5 {
      font-size: 2.22222222vw;
    }
  }
  @media screen and (max-width: 1023.98px) {
    .scroll-high-light {
      padding-top: 6.4vw;
      padding-bottom: 6.4vw;
      background: #fff;
    }
    .scroll-high-light .scroll-container {
      width: 82.93333333vw;
      margin: 0 8.53333333vw;
    }
    .scroll-high-light .scroll-container .title {
      width: auto;
      font-size: 7.46666667vw;
      line-height: 9.6vw;
    }

    .scroll-high-light .scroll-container ul {
      width: auto;
    }
    .scroll-high-light .scroll-container ul li h5 {
      font-size: 4.8vw;
      line-height: 1.44444;
      margin-bottom: 2.13333333vw;
    }
  }

  .scroll-high-light {
    padding-top: calc(var(--pc-padding-top) * 1px);
    padding-bottom: calc(var(--pc-padding-bottom) * 1px);
  }

  .scroll-high-light .scroll-container .title {
    font-size: calc(var(--pc-font) * 1px);
  }

  .scroll-high-light .scroll-container ul li h5 {
    font-size: calc(var(--pc-des-font) * 1px);
  }

  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .scroll-high-light {
      padding-top: calc(var(--pc-padding-top) * 100vw / 1440);
      padding-bottom: calc(var(--pc-padding-bottom) * 100vw / 1440);
    }
    .scroll-high-light .scroll-container .title {
      font-size: calc(var(--pc-font) * 100vw / 1440);
    }

    .scroll-high-light .scroll-container ul li h5 {
      font-size: calc(var(--pc-des-font) * 100vw / 1440);
    }
  }
  @media screen and (max-width: 1023.98px) {
    .scroll-high-light {
      padding-top: calc(var(--mb-padding-top) * 100vw / 750);
      padding-bottom: calc(var(--mb-padding-bottom) * 100vw / 750);
    }

    .scroll-high-light .scroll-container .title {
      font-size: calc(var(--mb-font) * 100vw / 750);
    }

    .scroll-high-light .scroll-container ul li h5 {
      font-size: calc(var(--mb-des-font) * 100vw / 750);
    }
  }
</style>

<div
  class="scroll-high-light"
  anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', ''}}"
  style="
    background: {{ settings.bg_color }};
    --pc-padding-bottom:{{ settings.pc_padding_bottom }};--mb-padding-bottom:{{ settings.mb_padding_bottom }};
    --pc-padding-top:{{ settings.pc_padding_top }};--mb-padding-top:{{ settings.mb_padding_top }};
    --pc-font:{{ settings.pc_font }};--mb-font:{{ settings.mb_font }};
    --pc-des-font:{{ settings.pc_des_font }};--mb-des-font:{{ settings.mb_des_font }};
  "
  data-color="{{ settings.des_color }}"
  data-highcolor="{{ settings.des_high_color }}"
>
  <div class="scroll-container {{ settings.align }}">
    <h3 class="title pc-block" style="color: {{ settings.title_color }}">{{ settings.title }}</h3>
    <h3 class="title mobile-block" style="color: {{ settings.title_color }}">{{ settings.title_mb }}</h3>
    <ul class="scroll_ul">
      {% for i in (0..19) %}
        {% assign des_index = 'des_' | append: forloop.index %}
        {% if settings[des_index] != blank %}
          <li>
            <h5>
              {{ settings[des_index] }}
            </h5>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

<script src="{{ 'gsap.js' | asset_url }}" defer></script>
<script src="{{ 'scrollTrigger.js' | asset_url }}" defer></script>

<script>
  (function () {
    function onReady(fn) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fn, { once: true });
        return;
      }
      fn();
    }

    onReady(function () {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      gsap.registerPlugin(ScrollTrigger);

      const textItems = Array.from(document.querySelectorAll('.scroll-high-light ul.scroll_ul li h5'));
      const element = document.querySelector('.scroll-high-light');
      if (!element || textItems.length === 0) return;

      const highColor = element.getAttribute('data-highcolor') || '#999999';
      const color = element.getAttribute('data-color') || 'var(--jds-color-primary)';

      const setAllToBase = () => {
        textItems.forEach((line) => {
          line.style.color = color;
        });
      };

      textItems.forEach((line, index) => {
        line.style.color = index === 0 ? highColor : color;
      });

      ScrollTrigger.create({
        trigger: '.scroll-high-light ul',
        start: 'top center',
        end: `bottom center`,
        scrub: 0,
        onLeave: setAllToBase,
        onLeaveBack: setAllToBase,
        onUpdate: function (self) {
          const progress = self.progress;
          const step = 1 / textItems.length;
          const buffer = step * 0.8;

          textItems.forEach(function (line, index) {
            const start = index * step - buffer;
            const end = (index + 1) * step + buffer;

            if (progress >= start && progress < end) {
              setAllToBase();
              line.style.color = highColor;
            }
          });
        },
      });
    });
  })();
</script>
