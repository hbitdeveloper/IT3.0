<a
        href="{{ block.settings.gallery_item_link }}"
        data-is-hot="{{ is_hot }}"
        class=" stories-item-card
                    group block w-full h-654 lg:j-h-500 xl:a-h-500 bg-black/20 cursor-pointer relative
                    after:block after-content-[''] after:absolute after:left-0 after:right-0 after:top-0 after:bottom-0
                    after:bg-black/15 after:z-0 stories-box {{ class }}
                "
>
    <img
            class="w-full h-654 lg:j-h-500 xl:a-h-500 object-cover"
            src="{{ block.settings.gallery_item_image | image_url: width: 442 }}"
            alt="{{ block.settings.gallery_item_image.alt | escape }}" loading="lazy"
    >
    {% if block.settings.type == '3' %}
        <div class="stories-card-play">
            <svg viewBox="0 0 24 24">
                <path
                  d="M3.568 23.07c-.627.388-1.231.453-1.812.194s-.872-.702-.872-1.33V2.028c0-.647.304-1.086.913-1.317.609-.231 1.199-.18 1.77.152l16.214 9.676c.554.332.835.817.844 1.455.01.638-.272 1.132-.844 1.483L3.568 23.07z"
                  fill="#FFF" fill-rule="nonzero" />
            </svg>
        </div>
    {% endif %}
    {% comment %} 标签 {% endcomment %}
    {% if block.settings.gallery_item_tag != blank %}
        <div class="life-story-tag absolute left-0 top-0 z-2">{{ block.settings.gallery_item_tag | escape }}</div>
    {% endif %}


    {% comment %} 阅读和播放 {% endcomment %}
    {% if block.settings.read_num != blank %}
        <div class="life-num-tag absolute z-2">
            {% if block.settings.type == "1" %}
                {{ 'stories.article.read' | t }}
            {% elsif block.settings.type == "3" %}
                {{ 'stories.article.watch' | t }}
            {% elsif block.settings.type == "2" %}
                {{ 'stories.article.listen' | t }}
            {% endif %}
            {{ block.settings.read_num | escape }}
        </div>
    {% endif %}

    <div
            class="gallery-box-detail{% if block.settings.is_hot %} gallery-box-detail--featured{% endif %}
                        absolute left-0 top-0 right-0 bottom-0 z-1
                        flex flex-col items-start justify-end p-40
                        lg:j-px-24 lg:j-pt-96 lg:j-pb-24
                        xl:a-px-24 xl:a-pt-96 xl:a-pb-24
                    "
    >
        <h2
                class=" gallery-box-text
                            font-medium text-white line-clamp-2
                            text-40 leading-56 mb-12
                            lg:j-text-32 lg:j-leading-40 lg:j-mb-12
                            xl:a-text-32 xl:a-leading-40 xl:a-mb-12
                        "
        >{{ block.settings.gallery_item_title | newline_to_br }}</h2>
        <div class="title-bottom flex gallery-box-text">
            <h4 data-time="{{ block.settings.type }}"
                class="
                            font-normal text-white line-clamp-1
                            text-28 leading-36
                            lg:j-text-20 lg:j-leading-28
                            xl:a-text-20 xl:a-leading-28
                        "
            >{{ block.settings.gallery_item_subtitle | newline_to_br }}

            </h4>
            {% if block.settings.type == '2' %}
                <div class="play-time-tag flex justify-center items-center">
                    <svg class="play-svg" viewBox="0 0 18 18 " xmlns="http://www.w3.org/2000/svg">
                        <path
                                d="M9 0a9 9 0 00-9 9 9 9 0 009 9 9 9 0 009-9c.002-4.971-4.029-9-9-9zm4.23 9.649l-6.207 3.583a.75.75 0 01-1.125-.65V5.418a.75.75 0 011.125-.649l6.205 3.583c.5.287.5 1.01.002 1.298z"
                                fill="var(--jds-color-primary)" fill-rule="nonzero" />
                    </svg>
                    <svg class="video-svg" viewBox="0 0 34 16" xmlns="http://www.w3.org/2000/svg">
                        <path
                                d="M4.06 2h1.522v12H4.06V2zM0 5.594h1.522v5.812H0V5.594zM8.12 0h1.522v16H8.119V0zm4.06 5.5H13.7v5H12.18v-5zM16.238 4h1.522v8H16.24V4zm4.06-2h1.522v12h-1.522V2zm4.06 4h1.522v4h-1.523V6zm4.059-2h1.522v8h-1.522V4zm4.06 1.5H34v5h-1.522v-5z"
                                fill="var(--jds-color-primary)" fill-rule="nonzero" />
                    </svg>
                    <span class="play-time">
                               {{ block.settings.play_time | escape }}
                                </span>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="read-more-btn">
        <jds-icon name="plus-line" class="icon"></jds-icon>
    </div>

    {% comment %} PC 端 hover 效果 {% endcomment %}
    <div
            class="hover-overlay
                        opacity-0 flex flex-col items-start justify-end transition-all duration-300
                        absolute left-0 top-0 right-0 bottom-0 bg-#DDD5C5 z-1
                        lg:j-px-24 lg:j-pt-96 lg:j-pb-24 group-hover:lg:opacity-100
                        xl:a-px-24 xl:a-pt-96 xl:a-pb-24 group-hover:xl:opacity-100
                    "
    >
        <div class="hover-detail-top">
            <div class="hover-detail-left">
                <h2
                        class="
                            font-medium !text-black line-clamp-2
                            lg:j-text-32 lg:j-leading-40 lg:j-mb-12
                            xl:a-text-32 xl:a-leading-40 xl:a-mb-12
                        "
                >{{ block.settings.gallery_item_title | newline_to_br }}</h2>
                <div class="hover-text-name">
                    <h4
                      class="
                            font-normal !text-black  line-clamp-1
                            lg:j-text-20 lg:j-leading-30
                            xl:a-text-20 xl:a-leading-30
                        "
                    >{{ block.settings.gallery_item_subtitle | newline_to_br }}
                    </h4>
                    {% if block.settings.type == '2' %}
                        <div class="play-time-tag flex justify-center items-center">
                            <svg class="play-svg" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                                <path
                                  d="M9 0a9 9 0 00-9 9 9 9 0 009 9 9 9 0 009-9c.002-4.971-4.029-9-9-9zm4.23 9.649l-6.207 3.583a.75.75 0 01-1.125-.65V5.418a.75.75 0 011.125-.649l6.205 3.583c.5.287.5 1.01.002 1.298z"
                                  fill="var(--jds-color-primary)" fill-rule="nonzero" />
                            </svg>
                            <svg class="video-svg" viewBox="0 0 34 16" xmlns="http://www.w3.org/2000/svg">
                                <path
                                  d="M4.06 2h1.522v12H4.06V2zM0 5.594h1.522v5.812H0V5.594zM8.12 0h1.522v16H8.119V0zm4.06 5.5H13.7v5H12.18v-5zM16.238 4h1.522v8H16.24V4zm4.06-2h1.522v12h-1.522V2zm4.06 4h1.522v4h-1.523V6zm4.059-2h1.522v8h-1.522V4zm4.06 1.5H34v5h-1.522v-5z"
                                  fill="var(--jds-color-primary)" fill-rule="nonzero" />
                            </svg>
                            <span class="play-time">
                               {{ block.settings.play_time | escape }}
                                </span>
                        </div>
                    {% endif %}
                </div>
            </div>
            <div class="hover-less-btn">
                <svg viewBox="0 0 60 60" class="icon" xmlns="http://www.w3.org/2000/svg">
                    <g fill="#666" fill-rule="nonzero" opacity=".6">
                        <path
                          d="M30 0c16.569 0 30 13.431 30 30 0 16.569-13.431 30-30 30C13.431 60 0 46.569 0 30 0 13.431 13.431 0 30 0zm0 3.53C15.38 3.53 3.53 15.38 3.53 30S15.38 56.47 30 56.47 56.47 44.62 56.47 30 44.62 3.53 30 3.53z" />
                        <path
                          d="M19.412 28.235h21.176c1.177 0 1.765.589 1.765 1.765s-.588 1.765-1.765 1.765H19.412c-1.177 0-1.765-.589-1.765-1.765s.588-1.765 1.765-1.765z" />
                    </g>
                </svg>
            </div>
        </div>
        <div class="detail-line"></div>
        <p
                class="!text-black/60
                            font-normal line-clamp-7
                            lg:j-text-20 !lg:j-leading-30
                            xl:a-text-20 !xl:a-leading-30
                        "
        >{{ block.settings.gallery_item_description | newline_to_br }}</p>
    </div>
</a>
