    <ul class="accordion-menu">
    {% for block in blocks %}
      {% case block.type %}
        {% when 'faq_item' %}
      <li>
        <h3 class="dropdownlink jky-text-lg flex justify-between items-center">
          {{block.settings.title | escape}}
          <jds-icon name="arrow-right" class="iconfont jackery-icon-arrow-right text-base"></jds-icon>
        </h3>
        <ul class="submenuItems">
          <div class="submenu-content jky-text-base">{{block.settings.faq_content | newline_to_br}}</div>
        </ul>
      </li>
      {% endcase %}
    {% endfor %}
    </ul>