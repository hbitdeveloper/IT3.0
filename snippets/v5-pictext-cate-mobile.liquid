{%-liquid
    assign cate_single = 0
    for item in settings.handle.cate.value
        assign cate_single = cate_single | plus: 1
    endfor
-%}

<pictext-cate-mobile {% unless cate_single > 1 %}data-single{% endunless %}>
    <drawer-dialog style="--drawer-top: var(--header-pos-bottom);" id="Drawer__pictext-cate--{{ id }}" placement="right">
        <div class="drawer__overlay"></div>
        <div class="drawer__content">
            <div class="section-container-lg">
                <div class="v5-menu-back drawer__close-btn flex items-center gap-x-1 py-4 sticky top-0 bg-white z-10">
                    <div class="w-5 h-5 flex items-center justify-center">
                        {%- render "icon-arrow", class: 'w-3 h-3 rotate-180', color: 'var(--color-text-info)' -%}
                    </div>
                    <span class="color-text-info text-base font-normal line-clamp-1">{{ section.settings.text_back }}</span>
                </div>

                <div class="v5-pictext-cate-mobile__content">
                    {%- if cate_single > 1 -%}
                        <div>
                            <div style="top: 3.5rem;" class="text-lg font-semibold bg-white pb-4 sticky z-[2]">{{settings.handle.title | strip_html | escape}}</div>
                            {%- for item in settings.handle.cate.value -%}
                                <menu-toggle class="relative block" style="z-index: {{forloop.index | plus: 1}};">
                                    <div 
                                        data-target="{{item.title | url_decode | strip | replace: ' ', ''}}"
                                        class="menu-toggle--trigger flex justify-between items-center py-2 sticky bg-white z-[2]" 
                                        style="top:3.5rem;"
                                        data-ga-event="5.0_top_nav_user_clicks"
                                        data-ga-action="click"
                                        data-ga-params-module="{{ settings.handle.title | strip_html | escape }}"
                                        data-ga-params-position="{{ item.title | strip | escape }}"
                                        data-ga-params-link="NULL" 
                                    >
                                        <span class="color-text-main font-semibold text-base flex-1 flex items-center">
                                            <span class="line-clamp-2">{{ item.title }}</span>
                                        </span>
                                        <svg class="rotate-90 w-3 h-3" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" width="14" height="14"><path d="M818.07039273 512L329.94971923 23.87932647l-111.86098796 101.69180708L604.51759771 512 218.08873127 898.42886645 329.94971923 1010.28985441z" fill="var(rgba(36, 47, 32, 1)"></path></svg>
                                    </div>

                                    <div class="menu-toggle-content invisible overflow-hidden bg-white">
                                        <div class="grid grid-cols-2 gap-3 py-3">
                                            {%- for card in item.items.value -%}
                                                <a href="{{ card.url }}" class="menu-toggle-subitem v5-pictext-cate-card flex flex-col relative"
                                                 data-ga-event="5.0_top_nav_user_clicks"
                                                 data-ga-action="click"
                                                 data-ga-params-module="{{ settings.handle.title | strip_html | escape }}"
                                                 data-ga-params-position="{{ item.title | strip | escape }}"
                                                 data-ga-params-link="{{ card.url | escape }}"
                                                >
                                                    {%- if card.tag != blank -%}
                                                        <div class="background-text-main absolute text-xs font-semibold text-white top-1 left-1 px-2 py-1 z-[2] line-clamp-1">{{ card.tag }}</div>
                                                    {%- endif -%}
                                                    <div style="height: auto;" class="v5-pictext-cate-card_img w-full overflow-hidden">
                                                        <img style="height: 7.4375rem;" width="{{ card.card_img.width }}" height="{{ card.card_img.height }}" loading="lazy" class="w-full h-full object-cover" data-src="{{ card.card_img | image_url: width: 480 }}" alt="{{ card.card_img.alt | escape }}" fetchpriority="low" />
                                                    </div>

                                                    <div class="v5-pictext-cate-card__content pt-2 pb-0 flex-1 flex flex-col justify-between">
                                                        <h3 class="text-xs font-semibold mb-1 line-clamp-2">{{ card.title }}</h3>
                                                        <div class="text-xs font-normal line-clamp-2">{{ card.subtitle }}</div>
                                                    </div>
                                                </a>
                                            {%- endfor -%}
                                        </div>
                                    </div>
                                </menu-toggle>
                            {%- endfor -%}
                        </div>
                    {%- else-%}
                        <div class="v5-pictext-cate-single">
                            {%- for item in settings.handle.cate.value -%}
                                <div style="top: 3.45rem;" class="text-lg font-semibold bg-white pb-4 sticky z-[2]">{{ item.title }}</div>
                                <div style="--index: {{ forloop.index }}" target-cate="{{item.title | url_decode | strip | replace: ' ', ''}}" class="{% if forloop.first %}active{% endif %} v5-pictext-cate-content grid grid-cols-2 gap-3">
                                    {%- for card in item.items.value -%}
                                        <a href="{{ card.url }}" class="v5-pictext-cate-card flex flex-col gap-y-1">
                                            <div style="height: auto;" class="v5-pictext-cate-card_img w-full overflow-hidden">
                                                <img width="{{ card.card_img.width }}" height="{{ card.card_img.height }}" loading="lazy" class="w-full h-full object-cover aspect-square" data-src="{{ card.card_img | image_url: width: 480 }}" alt="{{ card.card_img.alt | escape }}" />
                                            </div>

                                            <div class="v5-pictext-cate-card__content text-left py-2">
                                                <h3 class="text-xs font-semibold mb-1 line-clamp-2">{{ card.title }}</h3>
                                                <div class="text-xs font-normal line-clamp-2">{{ card.subtitle }}</div>
                                            </div>
                                        </a>
                                    {%- endfor -%}
                                </div>
                            {%- endfor -%}
                        </div>
                    {%- endif-%}
                </div>
            </div>
        </div>
    </drawer-dialog>
</pictext-cate-mobile>


<script src="{{ 'snippets-v5-pictext-cate-mobile.js' | asset_url }}" defer></script>
