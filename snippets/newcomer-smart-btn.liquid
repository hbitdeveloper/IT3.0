{% if settings.button_title != blank %}
    <div class="newcomer-smart-bottom newcomer-main-container">
     <div class="higher-output-content">
       <div class="bottom-box">
           <div class="smart-btn-pc smart-btn-mb higher-btn">
               <div class="btn-title">{{ settings.button_title }}</div>
               <div class="btn-icon"><jds-icon name="plus-line" class="icon"></jds-icon></div>
           </div>

           <div class="remark">
                {{ settings.remark }}
           </div>
       </div>
     </div>
    </div>

    <div class="smart-main-pop">
        <div class="higher-output-box">
            {% if settings.jky_theme_version == 'v4' %}
                <jds-icon name="close-fill" class="pop-close-icon"></jds-icon>
            {%- else -%}
                <jds-icon name="close" class="pop-close-icon"></jds-icon>  
            {% endif %}
            <div class="pop-title text-overflow-2">{{ settings.table_title }}</div>
            {% if settings.table_description != blank %}
                <div class="pop-description text-overflow-2">{{ settings.table_description }}</div>
            {% endif %}
            <div class="pop-content" data-has-image="{% if settings.pc_pop_poster != blank or settings.mb_pop_poster != blank %}true{% else %}false{% endif %}">
                {% if settings.pc_pop_poster != blank or settings.mb_pop_poster != blank %}
                    {% render 'responsive-image', 
                       image: settings.pc_pop_poster, 
                       mimage: settings.mb_pop_poster, 
                       image_class: 'output-pop-image' 
                     %}
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}