{%- comment -%} v3 {%- endcomment -%}
{% style %}
  @media screen and (max-width: 1023.98px) {
    .pay-wrannty.v3 .pay-wrannty-list {
      border-top: 1px solid #CCCCCC;
    }

    .pay-wrannty.v3 .pay-wrannty-item {
      border-bottom: 1px solid #CCCCCC;
    }

    .pay-wrannty.v3 .pay-wrannty-item span {
      max-width: 74.4vw;
    }
  }
{% endstyle %}
<div class="pay-wrannty v3 lg:mt-5 mt-4 lg:mb-5 mb-4 {{ block_class }}">
  <div class="pay-wrannty-title text-base lg:mb-3 mb-2.5 lg:leading-7 leading-5 font-medium">{{ first_icon_list.section_title }}</div>
  <div style="border-top: 1px solid #CCCCCC;" class="pay-wrannty-list">
    {%- if has_credential == true -%}
      {% if section.settings.credential_a != blank %}
        <div class="pay-wrannty-item">
          {% render 'responsive-image', image: section.settings.credential_a_icon %}
          <span class="text-overflow-1">{{ section.settings.credential_a }}</span>
        </div>
      {%- endif -%}
      {% if section.settings.credential_b != blank %}
        <div class="pay-wrannty-item">
          {% render 'responsive-image', image: section.settings.credential_b_icon %}
          <span class="text-overflow-1">{{ section.settings.credential_b }}</span>
        </div>
      {%- endif -%}
      {% if section.settings.credential_c != blank %}
        <div class="pay-wrannty-item">
          {% render 'responsive-image', image: section.settings.credential_c_icon %}
          <span class="text-overflow-1">{{ section.settings.credential_c }}</span>
        </div>
      {%- endif -%}
      {% if section.settings.credential_d != blank %}
        <div class="pay-wrannty-item">
          {% render 'responsive-image', image: section.settings.credential_d_icon %}
          <span class="text-overflow-1">{{ section.settings.credential_d }}</span>
        </div>
      {%- endif -%}
    {%- elsif warranty_enable -%}
      {% for item in first_icon_list.warranty_list.value %}
        {% if item.title != blank %}
          <div class="pay-wrannty-item">
            {% render 'responsive-image', image: item.icon %}
            <span>{{ item.title }}</span>
          </div>
        {% endif %}
      {% endfor %}
    {%- endif -%}
  </div>

  {%- if pay_enable and first_icon_list.link_list != blank -%}
    <div class="new-pay-box">
      {%- if first_icon_list.total_icon != blank -%}
      <img src="{{first_icon_list.total_icon | image_url: width: 80}}" alt="{{first_icon_list.total_icon.alt | escape}}" width="24" height="24" loading="lazy">
      {%- endif -%}
      {%- render 'payment-icons' -%}
    </div>
  {%- endif -%}
</div>
