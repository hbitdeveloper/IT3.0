{{ 'section-photovolatic-save-electricity-old.min.css' | asset_url | stylesheet_tag }}

<section class="photovolatic-save-electricity-wrap w-full flex-center flex-col bg-#F5F3EF px-40 py-80 lg:px-0 lg:j-py-70 xl:a-pt-70">
    {% comment %} 进度条 {% endcomment %}
    <div
      class="
        w-full rounded-24 p-40 bg-white
        lg:j-w-1280 lg:j-rounded-12 lg:j-pl-55 lg:j-pr-170 lg:j-py-35
        xl:a-w-1280 xl:a-rounded-12 xl:a-pl-55 xl:a-pr-170 xl:a-py-35
      "
    >
        {% if settings.title != blank %}
          <h2
            class="
              w-full text-center lg:text-left opacity-0 text-#1A1A1A font-600 text-48 leading-64
              lg:j-text-40 lg:j-leading-48 xl:a-text-40 xl:a-leading-48
            "
            data-label-fade-in
          >{{ settings.title | newline_to_br }}</h2>
        {% endif %}
        
        <div class="mt-40 lg:j-mt-20 xl:a-mt-20">
          {% if settings.small_title_one != blank %}
            <div
              class="
                opacity-0 font-600 text-#1A1A1A text-40 leading-48 mb-20
                lg:j-text-24 lg:j-leading-48 lg:j-mb-6 xl:a-text-24 xl:a-leading-48 xl:a-mb-6
              "
              data-label-fade-in
            >{{ settings.small_title_one | newline_to_br }}</div>
          {% endif %}
          {% if settings.with_storage_number != blank %}
            <div class="w-full balcony-progress-bar relative h-44 rounded-r-22 lg:j-h-48 lg:j-rounded-r-24 xl:a-h-48 xl:a-rounded-r-24">
              <div class="balcony-progress relative h-full rounded-r-22 lg:j-rounded-r-24 xl:a-rounded-r-24 bg-gradient-to-r from-#FD8600 to-var(--jds-color-primary)">
                <div
                  class="
                    w-full h-full glow-1 relative font-600 flex items-center justify-end text-white
                    text-28 lg:j-text-28 xl:a-text-28
                  "
                  data-with-storage
                  data-number="{{ settings.with_storage_number }}"
                >{{ settings.with_storage_number | times: 100 | money_without_trailing_zeros }}</div>
              </div>
            </div>
          {% endif %}
        </div>
        <div class="mt-60 lg:j-mt-45 xl:a-mt-45">
          {% if settings.small_title_two != blank %}
            <div
              class="
                opacity-0 font-600 text-#1A1A1A text-40 leading-48 mb-20
                lg:j-text-24 lg:j-leading-48 lg:j-mb-6 xl:a-text-24 xl:a-leading-48 xl:a-mb-6
              "
              data-label-fade-in
            >{{ settings.small_title_two | newline_to_br }}</div>
          {% endif %}
          {% if settings.without_storage_number != blank %}
            <div class="w-full balcony-progress-bar relative h-44 rounded-r-22 lg:j-h-34 lg:j-rounded-r-17 xl:a-h-34 xl:a-rounded-r-17">
              <div class="balcony-progress relative h-full rounded-r-22 lg:j-rounded-r-24 xl:a-rounded-r-24 bg-gradient-to-r from-#EAE9E9FF to-#CFBFB8FF">
                <div
                  class="
                    w-full h-full glow-2 relative font-600 flex items-center justify-end text-white pr-20
                    text-28 lg:j-text-24 lg:j-pr-15 xl:a-text-24 xl:a-pr-15
                  "
                  data-without-storage
                  data-number="{{ settings.without_storage_number }}"
                >{{ settings.without_storage_number | times: 100 | money_without_trailing_zeros }}</div>
              </div>
            </div>
          {% endif %}
        </div>
        {% if settings.extra_description != blank %}
          <div
            class="
              opacity-0 mt-40 text-20 leading-24
              lg:j-mt-35 lg:j-text-10 lg:j-leading-12 xl:a-mt-35 xl:a-text-10 xl:a-leading-12
            "
            data-label-fade-in
          >{{ settings.extra_description | newline_to_br }}</div>
        {% endif %}
    </div>
</section>

<script defer src="{{ 'section-photovolatic-save-electricity-old.min.js' | asset_url }}"></script>