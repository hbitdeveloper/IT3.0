<section class="advertising-image">
    <div class="advertising-body">
        {% if settings.title %}
            <h2 class="font-600 text-#1A1A1A">
                {{ settings.title | newline_to_br }}
            </h2>
        {% endif %}
        <a href="{{ settings.advertising_link }}" target="{% if settings.open_new %}_blank{% else %}_self{% endif %}" rel="advertising image">
            {% render 'responsive-image',
                    image: settings.advertising_pc_image,
                    mimage: settings.advertising_mb_image,
                    image_class: 'advertising-image'
            %}
        </a>
    </div>
</section>
<style>
    .advertising-image .advertising-body{
        text-align: center;
        margin: 0 auto;
        width: 1200px;
    }
    .advertising-image h2{
        margin-bottom: 24px;
        line-height: 48px;
        font-size: 40px;
        padding: 0 40px;
    }
    .advertising-image .advertising-image{
        border-radius: 12px;
        width: 100%;
        height: 430px;
        object-fit: cover;
    }
    @media screen and (max-width: 1024px) {
        .advertising-image .advertising-body{
            width: 100%;
            padding: 0 5.33333333vw 0;
        }
        .advertising-image h2{
            margin-bottom: 5.33333vw;
            line-height: 8vw;
            font-size: 6.4vw;
            padding: 0 5.3333333vw;
        }
        .advertising-image .advertising-image{
            border-radius: 12px;
            width: 100%;
            height: 145.6vw;
            object-fit: cover;
        }
    }
    @media screen and (min-width: 1024px) and (max-width: 1440px) {
        .advertising-image .advertising-body{
            width: 86.66666667vw;
        }
        .advertising-image h2{
            margin-bottom: 2vw;
            line-height: 48px;
            font-size: 40px;
            padding: 0 40px;
        }
        .advertising-image .advertising-image{
            border-radius: 12px;
            width: 100%;
            object-fit: cover;
        }
    }
</style>
