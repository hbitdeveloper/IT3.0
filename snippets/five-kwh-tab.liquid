<style>
    .product-detail-new .produc-detail--content .inner--container {height: auto;}
    .page-container {
        width: 1440px;
        margin: 0 auto;
        max-width: 100%;
    }
    .hide-wrapper {
        transform: translateY(-110%);
    }
    .show-wrapper {
        transform: translateY(0);
        transition: transform .23s ease;
    }
    .product-tabs-box {
        display: none;
        padding: 0 40px;
        position: sticky;
        top: -1px;
        z-index: 11;
        width: 100%;
        border-bottom: 1px solid rgba(210, 248, 253, 0.3);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        backdrop-filter: saturate(180%) blur(20px);
        background: rgba(255, 255, 255, 0.8);
        transition: all 0.2s ease-in-out;
    }
    .product-tabs-box.inverted {
        background: rgba(0, 0, 0, 0.6);
        border-bottom: 1px solid rgba(210, 248, 253, 0.3);
    }
    .product-tabs-box.inverted .product-name {
        color: rgba(255, 255, 255, 0.8);
    }
    .product-tabs-box.inverted .subnav-list {
        color: rgba(255, 255, 255, 0.5);
    }
    .product-tabs-container {
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 64px;
    }
    .product-tabs-container jky-tabs {
        display: none;
    }
    .product-tabs-container .product-name {
        font-size: 20px;
        font-weight: 500;
        color: #222226;
        letter-spacing: -0.4px;
    }
    .product-tabs-container .subnav-list {
        display: flex;
        gap: 32px;
        font-size: 16px;
        font-weight: 600;
        text-align: center;
        height: 100%;
        align-items: center;
        transition: color 0.3s ease;
        color: rgba(0, 0, 0, 0.5);
    }
    .product-tabs-container .subnav-list .navli {
        height: 100%;
        cursor: pointer;
        display: flex;
        align-items: center;
        position: relative;
    }
    .product-tabs-container .subnav-list .navli::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        height: 2px;
        background: transparent;
    }
    .product-tabs-container .subnav-list .navli.active {
        color: var(--primary-color);
    }
    .product-tabs-container .subnav-list .slider-main {
        position: absolute;
        height: 2px;
        bottom: -1px;
        background: var(--primary-color);
        left: 0;
        transition: all 0.24s ease;
    }
    .product-tabs-container .nav-buy{
        padding: 7px 10px;
        color: #FFFFFF;
        background-color: var(--jds-color-primary);
        font-size: 16px;
        font-weight: 600;
        border-radius: var(--theme-btn-border-radius,8px);
        cursor: pointer;
        white-space: nowrap;
    }
    @media screen and (max-width: 1440px) {
        .page-container {
            width: 100%;
        }
        .product-tabs-container {
            height: 4.4444vw;
            padding: 0 2.777778vw;
            gap: 4.4444vw;
        }
        .product-tabs-container .product-name {
            font-size: 1.38889vw;
        }
        .product-tabs-container .subnav-list {
            gap: 2.083333vw;
            font-size: 1.11111vw;
        }
    }
    @media screen and (max-width: 1024px) {
        .product-tabs-box {
            padding: 0;
            background: rgba(255, 255, 255, 1);
        }
        .product-tabs-box .five-main-container{
            width: 100%;
        }
        .product-tabs-container .product-name {
            font-size: 4.8vw;
            font-weight: 500;
            color: #282828;
            line-height: 2;
        }
        .product-tabs-container .nav-buy {
            padding: 2.133333vw 3.2vw;
            color: #FFFFFF;
            background-color: var(--jds-color-primary);
            font-size: 3.733333vw;
            font-weight: 600;
            border-radius: 1.6vw;
            line-height: 3.2vw;
            margin-left: 4.266667vw;
            white-space: nowrap;
        }
        .product-tabs-container .subnav-list .slider-main {
            height: 4px;
        }
        .product-tabs-container .subnav-list {
            overflow-x: auto;
            width: 100%;
            display: flex;
            gap: 4.266667vw;
            font-size: 3.733333vw;
            font-weight: 600;
            text-align: center;
            height: 12.8vw;
            align-items: center;
            transition: color 0.3s ease;
            color: rgba(0, 0, 0, 0.5);
            padding: 0 6.4vw;
        }
        .product-tabs-container {
            height: 26.1333333vw;
            padding: 0;
            gap: 0;
            border-bottom: transparent;
            flex-direction: column;
            align-items: start;
        }
        .five-title{
            padding: 0 4.266667vw 0 6.4vw;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 13.33333vw;
            border-bottom: solid 1px rgba(0,0,0,0.12);
        }
        .product-tabs-container .subnav-list {
            display: none;
        }
        .product-tabs-container jky-tabs {
            display: block;
            width: 100%;
        }
        .product-tabs-container jky-tabs .jky-tabs-scroll .inner-w {
            gap: 32px;
        }
        .product-tabs-container jky-tabs .jky-tabs-scroll .jky-tabs-item {
            padding: 2px 0;
            font-size: 3.73333vw;
            white-space: nowrap;
        }
        .product-tabs-container jky-tabs .jky-tabs-scroll .next-action {
            width: 10.66667vw;
            padding-right: 6px;
            /*right: -6.4vw;*/
        }
        .product-tabs-container jky-tabs .jky-tabs-scroll .next-action svg {
            width: 2.13333vw;
            height: 2.13333vw;
        }
        .product-tabs-container jky-tabs .jky-tabs-scroll .prev-action {
            width: 10.66667vw;

        }
        .product-tabs-container jky-tabs .jky-tabs-scroll .prev-action svg {
            width: 2.13333vw;
            height: 2.13333vw;
        }
    }
    jky-tabs {
        height: 100%;
        max-height: 12.8vw;
    }
    jky-tabs .jky-tabs-scroll {
        position: relative;
        height: 100%;
        padding-right: 6.4vw;
    }
    jky-tabs .jky-tabs-scroll .jky-tabs-scroll-inner {
        position: relative;
        height: 12.8vw;
        padding: 0 6.4vw;
        overflow: hidden;
        display: flex;
        justify-content: space-between;
        flex-wrap: nowrap;
        will-change: auto;
        gap: 30px;
    }
    jky-tabs .jky-tabs-scroll .jky-tabs-scroll-inner .jky-tabs-slideline {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.133333vw;
        height: 0.533333vw;
        z-index: 2;
    }
    jky-tabs .jky-tabs-scroll .jky-tabs-scroll-inner .jky-tabs-slideline .jky-tabs-slideline--inner {
        position: absolute;
        left: 0;
        height: 4px;
        background: var(--primary-color);
        transition: all 0.24s ease;
    }
    jky-tabs .jky-tabs-scroll .inner-w {
        display: flex;
        justify-content: space-between;
        flex-wrap: nowrap;
        will-change: auto;
        gap: 30px;
        position: relative;
        height: 100%;
    }
    jky-tabs .jky-tabs-scroll .jky-tabs-item {
        display: flex;
        align-items: center;
        padding: 4px 0;
        font-size: 2.13333vw;
        font-weight: 600;
        color: rgba(0, 0, 0, 0.5);
        transition: color 0.24s ease-in-out;
    }
    jky-tabs .jky-tabs-scroll .jky-tabs-item.active {
        color: var(--primary-color);
    }
    jky-tabs .jky-tabs-scroll .next-action {
        position: absolute;
        height: 100%;
        top: 0;
        right: 0;
        width: 10.66667vw;
        background: linear-gradient(267deg, #FFFFFF 61%, rgba(255, 255, 255, 0) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding-right: 20px;
        transition: opacity 0.24s ease;
        z-index: 2;
    }
    jky-tabs .jky-tabs-scroll .next-action svg {
        width: 2.66667vw;
        height: 2.66667vw;
        cursor: pointer;
    }
    jky-tabs .jky-tabs-scroll .next-action.unvisible {
        opacity: 0;
    }
    jky-tabs .jky-tabs-scroll .prev-action {
        position: absolute;
        height: 100%;
        top: 0;
        width: 10.66667vw;
        background: linear-gradient(267deg, #FFFFFF 60%, rgba(255, 255, 255, 0) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        transform: rotate(180deg);
        transition: opacity 0.24s ease;
        z-index: 2;
    }
    jky-tabs .jky-tabs-scroll .prev-action svg {
        width: 2.66667vw;
        height: 2.66667vw;
        cursor: pointer;
    }
    jky-tabs .jky-tabs-scroll .prev-action.unvisible {
        opacity: 0;
    }
    .product-tabs-box.inverted jky-tabs .jky-tabs-scroll .jky-tabs-item:not(.active) {
        color: rgba(255, 255, 255, 0.5);
    }
    .product-tabs-box.inverted jky-tabs .jky-tabs-scroll .next-action {
        background: linear-gradient(267deg, #000000 61%, rgba(0, 0, 0, 0) 100%);
    }
    .product-tabs-box.inverted jky-tabs .jky-tabs-scroll .prev-action {
        background: linear-gradient(267deg, #000000 61%, rgba(0, 0, 0, 0) 100%);
    }
    .product-tabs-box.inverted jky-tabs .jky-tabs-scroll svg path {
        fill: rgba(255, 255, 255, 0.5);
    }
</style>

<div class="product-tabs-box five-kwh-tab cal_scroll_target hide-wrapper">
    <div class="product-detail-variants five-main-container">
        <div class="product-tabs-container">
            {%- if product_name != blank -%}
                <div class="five-title">
                    <h1 class="product-name text-overflow-1">{{ product_name }}</h1>
                    {%- if product_buy_text != blank or product_buy_link != blank -%}
                        <a class="nav-buy show-mb" href="{{ product_buy_link }}"
                           data-ga-event="5000plus_page_user_clicks"
                           data-ga-action="click"
                           data-ga-params-current_page=""
                           data-ga-params-module="Directory"
                           {% if product_name != blank %}
                               data-ga-params-title="{{ product_name }}"
                           {% endif %}
                           data-ga-params-button_name="{{ product_buy_text }}"
                           data-ga-params-link="{{ product_buy_link }}"
                           target="{% if new_window %}_blank{% else %}_self{% endif %}">{{ product_buy_text }}</a>
                    {%- endif -%}
                </div>
            {%- endif -%}
                <ul class="subnav-list relative J-tabs-point flex" style="--translate-filters-slider: 0%;--translate-filters-w: {{bar_tran_w}}%;">
                    {%- for item in list -%}
                        {%- assign item_id = list_id[forloop.index0] -%}
                        <li class="navli {% if forloop.index0 == 0 %} active{% endif %}" data-cate="product_tab_{{forloop.index0}}"
                            {%- if product_name != blank -%}
                            data-ga-event="5000plus_page_user_clicks"
                            data-ga-action="click"
                            data-ga-params-current_page=""
                            data-ga-params-module="Directory"
                            {% if product_name != blank %}
                            data-ga-params-title="{{ product_name }}"
                            {% endif %}
                            data-ga-params-position="{{ item }}"
                            {%- endif -%}
                            data-id="{{item_id | url_decode | strip | replace: ' ', ''}}">{{ item }}</li>
                    {%- endfor -%}
                    {%- if product_buy_text != blank or product_buy_link != blank -%}
                        <a class="nav-buy show-pc"
                           data-ga-event="5000plus_page_user_clicks"
                           data-ga-action="click"
                           data-ga-params-current_page=""
                           data-ga-params-module="Directory"
                           {% if product_name != blank %}
                               data-ga-params-title="{{ product_name }}"
                           {% endif %}
                           data-ga-params-button_name="{{ product_buy_text }}"
                           data-ga-params-link="{{ product_buy_link }}"
                           href="{{ product_buy_link }}" target="{% if new_window %}_blank{% else %}_self{% endif %}">{{ product_buy_text }}</a>
                    {%- endif -%}
                    <div class="slider-main"></div>
                </ul>
                <jky-tabs data-type="five-kwh">
                <div class="jky-tabs-scroll">
                    <div class="action-btn prev-action unvisible">
                        <svg width="13" height="21" viewBox="0 0 13 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path id="&#232;&#183;&#175;&#229;&#190;&#132;" fill-rule="evenodd" clip-rule="evenodd" d="M12.6172 10.0288C12.6172 10.2459 12.5779 10.4462 12.4993 10.6296C12.4207 10.8131 12.2952 10.9871 12.123 11.1519L3.44189 19.6533C3.16488 19.9303 2.82796 20.0688 2.43115 20.0688C2.16162 20.0688 1.91829 20.0033 1.70117 19.8723C1.48405 19.7413 1.30998 19.5691 1.17896 19.3557C1.04793 19.1423 0.982422 18.9009 0.982422 18.6313C0.982422 18.242 1.1359 17.8939 1.44287 17.5869L9.20312 10.0288L1.44287 2.4707C1.1359 2.17122 0.982422 1.82308 0.982422 1.42627C0.982422 1.15674 1.04793 0.915283 1.17896 0.701904C1.30998 0.488525 1.48405 0.318197 1.70117 0.190918C1.91829 0.0636393 2.16162 0 2.43115 0C2.82796 0 3.16488 0.134766 3.44189 0.404297L12.123 8.90576C12.2952 9.07048 12.4207 9.24455 12.4993 9.42798C12.5779 9.61141 12.6172 9.81169 12.6172 10.0288Z" fill="black" fill-opacity="0.4"/>
                        </svg>
                    </div>

                    <div class="jky-tabs-scroll-inner">
                        <div class="inner-w">
                            {%- for item in list -%}
                                {%- assign item_id = list_id[forloop.index0] -%}
                                <div class="jky-tabs-item {% if forloop.index0 == 0 %} active curr_tab{% endif %}"
                                     {%- if product_name != blank -%}
                                     data-ga-event="5000plus_page_user_clicks"
                                     data-ga-action="click"
                                     data-ga-params-current_page=""
                                     data-ga-params-module="Directory"
                                     {% if product_name != blank %}
                                         data-ga-params-title="{{ product_name }}"
                                     {% endif %}
                                     data-ga-params-position="{{ item }}"
                                     {% endif %}
                                     data-cate="product_tab_{{forloop.index0}}"  data-id="{{item_id  | url_decode | strip | replace: ' ', ''}}">{{item}}</div>
                            {%- endfor -%}

                            <div class="jky-tabs-slideline">
                                <div class="jky-tabs-slideline--inner"></div>
                            </div>
                        </div>
                    </div>


                    <div class="action-btn next-action">
                        <svg width="13" height="21" viewBox="0 0 13 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path id="&#232;&#183;&#175;&#229;&#190;&#132;" fill-rule="evenodd" clip-rule="evenodd" d="M12.6172 10.0288C12.6172 10.2459 12.5779 10.4462 12.4993 10.6296C12.4207 10.8131 12.2952 10.9871 12.123 11.1519L3.44189 19.6533C3.16488 19.9303 2.82796 20.0688 2.43115 20.0688C2.16162 20.0688 1.91829 20.0033 1.70117 19.8723C1.48405 19.7413 1.30998 19.5691 1.17896 19.3557C1.04793 19.1423 0.982422 18.9009 0.982422 18.6313C0.982422 18.242 1.1359 17.8939 1.44287 17.5869L9.20312 10.0288L1.44287 2.4707C1.1359 2.17122 0.982422 1.82308 0.982422 1.42627C0.982422 1.15674 1.04793 0.915283 1.17896 0.701904C1.30998 0.488525 1.48405 0.318197 1.70117 0.190918C1.91829 0.0636393 2.16162 0 2.43115 0C2.82796 0 3.16488 0.134766 3.44189 0.404297L12.123 8.90576C12.2952 9.07048 12.4207 9.24455 12.4993 9.42798C12.5779 9.61141 12.6172 9.81169 12.6172 10.0288Z" fill="black" fill-opacity="0.4"/>
                        </svg>
                    </div>
                </div>
            </jky-tabs>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        let scrolling = false
        function throttle(fn, delay) {
            let timer;
            return function () {
                if (!timer) {
                    timer = setTimeout(() => {
                        fn.apply(this, arguments);
                        timer = null;
                    }, delay);
                }
            }
        }
        const tabs_is_mobile = window.innerWidth < 1024;

        const cssEscape = (value) => {
            if (window.CSS && typeof window.CSS.escape === 'function') return window.CSS.escape(value);
            return String(value).replace(/"/g, '\\"');
        };

        const animateScrollTop = (targetTop, duration, cb) => {
            const startTop = window.pageYOffset || document.documentElement.scrollTop || 0;
            const diff = targetTop - startTop;

            if (window.__fiveKwhTabScrollCancel) window.__fiveKwhTabScrollCancel();
            let cancelled = false;
            window.__fiveKwhTabScrollCancel = () => { cancelled = true; };

            if (!duration || duration <= 0) {
                window.scrollTo(0, targetTop);
                cb && cb();
                return;
            }

            const startTime = performance.now();
            const step = (now) => {
                if (cancelled) return;
                const t = Math.min(1, (now - startTime) / duration);
                const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
                window.scrollTo(0, startTop + diff * eased);
                if (t < 1) {
                    requestAnimationFrame(step);
                } else {
                    cb && cb();
                }
            };
            requestAnimationFrame(step);
        };

        const tabBoxEl = document.querySelector('.product-tabs-box.five-kwh-tab');
        const tabPointEl = document.querySelector('.five-kwh-tab .J-tabs-point');

        const getScrollOffset = () => {
            const tabHeight = tabBoxEl ? tabBoxEl.getBoundingClientRect().height : 0;
            const headerEl =
                document.querySelector('.shopify-section-header') ||
                document.querySelector('#shopify-section-header') ||
                document.querySelector('header.header') ||
                document.querySelector('header');
            const headerHeight = headerEl ? headerEl.getBoundingClientRect().height : 0;
            return tabHeight + headerHeight;
        };

        const getAnchorElement = (anchorId) => {
            if (!anchorId) return null;
            const attrEl = document.querySelector(`[anchor="${cssEscape(anchorId)}"]`);
            if (attrEl) return attrEl;
            const idEl = document.getElementById(anchorId);
            if (idEl) return idEl;
            const idAttrEl = document.querySelector(`[id="${cssEscape(anchorId)}"]`);
            if (idAttrEl) return idAttrEl;
            return null;
        };

        const getAnchorTop = (anchorId) => {
            const anchorEl = getAnchorElement(anchorId);
            if (!anchorEl) return null;
            const top = anchorEl.getBoundingClientRect().top + (window.pageYOffset || 0) - getScrollOffset();
            return Math.max(0, top);
        };

        const bindFiveKwhTabMobileFallback = () => {
            const tabsRoot = document.querySelector('.five-kwh-tab jky-tabs');
            if (!tabsRoot) return;
            if (tabsRoot.__fiveKwhMobileAnchorsBound) return;
            tabsRoot.__fiveKwhMobileAnchorsBound = true;

            const items = Array.from(tabsRoot.querySelectorAll('.jky-tabs-item'));
            if (!items.length) return;

            const scrollContainer = tabsRoot.querySelector('.jky-tabs-scroll-inner');
            const innerContainer = tabsRoot.querySelector('.inner-w');

            const scrollTabToCenter = (tabEl) => {
                if (!tabEl || !scrollContainer) return;
                const tabRect = tabEl.getBoundingClientRect();
                const containerRect = scrollContainer.getBoundingClientRect();
                let targetLeft =
                    scrollContainer.scrollLeft +
                    (tabRect.left - containerRect.left) -
                    (containerRect.width / 2 - tabRect.width / 2);
                const maxLeft = Math.max(0, scrollContainer.scrollWidth - scrollContainer.clientWidth);
                targetLeft = Math.max(0, Math.min(maxLeft, targetLeft));
                scrollContainer.scrollTo({ left: targetLeft, behavior: 'smooth' });
            };

            const setActive = (activeEl) => {
                items.forEach((el) => {
                    const isActive = el === activeEl;
                    el.classList.toggle('active', isActive);
                    el.classList.toggle('curr_tab', isActive);
                });
            };

            items.forEach((item) => {
                item.addEventListener('click', (e) => {
                    e && e.preventDefault && e.preventDefault();
                    const anchorId = item.getAttribute('data-id');
                    const top = getAnchorTop(anchorId);
                    if (top === null) return;
                    setActive(item);
                    const isOverflow = !!(innerContainer && scrollContainer && innerContainer.scrollWidth > scrollContainer.clientWidth);
                    if (isOverflow) scrollTabToCenter(item);
                    scrolling = true;
                    animateScrollTop(top, 500, () => {
                        scrolling = false;
                    });
                }, true);
            });
        };

        document.querySelectorAll(`.five-kwh-tab .nav-buy`).forEach((el) => {
            el.setAttribute("data-ga-params-current_page", window.location.href);
        });
        document.querySelectorAll(`.five-kwh-tab .navli`).forEach((el) => {
            el.setAttribute("data-ga-params-current_page", window.location.href);
        });
        document.querySelectorAll(`.five-kwh-tab .jky-tabs-item`).forEach((el) => {
            el.setAttribute("data-ga-params-current_page", window.location.href);
        });
        if (!tabs_is_mobile) {
            function setTabsUnderline() {
                const tabsUnder = document.querySelector(".subnav-list .slider-main")
                const activeTab = document.querySelector(".subnav-list .navli.active")
                if (!tabsUnder || !activeTab || !activeTab.parentElement) return

                const activeRect = activeTab.getBoundingClientRect()
                const parentRect = activeTab.parentElement.getBoundingClientRect()
                tabsUnder.style.width = `${activeRect.width}px`
                tabsUnder.style.left = `${activeRect.left - parentRect.left}px`
            }
            function initUnderline(){
                const targetNode = document.querySelector('.product-tabs-box');
                const observerConfig = {
                    attributes: true,
                    attributeFilter: ['style'],
                };
                const observerCallback = (mutationsList) => {
                    for (const mutation of mutationsList) {
                        if (mutation.type === 'attributes') {
                            const displayValue = window.getComputedStyle(targetNode).display;
                            if (displayValue === 'block') {
                                setTabsUnderline();
                            }
                        }
                    }
                };

                const observer = new MutationObserver(observerCallback);
                observer.observe(targetNode, observerConfig);
            }
            initUnderline()
            setTabsUnderline()
            
            const pcTabLis = Array.from(document.querySelectorAll(".five-kwh-tab .J-tabs-point li"));
            const pcTabLiLength = pcTabLis.length || 1;

            const setPcActive = (liEl) => {
                if (!liEl) return;
                const index = pcTabLis.indexOf(liEl);
                pcTabLis.forEach((el) => el.classList.remove("active"));
                liEl.classList.add("active");
                if (tabPointEl) {
                    tabPointEl.style.setProperty('--translate-filters-slider', `${index * 100 / pcTabLiLength}%`);
                }
                setTabsUnderline();
            };

            pcTabLis.forEach((liEl) => {
                liEl.addEventListener("click", (e) => {
                    e && e.preventDefault && e.preventDefault();
                    const d_id = liEl.getAttribute("data-id");
                    setPcActive(liEl);
                    scrolling = true;
                    const top = getAnchorTop(d_id);
                    if (top === null) {
                        scrolling = false;
                        return;
                    }
                    animateScrollTop(top, 500, () => {
                        scrolling = false;
                    });
                });
            });
            const variantChangeEventListener = (e) => {
                if (e.detail && e.detail.variant) {
                    const sectionId = document.querySelector(".five-kwh--content")?.getAttribute("section-id") || '';
                    fetch(`${location.pathname}?variant=${e.detail.variant.id}&section_id=${sectionId}`)
                        .then((response) => response.text())
                        .then((responseText) => {
                            const html = new DOMParser().parseFromString(responseText, 'text/html')

                            document.querySelectorAll(".five-kwh--content .product-detail__variant_block").forEach((block, index) => {
                                const variant_block = html.querySelectorAll(".five-kwh--content .product-detail__variant_block")

                                variant_block[index] && (block.innerHTML = variant_block[index].innerHTML)
                                if (variant_block[index]) {
                                    block.innerHTML = variant_block[index].innerHTML
                                    if (!variant_block[index].innerHTML) {
                                        block.classList.add("product-detail__textpic_block_empty")
                                    } else {
                                        block.classList.remove("product-detail__textpic_block_empty")
                                    }
                                }
                            })
                        })
                }
            };
            document.addEventListener('variantChangeEvent', variantChangeEventListener);

            const allHeights = function () {
                const allHeight = []
                const uls = document.querySelectorAll(".five-kwh--content [anchor]:not([anchor=''])");
                Array.from(uls).forEach((v) => {
                    const key = v.getAttribute("anchor")
                    allHeight.push({
                        collection: key,
                        value: v.getBoundingClientRect().top + window.pageYOffset - 40
                    })
                });
                return allHeight
            }

            window.addEventListener("scroll", throttle(() => {
                const allHeightNew = allHeights()
                if (scrolling) return
                const yScroll = window.pageYOffset || document.documentElement.scrollTop;
                const viewCollection = allHeightNew.find((item, index) => {
                    if (index === allHeightNew.length - 1) {
                        const tabH = tabBoxEl ? tabBoxEl.getBoundingClientRect().height : 0;
                        return yScroll >= item.value - tabH
                    }
                    const tabH = tabBoxEl ? tabBoxEl.getBoundingClientRect().height : 0;
                    return yScroll >= item.value - tabH && yScroll <= allHeightNew[index + 1]["value"] - tabH - 40
                })
                if (viewCollection) {
                    const targetLi = document.querySelector(`.five-kwh-tab .J-tabs-point li[data-id="${cssEscape(viewCollection.collection)}"]`)
                    targetLi && setPcActive(targetLi)
                }
            }, 80))
        }
        if (!customElements.get('jky-tabs') && tabs_is_mobile) {
            window.__fiveKwhTabDefinedJkyTabs = true;
            customElements.define('jky-tabs', class JkyTabs extends HTMLElement {
                constructor() {
                    super();
                    this.selectors = {
                        container: this.querySelector(".jky-tabs-scroll-inner"),
                        next: this.querySelector(".next-action"),
                        next_btn: this.querySelector(".next-action"),
                        prev: this.querySelector(".prev-action"),
                        prev_btn: this.querySelector(".prev-action")
                    }
                    this.isProdctTab = !this.getAttribute("data-type")
                    this.dragging = false
                    this.curYPos = 0
                    this.curXPos = 0
                    this.isMobile = window.innerWidth < 1024;
                    this.onmousedown_event = this.isMobile ? 'ontouchstart' : 'onmousedown'
                    this.onmouseup_event = this.isMobile ? 'touchend' : 'onmouseup'
                    this.onmousemove_event = this.isMobile ? 'touchmove' : 'mousemove'
                    this.init()
                }

                init() {
                    this.move();
                    this.listenerScroll();
                    this.setTabsUnderline();
                    this.initUnderline();
                    this.stopScroll();
                    let this_ = this
                    const innerContainer = this.querySelector('.inner-w');
                    const scrollContainer = this.selectors.container;
                    const calcOverflow = () => !!(innerContainer && scrollContainer && innerContainer.scrollWidth > scrollContainer.clientWidth);
                    const isOverflow = calcOverflow();
                    if (this.selectors.prev) this.selectors.prev.classList.add("unvisible");
                    if (this.selectors.next) {
                        if (isOverflow) this.selectors.next.classList.remove("unvisible");
                        else this.selectors.next.classList.add("unvisible");
                    }
                    this.querySelectorAll(".jky-tabs-item").forEach(item => {
                        let dataId = item.getAttribute("data-id")

                        item.addEventListener("click", (e) => {
                            // 区分拖拽和点击操作
                            if (this.endtime - this.startime < 300 || !e.pointerType) {
                                e && e.preventDefault && e.preventDefault();
                                this.querySelectorAll(".jky-tabs-item").forEach((el) => {
                                    el.classList.remove("curr_tab")
                                    el.classList.remove("active")
                                })
                                item.classList.add("active")
                                item.classList.add("curr_tab")
                                this.setTabsUnderline()

                                const items = Array.from(this.querySelectorAll(".jky-tabs-item"))
                                const index = items.indexOf(item)

                                const overflowNow = calcOverflow();
                                if (overflowNow) this.scrollTabToCenter(item);
                                const total = items.length;
                                if (this.selectors.prev) this.selectors.prev.classList.toggle("unvisible", !overflowNow || index === 0);
                                if (this.selectors.next) this.selectors.next.classList.toggle("unvisible", !overflowNow || index === total - 1);
                                scrolling = true
                                const top = getAnchorTop(dataId)
                                if (top === null) {
                                    scrolling = false
                                    return
                                }
                                animateScrollTop(top, 500, () => {
                                    scrolling = false
                                })


                                if (this_.isProdctTab) {
                                    this_.slideToVisiable(item)
                                    const innerEl = document.querySelector(".produc-detail--content .inner--container")
                                    innerEl && innerEl.style.setProperty('--translate-active', index)

                                    const contentItems = Array.from(document.querySelectorAll(".produc-detail--contetn_item"))
                                    contentItems.forEach((el, i) => {
                                        el.style.height = i === index ? 'max-content' : '0px'
                                    })

                                    const firstContent = document.querySelector('.produc-detail--contetn_item')
                                    const tabsHeight = document.querySelector(".product-tabs-container")?.getBoundingClientRect().height || 0
                                    const top = firstContent ? firstContent.getBoundingClientRect().top + (window.pageYOffset || 0) - tabsHeight : 0
                                    animateScrollTop(top, 0)
                                    const cate = item.getAttribute("data-cate")
                                    history.pushState(null, null, `#${cate}`);
                                }
                            }
                        })
                    })
                    if (this.isProdctTab) {
                        setTimeout(() => {
                            this.handleHash()
                        }, 200)
                    }
                }

                slideToVisiable(next_tab) {
                    const scrollBox = this.querySelector(".jky-tabs-scroll")
                    if (!scrollBox) return
                    const dirConfig = this.isCloserToLeftOrRight(next_tab, scrollBox)
                    const isIn = this.isElementInsideParent(next_tab, scrollBox)
                    // 目标tab超出可视容器范围
                    if (isIn) return
                    const inner = this.querySelector(".jky-tabs-scroll-inner")
                    inner && (inner.style.scrollBehavior = "smooth")
                    setTimeout(() => {
                        inner && (inner.style.scrollBehavior = "unset")
                    }, 200);
                    if (dirConfig.dir === 1) { // 右边界
                        this.selectors.container.scrollLeft = this.selectors.container
                            .scrollLeft - dirConfig.value
                    } else {
                        requestAnimationFrame(() => {
                            this.selectors.container.scrollLeft = this.selectors
                                .container.scrollLeft + dirConfig.value
                        })
                    }
                }

                setTabsUnderline() {
                    const tabsUnder = this.querySelector(".jky-tabs-slideline .jky-tabs-slideline--inner")
                    const activeTab = this.querySelector(".jky-tabs-item.active")
                    const innerW = this.querySelector(".inner-w")
                    if (!tabsUnder || !activeTab || !innerW) return
                    const activeRect = activeTab.getBoundingClientRect()
                    const parentRect = innerW.getBoundingClientRect()
                    tabsUnder.style.width = `${activeRect.width}px`
                    tabsUnder.style.left = `${activeRect.left - parentRect.left}px`
                }

                initUnderline(){
                    const targetNode = document.querySelector('.product-tabs-box');
                    const observerConfig = {
                        attributes: true,
                        attributeFilter: ['style'],
                    };
                    const observerCallback = (mutationsList) => {
                        for (const mutation of mutationsList) {
                            if (mutation.type === 'attributes') {
                                const displayValue = window.getComputedStyle(targetNode).display;
                                if (displayValue === 'block') {
                                    this.setTabsUnderline();
                                }
                            }
                        }
                    };

                    const observer = new MutationObserver(observerCallback);
                    observer.observe(targetNode, observerConfig);
                }

                listenerScroll() {
                    const allHeights = function () {
                        const allHeight = [];
                        const uls = document.querySelectorAll(".five-kwh--content [anchor]:not([anchor=''])");
                        Array.from(uls).forEach(function (el) {
                            const key = el.getAttribute("anchor");
                            allHeight.push({
                                collection: key,
                                element: el
                            });
                        });
                        return allHeight;
                    };

                    window.addEventListener("scroll", throttle(() => {
                        const allHeightMobile = allHeights()
                        if (scrolling) return;

                        const viewCollection = allHeightMobile.find((item) => {
                            if (item.element) {
                                const elementTop = item.element.getBoundingClientRect().top;
                                const threshold = 200;
                                const tabH = tabBoxEl ? tabBoxEl.getBoundingClientRect().height : 0;
                                return elementTop <= threshold && elementTop >= threshold - tabH;
                            }
                            return false;
                        });
                        if (viewCollection) {
                            const currentTab = this.querySelector(`.inner-w .jky-tabs-item[data-id="${cssEscape(viewCollection.collection)}"]`);
                            if (!currentTab) return;
                            const items = Array.from(this.querySelectorAll(".jky-tabs-item"));
                            const index = items.indexOf(currentTab);
                            const length = items.length || 1;

                            const innerW = this.querySelector('.five-kwh-tab .inner-w') || this.querySelector('.inner-w')
                            innerW && innerW.style.setProperty('--translate-filters-slider', `${index * 100 / length}%`);
                            this.querySelectorAll(".inner-w .jky-tabs-item").forEach((el) => el.classList.remove("active"));
                            currentTab.classList.add("active");

                            const scrollContainer = this.selectors.container;
                            const innerContainer = this.querySelector('.inner-w');
                            const isOverflow = !!(innerContainer && scrollContainer && innerContainer.scrollWidth > scrollContainer.clientWidth);
                            if (isOverflow) {
                                this.scrollTabToCenter(currentTab);
                                this.updatePrevNextButtons(currentTab);
                            }
                            this.setTabsUnderline();
                        }
                    }, 80));
                }

                scrollTabToCenter(tabEl) {
                    if (!tabEl) return
                    const container = this.selectors.container
                    if (!container) return
                    const tabRect = tabEl.getBoundingClientRect()
                    const containerRect = container.getBoundingClientRect()
                    let targetLeft = container.scrollLeft + (tabRect.left - containerRect.left) - (containerRect.width / 2 - tabRect.width / 2)
                    const maxLeft = Math.max(0, container.scrollWidth - container.clientWidth)
                    targetLeft = Math.max(0, Math.min(maxLeft, targetLeft))

                    if (container.__fiveKwhTabScrollLeftCancel) container.__fiveKwhTabScrollLeftCancel()
                    let cancelled = false
                    container.__fiveKwhTabScrollLeftCancel = () => { cancelled = true }

                    const startLeft = container.scrollLeft
                    const diff = targetLeft - startLeft
                    const duration = 300
                    const startTime = performance.now()
                    const step = (now) => {
                        if (cancelled) return
                        const t = Math.min(1, (now - startTime) / duration)
                        const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2
                        container.scrollLeft = startLeft + diff * eased
                        if (t < 1) requestAnimationFrame(step)
                    }
                    requestAnimationFrame(step)
                }

                updatePrevNextButtons(tabEl) {
                    const items = Array.from(this.querySelectorAll('.jky-tabs-item'))
                    const index = tabEl ? items.indexOf(tabEl) : -1
                    const total = items.length

                    if (total <= 0) return
                    if (index <= 0) {
                        this.selectors.prev && this.selectors.prev.classList.add('unvisible')
                        this.selectors.next && this.selectors.next.classList.remove('unvisible')
                        return
                    }
                    if (index >= total - 1) {
                        this.selectors.next && this.selectors.next.classList.add('unvisible')
                        this.selectors.prev && this.selectors.prev.classList.remove('unvisible')
                        return
                    }
                    this.selectors.prev && this.selectors.prev.classList.remove('unvisible')
                    this.selectors.next && this.selectors.next.classList.remove('unvisible')
                }

                isCloserToLeftOrRight(element, parentElement) { // 判断元素靠近左边界还是右边界
                    let elementRect = element.getBoundingClientRect();
                    let parentRect = parentElement.getBoundingClientRect();

                    if (elementRect.x - parentRect.x < 0) {
                        return {
                            dir: -1,
                            value: elementRect.x - parentRect.x
                        }
                    } else {
                        return {
                            dir: 1,
                            value: parentRect.right - elementRect.right
                        }
                    }
                }

                isElementInsideParent(element, parentElement) { // 判断元素是否在内部
                    let elementRect = element.getBoundingClientRect();
                    let parentRect = parentElement.getBoundingClientRect();
                    let isInside = (
                        elementRect.left >= parentRect.left &&
                        elementRect.top >= parentRect.top &&
                        elementRect.right <= parentRect.right &&
                        elementRect.bottom <= parentRect.bottom
                    );
                    return isInside;
                }

                move() {
                    let doc = this;
                    let html = this.selectors.container;
                    let content = this.selectors.container;
                    doc.startime = 0
                    doc.endtime = 0
                    // 禁止选中文字
                    doc.onselectstart = function () {
                        return false;
                    };

                    let startScroll = 0;
                    let startX = 0;
                    let previousX = 0; // 保存上一次的clientX坐标
                    let currentX = 0; // 获取每次移动的位置
                    let velocity = 0; // 控制速度
                    let direction = 0; // 控制左右滑动
                    let momentum = 0.875; // 控制滑动距离
                    let momentumInterval = null;
                    let velocityInterval = null;

                    let isDragging = false;
                    let scrollDisabled = false;

                    function disablePageScroll() {
                        document.body.style.overflow = 'hidden';
                    }

                    // 恢复页面滚动
                    function enablePageScroll() {
                        document.body.style.overflow = '';
                    }

                    /**
                     * 鼠标移动事件
                     **/
                    function f(event) {
                        // 获取每次移动的位置
                        currentX = doc.isMobile ? event.touches[0].clientX : event.clientX;
                        html.scrollLeft = startScroll + (startX - currentX);

                        if (html.scrollWidth <= Math.ceil(html.scrollLeft + html.clientWidth) + 1 && html.scrollLeft > 0) {
                            doc.selectors.next.classList.add("unvisible");
                            doc.selectors.prev.classList.remove("unvisible");
                        }

                        if (html.scrollLeft <= 0) { // 滚动到最左边
                            doc.selectors.prev.classList.add("unvisible")
                            doc.selectors.next.classList.remove("unvisible")
                        }
                    }

                    /**
                     * 鼠标离开.content
                     **/
                    content.onmouseleave = function () {
                        /**
                         * 移除.content的鼠标移动事件
                         * @see f
                         **/
                        content.removeEventListener(doc.onmousemove_event, f);

                    };

                    /**
                     * 鼠标点击事件
                     **/
                    content[doc.onmousedown_event] = function (event) {
                        scrollDisabled = true;
                        disablePageScroll(); // 禁用整个页面的上下滚动

                        doc.startime = event.timeStamp

                        startScroll = html.scrollLeft;
                        startX = doc.isMobile ? event.touches[0].clientX : event.clientX;

                        previousX = startX;
                        currentX = startX;
                        clearInterval(velocityInterval);
                        velocityInterval = setInterval(function () {
                            // previousX保存上一次移动鼠标的clientX值
                            // 慢速移动时currentX与previousX数值相同或者差值较小（慢速移动鼠标一直在一个点上）
                            // 快速滑动时鼠标左滑previousX大于currentX，右滑currentX大于previousX
                            // 原理：当快速移动时，松开鼠标的时候已经不在当时点击的点位上，50毫秒后就出现了2个变量的数值差
                            // 原因：鼠标移动时，不会存储所有的移动信息。尤其是在快速移动鼠标时
                            velocity = Math.abs(currentX - previousX);

                            // 正负数转换用于控制左右滑动
                            // 左滑动为正数，右滑动为负数
                            direction = currentX > previousX ? -1 : 1;

                            previousX = currentX;
                        }, 50);

                        /**
                         * .content添加鼠标移动事件
                         * @see f
                         **/
                        this.addEventListener(doc.onmousemove_event, f);
                        content.addEventListener('touchend', function (event) {
                                scrollDisabled = false;
                                enablePageScroll();  // 恢复整个页面的上下滚动
                            });
                        };

                    /**
                     * 松开鼠标事件
                     **/
                    content[doc.onmouseup_event] = function (event) {
                        let num = 0;
                        scrollDisabled = false;
                        enablePageScroll();  // 恢复整个页面的上下滚动

                        clearInterval(velocityInterval);
                        clearInterval(momentumInterval);
                        num = velocity;
                        // 鼠标松开后开始执行滑动
                        momentumInterval = setInterval(function () {
                            // 滑动距离
                            // 滑动距离依次减小
                            html.scrollLeft = html.scrollLeft + num * direction;
                            // 数值依次减小
                            num *= momentum;

                            // 小于1销毁定时器，滑动结束
                            if (Math.abs(num) < 1) {
                                clearInterval(momentumInterval);
                            }
                        }, 15);

                        /**
                         * 移除.content的鼠标移动事件
                         * @see f
                         **/
                        content.removeEventListener(doc.onmousemove_event, f);
                        doc.endtime = event.timeStamp
                    };

                }

                handleHash() {
                    if (!this.isProdctTab) return
                    const hash = location.hash.replace("#", "");
                    let target = ''
                    if (!location.hash || hash.indexOf("product_tab_") === -1) {
                        target = null
                    } else {
                        target = hash
                    }
                    if (!target) return
                    const el = this.querySelector(`.jky-tabs-item[data-cate="${cssEscape(target)}"]`)
                    el && el.click()
                }

                stopScroll(){
                    const scrollTab = this.querySelector('.jky-tabs-scroll');
                    if (!scrollTab) return
                    scrollTab.addEventListener('wheel', function(event) {
                        event.stopPropagation(); // 阻止事件冒泡到父元素
                    });
                }
            })
        }

        if (tabs_is_mobile && customElements.get('jky-tabs') && !window.__fiveKwhTabDefinedJkyTabs) {
            bindFiveKwhTabMobileFallback();
        }
    })
</script>
