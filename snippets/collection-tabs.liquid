<style>
    .horizontal-container {
        position: sticky;
        z-index: 9;
        top: -1px;
        background: #fff;
        padding: 15px 0;
    }
    .horizontal-container .scroll-item {
        height: 46px;
        line-height: 46px;
        font-size: 18px;
        display: inline-block;
        color: #666;
        font-weight: 500;
        margin-right: 90px;
        position: relative;
        width: auto;
        cursor: pointer;
    }
    .horizontal-container .scroll-item:last-child {
        margin-right: 0;
    }
    .horizontal-container .scroll-item::after {
        position: absolute;
        content: "";
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--primary-color);
        transform: scaleX(0);
        transform-origin: left center;
        transition: all 0.3s ease;
    }
    .horizontal-container .scroll-item:hover {
        color: #222222;
    }
    .horizontal-container .scroll-item:hover::after {
        transform: scaleX(1);
    }
    .horizontal-container .scroll-item.active {
        color: #222222;
    }
    .horizontal-container .scroll-item.active::after {
        transform: scaleX(1);
    }

    @media screen and (max-width: 1024px) {
        .horizontal-container {
            padding: 12px 0;
        }
        .horizontal-container .scroll-item {
            height: 24px;
            line-height: 24px;
            font-size: 14px;
            margin-right: 30px;
        }
        .horizontal-container .scroll-item::after {
            height: 2px;
        }
        .horizontal-container .scroll-item:hover::after {
            transform: scaleX(0);
        }
    }
</style>
{% comment %} <div class="horizontal-container collection-tabs cal_scroll_target">
  <div class="scroll-wrapper section-container collection-tabs-content">
    <div class="scroll-content">
      {% for item in list %}
        <div data-anchor="{{item.handle}}" class="scroll-item collection-tab-item relative {% if forloop.index0 == 0 %}active{% endif %}">{{item.title | escape}}</div>
      {% endfor %}
    </div>
  </div>
</div> {% endcomment %}

<div class="horizontal-container collection-tabs cal_scroll_target">
  <div class="scroll-wrapper section-container collection-tabs-content swiper">
    <div class="scroll-content swiper-wrapper">
      {% for item in list %}
        <div
          {% if item.handle != blank %}
            data-anchor="{{item.handle}}"
          {% endif %}
          class="scroll-item collection-tab-item relative swiper-slide {% if forloop.index0 == 0 %}active{% endif %}"
          data-title="{{item.title | escape}}"
        >{{item.title | escape}}</div>
      {% endfor %}
    </div>
  </div>
</div>