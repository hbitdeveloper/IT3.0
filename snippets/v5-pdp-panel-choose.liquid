{%- style -%}
    @media (max-width: 1024px) {
        .pdp-choose-v5-inner h2 {
            font-size: 1.75rem;
            line-height: 1;
        }
    }
{%- endstyle -%}

<jky-panel-choose 
    {% if settings.anchor != blank %}anchor-target="{{settings.anchor | escape}}"{% endif %}
    variant_id="{{product.selected_or_first_available_variant.id}}"
    product_label="{{settings.product_label}}"
    data-spu-name="{{ product.title | escape }}"
>
    <div class="py-16" style="background: {{settings.bg_color | default: 'transparent' }};">
        <div class="pdp-choose-v5-inner {{settings.page_width}}">
            {%- if settings.heading != blank -%}
                <h2 style="color: #242F20;" class="font-semibold lg:text-5xl text-2xl text-center lg:mb-6 mb-4 lg:max-w-5xl max-w-full mx-auto">{{ settings.heading | replace: "\n", "<br>" | strip}}</h2>
            {%- endif -%}

            {%- if settings.subheading != blank -%}
                <p 
                    style="color: rgba(0,0,0,0.65);" 
                    class="text-center font-normal lg:max-w-5xl max-w-full lg:text-base text-xs mx-auto"
                >{{ settings.subheading | replace: "\n", "<br>" | strip}}</p>
            {%- endif -%}

            <div style="border-color: #C6C7C8;" class="pdp-choose-v5-main lg:mt-10 mt-8 lg:py-6 py-8 lg:border-y border-t border-y-0 border-solid flex lg:flex-row flex-col lg:gap-x-10">
                <div style="border-color: #C6C7C8;" class="pdp-choose-v5-left flex-1 lg:border-r border-r-0 border-solid lg:pr-10 lg:py-9 flex items-center">
                    <div class="grid w-full grid-cols-1 lg:gap-16">
                        <div class="pdp-choose-v5-select flex-1">
                            <div id="choose-panel-label-{{ product.id }}" style="color:rgba(36, 47, 32, 0.9);" class="lg:text-xl text-lg font-semibold">{{settings.choose_panel_label}}</div>

                            <div class="jky-custom-select w-full lg:mt-6 mt-4 relative">
                                <select 
                                    aria-labelledby="choose-panel-label-{{ product.id }}"
                                    style="border: solid 1px rgba(232, 232, 229, 1);color: rgba(36, 47, 32, 1);" 
                                    id="pdp-v5-choose-panel" 
                                    class="jky-custom-select-select w-full lg:h-14 h-9 pl-4 pr-10 appearance-none relative z-10 bg-transparent cursor-pointer lg:text-xl text-sm font-normal max-w-full whitespace-nowrap overflow-hidden text-ellipsis" 
                                    name="pdp-v5-choose-panel"
                                >
                                    {%- if settings.panel_collection != blank -%}
                                        {%- for product_panel in settings.panel_collection.products -%}
                                            {%- for variant_panel in product_panel.variants -%}
                                                {%- assign variable_name = null -%}
                                                {%- if variant_panel.metafields.custom.shortname != blank -%}
                                                    {%- assign variable_name = variant_panel.metafields.custom.shortname | truncate: 60 -%}
                                                {%- else -%}
                                                    {%- if product_panel.has_only_default_variant == true -%}
                                                        {{product_panel.title | truncate: 60}}
                                                        {%- assign variable_name = product_panel.title | truncate: 60 -%}
                                                    {%- else -%}
                                                        {{variant_panel.title | truncate: 60}}
                                                        {%- assign variable_name = variant_panel.title | truncate: 60 -%}
                                                    {%- endif -%}
                                                {%- endif -%}
                                                <option 
                                                    data-variant="{{variant_panel.id}}" 
                                                    value="{{variant_panel.id}}" 
                                                    class="appearance-none bg-white px-4 py-1 whitespace-nowrap overflow-hidden text-ellipsis max-w-full w-full"
                                                    data-label="{{ variable_name | escape }}"
                                                >
                                                    {{ variable_name }}
                                                </option>
                                            {%- endfor -%}
                                        {%- endfor -%}
                                    {%- endif -%}
                                </select>

                                <div class="absolute w-6 top-0 bottom-0 flex items-center justify-center right-4">
                                    {% render 'icon-arrow', width: 12, height: 12, color: 'rgba(20, 23, 24, 1)', class: 'w-3 h-3 rotate-90	' %}
                                </div>
                            </div>
                        </div>

                        <div class="pdp-choose-v5-select flex-1 lg:pt-0 pt-12">
                            <div id="choose-panel-num-label-{{ product.id }}" style="color:rgba(36, 47, 32, 0.9);" class="lg:text-xl font-semibold">{{settings.panel_num_label}}</div>

                            <div class="jky-custom-select w-full lg:mt-6 mt-4 relative">
                                <select 
                                    aria-labelledby="choose-panel-num-label-{{ product.id }}"
                                    style="border: solid 1px rgba(232, 232, 229, 1);color: rgba(36, 47, 32, 1);" 
                                    id="pdp-v5-choose-panel-num" 
                                    class="jky-custom-select-select pdp-v5-choose-panel-num_select w-full lg:h-14 h-9 pl-4 pr-10 appearance-none relative z-10 bg-transparent cursor-pointer lg:text-xl text-sm font-normal" 
                                    name="pdp-v5-choose-panel-num"
                                >
                                    {%- for i in (1..settings.panel_num_max) -%}
                                        <option 
                                            class="appearance-none bg-white px-4 py-1" 
                                            value="{{i}}"
                                        >{{i}}</option>
                                    {%- endfor -%}
                                </select>

                                <div class="absolute w-6 top-0 bottom-0 flex items-center justify-center right-4">
                                    {% render 'icon-arrow', width: 12, height: 12, color: 'rgba(20, 23, 24, 1)', class: 'w-3 h-3 rotate-90	' %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pdp-choose-v5-right flex flex-1 flex-col lg:gap-y-6 lg:pt-0 pt-8 justify-center">
                    <div class="flex lg:flex-col flex-row lg:items-start items-baseline gap-x-4">
                        <div style="color: rgba(36, 47, 32, 0.9);" class="text-2xl font-semibold">{{settings.is_compatible}}</div>
                        <h2 class="font-bold lg:text-7xl text-5xl text-primary pdp-choose-v5-right__resault">YES</h2>
                    </div>
                    <p style="color: rgba(0, 0, 0, 0.65);" class="lg:text-sm text-xs font-normal">{{settings.description}}</p>
                    
                    <div class="pdp-choose-v5-product flex flex-col gap-y-3">
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</jky-panel-choose>

<script src="{{ 'snippets-v5-pdp-panel-choose.js' | asset_url }}" defer></script>