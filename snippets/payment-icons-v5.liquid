{% comment %}
 标题：商详页支付图标组
 描述：
  1. 数据源：内容 - 元对象 - 本站所支持的支付图标列表
  2. 可配置版块开关，默认开启
  3. 可配置标题、图标列表

{% endcomment %}

{%- assign payment_icon_list = shop.metaobjects.payment_icon_list.values -%}
{% comment %} 仅获取第一个条目 {% endcomment %}
{%- assign first_icon_list = payment_icon_list | first -%}

{%- if first_icon_list.pay_enable -%}
  {% comment %} 支付图标列表 {% endcomment %}
  {%- if first_icon_list.link_list != blank -%}
    <div class="icons-list flex flex-wrap items-center gap-1 lg:gap-1.5 mt-5 lg:mt-6">
      {%- for item in first_icon_list.link_list.value -%}
        <picture>
          <source srcset="{{ item | image_url: width: 50, height:32 }}" media="(min-width: 1024px)">
          <img
            class="w-10 h-[1.6rem] lg:w-[3.125rem] lg:h-8"
            src="{{ item | image_url: width: 100, height: 64 }}"
            width="50"
            height="32"
            alt="payment icon"
            loading="lazy"
          >
        </picture>
      {%- endfor -%}
    </div>
  {%- endif -%}
{%- endif -%}
