<style>
  .indoor-img-text {
    width: 1360px;
    margin: 0 auto;
    margin-top: 68px;
  }
  .indoor-img-text .title {
    font-size: 40px;
    font-weight: 600;
    line-height: 48px;
    margin-bottom: 40px;
    text-align: center;
  }
  .indoor-img-text .indoor-box {
    display: flex;
    border-radius: 16px;
    overflow: hidden;
  }
  .indoor-img-text .indoor-box .left-box {
    width: 50%;
  }
  .indoor-img-text .indoor-box .left-box img {
    width: 100%;
    height: 410px;
    object-fit: cover;
  }
  .indoor-img-text .indoor-box .right-box {
    width: 50%;
    padding: 0 79px;
    display: flex;
    justify-content: center;
    flex-direction: column;
    max-height: 410px;
    overflow-y: auto;
  }
  .indoor-img-text .indoor-box .right-box .title {
    font-size: 24px;
    line-height: 32px;
    margin-bottom: 10px;
    font-weight: 600;
  }
  .indoor-img-text .indoor-box .right-box .sub-title {
    font-size: 18px;
    line-height: 26px;
    font-weight: 450;
  }
  .indoor-img-text .indoor-box.right {
    flex-direction: row-reverse;
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .indoor-img-text {
      width: 94.44444444vw;
      border-radius: 1.11111111vw;
      margin-top: 4.72222222vw;
    }
    .indoor-img-text .title {
      font-size: 2.77777778vw;
      line-height: 3.33333333vw;
      margin-bottom: 2.77777778vw;
    }
    .indoor-img-text .indoor-box .left-box {
      width: 50%;
    }
    .indoor-img-text .indoor-box .left-box img {
      width: 100%;
      height: 28.47222222vw;
    }
    .indoor-img-text .indoor-box .right-box {
      width: 50%;
      padding: 0 5.48611111vw;
      max-height: 28.47222222vw;
    }
    .indoor-img-text .indoor-box .right-box .title {
      font-size: 1.66666667vw;
      line-height: 2.22222222vw;
      margin-bottom: 0.69444444vw;
    }
    .indoor-img-text .indoor-box .right-box .sub-title {
      font-size: 1.25vw;
      line-height: 1.80555556vw;
    }
  }
  @media screen and (max-width: 1024px) {
    .indoor-img-text {
      width: 91.46666667vw;
      border-radius: 3.2vw;
      margin-top: 9.06666667vw;
    }
    .indoor-img-text .title {
      font-size: 5.33333333vw;
      line-height: 6.66666667vw;
      margin-bottom: 6vw;
    }
    .indoor-img-text .indoor-box {
      flex-direction: column;
    }
    .indoor-img-text .indoor-box .left-box {
      width: 100%;
    }
    .indoor-img-text .indoor-box .left-box img {
      width: 100%;
      height: 40vw;
    }
    .indoor-img-text .indoor-box .right-box {
      width: 100%;
      padding: 4vw;
    }
    .indoor-img-text .indoor-box .right-box .title {
      font-size: 4vw;
      line-height: 4.66666667vw;
      margin-bottom: 1.6vw;
    }
    .indoor-img-text .indoor-box .right-box .sub-title {
      font-size: 2.66666667vw;
      line-height: 3.73333333vw;
    }
    .indoor-img-text .indoor-box.right {
      flex-direction: column;
    }
  }
</style>

<div
  class="indoor-img-text"
  anchor="{{ imgtext.anchor_id  | url_decode | strip | replace: ' ', ''}}"
>
  {% if imgtext['big-title'] != blank %}
    <h2 class="title" style="color:{{ imgtext.big-title-color }}">
      {{ imgtext['big-title'] }}
    </h2>
  {% endif %}

  <div class="indoor-box {{ imgtext.position }}">
    <div class="left-box">
      {% if imgtext['pc-img'] != blank %}
        <img
          src="{{ imgtext['pc-img'] | image_url: width: 680 }}"
          alt="{{ imgtext['pc-img'].alt }}"
          class="show-image show-pc"
          loading="lazy"
        >
      {% endif %}
      {% if imgtext['mb-img'] != blank %}
        <img
          src="{{ imgtext['mb-img'] | image_url: width: 686}}"
          alt="{{ imgtext['mb-img'].alt }}"
          class="show-image show-mb"
          loading="lazy"
        >
      {%- elsif imgtext['pc-img'] != blank -%}
        <img
          src="{{ imgtext['pc-img'] | image_url: width: 680}}"
          alt="{{ imgtext['pc-img'].alt }}"
          class="show-image show-mb"
          loading="lazy"
        >
      {% endif %}
    </div>
    <div class="right-box" style="background: {{ imgtext.bg-color }};">
      {% assign titleColor = '<em style="color: ' | append: imgtext.title_sp_color | append: '">' %}
      <h2 class="title show-pc {{ imgtext.title_pc }}" style="color:{{ imgtext.title-color }}">
        {{ imgtext.title | replace: '<em>', titleColor  }}
      </h2>
      <h2 class="title show-mb {{ imgtext.title_mb }}" style="color:{{ imgtext.title-color }}">
        {% if imgtext['title-mb'] != blank %}
          {{ imgtext['title-mb'] | replace: '<em>', titleColor  }}
        {% else %}
          {{ imgtext.title | replace: '<em>', titleColor  }}
        {% endif %}
      </h2>
      {% assign titleSubColor = '<em style="color: ' | append: imgtext.title_sub_sp_color | append: '">' %}
      <div class="sub-title show-pc" style="color:{{ imgtext.sub-title-color }}">
        {{ imgtext['sub-title'] | replace: '<em>', titleSubColor  }}
      </div>
      <div class="sub-title show-mb" style="color:{{ imgtext.sub-title-color }}">
        {% if imgtext['sub-title-mb'] != blank %}
          {{ imgtext['sub-title-mb'] | replace: '<em>', titleSubColor  }}
        {% else %}
          {{ imgtext['sub-title'] | replace: '<em>', titleSubColor  }}
        {% endif %}
      </div>
    </div>
  </div>
</div>
