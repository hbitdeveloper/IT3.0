{% comment %}
  圆形实心问号图标

  参数:
  - class: {String} 样式类名
  - size: {Number} 尺寸
  - color: {String} 颜色
  - bg_color: {String} 实心背景颜色

  示例:
  {% render 'jky-icon-circle-question-fill' %}
  {% render 'jky-icon-circle-question-fill', class: 'icon-close', size: 32 , color: 'var(--jds-color-primary)',bg_color:'#ddd' %}
{% endcomment %}

{% if size == blank %}
  {% assign size = 52 %}
{% endif %}

{% if color == blank %}
  {% assign color = 'white' %}
{% endif %}

{% if bg_color == blank %}
  {% assign bg_color = 'black' %}
{% endif %}

