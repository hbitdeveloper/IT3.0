{% comment %}
    Render icon next (轮播图右箭头图标 - > )

    Accepts:
    - diameter: {Number} 圆直径
    - class: {String} 样式类名

    Usage:
    {% render 'jky-icon-next', class: 'icon-next-test', diameter: 48 , color: 'white', bgColor: 'black' %}
{% endcomment %}

{% if class == blank %}
	{% assign class = 'jky-icon-next' %}
{% endif %}

{% if diameter == blank %}
	{% assign diameter = 48 %}
{% endif %}
{% assign radius  = diameter | divided_by: 2 %}

{% if color == blank %}
	{% assign color = '#fff' %}
{% endif %}

{% if bgColor == blank %}
	{% assign bgColor = 'rgba(0,0,0,0.2)' %}
{% endif %}

<svg class="{{ class }}" width="{{ diameter }}" height="{{ diameter }}" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
	<circle cx="24" cy="24" r="24" transform="matrix(-1 0 0 1 48 0)" fill="{{ bgColor }}"/>
