<div class="newcomer-main-container newcomer-recharge newcomer-recharge-{{ index }}" anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', ''}}">
    <div class="recharge-content">
        <div class="recharge-left">
            {% if settings.title != blank %}
                <h3 class="recharge-title">{{ settings.title }}</h3>
            {% endif %}
            {% if settings.description != blank %}
                <div class="recharge-desc">{{ settings.description }}</div>
            {% endif %}
        </div>
        <div class="recharge-right">
            <div class="pc-block">
                <div class="pc-item">
                    {% for i in (0..2) %}
                        {% assign img_title = 'title_' | append: forloop.index %}
                        {% assign pc_img = 'pc_img_' | append: forloop.index %}
                        {% assign mb_img = 'mb_img_' | append: forloop.index %}
                        {% if settings[pc_img] != blank and settings[mb_img] != blank %}
                            <div class=" recharge-item">
                                <div class="recharge-img">
                                    {% render 'responsive-image',
                                            image: settings[pc_img],
                                            mimage: settings[mb_img],
                                            image_class: 'activity-image'
                                    %}
                                </div>
                                <div class="recharge-sub">{{ settings[img_title] }}</div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            <div class="swiper recharge-swiper mb-block">
                <div class="swiper-wrapper">
                    {% for i in (0..2) %}
                        {% assign img_title = 'title_' | append: forloop.index %}
                        {% assign pc_img = 'pc_img_' | append: forloop.index %}
                        {% assign mb_img = 'mb_img_' | append: forloop.index %}
                        {% if settings[pc_img] != blank and settings[mb_img] != blank %}
                            <div class="swiper-slide recharge-item">
                                <div class="recharge-img">
                                    {% render 'responsive-image',
                                            image: settings[pc_img],
                                            mimage: settings[mb_img],
                                            image_class: 'activity-image'
                                    %}
                                </div>
                                <div class="recharge-sub">{{ settings[img_title] }}</div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="mb-pagination recharge-pagination"></div>
            </div>
        </div>
    </div>
</div>

<style>
    .newcomer-recharge-{{ index }}{
        padding-top:{{ settings.pc_padding_top }}px;
        padding-bottom:{{ settings.pc_padding_bottom }}px;
    }
    @media screen and (min-width: 1024px) and (max-width: 1439.98px){
        .newcomer-recharge-{{ index }}{
            padding-top: calc( {{ settings.pc_padding_top }}  * 100vw / 1440 );
            padding-bottom: calc( {{ settings.pc_padding_bottom }}  * 100vw / 1440 );
        }
    }
    @media screen and (max-width: 1023.98px){
        .newcomer-recharge-{{ index }}{
            padding-top: calc( {{ settings.mb_padding_top }}  * 100vw / 750 );
            padding-bottom: calc( {{ settings.mb_padding_bottom }}  * 100vw / 750 );
        }
    }
</style>
