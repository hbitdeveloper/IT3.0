{% comment %} 购买意向表单  {% endcomment %}
{% liquid
  if shop.id == 60738666677 or settings.pif_dialog_type == "ca"
    assign cr = "ca"
  else
    assign cr = "us"
  endif
%}

<jky-form data-scroll="true" data-is-in-dialog="true" data-no-reset-after-submit="true"  data-reset-radio="true"
   jky-form-id="purchase-intention-form" class="purchase-intention-form">
  <form data-action="/osconsumerapi/consumer/act/record-information">
    <div class="form-item form-desc jds-b1">
      Our experts will help you find the best home power solution and answer your questions. Just fill out the form —
      we’ll be in touch.
    </div>
    <div class="hidden">
      <div class="form-item form-item_const" data-field="input">
        <input type="hidden" name="cr" data-value="cr" value="{{ cr }}">
      </div>
      <div class="form-item form-item_const" data-field="input">
        <input type="hidden" name="pageUrl" class="page-url" data-value="pageUrl" value="">
      </div>
    </div>
    <section class="top-border">
      <div class="section-title jds-h6 bottom-20">Contact Information</div>
      <div class="form-row flex">
        <div class="form-item flex-col w-half required" data-field="input">
          <label> Full Name (required) <span class="red">*</span> </label>
          <input
            type="text"
            id="fullName"
            name="fullName"
            placeholder="Your answer"
            data-error="This is a required question."
            data-value="fullName"
          >
        </div>
        <div class="form-item flex-col w-half required" data-field="input">
          <label> Phone Number (required) <span class="red">*</span> </label>
          <input
            type="number"
            id="phoneNumber"
            name="phoneNumber"
            placeholder="Your answer"
            data-error="This is a required question."
            data-value="phoneNumber"
          >
        </div>
        <div class="form-item flex-col w-half required" data-field="input">
          <label> Email Address (required) <span class="red">*</span> </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Your answer"
            data-error="This is a required question."
            data-value="email"
            data-reg="email"
            data-regerror="Email is invalid"
          >
        </div>
      </div>
    </section>

    <section class="top-border">
      <div class="section-title jds-h6 bottom-16"> Is Installation Service Required? <span class="red">*</span></div>
      <div class="form-row flex">
        <div class="form-item flex-row w-full required" data-field="radio" data-value="address" data-error="This is a required question." style="min-height: auto; margin-bottom: 0;">
          <div class="flex flex-row">
            <label class="radio-label" style="margin-right: 5rem;">
              <input
                      type="radio"
                      name="address"
                      value="yes"
              >
              Yes
            </label>
            <label class="radio-label">
              <input
                      type="radio"
                      name="address"
                      value="no"
              >
              NO
            </label>
          </div>
        </div>
      </div>
    </section>

    <section class="top-border">
      <div class="section-title jds-h6 bottom-16">Backup Power Preference <span class="red">*</span></div>
      <div class="section-desc jds-b1 bottom-20">
        This helps us understand your power needs and recommend the right solution.
      </div>
      <div class="form-row flex">
        <div class="form-item flex-col w-full required" data-field="radio" data-value="preference" data-error="This is a required question.">
          <label class="radio-label">
            <input
              type="radio"
              name="preference"
              placeholder="Your answer"
              value="Whole-home backup"

            >
            Whole-home backup
          </label>
          <label class="radio-label">
            <input
              type="radio"
              name="preference"
              placeholder="Your answer"
              value="Essentials only (e.g., fridge, lights, Wi-Fi)"
            >
            Essentials only (e.g., fridge, lights, Wi-Fi)
          </label>
          <label class="radio-label">
            <input
              type="radio"
              name="preference"
              placeholder="Your answer"
              value="Not sure yet"
            >
            Not sure yet
          </label>
        </div>
      </div>
    </section>

    <section>
      <div class="section-title jds-h6 bottom-20">Interested Products <span class="red">*</span></div>
      <div class="form-row flex">
        <div class="form-item required w-full" data-field="check_box_group" data-value="goodsList" data-error="This is a required question.">
          <label class="checkbox-label">
            <input
              type="checkbox"
              name="goodsList"
              value="Jackery 5000 Plus"
            >
            Jackery 5000 Plus
          </label>
          <label class="checkbox-label">
            <input
              type="checkbox"
              name="goodsList"
              value="Jackery 2000 Plus"
            >
            Jackery 2000 Plus
          </label>
          <label class="checkbox-label">
            <input
              type="checkbox"
              name="goodsList"
              value="Jackery HomePower 3000"
            >
            Jackery HomePower 3000
          </label>
          <label class="checkbox-label">
            <input
              type="checkbox"
              name="goodsList"
              value=""
              class="other-checkbox"
            >
            Other
            <input type="text" class="other-inp">
          </label>
        </div>
      </div>
    </section>

    <section>
      <div class="section-title jds-h6 bottom-20">Which devices are essential during a power outage?</div>
      <div class="form-row flex">
        <div class="form-item flex-col w-full" data-field="textarea" data-value="outageEssential">
          <div class="textarea-wrapper">
            <textarea
              name="outageEssential"
              id="outageEssential"
              maxlength="6000"
              placeholder="Your answer"
            ></textarea>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="section-title jds-h6 bottom-16">Additional Notes (Optional)</div>
      <div class="section-desc jds-b1 bottom-20">
        Let us know any special requests, current solar setup, or questions you have.
      </div>
      <div class="form-row flex">
        <div class="form-item flex-col w-full" data-field="textarea" data-value="specialRequests">
          <div class="textarea-wrapper">
            <textarea
              name="specialRequests"
              id="specialRequests"
              maxlength="6000"
              placeholder="Your answer"
            ></textarea>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="section-title jds-h6 bottom-16">Privacy & Data Use Statement <span class="red">*</span></div>
      <div class="form-row form-row_check_box form-check-box flex w-full">
        <div class="form-item required none-upload" data-field="check_box" data-value="agree_privacy_policy" data-error="This is a required question.">
          <jky-checkbox class="jky-checkbox_shortage jky-checkbox">
            <label class="jky-checkbox">
              <span class="jky-checkbox-input">
                <input type="checkbox" class="jky-checkbox-original">
                <span class="jky-checkbox-inner"></span>
              </span>
              <span class="jky-checkbox-label">
                <span class="jky-agree">
                  By submitting your information above, you agree to Jackery's
                  <a href="https://ca.jackery.com/policies/privacy-policy">Privacy Policy</a>. Your
                  privacy matters. We'll only use this info to recommend a solution and schedule service. No spam. No
                  sharing.
                </span>
              </span>
            </label>
          </jky-checkbox>
        </div>

        {% comment %} 启用 购买意向表单 人机校验 {% endcomment %}
        {%- if settings.open_pif_dialog_robot_check -%}
        <div class="form-item required none-upload form-item_const" data-field="input">
           <div id="renderRobotCheck"></div>
           <input type="hidden" id="recaptchaStatus" name="recaptchaStatus" data-error="This is a required question.">
        </div>
        {%- endif -%}

      </div>
    </section>

    <div class="flex justify-center w-full relative">
      <jds-button class="form_sub_btn">Submit</jds-button>
      <jds-button class="form_reset" variant="text" kind="custom" style="--jds-btn-custom-color:#666;">Clear Form</jds-button>
    </div>
  </form>
</jky-form>

{% comment %} 启用 购买意向表单 人机校验 {% endcomment %}
{%- if settings.open_pif_dialog_robot_check -%}
<script src="https://www.google.com/recaptcha/enterprise.js" async defer></script>
{%- endif -%}

<script src="{{ 'snippet-purchase-intention-form.min.js' | asset_url }}" defer></script>
