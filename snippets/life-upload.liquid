<section class="jf-custom-body jf-min-width jf-body-bg-color jf-works-upload-body">
  <section class="jf-main-container jf-works-upload-wrap">
    {% comment %} 上传主要区域 {% endcomment %}
    <div class="jf-works-upload-main">
      {% comment %} 上传主要区域 {% endcomment %}
      <div class="upload-media-area">
        <div class="upload-box">
          <div class="box-left">
            <div class="jf-upload-type-wrap">
              <h3 class="title" data-i18n="upload.upload_type"></h3>
              <div class="jf-btn-inner-wrap">
                <button type="button" data-uploadType="picture"
                  class="layui-btn layui-btn-radius layui-btn-primary layui-btn-danger jf-upload-pic-btn"
                  data-i18n="upload.photo"></button>
                <button type="button" data-uploadType="video"
                  class="layui-btn layui-btn-radius layui-btn-primary jf-upload-video-btn"
                  data-i18n="upload.video"></button>
              </div>
            </div>
          </div>
          <div class="box-right" id="picture_right">
            <div class="js-upload-list" id="uploadListView">
              <div class="layui-upload-drag jf-upload-image-type" id="jfUploadImage">
                <input multiple type="file" accept="image/*" style="display:none;" data-upload-img-input>
                <i class="life-icon jf-icon-shangchuanicon jf-icon jf-upload-icon"></i>
                <p data-i18n="upload.upload_photo_tips"></p>
              </div>
            </div>
          </div>
          <div class="box-right" id="video_right" style="display: none">
            <div class="js-upload-list" id="videoUploadListView">
              <div class="layui-upload-drag jf-upload-video-type" id="jfUploadVideo">
                <input type="file" accept="video/*" style="display:none;" data-upload-video-input>
                <i class="life-icon jf-icon-shangchuanicon jf-icon jf-upload-icon"></i>
                <p data-i18n="upload.upload_video_tips"></p>
              </div>
            </div>
            <div class="jf-upload-cover" id="jfUploadCover" style="display: none">
              <input type="file" accept="image/*" style="display:none;" data-upload-cover-input>
              <i class="life-icon jf-icon-shangchuanicon jf-icon jf-upload-icon"></i>
              <p class="cover-tip" data-i18n="upload.upload_cover"></p>
            </div>
          </div>
        </div>
        <div class="tips upload-image-tips" id="picture_tips">
          <p class="tip" data-i18n="upload.upload_tips_1"></p>
          <p class="tip" data-i18n="upload.upload_tips_2"></p>
          <p class="tip">
            <span data-i18n="upload.upload_tips_3"></span>
            <a data-href="upload.terms_of_use_link" data-i18n="upload.terms_of_use"></a>
            <i style="font-style:normal;" data-i18n="upload.and"></i>
            <a data-href="upload.content_guidelines_link" data-i18n="upload.content_guidelines"></a>
            <i style="font-style:normal;" data-i18n="upload.more_text"></i>
          </p>
        </div>
        <div class="tips upload-video-tips" id="video_tips" style="display: none">
          <p class="tip" data-i18n="upload.upload_tips_4"></p>
          <p class="tip" data-i18n="upload.upload_tips_5"></p>
          <p class="tip">
            <span data-i18n="upload.upload_tips_3"></span>
            <a data-href="upload.terms_of_use_link" data-i18n="upload.terms_of_use"></a>
            <i style="font-style:normal;" data-i18n="upload.and"></i>
            <a data-href="upload.content_guidelines_link" data-i18n="upload.content_guidelines"></a>
            <i style="font-style:normal;" data-i18n="upload.more_text"></i>
          </p>
        </div>
      </div>
      {% comment %} 表单区域 {% endcomment %}
      <div class="jf-works-upload-form">
        <form class="layui-form">
          <div class="layui-form-item">
            <label class="layui-form-label">
              <span data-i18n="upload.title"></span>
              <span class="star">*</span>
            </label>
            <div class="layui-input-block">
              <div style="position: relative">
                <input name="title" type="text" data-i18n="[placeholder]upload.please_enter_title" autocomplete="off"
                  class="layui-input" id="titleInput" maxlength="70" />
                <div style="
                      position: absolute;
                      right: 10px;
                      top: 38%;
                      transform: translateY(-50%);
                      font-size: inherit;
                      color: #999999;
                    ">
                  <span class="titleLength">0</span>/70
                </div>
                <p class="error-tip" data-i18n="upload.please_enter_title"></p>
              </div>
            </div>
          </div>
          <div class="layui-form-item layui-form-text">
            <label class="layui-form-label">
              <span data-i18n="upload.description"></span>
              <span class="star">*</span>
            </label>
            <div class="layui-input-block">
              <div style="position: relative">
                <textarea id="descTextarea" data-i18n="[placeholder]upload.please_enter_description"
                  name="description" class="layui-textarea" maxlength="5000" style="resize: none"></textarea>
                <div style="
                      position: absolute;
                      right: 10px;
                      bottom: 28px;
                      font-size: inherit;
                      color: #999999;
                    ">
                  <span class="descLength">0</span>/5000
                </div>
                <p class="error-tip" data-i18n="upload.please_enter_description"></p>
              </div>
            </div>
          </div>
          <div class="layui-form-item jf-desc-template-item" onclick="return false;">
            <label class="layui-form-label" data-i18n="upload.description_template"></label>
            <div class="layui-input-block">
              <div class="layui-carousel jf-carousel jf-template-carousel" id="jfDescBanner">
                <div carousel-item>
                  <div class="template-box first-template-box">
                    <div class="checkbox-wrap">
                      <input type="checkbox" lay-skin="danger" />
                    </div>
                    <p data-i18n="upload.description_example_1"></p>
                  </div>
                  <div class="template-box">
                    <div class="checkbox-wrap">
                      <input type="checkbox" lay-skin="danger" />
                    </div>
                    <p data-i18n="upload.description_example_2"></p>
                  </div>
                  <div class="template-box">
                    <div class="checkbox-wrap">
                      <input type="checkbox" lay-skin="danger" />
                    </div>
                    <p data-i18n="upload.description_example_3"></p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="layui-form-item jf-works-tags-item">
            <label class="layui-form-label">
              <span data-i18n="upload.tag"></span>
              <span class="star">*</span>
            </label>
            <div class="layui-input-block">
              <input id="tagInput" type="text" name="tag" data-i18n="[placeholder]upload.please_enter_tag"
                autocomplete="off" class="layui-input" maxlength="20" />
              <p class="error-tip" data-i18n="upload.please_enter_tag"></p>
            </div>
            <div class="jf-work-tag-list"></div>
          </div>
          {% comment %} 国家 {% endcomment %}
          <div class="layui-form-item">
            <label class="layui-form-label">
              <span data-i18n="upload.country"></span>
              <span class="star">*</span>
            </label>
            <div class="layui-input-inline">
              <select name="country" data-i18n="[placeholder]upload.please_select_country" lay-filter="countrySelect">
                <option value="" data-i18n="upload.please_select_country"></option>
              </select>
              <p class="error-tip" data-i18n="upload.please_select_country"></p>
            </div>
          </div>
          <div class="layui-form-item">
            <label class="layui-form-label" data-i18n="upload.related_product"></label>
            <div class="layui-input-inline">
              <select name="productId" data-i18n="[placeholder]upload.please_select_related_product" lay-search="">
                <option value="" data-i18n="upload.please_select_related_product"></option>
              </select>
              <p class="error-tip" data-i18n="upload.please_select_related_product"></p>
            </div>
          </div>
          <div class="layui-form-item">
            <label class="layui-form-label" data-i18n="upload.login_tips" style="color:#333;font-weight:500;white-space:normal;"></label>
          </div>
        </form>
      </div>
      <div class="jf-works-upload-form is-refer-friend">
        <form class="layui-form">
          <div class="layui-form-item">
            <div class="form-check">
              <input id="oldInviteNewFlag" type="checkbox" name="oldInviteNewFlag">
              <span class="info">
                <span data-i18n="upload.checkbox_info_1"></span>
                <span class="old-purchase-welfare"></span>
                <span data-i18n="upload.checkbox_info_2"></span>
                <span class="tips">
                  <svg viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#666666">
                    <path d="M918.795922 356.854687c-21.798121-51.476314-52.909055-97.631021-92.514092-137.236058-39.605037-39.605037-85.862083-70.818309-137.236058-92.514092C635.727364 104.590046 579.236458 93.128123 520.903458 93.128123s-114.823906 11.461923-168.142315 33.976414c-51.476314 21.798121-97.631021 52.909055-137.236058 92.514092s-70.818309 85.862083-92.514092 137.236058C100.496502 410.173096 89.034579 466.664002 89.034579 524.997002s11.461923 114.823906 33.976414 168.142315c21.798121 51.476314 52.909055 97.631021 92.514092 137.236058 39.605037 39.605037 85.862083 70.818309 137.236058 92.514092 53.21607 22.514491 109.809314 33.976414 168.142315 33.976414s114.823906-11.461923 168.142315-33.976414c51.476314-21.798121 97.631021-52.909055 137.236058-92.514092 39.605037-39.605037 70.818309-85.862083 92.514092-137.236058 22.514491-53.21607 33.976414-109.809314 33.976414-168.142315S941.310414 410.173096 918.795922 356.854687zM520.903458 911.836898c-213.273636 0-386.839896-173.56626-386.839896-386.839896s173.56626-386.839896 386.839896-386.839896 386.839896 173.56626 386.839896 386.839896S734.177094 911.836898 520.903458 911.836898z" data-spm-anchor-id="a313x.search_index.0.i0.542e3a81Zt0EFZ" class="selected"></path>
                    <path d="M520.903458 637.364781c12.38297 0 22.514491-10.131521 22.514491-22.514491L543.417949 344.574056c0-12.38297-10.131521-22.514491-22.514491-22.514491s-22.514491 10.131521-22.514491 22.514491l0 270.378573C498.388967 627.23326 508.520488 637.364781 520.903458 637.364781z"></path>
                    <path d="M520.903458 705.931641m-30.701579 0a30 30 0 1 0 61.403158 0 30 30 0 1 0-61.403158 0Z"></path>
                  </svg>
                </span>
              </span>
            </div>
          </div>
        </form>
      </div>
      {% comment %} 表单区域 {% endcomment %}
    </div>
    {% comment %} 上传主要区域 {% endcomment %}
    {% comment %} 上传提交按钮区域 {% endcomment %}

    <div class="jf-works-upload-submit-area">
      <button type="button" class="layui-btn layui-btn-radius layui-btn-primary jf-upload-cancel-btn" id="cancelBtn"
        data-i18n="upload.cancel"></button>
      <button type="button" class="layui-btn layui-btn-radius layui-btn-danger" id="saveBtn"
        data-i18n="common.release"></button>
    </div>
    {% comment %} 上传提交按钮区域 {% endcomment %}
  </section>
  {% comment %} 弹窗 {% endcomment %}
  <div id="tips-modal" class="tips-modal">
    <div class="tips-modal-content">
      <div class="tips-modal-close">&times;</div>
      <div class="tips-modal-container">
        <div class="title"></div>
        <div class="info">
          <div>
            <span data-i18n="upload.subscription_title"></span>
            <span data-i18n="upload.subscription_info_1"></span>
            <span class="old-subscribe-welfare"></span>
            <span data-i18n="upload.subscription_info_2"></span>
          </div>
          <div>
            <span data-i18n="upload.purchase_title"></span>
            <span data-i18n="upload.purchase_info_1"></span>
            <span class="order-amount-limit"></span>
            <span data-i18n="upload.purchase_info_2"></span>
            <span class="order-amount-limit"></span>
            <span data-i18n="upload.purchase_info_3"></span>
            <span class="old-purchase-welfare"></span>
            <span data-i18n="upload.purchase_info_4"></span>
          </div>
          <div data-i18n="upload.tips"></div>
        </div>
      </div>
    </div>
  </div>
</section>
