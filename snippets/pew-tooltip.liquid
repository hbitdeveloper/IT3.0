{% comment %}
  Component: pew-tooltip 付费延保提示框
	Accepts:
	- content: {String}	提示内容
  - icon_color: {String} 图标颜色
  - icon_width: {String} 图标宽度
  - icon_height: {String} 图标高度
  - icon_index: {String} 图标下标
	Usage:
	{% render 'pew-tooltip', content="content test",icon_color="#666",icon_width="18",icon_height="18"，icon_index="1" %}
{% endcomment %}

{% if icon_color == blank %}
	{% assign icon_color = 'black' %}
{% endif %}
{% if icon_width == blank %}
	{% assign icon_width = '52' %}
{% endif %}
{% if icon_height == blank %}
	{% assign icon_height = '51' %}
{% endif %}
{% if icon_index == blank %}
	{% assign icon_index = '1' %}
{% endif %}

<div class="pew-tooltip">
    <svg class="icon-info" style="color:{{ icon_color }};" width="{{icon_width}}" height="{{icon_height}}" viewBox="0 0 52 51" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path fill-rule="evenodd" clip-rule="evenodd"
        d="M0 25.4806C0 39.5531 11.4216 50.9611 25.5109 50.9611C39.6003 50.9611 51.0219 39.5531 51.0219 25.4806C51.0219 11.408 39.6003 0 25.5109 0C11.4216 0 0 11.408 0 25.4806ZM47.5431 25.4806C47.5431 37.6341 37.679 47.4865 25.5109 47.4865C13.3429 47.4865 3.47877 37.6341 3.47877 25.4806C3.47877 13.327 13.3429 3.47462 25.5109 3.47462C37.679 3.47462 47.5431 13.327 47.5431 25.4806ZM25.5109 11.5821C23.91 11.5821 22.612 12.8785 22.612 14.4776C22.612 16.0766 23.91 17.3731 25.5109 17.3731C27.1119 17.3731 28.4099 16.0766 28.4099 14.4776C28.4099 12.8785 27.1119 11.5821 25.5109 11.5821ZM25.511 39.3791C26.4716 39.3791 27.2503 38.6012 27.2503 37.6418V22.0059C27.2503 21.0465 26.4716 20.2686 25.511 20.2686C24.5503 20.2686 23.7716 21.0465 23.7716 22.0059V37.6418C23.7716 38.6012 24.5503 39.3791 25.511 39.3791Z"
        fill="currentColor" />
      <mask id="pewTooltipMask{{ icon_index }}" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="52" height="51">
        <path fill-rule="evenodd" clip-rule="evenodd"
          d="M0 25.4806C0 39.5531 11.4216 50.9611 25.5109 50.9611C39.6003 50.9611 51.0219 39.5531 51.0219 25.4806C51.0219 11.408 39.6003 0 25.5109 0C11.4216 0 0 11.408 0 25.4806ZM47.5431 25.4806C47.5431 37.6341 37.679 47.4865 25.5109 47.4865C13.3429 47.4865 3.47877 37.6341 3.47877 25.4806C3.47877 13.327 13.3429 3.47462 25.5109 3.47462C37.679 3.47462 47.5431 13.327 47.5431 25.4806ZM25.5109 11.5821C23.91 11.5821 22.612 12.8785 22.612 14.4776C22.612 16.0766 23.91 17.3731 25.5109 17.3731C27.1119 17.3731 28.4099 16.0766 28.4099 14.4776C28.4099 12.8785 27.1119 11.5821 25.5109 11.5821ZM25.511 39.3791C26.4716 39.3791 27.2503 38.6012 27.2503 37.6418V22.0059C27.2503 21.0465 26.4716 20.2686 25.511 20.2686C24.5503 20.2686 23.7716 21.0465 23.7716 22.0059V37.6418C23.7716 38.6012 24.5503 39.3791 25.511 39.3791Z"
          fill="white" />
      </mask>
      <g mask="url(#pewTooltipMask{{ icon_index }})">
        <rect x="-2.32031" y="-2.31641" width="55.6603" height="55.594" fill="currentColor" />
      </g>
    </svg>
    <div class="tooltip-box">
      <div class="box-content">{{ content }}</div>
      <i class="bottom-arrow"></i>
    </div>
</div>