<div class="five-kwh-3D-img-box" anchor="{{ imagethree.settings.anchor_id  | url_decode | strip | replace: ' ', ''}}" style="background: {{ imagethree.settings.bgColor }};">
  <div class="title-content five-main-container {% if imagethree.settings.title_inbox == true %}active{% endif %}">
    {% assign titleColor = '<em style="color: ' | append: imagethree.settings.module_title_color | append: '">' %}
      <div class="title">{{ imagethree.settings.module_title | replace: '<em>', titleColor}}</div>
      {% assign subTitleColor = '<em style="color: ' | append: imagethree.settings.sub_title_color | append: '">' %}
      <div class="sub-title">{{ imagethree.settings.sub_title | replace: '<em>', subTitleColor}}</div>
  </div>  
  <div class="img-box">

    {%- if imagethree.settings['img-type'] == 'img' -%}
      <div class="not3d-box {{imagethree.settings['pc-width']}} {{imagethree.settings['mb-width']}} {{imagethree.settings['is-radius']}}">
        {% if imagethree.settings['pc-img'] != blank %}
          <img
            src="{{ imagethree.settings['pc-img'] | image_url: width: 1920}}"
            alt="{{ imagethree.settings['pc-img'].alt }}"
            class="show-image pc-block"
            loading="lazy"
          >
        {% endif %}
        {% if imagethree.settings['mb-img'] != blank %}
          <img
            src="{{ imagethree.settings['mb-img'] | image_url: width: 750}}"
            alt="{{ imagethree.settings['mb-img'].alt }}"
            class="show-image mb-block"
            loading="lazy"
          >
        {%- elsif imagethree.settings['pc-img'] != blank -%}
          <img
            src="{{ imagethree.settings['pc-img'] | image_url: width: 1920}}"
            alt="{{ imagethree.settings['pc-img'].alt }}"
            class="show-image mb-block"
            loading="lazy"
          >
        {% endif %}
      </div>

    {% elsif imagethree.settings['img-type'] == '3d-img' and imagethree.settings['img-type'] != blank %}
      <div class="is3d-box {{imagethree.settings['pc-width']}} {{imagethree.settings['mb-width']}}">
        {%- render 'jky-3dmodal', url: imagethree.settings.url -%}
      </div>
    {% endif %}
  </div>
</div>
