{% comment %}
    产品详情页 - 添加心愿单

    Accepts: product
    Usage:
    {% render 'app-wishlist' %}
{% endcomment %}

{% comment %} 全局控制启用：open_wishlist {% endcomment %}
{%- if settings.open_wishlist == true -%}
    {% assign current_sticky_variant = product.selected_or_first_available_variant %}

    <jky-wishlist
        product-title="{{product.title | escape}}"
        variant-id="{{current_sticky_variant.id}}"
        variant-title="{{current_sticky_variant.title | escape}}"
        goodsid="{{product.id}}"
        shortname="{{product.metafields.custom.shortname}}"
        class="hidden"
    >
        <div class="app-wishlist-container pt-1.5 relative flex">
            <svg id="heart" xmlns="http://www.w3.org/2000/svg" height="20px" width="20px" viewBox="0 0 612 792">
                <path d="M611.721,288.299c-2.258-42.176-20.114-81.782-50.287-111.524c-30.557-30.119-70.43-46.708-112.27-46.708
                c-62.267,0-107.396,49.233-131.641,75.684c-3.743,4.085-8.13,8.87-11.183,11.79c-2.444-2.529-5.756-6.3-8.803-9.768
                c-22.142-25.222-68.223-77.704-134.688-77.704c-41.84,0-81.711,16.588-112.268,46.708C20.408,206.517,2.547,246.121,0.29,288.299
                c-2.248,42.107,8.521,78.746,34.92,118.803c20.888,31.701,75.961,93.605,133.927,150.543c29.856,29.326,57.336,54.18,79.466,71.873
                c35.936,28.729,49.7,32.413,57.674,32.413c7.476,0,21.614-3.352,57.895-32.332c22.079-17.637,49.463-42.451,79.194-71.76
                c57.445-56.63,112.318-118.617,133.443-150.743C594.576,380.072,614.6,342.151,611.721,288.299z"/>
            </svg>

            <div class="app-wishlist-content"></div>

            <p class="jky-tooltip app-wishlist-tooltip">
                <span class="jky-tooltip__inner jky-tooltip__inner--top" style="opacity:0"></span>

                <svg class="absolute" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="18" height="18"><g fill="#666" data-name="Layer 2" class="color231f20 svgShape"><path d="M8 2a6 6 0 1 0 6 6 6 6 0 0 0-6-6Zm0 11a5 5 0 1 1 5-5 5 5 0 0 1-5 5Z" fill="#999" class="color000 svgShape"></path><path d="M8 6.85a.5.5 0 0 0-.5.5v3.4a.5.5 0 0 0 1 0v-3.4a.5.5 0 0 0-.5-.5zM8 4.8a.53.53 0 0 0-.51.52v.08a.47.47 0 0 0 .51.47.52.52 0 0 0 .5-.5v-.12A.45.45 0 0 0 8 4.8z" fill="#999" class="color000 svgShape"></path></g></svg>
            </p>

            <div class="onekplus">+1</div>
        </div>

        <div class="app-wishlist-tips"></div>
    </jky-wishlist>
{% endif %}