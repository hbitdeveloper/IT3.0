<link rel="stylesheet" href="{{ 'plugin-new-customer-pop.min.css' | asset_url }}">

<div class="new-customer-plugin J-customer-plugin" style="display:none;" data-init-show="{{ initShow | default: false }}">
  <div class="new-customer-icon J-newCustomer-button" style="z-index:{{ settings.laxin_z_index | default: 19999 }};">
    <img class="icon-close" id="icon-close" style="z-index:{{ settings.laxin_z_index | append: 1 | default: 20000 }};" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
         src="https://cdn.shopify.com/s/files/1/0796/1123/2554/files/ic_close_filled-1.svg?v=1697445398" loading="lazy" alt="close">
    <img class="icon-img" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" loading="lazy" alt="">
  </div>

  <div id="new-customer-pop" class="new-customer-wrap" style="z-index:{{ settings.laxin_z_index | default: 19999 }};">
    <div class="new-customer-box">
      <div class="close-btn J-newCustomer-close" customer-current-step="one">
        <svg class="close-svg" xmlns="http://www.w3.org/2000/svg" fill="#888888" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </div>

      {% comment %} 首弹窗 {% endcomment %}
      <div class="customer-one-step J-newCustomer-one">
        <div class="title-wrap">
          <div
            class="
              title mx-auto font-semibold text-center
              w-full text-44 leading-52 text-#222
              lg:w-[90%] lg:j-text-32 lg:j-leading-40 lg:text-#333
              xl:a-text-32 xl:a-leading-40
            "
          ></div>
          <div
            class="
              subtitle mx-auto font-medium text-center text-#333
              w-full text-28 leading-34 mt-8
              lg:w-[90%] lg:j-text-16 lg:j-leading-20 lg:j-mt-6
              xl:a-text-16 xl:a-leading-20 xl:a-mt-6
            "
          ></div>
        </div>

        <div class="gift-box">
          <img src="" alt="">
        </div>
        <div class="form-wrap J-newCustomer-form">
          <input type="email" id="newCustomerEmail" class="input-full J-newCustomer-email font-medium" name="newCustomerEmail" autocorrect="off" autocapitalize="off" placeholder="">
          <div class="submit J-newCustomer-submit">{{ 'newCustomer.submit' | t }}</div>
        </div>
        <div class="error-tip J-newCustomer-tip" data-email-tip="{{ 'newCustomer.email_tip' | t }}" data-emailerror-tip="{{ 'newCustomer.email_error_tip' | t }}"></div>

        <div
          class="form-item declaration required J-newCustomer-checkbox"
          data-field="check_box"
          data-error=""
          style="min-height: auto;"
        >
          <jky-checkbox class="jky-checkbox_ jky-checkbox">
              <label class="jky-checkbox">
                  <span class="jky-checkbox-input">
                    <input type="checkbox" class="jky-checkbox-original" data-value="agree_recevie">
                    <span class="jky-checkbox-inner"></span>
                  </span>

                  <span class="jky-checkbox-label">
                    <span class="jky-agree">
                      {{ 'newCustomer.declaration' | t }}
                      <a href="/policies/terms-of-service">{{ 'newCustomer.terms_of_ues' | t }}</a> {{ 'newCustomer.and' | t }} <a href="/policies/privacy-policy">{{ 'newCustomer.privacy_policy' | t }}</a>
                      {{ 'newCustomer.jackery_zu' | t }}
                    </span>
                  </span>
              </label>
          </jky-checkbox>
          <p class="extra-description"></p>
        </div>
      </div>

      {% comment %} 等待 {% endcomment %}
      <div class="customer-two-step J-newCustomer-two display-none">
        <div
          class="
            title mx-auto font-semibold text-center
            w-full text-44 leading-52 text-#222
            lg:w-[90%] lg:j-text-32 lg:j-leading-40 lg:text-#333
            xl:a-text-32 xl:a-leading-40
          "
        ></div>
        <div
          class="
            subtitle mx-auto font-medium text-center text-#333
            w-full text-28 leading-34 mt-8
            lg:w-[90%] lg:j-text-16 lg:j-leading-20 lg:j-mt-6
            xl:a-text-16 xl:a-leading-20 xl:a-mt-6
          "
        ></div>
        <div class="customer-gift J-newCustomer-gift">
          <img src="" alt="">
        </div>
        <div class="text-loading">
          {{ 'newCustomer.text_loading' | t }}
          <div class="loading">
            <div></div>
            <div></div>
            <div></div>
          </div>
        </div>
      </div>

      {% comment %} 结果 | 中转 {% endcomment %}
      <div class="customer-three-step J-newCustomer-three display-none">
        <div
          class="
            title mx-auto font-semibold text-center
            w-full text-44 leading-52 text-#222
            lg:w-[90%] lg:j-text-32 lg:j-leading-40 lg:text-#333
            xl:a-text-32 xl:a-leading-40
          "
        ></div>
        <div
          class="
            subtitle mx-auto font-medium text-center text-#333
            w-full text-28 leading-34 mt-8
            lg:w-[90%] lg:j-text-16 lg:j-leading-20 lg:j-mt-6
            xl:a-text-16 xl:a-leading-20 xl:a-mt-6
          "
        ></div>
        <div class="customer-prizes-img J-newCustomer-prizes-img" data-coupon-pkg="0">
          <img src="" alt="">
        </div>
        <div class="code-tip J-code-tip display-none">
          <div class="name display-none">Product namext name</div>
          <div>
            <span>{{ 'newCustomer.copy_code' | t }}</span>
            <span class="customer-code">
              <span class="J-newCustomer-code"></span>
              <span class="copy-tip J-newCustomer-code-tip">{{ 'newCustomer.copy_success' | t }}</span>
            </span>
          </div>
        </div>
        <div class="coupon-text J-newCustomer-virtual-text display-none"></div>
        <div class="option-button display-none">
          <div class="J-newCustomer-left" data-register-left="{{ 'newCustomer.register_left' | t }}"></div>
          <div class="J-newCustomer-right" data-register-right="{{ 'newCustomer.register_right' | t }}"></div>
        </div>
        <div class="virtual-explain J-newCustomer-virtual-explain display-none"></div>
        <div class="coupon-text J-newCustomer-coupon-text display-none" data-more-text="{{ 'newCustomer.more' | t }}">
          <div class="coupon display-none">
            <div class="PC-show">
              <div class="coupon-wrap">
                <div class="coupon-item highlight">
                  <span class="over-wrap">
                    <span class="item-icon"></span>
                    {% if shop.id != 10015375438 %}
                      {{ 'newCustomer.order_over' | t }} <span class="J-newCustomer-limit"></span>
                    {% else %}
                      <span class="J-newCustomer-limit"></span>{{ 'newCustomer.order_over' | t }}
                    {% endif %}
                  </span>
                  <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_minimum' | t }}</span>
                </div>
                <div class="coupon-item">
                  <span class="over-wrap">
                    <span class="item-icon"></span><span>{{ 'newCustomer.valid_time' | t }}: </span><span class="J-newCustomer-time"></span>
                  </span>
                  <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_valid_time' | t }}</span>
                </div>
                <div class="coupon-item">
                  <span class="item-icon"></span>
                  <span class="J-newCustomer-couponTip" data-coupon-tip="{{ 'newCustomer.coupons_tip' | t }}" data-exclud-tip="{{ 'newCustomer.coupons_tip_exclud' | t }}"></span>
                  <span class="more">{{ 'newCustomer.more' | t }}</span>
                </div>
                {% comment %} <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.only_usable' | t }} <span class="J-newCustomer-cr"></span> {{'newCustomer.usable_site' | t}}</div>
                <div class="coupon-item">
                  <span class="item-icon"></span>{{ 'newCustomer.check_email' | t }}
                  <span class="more">{{ 'newCustomer.more' | t }}</span>
                </div> {% endcomment %}
              </div>
              <div class="toolTip">
                <div class="coupon-item highlight">
                  <span class="over-wrap">
                    <span class="item-icon"></span>
                    {% if shop.id != 10015375438 %}
                      {{ 'newCustomer.order_over' | t }} <span class="J-newCustomer-limit"></span>
                    {% else %}
                      <span class="J-newCustomer-limit"></span>{{ 'newCustomer.order_over' | t }}
                    {% endif %}
                  </span>
                  <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_minimum' | t }}</span>
                </div>
                <div class="coupon-item">
                  <span class="over-wrap">
                    <span class="item-icon"></span><span>{{ 'newCustomer.valid_time' | t }}: </span><span class="J-newCustomer-time"></span>
