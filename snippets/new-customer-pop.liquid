                <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_valid_time' | t }}</span>
              </div>
              <div class="coupon-item"><span class="item-icon"></span><span class="J-newCustomer-couponTip" data-coupon-tip="{{ 'newCustomer.coupons_tip' | t }}" data-exclud-tip="{{ 'newCustomer.coupons_tip_exclud' | t }}"></span></div>
              <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.only_usable' | t }} <span class="J-newCustomer-cr"></span> {{'newCustomer.usable_site' | t}}</div>
              <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.check_email' | t }}</div>
              <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.checkout_tip' | t }}</div>
            </div>
          </div>
          <div class="sku-coupon display-none">
            <div class="PC-show">
              <div class="coupon-wrap">
                <div class="coupon-item highlight">
                  <span class="over-wrap">
                    <span class="item-icon"></span><span>{{ 'newCustomer.valid_time' | t }}: </span><span class="J-newCustomer-time"></span>
                  </span>
                  <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_valid_time' | t }}</span>
                </div>
                <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.only_usable' | t }} <span class="J-newCustomer-cr"></span> {{'newCustomer.usable_site' | t}}</div>
                <div class="coupon-item">
                  <span class="item-icon"></span>{{ 'newCustomer.check_email' | t }}
                  <span class="more">{{ 'newCustomer.more' | t }}</span>
                </div>
                {% comment %} <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.checkout_tip' | t }}</div> {% endcomment %}
              </div>

              <div class="toolTip">
                <div class="coupon-item highlight">
                  <span class="over-wrap">
                    <span class="item-icon"></span><span>{{ 'newCustomer.valid_time' | t }}: </span><span class="J-newCustomer-time"></span>
                  </span>
                  <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_valid_time' | t }}</span>
                </div>
                <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.only_usable' | t }} <span class="J-newCustomer-cr"></span> {{'newCustomer.usable_site' | t}}</div>
                <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.check_email' | t }}</div>
                <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.checkout_tip' | t }}</div>
              </div>
            </div>
            <div class="Mob-show">
              <div class="coupon-item highlight">
                <span class="over-wrap">
                  <span class="item-icon"></span><span>{{ 'newCustomer.valid_time' | t }}: </span><span class="J-newCustomer-time"></span>
                </span>
                <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_valid_time' | t }}</span>
              </div>
              <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.only_usable' | t }} <span class="J-newCustomer-cr"></span> {{'newCustomer.usable_site' | t}}</div>
              <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.check_email' | t }}</div>
              <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.checkout_tip' | t }}</div>
            </div>
          </div>
          <div class="card display-none">
            <div class="PC-show">
              <div class="coupon-wrap">
                <div class="coupon-item highlight">
                  <span class="over-wrap">
                    <span class="item-icon"></span><span>{{ 'newCustomer.valid_time' | t }}: </span><span class="J-newCustomer-time"></span>
                  </span>
                  <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_valid_time' | t }}</span>
                </div>
                <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.only_usable' | t }} <span class="J-newCustomer-cr"></span> {{'newCustomer.usable_site' | t}}</div>
                <div class="coupon-item">
                  <span class="item-icon"></span>{{ 'newCustomer.card_no_minimum' | t }}
