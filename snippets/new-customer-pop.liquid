            <input type="phone" id="newCustomerPhone" class="input-full J-newCustomer-phone font-medium" name="newCustomerPhone" autocorrect="off" autocapitalize="off" placeholder="{{ 'newCustomer.phone_placeholder' | t }}" title="{{ 'newCustomer.phone_placeholder' | t }}">
            <div class="submit J-newCustomer-phoneSubmit">{{ 'newCustomer.phone_submit' | t }}</div>
          </div>
          <div class="error-tip J-newCustomer-phoneTip" data-phone-empty="{{ 'newCustomer.phone_empty' | t }}"></div>

          <div
            class="form-item declaration  required J-newCustomer-phoneCheckbox"
            data-field="check_box"
            data-error=""
            style="min-height: auto;"
