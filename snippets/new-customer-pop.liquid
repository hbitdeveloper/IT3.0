                  <span class="over-wrap">
                    <span class="item-icon"></span><span>{{ 'newCustomer.valid_time' | t }}: </span><span class="J-newCustomer-time"></span>
                  </span>
                  <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_valid_time' | t }}</span>
                </div>
                <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.only_usable' | t }} <span class="J-newCustomer-cr"></span> {{'newCustomer.usable_site' | t}}</div>
                <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.card_no_minimum' | t }}</div>
