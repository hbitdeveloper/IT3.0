<style>
    .product-carousel-container {
        position: relative;
        width: 100%;
    }

    .product-carousel-swiper {
        width: 100%;
        position: relative;
    }

    .product-carousel-swiper .swiper-slide {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        height: auto;
    }

    .product-carousel-container .swiper-arrow {
        color: #1A1A1A;
        display: inline-block;
        cursor: pointer;
    }

    .product-carousel-swiper .swiper-pagination {
        position: relative;
        margin-top: 1rem;
    }

    .product-carousel-swiper .swiper-pagination-bullet {
        background: #ccc;
        opacity: 1;
        margin: 0 4px;
    }

    .product-carousel-swiper .swiper-pagination-bullet-active {
        background: var(--jds-color-primary);
    }

    @media screen and (max-width: 768px) {
        .product-carousel-container .swiper-arrow {
            /* 移动端保持图标尺寸由类控制 */
        }
    }

    .specs-v5-accordion {
      background-color: #FFFFFF;
      overflow: hidden;
    }

    .specs-v5-accordion .specs-v5-content {
      padding: 40px 0;
      display: flex;
      justify-content: center;
    }
    .specs-v5-content .accordion-content--title {
      color: #1A1A1A;
      font-size: 24px;
      font-weight: 600;
      line-height: 1.2;
    }
    .specs-v5-content .accordion-content--specs-pic {
      width: 60.125rem;
      margin: 0 auto;
    }
    .specs-v5-content .accordion-content--specs-pic img {
      width: 550px;
      height: auto;
    }
    .specs-v5-content .specs-img {
      object-fit: cover;
      max-width: 750px;
      min-width: 500px;
    }

    .specs-v5-content .accordion-content--specs-pic ul {
      flex: 1;
    }
    .specs-v5-content ul {
      margin-left: 8%;
      counter-reset: li;
      display: flex;
      flex-direction: column;
      justify-content: center;
      row-gap: 16px;
    }
    .specs-v5-content ul li {
      padding-left: 48px;
      position: relative;
      font-size: 16px;
      line-height: 24px;
      color: #1A1A1A;
    }
    .specs-v5-content ul li::before {
      counter-increment: li;
      content: counter(li);
      width: 24px;
      height: 24px;
      line-height: 24px;
      color: #fff;
      text-align: center;
      background: var(--primary-color);
      border-radius: 15px;
      display: inline-block;
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
    }

    .specs-v5-content .accordion-content--specs-more-main,
    .specs-v5-content .accordion-content--specs-pic_bundle {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 40px;
      flex: 1;
      justify-content: space-around;
    }
    .specs-v5-content .accordion-content--specs-pic_bundle img {
      width: 550px;
      height: auto;
    }
    .specs-v5-content .accordion-content--specs-pic_bundle .accordion-content--title {
      width: 550px;
      text-align: center;
    }
    .specs-v5-content .accordion-content--specs-pic_bundle span.jky-text-sm {
      width: 550px;
      text-align: center;
      padding-top: 24px;
    }
    .specs-v5-content .accordion-content--specs-pic_bundles {
      margin-top: 24px;
    }
    .specs-v5-content .accordion-content--specs-pic_bundles img {
      margin: 0 auto 1rem;
      display: block;
    }

    @media screen and (max-width: 1023px) {
      .specs-v5-accordion {
        margin-bottom: 6.8vw;
        border-radius: 6px 6px 0 0;
      }
      .specs-v5-accordion .specs-v5-content {
        padding: 6.8vw 0;
        flex-direction: column;
      }
      .specs-v5-content .accordion-content--title {
        font-size: 4.53333333vw;
        line-height: 6.93333333vw;
        font-weight: 600;
      }
      .specs-v5-content .accordion-content--specs-pic {
        flex-direction: column;
        margin-left: 0;
        width: 100%;
      }
      .specs-v5-content .accordion-content--specs-pic img {
        width: 82vw;
        height: auto;
        margin: 0 auto 5.33333333vw;
      }
      .specs-v5-content .accordion-content--specs-pic ul {
        width: 82vw;
        margin-left: 0;
      }
      .specs-v5-content .specs-img {
        max-width: 82vw;
        margin-bottom: 12px;
        min-width: 70vw;
      }
      .specs-v5-content ul {
        margin-left: 0;
        row-gap: 4.26666667vw;
      }
      .specs-v5-content ul li {
        padding-left: 9.6vw;
        font-size: 4.26666667vw;
        line-height: 1;
      }
      .specs-v5-content ul li::before {
        width: 5.33333333vw;
        height: 5.33333333vw;
        line-height: 5.33333333vw;
        border-radius: 5.33333333vw;
        font-size: 3.46666667vw;
      }
      .specs-v5-content .accordion-content--specs-pic_bundle {
        padding-top: 8.53333333vw;
        margin-top: 8.53333333vw;
      }
      .specs-v5-content .accordion-content--specs-pic_bundles {
        margin-top: 8.53333333vw;
      }
      .specs-v5-content .accordion-content--specs-pic_bundles img {
        width: 100%;
        margin-bottom: 1rem;
      }
      .specs-v5-content .accordion-content--specs-pic_bundle .accordion-content--title {
        width: 100%;
        text-align: center;
        font-size: 4.53333333vw;
        line-height: 6.93333333vw;
        font-weight: 600;
      }
      .specs-v5-content .accordion-content--specs-pic_bundle span.jky-text-sm {
        width: 100%;
        text-align: center;
        padding-top: 4.26666667vw;
        font-size: 4.26666667vw;
      }
    }
</style>


{% comment %} 产品端口和尺寸（specs-v5 命名避免冲突） {% endcomment %}
<div class="specs-v5-accordion w-full {% if settings.part_1_heading == blank %} hidden{% endif %}" style="{% if settings.part_1_heading == blank %}display: none;{% endif %}">
  <div class="specs-v5-content flex-col">
    {% comment %} 产品轮播容器 {% endcomment %}
    {%- assign product_items = '' -%}
    {%- if settings.part_1_img != blank -%}
      {%- assign product_items = product_items | append: '1,' -%}
    {%- endif -%}
    {%- if settings.part_1_img_2 != blank -%}
      {%- assign product_items = product_items | append: '2,' -%}
    {%- endif -%}
    {%- if settings.part_1_img_3 != blank -%}
      {%- assign product_items = product_items | append: '3,' -%}
    {%- endif -%}

    {%- assign product_array = product_items | remove_last: ',' | split: ',' -%}
    {%- if product_array.size > 1 -%}
      {%- assign has1 = false -%}
      {%- assign has2 = false -%}
      {%- assign has3 = false -%}
      {%- for item in product_array -%}
        {%- if item == '1' -%}{%- assign has1 = true -%}{%- endif -%}
        {%- if item == '2' -%}{%- assign has2 = true -%}{%- endif -%}
        {%- if item == '3' -%}{%- assign has3 = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has1 -%}
        {%- assign reordered = '' -%}
        {%- if has2 -%}
          {%- assign reordered = reordered | append: '2,' -%}
        {%- elsif has3 -%}
          {%- assign reordered = reordered | append: '3,' -%}
        {%- endif -%}
        {%- assign reordered = reordered | append: '1,' -%}
        {%- if has2 and has3 -%}
          {%- assign reordered = reordered | append: '3,' -%}
        {%- endif -%}
        {%- assign product_array = reordered | remove_last: ',' | split: ',' -%}
      {%- endif -%}
    {%- endif -%}

    {%- if product_array.size > 1 -%}
      {%- assign default_index = 0 -%}
      {%- for item in product_array -%}
        {%- if item == '1' -%}
          {%- assign default_index = forloop.index0 -%}
        {%- endif -%}
      {%- endfor -%}
      <div class="product-carousel-container" data-anchor="{{ settings.part_1_heading | default: 'Tech Specs' | handleize }}">
        <div class="swiper product-carousel-swiper" data-default-index="{{ default_index }}">
          <div class="swiper-wrapper">
            {% for item in product_array %}
              <div class="swiper-slide">
                {% comment %} 统一的产品展示结构 {% endcomment %}
                {%- assign img_key = 'part_1_img' -%}
                {%- assign title_key = 'part_1_product_title' -%}
                {%- assign desc_prefix = 'part_1_product_desc_' -%}
                {%- assign desc_max = 19 -%}

                {%- if item == '2' -%}
                  {%- assign img_key = 'part_1_img_2' -%}
                  {%- assign title_key = 'part_1_product_2_title' -%}
                  {%- assign desc_prefix = 'part_1_product_2_desc_' -%}
                  {%- assign desc_max = 9 -%}
                {%- elsif item == '3' -%}
                  {%- assign img_key = 'part_1_img_3' -%}
                  {%- assign title_key = 'part_1_product_3_title' -%}
                  {%- assign desc_prefix = 'part_1_product_3_desc_' -%}
                  {%- assign desc_max = 9 -%}
                {%- endif -%}

                {%- assign wrapper_class = 'accordion-content--specs-more-main' -%}
                {%- if item == '1' -%}
                  {%- assign wrapper_class = '' -%}
                {%- endif -%}

                <div class="{{ wrapper_class }}">
                  <div class="flex accordion-content--specs-pic justify-center">
                    {% render 'diff-end-img', picture_class: 'accordion-content--specs-pic-image ', pc_img: settings[img_key], mb_img: settings[img_key], pc_img_width: 550, mb_img_width: 300, class: 'specs-img' %}
                    
                    <ul>
                      {%- for i in (0..desc_max) -%}
                        {%- assign key_index = desc_prefix | append: forloop.index -%}
                        {%- if settings[key_index] != blank -%}
                          <li class="jky-text-base">{{ settings[key_index] | escape}}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                  {%- if settings[title_key] -%}
                    <div class="accordion-content--title font-500 text-center mt-[1rem]">{{ settings[title_key] | escape}}</div>
                  {%- endif -%}
                </div>
              </div>
            {% endfor %}
          </div>

          {%- if product_array.size > 1 -%}
            <div class="swiper-button-box flex justify-center mt-[1rem] items-center lg:gap-[1.5rem] gap-[1rem]">
              <div class="button-left flex lg:gap-[1.5rem] gap-[1rem] items-center">
                <div class="left-icon w-[1.875rem] h-[1.875rem] lg:w-[2.5rem] lg:h-[2.5rem] flex">
                  {%- render 'v5-icon-arrow-left', class: 'icon-arrow-left mb-swiper-button-prev left-0 swiper-arrow inline-block text-[#111111]' -%}
                </div>
              </div>
              <div class="button-right flex lg:gap-[1.5rem] gap-[1rem] items-center">
                <div class="right-icon w-[1.875rem] h-[1.875rem] lg:w-[2.5rem] lg:h-[2.5rem] flex">
                  {%- render 'v5-icon-arrow-right', class: 'icon-arrow-right mb-swiper-button-next right-0 swiper-arrow inline-block text-[#111111]' -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      {% comment %} 单个产品时不使用轮播 {% endcomment %}
      {%- if settings.part_1_img -%}
        {%- if settings.part_1_product_title -%}
          <div class="accordion-content--title font-500 text-center">{{ settings.part_1_product_title | escape}}</div>
        {%- endif -%}
        <div class="flex accordion-content--specs-pic justify-center">
          {% render 'diff-end-img', picture_class: 'accordion-content--specs-pic-image ', pc_img: settings.part_1_img, mb_img: settings.part_1_img, pc_img_width: 550, mb_img_width: 300, class: 'specs-img' %}
          
          <ul>
            {%- for i in (0..19) -%}
              {%- assign key_index = 'part_1_product_desc_' | append: forloop.index -%}
              {%- if settings[key_index] != blank -%}
                <li class="jky-text-base">{{ settings[key_index] | escape}}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- elsif settings.part_1_img_2 -%}
        <div class="accordion-content--specs-more-main">
          {%- if settings.part_1_product_2_title -%}
            <div class="accordion-content--title font-500 text-center">{{ settings.part_1_product_2_title | escape}}</div>
          {%- endif -%}
          <div class="flex accordion-content--specs-pic justify-center">
            {%- render 'diff-end-img', picture_class: 'accordion-content--specs-pic-image ', pc_img: settings.part_1_img_2, mb_img: settings.part_1_img_2, pc_img_width: 550, mb_img_width: 300, class: 'specs-img' -%}
            <ul>
              {%- for i in (0..9) -%}
                {% assign key_index = 'part_1_product_2_desc_' | append: forloop.index %}
                {%- if settings[key_index] != blank -%}
                  <li class="jky-text-base">{{ settings[key_index] | escape}}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- elsif settings.part_1_img_3 -%}
        <div class="accordion-content--specs-more-main">
          {%- if settings.part_1_product_3_title -%}
            <div class="accordion-content--title font-500 text-center">{{ settings.part_1_product_3_title | escape}}</div>
          {%- endif -%}
          <div class="flex accordion-content--specs-pic justify-center">
            {% render 'diff-end-img', picture_class: 'accordion-content--specs-pic-image ', pc_img: settings.part_1_img_3, mb_img: settings.part_1_img_3, pc_img_width: 550, mb_img_width: 300, class: 'specs-img' %}
            <ul>
              {%- for i in (0..9) -%}
                {%- assign key_index = 'part_1_product_3_desc_' | append: forloop.index -%}
                {%- if settings[key_index] != blank -%}
                  <li class="jky-text-base">{{ settings[key_index] | escape}}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {% assign bundle_flag = false %}
    {%- if settings.part_1_img == blank and settings.part_1_img_2 == blank and settings.part_1_img_3 == blank -%}
      {% assign bundle_flag = true %}
    {%- endif -%}

    <div>
      {% comment %} 组合配件产品 {% endcomment %}
      {%- for i in (0..4) -%}
        {%- assign bundle_key_index = 'part_1_bundle_img_' | append: forloop.index -%}
        {%- assign bundle_title_index = 'part_1_bundle_title_' | append: forloop.index -%}

        {%- if settings[bundle_key_index] -%}
          <div class="accordion-content--specs-pic_bundles" {% if forloop.index == 1 and bundle_flag == true %}  style="margin-top: 0;padding-top: 0;border-top: none;" {{forloop.index  }} {% endif %}>
            <div data-w="{{ settings[bundle_key_index].width }}" class="block w-full relative mx-auto mb-4" style="--ratio: {{ 1 | divided_by: settings[bundle_key_index].aspect_ratio }};--max-width:{{settings[bundle_key_index].width}}px;width: min(100%, var(--max-width));padding-bottom: min(100% * {{ 1.00 | divided_by: settings[bundle_key_index].aspect_ratio }}, var(--max-width) * {{ 1.00 | divided_by: settings[bundle_key_index].aspect_ratio }});">
              {% render 'diff-end-img', pc_img: settings[bundle_key_index], mb_img: settings[bundle_key_index], pc_img_width: 1360, mb_img_width: 500, class: 'absolute top-0 left-0 w-full right-0 bottom-0' %}
            </div>
            {%- if settings[bundle_title_index] -%}
              <div class="accordion-content--title font-500 text-center">{{ settings[bundle_title_index] | escape}}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script type="module">
  document.addEventListener('DOMContentLoaded', function() {
    // 初始化产品轮播
    const productCarousels = document.querySelectorAll('.product-carousel-swiper');

    productCarousels.forEach((carousel, index) => {
      const anchor = carousel.closest('.product-carousel-container').dataset.anchor;
      const uniqueId = `product-carousel-${anchor}-${index}`;

      // 为每个轮播添加唯一ID
      carousel.setAttribute('id', uniqueId);

      // 使用模板写入的默认索引（指向 item == '1' 的位置）
      const slides = carousel.querySelectorAll('.swiper-slide');
      const defaultIndexAttr = carousel.getAttribute('data-default-index');
      const parsedDefault = defaultIndexAttr ? parseInt(defaultIndexAttr, 10) : 0;
      const initialIndex = Math.min(slides.length - 1, Math.max(0, isNaN(parsedDefault) ? 0 : parsedDefault));
      // 初始化Swiper
      const swiper = new Swiper(`#${uniqueId}`, {
        slidesPerView: 1,
        loopAdditionalSlides: 2,
        loop: true,
        autoplay: false,
        centeredSlides: true,
        initialSlide: initialIndex,
        navigation: {
          nextEl: `#${uniqueId} .icon-arrow-right`,
          prevEl: `#${uniqueId} .icon-arrow-left`,
        }
      });

      // 存储swiper实例以便后续销毁
      carousel.swiperInstance = swiper;
    });
  });

  // 页面卸载时销毁所有swiper实例
  window.addEventListener('beforeunload', function() {
    const productCarousels = document.querySelectorAll('.product-carousel-swiper');
    productCarousels.forEach(carousel => {
      if (carousel.swiperInstance) {
        carousel.swiperInstance.destroy(true, true);
      }
    });
  });
</script>
