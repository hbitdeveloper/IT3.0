{% comment %}
  Renders icon right arrow (左箭头图标 - <- )

  Accepts:
  - width: {Number} 宽度
  - height: {Number} 高度
  - color: {String} 填充颜色
  - class: {String} 样式类名

  Usage:
  {% render 'icon-v5-arrow-left', class: 'iconfont header__section_search zzl-tt', width: 22, height: 22, color:  %}
{% endcomment %}

<svg class="icon {{ class }}" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{width}} {{height}}" fill="none">
  <g>
    <path d="M28.5 20.25H16.2578" stroke="{{color}}" />
    <path d="M19.0078 14L12.7581 20.2498L19.0078 26.4995" stroke="{{color}}"/>
  </g>
</svg>
