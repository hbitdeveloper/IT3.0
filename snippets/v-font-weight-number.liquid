{% doc %}
  @description 字重换算，受历史数据原因 需要 换算字重，返回字重数字
  @param fw 字重
{% enddoc %}

{% comment %} 还是建议将历史数据 修改为对应数字 {% endcomment %}
{%- liquid
  assign fw = fw | default: blank
  if fw == blank or fw == 'jky-font-default'
    echo blank
  else
    case fw
      when 'font-black'
        echo '900'
      when 'font-extrabold'
        echo '800'
      when 'font-bold'
        echo '700'
      when 'font-semibold'
        echo '600'
      when 'font-medium'
        echo '500'
      when 'font-normal'
        echo '400'
      else
        echo blank
    endcase
  endif
-%}
