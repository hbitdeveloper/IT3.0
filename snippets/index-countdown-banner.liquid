<style>
    .count-down-banner{
        background-image: url({{ countdown.settings.pc_image | image_url }});
    }
    @media screen and (max-width: 1024px) {
        .count-down-banner{
            background-image: url({{ countdown.settings.mb_image | image_url }});
        }
    }
</style>

<div class="count-down-banner banner-{{countdown.settings.pc_position}} mb-{{ countdown.settings.mb_position }}" data-time="{{ countdown.settings.time | escape }}">
    <a 
        data-ga-event="home_page_banner4.0" 
        data-ga-action="click" 
        data-ga-params-module="{{ countdown.settings.title_main | strip_html }}" 
        data-ga-params-button_name="{{ countdown.settings.button_text }}"
        data-ga-params-link="{{ countdown.settings.link }}"
        data-ga-params-type="countdown_ban"
        target="{% if new_window %}_blank{% else %}_self{% endif %}" href="{{ countdown.settings.link }}">
        <div class="banner-container">
            <div class="content">
                {% assign titleColor = '<em style="color: ' | append: countdown.settings.title_main_color | append: '">' %}
                <div class="title">{{ countdown.settings.title_main | replace: '<em>', titleColor }}</div>
                {% assign subTitleColor = '<em style="color: ' | append: countdown.settings.sub_title_main_color | append: '">' %}
                <div class="sub-title">{{ countdown.settings.sub_title | replace: '<em>', subTitleColor }}</div>
                <div class="count-down">
                    <div class="time-content">
                        <div class="_days" style="background: {{ countdown.settings.bg_color }}; color: {{ countdown.settings.number_color }}"></div>
                        <span class="units" style="color: {{ countdown.settings.text_color }}">{{ countdown.settings.days }}</span>
                    </div>
                    <div class="colon" style="color: {{ countdown.settings.number_color }}">:</div>
                    <div class="time-content">
                        <div class="_hours" style="background: {{ countdown.settings.bg_color }}; color: {{ countdown.settings.number_color }}"></div>
                        <span class="units" style="color: {{ countdown.settings.text_color }}">{{ countdown.settings.hours }}</span>
                    </div>
                    <div class="colon" style="color: {{ countdown.settings.number_color }}">:</div>
                    <div class="time-content">
                        <div class="_mins" style="background: {{ countdown.settings.bg_color }}; color: {{ countdown.settings.number_color }}"></div>
                        <span class="units" style="color: {{ countdown.settings.text_color }}">{{ countdown.settings.mins }}</span>
                    </div>
                    <div class="colon" style="color: {{ countdown.settings.number_color }}">:</div>
                    <div class="time-content">
                        <div class="_secs" style="background: {{ countdown.settings.bg_color }}; color: {{ countdown.settings.number_color }}"></div>
                        <span class="units" style="color: {{ countdown.settings.text_color }}">{{ countdown.settings.secs }}</span>
                    </div>
                </div>
                
                {%- if countdown.settings.button_text != blank -%}
                    <button class="index-button" style="background: {{ countdown.settings.button_color }}">
                        <span>{{ countdown.settings.button_text | escape}}</span>
                        <div>
                            <div class="arrow">
                                <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                        <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                            <g transform="translate(672.000000, 286.000000)">
                                                <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                            </g>
                                        </g>
                                    </g>
                                </svg>
                            </div>
                        </div>
                    </button>
                {%- endif -%}
            </div>
            
        </div>
    </a>
</div>