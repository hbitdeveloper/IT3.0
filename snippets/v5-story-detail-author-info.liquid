<div class="w-full flex flex-col bg-[#F5F5F3] gap-y-5 px-4 py-6 lg:gap-y-7">
  <h2 class="font-semibold text-[#242F20] text-base lg:text-xl">{{ block.settings.title | newline_to_br }}</h2>
  <div class="flex justify-start gap-x-4 lg:gap-x-6">
    {%- if block.settings.author_image != blank -%}
      <div class="shrink-0 w-[6.125rem] h-[6.125rem] lg:w-[8.75rem] lg:h-[8.75rem] overflow-hidden">
        {%- render 'diff-end-img',
          class: 'w-full h-full object-contain',
          pc_img: block.settings.author_image,
          mb_img: block.settings.author_image,
          pc_img_width: 140,
          mb_img_width: 98
        -%}
      </div>
    {%- else -%}
      <div class="shrink-0 w-[6.125rem] h-[6.125rem] lg:w-[8.75rem] lg:h-[8.75rem] overflow-hidden">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-full h-full object-contain' }}
      </div>
    {%- endif -%}
    <div class="flex-1 flex flex-col justify-between lg:gap-y-10">
      <div class="flex flex-col gap-y-4 lg:gap-y-5">
        {%- if block.settings.author_name != blank -%}
          <h3 class="font-semibold text-black lg:text-[#242F20] text-[0.875rem] lg:text-[1.125rem] leading-none">{{ block.settings.author_name }}</h3>
        {%- endif -%}
        {% comment %} 标签 {% endcomment %}
        {%- if block.settings.tags != blank -%}
          <div class="w-full flex flex-wrap gap-4">
            {% assign tags = block.settings.tags | split: ',' %}
            {%- for tag in tags limit: 3 -%}
              <span class="flex items-center justify-center w-fit px-2.5 border border-solid border-[#242F20] text-[#242F20] h-7 font-normal text-sm lg:text-base">{{ tag | escape }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {%- if block.settings.author_description != blank -%}
        <div class="hidden lg:block text-[#242F20]/90 font-normal text-[0.875rem] lg:text-[1rem] leading-[1.1] pl-[1.125rem] relative before:absolute before:top-0 before:left-0 before:w-0.5 before:h-full before:bg-[#242F20]">
          {{ block.settings.author_description }}
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- if block.settings.author_description != blank -%}
    <div class="block lg:hidden text-[#242F20]/90 font-normal text-[0.875rem] lg:text-[1rem] leading-[1.1] pl-[1.125rem] relative before:absolute before:top-0 before:left-0 before:w-0.5 before:h-full before:bg-[#242F20]">
      {{ block.settings.author_description }}
    </div>
  {%- endif -%}
</div>
