<div
  class="five-kwh-media-box"
  anchor="{{ media.anchor_id  | url_decode | strip | replace: ' ', ''}}"
  style="background: {{ media.bgColor }};"
>
  <div class="five-main-container">
    {% assign titleColor = '<em style="color: ' | append: media.title_color | append: '">' %}
    <div class="title">
      {{ media.title | replace: '<em>', titleColor }}
    </div>
    {% assign subTitleColor = '<em style="color: ' | append: media.subtitle_color | append: '">' %}
    <div class="sub-title">
      {{ media.subtitle | replace: '<em>', subTitleColor }}
    </div>
    <div class="big-box">
      {% for i in (0..1) %}
        {% assign pc_img_index = 'pc_img_' | append: forloop.index %}
        {% assign mb_img_index = 'mb_img_' | append: forloop.index %}
        {% assign title_index = 'title_' | append: forloop.index %}
        {% assign title_color_index = 'title_color_' | append: forloop.index %}
        {% assign sub_title_index = 'sub_title_' | append: forloop.index %}
        {% assign sub_title_color_index = 'sub_title_color_' | append: forloop.index %}
        {% assign btn_index = 'btn_' | append: forloop.index %}
        {% assign btn_link_index = 'btn_link_' | append: forloop.index %}
        {%- if media[pc_img_index] -%}
          <div class="item-box">
            {% comment %} 视频展示 {% endcomment %}
            {% if media[pc_img_index] != blank %}
              <img
                src="{{ media[pc_img_index] | image_url: width: 600}}"
                alt="{{ media[pc_img_index].alt }}"
                class="show-image pc-block"
                loading="lazy"
              >
            {% endif %}
            {% if media[mb_img_index] != blank %}
              <img
                src="{{ media[mb_img_index] | image_url: width: 686}}"
                alt="{{ media[mb_img_index].alt }}"
                class="show-image mb-block"
                loading="lazy"
              >
            {%- elsif media[pc_img_index] != blank -%}
              <img
                src="{{ media[pc_img_index] | image_url: width: 600}}"
                alt="{{ media[pc_img_index].alt }}"
                class="show-image mb-block"
                loading="lazy"
              >
            {% endif %}
            <div class="text-box">
              {% assign titleColorItem = '<em style="color: ' | append: media[title_color_index] | append: '">' %}
              <div class="text-title">
                {{ media[title_index] | replace: '<em>', titleColorItem }}
              </div>
              {% assign subTitleColorItem = '<em style="color: '
                | append: media[sub_title_color_index]
                | append: '">'
              %}
              <div class="text-content">
                {{ media[sub_title_index] | replace: '<em>', subTitleColorItem }}
              </div>

              {%- if media[btn_index] != blank -%}
                <a
                  target="{% if new_window %}_blank{% else %}_self{% endif %}"
                  href="{{ media[btn_link_index] }}"
                >
                  <div>
                    <button
                      class="five-button"
                      style="background: {{ banner[button_color_right_index] }}"
                    >
                      <span class="ellipsis">{{ media[btn_index] }}</span>
                      <div>
                        <div class="arrow">
                          <svg
                            class="line"
                            width="20"
                            height="15"
                            viewBox="0 0 20 15"
                            version="1.1"
                            xmlns="http://www.w3.org/2000/svg"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                          >
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                    <g transform="translate(672.000000, 286.000000)">
                                        <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                    </g>
                                </g>
                            </g>
                          </svg>
                        </div>
                      </div>
                    </button>
                  </div>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {% endfor %}
    </div>
  </div>
</div>
