<div
  class="pyp-card"
  data-pyp-solar-setup
  data-pyp-open-auto-discount-price="{{ settings.open_auto_discount_price }}"
  data-pyp-product-title="{{ product.title | escape }}"
  data-pyp-error="{{ section.settings.solar_error | escape }}"
>
  <div class="mt-5 font-semibold text-base text-[#242F20] jky-ipad-text">
    {{ section.settings.solar_title }}
  </div>

  <div class="lg:mt-5 mt-4 flex flex-col lg:flex-row lg:items-stretch lg:gap-8 gap-6">
    <div class="flex-1 bg-[#FFFFFF] lg:px-10 lg:py-8 px-3 py-6 lg:self-stretch">
      <div class="grid grid-cols-1 lg:gap-10 gap-6">
        <div>
          <div class="font-semibold text-base text-[#242F20] jky-ipad-text">
            {{ section.settings.solar_choose_solar_label | escape }}
          </div>
          <div class="mt-4 pyp-dropdown border border-[#e8e8e5] border-solid" data-pyp-dropdown="energy">
            <div class="w-full flex items-center justify-between lg:h-12 h-11 px-4" data-pyp-dropdown-selected>
              <span class="font-normal text-base text-[rgba(0, 0, 0, 0.65)] line-clamp-1 leading-[1.4] jky-ipad-text" data-pyp-dropdown-label>
                {{ section.settings.solar_select_placeholder }}
              </span>
              {%- render 'icon-select' -%}
            </div>
            <div class="pyp-dropdown-menu" data-pyp-dropdown-list></div>
          </div>
        </div>

        <div>
          <div class="font-semibold text-base text-[#242F20] jky-ipad-text">
            {{ section.settings.solar_choose_panel_label | escape }}
          </div>
          <div class="mt-4 pyp-dropdown border border-[#e8e8e5] border-solid" data-pyp-dropdown="panel">
            <div  class="w-full flex items-center justify-between lg:h-12 h-11 px-4" data-pyp-dropdown-selected>
              <span class="font-normal text-base text-[rgba(0, 0, 0, 0.65)] line-clamp-1 leading-[1.4] jky-ipad-text" data-pyp-dropdown-label>
                {{ section.settings.solar_select_placeholder }}
              </span>
              {%- render 'icon-select' -%}
            </div>
            <div class="pyp-dropdown-menu" data-pyp-dropdown-list></div>
          </div>
        </div>

        <div>
          <div class="font-semibold text-base text-[#242F20] jky-ipad-text">
            {{ section.settings.solar_choose_num_label | escape }}
          </div>
          <div class="mt-4 flex flex-wrap gap-3" data-pyp-solar-num></div>
        </div>
      </div>

      {% comment %} 用来计算不展示 {% endcomment %}
      <button type="button" class="hidden" data-pyp-solar-calc>
        {{ section.settings.solar_calculate }}
      </button>
    </div>

    <div class="lg:w-[26rem] w-full bg-[#FFFFFF] px-5 py-4 lg:p-10 lg:self-stretch">
      <div data-pyp-solar-result-time>
        <div class="font-medium lg:text-base text-sm text-[#242F20]">
          {{ section.settings.solar_match }}
        </div>
        <div class="mt-6 mb-3 lg:my-4 font-bold leading-none">
          <span class="pyp-result-num text-5xl lg:text-7xl" data-pyp-solar-hours>0</span><span class="text-5xl lg:text-7xl">{{ section.settings.solar_hours }}</span>
        </div>
        {% if section.settings.solar_des != blank %}
          <p class="font-medium lg:text-base text-sm text-[rgba(0,0,0,0.65)]">
            {{ section.settings.solar_des }}
          </p>
        {% endif %}

        <div class="lg:mt-16 mt-8" data-pyp-solar-connector>
          <div class="font-medium text-sm lg:text-base text-[#242F20]">
            {{ section.settings.solar_part_title }}
          </div>
          <div class="mt-3" data-pyp-solar-product></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'section-pdp-calculator-plus-solar-setup.min.js' | asset_url }}" defer></script>
