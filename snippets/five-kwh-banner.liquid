<style>
  .five-kwh-banner-{{ index }} section {
    {% comment %} height: {{ banner.pc_height }}px; {% endcomment %}
  }

  @media screen and (min-width: 1024px) {
    .five-kwh-banner-{{ index }} section {
      {% comment %} height: {{ banner.pc_height }}px; {% endcomment %}
      height: auto;
      aspect-ratio: 1920 / {{ banner.pc_height }};
    }
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    {% comment %} .five-kwh-banner-{{ index }} section {
       height: calc(({{ banner.pc_height }}/1440)*100vw);
    } {% endcomment %}
  }

    @media screen and (max-width: 1024px) {
      .five-kwh-banner-{{ index }} section {
        height: calc(({{ banner.mb_height }}/750)*100vw);
      }
    }
</style>

<div
  class="five-kwh-banner five-kwh-banner-{{ index }} {% if banner.videoSrc != blank %}is-kwh-video{% else %}is-kwh-img{% endif %}"
  data-autoplay="{{ banner.autoplay }}"
  data-delay="{{ banner.swiperInterval }}"
  anchor="{{ banner.anchor_id  | url_decode | strip | replace: ' ', ''}}"
  data-initialized="false"
>
  <section class="w-screen">
    <div class="swiper-container autoplay-{{ banner.autoplay }}">
      {% if banner.videoSrc != blank %}
        <div class="swiper-wrapper video-wrapper">
          <svg
            class="icon-refresh"
            viewBox="0 0 90 90"
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
          >
            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
              <g>
                <circle fill="#000000" opacity="{{ iconOpacity }}" cx="45" cy="45" r="45"></circle>
                <path
                    d="M22.5,44.9151973 C22.5,47.9767459 23.0882118,50.8597042 24.2646355,53.5640722 C25.4410591,56.2684401 27.059555,58.6484297 29.1201231,60.7040409 C31.1806913,62.7596521 33.56642,64.3742545 36.2773092,65.5478482 C38.9881985,66.7214418 41.8781088,67.3082386 44.94704,67.3082386 C48.0013573,67.3082386 50.8839606,66.7214418 53.5948499,65.5478482 C56.3057391,64.3742545 58.6951213,62.7596521 60.7629964,60.7040409 C62.8308715,58.6484297 64.4493674,56.2684401 65.6184841,53.5640722 C66.7876008,50.8597042 67.3721591,47.9767459 67.3721591,44.9151973 C67.3721591,42.2326976 66.9118194,39.6777623 65.99114,37.2503917 C65.0704607,34.823021 63.7880858,32.6252664 62.1440155,30.657128 C60.4999452,28.6889896 58.5782097,27.0415849 56.3788089,25.7149138 C54.1794082,24.3882427 51.8009865,23.4697782 49.2435438,22.9595201 L49.2435438,19.8761032 C49.2435438,19.0596903 49.0097204,18.5567216 48.5420738,18.3671971 C48.0744271,18.1776727 47.5264037,18.3015925 46.8980035,18.7389566 L39.7956197,23.6593026 C39.2695172,24.0237727 39.0064659,24.4502027 39.0064659,24.9385926 C39.0064659,25.4269825 39.2695172,25.8534124 39.7956197,26.2178825 L46.8760825,31.1819649 C47.5044827,31.619329 48.0561597,31.7396041 48.5311133,31.5427903 C49.0060669,31.3459765 49.2435438,30.8466525 49.2435438,30.0448183 L49.2435438,26.9832697 C51.2894979,27.4497914 53.1746986,28.233402 54.8991456,29.3341016 C56.6235927,30.4348013 58.1215235,31.7833405 59.3929378,33.3797195 C60.6643522,34.9760984 61.6544479,36.7510677 62.3632249,38.7046272 C63.0720018,40.6581868 63.4263903,42.7283769 63.4263903,44.9151973 C63.4263903,47.4810666 62.9514367,49.8829244 62.0015294,52.1207707 C61.0516221,54.3586169 59.7290589,56.3194659 58.0338397,58.0033177 C56.3386205,59.6871694 54.3730431,61.0029064 52.1371075,61.9505286 C49.9011719,62.8981507 47.5044827,63.3719618 44.94704,63.3719618 C42.3749833,63.3719618 39.9673337,62.8981507 37.7240911,61.9505286 C35.4808485,61.0029064 33.5152711,59.6871694 31.8273589,58.0033177 C30.1394467,56.3194659 28.8168835,54.3586169 27.8596692,52.1207707 C26.902455,49.8829244 26.4238478,47.4810666 26.4238478,44.9151973 C26.4238478,42.8741649 26.7380479,40.9315394 27.3664481,39.0873208 C27.9948483,37.2431023 28.8753393,35.5592505 30.0079211,34.0357656 C31.1405029,32.5122807 29.1201231,29.3341016 26.873227,31.7833405 C24.6263309,34.2325794 24.418082,35.7086832 23.6508492,37.9392401 C22.8836164,40.1697969 22.5,42.495116 22.5,44.9151973 Z"
                    fill="#FFFFFF" fill-rule="nonzero"></path>
              </g>
            </g>
          </svg>

          {% comment %} PC Video {% endcomment %}
          {% for sources in banner.videoSrc.sources %}
            {% if sources.format == 'mp4' %}
              {% assign videoOriginalUrl = sources.url %}
              {% assign videoUrlArray = sources.url | split: '/' %}
              {% for word in videoUrlArray -%}
                {% if forloop.index == 9 and word != '' %}
                  {% assign videoOriginalUrl = 'https://cdn.shopify.com/videos/c/o/v/'
                    | append: word
                    | append: '.mp4'
                  %}
                {% endif %}
              {%- endfor %}

              <video
                class="lazy pc-h2"
                muted
                preload="metadata"
                playsinline
                width="100%"
                aria-label="{{ banner.videoSrc.alt }}"
                data-src="{{ videoOriginalUrl }}"
                poster="{{ banner.videoSrc.preview_image | image_size:'100%'}}"
              >
                <source src="{{ videoOriginalUrl }}" type="video/mp4">
              </video>
            {% endif %}
          {% endfor %}

          {% comment %} MB Video {% endcomment %}
          {% assign videoSrcMB = banner.videoSrcMB | default: banner.videoSrc %}
          {% for sources in videoSrcMB.sources  %}
            {% if sources.format == 'mp4' %}
              {% assign videoOriginalUrl = sources.url %}
              {% assign videoUrlArray = sources.url | split: '/' %}
              {% for word in videoUrlArray -%}
                {% if forloop.index == 9 and word != '' %}
                  {% assign videoOriginalUrl = 'https://cdn.shopify.com/videos/c/o/v/'
                    | append: word
                    | append: '.mp4'
                  %}
                {% endif %}
              {%- endfor %}

              <video
                class="lazy mb-h2"
                muted
                preload="metadata"
                playsinline
                width="100%"
                aria-label="{{ videoSrcMB.alt }}"
                data-src="{{ videoOriginalUrl }}"
                poster="{{ videoSrcMB.preview_image | image_size:'100%'}}"
              >
                <source src="{{ videoOriginalUrl }}" type="video/mp4">
              </video>
            {% endif %}
          {% endfor %}
          {% if banner.videoSrcPoster != blank %}
            <img
            src="{{ banner.videoSrcPoster | image_url: width: 1920}}"
            alt="{{ banner.videoSrcPoster.alt }}"
            class="banner-image is-show"
            loading="lazy"
          >
          {% endif %}
          {% if banner.videoSrcPosterMB != blank %}
            <img
            src="{{ banner.videoSrcPosterMB | image_url: width: 750}}"
            alt="{{ banner.videoSrcPosterMB.alt }}"
            class="banner-image is-show-mb"
            loading="lazy"
          >
          {% endif %}

          <div class="absolute-box">
            <div class="title-box banner-{{ banner.pc_position_video}} mb-{{ banner.mb_position_video }}">
              <div class="mini-title">
                {% assign titleColor = '<em style="color: ' | append: banner.title_main_color_video | append: '">' %}
                <div class="pc-h2 banner-title">
                  {% if banner.title_video != blank %}
                    {{ banner.title_video | replace: '<em>', titleColor }}
                  {% elsif banner.title_mb_video != blank %}
                    {{ banner.title_mb_video | replace: '<em>', titleColor }}
                  {% endif %}
                </div>

                <div class="mb-h2 banner-title">
                  {% if banner.title_mb_video != blank %}
                    {{ banner.title_mb_video | replace: '<em>', titleColor }}
                  {% elsif banner.title_video != blank %}
                    {{ banner.title_video | replace: '<em>', titleColor }}
                  {% endif %}
                </div>

                {% assign subTitleColor = '<em style="color: '
                  | append: banner.sub_title_main_color_video
                  | append: '">'
                %}
                <div class="sub-title">
                  {{ banner.sub_title_video | replace: '<em>', subTitleColor }}
                </div>
                <div class="two-btn">
                  {%- if banner.button_text_video != blank -%}
                    <a
                      data-ga-event="5000plus_page_user_clicks"
                      data-ga-action="click"
                      data-ga-params-module="TopBanner"
                      data-ga-params-title="{{ banner.title_video | strip_html }}"
                      data-ga-params-button_name="{{ banner.button_text_video }}"
                      data-ga-params-link="{{ banner.button_link_video }}"
                      data-ga-params-type="{% if banner.button_text_right_video != blank %}button_two{% else %}button_one{% endif %}"
                      target="{% if new_window %}_blank{% else %}_self{% endif %}"
                      href="{{ banner.button_link_video }}"
                    >
                      <div>
                        <button class="five-button" style="background: {{ banner.button_color_video }}">
                          <span class="ellipsis">{{ banner.button_text_video }}</span>
                          <div>
                            <div class="arrow">
                              <svg
                                class="line"
                                width="20"
                                height="15"
                                viewBox="0 0 20 15"
                                version="1.1"
                                xmlns="http://www.w3.org/2000/svg"
                                xmlns:xlink="http://www.w3.org/1999/xlink"
                              >
                                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                        <g transform="translate(672.000000, 286.000000)">
                                            <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                        </g>
                                    </g>
                                </g>
                              </svg>
                            </div>
                          </div>
                        </button>
                      </div>
                    </a>
                  {%- endif -%}

                  {%- if banner.button_text_right_video != blank -%}
                    <a
                      data-ga-event="5000plus_page_user_clicks"
                      data-ga-action="click"
                      data-ga-params-module="TopBanner"
                      data-ga-params-title="{{ banner.title_video | strip_html }}"
                      data-ga-params-button_name="{{ banner.button_text_right_video }}"
                      data-ga-params-link="{{ banner.button_link_right_video }}"
                      data-ga-params-type="{% if banner.button_text_right_video != blank %}button_two{% else %}button_one{% endif %}"
                      target="{% if new_window %}_blank{% else %}_self{% endif %}"
                      href="{{ banner.button_link_right_video }}"
                    >
                      <div class="btn-right">
                        <button class="five-button" style="background: {{ banner.button_color_right_video }}">
                          <span class="ellipsis">{{ banner.button_text_right_video }}</span>
                          <div>
                            <div class="arrow">
                              <svg
                                class="line"
                                width="20"
                                height="15"
                                viewBox="0 0 20 15"
                                version="1.1"
                                xmlns="http://www.w3.org/2000/svg"
                                xmlns:xlink="http://www.w3.org/1999/xlink"
                              >
                                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                        <g transform="translate(672.000000, 286.000000)">
                                            <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                        </g>
                                    </g>
                                </g>
                              </svg>
                            </div>
                          </div>
                        </button>
                      </div>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>

          <div class="absolute-box-new">
            <div class="five-main-container">
              {% assign bottomTitleColor = '<em style="color: ' | append: banner.bottom_text_color | append: '">' %}
                <div class="pc-h2 bottom-title ">
                    {% if banner.bottom_text != blank %}
                      {{ banner.bottom_text | replace: '<em>', bottomTitleColor }}
                    {% elsif banner.bottom_text_mb != blank %}
                      {{ banner.bottom_text_mb | replace: '<em>', bottomTitleColor }}
                    {% endif %}
                </div>

                  <div class="mb-h2 bottom-title five-main-container">
                      {% if banner.bottom_text_mb != blank %}
                        {{ banner.bottom_text_mb | replace: '<em>', bottomTitleColor }}
                      {% elsif banner.bottom_text != blank %}
                        {{ banner.bottom_text | replace: '<em>', bottomTitleColor }}
                      {% endif %}
                  </div>
            </div>

          </div>
        </div>

      {% else %}
      {%- assign sizes = 0 -%}

        <div class="swiper-wrapper">
          {% for i in (0..4) %}
            {% assign pc_image_index = 'pc_image_' | append: forloop.index %}
            {% assign mb_image_index = 'mb_image_' | append: forloop.index %}
            {% assign pc_height_index = 'pc_height_' | append: forloop.index %}
            {% assign mb_height_index = 'mb_height_' | append: forloop.index %}
            {% assign pc_position_index = 'pc_position_' | append: forloop.index %}
            {% assign mb_position_index = 'mb_position_' | append: forloop.index %}
            {% assign title_index = 'title_' | append: forloop.index %}
            {% assign title_mb_index = 'title_mb_' | append: forloop.index %}
            {% assign title_main_color_index = 'title_main_color_' | append: forloop.index %}
            {% assign sub_title_index = 'sub_title_' | append: forloop.index %}
            {% assign sub_title_mb_index = 'sub_title_mb_' | append: forloop.index %}
            {% assign sub_title_main_color_index = 'sub_title_main_color_' | append: forloop.index %}
            {% assign btn_to_login = 'btn_to_login_' | append: forloop.index %}
            {% assign button_text_index = 'button_text_' | append: forloop.index %}
            {% assign button_link_index = 'button_link_' | append: forloop.index %}
            {% assign button_color_index = 'button_color_' | append: forloop.index %}
            {% assign button_text_right_index = 'button_text_right_' | append: forloop.index %}
            {% assign button_link_right_index = 'button_link_right_' | append: forloop.index %}
            {% assign button_color_right_index = 'button_color_right_' | append: forloop.index %}
            {%- if banner[pc_image_index] -%}
              {%- assign sizes = sizes | plus: 1 -%}
              <div class="swiper-slide overflow-hidden">
                <div class="slide-inner flex ">
                  <a
                    data-ga-event="5000plus_page_user_clicks"
                    data-ga-action="click"
                    data-ga-params-module="TopBanner"
                    data-ga-params-title="{{ banner[title_index] | strip_html }}"
                    data-ga-params-link="{{ banner[button_link_index] }}"
                    data-ga-params-type="picture"
                    data-ga-params-url="{{ banner[pc_image_index] }}"
                    href="{% if banner[button_text_index] != blank or banner[button_link_index] == blank %}javascript:void(0);{% else %}{{banner[button_link_index]}}{% endif %}"
                    {% if banner[button_text_index] != blank or banner[button_link_index] == blank%}style="cursor: default;"{% endif %}
                    target="{% if banner[button_text_index] != blank or banner[button_link_index] == blank %}_self{% else %}_blank{% endif %}"
                    >
                    <div class="general-img-box">
                      {%- assign img_url = banner[pc_image_index]  | image_url: width: 1920 -%}
                      {%- assign m_img_url = banner[mb_image_index] | image_url: width: 750 -%}
                      {% if index == 1 %}
                        <picture>
                          <source media="(min-width: 1024px)" srcset="{{img_url}}">
                          <source media="(max-width:1023.98px)" srcset="{{m_img_url}}">
                          <img class="general-img" alt="{{ general.settings.pc_image.alt | default: general.settings.mb_image.alt }}" src="{{ img_url }}"  fetchpriority="high" loading="eager">
                        </picture>
                      {% else %}
                          {%- render 'diff-end-img', class:'general-img', pc_img: banner[pc_image_index],  mb_img: banner[mb_image_index], pc_img_width: 1920, mb_img_width: 750 -%}
                      {% endif %}
                    </div>
                    <div class="absolute-box">
                      <div class="title-box banner-{{ banner[pc_position_index]}} mb-{{ banner[mb_position_index] }}">
                        <div class="mini-title">
                          {% assign titleColor = '<em style="color: '
                            | append: banner[title_main_color_index]
                            | append: '">'
                          %}
                          <div class="pc-h2 regular-animate banner-title {% if settings.jky_theme_version != 'v4' %}v5-font-oxm{% endif %}">
                            {% if banner[title_index] != blank %}
                              {{ banner[title_index] | replace: '<em>', titleColor }}
                            {% elsif banner[title_mb_index] != blank %}
                              {{ banner[title_mb_index] | replace: '<em>', titleColor }}
                            {% endif %}
                          </div>

                          <div class="mb-h2 regular-animate banner-title {% if settings.jky_theme_version != 'v4' %}v5-font-oxm{% endif %}">
                            {% if banner[title_mb_index] != blank %}
                              {{ banner[title_mb_index] | replace: '<em>', titleColor }}
                            {% elsif banner[title_index] != blank %}
                              {{ banner[title_index] | replace: '<em>', titleColor }}
                            {% endif %}
                          </div>

                          {% assign subTitleColor = '<em style="color: '
                            | append: banner[sub_title_main_color_index]
                            | append: '">'
                          %}
                          <div class="pc-h2 sub-title regular-animate">
                            {% if banner[sub_title_index] != blank %}
                              {{ banner[sub_title_index] | replace: '<em>', subTitleColor }}
                            {% elsif banner[sub_title_mb_index] != blank %}
                              {{ banner[sub_title_mb_index] | replace: '<em>', subTitleColor }}
                            {% endif %}
                          </div>
                          <div class="mb-h2 sub-title regular-animate">
                            {% if banner[sub_title_mb_index] != blank %}
                              {{ banner[sub_title_mb_index] | replace: '<em>', subTitleColor }}
                            {% elsif banner[sub_title_index] != blank %}
                              {{ banner[sub_title_index] | replace: '<em>', subTitleColor }}
                            {% endif %}
                          </div>
                          <div class="two-btn">
                              {% if banner[btn_to_login] == true and customer.id != blank %}
                                {% assign hideFirstBtn = true %}
                              {% else %}
                                {% assign hideFirstBtn = false %}
                              {% endif %}

                              {%- if banner[button_text_index] != blank and hideFirstBtn == false -%}
                                  <a
                                          data-ga-event="5000plus_page_user_clicks"
                                          data-ga-action="click"
                                          data-ga-params-module="TopBanner"
                                          data-ga-params-title="{{ banner[title_index] | strip_html }}"
                                          data-ga-params-button_name="{{ banner[button_text_index] }}"
                                          data-ga-params-link="{{ banner[button_link_index] }}"
                                          data-ga-params-type="{% if banner[button_text_right_index] != blank %}button_two{% else %}button_one{% endif %}"
                                          target="{% if new_window %}_blank{% else %}_self{% endif %}"
                                          href="{{ banner[button_link_index] }}"
                                          data-btn-to-login="{{ banner[btn_to_login]}}"
                                  >
                                      <div class="regular-animate">
                                          <button class="five-button"
                                                  style="background: {{ banner[button_color_index] }}">
                                              <span class="ellipsis">{{ banner[button_text_index] }}</span>
                                              <div>
                                                  <div class="arrow">
                                                      <svg
                                                              class="line"
                                                              width="20"
                                                              height="15"
                                                              viewBox="0 0 20 15"
                                                              version="1.1"
                                                              xmlns="http://www.w3.org/2000/svg"
                                                              xmlns:xlink="http://www.w3.org/1999/xlink"
                                                      >
                                                          <g stroke="none" stroke-width="1" fill="none"
                                                             fill-rule="evenodd">
                                                              <g
                                                                 transform="translate(-694.000000, -311.000000)"
                                                                 fill="#FFFFFF" fill-rule="nonzero">
                                                                  <g transform="translate(672.000000, 286.000000)">
                                                                      <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                                                  </g>
                                                              </g>
                                                          </g>
                                                      </svg>
                                                  </div>
                                              </div>
                                          </button>
                                      </div>
                                  </a>
                              {%- endif -%}

                              {%- if banner[button_text_right_index] != blank -%}
                                  <a
                                          data-ga-event="5000plus_page_user_clicks"
                                          data-ga-action="click"
                                          data-ga-params-module="TopBanner"
                                          data-ga-params-title="{{ banner[title_index] | strip_html }}"
                                          data-ga-params-button_name="{{ banner[button_text_right_index] }}"
                                          data-ga-params-link="{{ banner[button_link_right_index] }}"
                                          data-ga-params-type="{% if banner[button_text_right_index] != blank %}button_two{% else %}button_one{% endif %}"
                                          target="{% if new_window %}_blank{% else %}_self{% endif %}"
                                          href="{{ banner[button_link_right_index] }}"
                                  >
                                      <div class="regular-animate btn-right">
                                          <button
                                                  class="five-button"
                                                  style="background: {{ banner[button_color_right_index] }}"
                                          >
                                              <span class="ellipsis">{{ banner[button_text_right_index] }}</span>
                                              <div>
                                                  <div class="arrow">
                                                      <svg
                                                              class="line"
                                                              width="20"
                                                              height="15"
                                                              viewBox="0 0 20 15"
                                                              version="1.1"
                                                              xmlns="http://www.w3.org/2000/svg"
                                                              xmlns:xlink="http://www.w3.org/1999/xlink"
                                                      >
                                                          <g stroke="none" stroke-width="1" fill="none"
                                                             fill-rule="evenodd">
                                                              <g
                                                                 transform="translate(-694.000000, -311.000000)"
                                                                 fill="#FFFFFF" fill-rule="nonzero">
                                                                  <g
                                                                     transform="translate(672.000000, 286.000000)">
                                                                      <polygon
                                                                               points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                                                  </g>
                                                              </g>
                                                          </g>
                                                      </svg>
                                                  </div>
                                              </div>
                                          </button>
                                      </div>
                                  </a>
                              {%- endif -%}
                          </div>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              </div>
            {%- endif -%}
          {% endfor %}
        </div>
      {% endif %}

      {% if banner.videoSrc == blank and sizes > 1 %}
        <div class="swiper-arrow swiper-button-next"></div>
        <div class="swiper-arrow swiper-button-prev"></div>
        <div class="slideshow-pagination"></div>
      {% endif %}
    </div>
  </section>
</div>
