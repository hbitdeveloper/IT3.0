{% assign container_class = container_class | default: 'relative w-full mx-auto h-full' %}

<div class="flash-line-container overflow-hidden {{ container_class }}" style="--line_bg: {{ line_bg | default: '#FFFFFF' }};--line_height: {{ line_height | default: '5rem' }};--duration: {{ duration | default: 3 }}s;">
    <div class="flash-line absolute bottom-0 left-0 w-full"></div>
</div>
