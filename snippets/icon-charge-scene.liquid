{% doc %}
  说明：图标场景 历史数据兼容转换
  参数：
    value：图标名称
    class：图标类名
{% enddoc %}

{% liquid
  assign value = value | default: ''
  assign class = class | default: ''
%}

{% case value %}
  {% when 'jackery-icon-icon-wall-charging' %}
    {% render 'icon-wall-charging', class: class %}
  {% when 'jackery-icon-icon-car-charging' %}
    {% render 'icon-car-charging', class: class %}
  {% when 'jackery-icon-icon-solar-charging' %}
    {% render 'icon-solar-charging', class: class %}
  {% when 'jackery-icon-a-QuickCharging' %}
    {% render 'icon-quick-charging', class: class %}
{% endcase %}
