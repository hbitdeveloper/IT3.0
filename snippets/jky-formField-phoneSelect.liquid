{% comment %} ex-form.css {% endcomment %}
{% assign placeholder_text = '' %}
{% if placeholder_enable != false and placeholder_enable != 'false' %}
  {% assign placeholder_text = 'newsletter.phone_placeholder' | t %}
{% endif %}
<jky-phoneselect class="jky-phoneselect_{{id}} jky-phoneselect" data-iso="" data-cr="" data-value="">
    <div class="form-item form-item_phone_select form-item_phone_select_{{id}} flex">
        {%- if key != blank -%}
        <label for="{{value | handleize}}">{{key}}</label>
        {%- endif -%}
        {% comment %} 以下 data-value 用于向后端传值 {% endcomment %}
        <input 
            type="tel"
            id="{{value | handleize}}" 
            name="{{value | handleize}}" 
            maxlength="50" 
            data-error="{{error_text | escape}}"
            data-value="{{value | escape}}"
            placeholder="{{ placeholder_text }}"
        />
        <details-disclosure>
            <details id="Details-phone_select">
                <summary 
                    class="phone_select_prefix list-menu__item link focus-inset" 
                    role="button" aria-controls="HeaderMenu-MenuList-user" aria-expanded="false"
                >
                    <img width="32" height="32" class="phone_select_prefix_flag" src="https://cdn.shopify.com/static/images/flags/us.svg?width=32" alt="country-flag" loading="lazy">
                    <span class="phone_select_prefix_country">US</span>
                    <div class="select-arror">
                        <jds-icon name="arrow-down"></jds-icon>
                    </div>
                    <span class="phone_select_prefix_code">86</span>
                </summary>
                <ul class="list-menu list-menu--disclosure caption-large motion-reduce" tabindex="-1">
                    <div class="phone_select_search_wrapper">
                        <input style="color: #333;" type="text" placeholder="Enter keyword">
                    </div>

                    <div class="phone_select_country_container"></div>
                </ul>
                <div class="jky-overlay" style="z-index: 2025;"></div>
            </details>
        </details-disclosure>
    </div>
</jky-phoneselect>