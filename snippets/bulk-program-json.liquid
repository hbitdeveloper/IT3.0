<script type="application/ld+json" id="bulk-program-products">
  [
    {%- for block in bulk_program -%}
      {%- assign block_handle = block.title | handleize -%}
      {%- assign block_title = block.title | escape -%}
      {
        "type": {{ block_handle | json }},
        "title": {{ block_title | json }},
        "is_tailor": {{ block.is_tailor | default: false }},
        {%- capture products -%}
            [
            {%- for item in block.items.value -%}
                {%- assign product = item.product.value -%}
                {%- if product.available -%}
                {%- assign current_variant = product.variants | where: "available", true | where: "sku", item.sku | first -%}
                {%- unless current_variant -%}
                    {%- assign current_variant = product.selected_or_first_available_variant -%}
                {%- endunless -%}

                {%- assign image = current_variant.featured_image | default: product.featured_image -%}
                {%- assign main_image = image | image_url: width: 520 -%}


                {
                    "id": {{ current_variant.id | json }},
                    "sku": {{ item.sku | default: "" | json }},
                    "title": {{ item.title | escape | json }},
                    "price": {{ current_variant.price | json }},
                    "formatPrice": {{ current_variant.price | money | json }},
                    "url": {{ product.url | json }},
                    "inventory_quantity": {{ current_variant.inventory_quantity | json }},
                    "image": {{ main_image | json }},
                    "images": [
                    {%- if product.variants.size == 1 -%}
                        {%- for img in product.images -%}
                        {{ img | image_url: width: 340 | json }}
                        {%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                    {%- else -%}
                        {{ image | image_url: width: 340 | json }}
                    {%- endif -%}
                    ],
                    "productId": {{ product.id | json }},
                    "barcode": {{ current_variant.barcode | default: "" | json }},
                    "discountList": [
                    {%- for discount in item.discount.value -%}
                        {%- assign discount_multiplier = 100 | minus: discount.value | times: 0.01 -%}
                        {%- assign discounted_price = current_variant.price | times: discount_multiplier -%}
                        {
                        "quantity": {{ discount.quantity | json }},
                        "value": {{ discount.value | json }},
                        "price": {{ discounted_price | round | json }},
                        "formatPrice": {{ discounted_price | money | json }}
                        }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                    ]
                }{%- unless forloop.last -%},{%- endunless -%}
                {%- endif -%}
            {%- endfor -%}
            ]
        {%- endcapture -%}
        "products": {{ products | replace: ',]', ']'}}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>
