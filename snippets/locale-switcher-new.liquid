{% comment %} IP定位 {% endcomment %}
<jky-locale-switcher class="hidden">
  <div class="locale-switcher">
    <div class="header-container">
      <div class="locale-switcher--text"></div>
      <div class="locale-switcher--contain">
        <div class="locale-switcher--selector">
          <div class="locale-switcher--selected">
            <span class="locale-switcher--value" value="">
              <span class="icon">
                <jds-icon name="check" class="icon-check align-middle"></jds-icon>
              </span>
              <span class="text"></span>
            </span>
            <jds-icon name="arrow-down" class="icon-arrow-down"></jds-icon>
          </div>
          <ul class="locale-switcher--ul"></ul>
        </div>
        <div class="locale-switcher--button"></div>
        <div class="locale-switcher--close">
          <svg fill="#888888" viewBox="0 0 24 24" stroke-width="1.5" width="18" height="18" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</jky-locale-switcher>

<script src="{{ 'plugins-locale-switcher.min.js' | asset_url }}" defer></script>
