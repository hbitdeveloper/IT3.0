{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}

{% comment %} 全局开关 {% endcomment %}
{%- if settings.open_products_recommend -%}
  {% capture recommend_root_id %}app-recommend-products-{{ section.id }}-{{ block.id }}{% endcapture %}
  {% assign recommend_root_selector = '#' | append: recommend_root_id %}
  <div id="{{ recommend_root_id }}">
    <jky-v5-app-recommend-products
      data-product-title="{{ product.title | escape }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-sku-card-bg="#FFFFFF"
      data-open-auto-discount-price="{{ settings.open_auto_discount_price}}"
      data-discount-tag-display-style="{{ settings.discount_tag_display_style}}"
      data-discount-amount-display-style="{{ settings.discount_amount_display_style}}"
      data-discount-percent-display-style="{{ settings.discount_percent_display_style}}"
      class="block relative max-w-full w-screen mx-auto section-padding"
      style="{{ style }}"
    ></jky-v5-app-recommend-products>
  </div>
  {% render 'lazy-load-asset-group',
    script: 'snippet-v5-app-recommend-products.min.js',
    style: 'snippet-v5-app-recommend-products.min.css',
    strategy: 'visible',
    root_selector: recommend_root_selector
  %}
{%- endif -%}
