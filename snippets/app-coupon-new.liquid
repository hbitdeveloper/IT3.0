{% comment %}
    产品详情页 - 新优惠券
    Accepts: product
    Usage: {% render 'app-coupon-new' %}
{% endcomment %}

{% comment %} open_coupon_new {% endcomment %}
{%- if settings.open_coupon_new == true -%}
  {% assign current_variant = product.selected_or_first_available_variant %}
  {% assign auto_applied = 'products.product.auto_applied' | t %}

  <div class="w-full product-coupon-new-wrap" style="display:none;" {{ block.shopify_attributes }}>
    <div
      id="app-coupon-new"
      data-product-title="{{ product.title | escape }}"
      data-variant-id="{{ current_variant.id }}"
      data-variant-price="{{ current_variant.price }}"
      data-off-text="{{ block.settings.off_text }}"
      data-code-text="{{ block.settings.code_text }}"
      data-ends-in-text="{{ block.settings.ends_in_text }}"
      data-copy-and-use-text="{{ block.settings.copy_and_use_text }}"
      data-code-copy-success-text="{{ block.settings.code_copy_success_text }}"
      data-coupon-rules-richtext-text="{{ block.settings.coupon_rules_richtext_text | escape }}"
      data-coupon-auto-applied="{{ auto_applied }}"
    ></div>

    {{ 'plugin-app-coupon-new.min.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'plugin-app-coupon-new.min.js' | asset_url }}" defer></script>
  </div>
{% endif %}
