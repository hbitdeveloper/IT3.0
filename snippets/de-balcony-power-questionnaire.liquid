<script type="module">
    document.addEventListener('DOMContentLoaded', function() {
        const checkQuestions = () => {
            let allAnswered = true;
            $('.de-balcony-power-questionnaire .question').each(function () {
                if ($(this).find('.selected').length === 0 && $(this).find('.option-btn.disable').length === 0) {
                    allAnswered = false;
                    return false;
                }
            });
            if (allAnswered) {
                $('.de-balcony-power-questionnaire .submit').removeClass('disable');
            } else {
                $('.de-balcony-power-questionnaire .submit').addClass('disable');
            }
        };
        // Custom dropdown toggle
        $('.de-balcony-power-questionnaire .select.option-btn').on('click', function (e) {
            if ($(this).hasClass("active")) {
                $(this).removeClass("active");
            } else {
                $(this).addClass("active");
            }
            var $selections = $(this).siblings('.selections');
            // Close other open dropdowns
            $('.de-balcony-power-questionnaire .selections').not($selections).slideUp(100);
            $selections.slideToggle(100);
        });
        // Dropdown option click
        $('.de-balcony-power-questionnaire .selections .option-item').on('click', function () {
            var value = $(this).text();
            var $question = $(this).closest('.question');
            $question.find('.select.option-btn').text(value).addClass('selected');
            // Highlight selected option
            $(this).addClass('selected').siblings().removeClass('selected');
            $question.find('.selections').slideUp(100);
            checkQuestions();
        });
        // Close dropdown if clicking outside
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.de-balcony-power-questionnaire .select').length) {
                $('.de-balcony-power-questionnaire .selections').slideUp(100);
                $('.de-balcony-power-questionnaire .select').removeClass("active")
            }
        });
        // Standard button selection for other questions
        $('.de-balcony-power-questionnaire .question .options .option-btn').on('click', function () {
            $(this).closest('.question').find('.options .option-btn').removeClass('selected');
            $(this).addClass('selected');
            if ($(this).parent().hasClass("third")) {
                let options = $(this).parent().parent().next().find('.option-btn');
                if ($(this).text() === 'Nein') {
                    options.removeClass('selected');
                    options.addClass('disable');
                } else {
                    options.removeClass('disable');
                }
            }
            checkQuestions();
        });
        // Show modal on submit button click if all questions are answered
        $('.de-balcony-power-questionnaire .submit').on('click', function () {
            let fourthQuestionAnsweredNo = false;
            let fifthQuestionAnsweredNo = false;
            $('.de-balcony-power-questionnaire .question').each(function (index) {
                const selectedAnswer = $(this).find('.selected').text();
                if (index === 3) {
                    if ($(this).find('.option-btn.disable').length > 0 || selectedAnswer === 'Nein') {
                        fourthQuestionAnsweredNo = true;
                    }
                }
                if (index === 4) {
                    if (selectedAnswer === 'Nein') {
                        fifthQuestionAnsweredNo = true;
                    }
                }
            });
            let showNoModal = fourthQuestionAnsweredNo && fifthQuestionAnsweredNo;
            $('body').addClass('no-scroll');
            $('.overlay').fadeIn(300);
            if (showNoModal) {
                $('.de-balcony-power-questionnaire .modal.yes').hide();
                $('.de-balcony-power-questionnaire .modal.no').show();
            } else {
                $('.de-balcony-power-questionnaire .modal.yes').show();
                $('.de-balcony-power-questionnaire .modal.no').hide();
            }
        });
        // Close modal on close button click
        $('.de-balcony-power-questionnaire .overlay .close').on('click', function () {
            $('.overlay').fadeOut(300);
            $('body').removeClass('no-scroll');
        });
    });
</script>
