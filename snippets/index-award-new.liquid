<style>
  .index-awards-new {
    background-image: url({{ award.pc_image | image_url:width: 1920}});
  }

  .index-awards-new .new-main-container{
        width: 1440px;
        margin: 0 auto;
    }
  @media screen and (max-width: 1024px) {
    .index-awards-new {
      background-image: url({{ award.mb_image | image_url:width: 750 }});
    }
  }
  .index-awards-new .mb-pagination{
        display: none;
    }

  .index-button {
    --index-button-p: 10px 0 10px 32px;
    --index-button-hover-p: 7px 7px 7px 16px;
    --index-button-r: 28px;
    --index-button-text: 18px;
    --index-button-h: 48px;
    --index-arrow-w: 0;
    --index-arrow-h: 0;
    --index-arrow-r: 28px;
    --index-arrow-ml: 9px;
    --index-arrow-svg-w: 14px;
    --index-arrow-hover-w: 32px;
    --index-arrow-hover-h: 32px;
    padding: var(--index-button-p);
    border-radius: var(--index-button-r);
    font-size: var(--index-button-text);
    color: #ffffff;
    display: flex;
    align-items: center;
    background: var(--primary-color);
    height: var(--index-button-h);
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.8, 0, 0.2, 1);
  }
  .index-button > div {
    overflow: hidden;
  }
  .index-button > div .arrow {
    width: var(--index-arrow-hover-w);
    height: var(--index-arrow-hover-h);
    border-radius: var(--index-arrow-r);
    background: #fd7333;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.8, 0, 0.2, 1);
    display: flex;
    transform: scale(0);
  }
  .index-button > div .arrow svg {
    transform: translateX(calc(0px - var(--index-arrow-svg-w)));
    width: var(--index-arrow-svg-w);
    transition: all 0.4s cubic-bezier(0.8, 0, 0.2, 1);
  }
  .index-button:hover {
    padding: var(--index-button-hover-p);
  }
  .index-button:hover > div {
    overflow: inherit;
  }
  .index-button:hover > div .arrow {
    margin-left: var(--index-arrow-ml);
    transform: scale(1);
  }
  .index-button:hover > div .arrow svg {
    transform: translateX(0);
  }
  .index-button:active {
    background: #d25424;
  }

  .index-awards-new {
    --awards-m: 72px 0;
    --i-awards-h: 640px;
    --awards-pl: 96px;
    --awards-h: 640px;
    --awards-l-w: 300px;
    --awards-l-title: 32px;
    --awards-l-lh: 40px;
    --awards-l-pb: 18px;
    --awards-l-sub: 16px;
    --awards-l-sub-lh: 24px;
    --awards-l-sub-mb: 32px;
    --awards-r-w: 980px;
    --awards-l-h: 384px;
    --awards-r-img-r: 12px;
    background-size: cover;
    height: var(--i-awards-h);
    margin: var(--awards-m);
  }
  .index-awards-new .awards {
    position: relative;
    padding-left: var(--awards-pl);
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--awards-h);
  }
  .index-awards-new .awards .content {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .index-awards-new .awards .content .left {
    width: var(--awards-l-w);
    color: #fff;
  }
  .index-awards-new .awards .content .left .title {
    line-height: var(--awards-l-lh);
    padding-bottom: var(--awards-l-pb);
    overflow: hidden;
  }
  .index-awards-new .awards .content .left .title span {
    font-weight: 600;
    font-size: var(--awards-l-title);
    display: inline-block;
  }
  .index-awards-new .awards .content .left .sub-title {
    font-size: var(--awards-l-sub);
    line-height: var(--awards-l-sub-lh);
    margin-bottom: var(--awards-l-sub-mb);
  }
  .index-awards-new .awards .content .right {
    width: var(--awards-r-w);
  }
  .index-awards-new .awards .content .right .awards-swiper .swiper-wrapper {
    -webkit-transition-timing-function: linear;
    /*之前是ease-out*/
    -moz-transition-timing-function: linear;
    -ms-transition-timing-function: linear;
    -o-transition-timing-function: linear;
    transition-timing-function: linear;
  }
  .index-awards-new .awards .content .right .awards-swiper .awards-pagination {
    display: none;
  }
  .index-awards-new .awards .content .right .awards-swiper .swiper-slide img {
    width: 100%;
    object-fit: cover;
    height: var(--awards-l-h);
    border-radius: var(--awards-r-img-r);
  }
  @media screen and (max-width: 1440px) {
    .index-awards-new .new-main-container{
        width: 100vw;
    }
    .index-button {
      --index-button-p: 0.694444444444444vw 0 0.694444444444444vw 2.22222222222222vw;
      --index-button-hover-p: 0.486111111111111vw 0.486111111111111vw 0.486111111111111vw 1.11111111111111vw;
      --index-button-r: 1.94444444444444vw;
      --index-button-text: 1.25vw;
      --index-button-h: 3.33333333333333vw;
      --index-arrow-w: 0;
      --index-arrow-h: 0;
      --index-arrow-r: 1.94444444444444vw;
      --index-arrow-ml: 0.625vw;
      --index-arrow-svg-l: 0.694444444444444;
      --index-arrow-svg-w: 0.972222222222222vw;
      --index-arrow-hover-w: 2.22222222222222vw;
      --index-arrow-hover-h: 2.22222222222222vw;
    }

    .index-awards-new {
      --awards-m: 5vw 0;
      --i-awards-h: 44.44444444vw;
      --awards-pl: 6.66666667vw;
      --awards-h: 44.44444444vw;
      --awards-l-w: 20.83333333vw;
      --awards-l-title: 2.22222222vw;
      --awards-l-lh: 2.77777778vw;
      --awards-l-pb: 1.25vw;
      --awards-l-sub: 1.11111111vw;
      --awards-l-sub-lh: 1.66666667vw;
      --awards-l-sub-mb: 2.22222222vw;
      --awards-r-w: 68.05555556vw;
      --awards-l-h: 26.66666667vw;
      --awards-r-img-r: 0.83333333vw;
    }
  }
  @media screen and (max-width: 1024px) { 
    .index-awards-new .new-main-container{
        width: 100%;
    }
    .index-button {
      --index-button-p: 2.66666666666667vw 5.33333333333333vw;
      --index-button-hover-p: 2.66666666666667vw 5.33333333333333vw;
      --index-button-r: 5.33333333333333vw;
      --index-button-text: 3.73333333333333vw;
      --index-button-h: inherit;
      & > div {
        display: none;
      }
    }

    .index-awards-new {
      --awards-m: 19.2vw 0;
      --i-awards-h: inherit;
      --awards-pl: 5.33333333vw;
      --awards-h: inherit;
      --awards-l-w: 81.33333333vw;
      --awards-l-title: 6.4vw;
      --awards-l-lh: 8.53333333vw;
      --awards-l-pb: 2.13333333vw;
      --awards-l-sub: 3.73333333vw;
      --awards-l-sub-lh: 5.86666667vw;
      --awards-l-sub-mb: 4.26666667vw;
      --awards-r-w: 100%;
      --awards-l-h: 94.93333333vw;
      --awards-r-img-r: 3.2vw;
    }

    .index-awards-new .mb-pagination {
      width: 85vw;
    }
    .index-awards-new .mb-pagination .swiper-pagination-bullet {
      flex: 1;
      background: rgba(255, 255, 255, 0.5);
      height: 0.53333333vw;
      border-radius: 0.53333333vw;
      margin: 0;
    }
    .index-awards-new .mb-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
      background: var(--primary-color);
    }
    .index-awards-new .awards {
      padding: 6.66666667vw 0 12vw 6.4vw;
    }
    .index-awards-new .awards .content {
      display: block;
    }
    .index-awards-new .awards .content .left {
      margin-bottom: 6.4vw;
    }
    .index-awards-new .awards .content .left .title span {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      text-overflow: hidden;
    }
    .index-awards-new .awards .content .left .sub-title {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
      overflow: hidden;
      text-overflow: hidden;
    }
    .index-awards-new .awards .content .right .awards-swiper{
      width: 94vw;
    }
    .index-awards-new .awards .content .right .awards-swiper .awards-pagination {
      display: flex;
      width: 91.4666666666667vw;
    }
    .index-awards-new .awards .content .right .awards-swiper .awards-pagination .swiper-pagination-bullet {
      margin: 6.4vw 0 0;
    }
  }

</style>

<div class="index-awards-new">
  <div class="new-main-container">
    <div class="awards">
      <div class="content">
        <div class="left jky-slidedown">
          <div class="title">
            <span class="jky-slideup">{{ award.module_title | escape }}</span>
          </div>
          {%- if award.sub_title != blank -%}
            <div class="sub-title line-clamp-4">{{ award.sub_title }}</div>
          {%- endif -%}

          {% if award.button_text != blank %}
            <a
              data-ga-event="home_page_media_recommendations4.0"
              data-ga-action="click"
              data-ga-params-module="{{ award.module_title | escape }}"
              data-ga-params-link="{{ award.link }}"
              data-ga-params-button_name="{{ award.button_text }}"
              data-ga-params-type="Media recommendations"
              target="{% if award.new_window %}_blank{% else %}_self{% endif %}"
              href="{{ award.link }}"
            >
              <button class="index-button">
                <span>{{ award.button_text | escape }}</span>
                <div>
                  <div class="arrow">
                    <svg
                      class="line"
                      width="20"
                      height="15"
                      viewBox="0 0 20 15"
                      version="1.1"
                      xmlns="http://www.w3.org/2000/svg"
                      xmlns:xlink="http://www.w3.org/1999/xlink"
                    >
                      <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                          <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                              <g transform="translate(672.000000, 286.000000)">
                                  <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                              </g>
                          </g>
                      </g>
                    </svg>
                  </div>
                </div>
              </button>
            </a>
          {% endif %}
        </div>
        <div class="right">
          <div class="swiper awards-swiper">
            <div class="swiper-wrapper">
              {% for i in (0..7) %}
                {% assign pc_image_index = 'pc_image_' | append: forloop.index %}
                {% assign mb_image_index = 'mb_image_' | append: forloop.index %}
                {% assign image_link_index = 'image_link_' | append: forloop.index %}
                {%- if award[pc_image_index] -%}
                  <div class="swiper-slide">
                    {% comment %} {% render 'responsive-image' image: item.settings.pc_image, mimage: item.settings.mb_image %} {% endcomment %}
                    {% if award[image_link_index] !=blank %}
                    <a  target="{% if award.new_window %}_blank{% else %}_self{% endif %}"
                      href="{{ award[image_link_index] }}">
                      <img
                        class="pc-block"
                        src="{{ award[pc_image_index] | image_url: width: 304}}"
                        alt="{{ award[pc_image_index].alt}}"
                        loading="lazy"
                      >
                      <img
                        class="mobile-block"
                        src="{{ award[mb_image_index] | image_url: width: 620}}"
                        alt="{{ award[mb_image_index].alt}}"
                        loading="lazy"
                      >
                    </a>
                    {% else %}
                      <img
                      class="pc-block"
                      src="{{ award[pc_image_index] | image_url: width: 304}}"
                      alt="{{ award[pc_image_index].alt}}"
                      loading="lazy"
                    >
                    <img
                      class="mobile-block"
                      src="{{ award[mb_image_index] | image_url: width: 620}}"
                      alt="{{ award[mb_image_index].alt}}"
                      loading="lazy"
                    >
                    {% endif %}
                    
                  </div>
                {%- endif -%}
              {% endfor %}
            </div>
            <div class="mb-pagination awards-pagination"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="module">
  class AwardsSwiperNew {
    constructor() {
        this.init();
    }
    init() {
        // awards
        const awardsSwiper =  new Swiper(".awards-swiper", {
            spaceBetween: 16,
            slidesPerView: 1.2,
            autoplay: !!this.isMobile() ? false : {
                delay: 0,
                disableOnInteraction: false,
                // pauseOnMouseEnter: true
            },
            freeMode: !this.isMobile(),
            speed: this.isMobile() ? 600 : 3000,
            allowTouchMove: !!this.isMobile(),
            simulateTouch: false,
            loop: true,
            breakpoints: {
                1024: {
                    spaceBetween: 20,
                    slidesPerView: 3,
                },
            },
            pagination: {
                el: ".awards-pagination",
            },
        });

        let nextTransForm = ''
        let nextTime = 0

        const swiperWrapper = document.getElementsByClassName('awards-swiper')[0]?.querySelector('.swiper-wrapper')
        if (swiperWrapper) {
            awardsSwiper.el.onmouseenter = function () {
                nextTransForm = swiperWrapper.style.transform
                
                let nextTransPosition = -1 * parseInt(swiperWrapper.style.transform.split("translate3d(")[1].split('px')[0])
                let nowTransPosition = -1 * parseInt(
                    window.getComputedStyle(swiperWrapper, false)["transform"].split("1, ")[2].split(",")[0]
                )
                let nowTransForm = window.getComputedStyle(swiperWrapper, false)["transform"]
    
                
                const slideWidth = swiperWrapper?.querySelector('.swiper-slide').style.width?.split('px')[0]
                nextTime = 3000 * ((nextTransPosition - nowTransPosition) / Number(slideWidth))
                swiperWrapper.style.transform = nowTransForm
                swiperWrapper.style.transitionDuration = "0ms"
                awardsSwiper.autoplay.stop()
            }
    
            awardsSwiper.el.onmouseleave = function () {
                swiperWrapper.style.transform = nextTransForm
                swiperWrapper.style.transitionDuration = `${nextTime}ms`
                awardsSwiper.autoplay.start()
            }
        }
    }
    
    isMobile(){
        return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
       new AwardsSwiperNew()
  })
</script>
