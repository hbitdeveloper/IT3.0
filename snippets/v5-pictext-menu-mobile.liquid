<drawer-dialog data-lazy-image style="--drawer-top: var(--header-pos-bottom);" id="Drawer__pictext--{{ id }}" placement="right">
    <div class="drawer__overlay"></div>
    <div class="drawer__content">
        <div class="section-container-lg">
            <div class="v5-menu-back drawer__close-btn flex items-center gap-x-1 py-4 sticky top-0 bg-white z-10">
                <div class="w-5 h-5 flex items-center justify-center">
                    {%- render "icon-arrow", class: 'w-3 h-3 rotate-180', color: 'var(--color-text-info)' -%}
                </div>
                <span class="color-text-info text-base font-normal line-clamp-1">{{ section.settings.text_back }}</span>
            </div>

            <div class="v5-pictext-menu-mobile__content pb-4">
                <div style="top: 3.4rem;z-index: 9;" class="color-text-main text-xl font-semibold pb-5 sticky bg-white">{{ settings.handle.title | strip_html }}</div>
                <div class="grid grid-cols-1 w-full gap-y-6">
                    {%- for item in settings.handle.items.value limit: 4 -%}
                        <div class="aspect-square relative lazy-image-wrapper">
                            {%- if item.tag != blank -%}
                                <div class="background-text-main absolute text-xs font-semibold text-white top-1 left-1 px-2 py-1 z-[2] line-clamp-1">{{ item.tag }}</div>
                            {%- endif -%}
                            {%-liquid
                                assign item_img = item.card_img
                                if item.item_img_mb != blank
                                    assign item_img = item.item_img_mb
                                endif

                            -%}
                            <img 
                                width="{{ item_img.width }}" 
                                height="{{ item_img.height }}" 
                                loading="lazy" 
                                class="absolute w-full h-full top-0 left-0 object-cover opacity-0 transition-slow-ease" data-src="{{ item_img | image_url: width: 750 }}" 
                                alt="{{ item_img.alt | escape }}"
                                fetchpriority="low"
                            />
                            <div class="relative z-[2] w-full h-full flex items-start justify-end p-4 flex-col">
                                <div style="color: {{ settings.card_color | default: '#000000' }};" class="line-clamp-2 text-base font-semibold mb-1">{{item.title}}</div>
                                <div style="color: {{ settings.card_color | default: '#000000' }};" class="line-clamp-2 text-sm font-normal mb-3">{{item.subtitle}}</div>
                                <a href="{{ item.url }}" style="background-color: {{ settings.help_bg | default: '#242f20' }};color: {{ settings.text_color | default: '#ffffff' }};" class="background-text-main header-v5-btn flex h-10 items-center px-4 font-semibold text-white text-base"
                                data-ga-event="5.0_top_nav_user_clicks"
                                data-ga-action="click"
                                data-ga-params-module="{{ settings.handle.title | strip_html | escape }}"
                                data-ga-params-position="{{ item.title | strip | escape }}"
                                data-ga-params-link="{{ item.url | escape }}"
                                >{{ settings.card_label }}</a> 
                            </div>
                        </div>
                    {%- endfor -%}
                </div>
            </div>
        </div>
    </div>
</drawer-dialog>