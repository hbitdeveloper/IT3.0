<section class="jf-custom-body jf-min-width jf-body-bg-color jf-works-detail-body">
  <section class="jf-main-container jf-works-detail-wrap">
    {% comment %} 面包屑导航 {% endcomment %}
    <div class="jf-breadcrumb-wrap">
      <span id="prevPage">
        <i class="life-icon jf-icon-icon-fanhui jf-icon jf-left-arrow-icon"></i>
        <span class="layui-breadcrumb">
          <a href="javascript:;" data-i18n="detail.explore"></a>
          <a href="javascript:;" id="currentPage"></a>
        </span>
      </span>
    </div>
    <article class="jf-works-detail-main">
      <h2 class="jf-detail-title"></h2>
      {% comment %} 作者信息 {% endcomment %}
      <div class="jf-detail-author">
        <a class="avatar">
          <div class="avatar-pic"></div>
          <span class="author-name"></span>
        </a>
        <i class="jf-icon jf-vip-icon"></i>
        <i class="jf-icon jf-award-icon"></i>
      </div>
      {% comment %} 作者信息 {% endcomment %}
      <div class="jf-article-content">
        <div class="carousel-wrapper">
          <div
            class="layui-carousel jf-carousel jf-works-detail-carousel"
            id="jfDetailBanner"
          >
            <div carousel-item id="carousel-box"></div>
            <i class="life-icon jf-icon-close jf-icon jf-close-icon"></i>
          </div>
        </div>
        <div class="jf-article-detail">
          <p class="jf-text" id="mainContentText"></p>
          <div class="jf-load-more" id="loadMoreText">
            <span data-i18n="common.view_more"></span>
            <i class="life-icon jf-icon-down-arrow jf-icon jf-down-icon"></i>
          </div>
          <p class="jf-works-related"></p>
          <p class="jf-works-publish-time"></p>
          <div class="jf-work-tag-list"></div >
          <div class="jf-work-affect">
          </div>

          {% comment %} 老带新 {% endcomment %}
          <div class="jf-detail-refer-friend">
            <div class="jf-detail-content">
            </div>
          </div>

          {% comment %} 老带新 {% endcomment %}

          {% comment %} 客户评论 {% endcomment %}
          <div class="jf-customer-reviews">
            <h2 class="jf-reviews-title" data-i18n="detail.customer_reviews"></h2>
            {% comment %} 第一层评论框 {% endcomment %}
            <div
              class="jf-comment-release jf-hot-click-area"
              style="border-bottom: none"
            >
              <div class="comment-main">
                <div class="comment-avatar" data-url="/pages/life-user?&curUser=true" style="cursor:pointer;">
                  <div class="current-login-avatar avatar-pic"></div>
                </div>
                <div class="jf-comment-release-wrap">
                    <div class="comment-release-textarea" style="position:relative;">
                        <textarea
                          id="commentTextarea1"
                          data-i18n="[placeholder]detail.share_your_ideas"
                          maxlength="500"
                          class="layui-textarea"
                          style="resize: none;"
                        ></textarea>
                        <div
                          class="commentNumber"
                          style="
                            position: absolute;
                            right: 10px;
                            bottom: 5px;
                            font-size: inherit;
                            color: #999999;
                          "
                        >
                          <span class="commentLength">0</span>/500
                        </div>
                    </div>
                    <div class="jf-inner-btn-wrap">
                        <div class="jf-inner-left visibility-hidden">
                            <input
                                type="text"
                                name="tag"
                                data-i18n="[placeholder]detail.please_enter_email"
                                autocomplete="off"
                                class="layui-input"
                                maxlength="50"
                            />
                            <span
                                class="email-error-tip"
                                data-i18n-empty="detail.please_enter_email"
                                data-i18n-format="detail.please_enter_email_correct"
                            ></span>

                            <label for="save-to-browser">
                                <input type="checkbox" id="save-to-browser">
                                <span data-i18n="detail.remeber_email"></span>
                            </label>
                        </div>
                        <button
                          type="button"
                          class="layui-btn layui-btn-radius layui-btn-primary jf-realease-btn"
                          data-i18n="common.release"
                        ></button>
                      </div>
                </div>

              </div>
            </div>
            <div id="commentListTree" class="jf-hot-click-area"></div>
          </div>
          {% comment %} 客户评论 {% endcomment %}
        </div>
        <div class="jf-pagination-wrap jf-work-detail-pagination">
          <div id="jfPagination"></div>
        </div>
      </div>
    </article>
  </section>
</section>