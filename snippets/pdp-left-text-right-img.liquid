{% comment %} 4.0商详页内容组件（Product Detail Page V4 Content） - 单张左文右图 {% endcomment %}

{% assign brand_color = '<em style="color: var(--jds-color-primary)">' %}

<div class="pdp-left-text-right-img w-full" style="max-width: 100vw;">
  <div
    class="w-full px-32 lg:j-w-1440 lg:j-px-64 xl:a-w-1440 xl:a-px-64 lg:mx-auto flex flex-col lg:flex-row lg:items-start lg:justify-between"
    style="margin-top:{{settings.margin_top}}px;margin-bottom:{{settings.margin_bottom}}px;"
  >
    {% if settings.title != blank %}
      <h2 class="block lg:hidden w-full font-semibold text-#1A1A1A px-32 text-64 leading-80">
        {{ settings.title | replace: '<em>', brand_color }}
      </h2>
    {% endif %}
    <div class="order-2 lg:order-1 w-full lg:j-w-440 xl:a-w-440">
      {% if settings.title != blank %}
        <h2 class="hidden lg:block w-full font-medium text-#1A1A1A lg:j-text-48 lg:j-leading-56 xl:a-text-48 xl:a-leading-56">
          {{ settings.title | replace: '<em>', brand_color }}
        </h2>
      {% endif %}
      <ul class="list-wrap w-full flex flex-col px-32 mt-64 gap-y-82 lg:px-0 lg:j-mt-48 lg:j-gap-y-49 xl:a-mt-48 xl:a-gap-y-49">
        {% if settings.description_one != blank %}
          <li class="text-#1A1A1A text-40 leading-48 lg:j-text-20 lg:j-leading-28 xl:a-text-20 xl:a-leading-28">
            {{ settings.description_one | replace: '<em>', brand_color }}
          </li>
        {% endif %}
        {% if settings.description_two != blank %}
          <li class="text-#1A1A1A text-40 leading-48 lg:j-text-20 lg:j-leading-28 xl:a-text-20 xl:a-leading-28">
            {{ settings.description_two | replace: '<em>', brand_color }}
          </li>
        {% endif %}
        {% if settings.description_three != blank %}
          <li class="text-#1A1A1A text-40 leading-48 lg:j-text-20 lg:j-leading-28 xl:a-text-20 xl:a-leading-28">
            {{ settings.description_three | replace: '<em>', brand_color }}
          </li>
        {% endif %}
        {% if settings.description_four != blank %}
          <li class="text-#1A1A1A text-40 leading-48 lg:j-text-20 lg:j-leading-28 xl:a-text-20 xl:a-leading-28">
            {{ settings.description_four | replace: '<em>', brand_color }}
          </li>
        {% endif %}
        {% if settings.description_five != blank %}
          <li class="text-#1A1A1A text-40 leading-48 lg:j-text-20 lg:j-leading-28 xl:a-text-20 xl:a-leading-28">
            {{ settings.description_five | replace: '<em>', brand_color }}
          </li>
        {% endif %}
        {% if settings.description_six != blank %}
          <li class="text-#1A1A1A text-40 leading-48 lg:j-text-20 lg:j-leading-28 xl:a-text-20 xl:a-leading-28">
            {{ settings.description_six | replace: '<em>', brand_color }}
          </li>
        {% endif %}
      </ul>
    </div>
    {% if settings.imgPC != blank or settings.imgMB != blank or settings.videoPC != blank or settings.videoMB != blank %}
      {% if settings.videoPC != blank %}
        <div class="order-1 lg:order-2 w-full h-505 rounded-24 mt-40 lg:mt-0 lg:j-w-760 lg:j-h-560 lg:j-rounded-12 xl:a-w-760 xl:a-h-560 xl:a-rounded-12 overflow-hidden hidden lg:block">
          {% comment %} video {% endcomment %}
          {%
            render 'jky-video',
              class: 'w-full h-full pc-video'
              poster: settings.imgPC,
              video_url: settings.videoPC,
              autoplay: false,
              loop: settings.loop,
              controls: settings.controls
          %}
        </div>
      {% endif %}
      {% if settings.videoMB != blank %}
        <div class="order-1 lg:order-2 w-full h-505 rounded-24 mt-40 lg:mt-0 lg:j-w-760 lg:j-h-560 lg:j-rounded-12 xl:a-w-760 xl:a-h-560 xl:a-rounded-12 overflow-hidden block lg:hidden">
          {% comment %} video {% endcomment %}
          {%
            render 'jky-video',
              class: 'w-full h-full mb-video'
              poster: settings.imgMB,
              video_url: settings.videoMB,
              autoplay: false,
              loop: settings.loop,
              controls: settings.controls,
          %}
        </div>
      {% endif %}

      {% if settings.videoPC == blank and settings.imgPC != blank %}
        <div class="order-1 lg:order-2 w-full h-505 mt-40 lg:mt-0 lg:j-w-760 lg:j-h-560 xl:a-w-760 xl:a-h-560 overflow-hidden hidden lg:block">
          {%- render 'responsive-image',
            image: settings.imgPC,
            image_class: 'w-full h-full object-cover rounded-24 lg:j-rounded-12 xl:a-rounded-12',
            width: 760,
            mwidth: 1
          -%}
        </div>
      {% endif %}

      {% if settings.videoMB == blank and settings.imgMB != blank %}
        <div class="order-1 lg:order-2 w-full h-505 rounded-24 mt-40 lg:mt-0 lg:j-w-760 lg:j-h-560 lg:j-rounded-12 xl:a-w-760 xl:a-h-560 xl:a-rounded-12 overflow-hidden block lg:hidden">
          {% comment %} image {% endcomment %}
          {% render 'responsive-image',
            image: settings.imgMB,
            image_class: 'w-full h-full object-cover rounded-24 lg:j-rounded-12 xl:a-rounded-12',
            width: 1,
            mwidth: 343
          -%}
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>
