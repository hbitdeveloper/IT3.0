{% comment %}  批量购买导航 {% endcomment %}
<div {{ attributes }} class="bulk-program--nav cal_scroll_target">
    <div class="bulk-program--container">
        <div class="nav-wrapper">
            <div class="nav-list">
                {% for block in bulk_program %}
                    <div class="nav-item {% if forloop.first %}active-item{% endif %}"
                        data-tab="{{ block.title | handleize }}"
                        data-title="{{ block.title | escape}}"
                        data-ga-event="bulk_program_user_clicks"
                        data-ga-action="click"
                        data-ga-params-module="Directory"
                        data-ga-params-position="{{ block.title | escape}}"
                    >{{ block.title | escape}}</div>
                {% endfor %}
            </div>
            <div>
                <span class="nav-arrow nav-arrow--left">&lt;</span>
                <span class="nav-arrow nav-arrow--right">&gt;</span>
            </div>
        </div>
    </div>
</div>
