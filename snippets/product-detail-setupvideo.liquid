

<section class="w-full flex-center flex-col">
  <div class="photovolatic-setup-wrapper w-full flex-center flex-col px-40 py-64 lg:px-0 lg:j-w-1280 lg:j-py-75 xl:a-w-1280 xl:a-py-75 bg-white">
      <h2 class="w-full text-left lg:text-center font-600 text-#222226 mb-16 text-52 leading-68 lg:j-px-40 xl:a-px-40 lg:j-text-40 lg:j-leading-64 lg:j-mb-24 xl:a-text-40 xl:a-leading-64 xl:a-mb-24">
        {{ settings.title | newline_to_br }}
      </h2>
      <div class="font-500 text-#222226/60 text-32 text-left leading-40 mb-40 lg:text-center lg:j-px-40 lg:j-text-18 lg:j-leading-24 lg:j-mb-32 xl:a-px-40 xl:a-text-18 xl:a-leading-24 xl:a-mb-32">
        {{ settings.description | newline_to_br }}
      </div>
      <ul class="photovolatic-setup-wrap w-full flex flex-wrap gap-40 lg:j-gap-x-20 lg:j-gap-y-24 xl:a-gap-x-20 xl:a-gap-y-24">
        {%- for i in (0..5) -%}
            {% assign video_title_index = 'video_title_' | append: forloop.index %}
            {% assign video_url_index = 'video_url_' | append: forloop.index %}
            {% assign poster_index = 'poster_' | append: forloop.index %}

            {%- if settings[video_url_index] or settings[poster_index] -%}
              <li class="w-full lg:j-w-630 xl:a-w-630">
                {% comment %} <span class="photovolatic-video-title font-600 text-#949494 absolute left-60 top-40 text-48 leading-56 lg:j-left-30 lg:j-top-20 lg:j-text-32 lg:j-leading-40 xl:a-left-30 xl:a-top-20 xl:a-text-32 xl:a-leading-40 z-3">
                  {{ settings[video_title_index] | escape }}
                </span> {% endcomment %}

                {% if settings[video_url_index] != blank %}
                  <div
                    class="w-full h-384 rounded-24 lg:j-w-630 lg:j-h-356 lg:j-rounded-12 xl:a-w-630 xl:a-h-356 xl:a-rounded-12 relative bg-black overflow-hidden"
                    data-jky-video
                    data-section-title="{{ settings.title | escape }}"
                    data-video-url="{{ settings[video_url_index] }}"
                    data-poster="{{ settings[poster_index] }}"
                    data-index="{{ forloop.index0 }}"
                    data-video-title="{{ settings[video_title_index] | escape }}"
                  >
                    {%-
                      render 'jky-video',
                        poster: settings[poster_index],
                        video_url: settings[video_url_index],
                        autoplay: false,
                        loop: settings.loop,
                        controls: settings.controls
                    -%}
                  </div>
                {% else %}
                  <div
                    class="w-full h-384 rounded-24 lg:j-w-630 lg:j-h-356 lg:j-rounded-12 xl:a-w-630 xl:a-h-356 xl:a-rounded-12 relative bg-black overflow-hidden"
                    data-jky-video
                    data-section-title="{{ settings.title | escape }}"
                    data-video-url="{{ settings[video_url_index] }}"
                    data-poster="{{ settings[poster_index] }}"
                    data-index="{{ forloop.index0 }}"
                    data-video-title="{{ settings[video_title_index] | escape }}"
                  >
                    <picture class="w-full h-full">
                      <source media="(min-width:1024px)" srcset="{{ settings[poster_index] | image_url: width: 3840}}">
                      <img
                        class="w-full h-full object-cover rounded-24 xl:a-rounded-12 lg:j-rounded-12"
                        src="{{ settings[poster_index] | image_url: width: 750}}"
                        alt="{{ settings[poster_index].alt }}"
                        loading="lazy"
                        width="{{ settings[poster_index].width }}"
                        height="{{ settings[poster_index].height }}"
                      >
                    </picture>
                  </div>
                {% endif %}

                <div class="photovolatic-video-title font-600 text-#222226 text-40 leading-52 mt-32 mb-24 lg:j-text-28 lg:j-leading-36 lg:j-mt-24 lg:j-mb-32 xl:a-text-28 xl:a-leading-36 xl:a-mt-24 xl:a-mb-32 z-3">
                  {{ settings[video_title_index] | escape }}
                </div>
              </li>
            {%- endif -%}
        {%- endfor -%}
      </ul>
  </div>
</section>
