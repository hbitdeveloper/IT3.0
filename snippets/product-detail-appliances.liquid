{% comment %} 配置 更多电器 {% endcomment %}
{% if blocks.size > 0 %}
  <div id="product-detail-appiances">
    <div class="w-full px-60 my-100 lg:a-w-1200 lg:a-px-0 mx-auto lg:a-mt-80 lg:a-mb-0">
        <h2 class="w-full text-center text-36 leading-52 mb-16 lg:a-text-32 lg:a-leading-48 lg:a-mb-8 text-black font-600">{{ title | newline_to_br }}</h2>
        <p class="w-full text-center text-26 leading-39 lg:a-text-18 lg:a-leading-27 text-black font-400 mb-40 lg:a-mb-40">{{ subtitle | newline_to_br }}</p>

        <div class="w-full flex p-14 rounded-30 lg:flex-col lg:a-p-16 lg:a-rounded-30 bg-#EBEBEB">
            <ul class="flex flex-col w-240 gap-y-10 pb-20 lg:a-pb-0 lg:w-full lg:flex-row lg:a-gap-5" data-more-appliances>
              {% for block in blocks limit: 7 %}
                <li
                  class="lg:flex-1 flex-center h-80 text-26 rounded-tl-20 rounded-bl-20 lg:a-max-w-230 lg:a-h-66 lg:a-rounded-tl-20 lg:a-rounded-bl-0 lg:a-rounded-tr-20 lg:a-text-18 Gilory-Semibold bg-#F5F5F5 cursor-pointer appliance-active"
                  data-appliance-a="{{ block.settings.appliance_name_1 | escape }}"
                  data-appliance-b="{{ block.settings.appliance_name_2 | escape }}"
                  data-appliance-c="{{ block.settings.appliance_name_3 | escape }}"
                  data-appliance-d="{{ block.settings.appliance_name_4 | escape }}"
                  data-appliance-e="{{ block.settings.appliance_name_5 | escape }}"
                  data-appliance-f="{{ block.settings.appliance_name_6 | escape }}"
                  data-appliance-g="{{ block.settings.appliance_name_7 | escape }}"
                  data-appliance-h="{{ block.settings.appliance_name_8 | escape }}"
                  data-appliance-i="{{ block.settings.appliance_name_9 | escape }}"
                  data-appliance-j="{{ block.settings.appliance_name_10 | escape }}"
                >
                  {{ block.settings.appliance_scope | escape }}
                </li>
              {% endfor %}
            </ul>

            <div
              class="flex-1 px-30 py-60 gap-y-50 content-center rounded-tr-20 rounded-b-20 lg:flex-row lg:w-full lg:a-min-h-215 lg:a-px-100 lg:a-py-55 lg:a-rounded-tr-0 lg:a-rounded-b-20 bg-white grid grid-cols-1 justify-items-center lg:a-gap-40"
              data-appliance-content
            ></div>
        </div>
    </div>
  </div>
{% endif %}

<script defer>
// 配置 更多电器
if (!window.MoreAppliances) {
    class MoreAppliances {
    constructor({ tabEl, contentEl, }) {
        this.tabDOM = document.querySelector(tabEl)
        this.contentDOM = document.querySelector(contentEl)

        this.oLis = this.tabDOM.querySelectorAll("li")
        this.init()
    }
    init() {
        this.oLis.forEach((it) => it.onclick = () => this.handleClick(it))
        this.handleClick(this.oLis[0])
    }
    handleClick(it) {
        this.oLis.forEach((a) => a.classList.remove("appliance-active"))
        it.classList.add("appliance-active")

        const { applianceA, applianceB, applianceC, applianceD, applianceE, applianceF, applianceG, applianceH, applianceI, applianceJ, } = it.dataset

        const list = [applianceA, applianceB, applianceC, applianceD, applianceE, applianceF, applianceG, applianceH, applianceI, applianceJ].filter(s => s && s.trim())

        const html = list.reduce((prev, next) => {
            const [ key, value ] = next.split(':')
            prev += `
            <p class="flex-center flex-col">
                <span class="text-28 leading-36 lg:a-min-w-180 lg:a-text-20 lg:a-leading-36 text-center text-black font-600 text-overflow-1" title="${key}">${key}</span>
                <span class="text-24 leading-21 mt-4 lg:a-text-16 lg:a-leading-21 lg:a-mt-0 text-black/50 font-400">${value}</span>
            </p>
            `
            return prev
        }, '')

        if (list.length >= 5) {
            this.contentDOM.classList.add('lg:grid-cols-5')
        } else {
            this.contentDOM.classList.remove('lg:grid-cols-5')
            this.contentDOM.classList.remove('lg:grid-cols-4')
            this.contentDOM.classList.remove('lg:grid-cols-3')
            this.contentDOM.classList.remove('lg:grid-cols-2')
            this.contentDOM.classList.add(`lg:grid-cols-${list.length}`)
        }
        this.contentDOM.innerHTML = html
    }
    }

    window.MoreAppliances = MoreAppliances
}

document.addEventListener('DOMContentLoaded', () => {
    if ({{blocks.size}} > 0) {
        new MoreAppliances({
            tabEl: "[data-more-appliances]",
            contentEl: "[data-appliance-content]",
        })
    }
})
</script>
