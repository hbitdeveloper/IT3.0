{% comment %} 颜色方案 {% endcomment %}
{% style %}
  {%- for scheme in settings.color_schemes -%}
    .color-{{ scheme.id }} {
      {% if scheme.settings.background_gradient != empty %}
        --color-background: {{ scheme.settings.background_gradient }};
      {% else %}
        --color-background: {{ scheme.settings.background }};
      {% endif %}
      --color-text: {{ scheme.settings.text }};
      --color-shadow: {{ scheme.settings.shadow }};
      --color-button: {{ scheme.settings.button }};
      --color-button-text: {{ scheme.settings.button_label }};
      --color-secondary-button: {{ scheme.settings.background }};
      --color-secondary-button-text: {{ scheme.settings.secondary_button_label }};
      --color-link: {{ scheme.settings.secondary_button_label }};  
    }
  {%- endfor -%}
{% endstyle %}