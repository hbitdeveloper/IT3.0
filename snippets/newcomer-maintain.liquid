<div class="newcomer-main-container newcomer-maintain newcomer-maintain-{{ index }}" anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', ''}}">
    <div class="maintain-content">
        {% if settings.section_title != blank %}
            <h3 class="maintain-title">{{ settings.section_title }}</h3>
        {% endif %}
        <div class="maintain-body">
            {% for i in (0..2) %}
                {% assign img_title = 'part_title_' | append: forloop.index %}
                {% assign img_subtitle = 'part_subtitle_' | append: forloop.index %}
                {% assign pc_img = 'part_pc_img_' | append: forloop.index %}
                {% assign mb_img = 'part_mb_img_' | append: forloop.index %}
                {% if settings[pc_img] != blank and settings[mb_img] != blank %}
                    <div class="maintain-item">
                        <div class="recharge-img">
                            {% render 'responsive-image',
                                    image: settings[pc_img],
                                    mimage: settings[mb_img],
                                    image_class: 'activity-image'
                            %}
                        </div>
                        <div class="img-text">
                            {% if settings[img_title] != blank %}
                                <div class="img-title">{{ settings[img_title] }}</div>
                            {% endif %}
                            {% if settings[img_subtitle] != blank %}
                                <div class="img-subtitle">{{ settings[img_subtitle] }}</div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>

<style>
    .newcomer-maintain-{{ index }}{
        padding-top:{{ settings.pc_padding_top }}px;
        padding-bottom:{{ settings.pc_padding_bottom }}px;
    }
    @media screen and (min-width: 1024px) and (max-width: 1439.98px){
        .newcomer-maintain-{{ index }}{
            padding-top: calc( {{ settings.pc_padding_top }}  * 100vw / 1440 );
            padding-bottom: calc( {{ settings.pc_padding_bottom }}  * 100vw / 1440 );
        }
    }
    @media screen and (max-width: 1023.98px){
        .newcomer-maintain-{{ index }}{
            padding-top: calc( {{ settings.mb_padding_top }}  * 100vw / 750 );
            padding-bottom: calc( {{ settings.mb_padding_bottom }}  * 100vw / 750 );
        }
    }
</style>
