                                                                                        <g transform="translate(-694.000000, -311.000000)" fill="currentColor" fill-rule="nonzero">
                                                                                            <g transform="translate(672.000000, 286.000000)">
                                                                                                <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                                                                            </g>
                                                                                        </g>
                                                                                    </g>
                                                                                </svg>
                                                                            </div>
                                                                        </div>
                                                                    {% endif %}
                                                                {%- endif -%}
                                                            </a>
                                                        {%- endif -%}

                                                        {% comment %} 售卖提醒 {% endcomment %}
                                                        {%- if schema_settings.remind_me != blank -%}
                                                            <a btn-action="remindme" data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="{{schema_settings.remind_me | escape}}" data-ga-params-link="" data-ga-params-type="{{sb_types}}"
                                                                {% if schema_settings.remind_me_solid == true %} btn-solid
                                                                {% if schema_settings.columns_desktop != 2 %}
                                                                    class="index-button"
                                                                {% endif %}
                                                            {% endif %}>
                                                                <span> {{schema_settings.remind_me | escape}} </span>
                                                                {% if schema_settings.remind_me_solid == true and schema_settings.columns_desktop != 2 %}
                                                                    <div>
                                                                        <div class="arrow">
                                                                            <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                                                                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                                                    <g transform="translate(-694.000000, -311.000000)" fill="currentColor" fill-rule="nonzero">
                                                                                        <g transform="translate(672.000000, 286.000000)">
                                                                                            <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                                                                        </g>
                                                                                    </g>
                                                                                </g>
                                                                            </svg>
                                                                        </div>
                                                                    </div>
                                                                {% endif %}
                                                            </a>
                                                        {%- endif -%}
                                                    </div>
                                                {%- endif -%}
                                            </div>
                                        </div>
                                    </div>
                                </jky-landing-product>
                            {%- endif -%}
                        {%- endfor -%}
                    </div>

                    {%- if schema_settings.open_swiper==true and swiper_size > 1 -%}
                        <div class="swiper-button-prev" data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}" data-ga-params-button_name="left" data-ga-params-type="{{sb_types}}"><div class="arrow-icon"></div></div>
                        <div class="swiper-button-next" data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}" data-ga-params-button_name="right" data-ga-params-type="{{sb_types}}"><div class="arrow-icon"></div></div>
                    {%- endif -%}
                </jky-landing-collectionitem>
                {%- endif -%}
            {%- endfor -%}
        </div>
    </jky-landing-collections>
</div>

<script type="module">
    document.addEventListener('DOMContentLoaded', function() {
        if (!customElements.get('jky-landing-collections')) {
            customElements.define('jky-landing-collections', class JkyLandingCollections extends HTMLElement {
                constructor() {
                    super()
                    this.getServerTime()
                    this.init()
                }
                getServerTime() {
                    if (window.JKY_getServerTime) {
                        window.JKY_getServerTime().then(res => {
                            const ts = Number(res?.data?.time);
                            this.server_time = ts;
                            document.querySelectorAll("jky-landing-product").forEach(item => {
                                item.server_time = ts;
                                item.startServertime(ts);
                                item.setAttribute("servertime", ts);
                            });
                        });
                    } else {
                        const url = `${window?.pageInfo?.api}/osconsumerapi/v1/com/get-server-time?shopify_shop_id=${window?.pageInfo?.shopId}&cr=${window?.pageInfo?.cr}`
                        fetch(url).then((response) => response.json()).then(res => {
                            if(res.code === 200 && res?.data?.time) {
                                const ts = res.data.time
                                this.server_time = ts
                                document.querySelectorAll("jky-landing-product").forEach(item => {
                                    item.server_time = ts
                                    item.startServertime(ts)
                                    item.setAttribute("servertime", ts)
                                })
                            }
                        })
                    }
                }

                init() {
                    const that = this;
                    const tabs = this.querySelectorAll(".landing-block--product-tab");
                    tabs.forEach(tab => {
                        tab.addEventListener("click", function () {
                            const handle = tab.getAttribute("data-handle");

                            that.querySelectorAll(".landing-block--product-tab").forEach(el => el.classList.remove("active"));
                            that.querySelectorAll("jky-landing-collectionitem").forEach(el => el.classList.remove("active"));
                            tab.classList.add("active");

                            const target = that.querySelector(`jky-landing-collectionitem[target-handle="${handle}"]`);
                            if (target) {
                                target.classList.add("active");
                            }

                            target.querySelectorAll("jky-landing-product").forEach(item => {
                                item.handlePriceLoog();
                            });
                        })
                    })
                }
            })
        }

        if (!customElements.get('jky-landing-collectionitem')) {
            customElements.define('jky-landing-collectionitem', class JkyLandingCollectionitem extends HTMLElement {
                constructor() {
                    super()
                    this.isMobile = window.innerWidth <= 1024
                    this.init()
                }
                init() {
                    if (this.classList.contains("col-swiper")) {
                        this.swiper = new Swiper(this, {
                            slidesPerView: this.isMobile ? 'auto' : 3,
                            freeMode: true,
                            spaceBetween: this.isMobile ? 12 : 24,
                            navigation: {
                                nextEl: this.querySelector(".swiper-button-next"),
                                prevEl: this.querySelector(".swiper-button-prev"),
                            }
                        });
                    }
                }
            })
        }

        if (!customElements.get('jky-landing-product')) {
            customElements.define('jky-landing-product', class JkyLandingProduct extends HTMLElement {
                constructor() {
                    super()
                    this.act_start = this.getAttribute("data-start")
                    this.init()
                }
                init() {
                    this.handleActionTrigger()

                    // 商品售价
                    this.price = this.getAttribute("data-price")
                    // 促销活动开始时间
                    if(this.getAttribute("data-start")) {
                        this.act_start = Number(this.getAttribute("data-start")) * 1000
                    }
                    // 促销活动结束时间
                    if(this.getAttribute("data-end")) {
                        this.act_end = Number(this.getAttribute("data-end")) * 1000
                    }
                    // 商品售价
                    if(this.getAttribute("data-actprice")) {
                        this.act_price = this.getAttribute("data-actprice") || ''
                    }

                    // 折扣活动进行中
                    this.has_act = this.getAttribute("has_act") === "true"
                    // 是否有折扣活动（包含生效和过期和未开始）
                    this.has_act_active = this.getAttribute("has_act_active") === "true"

                    // 获取折扣显示信息
                    if(this.querySelector('.landing-block--product-price [type="application/json"]')) {
                        try {
                            this.discount_config = JSON.parse(this.querySelector('.landing-block--product-price [type="application/json"]').textContent)
                        } catch(e) {
                            this.discount_config = null
                        }

                        try {
                            this.day_num = Math.ceil((this.discount_config.act_time_end - this.discount_config.act_time) / 60 / 60 / 24)
                        } catch(e) {
                            console.info(e)
                        }
                    }
                    this.discount_dom_price = this.querySelector(".p-discount")

                    // 分期
                    this.affirm_dom = this.querySelector(".landing-block--product-affirm")

                    // 进度条
                    this.available_progress = this.querySelector(".landing-block--product-progress")

                    // 卡片显示样式（US or JP）
                    this.style_us = this.getAttribute("card_style") === "cards_style_1"

                    setTimeout(() => {
                        this.handlePriceLoog()
                    }, 200)
                    this.handleAffirmDisplay()
                    this.handleAmountDiscount()
                }

                activeACT() { // 活动开启
                    if(!this.has_act_active) return
                    this.intervalId = setInterval(() => { this.updateACTTime() }, 1000);
                }

                updateACTTime() { // 活动时间轮询
                    this.timenow += 1000

                    if(this.timenow > this.act_start && this.timenow < this.act_end) { // 活动进行中
                        this.querySelector(".p-price").innerHTML = this.act_price || ''
                        this.handleAmountDiscount()
                        this.updateProgress(true)
                    }

                    if(this.timenow > this.act_end) { // 活动结束
                        this.intervalId && clearInterval(this.intervalId); // 停止更新倒计时
                        this.querySelector(".p-price").innerHTML = this.price || this.act_price || ''
                        this.handleAmountDiscount()
                        this.updateProgress(false)
                    }

                    this.handlePriceLoog()
                }

                getRankDay(now, start, end) { // 计算活动进度（第几天）
                    if(now < start || now > end) return
                    return Math.ceil((now - start) / (1000 * 60 * 60 * 24))
                }

                // 设置价格折扣显示 & 分期付款显示信息调整
                handleAmountDiscount() { // true 活动中，false: 非活动时间
                    if(!this.discount_config) return

                    this.discount_dom_price && (this.discount_dom_price.innerHTML = this.discount_config?.display_discount_num || '')
                    this.handleAffirmDisplay()
                    this.updateUSStyle()
                }

                // 分期信息处理
                handleAffirmDisplay() {
                    if(!this.affirm_dom) return

                    if(this.discount_config && this.discount_config.Installment_text && this.discount_config.price_num) {
                        this.affirm_dom.querySelector("span").innerHTML = this.discount_config.Installment_text.replace("{Installment_per}", this.calcPerAffirm(this.discount_config.price_num))
                        this.affirm_dom.classList.add("active")
                        return
                    }
                    this.affirm_dom.classList.remove("active")
                }

                calcPerAffirm(amount) { // 计算分期金额
                    if(amount < 200) {
                        return Math.ceil(amount / 4)
                    } else {
                        return Math.ceil(amount * 1.1229 / 18)
                    }
                }

                handlePriceLoog() { // 处理价格显示超长问题
                    const bottom = this.querySelector(".landing-block--product-content--bottom");
                    if (!bottom || !bottom.offsetWidth) return;

                    const price = this.querySelector(".landing-block--product-price");
                    if (price && bottom.offsetWidth <= price.offsetWidth + 4) {
                        const discount = this.querySelector(".p-discount");
                        if (discount) discount.style.display = "none";
                    }
                }

                handleActionTrigger() { // 卡片按钮事件处理
                    this.querySelectorAll("[btn-action]").forEach(btn => {
                        btn.addEventListener("click", (event) => {
                            event.preventDefault();

                            if(!this.discount_config) return
                            const actionType = btn.getAttribute("btn-action")
                            switch (actionType) {
                            case "addtocart":
                                this.handleAddToCart(this.discount_config.id, 1, btn)
                                break;
                            case "buyitnow":
                                this.handleBuyItNow(this.discount_config.id, 1, btn)
                                break;
                            case "remindme":
                                this.handleRemind()
                                break;
                            default:
                                break;
                            }
                        })
                    })
                }

                handleAddToCart(id, quantity = 1, dom) { // 卡片按钮事件-加购
                    dom.classList.add("loading");
                    if (typeof id !== 'number' || isNaN(id)) {
                        throw new TypeError('Theme Cart: Variant ID must be a number');
                    }
                    const cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
                    const fetchJSON = (url, config) => {
                        return fetch(url, config).then(function(response) {
                            if (!response.ok) {
                                throw response;
                            }
                            return response.json();
                        });
                    }
                    const config = {
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json;'
                        },
                        method: 'POST',
                        body: JSON.stringify({
                            items: [
                                {
                                    id: id,
                                    quantity: quantity
                                }
                            ]
                        })
                    }

                    fetchJSON('/cart/add.js', config).then(response => {
                        if(cart && cart.renderContents) {
                            cart.renderContents(response);
                        } else {
                            window.location.href = '/cart';
                        }
                        setTimeout(() => dom.classList.remove("loading"), 1000)
                        if (cart && cart.classList.contains('is-empty')) {
                            cart.classList.remove('is-empty');
                        }
                    })
                    .catch((e) => {
                        setTimeout(() => dom.classList.remove("loading"), 1000)
                        if (cart && cart.classList.contains('is-empty')) {
                            cart.classList.remove('is-empty');
                        }
                        e.json().then(errorData => {
                            const message = errorData.message
                            message && pushErrorMessage(message)
                        })
                    })
                }

                async handleBuyItNow(id, quantity = 1, dom) { // 卡片事件 - 立即购买
                    dom.classList.add("btn--loading");
                    if (typeof id !== 'number' || isNaN(id)) {
                        throw new TypeError('Theme Cart: Variant ID must be a number');
                    }
                    const params = [{ id, quantity, properties: {} }]
                    try {
                        const checkoutUrl = await createCartAndCheckout(params)
                        if (checkoutUrl) {
                            window.location.href = checkoutUrl
                        }
                    } catch (error) {
                        let str =  `/cart/${id}:${quantity}`
                        window.location.href = str
                    } finally{
                        dom.classList.remove('btn--loading')
                    }
                }

                handleRemind() { // 卡片按钮事件-售卖提醒
                    let config = null
                    let tag = null
                    try {
                        config = JSON.parse(document.querySelector("#landing-product-config").textContent)
                    } catch(e) {
                        config = null
                    }

                    if(config && config.remind_tag) {
                        tag = config.remind_tag
                    } else {
                        tag = location.pathname.replace("/pages/", "")
                    }

                    const onsubmitcall = (params) => {
                        if(params.response && params.response.code === 200) {
                            pushSuccessMessage(document.querySelector(`.landing-block--product`).getAttribute(`string-remind_success_tip`))
                        } else {
                            pushSuccessMessage(document.querySelector(`.landing-block--product`).getAttribute(`string-remind_error_tip`))
                        }

                        const popEl = document.querySelector('.landing_product_card--pop');
                        if (popEl) {
                            const closeBtn = popEl.querySelector('.close');
                            if (closeBtn) {
                                closeBtn.click();
                            }
                        }
                    }

                    ZModle.getInstance(
                        `
                            <div class="flex flex-col">
                                <div class="title">${config.remind_title}</div>
                                <div class="subtitle">${config.remind_des}</div>
                                <jky-form data-scroll="false" onsubmitcall="${onsubmitcall}" jky-form-id="product-shaortage-form" class="">
                                    <form data-action="/osconsumerapi/v1/notice/subscribe">
                                        <div class="newbee-form newbee-form_shortage">
                                            <div class="form-row flex full">
                                                <div class="form-item required" data-field="input">
                                                    <input type="email" id="email" name="email"
                                                        placeholder="${config.remind_email_place}"
                                                        data-error="${config.remind_email_empty}" data-value="email" data-reg="email"
                                                        data-regerror="${config.remind_email_error}">
                                                </div>
                                            </div>

                                            <div style="margin-top: 6px;" class="form-row form-row_check_box flex full">
                                                    <div
                                                        class="form-item required"
                                                        data-field="check_box"
                                                        data-error="${config.remind_policy_error}"
                                                    >
                                                        <jky-checkbox class="jky-checkbox_shortage jky-checkbox">
                                                            <label class="jky-checkbox">
                                                                <span class="jky-checkbox-input">
                                                                <input type="checkbox" class="jky-checkbox-original" data-value="agree_recevie_shortage">
                                                                <span class="jky-checkbox-inner"></span>
                                                                </span>

                                                                <span class="jky-checkbox-label">
                                                                <span class="jky-agree">${config.remind_policy}</span>
                                                                </span>
                                                            </label>
                                                        </jky-checkbox>
                                                    </div>
                                            </div>

                                            <div style="display: none;" class="form-row flex  full">
                                                <div class="form-item form-item_const" data-field="input">
                                                <input type="text" id="tags" name="tags" data-error="" data-value="tags" data-reg="" value="${tag}" data-regerror="">
                                                </div>
                                            </div>

                                            <div class="newbee-form_submit flex" style="justify-content: flex-start;">
                                                <button class="form_sub_btn z-button-middle">${config.remind_submit}</button>
                                            </div>
                                        </div>
                                    </form>
                                </jky-form>
                            </div>
                        `,
                        {
                        id: `landing_product_card`,
                        class: "landing_product_card--pop"
                    })
                }

                updateProgress(active = false) { // 售卖进度更新
                    if(!this.available_progress) return
                    if(!active) {
                        this.querySelector(".landing-block--product-progress").classList.remove("active")
                    }
                    if(!active || !this.discount_config?.has_act) return
                    if(!this.day_num || !this.timenow || !this.discount_config.init_num) return
                    const rank_day = this.getRankDay(this.timenow, this.discount_config.act_time * 1000, this.discount_config.act_time_end * 1000)
                    if(!rank_day || rank_day === this.rank_day) return

                    let res = this.rank_day ? (100 - this.discount_config.init_num) / this.day_num * rank_day + this.discount_config.init_num + (Math.floor(Math.random() * 7 - 3)) : (100 - this.discount_config.init_num) / this.day_num * rank_day + this.discount_config.init_num
                    res = res >= 99 ? 99 : res
                    this.rank_day = rank_day
                    if(this.discount_config.unavailable_sold_txt) {
                        this.querySelector(".landing-block--product--sold").innerHTML = this.discount_config.unavailable_sold_txt.replace("{num}", Math.floor(res))
                    }
                    if(this.discount_config.available_sold_txt) {
                        this.querySelector(".landing-block--product--unsold").innerHTML = this.discount_config.available_sold_txt.replace("{num}", Math.ceil(100 - res))
                    }
                    this.querySelector(".landing-block--product-progress .jk-seekbar-progress [role='progressbar']").style.width = `${res}%`
                }

                startServertime(time) { // 同步后端服务器时间
                    if(!this.has_act_active) return
                    if(this.act_start >= this.act_end) {
                        console.error(`配置错误：活动开始时间不能晚于结束时间`)
                        return
                    }
                    this.timenow = Number(time)
                    this.timenow && this.activeACT()
                }

                updateUSStyle() { // 美站样式角标更新
                    if(!this.querySelector(".p-discount")) return

                    const discount_tag = this.querySelector(".landing-block--product-discount-tag--1")
                    const discount_tag_span = this.querySelector(".landing-block--product-discount-tag--1 span")
                    if(!this.style_us || !discount_tag) return

                    const _ctx_discount = this.discount_config?.display_discount_num || ''
                    if(!_ctx_discount) return

                    discount_tag_span.innerHTML = _ctx_discount
                    discount_tag.classList.add("active")
                    this.querySelector('.p-discount').style.display = 'none';
                }
            })
        }
    })
</script>
