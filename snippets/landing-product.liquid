    .tag--2--content {height: 50%;width:100%;z-index:2;position: relative;transform: rotate(45deg);transform-origin: center bottom;flex-direction: column;font-weight: 400;color: rgba(255,255,255,0.6);font-size: 12px;text-align: center;justify-content: flex-end;padding-bottom: 12px;gap: 2px;}
    .tag--2--content.tag--2--content--notime {justify-content: center;padding-bottom: 0;}
    .tag--2--content .text--primary {font-weight: 600;color: rgba(255,255,255,1);font-size: 14px;}
