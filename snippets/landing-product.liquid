        .landing-product--block-title {font-size:calc(var(--block_title_size) / 2);padding-bottom:calc(var(--block_title_bottom) / 2)!important;}
        .landing-product--block-sub-title {font-size:calc(var(--block_sub_title_size) / 2);padding-bottom:calc(var(--block_sub_title_bottom) / 2)!important;}
        .landing-grid--2-col-desktop.p-cards_style_1 .landing-block--product-content--top{
            min-height: unset;
        }
    }
</style>

{%- assign _p_html = schema_settings.remind_policy | replace: '"', "'" -%}
<script id="landing-product-config" type="application/json">
    {
        "remind_title": "{{schema_settings.remind_title | escape}}",
        "remind_des": "{{schema_settings.remind_des | escape}}",
        "remind_email_place": "{{schema_settings.remind_email_place | escape}}",
        "remind_email_error": "{{schema_settings.remind_email_error | escape}}",
        "remind_email_empty": "{{schema_settings.remind_email_empty | escape}}",
        "remind_policy": "{{_p_html}}",
        "remind_policy_error": "{{schema_settings.remind_policy_error | escape}}",
        "remind_submit": "{{schema_settings.remind_submit | escape}}",
        "remind_tag": "{{schema_settings.remind_tag | escape}}",
        "remind_success_tip": "{{schema_settings.remind_success_tip | escape}}",
        "remind_error_tip": "{{schema_settings.remind_error_tip | escape}}"
    }
</script>
{%- assign p_cates = shop.metaobjects.landing_product_block[schema_settings.handle] -%}
<div string-remind_success_tip="{{schema_settings.remind_success_tip | escape}}" string-remind_error_tip="{{schema_settings.remind_error_tip | escape}}" class="landing-block--product color-{{ schema_settings.color_scheme }} {%if schema_settings.align_between==false%} unmin-card{% endif %}" {%if schema_settings.anchor_id != blank%}anchor={{schema_settings.anchor_id | escape}}{% endif %} style="background:var(--color-background);--padding-bottom:{{schema_settings.padding_bottom}}px;--padding-top:{{schema_settings.padding_top}}px;--columns-gap:{{schema_settings.columns_gap}}px;--btns-font-size:{{schema_settings.btns_font_size}}px;--pc-bg-img:url('{{schema_settings.pc_bg_img | image_url: width: 3840}}');--mb-bg-img:url('{{schema_settings.mb_bg_img | image_url: width: 1024}}');--btn-svg-bg:{{ schema_settings.text_bg }}" {% if schema_settings.pc_bg_img != blank%}has-pc-bg{% endif %}  {% if schema_settings.mb_bg_img != blank%}has-mb-bg{% endif %}>
    {%- if schema_settings.block_title != blank -%}
        <div class="section-container landing-product--block-title" style="color: {{schema_settings.block_title_color}};--block_title_size:{{schema_settings.block_title_size}}px;--block_title_bottom:{{schema_settings.block_title_bottom}}px;">{{schema_settings.block_title | newline_to_br}}</div>
    {%- endif -%}

    {%- if schema_settings.block_sub_title != blank -%}
        <div class="section-container landing-product--block-sub-title" style="color: {{schema_settings.block_sub_title_color}};--block_sub_title_size:{{schema_settings.block_sub_title_size}}px;--block_sub_title_bottom:{{schema_settings.block_sub_title_bottom}}px;">{{schema_settings.block_sub_title | newline_to_br}}</div>
    {%- endif -%}

    {%- assign sb_types = 'Multiple_tags' -%}
    {%- if schema_settings.show_tabs == false -%}
        {%- assign sb_types = 'Single_tags' -%}
    {%- endif -%}

    <jky-landing-collections>
        <div class="landing-block--product-main section-container {%if schema_settings.mb_colums_2==true%} landing-col-grid--mb-2{% endif %} {%if schema_settings.open_swiper==true%} swiper_mode{% endif %}">
            {%- if schema_settings.show_tabs == true -%}
            <div class="landing-block--product-tabs color-{{ schema_settings.color_scheme_tab }}">
                {%- if schema_settings.all_txt != blank -%}
                    <div class="landing-block--product-tab active" data-handle="all" data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}">{{schema_settings.all_txt | escape}}</div>
                {%- endif -%}
                {%- for cate in p_cates.cate_list.value -%}
                    <div class="landing-block--product-tab" data-handle="{{cate.title | handleize}}" data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}">{{cate.title | escape}}</div>
                {%- endfor -%}
            </div>
            {%- endif -%}

            {%- if schema_settings.all_txt != blank and schema_settings.show_tabs == true -%}
                {%- assign all_items = '' -%}
                {%- for cate in p_cates.cate_list.value -%}
                    {%- for card in cate.list.value -%}
                        {%- if card.variant.value.id != blank -%}
                            {%- assign _id_handle = card.variant.value.id | handle -%}
                            {%- if all_items contains _id_handle -%}{%- else -%}
                                {%- assign all_items = all_items | append: _id_handle | append: ',' -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                {%- endfor -%}

                <jky-landing-collectionitem target-handle="all" class="active {%if schema_settings.open_swiper==true%} col-swiper{% endif %}">
                    {%- assign swiper_size_all = 0 -%}
                    <div class="landing-block--product-cate {%if schema_settings.open_swiper==true%} swiper-wrapper{% endif %}">
                        {%- for cate in p_cates.cate_list.value -%}
                            {%- for card in cate.list.value -%}
                                {%- if card.variant.value.id != blank -%}
                                    {%- assign swiper_size_all = swiper_size_all | plus: 1 -%}
                                    {%- if all_items contains card.variant.value.id -%}
                                    {%- assign all_items = all_items | replace: card.variant.value.id, '' -%}
                                    {% assign act_time_end = card.act_time_end.value | date: '%s' %}
                                    {% assign act_time_start = card.act_time.value | date: '%s' %}
                                    {%- assign time_now = 'now' | date: '%s' -%}
                                    {%- assign product_card = card.variant.value -%}

                                    {% comment %} 活动是否进行 {% endcomment %}
                                    {%- assign has_act = false -%}
                                    {% comment %} 是否有活动 {% endcomment %}
                                    {%- assign has_act_active = false -%}
                                    {%- if card.act_time.value != blank and card.act_time_end.value != blank -%}
                                        {%- assign has_act_active = true -%}
                                        {%- if act_time_start < time_now and act_time_end > time_now and act_time_start < act_time_end -%}
                                            {% comment %} 活动进行中 {% endcomment %}
                                            {%- assign has_act = true -%}
                                        {%- endif -%}
                                    {%- endif -%}

                                    {% comment %} 初始值 {% endcomment %}
                                    {%- assign current_price = product_card.price -%}
                                    {%- assign current_origin_price = product_card.compare_at_price | default: product_card.price -%}

                                    {% comment %} 如果配置了产品价格，则取产品价格 {% endcomment %}
                                    {%- if has_act -%}
                                        {%- if card.price.value != blank -%}
                                            {%- assign current_price = card.price.value | times: 100.00 -%}
                                        {%- elsif settings.open_auto_discount_price and settings.display_auto_discount_price_in_activity_page %}
                                            {% comment %} 如果开启了全局的 自动计算折扣价，并且开启了 活动页内展示自动计算折扣价 {% endcomment %}
                                            {% comment %} 自动计算 - 折后价格 {% endcomment %}
                                            {%- assign auto_discount_price = product_card.metafields.custom.auto_discount_price | times: 1 -%}
                                            {%- if auto_discount_price > 0 and auto_discount_price < product_card.price -%}
                                                {%- assign current_price = auto_discount_price -%}
                                            {%- else -%}
                                                {%- assign current_price = product_card.price -%}
                                            {%- endif -%}
                                        {%- endif -%}
                                    {%- else -%}
                                        {%- if settings.open_auto_discount_price and settings.display_auto_discount_price_in_activity_page %}
                                            {% comment %} 如果开启了全局的 自动计算折扣价，并且开启了 活动页内展示自动计算折扣价 {% endcomment %}
                                            {% comment %} 自动计算 - 折后价格 {% endcomment %}
                                            {%- assign auto_discount_price = product_card.metafields.custom.auto_discount_price | times: 1 -%}
                                            {%- if auto_discount_price > 0 and auto_discount_price < product_card.price -%}
                                                {%- assign current_price = auto_discount_price -%}
                                            {%- else -%}
                                                {%- assign current_price = product_card.price -%}
                                            {%- endif -%}
                                        {%- endif -%}
                                    {%- endif -%}

                                    {% comment %} 如果配置了产品原价，则取产品原价 {% endcomment %}
                                    {%- if has_act -%}
                                        {%- if card.origin_price.value != blank -%}
                                            {%- assign current_origin_price = card.origin_price.value | times: 100.00 -%}
                                        {%- else -%}
                                            {%- if current_origin_price < product_card.price -%}
                                                {%- assign current_origin_price = product_card.price -%}
                                            {%- endif -%}
                                        {%- endif -%}
                                    {%- else -%}
                                        {%- if current_origin_price < product_card.price -%}
                                            {%- assign current_origin_price = product_card.price -%}
                                        {%- endif -%}
                                    {%- endif -%}


                                    <jky-landing-product
                                        style="background:{{ schema_settings.bgColor }};border: {{ schema_settings.border }}px solid {{ schema_settings.border_color }}; --pc-bg-single-img:url('{{schema_settings.pc_bg_single_img | image_url: width: 3840}}');--mb-bg-single-img:url('{{schema_settings.mb_bg_single_img | image_url: width: 1024}}')"
                                        card_style="{{schema_settings.cards_style}}"
                                        pid="{{product_card.id}}"
                                        has_act_active="{{has_act_active}}"
                                        has_act="{{has_act}}"
                                        {%if card.act_time.value != blank%}data-start="{{act_time_start}}" {% endif %}
                                        {%if card.act_time_end.value != blank%} data-end="{{act_time_end}}" {% endif %}
                                        data-actprice="{%if card.price.value != blank%}{{card.price.value | times: 100.00 | money | remove_last: '.00'}}{% else %}{{current_price | money | remove_last: '.00'}}{% endif %}"
                                        data-price="{{current_price | money | remove_last: '.00'}}"
                                        class="landing-grid--{{schema_settings.columns_desktop}}-col-desktop p-{{schema_settings.cards_style}} {%if schema_settings.mb_colums_2==true%} landing-grid--mb-2{% endif %}  {%if schema_settings.open_swiper==true%} swiper-slide{% endif %}"
                                        {% if schema_settings.pc_bg_single_img != blank%} has-pc-bg {% endif %}
                                        {% if schema_settings.mb_bg_single_img != blank%} has-mb-bg {% endif %}
                                    >
                                        <div class="landing-block--product-card flex">
                                            <div class="landing-block--product-media relative" style="background:{{schema_settings.mediao_bg_color}};">
                                                {% comment %} 样式1折扣角标（US）- 左上 / 样式1折扣角标（US）- 右上 {% endcomment %}
                                                {%- if schema_settings.cards_style == "cards_style_1" -%}
                                                    {%- if card.amount_discount.value != blank and card.fk_icon.value != blank -%}
                                                        <div class="absolute landing-block--product-discount-tag--1 text-overflow-1" style="color:{{ schema_settings.text_color3}}">
                                                            <img src="{{card.fk_icon.value | image_url: width: 260}}" alt="discount" loading="lazy" />
                                                            <span></span>
                                                        </div>
                                                    {%- else -%}
                                                        {%- if card.awards_icon.value != blank -%}
                                                            <img class="absolute landing-block--product-awards-img--1" src="{{card.awards_icon.value | image_url: width: 240}}" loading="lazy" />
                                                        {%- endif -%}
                                                    {%- endif -%}

                                                    {%- if card.card_right_tag_1.value != blank -%}
                                                        <div class="absolute landing-block--product--ptag--1">{{card.card_right_tag_1.value}}</div>
                                                    {%- endif -%}
                                                {%- else -%}
                                                    {% comment %} 样式2折扣角标（US）- 左上 / 样式2折扣角标（US）- 右上 {% endcomment %}
                                                    {%- if card.awards_icon.value != blank -%}
                                                        <img class="absolute landing-block--product-awards-img--2" src="{{card.awards_icon.value | image_url: width: 240}}" alt="{{card.awards_icon.value.alt | escape}}" loading="lazy" />
                                                    {%- endif -%}

                                                    {%- if card.card_right_tag_2.value != blank -%}
                                                        <div class="absolute flex landing-block--product-discount-tag--2">
                                                            <div class="tag--2--content flex {%if product_card.metafields.custom.discount_tag_time == blank %} tag--2--content--notime{% endif %}">
                                                                <span class="text--primary">{{card.card_right_tag_2.value}}</span>
                                                                {%- if product_card.metafields.custom.discount_tag_time != blank -%}
                                                                    <span>{{product_card.metafields.custom.discount_tag_time}}</span>
                                                                {%- endif -%}
                                                            </div>
                                                        </div>
                                                    {%- endif -%}
                                                {%- endif -%}

                                                {%- if card.product_img.value != blank -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{card.product_img.value | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        <img class="landing-block--product-pimg pc-show" data-src="{{product_card.url}}" src="{{card.product_img.value | image_url: width: 640}}" alt="{{card.product_img.value.alt | escape}}" loading="lazy" />
                                                    </a>
                                                {%- else -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{product_card.featured_image | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        <img class="landing-block--product-pimg p--link pc-show" data-src="{{product_card.url}}" src="{{product_card.featured_image | image_url: width: 640}}" alt="{{product_card.featured_image.value.alt | escape}}" loading="lazy" />
                                                    </a>
                                                {%- endif -%}

                                                {% comment %} pcmb区分图片 {% endcomment %}
                                                {%- if card.product_mb_img.value != blank -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{card.product_mb_img.value | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        <img class="landing-block--product-pimg mb-show" data-src="{{product_card.url}}" src="{{card.product_mb_img.value | image_url: width: 640}}" alt="{{card.product_img.value.alt | escape}}" loading="lazy" />
                                                    </a>
                                                {%- elsif card.product_img.value != blank -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{card.product_img.value | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        <img class="landing-block--product-pimg mb-show" data-src="{{product_card.url}}" src="{{card.product_img.value | image_url: width: 640}}" alt="{{card.product_img.value.alt | escape}}" loading="lazy" />
                                                    </a>
                                                {%- else -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{product_card.featured_image | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        <img class="landing-block--product-pimg p--link mb-show" data-src="{{product_card.url}}" src="{{product_card.featured_image | image_url: width: 640}}" alt="{{product_card.featured_image.value.alt | escape}}" loading="lazy" />
                                                    </a>
                                                {%- endif -%}
                                            </div>
                                            <div class="landing-block--product-content flex">
                                                {%- if schema_settings.columns_desktop != 2 or schema_settings.cards_style != "cards_style_2" -%}
                                                    <div class="landing-block--product-content--top">
                                                        <a href="{{product_card.url}}" style="color:{{ schema_settings.text_color1 }}" class="landing-block--product-ptitle text-overflow-2" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-type="{{sb_types}}">
                                                            {%- if card.title.value != blank -%}
                                                                {{card.title.value | escape}}
                                                            {%- else -%}
                                                                {{product_card.title | escape | strip | replace: 'Jackery', ''}}
                                                            {%- endif -%}
                                                        </a>
                                                        {%- if card.subtitle.value != blank -%}
                                                            <div class="landing-block--product-psubtitle text-overflow-2" style="color:{{ schema_settings.text_color1 }}">{{card.subtitle.value | escape | strip}}</div>
                                                        {%- endif -%}
                                                    </div>
                                                {%- endif -%}

                                                <div class="landing-block--product-content--bottom flex">
                                                    <div class="landing-block--product-pmain--top">
                                                        {%- if schema_settings.columns_desktop == 2 and schema_settings.cards_style == "cards_style_2" -%}
                                                            <div class="cards-style-2--block flex">
                                                        {%- endif -%}

                                                        {%- if schema_settings.columns_desktop == 2 and schema_settings.cards_style == "cards_style_2" -%}
                                                            <div class="landing-block--product-pmain--titles">
                                                                <a style="color:{{ schema_settings.text_color1 }}" class="landing-block--product-ptitle text-overflow-1" href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-type="{{sb_types}}">
                                                                    {%- if card.title.value != blank -%}
                                                                        {{card.title.value | escape}}
                                                                    {%- else -%}
                                                                        {{product_card.title | escape | strip | replace: 'Jackery', ''}}
                                                                    {%- endif -%}
                                                                </a>
                                                                {%- if card.subtitle.value != blank -%}
                                                                    <div class="landing-block--product-psubtitle text-overflow-1" style="color:{{ schema_settings.text_color1 }}">{{card.subtitle.value | escape | strip}}</div>
                                                                {%- endif -%}
                                                            </div>
                                                        {%- endif -%}

                                                        <div class="landing-block--product-price flex flex-wrap" >
                                                            <span class="p-price" style="color:{{ schema_settings.text_color2}}">
                                                                {%- if has_act == true -%}
                                                                    <span data-price="{{current_price | money | remove_last: '.00'}}">{{current_price | money | remove_last: '.00'}}</span>
                                                                {%- else -%}
                                                                    {{current_price | money | remove_last: '.00'}}
                                                                {%- endif -%}
                                                            </span>

                                                            {%- if current_origin_price > current_price -%}
                                                                {%- assign _a_act = current_origin_price | minus: current_price | divided_by: 100.00 | floor | times: 100 | money | remove_last: '.00' -%}
                                                                {%- assign display_discount_num = card.amount_discount.value | replace: '{amount}', _a_act -%}
                                                            {%- else -%}
                                                                {%- assign _a_act = '' -%}
                                                                {%- assign display_discount_num = '' -%}
                                                            {%- endif -%}
                                                            <script type="application/json">
                                                                {
                                                                    "has_act_active": {{has_act_active}},
                                                                    "has_act": {{has_act_active}},
                                                                    "display_discount_num": "{{display_discount_num}}",
                                                                    "Installment_text": "{{card.Installment_text.value}}",
                                                                    {%- if card.init_num.value != blank -%}
                                                                        "init_num": {{card.init_num.value}},
                                                                    {%- endif -%}
                                                                    {%- if card.act_time.value != blank -%}
                                                                        "act_time": {{card.act_time.value | date: '%s' }},
                                                                    {%- endif -%}
                                                                    {%- if card.act_time_end.value != blank -%}
                                                                        "act_time_end": {{card.act_time_end.value | date: '%s' }},
                                                                    {%- endif -%}
                                                                    {%- if card.unavailable_sold_txt.value != blank -%}
                                                                        "unavailable_sold_txt": "{{card.unavailable_sold_txt.value }}",
                                                                    {%- endif -%}
                                                                    {%- if card.available_sold_txt.value != blank -%}
                                                                        "available_sold_txt": "{{card.available_sold_txt.value }}",
                                                                    {%- endif -%}
                                                                    "price_num": {{product_card.price | divided_by: 100.00}},
                                                                    "id": {{product_card.id}}
                                                                }
                                                            </script>

                                                            {%- if current_origin_price > current_price -%}
                                                                <span class="p-origin-price" style="color:{{ schema_settings.text_color1 }}">{{current_origin_price | money | remove_last: '.00'}}</span>
                                                            {%- endif -%}
                                                            {%- if card.amount_discount.value != blank -%}
                                                                <span class="p-discount" style="color:{{ schema_settings.text_color2 }}"></span>
                                                            {%- endif -%}
                                                        </div>
                                                        {%- if schema_settings.columns_desktop == 2 and schema_settings.cards_style == "cards_style_2" -%}</div>{%- endif -%}

                                                        {%- if schema_settings.columns_desktop == 2 and schema_settings.cards_style == "cards_style_2" -%}<div class="cards-style-2--block cards-style-2--block-sec flex">{%- endif -%}
                                                            {%- if schema_settings.columns_desktop == 2 and schema_settings.cards_style == "cards_style_2" -%}<div class="div--block">{%- endif -%}
                                                                {%- if card.available_sold_txt.value != blank or card.unavailable_sold_txt.value != blank -%}
                                                                    {%- if schema_settings.show_progress == true -%}
