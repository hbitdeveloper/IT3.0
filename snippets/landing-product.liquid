    .landing-block--product-awards-img--1 {left: 0;width: 120px;z-index: 1;}
    .landing-block--product--ptag--1 {right: 21px;top:20px;color: var(--jds-color-primary);font-weight: 600;font-size: 14px;z-index: 1;}
    .landing-block--product-awards-img--2 {left: 0;width: 120px;z-index: 1;}
    .landing-block--product-discount-tag--2 {right: 0;width: 120px;height: 120px;z-index: 1;}
