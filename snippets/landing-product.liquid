{% comment %} 活动页-产品组件 {% endcomment %}
<style>
    a[disabled] {pointer-events: none;}
    .swiper_mode .swiper-button-next, .swiper_mode .swiper-button-prev {position: absolute;top: 50%;transform: translateY(-50%);background-color: rgba(0, 0, 0, 0.3);width: 48px;height: 48px;display: flex;align-items: center;justify-content: center;transition: all 0.3s ease;z-index: 3;cursor: pointer;border-radius: 50%;}
    .swiper_mode .swiper-button-next.swiper-button-disabled, .swiper_mode .swiper-button-prev.swiper-button-disabled {display: none;}
    .swiper_mode .arrow-icon {width: 10px;height: 20px;background-size: cover;background-position: center;background-repeat: no-repeat;background-image: url(data:image/svg+xml;base64,);}
    .swiper_mode .swiper-button-next:after, .swiper_mode .swiper-button-prev:after {display:none;}
    .swiper_mode .swiper-button-next:hover,.swiper_mode .swiper-button-prev:hover {background-color: rgba(0, 0, 0, 0.4);}
    .swiper_mode .swiper-button-next .arrow-icon {transform: rotate(180deg);}

    .landing-block--product {background: rgba(234, 234, 234, 1);padding-top: var(--padding-top);padding-bottom:var(--padding-bottom);}
    .landing-block--product[has-pc-bg] {background-image:var(--pc-bg-img)!important;background-repeat: no-repeat!important;background-size: cover!important;}
    .landing-block--product .section-container {width: 1440px;padding: 0 58px;}

    {% comment %} cate tabs{% endcomment %}
    .landing-block--product-tabs {display: flex;flex-wrap: wrap;gap: 16px;margin-bottom:25px;justify-content: center;}
    body .landing-block--product .landing-block--product-tab {height: 40px;color: var(--color-text);border-radius: 40px;line-height: 40px!important;padding: 0 24px;font-size: 16px;background: var(--color-secondary-button-text);cursor: pointer;transition: all .24s ease;user-select: none;}
    .landing-block--product-tab:hover {background: rgba(0,0,0,0.1);}
    body .landing-block--product-tab:active,body .landing-block--product-tab.active {background: var(--color-button);color:var(--color-button-text);}

    {% comment %} collection item {% endcomment %}
    .landing-block--product-cate:not(.swiper_mode .landing-block--product-cate) {display: flex; margin-bottom: var(--columns-gap);}
    jky-landing-product {width: 25%;display: block;background: #ffffff;border-radius: 15px;overflow: hidden;}
    .landing-grid--4-col-desktop {width: calc((100% - var(--columns-gap) * 3)/4);}
    .landing-grid--3-col-desktop {width: calc((100% - var(--columns-gap) * 2)/3);}
    .landing-grid--2-col-desktop {width: calc((100% - var(--columns-gap) * 1)/2);}
    .landing-block--product-cate:not(.swiper_mode .landing-block--product-cate) {flex-wrap: wrap;gap: var(--columns-gap);}
    .swiper_mode jky-landing-product {height:unset;}
    .swiper_mode jky-landing-collectionitem {overflow: hidden;}
    .swiper_mode .col-swiper {margin: 0 65px;position:relative;}

    {% comment %} product card {% endcomment %}
    .landing-block--product-card {flex-direction: column;height: 100%;}
    .landing-block--product-media {height: 244px;text-align: center;background: #ffffff; overflow: hidden;}
    .landing-block--product-media:hover .landing-block--product-pimg{transform: scale(1.03);}
    .landing-grid--2-col-desktop .landing-block--product-media {height: 300px;overflow: hidden;}
    .landing-block--product-pimg {height: 100%;width: auto; transition: all .3s;}
    .landing-block--product-content {padding: 20px 24px 24px 24px;width: 100%;flex-direction: column;flex: 1;}
    .landing-grid--3-col-desktop .landing-block--product-content {padding: 20px 32px 32px 32px;}
    .landing-block--product-content--top {padding-bottom: 20px;border-bottom: none;width: 100%;min-height: 129px;}
    .unmin-card .landing-block--product-content--top {min-height: unset;}
    .landing-grid--2-col-desktop .landing-block--product-content--top {text-align: center;min-height: 60px;padding-bottom: 0px;border-bottom: none;}
    .landing-grid--2-col-desktop.p-cards_style_1 .landing-block--product-content--top {margin-bottom: 10px;}
    .landing-block--product-ptitle {font-weight: 600;font-size: 20px;color: rgba(26, 26, 26, 1);line-height: 28px;}
    .landing-grid--2-col-desktop .landing-block--product-ptitle {-webkit-line-clamp: 1;font-size: 24px;line-height: 32px;}
    .landing-block--product-psubtitle {margin-top: 8px;font-weight: 400;font-size: 14px;line-height: 22px;color: rgba(0, 0, 0, 0.6);}
    .landing-grid--2-col-desktop .landing-block--product-psubtitle {-webkit-line-clamp: 1;font-size: 16px;color: rgba(0, 0, 0, 0.7);font-style: italic;font-weight: normal;}
    .landing-block--product-content--bottom {padding-top: 0px;flex:1;flex-direction: column;justify-content: space-between;gap: 24px;}
    .landing-grid--2-col-desktop .landing-block--product-content--bottom {flex-direction: row;}
    .landing-block--product-price {column-gap: 10px;align-items: baseline;width: max-content;max-width: 100%;}
    .p-cards_style_2.landing-grid--2-col-desktop .landing-block--product-price {flex-wrap: wrap;width: 164px;justify-content: flex-end;column-gap: 8px;}
    .landing-block--product-price .p-price {color: var(--jds-color-primary);font-size: 24px;font-weight: 600;}
    .p-cards_style_2.landing-grid--2-col-desktop .landing-block--product-price .p-price {display: block;width: 100%;text-align: right;font-size: 28px;}
    .p-cards_style_2.landing-grid--2-col-desktop .landing-block--product-price .p-discount, .p-cards_style_2.landing-grid--2-col-desktop .landing-block--product-price .p-origin-price {-webkit-box-orient: vertical;
    display: -webkit-box;-webkit-line-clamp: 1;overflow: hidden;}
    .landing-block--product-price .p-origin-price {color: rgba(0, 0, 0, 0.4);font-size: 14px;font-weight: 400;text-decoration: line-through;}
    .landing-block--product-price .p-discount {color: color-mix(in srgb, var(--jds-color-primary), transparent 40%);font-size: 14px;font-weight: 400;}
    .landing-block--product-affirm {color: rgba(0, 0, 0, 0.6);font-size: 12px;font-weight: 500;gap: 6px;margin-top: 16px;align-items: flex-end;line-height: 1;opacity: 0;}
    .landing-block--product-affirm.active {opacity: 1;}
    .landing-grid--2-col-desktop .landing-block--product-affirm {margin-top: 6px;}
    .landing-block--product-affirm img {object-fit: contain;height: 20px;}
    .landing-block--product-pmain--bottom a:nth-child(n+3) {display: none;}
    .landing-block--product-pmain--bottom a.sold-out{padding: 0;}
    .landing-grid--2-col-desktop .landing-block--product-pmain--bottom a {width: max-content;padding: 0 16px;}
    .landing-block--product-pmain--bottom {flex-wrap: wrap;gap: 12px;}
    .landing-grid--2-col-desktop .landing-block--product-pmain--bottom {flex-wrap: nowrap;flex: 1;justify-content: flex-end;align-items: center;gap: 8px;}
    .landing-block--product-pmain--bottom a{position: relative;}
    .landing-block--product-pmain--bottom a {width: 100%;height: 40px;border-radius: var(--theme-btn-border-radius, 30px);font-size: var(--btns-font-size);font-weight: 600;display: flex;justify-content: center;align-items: center;user-select: none;
    color: var(--a-col);background-color: transparent;border: 2px solid var(--a-col);transition: .3s;}
    .landing-block--product-pmain--bottom a .loading__spinner {display:none;}
    .landing-block--product-pmain--bottom a.loading .loading__spinner {display:block;}
    .landing-block--product-card .landing-block--product-pmain--bottom a.loading {background: color-mix(in srgb, var(--jds-color-primary), transparent 32%);color: transparent;pointer-events: none;border: solid 2px transparent;}
    .landing-block--product-pmain--bottom a:hover {opacity: 0.8;}
    .landing-block--product-pmain--bottom a:active {opacity: 1;color: #fd2f00;border: 2px solid #fd2f00;background-color: #fff;}
    .landing-block--product-pmain--bottom a[btn-solid] {background: var(--a-col);color: var(--a-solid-bg); height: 40px;}
    .landing-block--product-pmain--bottom a.index-button{--index-button-text: var(--btns-font-size);}
    .landing-block--product-pmain--bottom a[btn-solid] .arrow { height: 26px; width: 26px; background: var(--btn-svg-bg)}
    .landing-block--product-pmain--bottom a[btn-solid] .arrow svg { color: var(--a-solid-bg)}
    .landing-block--product-pmain--bottom a[btn-solid]:active {color: #ffffff;border: 2px solid #fd2f00;background-color: #fd2f00;}
    .landing-block--product-progress {opacity: 0;height: 0;overflow: hidden;margin-top: 0;}
    .landing-block--product-progress.active {opacity: 1;height: auto;overflow: unset;margin-top: 20px;}
    .landing-grid--2-col-desktop .landing-block--product-progress.active {width: 240px;}
    .landing-block--product-progress input {width: 100%;height: 100%;margin: 0;position: absolute;top: 0;left: 0;z-index: 2;background: transparent;outline: 0;border: 0;opacity: 0;}
    .landing-block--product-progress .jk-seekbar-progress {height: 6px;border-radius: 4px;background: color-mix(in srgb, var(--jds-color-primary), transparent 90%);}
