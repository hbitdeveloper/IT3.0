                                {%- assign swiper_size = forloop.index -%}
                                {% assign act_time_end = card.act_time_end.value | date: '%s' %}
                                {% assign act_time_start = card.act_time.value | date: '%s' %}
                                {%- assign time_now = 'now' | date: '%s' -%}
                                {%- assign product_card = card.variant.value -%}

                                {% comment %} 活动是否进行 {% endcomment %}
                                {%- assign has_act = false -%}
                                {% comment %} 是否有活动 {% endcomment %}
                                {%- assign has_act_active = false -%}
                                {%- if card.act_time.value != blank and card.act_time_end.value != blank -%}
                                    {%- assign has_act_active = true -%}
                                    {%- if act_time_start < time_now and act_time_end > time_now and act_time_start < act_time_end -%}
                                        {% comment %} 活动进行中 {% endcomment %}
                                        {%- assign has_act = true -%}
                                    {%- endif -%}
                                {%- endif -%}

                                {% comment %} 初始值 {% endcomment %}
                                {%- assign current_price = product_card.price -%}
                                {%- assign current_origin_price = product_card.compare_at_price | default: product_card.price -%}

                                {% comment %} 如果配置了产品价格，则取产品价格 {% endcomment %}
                                {%- if has_act -%}
                                    {%- if card.price.value != blank -%}
