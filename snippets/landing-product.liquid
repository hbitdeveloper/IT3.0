    .landing-block--product-progress .jk-seekbar-progress [role="progressbar"]:after {content: " ";display: block;width: 18px;height: 11px;position: absolute;top: 50%;right: 0;background-color: #ffffff;border-radius: 11px;box-shadow: 0px 2px 9px 0px color-mix(in srgb, var(--jds-color-primary), transparent 50%);transform: translate(50%, -50%);}
    .landing-block--product-progress .jk-seekbar-progress [role="progressbar"]:before {content: " ";display: block;width: 13px;height: 6px;position: absolute;top: 50%;right: 0;background-color: var(--before-col);border-radius: 4px;transform: translate(50%, -50%);z-index: 2;}
    .landing-block--product-progress--content {margin-top: 6px;justify-content: space-between;font-size: 14px;font-weight: 400;gap: 5px;}
    .landing-block--product--sold {text-align: left;color: var(--jds-color-primary);flex:1;}
    .landing-block--product--unsold {text-align: right;color: rgba(0, 0, 0, 0.6);flex:1;}
    .landing-block--product-discount-tag--1 {width: 138px;font-weight: 600;font-size: 16px;text-align: center;overflow: hidden;color: #ffffff;display: none; z-index: 1;}
