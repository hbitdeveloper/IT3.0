<script id="smartshop-scene-main-json" type="application/json">
  {{ shop.metafields.custom.smartshop_scene_main.value | json }}
</script>

{%- liquid
  assign scenes_raw = shop.metafields.custom.smartshop_scene_main.value
  assign scenes_list = scenes_raw
  if scenes_raw != blank
    if scenes_raw.data != blank
      assign scenes_list = scenes_raw.data
    endif
  endif
-%}

{%- if scenes_list != blank -%}
  <template id="smartshop-scene-main-html">
    {%- for item in scenes_list limit: 4 -%}
      {%- liquid
        assign id = item.sceneMainId
        assign name = item.sceneMainName | strip
        assign img = item.sceneMainImagePc | strip | replace: '`', ''
        assign loading = 'lazy'
        assign fetchpriority = 'auto'
        if forloop.index0 < 2
          assign loading = 'eager'
          assign fetchpriority = 'high'
        endif
      -%}
      {%- if id != blank and name != blank and img != blank -%}
        <div class="w-full flex items-center justify-start flex-col cursor-pointer bg-[#fff] border-solid border-[#FFFFFF] border-2 lg:hover:border-[var(--jds-color-primary)] p-2 lg:p-4 group lg:hover:shadow-lg usage-item" data-value="{{ id | escape }}">
          <div class="w-full h-[6.75rem] lg:h-[13.125rem] flex items-center justify-center mb-4 lg:mb-6 relative overflow-hidden">
            <div class="absolute inset-0 bg-[#EEE]"></div>
            <img src="{{ img | escape }}" alt="{{ name | escape }}" class="w-full h-full object-contain relative z-[1]" loading="{{ loading }}" fetchpriority="{{ fetchpriority }}" decoding="async" width="1" height="1">
          </div>
          <div class="scene-main-name text-sm lg:text-xl text-[#242F20] font-bold text-center">{{ name }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </template>
{%- endif -%}
