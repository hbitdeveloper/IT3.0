<style>
    .activity-des .activity-des-pc{padding-top: var(--padding-top);padding-bottom:var(--padding-bottom);font-size: var(--text-size);}
    .activity-des .activity-des-mb{padding-top: var(--padding-top);padding-bottom:var(--padding-bottom);font-size: var(--text-size);}
    .activity-des ul,
    .activity-des ul li{
        list-style: inside;
    }

    .activity-des ol,
    .activity-des ol li{
        list-style: decimal;
        list-style-position: inside;
    }

    .extra-empty {
        height: 1em;
    }
</style>

{% assign activeColor = '<em style="color: ' | append: settings.text_active | append: '">' %}
<div class="activity-des color-{{ settings.color_scheme }}" {%if settings.anchor_id != blank%}anchor={{settings.anchor_id | escape}}{%endif%} style="background:{{ settings.bg_color }};color:{{ settings.text_color }};">
    {%if settings.des_text_pc != blank%}
        <div class="show-pc activity-des-pc activity-container" style="--padding-top:{{ settings.padding_top_pc }}px;--padding-bottom:{{ settings.padding_bottom_pc }}px;--text-size:{{ settings.text_size_pc }}px;text-align: {{ settings.pc_position }};">
            {{ settings.des_text_pc | replace: '<em>', activeColor }}
        </div>
    {%endif%}
    {%if settings.des_text_mb != blank%}
        <div class="show-mb activity-des-mb activity-container" style="--padding-top:calc(({{ settings.padding_top_mb }}/750)*100vw);--padding-bottom:calc(({{ settings.padding_bottom_mb }}/750)*100vw);--text-size:calc(({{ settings.text_size_mb }}/750)*100vw);text-align: {{ settings.mb_position }};">
            {{ settings.des_text_mb | replace: '<em>', activeColor }}
        </div>
    {%endif%}
</div>
<script>
    (function () {
      function onReady(fn) {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', fn, { once: true });
          return;
        }
        fn();
      }

      document.addEventListener('click', function (event) {
        var target = event.target && event.target.closest('.activity-des a');
        if (!target) return;
        if (typeof gaPushDataLayer !== 'function') return;

        gaPushDataLayer('activity_page_user_clicks', {
          module: "Text Display",
          button_name: (target.textContent || '').trim(),
          link: target.getAttribute('href'),
        });
      });

      onReady(function () {
        var consecutiveEmptyCount = 0;
        document.querySelectorAll('.activity-des p').forEach(function (pEl) {
          if (((pEl.textContent || '')).trim() === '') {
            consecutiveEmptyCount++;
            if (consecutiveEmptyCount >= 2) {
              pEl.classList.add('extra-empty');
            }
          } else {
            consecutiveEmptyCount = 0;
          }
        });
      });
    })();
</script>
