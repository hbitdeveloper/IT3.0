{%- doc -%}
  Head中通用样式文件

  @example
  {% render 'head-styles' %}
{%- enddoc -%}

{% comment %} 颜色方案 {% endcomment %}
{%- render 'settings-color-schema' -%}

{% comment %} 设计系统 - Jackery Design System {% endcomment %}
{% assign jky_theme_version = settings.jky_theme_version | default: 'v4' %}
{%- if jky_theme_version == 'v4' -%}
  {{ 'plugin-jds-theme-v1.min.css' | asset_url | stylesheet_tag: preload: true }}
  <link rel="stylesheet" href="{{ 'plugin-jds-theme-v1.min.css' | asset_url }}">
{%- elsif jky_theme_version == 'v5' -%}
  {{ 'plugin-jds-theme-v2.min.css' | asset_url | stylesheet_tag: preload: true }}
  <link rel="stylesheet" href="{{ 'plugin-jds-theme-v2.min.css' | asset_url }}">
{%- elsif jky_theme_version == 'v5-eu' -%}
  {{ 'plugin-jds-theme-v3.min.css' | asset_url | stylesheet_tag: preload: true }}
  <link rel="stylesheet" href="{{ 'plugin-jds-theme-v3.min.css' | asset_url }}">
{%- endif -%}

{% comment %} 字体图标+品牌字体 {% endcomment %}
{% render 'head-font' %}

{% comment %} 全局公共样式 {% endcomment %}
{{ 'common-theme.min.css' | asset_url | stylesheet_tag: preload: true }}
<link rel="stylesheet" href="{{ 'common-theme.min.css' | asset_url }}">

{% comment %} 全局自定义封装组件样式 {% endcomment %}
{{ 'global-components.min.css' | asset_url | stylesheet_tag: preload: true }}
<link rel="stylesheet" href="{{ 'global-components.min.css' | asset_url }}">
