{% comment %}
  @params: attributes: Shopify 自定义，方便定位
  @params: settings: 设置
  @params: text: 文本
  @params 对话框滚动动画 
{% endcomment %}
<div class="scroll-animate" {{ attributes }}>
  <div class="container">
      <div class="container-contain">
        {%- for i in (1..5) -%}
          {%- assign str = 'dialog_' | append: i -%}
            {%- if settings[str] != blank -%}
              <div class="title"> <div class="title-content"> {{settings[str] | escape }}</div> </div>
            {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="bottom">
          <div class="text">{{ settings.text }} </div>
      </div>
  </div>
</div>
