<style>
  .diy-video-wrap {width: 100vw;}
  .diy-video-wrap jky-video{--video-ratio: 41.67%;}
  .diy-video-wrap picture{width:100%;}
  .diy-video-wrap .w-full{width:100%;}
  .diy-video-wrap .lg\:hidden {display:none;}
  .diy-video-wrap .lg\:block {display:block;}
  .diy-video-wrap .diy-video-text{margin-top:30px;width:1200px;text-align:center;font-size:12px;font-weight:400;color:#86868b;line-height:16px;}
  @media screen and (max-width: 1023px) {
    .diy-video-wrap jky-video {--video-ratio: 133.34%;}
    .diy-video-wrap .hidden {display:none;}
    .diy-video-wrap .block {display:block;}
    .diy-video-wrap .diy-video-text{margin-top:3.0666667vw;text-align:left;font-size:2.4vw;line-height:3.4666667vw;}
  }
</style>


{% comment %} PC {% endcomment %}
<div class="diy-video-wrap {{class}} ">
  {% if pcPoster != blank and pcUrl == blank -%}
    {%-
      render 'responsive-image', image: pcPoster, image_class: 'w-full hidden lg:block'
    -%}
  {%- endif -%}

  {%- if pcUrl != blank -%}
    {%-
      render 'jky-video',
      class: "jky-video--pc",
      poster: pcPoster,
      video_url: pcUrl,
      autoplay: autoplay,
      loop: loop,
      controls: controls
    -%}
  {%- endif -%}

  {% comment %} Mobile {% endcomment %}
  {% if mbPoster != blank and mbUrl == blank  -%}
    {%- render 'responsive-image', mimage: mbPoster, image_class: 'w-full block lg:hidden' -%}
  {%- endif -%}

  {%- if mbUrl != blank -%}
    {%-
      render 'jky-video',
      class: "jky-video--mb",
      poster: mbPoster,
      mbPoster: mbPoster,
      video_url: mbUrl,
      autoplay: autoplay,
      loop: loop,
      controls: controls
    -%}
  {%- endif -%}
  {%- if text != blank -%}
    <div class="diy-video-text section-container">
      {{ text }}
    </div>
  {%- endif -%}
</div>
