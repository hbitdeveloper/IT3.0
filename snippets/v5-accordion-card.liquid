{% doc %}
   @description  产品手风琴
   @param {object} setting 设置

   @example
    {% render 'v5-accordion-card', curr_select_variant_id: curr_variant_id, setting: block.settings, index: forloop.index %}
{% enddoc %}

{% style %}
  v5-accordion .accordion-card {
    border: 1px solid #e5e5e5;
    transition: box-shadow 0.3s ease;
  }
  v5-accordion .accordion-card.accordion-card-select {
    box-shadow: 0 4px 12px rgba(0,0,0,.08);
  }

  v5-accordion .accordion-content {
    height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-5px);
    transition: height 0.35s ease, opacity 0.35s ease, transform 0.35s ease;
}
v5-accordion .accordion-card.accordion-card-select .accordion-content {
    margin-top: 1rem;
    opacity: 1;
    transform: translateY(0);
}

  v5-accordion .accordion-card .accordion-toggle .tag {
    transition: all 0.3s ease;
  }

  v5-accordion .accordion-card .icon .horizontal,
  v5-accordion .accordion-card .icon .vertical {
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  v5-accordion .accordion-card.accordion-card-select .icon .vertical {
    transform: scaleY(0);
    opacity: 0;
  }

  /* 5.0主题按钮 */
  .jky-v5 [accordion-add-to-cart] {
    border-radius: 0;
  }
{% endstyle %}

{% liquid
  assign product = setting.product
  assign variant = product.variants | where: "id", setting.variant_id | where: "available", true | first | default: product.selected_or_first_available_variant
  # 标题
  assign title = variant.title
  if title == 'Default Title'
    assign title = product.title
  endif

  # 价格（含自动折扣逻辑）
  if settings.open_auto_discount_price
    assign auto_discount_price = variant.metafields.custom.auto_discount_price | times: 1
    if auto_discount_price > 0
      assign current_price = variant.price
      if auto_discount_price < variant.price
        assign current_price = auto_discount_price
      endif
    else
      assign current_price = variant.price
    endif
  else
    assign current_price = variant.price
  endif

  # 划线价
  if variant.compare_at_price > current_price
    assign compare_at_price = variant.compare_at_price
  else
    if variant.price > current_price
      assign compare_at_price = variant.price
    else
      assign compare_at_price = blank
    endif
  endif
%}

<div class="p-2 lg:p-4 mb-4 lg:mb-6 bg-[#fff] rounded-lg accordion-card" data-id="{{ variant.id }}">
  {% comment %} 头部：标签 + 图标 {% endcomment %}
  <div class="accordion-toggle group w-full flex items-center justify-between focus:outline-none cursor-pointer" data-id="{{ variant.id }}">
    <div class="tag px-3 py-1 lg:py-2 font-semibold text-[0.75rem] bg-[#242F20] lg:h-7 flex items-center justify-center text-white lg:text-[1rem] tracking-[-0.02rem]">
      {{ setting.tag | escape }}
    </div>
    <span class="icon relative w-5 h-5 inline-flex items-center justify-center">
      <span class="horizontal h-[2px] w-3 bg-[rgba(0,0,0,.6)] inline-block"></span>
      <span class="vertical absolute h-3 w-[2px] bg-[rgba(0,0,0,.6)] inline-block origin-center"></span>
    </span>
  </div>

  {% comment %} 内容 {% endcomment %}
  <div class="accordion-content">
    <div class="w-full font-semibold text-[1.125rem] leading-7 lg:text-[1.5rem] lg:leading-8 text-[rgba(0,0,0,.9)] mb-2 lg:mb-4 line-clamp-2"> {{ title | escape }} </div>
    {% if setting.selling_points != blank %}
      <div class="w-full font-medium text-[0.75rem] lg:text-[1rem] leading-4 lg:leading-6 text-[rgba(0,0,0,.6 )] mb-2 line-clamp-2">
        {{ setting.selling_points | escape }}
      </div>
    {% endif %}

    {% comment %} 价格 + 按钮 {% endcomment %}
    <div class="flex items-center justify-between mb-4">
      <div class="text-[rgba(0,0,0,.9)] font-normal">
        <span class="text-[1.125rem] lg:text-[1.25rem] leading-7">{{ current_price | money }}</span>
        {% if compare_at_price != blank %}
          <span class="text-[0.75rem] pl-1 text-[rgba(0,0,0,.6)] line-through">{{ compare_at_price | money }}</span>
        {% endif %}
      </div>

      {%- if setting.btn_type == 'add_to_cart' -%}
        <button
          class="flex items-center justify-center px-[1.125rem] lg:px-10 h-10 lg:h-12 font-semibold text-[1rem] lg:text-[1.25rem] text-[#fff] bg-[var(--jds-color-primary)] hover:bg-[#e95a18] uppercase"
          data-id="{{ variant.id }}"
          accordion-add-to-cart>
          {{ 'products.product.add_to_cart' | t }}
        </button>
      {% else %}
        <a href="{{ product.url }}?variant={{ variant.id }}">
          <button class="flex items-center justify-center px-[1.125rem] lg:px-10 h-10 lg:h-12 font-semibold text-[1rem] lg:text-[1.25rem] text-[#fff] bg-[var(--jds-color-primary)] hover:bg-[#e95a18] uppercase">
            {{ 'products.product.shop_now' | t }}
          </button>
        </a>
      {%- endif -%}
    </div>

    {% comment %} 底部图片 {% endcomment %}
    {% if setting.pc_power_image != blank or setting.mb_power_image != blank %}
      <div class="w-full border-t-[1px] border-solid border-[#D9D9D9] pt-3">
        {% render 'diff-end-img', pc_img: setting.pc_power_image, mb_img: setting.mb_power_image, pc_img_width: 612, mb_img_width: 327, class: 'object-cover focus-zoom w-full h-full' %}
      </div>
    {% endif %}
  </div>
</div>
