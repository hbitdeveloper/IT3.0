<div
  class="five-kwh-item five-kwh-video video-{{ settings.style }} video-{{ settings.mb_style }}"
  anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', '' }}"
  data-index="{{ index }}"
  data-type="{{ settings.style }}"
  style="background:{{ settings.bgColor }};--padding-y: {{ settings.padding_y | divided_by: 16.00 }}rem;"
>
  {% if settings.title != blank %}
    {% assign title_color = '<em style="color: ' | append: settings.title_color | append: '">' %}
    <div class="five-kwh-title five-main-container">{{ settings.title | replace: '<em>', title_color }}</div>
  {% endif %}

  {% if settings.subtitle != blank %}
    {% assign subtitle_color = '<em style="color: ' | append: settings.subtitle_color | append: '">' %}
    <div class="five-kwh-subtitle five-main-container">{{ settings.subtitle | replace: '<em>', subtitle_color }}</div>
  {% endif %}

  {% comment %} PC端进场动画 {% endcomment %}
  {% if settings.entryAnimationSwitch and settings.style == 'full' %}
    <picture class="entry-img-box-outter" id="entry-img-box-outter-{{ index }}">
      <source srcset="{{ settings.entryAnimationImg | image_url: width: 1920 }}" media="(min-width:1024px)">
      <img
        class="entry-animation-img"
        alt="Entry animation image"
        width="{{ settings.entryAnimationImg.width }}"
        height="{{ settings.entryAnimationImg.height }}"
        loading="lazy"
      >
    </picture>
  {% endif %}

  <div
    id="five-kwh-video-{{ index }}"
    data-switch="{{ settings.entryAnimationSwitch }}"
    data-link="{{ settings.videoSrc }}"
  >
    <div class="video-box relative">
      {% if settings.entryAnimationSwitch and settings.style == 'full' %}
        <picture class="entry-img-box-inner" id="entry-img-box-inner-{{ index }}">
          <source srcset="{{ settings.entryAnimationImg | image_url: width: 1920 }}" media="(min-width:1024px)">
          <img
            class="entry-animation-img"
            alt="Entry animation image"
            width="{{ settings.entryAnimationImg.width }}"
            height="{{ settings.entryAnimationImg.height }}"
            loading="lazy"
          >
        </picture>
      {% endif %}
      {% comment %} 视频展示 {% endcomment %}
      {% if settings.videoSrc != blank %}
        {%- render 'jky-video',
          video_url: settings.videoSrc,
          poster: settings.poster,
          isHidePauseBtn: false,
          class: 'five-kwh-video-box pc-block',
          autoplay: settings.autoplay,
          controls: settings.controls,
          loop: true
        -%}
      {% endif %}

      {% if settings.videoSrcMB != blank %}
        {%- render 'jky-video',
          video_url: settings.videoSrcMB,
          poster: settings.posterMB,
          isHidePauseBtn: false,
          class: 'five-kwh-video-box mb-block',
          autoplay: settings.autoplay,
          controls: settings.controls,
          loop: true
        -%}
      {%- elsif settings.videoSrc != blank -%}
        {%- render 'jky-video',
          video_url: settings.videoSrc,
          poster: settings.poster,
          isHidePauseBtn: false,
          class: 'five-kwh-video-box mb-block',
          autoplay: settings.autoplay,
          controls: settings.controls,
          loop: true
        -%}
      {% endif %}

      <div class="video-desc-box {{ settings.desPosition }}">
        {% comment %} 视频描述 {% endcomment %}
        {% if settings.desc != blank %}
          <div class="video-desc" style="color: {{ settings.descColor }};">{{ settings.desc }}</div>
        {% endif %}

        {% comment %} 视频小封面 {% endcomment %}
        {% if settings.poster_mini_pc != blank %}
          <div class="mini-img-{{ index }}">
            {% render 'responsive-image',
            image: settings.poster_mini_pc,
            mimage: settings.poster_mini_mb,
            image_class: 'five-kwh-mini-image'
          %}
        </div>

         {% comment %} 播放按钮 {% endcomment %}
        {% elsif settings.play_btn != blank %}
          <div class="play-button  play-button-{{ index }}">
            <div>{{ settings.play_btn | escape }}</div>
            <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M23.4118 32.5357C21.3832 33.4187 19.2216 33.8602 16.927 33.8602C14.6212 33.8602 12.4541 33.4187 10.4255 32.5357C8.39689 31.6527 6.60663 30.4365 5.0547 28.8871C3.50277 27.3377 2.28894 25.5439 1.41321 23.5058C0.537475 21.4677 0.0996094 19.2991 0.0996094 16.9999C0.0996094 14.7008 0.540247 12.5322 1.42152 10.4941C2.3028 8.45595 3.51385 6.66218 5.0547 5.11277C6.59554 3.56335 8.38026 2.34715 10.4089 1.46415C12.4375 0.581148 14.6046 0.139648 16.9103 0.139648C19.2161 0.139648 21.3832 0.581148 23.4118 1.46415C25.4404 2.34715 27.2307 3.56335 28.7826 5.11277C30.3345 6.66218 31.5511 8.45595 32.4324 10.4941C33.3137 12.5322 33.7543 14.7008 33.7543 16.9999C33.7543 19.2991 33.3137 21.4677 32.4324 23.5058C31.5511 25.5439 30.3345 27.3377 28.7826 28.8871C27.2307 30.4365 25.4404 31.6527 23.4118 32.5357ZM12.6449 23.7968C12.9941 23.9523 13.3571 23.9134 13.734 23.6801L23.4779 17.9157C23.8215 17.7046 23.9906 17.4075 23.985 17.0243C23.9795 16.6411 23.8104 16.3496 23.4779 16.1497L13.734 10.3352C13.3904 10.1353 13.0356 10.1047 12.6698 10.2436C12.304 10.3824 12.1211 10.6462 12.1211 11.0349V22.9971C12.1211 23.3747 12.2957 23.6413 12.6449 23.7968Z" fill="white"></path>
            </svg>
          </div>
        {% endif %}
      </div>

      <div class="absolute-box-new">
        <div class="five-main-container">
          {% comment %} 视频底部小文字 {% endcomment %}
          {% assign bottomTitleColor = '<em style="color: ' | append: settings.bottom_text_color | append: '">' %}
          {% if settings.style == 'full' %}
            <div class="bottom-title pc-block">
              {% if settings.bottom_text != blank %}
                {{ settings.bottom_text | replace: '<em>', bottomTitleColor }}
              {% elsif settings.bottom_text_mb != blank %}
                {{ settings.bottom_text_mb | replace: '<em>', bottomTitleColor }}
              {% endif %}
            </div>
          {% endif %}

          {% if settings.mb_style == 'mb-full' %}
            <div class="bottom-title mb-block">
              {% if settings.bottom_text_mb != blank %}
                {{ settings.bottom_text_mb | replace: '<em>', bottomTitleColor }}
              {% elsif settings.bottom_text != blank %}
                {{ settings.bottom_text | replace: '<em>', bottomTitleColor }}
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% comment %} 展示更多信息 {% endcomment %}
  {% if settings.btnTxt != blank %}
    <div class="button-box  button-box-{{ index }}">
      <button
        data-ga-event="5000plus_page_user_clicks"
        data-ga-action="click"
        data-ga-params-module="Explanation"
        data-ga-params-title="{{ settings.title | strip_html }}"
        data-ga-params-button_name="{{ settings.btnTxt }}"
        class="five-button"
      >
        <span>{{ settings.btnTxt | escape }}</span>
        <div>
          <div class="arrow">
            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              version="1.1"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
            >
              <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
              	<g transform="translate(-158.000000, -41.000000)" fill="#FFFFFF" fill-rule="nonzero">
              		<g transform="translate(18.000000, 22.000000)">
              			<g transform="translate(129.000000, 8.000000)">
              				<path d="M11,20.0276356 C11,19.5486182 11.1535312,19.1586489 11.4605937,18.8577277 C11.7676561,18.5568066 12.160696,18.406346 12.6397134,18.406346 L18.406346,18.406346 L18.406346,12.6397134 C18.406346,12.160696 18.5506653,11.7676561 18.839304,11.4605937 C19.1279427,11.1535312 19.5056295,11 19.9723644,11 C20.4513818,11 20.8413511,11.1535312 21.1422723,11.4605937 C21.4431934,11.7676561 21.593654,12.160696 21.593654,12.6397134 L21.593654,18.406346 L27.3787103,18.406346 C27.8577277,18.406346 28.247697,18.5568066 28.5486182,18.8577277 C28.8495394,19.1586489 29,19.5486182 29,20.0276356 C29,20.4943705 28.8464688,20.8720573 28.5394063,21.160696 C28.2323439,21.4493347 27.8454452,21.593654 27.3787103,21.593654 L21.593654,21.593654 L21.593654,27.3787103 C21.593654,27.8577277 21.4431934,28.247697 21.1422723,28.5486182 C20.8413511,28.8495394 20.4513818,29 19.9723644,29 C19.5056295,29 19.1279427,28.8495394 18.839304,28.5486182 C18.5506653,28.247697 18.406346,27.8577277 18.406346,27.3787103 L18.406346,21.593654 L12.6397134,21.593654 C12.160696,21.593654 11.7676561,21.4493347 11.4605937,21.160696 C11.1535312,20.8720573 11,20.4943705 11,20.0276356 Z"></path>
              			</g>
              		</g>
              	</g>
              </g>
            </svg>
          </div>
        </div>
      </button>
    </div>
  {% endif %}
  <div class="more-box more-box-{{ index }} five-main-container {% if settings.btnTxt == blank %}open{% endif %}">
    {% if settings.moreDescTitle != blank %}
      <div class="more-title" style="color: {{ settings.moreDescTitleColor }};">
        {{ settings.moreDescTitle }}
      </div>
    {% endif %}
    {% if settings.moreDesc != blank %}
      <div class="more-desc" style="color: {{ settings.moreDescColor }};">
        {{ settings.moreDesc }}
      </div>
    {% endif %}
  </div>

  <div class="half-bottom-text">
    <div class="five-main-container">
      {% assign bottomTitleColor = '<em style="color: ' | append: settings.bottom_text_color | append: '">' %}
      {% if settings.style == 'normal' or settings.style == 'activity' %}
        <div class="bottom-title pc-block">
          {% if settings.bottom_text != blank %}
            {{ settings.bottom_text | replace: '<em>', bottomTitleColor }}
          {% elsif settings.bottom_text_mb != blank %}
            {{ settings.bottom_text_mb | replace: '<em>', bottomTitleColor }}
          {% endif %}
        </div>
      {% endif %}

      {% if settings.mb_style == 'mb-normal' or settings.mb_style == 'mb-activity' %}
        <div class="bottom-title mb-block">
          {% if settings.bottom_text_mb != blank %}
            {{ settings.bottom_text_mb | replace: '<em>', bottomTitleColor }}
          {% elsif settings.bottom_text != blank %}
            {{ settings.bottom_text | replace: '<em>', bottomTitleColor }}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
