<script defer>
    function insertAfter(newElement,targetElement){
        var parent = targetElement.parentNode;
        if(parent.lastChild == targetElement){
            parent.appendChild(newElement);
        }else{
            parent.insertBefore(newElement,targetElement.nextSibling);
        }
    }

    if(window.location.pathname.includes("/products/")) {
        const targetDom = document.querySelector(".product-main-block .meta h2.font-bold")
        const reviewsDom = document.createElement("jackery-commetn-header")
        insertAfter(reviewsDom, targetDom)
    }
</script>

<script type='module' defer src='https://cdn.jsdelivr.net/npm/jackery-ui@0.2.8/dist/jackery-ui/jackery-ui.esm.js'></script>

<jackery-comment cid="{{ product.id }}" ctype="1" id="reviews"></jackery-comment>