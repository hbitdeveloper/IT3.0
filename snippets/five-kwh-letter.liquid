<style>
  .trust-letter-box {
    /* background-color: #ffffff; */
    
  }

  .trust-letter-box .type-text {
    padding: 64px 0 0 0;
  }

  .trust-letter-box .type-text .title-box.changed {
    /* color: var(--jds-color-primary); */
    -webkit-text-fill-color: transparent;
    background: url('https://cdn.shopify.com/s/files/1/0550/0524/9633/files/letter.png?v=1725957319') no-repeat
      currentColor;
    background-size: auto;
    background-position: 0 50%;
    -webkit-background-clip: text;
    animation: shark-txt 4.5s linear forwards;
  }

  @keyframes shark-txt {
    0% {
      background-position: -100% 50%; /* 背景从左开始 */
    }
    100% {
      background-position: calc(100vw + 100%) 50%; /* 背景移动到视口外 */
    }
  }

  .trust-letter-box .common-title {
    font-weight: 500;
    font-size: 48px;
    /* color: var(--jds-color-primary); */
    line-height: 60px;
    text-align: left;
    transition: color 0.3s ease;
  }
  .trust-letter-box .change-color.changed {
    /* color: var(--jds-color-primary); */
  }
  .trust-letter-box .change-color.changed .cls-1 {
    /* fill: var(--jds-color-primary); */
  }
  .trust-letter-box .title {
    max-width: 1200px;
  }
  .trust-letter-box .mb-title {
    display: none;
  }
  .trust-letter-box .sec-title {
    display: flex;
    align-items: center;
    max-width: 1200px;
  }
  .trust-letter-box .sec-title .mid-img {
    width: 24px;
    margin: 0 16px;
    display: flex;
    align-items: center;
  }
  .trust-letter-box .sec-title .mid-img svg {
    width: 24px;
    height: 24px;
  }
  .trust-letter-box .des {
    margin-top: 8px;
    max-width: 1200px;
  }
  .trust-letter-box .des .left-des,
  .trust-letter-box .des .right-des {
    font-size: 8px;
    color: #999999;
    line-height: 12px;
    text-align: left;
  }
  .trust-letter-box .type-img {
    padding: 64px 0 0 0;
  }
  .trust-letter-box .type-img img {
    width: 100%;
    height: 68px;
    object-fit: contain;
  }
  @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
    .trust-letter-box {
      /* width: calc(1360vw / 1440 * 100); */
    }
    .trust-letter-box .type-text {
      padding: calc(64vw / 1440 * 100) 0 0 0;
    }
    .trust-letter-box .common-title {
      font-size: calc(48vw / 1440 * 100);
      line-height: calc(60vw / 1440 * 100);
    }
    .trust-letter-box .title {
      max-width: calc(1200vw / 1440 * 100);
    }
    .trust-letter-box .sec-title {
      max-width: calc(1200vw / 1440 * 100);
    }
    .trust-letter-box .sec-title .mid-img {
      width: calc(24vw / 1440 * 100);
      margin: 0 calc(16vw / 1440 * 100);
    }
    .trust-letter-box .sec-title .mid-img svg {
      width: calc(24vw / 1440 * 100);
      height: calc(24vw / 1440 * 100);
    }
    .trust-letter-box .des {
      margin-top: calc(8vw / 1440 * 100);
      max-width: calc(1200vw / 1440 * 100);
    }
    .trust-letter-box .des .left-des,
    .trust-letter-box .des .right-des {
      font-size: calc(8vw / 1440 * 100);
      line-height: calc(12vw / 1440 * 100);
    }
    .trust-letter-box .type-img {
      padding: calc(64vw / 1440 * 100) 0 0 0;
    }
    .trust-letter-box .type-img img {
      width: 100%;
      height: calc(68vw / 1440 * 100);
      object-fit: contain;
    }
  }
  @media screen and (max-width: 1023.98px) {
    html[lang="ja"] .trust-letter-box .common-title {
        font-size: calc(52vw / 750 * 100);
    }
    .trust-letter-box {
      /* padding: calc(80vw / 750 * 100) 0 0; */
      /* width: 91.46666667vw; */
      /* margin: 0 auto; */
    }
    .trust-letter-box .type-text {
      padding-top: calc(80vw / 750 * 100);;
    }

    .trust-letter-box .type-text .title-box.changed {
      /* color: var(--jds-color-primary); */
      -webkit-text-fill-color: transparent;
      background: url('https://cdn.shopify.com/s/files/1/0550/0524/9633/files/letter.png?v=1725957319') no-repeat
        currentColor;
      background-size: auto 250%;
      -webkit-background-clip: text;
      animation: shark-txt 1.5s linear forwards;
    }

    @keyframes shark-txt {
      0% {
        background-position: -2000% 50%; /* 背景从左开始 */
      }
      100% {
        background-position: calc(100vw + 100%) 50%; /* 背景移动到视口外 */
      }
    }

    .trust-letter-box .common-title {
      font-size: calc(60vw / 750 * 100);
      line-height: calc(74vw / 750 * 100);
      max-width: unset;
    }
    .trust-letter-box .title {
      max-width: unset;
    }
    .trust-letter-box .pc-title {
      display: none;
    }
    .trust-letter-box .mb-title {
      display: block;
    }
    .trust-letter-box .sec-title {
      display: block;
      max-width: unset;
    }
    .trust-letter-box .sec-title .mid-img {
      display: none;
    }
    .trust-letter-box .des {
      margin-top: calc(40vw / 750 * 100);
      position: relative;
      max-width: unset;
    }
    .trust-letter-box .des .left-des,
    .trust-letter-box .des .right-des {
      font-size: calc(12vw / 750 * 100);
      line-height: calc(20vw / 750 * 100);
      display: block;
    }
    .trust-letter-box .type-img {
      padding: 0 calc(37vw / 750 * 100) 0 calc(38vw / 750 * 100);
    }
    .trust-letter-box .type-img img {
      width: 100%;
      height: calc(144vw / 750 * 100);
      object-fit: contain;
    }
  }
</style>

<div class="trust-letter-box" style="background: {{ letter['bg-color'] }}">
  <div class="five-main-container">
    {%- if letter['letter-type'] == 'text' -%}
      <div class="type-text">
        <div class="title-box" style="color: {{ letter['title-color'] }}">
          <div class="title common-title pc-title change-color" id="txt1">
            {% if letter['pc-title'] != blank %}
              {{ letter['pc-title'] }}
            {% elsif letter['mb-title'] != blank %}
              {{ letter['mb-title'] }}
            {% endif %}
          </div>
          <div class="title common-title mb-title change-color">
            {% if letter['mb-title'] != blank %}
              {{ letter['mb-title'] }}
            {% elsif letter['pc-title'] != blank %}
              {{ letter['pc-title'] }}
            {% endif %}
          </div>
          <div class="sec-title common-title">
            <p class="left-sec-title change-color" id="txt2">
              {{ letter['sec-title1'] }}
            </p>
            {% if letter['sec-title1'] != blank or letter['sec-title2'] != blank %}
              <div class="mid-img change-color">x</div>
            {% endif %}
            <p class="right-sec-title change-color" id="txt3">
              {{ letter['sec-title2'] }}
            </p>
          </div>
        </div>

        <div class="des">
          {% assign text_color = letter['sub-title-color'] %}
          {% if text_color contains 'rgba(0,0,0,0)' %}
            {% assign text_color = '#999999' %}
          {% endif %}
          <div class="left-des common-des inb" style="color: {{ text_color }}">
            {{ letter['sub-title'] }}
          </div>

          {% comment %}
            <div class="right-des common-des inb">
              {{ letter['sub-title2'] }}
            </div>
          {% endcomment %}
        </div>
      </div>
    {% elsif letter['letter-type'] == 'img' and letter['pc-letter-img'] != blank %}
      <div class="type-img">
        {% render 'responsive-image',
          image: letter['pc-letter-img'],
          mimage: letter['mb-letter-img'],
          image_class: 'letter-img'
        %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    function onReady(fn) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fn, { once: true });
        return;
      }
      fn();
    }

    function getScrollTop() {
      return window.scrollY || document.documentElement.scrollTop || 0;
    }

    function getTitleBoxes() {
      return Array.from(document.querySelectorAll('.trust-letter-box .title-box'));
    }

    function checkVisible(elements) {
      if (!elements || elements.length === 0) return;

      var windowHeight = window.innerHeight || document.documentElement.clientHeight || 0;
      var windowTop = getScrollTop();
      var windowBottom = windowTop + windowHeight;
      var middleScreenTop = windowTop + windowHeight / 3;
      var middleScreenBottom = windowBottom - windowHeight / 3;

      elements.forEach(function (element) {
        var rect = element.getBoundingClientRect();
        var elementTop = rect.top + windowTop;
        var elementBottom = elementTop + rect.height;

        if (elementTop <= middleScreenBottom && elementBottom >= middleScreenTop) {
          element.classList.add('changed');
        } else {
          element.classList.remove('changed');
        }
      });
    }

    onReady(function () {
      var lastScrollTopNew = 0;
      var ticking = false;

      function update() {
        var scrollTopNew = getScrollTop();
        if (scrollTopNew > lastScrollTopNew) {
          checkVisible(getTitleBoxes());
        }
        lastScrollTopNew = scrollTopNew;
      }

      window.addEventListener(
        'scroll',
        function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            update();
            ticking = false;
          });
        },
        { passive: true }
      );
    });
  })();
</script>
