                                                                    {%- assign display_act_discount_amount_num = card.origin_price.value | minus: card.price.value | times: 100.00 | remove_last: '.00' -%}
                                                                    {%- assign _a = card.origin_price.value | minus: card.price.value | floor | times: 100.00 | money | remove_last: '.00' -%}
                                                                    {%- assign display_act_discount_num = card.amount_discount.value | replace: '{amount}', _a -%}
                                                                {%- else -%}
                                                                    {%- assign display_act_discount_amount_num = '' -%}
                                                                    {%- assign display_act_discount_num = '' -%}
                                                                {%- endif -%}
                                                            {%- else -%}
                                                                {%- if product_card.compare_at_price > act_price_times -%}
                                                                    {%- assign display_act_discount_amount_num = product_card.compare_at_price | divided_by: 100.00 | minus: card.price.value | times: 100.00 | remove_last: '.00' -%}
                                                                    {%- assign _a = product_card.compare_at_price | divided_by: 100.00 | minus: card.price.value | floor | times: 100.00 | money | remove_last: '.00' -%}
                                                                    {%- assign display_act_discount_num = card.amount_discount.value | replace: '{amount}', _a -%}
                                                                {%- else -%}
                                                                    {%- assign display_act_discount_amount_num = '' -%}
                                                                    {%- assign display_act_discount_num = '' -%}
                                                                {%- endif -%}
                                                            {%- endif -%}

                                                            {%- if product_card.compare_at_price > product_card.price -%}
                                                                {%- assign display_discount_amount_num = product_card.compare_at_price | minus: product_card.price | divided_by: 100.00 | times: 100 | remove_last: '.00' -%}
                                                                {%- assign _a_act = product_card.compare_at_price | minus: product_card.price | divided_by: 100.00 | floor | times: 100 | money | remove_last: '.00' -%}
                                                                {%- assign display_discount_num = card.amount_discount.value | replace: '{amount}', _a_act -%}
                                                            {%- else -%}
                                                                {%- assign display_discount_amount_num = '' -%}
                                                                {%- assign display_discount_num = '' -%}
                                                            {%- endif -%}
                                                            <script type="application/json">
                                                                {
                                                                    "has_act_active": {{has_act_active}},
                                                                    "has_act": {{has_act_active}},
                                                                    "display_discount_amount_num": "{{display_discount_amount_num}}",
                                                                    "display_discount_num": "{{display_discount_num}}",

                                                                    {%- if card.origin_price.value != blank -%}
                                                                    "display_origin_act": "{{card.origin_price.value | times: 100.00 | money | remove_last: '.00'}}",
                                                                    "display_origin_act_num": "{{card.origin_price.value | times: 100.00 | remove_last: '.00'}}",
                                                                    {%- else -%}
                                                                        {%- if product_card.price < product_card.compare_at_price -%}
                                                                        "display_origin_act": "{{product_card.compare_at_price | money | remove_last: '.00'}}",
                                                                        "display_origin_act_num": "{{product_card.compare_at_price | remove_last: '.00'}}",
                                                                        {%- endif -%}
                                                                    {%- endif -%}

                                                                    {%- if product_card.price < product_card.compare_at_price -%}
                                                                    "display_origin": "{{product_card.compare_at_price | money | remove_last: '.00'}}",
                                                                    "display_origin_num": "{{product_card.compare_at_price | remove_last: '.00'}}",
                                                                    {%- endif -%}

                                                                    "display_act_discount_amount_num": "{{display_act_discount_amount_num}}",
                                                                    "display_act_discount_num": "{{display_act_discount_num}}",
                                                                    "Installment_text": "{{card.Installment_text.value}}",
                                                                    {%-if card.price.value-%}
                                                                    "price_act_num": {{card.price}},
                                                                    {%-endif-%}
                                                                    {%- if card.init_num.value != blank -%}
                                                                    "init_num": {{card.init_num.value}},
                                                                    {%- endif -%}
                                                                    {%- if card.act_time.value != blank -%}
                                                                    "act_time": {{card.act_time.value | date: '%s' }},
                                                                    {%- endif -%}
                                                                    {%- if card.act_time_end.value != blank -%}
                                                                    "act_time_end": {{card.act_time_end.value | date: '%s' }},
                                                                    {%- endif -%}
                                                                    {%- if card.unavailable_sold_txt.value != blank -%}
                                                                    "unavailable_sold_txt": "{{card.unavailable_sold_txt.value }}",
                                                                    {%- endif -%}
                                                                    {%- if card.available_sold_txt.value != blank -%}
                                                                    "available_sold_txt": "{{card.available_sold_txt.value }}",
                                                                    {%- endif -%}
                                                                    "price_num": {{product_card.price | divided_by: 100.00}},
                                                                    "id": {{product_card.id}}
                                                                }
                                                            </script>
                                                                <span class="p-origin-price" style="color:{{ schema_settings.text_color1 }}"></span>
                                                                {%- if card.amount_discount.value != blank -%}
                                                                    <span class="p-discount" style="color:{{ schema_settings.text_color2 }}"></span>
                                                                {%- endif -%}
                                                        </div>

                                                        {% comment %} {%- if product_card.metafields.custom.discount_tag_time != blank -%}
                                                            <div class="coupon__time">{{product_card.metafields.custom.discount_tag_time}}</div>
                                                        {%- endif -%} {% endcomment %}
                                                        {%- if schema_settings.progress_coupon == "coupon" -%}
                                                            {%- if card.coupon_code.value != blank -%}
                                                                <product-coupon-eu {% if schema_settings.mb_colums_2==true and schema_settings.open_swiper == false %} hide--mb {% endif %} data-id="{{product_card.id}}" data-success="{{schema_settings.copy_success_text}}" data-success-tip="{{schema_settings.copy_success_tip_text}}" data-code="{{card.coupon_code.value}}" {% if schema_settings.copy_success_to_checkout %} data-to-checkout {% endif %} >
                                                                    {% render 'icon-coupon-bg', color: schema_settings.text_color2, text: card.coupon_code.value, copy: schema_settings.copy_text, coupon_text: schema_settings.coupon_before %}
                                                                </product-coupon-eu>

                                                                {%- if schema_settings.mb_colums_2==true and schema_settings.open_swiper == false -%}
                                                                    <product-coupon-eu show--mb data-id="{{product_card.id}}" data-success="{{schema_settings.copy_success_text}}" data-success-tip="{{schema_settings.copy_success_tip_text}}" data-code="{{card.coupon_code.value}}" {% if schema_settings.copy_success_to_checkout %} data-to-checkout {% endif %} >
                                                                        {% render 'icon-coupon-bg-mb', color: schema_settings.text_color2, text: card.coupon_code.value, copy: schema_settings.copy_text, coupon_text: schema_settings.coupon_before %}
                                                                    </product-coupon-eu>
                                                                {%- endif -%}
                                                            {%- else -%}
                                                                <div class="coupon__empty"></div>
                                                            {%- endif -%}
                                                        {%- endif -%}

                                                        {%- if card.available_sold_txt.value != blank or card.unavailable_sold_txt.value != blank -%}
                                                            {%- if schema_settings.progress_coupon == "progress" -%}
                                                            <div class="landing-block--product-progress relative {%if has_act == true%} active{% endif %}">
                                                                <input type="range" value="0" min="0.5" max="99.99">
                                                                <div class="jk-seekbar-progress" style="translate:none;rotate:none;scale:none;transform:translate(0px, 0px);">
                                                                    <div role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width: 0%;background:{{schema_settings.text_color2}};--before-col:{{schema_settings.text_color2}};"></div>
                                                                </div>
                                                                <div class="landing-block--product-progress--content flex">
                                                                    {%- assign un_sold = card.unavailable_sold_txt.value | replace: '{num}', card.init_num.value -%}
                                                                    {%- assign _u = 100 | minus: card.init_num.value -%}
                                                                    {%- assign a_sold = card.available_sold_txt.value | replace: '{num}', _u -%}
                                                                    {%- if card.unavailable_sold_txt.value != blank -%}
                                                                    <span class="landing-block--product--sold" style="color: {{ schema_settings.text_color2}}">{{un_sold}}</span>
                                                                    {%- endif -%}

                                                                    {%- if card.available_sold_txt.value != blank -%}
                                                                    <span class="landing-block--product--unsold" style="color: {{ schema_settings.text_color1}}">{{a_sold}}</span>
                                                                    {%- endif -%}
                                                                </div>
                                                            </div>
                                                            {%- endif -%}
                                                        {%- endif -%}

                                                        {%- if card.Installment_text.value != blank -%}
                                                        <div class="landing-block--product-affirm flex" style="color:{{ schema_settings.text_color1 }}">
                                                            <span>{{card.Installment_text.value | escape}}</span>
                                                            {%- if card.Installment_icon.value != blank -%}
                                                                <img src="{{card.Installment_icon.value | image_url: width: 72}}" alt="{{card.Installment_text.value | escape}}" loading="lazy" width="{{ card.Installment_icon.value.width }}" height="{{ card.Installment_icon.value.height }}" />
                                                            {%- endif -%}
                                                        </div>
                                                        {%- endif -%}
                                                    </div>

                                                    <div class="landing-block--product-pmain--bottom flex" style="--a-col:{{ schema_settings.text_color2 }};--a-bg:{{ schema_settings.text_color2 }};--a-solid-bg:{{ schema_settings.text_color3 }}">
                                                        {% comment %} 加入购物车 {% endcomment %}
                                                        {%- if schema_settings.add_to_cart != blank -%}
                                                            <a {%if product_card.available != true%}disabled{% endif %} btn-action="addtocart" date-loading data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="{{schema_settings.add_to_cart | escape}}" data-ga-params-link="" data-ga-params-type="{{sb_types}}"
                                                                {% if schema_settings.add_cart_solid == true %}
                                                                    btn-solid
                                                                    class="{% if product_card.available != true %} sold-out {% endif %}"
                                                                {% endif %}
                                                            >
                                                                {%- if product_card.available != true -%}
                                                                    {{ 'products.product.sold_out' | t }}
                                                                {%- else -%}
                                                                    <span> {{schema_settings.add_to_cart | escape}}</span>
                                                                {%- endif -%}
                                                                <div class="loading__spinner loading__spinner__dark">
                                                                    <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                                                                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                                                                    </svg>
                                                                </div>
                                                            </a>
                                                        {%- endif -%}

                                                        {% comment %} 商品详情 {% endcomment %}
                                                        {%- if schema_settings.shop_now != blank -%}
                                                            <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="{{schema_settings.shop_now | escape}}" data-ga-params-link="{{product_card.url}}" data-ga-params-type="{{sb_types}}"
                                                                {% if schema_settings.shop_solid == true %} btn-solid
                                                            {% endif %}
                                                            >
                                                                <span> {{schema_settings.shop_now | escape}}</span>
                                                            </a>
                                                        {%- endif -%}

                                                        {% comment %} 立即购买 {% endcomment %}
                                                        {%- if schema_settings.buy_now != blank -%}
                                                            {% capture href %}
                                                                /cart/{{product_card.id}}:1
                                                            {% endcapture %}
                                                            <a {%if product_card.available != true%}disabled{% endif %}  class="bundle-shop-now" btn-action="buyitnow" {% if schema_settings.link_blank == true %} target="_blank" {% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display"  data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="{{schema_settings.buy_now | escape}}" data-ga-params-link="{{ href | strip | strip_newlines}}"  {% if schema_settings.buy_now_solid == true %} btn-solid {% endif %}>
                                                                {%- if product_card.available != true -%}
                                                                    {{ 'products.product.sold_out' | t }}
                                                                {%- else -%}
                                                                    {{schema_settings.buy_now | escape}}
                                                                {%- endif -%}
                                                            </a>
                                                        {%- endif -%}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </jky-landing-product-eu>
                                {%- endif -%}
                            {%- endfor -%}
                        </div>

                        {%- if schema_settings.open_swiper==true and swiper_size > 1 -%}
                            <div class="eu-pagination swiper-pagination flex justify-center gap-[0.375rem]"></div>
                        {%- endif -%}
                    </jky-landing-collectionitem-eu>
                {%- endif -%}
            {%- endfor -%}
        </div>
    </jky-landing-collections-eu>
</div>

<script type="module">
    document.addEventListener('DOMContentLoaded', function() {
        if (!customElements.get('jky-landing-collections-eu')) {
            customElements.define('jky-landing-collections-eu', class JkyLandingCollections extends HTMLElement {
                constructor() {
                    super()
                    this.getServerTime()
                    this.init()
                }
                getServerTime() {
                    if (window.JKY_getServerTime) {
                        window.JKY_getServerTime().then(res => {
                            const ts = Number(res?.data?.time);
                            this.server_time = ts;
                            document.querySelectorAll("jky-landing-product-eu").forEach(item => {
                                item.server_time = ts;
                                item.startServertime(ts);
                                item.setAttribute("servertime", ts);
                            });
                        });
                    } else {
                        const url = `${window?.pageInfo?.api}/osconsumerapi/v1/com/get-server-time?shopify_shop_id=${window?.pageInfo?.shopId}&cr=${window?.pageInfo?.cr}`
                        fetch(url).then((response) => response.json()).then(res => {
                            if(res.code === 200 && res?.data?.time) {
                                const ts = Number(res?.data?.time);
                                this.server_time = ts
                                document.querySelectorAll("jky-landing-product-eu").forEach(item => {
                                    item.server_time = ts
                                    item.startServertime(ts)
                                    item.setAttribute("servertime", ts)
                                })
                            }
                        })
                    }
                }

                init() {
                    const that = this
 
                    this.querySelectorAll(".landing-block--product-tab").forEach(tab => {
                        tab.addEventListener("click", function () {
                            const handle = this.getAttribute("data-handle");
                            that.querySelectorAll(".landing-block--product-tab").forEach(el => el.classList.remove("active"));
                            that.querySelectorAll(".jky-landing-collectionitem-eu").forEach(el => el.classList.remove("active"));
                            this.classList.add("active");
                            const activeItems = that.querySelectorAll(`jky-landing-collectionitem-eu[target-handle="${handle}"]`);
                            activeItems.forEach(item => item.classList.add("active"));
                            activeItems.forEach(parent => {
                                parent.querySelectorAll("jky-landing-product-eu").forEach((item, index) => {
                                    item.handlePriceLoog();
                                });
                            });
                            document.querySelectorAll("product-coupon-eu").forEach(item => item?.init())
                        })
                    })
                }
            })
        }

        if (!customElements.get('jky-landing-collectionitem-eu')) {
            customElements.define('jky-landing-collectionitem-eu', class JkyLandingCollectionitem extends HTMLElement {
                constructor() {
                    super()
                    this.isMobile = window.innerWidth <= 1024
                    this.init()
                }

                init() {
                    const that = this
                    const elements = this.querySelectorAll('jky-landing-product-eu');
                    const pids = Array.from(elements).map(el => Number(el.getAttribute('pid')));

                    if(this.classList.contains("col-swiper") && this.isMobile) {
                        this.swiper = new Swiper(this, {
                            slidesPerView: 'auto',
                            pagination: {
                                el: 'jky-landing-collectionitem-eu .swiper-pagination',
                                clickable: true
                            },
                            spaceBetween: 18,
                            navigation: {
                                nextEl: this.querySelector(".swiper-button-next"),
                                prevEl: this.querySelector(".swiper-button-prev"),
                            }
                        });
                    }

                    fetch(`${window.pageInfo.api}/osconsumerapi/v1/app-bundled-sale/infos`, {
                        method: 'POST',
                        headers: {
                        Accept: 'application/json',
                        'Content-Type': 'application/json',
                        cr: window?.pageInfo?.cr,
                        lang: window?.pageInfo?.lang,
                        },
                        body: JSON.stringify({
                        skuIds: pids,
                        shopifyShopId: window.pageInfo.shopId,
                        }),
                    })
                        .then((response) => response.json())
                        .then((res) => {
                        if (res.code === 200) {
                            elements.forEach(el => {
                            const pid = Number(el.getAttribute('pid'));

                            // 3. 查找匹配的 data 项
                            const matchedItem = res.data.find(item => Number(item.originSkuId) === pid);
                            const bundleEl = el.querySelector('.bundle-product');
                            if (matchedItem?.bundleGoodsList?.length > 0) {
                                bundleEl.classList.add('flex');
                                if(this.isMobile){
                                    el.querySelector('.bundle-product .bundle-mid.col-swiper')?.remove();
                                    el.querySelector('.bundle-product .bundle-right.col-swiper')?.remove();
                                }

                                const bundleobj = matchedItem.bundleGoodsList[0]
                                const titleEl = el.querySelector('.bundle-title');
                                const priceEl = el.querySelector('.bundle-price');
                                const linePriceEl = el.querySelector('.bundle-line-price');
                                const imgEl = el.querySelector('.bundle-img img');

                                if (titleEl) {
                                    titleEl.textContent = bundleobj.title?.replace("Jackery", "");
                                }
                                if (priceEl) {
                                    priceEl.textContent = window.formatMoney(bundleobj.price*100,window?.pageInfo?.currency?.money_format)
                                }
                                if (linePriceEl && bundleobj.originPrice > bundleobj.price) {
                                    linePriceEl.textContent = window.formatMoney(bundleobj.originPrice*100,window?.pageInfo?.currency?.money_format)
                                }
                                if (imgEl) {
                                    imgEl.setAttribute('src', bundleobj.image);
                                }
                                bundleEl.setAttribute('data-skuid', bundleobj.skuId);



                            }else{
                                bundleEl.classList.add('hidden');
                            }
                        });

                        } else {
                            window?.pushErrorMessage(res.message || 'Network Error');
                        }
                        })
                        .catch((e) => {
                        window?.pushErrorMessage(e);
                        });

                }

                updateCartHref(href, newSkuId, newQty) {
                    // 去掉前缀 "/cart/"
                    const prefix = "/cart/";
                    let cartStr = href.replace(prefix, '');

                    // 拆分已有项
                    const items = cartStr ? cartStr.split(',') : [];

                    // 转换成 Map
                    const itemMap = new Map();
                    items.forEach(item => {
                        const [sku, qty] = item.split(':');
                        itemMap.set(sku, qty);
                    });

                    // 设置或覆盖 SKU 数量
                    itemMap.set(String(newSkuId), String(newQty));

                    // 重新拼接
                    const updatedItems = Array.from(itemMap.entries())
                        .map(([sku, qty]) => `${sku}:${qty}`);

                    return prefix + updatedItems.join(',');
                }

            })
        }

        if (!customElements.get('jky-landing-product-eu')) {
            customElements.define('jky-landing-product-eu', class JkyLandingProduct extends HTMLElement {
                constructor() {
                    super()
                    this.act_start = this.getAttribute("data-start")

                    this.bundleInputDomTwo =this.querySelector('.bundle-right')?.querySelector('quantity-input')
                    this.bundleInputDomThree =this.querySelector('.bundle-mid')?.querySelector('quantity-input')
                    this.bundleInputDomSwiper =this.querySelector('.col-right-bottom')?.querySelector('quantity-input')
                    this.init()
                }
                init() {
                    const self = this;
                    self.bundleNum = 0;

                    this.handleActionTrigger()

                    // 商品售价商品活动售价
                    this.price = this.getAttribute("data-price")
                    // 促销活动开始时间
                    if(this.getAttribute("data-start")) {
                        this.act_start = Number(this.getAttribute("data-start")) * 1000
                    }
                    // 促销活动结束时间
                    if(this.getAttribute("data-end")) {
                        this.act_end = Number(this.getAttribute("data-end")) * 1000
                    }
                    // 商品售价
                    if(this.getAttribute("data-actprice")) {
                        this.act_price = this.getAttribute("data-actprice") || ''
                    }

                    // 折扣活动进行中
                    this.has_act = this.getAttribute("has_act") === "true"
                    // 是否有折扣活动（包含生效和过期和未开始）
                    this.has_act_active = this.getAttribute("has_act_active") === "true"

                    // 获取折扣显示信息
                    if(this.querySelector('.landing-block--product-price [type="application/json"]')) {
                        try {
                            this.discount_config = JSON.parse(this.querySelector('.landing-block--product-price [type="application/json"]').textContent)
                        } catch(e) {
                            this.discount_config = null
                        }

                        try {
                            this.day_num = Math.ceil((this.discount_config.act_time_end - this.discount_config.act_time) / 60 / 60 / 24)
                        } catch(e) {
                            console.info(e)
                        }
                    }
                    this.discount_dom_price = this.querySelector(".p-discount")

                    // 分期
                    this.affirm_dom = this.querySelector(".landing-block--product-affirm")

                    // 进度条
                    this.available_progress = this.querySelector(".landing-block--product-progress")

                    // 卡片显示样式（US or EU）
                    this.style_us = this.getAttribute("card_style") === "cards_style_1"

                    this.bundleIdDom = this.querySelector('.bundle-product')
                    this.bundleNumDom = this.querySelector('quantity-input input');

                    setTimeout(() => {
                        this.handlePriceLoog()
                    }, 200)
                    this.handleAffirmDisplay(false)
                    this.handleAmountDiscount(false)
                }

                activeACT() { // 活动开启
                    if(!this.has_act_active) return
                    this.intervalId = setInterval(() => { this.updateACTTime() }, 1000);
                }

                updateACTTime() { // 活动时间轮询
                    this.timenow += 1000

                    if(this.timenow > this.act_start && this.timenow < this.act_end) { // 活动进行中
                        this.querySelector(".p-price").innerHTML = this.act_price || ''
                        this.handleAmountDiscount(true)
                        this.updateProgress(true)
                    }

                    if(this.timenow > this.act_end) { // 活动结束
                        this.intervalId && clearInterval(this.intervalId); // 停止更新倒计时
                        this.querySelector(".p-price").innerHTML = this.price || this.act_price || ''
                        this.handleAmountDiscount(false)
                        this.updateProgress(false)
                    }

                    this.handlePriceLoog()
                }

                getRankDay(now, start, end) { // 计算活动进度（第几天）
                    if(now < start || now > end) return
                    return Math.ceil((now - start) / (1000 * 60 * 60 * 24))
                }

                // 设置价格折扣显示 & 分期付款显示信息调整
                handleAmountDiscount(active = false) { // true 活动中，false: 非活动时间
                    if(!this.discount_config) return

                    if(active) {
                        this.querySelector(".p-origin-price").innerHTML = this.discount_config?.display_origin_act || ''
                    } else {
                        this.querySelector(".p-origin-price").innerHTML = this.discount_config?.display_origin || ''
                    }



                    if(active && this.discount_config?.display_act_discount_num) {
                        this.discount_dom_price && (this.discount_dom_price.innerHTML = this.discount_config?.display_act_discount_num || '')
                    } else {
                        this.discount_dom_price && (this.discount_dom_price.innerHTML = this.discount_config?.display_discount_num || '')
                    }
                    this.handleAffirmDisplay(active)
                    this.updateEUStyle(active)
                }

                // 分期信息处理
                handleAffirmDisplay(active = false) { // true 活动中，false: 非活动时间
                    if(!this.affirm_dom) return
                    if(active) {
                        if(this.discount_config && this.discount_config.Installment_text && this.discount_config.price_act_num) {
                            this.affirm_dom.querySelector("span").innerHTML = this.discount_config.Installment_text.replace("{Installment_per}", this.calcPerAffirm(this.discount_config.price_act_num))
                            this.affirm_dom.classList.add("active")
                            return
                        }
                        this.affirm_dom.classList.remove("active")
                        return
                    }

                    if(this.discount_config && this.discount_config.Installment_text && this.discount_config.price_num) {
                        this.affirm_dom.querySelector("span").innerHTML = this.discount_config.Installment_text.replace("{Installment_per}", this.calcPerAffirm(this.discount_config.price_num))
                        this.affirm_dom.classList.add("active")
                        return
                    }
                    this.affirm_dom.classList.remove("active")
                }

                calcPerAffirm(amount) { // 计算分期金额
                    if(amount < 200) {
                        return Math.ceil(amount / 4)
                    } else {
                        return Math.ceil(amount * 1.1229 / 18)
                    }
                }

                handlePriceLoog() { // 处理价格显示超长问题
                    const bottomEl = this.querySelector(".landing-block--product-content--bottom");
                    const priceEl = this.querySelector(".landing-block--product-price");
                    const discountEl = this.querySelector(".p-discount");
                    if (!bottomEl) return;
                    const bottomWidth = bottomEl.offsetWidth;
                    const priceWidth = priceEl ? priceEl.offsetWidth : 0;
                    if (bottomWidth <= priceWidth + 4) {
                        if (discountEl) {
                            discountEl.style.display = 'none';
                        }
                    }
                }

                handleActionTrigger() { // 卡片按钮事件处理
                    this.querySelectorAll("[btn-action]").forEach(btn => {
                        btn.addEventListener("click", (event) => {
                            event.preventDefault();
                            if(!this.discount_config) return
                            const actionType = btn.getAttribute("btn-action")
                            switch (actionType) {
                            case "addtocart":
                                this.handleAddToCart(this.discount_config.id, 1, btn)
                                break;
                            case 'buyitnow':
                                this.handleBuyItNow(this.discount_config.id, 1, btn)
                                break;
                            default:
                                break;
                            }
                        })
                    })
                }

                handleAddToCart(id, quantity = 1, dom) { // 卡片按钮事件-加购
                    dom.classList.add("loading");
                    if (typeof id !== 'number' || isNaN(id)) {
                        throw new TypeError('Theme Cart: Variant ID must be a number');
                    }
                    const cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
                    const fetchJSON = (url, config) => {
                        return fetch(url, config).then(function(response) {
                            if (!response.ok) {
                            throw response;
                            }
                            return response.json();
                        });
                    }
                    const items = [
                                {
                                    id: id,
                                    quantity: quantity
                                }
                            ]

                    const bundleId =this.bundleIdDom.getAttribute('data-skuid');

                    this.bundleNum = this.bundleInputDomTwo.input.value != 0 ? this.bundleInputDomTwo.input.value : (this.bundleInputDomThree.input.value != 0 ? this.bundleInputDomThree.input.value : this.bundleInputDomSwiper?.input?.value);
                    if( this.bundleNum >0 ){
                        items.push({
                            id: bundleId,
                            quantity: this.bundleNum
                        });
                    }

                    const config = {
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json;'
                        },
                        method: 'POST',
                        body: JSON.stringify({
                            items: items
                        })
                    }

                    fetchJSON('/cart/add.js', config).then(response => {
                        if(cart && cart.renderContents) {
                            cart.renderContents(response);
                        } else {
                            window.location.href = '/cart';
                        }
                        setTimeout(() => dom.classList.remove("loading"), 1000)
                        if (cart && cart.classList.contains('is-empty')) {
                            cart.classList.remove('is-empty');
                        }
                    })
                    .catch((e) => {
                        setTimeout(() => dom.classList.remove("loading"), 1000)
                        if (cart && cart.classList.contains('is-empty')) {
                            cart.classList.remove('is-empty');
                        }
                        e.json().then(errorData => {
                            const message = errorData.message
                            message && pushErrorMessage(message)
                        })
                    })
                }

                async handleBuyItNow(id, quantity = 1, dom) { // 卡片事件 - 立即购买
                    dom.classList.add("btn--loading");
                    if (typeof id !== 'number' || isNaN(id)) {
                        throw new TypeError('Theme Cart: Variant ID must be a number');
                    }
                    const params = [{ id, quantity, properties: {} }]
                    const bundleId =this.bundleIdDom.getAttribute('data-skuid');
                    this.bundleNum = this.bundleInputDomTwo.input.value != 0 ? this.bundleInputDomTwo.input.value : (this.bundleInputDomThree.input.value != 0 ? this.bundleInputDomThree.input.value : this.bundleInputDomSwiper?.input?.value);
                    if( this.bundleNum >0 ){
                        params.push({
                            id: Number(bundleId),
                            quantity: Number(this.bundleNum),
                            properties: {}
                        });
                    }

                    try {
                        const checkoutUrl = await createCartAndCheckout(params)
                        if (checkoutUrl) {
                            window.location.href = checkoutUrl
                        }
                    } catch (error) {
                        let str =  `/cart/${id}:${quantity}`
                        window.location.href = str
                    } finally{
                        dom.classList.remove('btn--loading')
                    }
                }
                updateProgress(active = false) { // 售卖进度更新
                    if(!this.available_progress) return
                    if(!active) {
                        this.querySelector(".landing-block--product-progress").classList.remove("active")
                    }
                    if(!active || !this.discount_config?.has_act) return
                    if(!this.day_num || !this.timenow || !this.discount_config.init_num) return
                    const rank_day = this.getRankDay(this.timenow, this.discount_config.act_time * 1000, this.discount_config.act_time_end * 1000)
                    if(!rank_day || rank_day === this.rank_day) return

                    let res = this.rank_day ? (100 - this.discount_config.init_num) / this.day_num * rank_day + this.discount_config.init_num + (Math.floor(Math.random() * 7 - 3)) : (100 - this.discount_config.init_num) / this.day_num * rank_day + this.discount_config.init_num
                    res = res >= 99 ? 99 : res
                    this.rank_day = rank_day
                    if(this.discount_config.unavailable_sold_txt) {
                        this.querySelector(".landing-block--product--sold").innerHTML = this.discount_config.unavailable_sold_txt.replace("{num}", Math.floor(res))
                    }
                    if(this.discount_config.available_sold_txt) {
                        this.querySelector(".landing-block--product--unsold").innerHTML = this.discount_config.available_sold_txt.replace("{num}", Math.ceil(100 - res))
                    }
                    this.querySelector(".landing-block--product-progress .jk-seekbar-progress [role='progressbar']").style.width = `${res}%`
                }

                startServertime(time) { // 同步后端服务器时间
                    if(!this.has_act_active) return
                    if(this.act_start >= this.act_end) {
                        console.error(`配置错误：活动开始时间不能晚于结束时间`)
                        return
                    }
                    this.timenow = Number(time)
                    this.timenow && this.activeACT()
                }

                updateEUStyle(active) { // 欧站样式角标更新
                    // if(!this.querySelector(".p-discount")) return
                    const discount_percent = this.querySelector(".landing-block--product-discount-percent")
                    const discount_percent_text = this.querySelector(".landing-block--product-discount-percent-text").querySelector(".percent")
                    if(!this.style_us || !discount_percent) return
                    let _origin_price = null
                    let _ctx_discount = null

                    if(active) {
                        this.querySelector(".p-origin-price").innerHTML = this.discount_config?.display_origin_act || ''
                    } else {
                        this.querySelector(".p-origin-price").innerHTML = this.discount_config?.display_origin || ''
                    }

                    if(active) {
                        _origin_price = this.discount_config?.display_origin_act_num || ''
                        _ctx_discount = this.discount_config?.display_act_discount_amount_num || ''
                    } else {
                        _origin_price = this.discount_config?.display_origin_num || ''
                        _ctx_discount = this.discount_config?.display_discount_amount_num || ''
                    }

                    if(!_ctx_discount) {
                        discount_percent.style.visibility = 'hidden'
                    } else {
                        discount_percent.style.visibility = 'visible'
                        //四舍五入改成向下取整
                        discount_percent_text.innerHTML = Math.floor((_ctx_discount / _origin_price) * 100) + '%';
                        discount_percent.classList.add("active")
                    }
                }
            })
        }

        if (!customElements.get('product-coupon-eu')) {
            customElements.define('product-coupon-eu', class ProductCoupon extends HTMLElement {
                constructor() {
                    super()
                    this.inited = false
                    this.init()
                }
                init() {
                    this.svg = this.querySelector("svg");
                    if(!this.svg) return;
                    this.svgLeft = this.svg.querySelector("#coupon-bg--left");
                    if(!this.svgLeft) return;
                    this.svgRight = this.svg.querySelector("#coupon-bg--right");
                    if(!this.svgRight) return;
                    this.svgLeftText = this.svg.querySelector("#coupon-bg--left-text");
                    if(!this.svgLeftText) return;
                    this.svgRightText = this.svg.querySelector("#coupon-bg--right-text");
                    if(!this.svgRightText) return;

                    this.initProperties();
                    !this.inited && this.initEvents();
                    this.inited = true
                }

                initProperties() {
                    let rate = 1
                    const act_w = this.querySelector("svg").getBoundingClientRect().width
                    const origin_w = this.querySelector("svg").getAttribute("width").replace("px", "") || act_w
                    rate = act_w / origin_w
                    if(!rate) return

                    this.svgRightText.setAttribute("x", `${Math.floor(this.svgLeft.getBoundingClientRect().width + this.svgRight.getBoundingClientRect().width / 2 - this.svgRightText.getBoundingClientRect().width / 2) /  rate}`)

                    this.svgLeftText.setAttribute("x", `${Math.floor(this.svgLeft.getBoundingClientRect().width / 2 - this.svgLeftText.getBoundingClientRect().width / 2) / rate}`)
                }

                initEvents() {
                    this.svgRight.addEventListener("click", () => {
                        const skuId = this.getAttribute("data-id")
                        const discountCode = this.getAttribute("data-code")
                        copyString(discountCode)
                        pushSuccessMessage(this.getAttribute("data-success-tip"))

                        if (this.hasAttribute("data-to-checkout")) {
                            this.goToCheckout(skuId, discountCode)
                        } else {
                            this.svgRightText.textContent = this.getAttribute("data-success");
                            this.initProperties()
                        }
                    })

                    this.svgRightText.addEventListener("click", () => {
                        const skuId = this.getAttribute("data-id")
                        const discountCode = this.getAttribute("data-code")
                        copyString(discountCode)
                        pushSuccessMessage(this.getAttribute("data-success-tip"))

                        if (this.hasAttribute("data-to-checkout")) {
                            this.goToCheckout(skuId, discountCode)
                        } else {
                            this.svgRightText.textContent = this.getAttribute("data-success");
                            this.initProperties()
                        }
                    })
                }
                // 跳转到 checkout 页
                async goToCheckout(skuId, code, cb) {
                    // 设置 cookie
                    let d = new Date()
                    d.setTime(d.getTime() + (7 * 24 * 60 * 60 * 1000)) // 7天
                    document.cookie = `discount_code=${code};expires=${d.toGMTString()};path=/`

                    // window.location.href = `/cart/${skuId}:1?traffic_source=buy_now`

                    try {
                        // 生成 checkout url，并跳转
                        const checkoutUrl = await createCartAndCheckout([{ id: skuId, quantity: 1, properties: {}, }])
                        if (checkoutUrl) {
                            window.location.href = checkoutUrl
                        }
                    } catch(err) {
                        console.log(err)
                    } finally {
                        setTimeout(() => {
                            cb && cb()
                        }, 300)
                    }
                }
            })
        }
    })
</script>