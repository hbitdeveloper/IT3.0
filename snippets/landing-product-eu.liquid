                                                                {%- if card.price.value == blank -%}
                                                                    {{product_card.price | money | remove_last: '.00'}}
                                                                {%- else -%}
                                                                    {%- if has_act == true -%}
                                                                        <span data-price="{{card.price.value | times: 100.00 | money | remove_last: '.00'}}">{{card.price.value | times: 100.00 | money | remove_last: '.00'}}</span>
                                                                    {%- else -%}
                                                                        {{product_card.price | money | remove_last: '.00'}}
                                                                    {%- endif -%}
                                                                {%- endif -%}
                                                            </span>

                                                            {%- assign act_price_times = card.price.value | times: 100.00 -%}
                                                            {%- assign act_origin_price_times = card.origin_price.value | times: 100.00 -%}

                                                            {%- if card.origin_price.value != blank and card.price.value != blank -%}
