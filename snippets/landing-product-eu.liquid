{%- assign p_cates = shop.metaobjects.landing_product_block[schema_settings.handle] -%}
<div
    data-style="EU"
    class="landing-block--product color-{{ schema_settings.color_scheme }}"
    {% if schema_settings.anchor_id != blank%}anchor={{schema_settings.anchor_id | escape}}{% endif %}
    style="background:var(--color-background);--padding-bottom:{{schema_settings.padding_bottom}}px;--padding-top:{{schema_settings.padding_top}}px;--columns-gap:{{schema_settings.columns_gap}}px;--btns-font-size:{{schema_settings.btns_font_size}}px;--btns-font-size-mb:{{schema_settings.btns_font_size_mb}}px;--pc-bg-img:url('{{schema_settings.pc_bg_img | image_url: width: 1920 }}');--mb-bg-img:url('{{schema_settings.mb_bg_img | image_url: width: 750 }}');"
    {% if schema_settings.pc_bg_img != blank %}has-pc-bg {% endif %}
    {% if schema_settings.mb_bg_img != blank %}has-mb-bg {% endif %}
>
    {%- if schema_settings.block_title != blank -%}
        <div class="section-container landing-product--block-title" style="color: {{schema_settings.block_title_color}};--block_title_size:{{schema_settings.block_title_size}}px;--block_title_bottom:{{schema_settings.block_title_bottom}}px;">{{schema_settings.block_title | newline_to_br}}</div>
    {%- endif -%}

    {%- if schema_settings.block_sub_title != blank -%}
        <div class="section-container landing-product--block-sub-title" style="color: {{schema_settings.block_sub_title_color}};--block_sub_title_size:{{schema_settings.block_sub_title_size}}px;--block_sub_title_bottom:{{schema_settings.block_sub_title_bottom}}px;">{{schema_settings.block_sub_title | newline_to_br}}</div>
    {%- endif -%}

    {% comment %} {%- assign sb_types = 'Multiple_tags' -%}
    {%- if schema_settings.show_tabs == false -%} {% endcomment %}
        {%- assign sb_types = 'Single_tags' -%}
    {% comment %} {%- endif -%} {% endcomment %}

    <jky-landing-collections-eu>
        <div class="landing-block--product-main section-container {%if schema_settings.mb_colums_2==true and schema_settings.open_swiper == false %} landing-col-grid--mb-2{% endif %}">
            {%- for cate in p_cates.cate_list.value -%}
                {%- assign collectionitem_show = false -%}
                {%- if forloop.index == 1 -%}
                    {%- assign collectionitem_show = true -%}
                {%- else -%}
                    {%- assign collectionitem_show = false -%}
                {%- endif -%}

                {%- if collectionitem_show == true -%}
                    <jky-landing-collectionitem-eu target-handle="{{cate.title | handle}}" class="active {%if schema_settings.open_swiper==true%} col-swiper{% endif %}">
                        {%- assign swiper_size = 0 -%}
                        <div class="landing-block--product-cate {%if schema_settings.open_swiper==true%} swiper-wrapper{% endif %}">
                            {%- for card in cate.list.value -%}
                                {%- if card.variant.value.id != blank -%}
                                    {%- assign swiper_size = forloop.index -%}
                                    {% assign act_time_end = card.act_time_end.value | date: '%s' %}
                                    {% assign act_time_start = card.act_time.value | date: '%s' %}
                                    {%- assign time_now = 'now' | date: '%s' -%}
                                    {%- assign product_card = card.variant.value -%}

                                    {% comment %} 活动是否进行 {% endcomment %}
                                    {%- assign has_act = false -%}
                                    {% comment %} 是否有活动 {% endcomment %}
                                    {%- assign has_act_active = false -%}
                                    {%- if card.act_time.value != blank and card.act_time_end.value != blank -%}
                                        {%- assign has_act_active = true -%}
                                        {%- if act_time_start < time_now and act_time_end > time_now and act_time_start < act_time_end -%}
                                            {% comment %} 活动进行中 {% endcomment %}
                                            {%- assign has_act = true -%}
                                        {%- endif -%}
                                    {%- endif -%}

                                    <jky-landing-product-eu
                                        style="background:{{ schema_settings.bgColor }};border:{{ schema_settings.border }}px solid {{ schema_settings.border_color }};--pc-bg-single-img:url('{{schema_settings.pc_bg_single_img | image_url: width: 425 }}');--mb-bg-single-img:url('{{schema_settings.mb_bg_single_img | image_url: width: 750 }}')"
                                        card_style="cards_style_1"
                                        pid="{{product_card.id}}"
                                        has_act_active="{{has_act_active}}"
                                        has_act="{{has_act}}"
                                        {%if card.act_time.value != blank%}data-start="{{act_time_start}}" {% endif %}
                                        {%if card.act_time_end.value != blank%} data-end="{{act_time_end}}" {% endif %}
                                        data-actprice="{%if card.price.value != blank%}{{card.price.value | times: 100.00 | money | remove_last: '.00'}}{% else %}{{product_card.price | money | remove_last: '.00'}}{% endif %}"
                                        class="landing-grid--{{schema_settings.columns_desktop}}-col-desktop  p-cards_style_2 {%if schema_settings.mb_colums_2==true and schema_settings.open_swiper == false%} landing-grid--mb-2{% endif %} {%if schema_settings.open_swiper==true%} swiper-slide{% endif %}"
                                        data-price="{{product_card.price | money | remove_last: '.00'}}"
                                        {% if schema_settings.pc_bg_single_img != blank%}has-pc-bg {% endif %}
                                        {% if schema_settings.mb_bg_single_img != blank%}has-mb-bg {% endif %}
                                    >
                                        <div class="landing-block--product-card flex">
                                            <div class="landing-block--product-media relative" style="background:{{schema_settings.mediao_bg_color}};">
                                                {% comment %} 折扣率 {% endcomment %}
                                                <div class="absolute landing-block--product-discount-percent" style="visibility:hidden">
                                                    {% render 'icon-discount-bg', color: schema_settings.text_color2, %}
                                                    <div class="absolute landing-block--product-discount-percent-text">
                                                        {% if schema_settings.txt_and_percent_order == 'save_txt_up' %}
                                                            <span>{{ schema_settings.save_txt | escape }}</span>
                                                            <span class="percent"></span>
                                                        {% else %}
                                                            <span class="percent"></span>
                                                            <span>{{ schema_settings.save_txt | escape }}</span>
                                                        {% endif %}
                                                    </div>
                                                </div>

                                                {%- if card.card_right_tag_1.value != blank -%}
                                                    <div class="absolute landing-block--product--ptag--1" style="color:{{schema_settings.text_color2}}">{{card.card_right_tag_1.value}}</div>
                                                {%- endif -%}

                                                {%- if card.product_img.value != blank -%}
                                                    <a 
                                                        href="{{product_card.url}}" 
                                                        {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" 
                                                        data-ga-action="click" 
                                                        data-ga-params-module="Product Display" 
                                                        data-ga-params-content="{{cate.title | escape}}" 
                                                        data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" 
                                                        data-ga-params-link="{{product_card.url}}" 
                                                        data-ga-params-url="{{card.product_img.value | image_url: width: 640}}" data-ga-params-type="{{sb_types}}"
                                                    >
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: card.product_img.value,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg pc-show'
                                                        -%}
                                                    </a>
                                                {%- else -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{product_card.featured_image | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: product_card.featured_image,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg p--link pc-show'
                                                        -%}
                                                    </a>
                                                {%- endif -%}

                                                {% comment %} 区分pc和mb图片 {% endcomment %}
                                                {%- if card.product_mb_img.value != blank -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{card.product_mb_img.value | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: card.product_mb_img.value,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg mb-show'
                                                        -%}
                                                    </a>
                                                {%- elsif card.product_img.value != blank -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{schema_settings.all_txt | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{card.product_img.value | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: card.product_img.value,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg mb-show'
                                                        -%}
                                                    </a>
                                                {%- else -%}
                                                    <a href="{{product_card.url}}" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-url="{{product_card.featured_image | image_url: width: 640}}" data-ga-params-type="{{sb_types}}">
                                                        {%- 
                                                            render 'responsive-image', 
                                                            image: product_card.featured_image,
                                                            width: 640,
                                                            mwidth: 400,
                                                            image_class: 'landing-block--product-pimg p--link mb-show'
                                                        -%}
                                                    </a>
                                                {%- endif -%}
                                            </div>
                                            <div class="landing-block--product-content flex">
                                                <div class="landing-block--product-content--top">
                                                    <a style="color:{{ schema_settings.text_color1 }}" href="{{product_card.url}}" class="landing-block--product-ptitle text-overflow-2" {%if schema_settings.link_blank == true%} target="_blank"{% endif %} data-ga-event="activity_page_user_clicks" data-ga-action="click" data-ga-params-module="Product Display" data-ga-params-content="{{cate.title | escape}}" data-ga-params-position="{{product_card.sku}}" data-ga-params-button_name="picture" data-ga-params-link="{{product_card.url}}" data-ga-params-type="{{sb_types}}">
                                                        {%- if card.title.value != blank -%}
                                                            {{card.title.value | escape}}
                                                        {%- else -%}
                                                            {{product_card.title | escape | strip | replace: 'Jackery', ''}}
                                                        {%- endif -%}
                                                    </a>
                                                    {%- if card.subtitle.value != blank -%}
                                                        <div class="landing-block--product-psubtitle text-overflow-2" style="color:{{ schema_settings.text_color1 }}">{{card.subtitle.value | escape | strip}}</div>
                                                    {%- endif -%}
                                                </div>

                                                <div class="landing-block--product-content--bottom flex">
                                                    <div class="landing-block--product-pmain--top">

                                                        <div class="bundle-product bundle-product-{{schema_settings.columns_desktop}} {%if schema_settings.mb_colums_2==true and schema_settings.open_swiper == false%} bundle-product-mb {% endif %}">
                                                            <div class="bundle-left">
                                                                <div class="bundle-img">
                                                                   <img src="" alt="bundle-img" loading="lazy" >
                                                                </div>
                                                            </div>

                                                             <div class="bundle-mid {%if schema_settings.open_swiper==true%} col-swiper{% endif %}">
                                                                <div class="bundle-title text-overflow-2"></div>
                                                                <div class="bundle-price-box">
                                                                    <span class="bundle-price"></span>
                                                                    <span class="bundle-line-price"></span>
                                                                </div>
                                                                <quantity-input class="quantity">
                                                                    <button class="quantity__button no-js-hidden" name="minus" type="button">
                                                                        {% render 'icon-minus' %}
                                                                    </button>
                                                                    <input class="quantity__input"
                                                                        type="number"
                                                                        value="0"
                                                                        min="0"
                                                                    >
                                                                    <button class="quantity__button no-js-hidden" name="plus" type="button">
                                                                        {% render 'icon-plus' %}
                                                                    </button>
                                                                    </quantity-input>
                                                            </div>
                                                             <div class="bundle-right {%if schema_settings.open_swiper==true%} col-swiper{% endif %}">
                                                                <quantity-input class="quantity">
                                                                    <button class="quantity__button no-js-hidden" name="minus" type="button">
                                                                        {% render 'icon-minus' %}
                                                                    </button>
                                                                    <input class="quantity__input"
                                                                        type="number"
                                                                        value="0"
                                                                        min="0"
                                                                    >
                                                                    <button class="quantity__button no-js-hidden" name="plus" type="button">
                                                                        {% render 'icon-plus' %}
                                                                    </button>
                                                                    </quantity-input>
                                                            </div>
                                                            {%if schema_settings.open_swiper==true%}
                                                            <div class="col-right {%if schema_settings.open_swiper==true%} col-swiper{% endif %}">
                                                                <div class="col-right-top">
                                                                    <div class="bundle-title text-overflow-2"></div>
                                                                </div>
                                                                <div class="col-right-bottom">
                                                                    <div class="bundle-price-box">
                                                                        <span class="bundle-price"></span>
                                                                        <span class="bundle-line-price"></span>
                                                                    </div>

                                                                    <quantity-input class="quantity">
                                                                        <button class="quantity__button no-js-hidden" name="minus" type="button">
                                                                            {% render 'icon-minus' %}
                                                                        </button>
                                                                        <input class="quantity__input"
                                                                            type="number"
                                                                            value="0"
                                                                            min="0"
                                                                        >
                                                                        <button class="quantity__button no-js-hidden" name="plus" type="button">
                                                                            {% render 'icon-plus' %}
                                                                        </button>
                                                                    </quantity-input>
                                                                </div>
                                                            </div>
                                                            {%- endif -%}
                                                        </div>

                                                        <div class="landing-block--product-price flex flex-wrap">
