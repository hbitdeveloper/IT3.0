                  px-52 min-w-260 max-w-670 h-80 text-30 border-2 hover:text-white hover:bg-primary transition-all duration-300
                  lg:j-px-24 lg:j-min-w-145 lg:j-h-36 lg:j-text-16 lg:j-border-2
