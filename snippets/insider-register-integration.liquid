                  lg:j-px-24 lg:j-min-w-145 lg:j-h-36  lg:j-text-16 lg:j-border-2
                  xl:a-px-24 xl:a-min-w-145 xl:a-h-36  xl:a-text-16 xl:a-border-2
                "
                data-coupon-pkg-explore-btn
              ></button>
