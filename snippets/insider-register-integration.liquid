                      </span>
                      <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_valid_time' | t }}</span>
                    </div>
                    <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.only_usable' | t }} <span class="register-welfare-pop-cr"></span> {{'newCustomer.usable_site' | t}}</div>
                    <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.check_email' | t }}</div>
                    <div class="coupon-item"><span class="item-icon"></span>{{ 'newCustomer.checkout_tip' | t }}</div>
