              <div class="register-welfare-pop-right px-32 lg:j-px-10 xl:a-px-10 line-clamp-1"></div>
            </div>
            <div class="coupon-text register-welfare-pop-coupon-text display-none" data-more-text="{{ 'newCustomer.more' | t }}">
              <div class="coupon display-none">
                <div class="PC-show">
                  <div class="coupon-wrap">
                    <div class="coupon-item highlight">
                      <span class="over-wrap">
                        <span class="item-icon"></span>
                        {% if shop.id != 10015375438 %}
                          {{ 'newCustomer.order_over' | t }} <span class="register-welfare-pop-limit"></span>
                        {% else %}
                          <span class="register-welfare-pop-limit"></span>{{ 'newCustomer.order_over' | t }}
                        {% endif %}
                      </span>
                      <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_minimum' | t }}</span>
                    </div>
                    <div class="coupon-item">
                      <span class="over-wrap">
                        <span class="item-icon"></span><span>{{ 'newCustomer.valid_time' | t }}: </span><span class="register-welfare-pop-time"></span>
                      </span>
                      <span class="no-minimum-wrap display-none"><span class="item-icon"></span>{{ 'newCustomer.no_valid_time' | t }}</span>
                    </div>
                    <div class="coupon-item">
                      <span class="item-icon"></span>
                      <span class="register-welfare-pop-couponTip" data-coupon-tip="{{ 'newCustomer.coupons_tip' | t }}" data-exclud-tip="{{ 'newCustomer.coupons_tip_exclud' | t }}"></span>
