{% comment %}
    Renders icon right arrow (右箭头图标 - ->)

    Accepts:
    - width: {Number} 宽度
    - height: {Number} 高度
    - color: {String} 填充颜色
    - class: {String} 样式类名

    Usage:
    {% render 'icon-arrow-right', class: 'iconfont header__section_search zzl-tt', width: 22, height: 22, color:  %}
{% endcomment %}

{% assign width = width | default: 16 %}
{% assign height = height | default: 16 %}
<svg class="{{class}} icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" width="{{width}}" height="{{height}}"><path d="M604.17061386 93.0426665l402.19903979 402.1990398-402.19903979 410.57818814L512 813.64928061l259.66975621-259.75354784H9.2511995V428.208533h754.03940987L512 176.83413201l92.17061386-83.79146551z" fill="{{color}}"></path></svg>