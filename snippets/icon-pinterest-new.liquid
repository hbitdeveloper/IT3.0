    Accepts:
    - width: {Number} 宽度
    - height: {Number} 高度
    - color: {String} 填充颜色
    - class: {String} 样式类名

    Usage:
    {% render 'icon-pinterest-new', class: 'iconfont header__section_search zzl-tt', width: 32, height: 32, color: '#FFF' %}
{% endcomment %}

