{% comment %}
    1: title：标题
    2: type: 类型
        1: 小档
        2: 大档
    3: color: 文本颜色
    4：bgColor: 初始背景色
    5: class: 类名
    例子: {% render 'new-title', color: '#000', bgColor: '#ffffff', title: 'jackery', type: '1' %}
{% endcomment %}

<style>
    .title-snippet.title-snippet-small {
        padding: 110px 0;
    }

    .title-snippet.title-snippet-big {
        padding: 184px 0 178px;
    }

    .title-snippet .title-container {
        margin: 0 auto;
        width: fit-content;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .title-snippet .title-container .text {
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 48px;
        line-height: 58px;
        max-width: 1000px;
        color: #1a1a1a;
        width: auto;
        height: auto;
        letter-spacing: -1px;
    }

    .title-snippet .title-container .overlay {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        z-index: 1;
    }

    .title-snippet .title-container .overlay .box {
        position: absolute;
        transition: all .6s cubic-bezier(.8, 0, .2, 1);
        pointer-events: none;
        background-color: #fff;
    }


    .title-snippet .title-container .overlay .top,
    .title-snippet .title-container .overlay .bottom {
        left: 0;
        width: 100%;
        height: 50%
    }

    .title-snippet .title-container .overlay .top {
        top: 0
    }

    .title-snippet .title-container .overlay .bottom {
        bottom: 0
    }

    .title-snippet .title-container .overlay .left,
    .title-snippet .title-container .overlay .right {
        top: 50%;
        width: 50%;
        height: 100%;
        transform: translateY(-50%)
    }

    .title-snippet .title-container .overlay .left {
        left: 0
    }

    .title-snippet .title-container .overlay .right {
        right: 0
    }

    .title-snippet .title-container .overlay .top-left,
    .title-snippet .title-container .overlay .bottom-right {
        position: absolute;
        z-index: 2
    }

    .title-snippet .title-container .overlay .top-left {
        width: 38px;
        top: calc(50% - 46px);
        left: calc(50% - 52px);
        transition: all .6s cubic-bezier(.8, 0, .2, 1)
    }

    .title-snippet .title-container .overlay .bottom-right {
        width: 50px;
        bottom: calc(50% - 46px);
        right: calc(50% - 50px);
        transition: all .6s cubic-bezier(.8, 0, .2, 1)
    }

    .title-snippet .title-container .overlay .kong {
        position: absolute;
        left: 50%;
        top: 50%;
        translate: -50% -50%;
        width: 0;
        height: 0;
        background-color: transparent;
        transition: all 3s cubic-bezier(.8, 0, .2, 1);
        pointer-events: none
    }

    .title-snippet.title-snippet-show .title-container .overlay .top,
    .title-snippet.title-snippet-show .title-container .overlay .bottom {
        height: 0
    }

    .title-snippet.title-snippet-show .title-container .overlay .left,
    .title-snippet.title-snippet-show .title-container .overlay .right {
        width: 0;
        height: 100%
    }

    .title-snippet.title-snippet-show .title-container .overlay .top-left {
        top: -40px;
        left: -52px
    }

    .title-snippet.title-snippet-show .title-container .overlay .bottom-right {
        bottom: -34px;
        right: -54px
    }

    @media screen and (max-width: 1440px) {
        .title-snippet.title-snippet-small {
            padding: 7.63888889vw 0
        }

        .title-snippet.title-snippet-big {
            padding: 12.77777778vw 0 12.36111111vw
        }

        .title-snippet .title-container .text {
            font-size: 3.33333333333333vw;
            line-height: 4.02777777777778vw;
            max-width: 69.44444444vw
        }

        .title-snippet .title-container .overlay .top-left {
            width: 38px;
            top: calc(50% - (46 * .06944444vw));
            left: calc(50% - (52 * .06944444vw))
        }

        .title-snippet .title-container .overlay .bottom-right {
            width: 3.47222222vw;
            bottom: calc(50% - (46 * .06944444vw));
            right: calc(50% - (50 * .06944444vw))
        }

        .title-snippet.title-snippet-show .title-container .overlay .top-left {
            top: -2.77777778vw;
            left: -3.61111111vw
        }

        .title-snippet.title-snippet-show .title-container .overlay .bottom-right {
            bottom: -2.36111111vw;
            right: -3.75vw
        }
    }

    @media screen and (max-width: 1024px) {
        .title-snippet.title-snippet-small {
            padding: 17.0666666666667vw 0 19.2vw
        }

        .title-snippet.title-snippet-big {
            padding: 26.66666667vw 0 28.8vw
        }

        .title-snippet .title-container .text {
            font-size: 8.53333333vw;
            line-height: 10.66666667vw;
            max-width: 66.66666667vw;
        }

        .title-snippet .title-container .overlay .top-left {
            width: 6.66666667vw;
            top: calc(50% - (50 * .13333333vw));
            left: calc(50% - (56 * .13333333vw))
        }

        .title-snippet .title-container .overlay .bottom-right {
            width: 9.6vw;
            bottom: calc(50% - (50 * .13333333vw));
            right: calc(50% - (72 * .13333333vw))
        }

        .title-snippet.title-snippet-show .title-container .overlay .top-left {
            top: -7.46666667vw;
            left: -10.4vw
        }

        .title-snippet.title-snippet-show .title-container .overlay .bottom-right {
            bottom: -9.6vw;
            right: -10.4vw
        }
    }
</style>

<div class="title-snippet {% if type == '1' and title != '' %} title-snippet-small {% elsif type == '2' and title != '' %} title-snippet-big {% endif %} {{class}}" style="background: {{ bgColor | escape}};" id="{{ formId | handleize }}">
    {% if title != '' %}
        <div class="title-container">
            <h2 class="text" style="color: {{ color | escape}};">{{ title }}</h2>
            <div class="overlay">
                <div class="box  top" style="background-color: {{ bgColor | escape}};"></div>
                <div class="box left" style="background-color: {{ bgColor | escape}};"></div>
                <div class="kong"></div>
                <div class="box right" style="background-color: {{ bgColor | escape}};"></div>
                <div class="box bottom" style="background-color: {{ bgColor | escape}};"></div>
                <svg class="top-left" width="34" height="56" viewBox="0 0 34 56" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                        <g transform="translate(-465.000000, -5850.000000)" fill="{{ color | escape }}">
                            <path d="M499,5850 L499,5864.31756 C494.302527,5864.31756 490.11706,5864.31756 486.443599,5864.31756 C480.933408,5864.31756 479.462853,5868.32561 479.462853,5872.88588 C479.462853,5875.92605 479.462853,5886.96409 479.462853,5906 L465,5906 C465,5891.74214 465,5880.7041 465,5872.88588 C465,5861.15854 473.887198,5850 486.443599,5850 C494.814533,5850 499,5850 499,5850 Z" id="路径-4备份-5"></path>
                        </g>
                    </g>
                </svg>
                <svg class="bottom-right" width="46" height="66" viewBox="0 0 46 66" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                        <g transform="translate(-1410.000000, -5877.000000)" fill="{{ color | escape }}">
                            <path d="M1456,5877 L1456,5890.07651 C1442.47352,5890.07651 1433.95828,5890.07651 1430.4543,5890.07651 C1425.19832,5890.07651 1423.79561,5893.73714 1423.79561,5897.90212 C1423.79561,5900.67877 1423.79561,5915.7114 1423.79561,5943 L1410,5943 C1410,5920.07528 1410,5905.04266 1410,5897.90212 C1410,5887.19132 1418.47719,5877 1430.4543,5877 C1438.43904,5877 1446.95427,5877 1456,5877 Z" id="路径-4备份-8" transform="translate(1433.000000, 5910.000000) rotate(180.000000) translate(-1433.000000, -5910.000000) "></path>
                        </g>
                    </g>
                </svg>
            </div>
        </div>
    {% endif %}
</div>

<script>
    window.addEventListener('DOMContentLoaded', function () {
      // 渐变出现
      const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
              if (entry.isIntersecting) {
                  // 元素进入视窗,触发动画
                  entry.target.classList.add('title-snippet-show');
              } else {
                  entry.target.classList.remove('title-snippet-show');
              }
          });
      });

      // 开始观察目标元素
      const newTitles = document.querySelectorAll('.title-snippet')
      if (newTitles && newTitles.length) {
        newTitles.forEach(item => {
              observer.observe(item);
          })
      }
  })

  </script>
