{% comment %} 通用带有超链接的按钮组件 {% endcomment %}
<style>
  .common-button-wrap a {
    width: 100%;
  }
  @media screen and (min-width:1024px) {
    .common-button-wrap a {
      width: fit-content;
    }
  }
</style>

{% if block.settings.button_text != blank %}
  <div class="common-button-wrap" style="background-color:{{block.settings.button_wrap_bg_color}};padding-top:{{block.settings.button_padding_top | escape}}px;padding-bottom:{{block.settings.button_padding_bottom | escape}}px;">
    {% if block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}">
        <button class="index-button">
          <span>{{ block.settings.button_text | escape }}</span>
          <div>
            <div class="arrow">
              <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                  <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                    <g transform="translate(672.000000, 286.000000)">
                      <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                    </g>
                  </g>
                </g>
              </svg>
            </div>
          </div>
        </button>
      </a>
    {% else %}
      <button class="index-button">
        <span>{{ block.settings.button_text | escape }}</span>
        <div>
          <div class="arrow">
            <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
              <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                  <g transform="translate(672.000000, 286.000000)">
                    <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                  </g>
                </g>
              </g>
            </svg>
          </div>
        </div>
      </button>
    {% endif %}
  </div>
{% endif %}

<style>
.common-button-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.common-button-wrap .index-button {
  --index-button-p: 10px 0 10px 32px;
  --index-button-hover-p: 7px 7px 7px 16px;
  --index-button-r: 28px;
  --index-button-text: 18px;
  --index-button-h: 48px;
  --index-arrow-w: 0;
  --index-arrow-h: 0;
  --index-arrow-r:  var(--theme-btn-border-radius,28px);
  --index-arrow-ml: 9px;
  --index-arrow-svg-w: 14px;
  --index-arrow-hover-w: 32px;
  --index-arrow-hover-h: 32px;

  padding: var(--index-button-p);
  border-radius: var(--index-button-r);
  font-size: var(--index-button-text);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  background: var(--primary-color);
  height: var(--index-button-h);
  font-weight: 500;
  transition: all 0.3s cubic-bezier(0.8, 0, 0.2, 1);
}
.common-button-wrap .index-button > div {
  overflow: hidden;
}
.common-button-wrap .index-button .arrow {
  width: var(--index-arrow-hover-w);
  height: var(--index-arrow-hover-h);
  border-radius: var(--index-arrow-r);
  background: rgba(253, 115, 51, 1);
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.8, 0, 0.2, 1);
  display: flex;
  transform: scale(0);
}
.common-button-wrap .index-button svg {
  transform: translateX(calc(0px - var(--index-arrow-svg-w)));
  width: var(--index-arrow-svg-w);
  transition: all 0.4s cubic-bezier(0.8, 0, 0.2, 1);
}


.common-button-wrap .index-button:hover {
  padding: var(--index-button-hover-p);
}
.common-button-wrap .index-button:hover .common-button-wrap .index-button > div {
  overflow: inherit;
}
.common-button-wrap .index-button:hover .arrow {
  margin-left: var(--index-arrow-ml);
  transform: scale(1);
}
.common-button-wrap .index-button:hover svg {
  transform: translateX(0);
}
.common-button-wrap .index-button:active {
  background: #d25424;
}

@media screen and (max-width: 1440px) {
  .common-button-wrap .index-button {
    --index-button-p: 0.694444444444444vw 0 0.694444444444444vw 2.22222222222222vw;
    --index-button-hover-p: 0.486111111111111vw 0.486111111111111vw 0.486111111111111vw 1.11111111111111vw;
    --index-button-r: 1.94444444444444vw;
    --index-button-text: 1.25vw;
    --index-button-h: 3.33333333333333vw;
    --index-arrow-w: 0;
    --index-arrow-h: 0;
    --index-arrow-r:  var(--theme-btn-border-radius,1.94444444444444vw);
    --index-arrow-ml: 0.625vw;
    --index-arrow-svg-l: 0.694444444444444;
    --index-arrow-svg-w: 0.972222222222222vw;
    --index-arrow-hover-w: 2.22222222222222vw;
    --index-arrow-hover-h: 2.22222222222222vw;
  }
}
@media screen and (max-width: 1023px) {
  .common-button-wrap {
    width: 100%;
    padding-left: 5.33333333333333vw;
    padding-right: 5.33333333333333vw;
  }
  .common-button-wrap .index-button {
    --index-button-p: 2.66666666666667vw 5.33333333333333vw;
    --index-button-hover-p: 2.66666666666667vw 5.33333333333333vw;
    --index-button-r:  var(--theme-btn-border-radius,5.33333333333333vw);
    --index-button-text: 3.73333333333333vw;
    --index-button-h: inherit;

    width: 100%;
  }
  .common-button-wrap .index-button span {
    display: -webkit-box;
    text-overflow: ellipsis;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    width: 100%;
  }
  .common-button-wrap .index-button > div {
    display: none;
  }
}</style>
