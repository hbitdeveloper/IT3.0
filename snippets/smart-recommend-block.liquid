            <div class="bottom-text center">
                {{ smart.save_time }}
            </div>
            <div class="number"></div>
            <div class="bottom-text">
                {{ smart.wh }}
            </div>
        </div>
    </div>

    <div class="smart-recommend-bottom-mb show-mb">
        <div class="bottom-left">
            <div class="time-top">
                <span class="number"></span>
                <span class="bottom-text"> {{ smart.hour }}</span>
            </div>

            <div class="bottom-text">
                {{ smart.recharge_time }}
            </div>
        </div>
        <div class="bottom-right">
            <div class="wh-top">
                <span class="number"></span>
                <span class="bottom-text">{{ smart.wh }}</span>
            </div>

            <div class="bottom-text">
                {{ smart.save_time }}
            </div>
        </div>
    </div>

    {% if smart.show_result == true %}
    <div class="show-result">
        <div class="smart-recommend-middle">
            <div class="middle-title">
                {{ smart.recommend_result }}
            </div>
            <div class="middle-center"></div>
        </div>

        <div class="smart-recommend-access">
            <div class="access-title">
                {{ smart.access_text }}
            </div>

            <div class="middle-center"></div>
        </div>

        <div class="smart-recommend-cart">
            <div class="cart-left">
                <div class="cart-price">
                    {{ smart.total }}
                    <span></span>
                </div>
                <div class="cart-origin-price"></div>
            </div>
            <a class="cart-right" href="javascript:void(0)">
                {{ smart.cart }}
            </a>
        </div>
    </div>
    {% endif %}
</smart-recommend-block>

<script src="{{ 'snippet-smart-recommend-block.min.js' | asset_url }}" defer></script>