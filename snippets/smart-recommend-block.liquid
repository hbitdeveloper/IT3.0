{{ 'snippet-smart-recommend-block.min.css' | asset_url | stylesheet_tag }}

<smart-recommend-block class="smart-recommend-block"
    data-open-auto-discount-price="{{settings.open_auto_discount_price}}"
    >
    <div class="smart-recommend-mb"
    data-id="{{  product.selected_or_first_available_variant.id }}"
    data-cart="{{ smart.cart }}"
    data-img="{{ 'smart_recommend_4.common.no_data_image_placeholder' | t }}"
    data-text="{{ 'smart_recommend_4.step_4.no_match_sp_data_text' | t }}"
    anchor="{{ smart.anchor_id  | url_decode | strip | replace: ' ', ''}}"
    >
        <div class="smart-recommend-title">{{ smart.title }}</div>
        <div class="smart-recommend-subtitle show-pc">{{ smart.choose_solar }}</div>
        <div class="smart-recommend-content">
            <div class="smart-recommend-left">
                <input type="checkbox" id="scales" name="scales" class="show-mb" checked>
                <div class="left-img show-mb">
                    {% comment %} 占位图片 {% endcomment %}
                </div>
                <div class="select-container"></div>
                {% comment %} 是pps {% endcomment %}
                <div class="is-pps text-overflow-2"></div>
                <div class="border show-pc"></div>
                <div class="left-img show-pc">
                    {% comment %} 占位图片 {% endcomment %}
                </div>
            </div>

            <div class="smart-recommend-subtitle show-mb">{{ smart.choose_solar }}</div>
            {% comment %} three two one动态样式 {% endcomment %}
            <div class="smart-recommend-right">
                {% comment %} 动态判断等于1显示并且隐藏其他item {% endcomment %}
            </div>
        </div>
    </div>
