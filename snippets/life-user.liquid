<section class="jf-custom-body jf-min-width jf-body-bg-color jf-works-list-body jf-works-author-body">
  <section class="jf-works-author-wrap">
    <div class="jf-works-author-banner"></div>
    <div class="jf-works-list-wrap">
      {% comment %} main {% endcomment %}
      <div class="jf-main-content">
        <div class="jf-container padding-container" style="position:relative;padding-top:0.2rem">
          <div class="jf-author-info">
            <a href="javascript:;">
              <div class="avatar"></div>
            </a>
            <div class="detail">
              <p class="author-name"></p>
              <p class="icons-wrap">
                <i class="jf-icon jf-award-icon"></i>
                <i class="jf-icon jf-vip-icon"></i>
              </p>
            </div>
          </div>
          <div class="jf-tabs-area">
            {% comment %} 作品类型tab {% endcomment %}
            <div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
              <ul class="layui-tab-title"></ul>
            </div>
            {% comment %} 作品类型tab {% endcomment %}
            <div class="jf-flex-1">
              <div class="js-select-area">
                <button class="layui-btn layui-btn-primary jf-dropdown">
                  <span class="sort-title" data-i18n="common.default"></span>
                  <i class="layui-icon layui-icon-down layui-font-12"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="jf-body-bg-color">
          <div class="jf-container jf-tab-content" style="opacity: 0">
            {% comment %} Creations & Favorites {% endcomment %}
            <div class="layui-tab-item layui-show" data-showType="creation,favorite">
              <div class="jf-waterfall-flow" id="jfWaterfall">
                <div class="jf-flow-item"></div>
                <div class="jf-flow-item jf-ignore-item"></div>
                <div class="jf-flow-item jf-ignore-item"></div>
              </div>
              <div class="jf-loading-wrap" id="jfLoading">
                <i class="layui-icon layui-icon-loading layui-anim layui-anim-rotate layui-anim-loop"></i>
                <span data-i18n="common.loading"></span>
              </div>
            </div>
            {% comment %} Messages {% endcomment %}
            <div class="layui-tab-item jf-tab-item jf-msg-tab-item" data-showType="message">
              <ul
                class="layui-nav layui-nav-tree"
                id="menuNav"
                lay-filter="sideBarNav">
                <li
                  class="layui-nav-item layui-nav-itemed layui-this"
                  id="favoriteNav"
                  data-msgType="favorite">
                  <a href="javascript:;" data-i18n="user.like"></a>
                  <span></span>
                </li>
                <li
                  class="layui-nav-item"
                  id="commentNav"
                  data-msgType="comment">
                  <a href="javascript:;" data-i18n="user.comment"></a>
                  <span></span>
                </li>
                <li
                  class="layui-nav-item"
                  id="newsNav"
                  data-msgType="news">
                  <a href="javascript:;" data-i18n="user.news"></a>
                  <span></span>
                </li>
              </ul>
              <div class="nav-main-content">
                <ul class="jf-comment-list"></ul>
                <div class="jf-pagination-wrap jf-work-author-pagination">
                  <div id="jfPagination"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</section>
