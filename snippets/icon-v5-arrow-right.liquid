
{% comment %}
    Renders icon right arrow (右箭头图标 - ->)

    Accepts:
    - width: {Number} 宽度
    - height: {Number} 高度
    - color: {String} 填充颜色
    - class: {String} 样式类名

    Usage:
    {% render 'icon-v5-arrow-right', class: 'iconfont header__section_search zzl-tt', width: 22, height: 22, color:  %}
{% endcomment %}


<svg class="icon {{ class }}" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{width}} {{height}}" fill="none">
  <g>
    <path d="M11.5 20.25H23.7422" stroke="{{color}}" />
    <path d="M20.9922 14L27.2419 20.2498L20.9922 26.4995" stroke="{{color}}" />
  </g>
</svg>
