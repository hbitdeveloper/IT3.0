{% comment %}
    description：商详页头部 - 产品对比
params
    current_variant_id: 当前变体
{% endcomment %}
{{ 'app-bundled-compare.min.css' | asset_url | stylesheet_tag }}
{%- assign icon_color = 'var(--jds-color-primary)' -%}
{%- if color != blank -%}
    {%- assign icon_color = color -%}
{%- endif -%}

<div
    data-add_to_cart="{{ 'products.product.add_to_cart' | t }}"
    data-current_variant_id="{{ current_variant_id }}"
    data-open_auto_discount_price="{{settings.open_auto_discount_price}}"
    class="product-head-compare">
    <div class="flex-between">
        <span> {{ compare_text | escape}} </span>
        {% render 'icon-circle-plus', class: 'icon-circle-plus', width: 22, height: 22, color: icon_color %}
    </div>
</div>

<script src="{{ 'app-bundled-compare.min.js' | asset_url }}" defer></script>
<script src="{{ 'snippets-product-head-compare.js' | asset_url }}" defer></script>
