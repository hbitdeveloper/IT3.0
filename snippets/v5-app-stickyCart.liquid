{% comment %}
    产品详情页 - 底部粘性购物车

    Accepts: product
    Usage:
    {% render 'app-stickyCart' %}
{% endcomment %}

{% comment %} 全局控制启用：open_stickyCart {% endcomment %}
{%- if settings.open_stickyCart == true and product.metafields.custom.hide_sticky_cart != true -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {% comment %} 变体初始化 ：优先获取选中的变体，若为空则取第一个可用变体 {% endcomment %}
  {%- if current_variant == blank and product.variants[0] != blank -%}
    {%- assign current_variant = product.variants[0] -%}
  {%- endif -%}

  {% style %}
    body {padding-bottom: 3.75rem;}
    jky-v5-sticky-cart .v5-jky-sticky-cart .diy-sticky-v5-button-ghost.loading:before{
      animation: jky-v5-spin 1s linear infinite;
      border-color: var(--border-color);
      border-radius: 50%;
      border-style: solid;
      border-top-color: transparent;
      border-width: .15em;
      box-sizing: border-box;
      content: "";
      height: 1.25em;
      inset: 0;
      margin: auto;
      position: absolute;
      width: 1.25em;
    }
    jky-v5-sticky-cart .v5-jky-sticky-cart .diy_sticky_add_cart{
      background: none;
      border: 1px solid var(--primary-color);
      color: var(--primary-color);
    }
    jky-v5-sticky-cart .v5-jky-sticky-cart .sticky_cart_p {
      color: var(--primary-color);
      font-size: 1rem;
      font-weight: 600;
    }
    jky-v5-sticky-cart .v5-jky-sticky-cart .diy_sticky_cart_p{
      color: white;
      font-size: 1.25rem;
    }

    jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu {
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(100% + 0.625rem);
      max-height: 25rem;
      overflow-y: auto;
      opacity: 0;
      transition: opacity .3s cubic-bezier(.645, .045, .355, 1);
    }
    jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure summary .iconfont {
      transform: rotate(90deg);
    }
    jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure details[open] .disclosure-list-menu {
      opacity: 1;
    }
    jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure details[open] summary .iconfont {
      transform: rotate(-90deg);
    }
    jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu li {
      width: 100%;
      padding: 0.625rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
    jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu li[disabled] span {
      opacity: .5;
    }
    jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu li:first-of-type {
      border-top: 0;
    }
    jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu li.active span:last-of-type,
    jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu li:hover span:last-of-type {
      color: var(--primary-color);
    }
    jky-v5-sticky-cart #sticky_addToCart .loading__spinner {
      display: none;
    }
    jky-v5-sticky-cart #sticky_addToCart.loading,
    jky-v5-sticky-cart #sticky_addToCart.disabled {
      background: var(--primary-color);
      color: #fff;
      pointer-events: none;
      opacity: 0.68;
    }
    jky-v5-sticky-cart #sticky_addToCart.loading {
      color: var(--primary-color);
    }
    jky-v5-sticky-cart #sticky_addToCart.loading .loading__spinner {
      display: inline-block;
    }
    @media (max-width: 1023.98px) {
      body {padding-bottom: 8.4375rem;}
      jky-v5-sticky-cart .v5-jky-sticky-cart .product-price--discount_amount {
        display: none;
      }
      jky-v5-sticky-cart .v5-jky-sticky-cart .sticky_cart_p {
        font-size: 4.2666666667vw;
      }
      jky-v5-sticky-cart .v5-jky-sticky-cart .diy_sticky_cart_p{
        font-size: 1.125rem;
      }
      jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu {
        bottom: 100%;
        max-height: 60dvh;
        overflow-y: auto;
        overscroll-behavior: contain;
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
      }
      jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu::-webkit-scrollbar{
        height: 4px !important;
        width: 4px !important;
      }
      jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu::-webkit-scrollbar{
        border-radius: 10px !important;
      }
      jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu::-webkit-scrollbar-thumb {
        background-color: rgba(144, 147, 153, 30%);; /* 滑块的颜色 */
        border-radius: 10px; /* 滑块的圆角 */
      }
      jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu li {
        width: 100%;
        padding: 0.7rem 0;
        padding-right: 2rem;
      }
      jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu li.active{
        display: flex;
        align-items: center;
      }
      jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu li:hover span:last-of-type {
        color: #FFF; /* mb端取消hover效果 */
      }
      jky-v5-sticky-cart .sticky_cart_variantSelect details-disclosure .disclosure-list-menu .active::after {
        content: '';
        display: inline-block;
        width: 1rem;
        height: 1rem;
        background: url(data:image/svg+xml;base64,) no-repeat center center;
        background-size: contain;
        margin-left: 0.5rem; /* 如果需要，可以调整间距 */
        position: absolute;
        right: 1.5rem;
      }
    }

    /* 吸底购物车滑入/滑出动画 */
    jky-v5-sticky-cart {
      pointer-events: none;
    }
    jky-v5-sticky-cart:not(.is-hidden) {
      pointer-events: auto;
    }
    jky-v5-sticky-cart .v5-jky-sticky-cart {
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    jky-v5-sticky-cart:not(.is-hidden) .v5-jky-sticky-cart {
      transform: translateY(0);
    }
  {% endstyle %}
  <jky-v5-sticky-cart
    {% if is_diy == true %}is-diy="true" {% endif %}
    {% if hide_add_to_cart_price %}hide-add-to-cart-price{% endif %}
    {% if show_price_info == true %}show-price-info="true" {% endif %}
    enable_shortage_reminds="{{ enable_shortage_reminds }}"
    init-variant-id="{{ current_variant.id }}"
    init-current-tax-free-popup="{{ current_variant.metafields.custom.open_tax_free_popup_before_buy.value | json }}"
    pd="{{ product.selected_or_first_available_variant.id }}"
    product-title="{{ product.title | escape }}"
    style="display:none"
    data-discount-format="{{ settings.discount_amount_format }}"
    data-display-auto-discount-price-in-sticky-cart="{{ settings.display_auto_discount_price_in_sticky_cart }}"
  >
    <div 
      class="v5-jky-sticky-cart fixed bottom-0 left-0 w-full bg-[#242F20] shadow-[0_2px_18px_rgba(255,255,255,0.12)]"
      data-zindex="{{ settings.sticky_cart_z_index | default: 10001 }}"
      data-unfold-zindex="{{ settings.sticky_cart_unfold_z_index | default: 99999 }}"
      style="z-index:{{ settings.sticky_cart_z_index | default: 10001 }}"
    >
      <div class="flex w-full h-auto max-h-[17.875rem] mx-auto lg:w-[82.5rem] lg:h-[3.75rem]">
        <div class="relative w-full h-full flex flex-col lg:flex-row items-center justify-space justify-between px-4 py-3 gap-y-3 lg:py-2.5 lg:px-0 lg:gap-x-4">
          <div class="sticky_cart_variantSelect lg:relative w-full h-full lg:max-w-[48%] flex-1 {% if product.has_only_default_variant == true %} flex items-center {% endif %}">
            {%- if product.has_only_default_variant == false -%}
              <details-disclosure>
                <details class="!static">
                  {% comment %} 如果是diy3 则下拉列表被隐藏 {% endcomment %}
                  <ul class="{% if is_diy == true %}invisible opacity-0 {% endif %} disclosure-list-menu py-1 px-4 bg-[#242F20] border-0 border-solid border-b border-[rgba(255,255,255,0.12)] shadow-[0_-2px_8px_rgba(255,255,255,0.12)]" tabindex="-1">
                    {%- for variant in product.variants -%}
                      <li
                        data-id="{{ variant.id }}"
                        {% unless variant.available %} disabled {% endunless %}
                        class="cursor-pointer select-none text-left text-sm lg:text-base flex items-start gap-x-4 disabled:opacity-50 {% if variant.id == product.selected_or_first_available_variant.id %} active {% endif %}"
                      >
                        <span class="flex-1 font-semibold text-white text-sm lg:text-base transition-color duration-300">{{ variant.title }}</span>
                      </li>
                    {%- endfor -%}
                  </ul>
                  {% comment %} 如果是diy3 标题不可点击 {% endcomment %}
                  <summary
                    class="header__menu-item list-menu__item link focus-inset flex items-center justify-between lg:justify-start cursor-pointer {% if is_diy %}pointer-events-none{% endif %}"
                    aria-expanded="false"
                  >
                    {%- assign cur_variant_tag = current_variant.metafields.custom.variant_tag -%}
                    <div class="shg-fa variant-title max-w-[95%] font-semibold text-white flex items-center gap-x-4 text-base lg:text-xl lg:pr-4 cursor-pointer select-none">
                      {% if cur_variant_tag != blank and is_diy != true -%}
                        <span class="hidden lg:flex items-center justify-center bg-white text-[#242F20] font-semibold lg:text-base leading-[1.75rem] px-2 lg:px-3">{{ cur_variant_tag | escape }}</span>
                      {%- endif -%}
                      <span class="w-[20.4375rem] pr-4 block lg:w-fit lg:flex-1 lg:pr-2 text-white font-semibold text-ellipsis overflow-hidden whitespace-nowrap">
                        {% comment %} 显示产品标题而非变体标题 {% endcomment %}
                        {%- if is_diy == true -%}
                          {{ product.title }}
                        {%- else -%}
                          {{ product.selected_or_first_available_variant.title }}
                        {%- endif -%}
                        </span>
                    </div>

                    {% comment %} 下拉箭头隐藏 {% endcomment %}
                    {%-liquid
                      assign icon_class = 'iconfont w-4 h-4 lg:w-5 lg:h-5'
                      if is_diy == true
                        assign icon_class = 'iconfont w-4 h-4 lg:w-5 lg:h-5 invisible opacity-0'
                      endif
                    -%}
                    {%- render 'icon-arrow', width: 20, height: 20, color: '#FFFFFF', class: icon_class -%}
                  </summary>
                </details>
              </details-disclosure>
            {%- else -%}
              {%- assign cur_variant_tag = current_variant.metafields.custom.variant_tag -%}
              <div class="shg-fa max-w-[95%] font-semibold text-white flex items-center gap-x-4 text-base lg:text-xl lg:pr-4 cursor-pointer select-none">
                {% if cur_variant_tag != blank -%}
                  <span class="hidden lg:flex items-center justify-center bg-white text-[#242F20] font-semibold lg:text-base leading-[1.75rem] px-2 lg:px-3">{{ cur_variant_tag | escape }}</span>
                {%- endif -%}
                <span class="flex-1 text-white font-semibold text-overflow-1">{{ product.title }}</span>
              </div>
            {%- endif -%}
          </div>

          <div class="w-full flex-1 flex  
            {% if is_diy == true or show_price_info == true %}
              lg:justify-end
              justify-start
              flex-wrap
              {% else %} 
              justify-end
            {% endif %}">
            {%- liquid
              assign target = current_variant
              assign price = target.price | default: 1999
              assign compare_at_price = target.compare_at_price | default: price
              assign available = target.available | default: false
              
              if settings.open_auto_discount_price and settings.display_auto_discount_price_in_sticky_cart
                assign auto_discount_price = target.metafields.custom.auto_discount_price | times: 1
                if auto_discount_price > 0 and auto_discount_price < target.price
                  assign price = auto_discount_price
                else
                  assign price = target.price
                endif
              endif

              if compare_at_price < target.price
                assign compare_at_price = target.price
              endif

              assign money_price = price | money
    
              if target == product and product.price_varies
                assign money_price = 'products.product.price.from_price_html' | t: price: money_price
              endif
            -%}

            {% comment %} DIY3价格信息区域 {% endcomment %} 
            {%- if is_diy == true or show_price_info == true -%}
              <div class="sticky_cart_p_info flex flex-wrap items-center gap-y-1 md:mr-4 max-lg:leading-[1.625rem]" data-sticky-cart-price-info>
                <span class="sticky_cart_p diy_sticky_cart_p mr-[0.34375rem] md:mr-2">{{ money_price }}</span>
                <span class="v5-product-op font-normal text-[#FFFFFF]/65 md:text-white text-sm mr-[0.46875rem] md:mr-2 line-through{% unless compare_at_price > price %} hidden{% endunless %}">{{ compare_at_price | money }}</span>
                <span class="v5-product-discount_amount font-medium text-sm px-[0.6875rem] py-[0.1875rem] md:px-[0.4375rem] md:py-1 bg-[#FFDCCA] text-primary{% unless compare_at_price > price and settings.show_discount_amount %} hidden{% endunless %}" data-format="{{settings.discount_amount_format}}">
                  {%- assign amount_discount = compare_at_price | minus: price | divided_by: 100 | floor | times: 100 | money_without_trailing_zeros -%}
                  {{settings.discount_amount_format | replace: '()', amount_discount}}
                </span>
              </div>
            {%- endif -%} 

            {% comment %} 缺货时隐藏加购按钮 {% endcomment %}
            <div data-sticky-copy-container class="w-full lg:w-fit sticky_cart_addToCart mt-[0.5625rem] lg:mt-0 flex items-center gap-x-2 {%if enable_shortage_reminds == true%}{% unless current_variant.available %} !hidden{% endunless %}{% endif %}">
              {% comment %} 优惠券组件控制是否显示 {% endcomment %}
              <div class="flex flex-col lg:flex-row gap-x-2 gap-y-1.5 {% if show_price_info == true %}!hidden{% endif %}" style="display:none" data-sticky-copy-wrap>
                <span class="text-white text-xs lg:text-sm" data-sticky-copy-discount-title></span>
                <button class="jky-v5-button appearance-none bg-transparent flex items-center gap-x-2" data-sticky-copy-discount-code>
                  <span class="font-semibold text-[#242F20] bg-[#F5F5F3] text-xs lg:text-sm px-2"></span>
                  <svg class="w-4 h-4 lg:w-5 lg:h-5" width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <rect width="20" height="20" fill="url(#pattern0_3_1004)"/>
                    <rect width="20" height="20" fill="url(#pattern1_3_1004)"/>
                    <rect width="20" height="20" fill="url(#pattern2_3_1004)"/>
                    <rect width="20" height="20" fill="url(#pattern3_3_1004)"/>
                    <rect width="20" height="20" fill="url(#pattern4_3_1004)"/>
                    <defs>
                      <pattern id="pattern0_3_1004" patternContentUnits="objectBoundingBox" width="1" height="1">
                        <use xlink:href="#image0_3_1004" transform="scale(0.005)"/>
                      </pattern>
                      <pattern id="pattern1_3_1004" patternContentUnits="objectBoundingBox" width="1" height="1">
                        <use xlink:href="#image0_3_1004" transform="scale(0.005)"/>
                      </pattern>
                      <pattern id="pattern2_3_1004" patternContentUnits="objectBoundingBox" width="1" height="1">
                        <use xlink:href="#image0_3_1004" transform="scale(0.005)"/>
                      </pattern>
                      <pattern id="pattern3_3_1004" patternContentUnits="objectBoundingBox" width="1" height="1">
                        <use xlink:href="#image0_3_1004" transform="scale(0.005)"/>
                      </pattern>
                      <pattern id="pattern4_3_1004" patternContentUnits="objectBoundingBox" width="1" height="1">
                        <use xlink:href="#image0_3_1004" transform="scale(0.005)"/>
                      </pattern>
                      <image id="image0_3_1004" width="200" height="200" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
                    </defs>
                  </svg>
                </button>
              </div>
              <button
                id="sticky_addToCart"
                data-nm-target="add_to_cart_btn"
                class="jky-v5-button disabled:opacity-40 disabled:cursor-not-allowed appearance-none flex items-center justify-center 
                  {% if is_diy == true and current_variant.available == false %}
                    bg-primary text-white font-semibold flex-1 text-base px-2 h-10 lg:text-xl lg:h-10 lg:px-6
                  {% elsif is_diy == true %}
                    diy_sticky_add_cart font-semibold text-sm w-[44.666vw] h-[9.0666vw] lg:text-base lg:w-[10rem] lg:h-12
                  {% else %}
                    bg-primary text-white font-semibold flex-1 text-base px-2 h-10 lg:text-xl lg:h-10 lg:px-6
                  {% endif %}
                "
                {% comment %} 缺货时禁用按钮 {% endcomment %}
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                {% unless is_diy or show_price_info or hide_add_to_cart_price %}
                  {% render 'v5-icon-cart', stroke_width: 2, class: 'text-white w-8 h-8 lg:w-9 lg:h-9 shrink-0' %}
                {% endunless %}
                {% comment %} 有库存 {% endcomment %}
                {%-if current_variant.available -%}
                  <span class="flex items-center justify-center {% unless is_diy or show_price_info or hide_add_to_cart_price %} ml-2 lg:ml-4{% endunless %}">
                    {% comment %} diy显示纯文字"加入购物车"。 普通产品 显示价格+按钮文字 {% endcomment %}
                    {%- if is_diy == true or show_price_info == true or hide_add_to_cart_price == true -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ money_price }} {{ 'products.product.in_cart' | t }}
                    {%- endif -%}
                    </span>
                {%- else -%}
                  {% comment %} 已售罄 {% endcomment %}
                  <span class="flex items-center justify-center {% unless is_diy or show_price_info or hide_add_to_cart_price %} ml-2 lg:ml-4{% endunless %}">{{ 'products.product.sold_out' | t }}</span>
                {%- endif -%}
              </button>
              
              {% comment %} 立即购买按钮 - DIY模式下显示 {% endcomment %}
              {% if is_diy == true and current_variant.available %}
                <button
                  id="sticky_buyNow"
                  class="jky-v5-button-ghost diy-sticky-v5-button-ghost buy-now--box disabled:opacity-40 disabled:cursor-not-allowed appearance-none flex items-center justify-center bg-[var(--primary-color)] text-white font-semibold text-sm w-[44.666vw] h-[9.0666vw] lg:text-base lg:w-[10rem] lg:h-12"
                  {% unless current_variant.available %} 
                    disabled
                  {% endunless %}
                >
                  <span>{{ 'products.product.buy_it_now' | t }}</span>
                </button>
              {% endif %}
            </div>
            
            {% comment %} 到货提醒 {% endcomment %}
            {%- if enable_shortage_reminds == true -%}
              <div class="w-full lg:w-fit shortage-btn flex items-center {% if current_variant.available %}!hidden{% endif %} mt-[0.5625rem] lg:mt-0">
                <button class="jky-v5-button appearance-none flex items-center justify-center bg-primary text-white font-semibold flex-1 text-base px-[1.125rem] h-10 lg:text-xl lg:h-10 lg:px-10">
                  {{ 'products.product.sticky_cart_shortage' | t }}
                </button>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </jky-v5-sticky-cart>

  <script src="{{ 'snippet-v5-app-sticky-cart.js' | asset_url }}" defer></script>
{% endif %}
