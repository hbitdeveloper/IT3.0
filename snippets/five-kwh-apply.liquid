{%- assign size = 0 -%}
{%- for i in (0..2) -%}
    {% assign video_image_mb_index = 'video_image_mb_' | append: forloop.index %}
    {%- if settings[video_image_mb_index] != blank -%}
        {%- assign size = size | plus: 1 -%}
    {%- endif -%}
{%- endfor -%}
{%- assign gaTitle = '' -%}
{% if settings.title != blank %}
    {%- assign gaTitle = settings.title | strip_html -%}
{% elsif settings.sub_title != blank %}
    {%- assign gaTitle = settings.sub_title | strip_html -%}
{%endif%}
<section class="five-kwh-apply five-kwh-apply-{{ index }}" anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', '' }}"
         data-index="{{ index }}" style="background: {{ settings.bgColor }}">
    <div class="video-apply-text five-main-container">
        {% assign titleColor = '<em style="color: ' | append: settings.title_color | append: '">' %}
        {% assign subTitleColor = '<em style="color: ' | append: settings.subtitle_color | append: '">' %}
        {% if settings.title != blank %}
            <div class="five-kwh-title ">
                {{ settings.title | replace: '<em>', titleColor }}
            </div>
        {% endif %}
        {% if settings.sub_title != blank %}
            <div class="five-kwh-subtitle">{{ settings.sub_title | replace: '<em>', subTitleColor }}</div>
        {% endif %}
    </div>
    <div class="video-apply-box show-pc five-main-container">
        <div class="video-apply-content">
            {%- for i in (0..2) -%}
                {% assign video_image_pc_index = 'video_image_pc_' | append: forloop.index %}
                {% assign video_pc_url_index = 'video_pc_url_' | append: forloop.index %}
                {% assign video_title_index = 'video_title_' | append: forloop.index %}
                {% assign video_des_index = 'video_des_' | append: forloop.index %}
                {% assign video_title_color_index = 'video_title_color_' | append: forloop.index %}
                {% assign video_des_color_index = 'video_des_color_' | append: forloop.index %}
                {% if settings[video_image_pc_index] != blank %}
                <div class="video-apply-item relative">
                    {% render 'responsive-image', image: settings[video_image_pc_index], width: 440, mwidth: 390, image_class: 'absolute video-apply-image'%}
                    {% if settings[video_pc_url_index] != blank %}
                        <div class="video-apply-button absolute"
                             data-video="{{ settings[video_pc_url_index] }}"
                             data-controls="{{ settings.controls }}"
                             data-loop="{{ settings.loop }}"
                             data-ga-event="5000plus_page_user_clicks"
                             data-ga-action="click"
                             data-ga-params-current_page=""
                             data-ga-params-module="Video Display"
                             data-ga-params-position="{{ gaTitle }}"
                             data-ga-params-link="{{ settings[video_pc_url_index] }}">
                            <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M23.4118 32.5357C21.3832 33.4187 19.2216 33.8602 16.927 33.8602C14.6212 33.8602 12.4541 33.4187 10.4255 32.5357C8.39689 31.6527 6.60663 30.4365 5.0547 28.8871C3.50277 27.3377 2.28894 25.5439 1.41321 23.5058C0.537475 21.4677 0.0996094 19.2991 0.0996094 16.9999C0.0996094 14.7008 0.540247 12.5322 1.42152 10.4941C2.3028 8.45595 3.51385 6.66218 5.0547 5.11277C6.59554 3.56335 8.38026 2.34715 10.4089 1.46415C12.4375 0.581148 14.6046 0.139648 16.9103 0.139648C19.2161 0.139648 21.3832 0.581148 23.4118 1.46415C25.4404 2.34715 27.2307 3.56335 28.7826 5.11277C30.3345 6.66218 31.5511 8.45595 32.4324 10.4941C33.3137 12.5322 33.7543 14.7008 33.7543 16.9999C33.7543 19.2991 33.3137 21.4677 32.4324 23.5058C31.5511 25.5439 30.3345 27.3377 28.7826 28.8871C27.2307 30.4365 25.4404 31.6527 23.4118 32.5357ZM12.6449 23.7968C12.9941 23.9523 13.3571 23.9134 13.734 23.6801L23.4779 17.9157C23.8215 17.7046 23.9906 17.4075 23.985 17.0243C23.9795 16.6411 23.8104 16.3496 23.4779 16.1497L13.734 10.3352C13.3904 10.1353 13.0356 10.1047 12.6698 10.2436C12.304 10.3824 12.1211 10.6462 12.1211 11.0349V22.9971C12.1211 23.3747 12.2957 23.6413 12.6449 23.7968Z" fill="white"/>
                            </svg>
                        </div>
                    {% endif %}
                    <div class="video-apply-item-text absolute">
                        {% assign boxTitleColor = '<em style="color: ' | append: settings[video_title_color_index] | append: '">' %}
                        {% assign boxDesColor = '<em style="color: ' | append: settings[video_des_color_index] | append: '">' %}
                        {% if settings[video_title_index] != blank %}
                            <div class="apply-item-title">
                                {{ settings[video_title_index] | replace: '<em>', boxTitleColor }}
                            </div>
                        {% endif %}
                        {% if settings[video_des_index] != blank %}
                            <div class="apply-item-subTitle">{{ settings[video_des_index] | replace: '<em>', boxDesColor }}</div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            {%- endfor -%}
        </div>
    </div>
    <div class="video-apply-box-mb show-mb swiper"
        data-autoplay="{{ settings.swiper_auto_play }}"
        data-delay="{{ settings.swiperInterval }}"
        data-size="{{ size }}">
        <div class="video-apply-content-mb swiper-wrapper">
            {%- for i in (0..2) -%}
                {% assign video_image_mb_index = 'video_image_mb_' | append: forloop.index %}
                {% assign video_mb_url_index = 'video_mb_url_' | append: forloop.index %}
                {% assign video_title_index = 'video_title_' | append: forloop.index %}
                {% assign video_des_index = 'video_des_' | append: forloop.index %}
                {% assign video_title_color_index = 'video_title_color_' | append: forloop.index %}
                {% assign video_des_color_index = 'video_des_color_' | append: forloop.index %}
                {% if settings[video_image_mb_index] != blank %}
                    <div class="video-apply-item relative swiper-slide">
                        {% render 'responsive-image', image: settings[video_image_mb_index], width: 440, mwidth: 390, image_class: 'absolute video-apply-image'%}
                        {% if settings[video_mb_url_index] != blank %}
                            <div class="video-apply-button absolute"
                                 data-video="{{ settings[video_mb_url_index] }}"
                                 data-controls="{{ settings.controls }}"
                                 data-loop="{{ settings.loop }}"
                                 data-ga-event="5000plus_page_user_clicks"
                                 data-ga-action="click"
                                 data-ga-params-current_page=""
                                 data-ga-params-module="Video Display"
                                 data-ga-params-position="{{ gaTitle }}"
                                 data-ga-params-link="{{ settings[video_mb_url_index] }}">
                                <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M23.4118 32.5357C21.3832 33.4187 19.2216 33.8602 16.927 33.8602C14.6212 33.8602 12.4541 33.4187 10.4255 32.5357C8.39689 31.6527 6.60663 30.4365 5.0547 28.8871C3.50277 27.3377 2.28894 25.5439 1.41321 23.5058C0.537475 21.4677 0.0996094 19.2991 0.0996094 16.9999C0.0996094 14.7008 0.540247 12.5322 1.42152 10.4941C2.3028 8.45595 3.51385 6.66218 5.0547 5.11277C6.59554 3.56335 8.38026 2.34715 10.4089 1.46415C12.4375 0.581148 14.6046 0.139648 16.9103 0.139648C19.2161 0.139648 21.3832 0.581148 23.4118 1.46415C25.4404 2.34715 27.2307 3.56335 28.7826 5.11277C30.3345 6.66218 31.5511 8.45595 32.4324 10.4941C33.3137 12.5322 33.7543 14.7008 33.7543 16.9999C33.7543 19.2991 33.3137 21.4677 32.4324 23.5058C31.5511 25.5439 30.3345 27.3377 28.7826 28.8871C27.2307 30.4365 25.4404 31.6527 23.4118 32.5357ZM12.6449 23.7968C12.9941 23.9523 13.3571 23.9134 13.734 23.6801L23.4779 17.9157C23.8215 17.7046 23.9906 17.4075 23.985 17.0243C23.9795 16.6411 23.8104 16.3496 23.4779 16.1497L13.734 10.3352C13.3904 10.1353 13.0356 10.1047 12.6698 10.2436C12.304 10.3824 12.1211 10.6462 12.1211 11.0349V22.9971C12.1211 23.3747 12.2957 23.6413 12.6449 23.7968Z" fill="white"/>
                                </svg>
                            </div>
                        {% endif %}
                        <div class="video-apply-item-text absolute">
                            {% assign boxTitleColor = '<em style="color: ' | append: settings[video_title_color_index] | append: '">' %}
                            {% assign boxDesColor = '<em style="color: ' | append: settings[video_des_color_index] | append: '">' %}
                            {% if settings[video_title_index] != blank %}
                                <div class="apply-item-title">
                                    {{ settings[video_title_index] | replace: '<em>', boxTitleColor }}
                                </div>
                            {% endif %}
                            {% if settings[video_des_index] != blank %}
                                <div class="apply-item-subTitle">{{ settings[video_des_index] | replace: '<em>', boxDesColor }}</div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {%- endfor -%}
        </div>
    </div>
    <div class="apply-video-bottom">
        {% if settings.more_link != blank and settings.more_title != blank %}
            <a class="video-apply-more" href="{{ settings.more_link }}" target="{% if new_window %}_blank{% else %}_self{% endif %}">
                <button  class="five-button">
                    <span>{{ settings.more_title }}</span>
                    <div>
                        <div class="arrow">
                            <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                        <g transform="translate(672.000000, 286.000000)">
                                            <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                        </g>
                                    </g>
                                </g>
                            </svg>
                        </div>
                    </div>
                </button>
            </a>
        {% endif %}
        {% if size > 1 %}
            <div class="swiper-navigation show-mb">
                <div class="swiper-button-prev swiper-apply-button-prev swiper-tab-vs-pc-button"></div>
                <div class="swiper-button-next swiper-apply-button-next swiper-tab-vs-pc-button"></div>
            </div>
        {% endif %}
    </div>
</section>
