{% comment %}
  This snippet is used to display a product in a swiper slider on an article page.
  It includes the product image, title, price, and a link to the product page.
  The swiper slider is initialized with specific settings for navigation and pagination.
  The product title is derived from the variant or product title, with 'Jackery' removed if present.
  params:
      title: 标题.
      variant: 变体.
      product: 产品.
      features_info: 卖点
      target: 新开标签页
{% endcomment %}

{% liquid
  # 标题
  assign product_title = title | escape
  if product_title == blank
    assign product_title = variant.metafields.custom.shortname | default: variant.title
    if product_title == 'Default Title'
      assign product_title = product.metafields.custom.shortname | default: product.title
    endif
  endif

  # 图片
  assign image = variant.featured_image | default: product.featured_image

  # 产品卖点
  assign features_info = features_info | default: variant.metafields.custom.product_features_info | default: product.metafields.custom.product_features_info

  # 跳转地址
  assign link = product.url | append: '?variant=' | append: variant.id

  # 折扣价
  assign price_discounted = product.metafields.custom.manual_discounted_price
  if price_discounted != blank
    assign current_price = price_discounted | times: 100
  else
    assign current_price = variant.price
    if settings.open_auto_discount_price
      assign auto_discount_price = variant.metafields.custom.auto_discount_price | times: 1
      assign auto_discount_amount = variant.metafields.custom.auto_discount_amount | times: 1
      if auto_discount_price > 0 and auto_discount_amount > 0
        if auto_discount_price < current_price
          assign current_price = auto_discount_price
        endif
      endif
    endif
  endif
%}

<a
  class="product-card"
  href="{{ link }}"
  target="{{ target | default: '_blank' }}"
    data-ga-event="blog_detail_page_user_clicks" 
    data-ga-action="click" 
    data-ga-params-title="{{ article.title | strip_html }}" 
    data-ga-params-module="Blog Product Display"
    data-ga-params-position="{{ product_title }}"
    data-ga-params-button_name="{{ 'general.action_text.view_more' | t }}"
    data-ga-params-link="{{ link }}"
    data-ga-params-type="blog_footer"
  
>

  <div class="icons"> {% render 'product-tag', product: product, variant: variant, hide_left: false %} </div>

  <div class="img-box">
    {% render 'responsive-image', image: image %}
  </div>

  {% comment %} 可能需要加div {% endcomment %}
  <div class="content-info">
    <div>
      <div class="product-title text-overflow-3">
        {{ product_title | replace_first: 'Jackery', '' }}
      </div>
      <div class="product-sell text-overflow-2">
        {{ features_info | metafield_tag }}
      </div>
    </div>
    <div class="product-btn-box">
      <div class="product-price">{{ current_price | money }}</div>
      <button class="product-btn">{{ 'general.action_text.view_more' | t }}</button>
    </div>
  </div>
</a>
