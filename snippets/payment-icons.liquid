{% comment %}
 标题：商详页支付图标组
 描述：
  1. 数据源：内容 - 元对象 - 本站所支持的支付图标列表
  2. 可配置版块开关，默认开启
  3. 可配置标题、图标列表

{% endcomment %}

{%- assign payment_icon_list = shop.metaobjects.payment_icon_list.values -%}
{%- if payment_icon_list != blank -%}
  <div class="payment-icon-wrapper flex justify-center">

    {% comment %} 仅获取第一个条目 {% endcomment %}
    {%- assign first_icon_list = payment_icon_list | first -%}

    {% comment %} 版块开关，默认开启 {% endcomment %}
    {% assign enable = first_icon_list.enable | default: true , allow_false: true %}

      <div class="payment-icon-list">
        <style>
          .payment-icon-wrapper {
            justify-content: center;
          }
          .pdp-v4 .product-info_block~.payment-icon-wrapper .payment-icon-list {
            padding-top: 0;
          }
          .payment-icon-list-title {
            color: #1A1A1A;
            font-weight: 500;
          }
          .payment-icon-list{
             display: flex;
             align-items: flex-start;
          }

          .payment-icon-list .icons-list {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            flex-wrap: wrap;
            display: grid;
            grid-template-columns: repeat(8, 1fr);
          }
          .payment-icon-list .icons-list img {
            object-fit: contain;
          }

          figure .payment-icon-list-title{
            font-weight: 400;
            color: #666666;
          }

          .pay-wrannty .payment-icon-list-title{
              font-weight: 500;
              font-size: 14px;
              color: #1A1A1A;
              line-height: 18px;
              max-width: 100%;
              margin-top: 3px;
              margin-bottom: 14px;
          }

          .payment-icon-list-title.pc-show{
            display: block;
          }

          .payment-icon-list-title.mb-show{
            display: none;
          }

          .pay-wrannty .payment-icon-list-title.pc-show{
            display: -webkit-box;
          }
          .pay-wrannty .payment-icon-list-title.mb-show{
            display: none;
          }

          .pay-wrannty .payment-icon-wrapper{
            justify-content: flex-start;
          }
          
          .pay-wrannty .payment-icon-list{
            display: block;
          }

          .pay-wrannty .payment-icon-wrapper .payment-icon-list .icons-list{
             grid-template-columns: repeat(12, 1fr);
             gap: 3px;
          }

          .pay-wrannty .payment-icon-list .icons-list img{
            border-radius: 3px;
          }

          @media screen and (min-width: 1024px){
             .pay-wrannty .payment-icon-list-title{
                overflow: hidden;
                text-overflow: ellipsis;
                display: -webkit-box;
                -webkit-box-orient: vertical;
                -webkit-line-clamp: 1;
            }
          }

          @media screen and (min-width: 1440px) {

            .payment-icon-list {
              padding: 0;
              
            }
            .payment-icon-list-title {
              font-size: 14px;
              line-height: 18px;
              margin-bottom: 0;
              margin-right: 8px;
              max-width: 280px;
            }
            .payment-icon-list .icons-list {
              gap: 4px;
            }
            .payment-icon-list .icons-list img {
              border-radius: 4px;
              width: 36px;
              height: 22px;
            }
          }
          @media screen and (min-width: 1024px) and (max-width: 1439.98px) {
            figure .payment-icon-wrapper{
              margin-top: 2.66666666666667vw;
            }

            .payment-icon-list {
              padding: 1.66666666666667vw 0;
            }
            .payment-icon-list-title {
              font-size: max(12px, 0.97222222vw);
              line-height: 1.25vw;
              margin-bottom: 0.69444444444444vw;
              margin-right: 0.5555555vw;
              max-width: 19.4444444vw;
            }
            .payment-icon-list .icons-list {
              gap: 0.69444444444444vw;
            }
            .payment-icon-list .icons-list img {
              border-radius: 0.13888888888889vw;
              width: 2.77777777777778vw;
              height: 1.66666666666667vw;
            }
           
            .pay-wrannty .payment-icon-list-title {
              font-weight: 500;
              font-size: 0.97222222vw;
              color: #1A1A1A;
              line-height: 1.25vw;
              max-width: 100%;
              margin-top: 0.20833333vw;
              margin-bottom: 0.97222222vw;
            }
            .pay-wrannty .payment-icon-wrapper {
              justify-content: flex-start;
            }
            .pay-wrannty .payment-icon-list {
              padding: 0;
              display: block;
            }
            .pay-wrannty .payment-icon-wrapper .payment-icon-list .icons-list {
              grid-template-columns: repeat(12, 1fr);
              gap: 0.20833333vw;
            }
            .pay-wrannty .payment-icon-list .icons-list img {
              border-radius: 0.20833333vw;
            }
          }
          @media screen and (max-width: 1023.98px) {
            .payment-icon-list {
              padding: 0;
            }
            .main-product .layer-container .payment-icon-list {
              padding: 0;
            }
            .payment-icon-list-title {
              margin-bottom: 3.2vw;
              color: rgba(25, 25, 25, 1);
              font-size: max(12px, 5.86666666666667vw);
            }
            .payment-icon-list .icons-list {
              gap: 2.13333333333333vw;
            }
            .payment-icon-list .icons-list img {
              border-radius: 1.066666666vw;
              width: 9.6vw;
              height: 5.8666666vw;
            }

            .pay-wrannty.v3 .payment-icon-list .icons-list img {
              border-radius: 1.066666666vw;
              width: 8.666666vw;
              height: 5.333333333vw;
            }
           
            .pay-wrannty .payment-icon-list-title {
              font-weight: 500;
              font-size: 3.2vw;
              color: #1A1A1A;
              line-height: 4.26666667vw;
              margin-top: 1.6vw;
              margin-bottom: 3.2vw;
              max-width: 79.2vw;
              white-space: nowrap;
              overflow: hidden;
              text-overflow: ellipsis;
            }

            .pay-wrannty .payment-icon-list-title.pc-show{
              display: none;
            }
            .pay-wrannty .payment-icon-list-title.mb-show{
              display: block;
            }

            .payment-icon-list-title.pc-show{
              display: none;
            }

            .payment-icon-list-title.mb-show{
              display: block;
            }

            .pay-wrannty.v3 .payment-icon-list-title {
              max-width: 74.4vw;
            }
            .pay-wrannty .payment-icon-wrapper {
              justify-content: flex-start;
            }
            .pay-wrannty .payment-icon-list {
              display: block;
            }
            .pay-wrannty .payment-icon-wrapper .payment-icon-list .icons-list {
              grid-template-columns: repeat(8, 1fr);
              gap: 0.8vw;
            }
            .pay-wrannty .payment-icon-list .icons-list img {
              border-radius: 0.8vw;
            }
          }
        </style>

        {% comment %} 标题 {% endcomment %}
        {%- if first_icon_list.title != blank -%}
          <h3 class="payment-icon-list-title pc-show">{{ first_icon_list.title | metafield_tag }}</h3>
        {%- endif -%}
        {%- if first_icon_list.title_mb != blank -%}
            <h3 class="payment-icon-list-title mb-show">{{ first_icon_list.title_mb | metafield_tag | strip_html }}</h3>
        {%- endif -%}

        {% comment %} 支付图标列表 {% endcomment %}
        <div class="icons-list">
          {%- if first_icon_list.link_list != blank -%}
            {%- for item in first_icon_list.link_list.value -%}
              <picture>
                <source srcset="{{ item | image_url: width: 40,height:24 }}" media="(min-width: 1024px)">
                <img
                  src="{{ item | image_url: width: 80,height:48 }}"
                  width="40"
                  height="24"
                  alt="payment icon"
                  loading="lazy"
                >
              </picture>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
  </div>
{%- endif -%}
