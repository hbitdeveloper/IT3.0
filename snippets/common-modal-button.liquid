{% comment %} 通用弹窗按钮组件 {% endcomment %}

{% if block.settings.button_text != blank %}
  <div
    data-index="{{ index }}"
    class="common-button-modal common-button-modal-{{ index }}"
    style="background-color:{{block.settings.button_wrap_bg_color}};padding-top:{{block.settings.button_padding_top | escape}}px;padding-bottom:{{block.settings.button_padding_bottom | escape}}px;"
  >
    <button
      class="index-button"
      style="background:{{ block.settings.button_bg_color }};color:{{ block.settings.button_text_color }}"
    >
      <span>{{ block.settings.button_text | escape }}</span>
      <div>
        <div class="arrow">
          <svg
            class="line"
            width="20"
            height="15"
            viewBox="0 0 20 15"
            version="1.1"
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
          >
            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
              <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                <g transform="translate(672.000000, 286.000000)">
                  <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                </g>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </button>

    <div class="jky-modal-dialog">
      <div class="common-modal-content">
        {% if block.settings.button_title != blank %}
          <div class="modal-content-title text-overflow-2">
            {{ block.settings.button_title }}
          </div>
        {% endif %}
        <div class="modal-content-content">
          {{ block.settings.button_content }}
        </div>
      </div>
    </div>
  </div>
{% endif %}

<style>
  .common-button-modal {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .common-button-modal .index-button {
    --index-button-p: 10px 0 10px 32px;
    --index-button-hover-p: 7px 7px 7px 16px;
    --index-button-r: 28px;
    --index-button-text: 18px;
    --index-button-h: 48px;
    --index-arrow-w: 0;
    --index-arrow-h: 0;
    --index-arrow-r: 28px;
    --index-arrow-ml: 9px;
    --index-arrow-svg-w: 14px;
    --index-arrow-hover-w: 32px;
    --index-arrow-hover-h: 32px;

    padding: var(--index-button-p);
    border-radius: var(--index-button-r);
    font-size: var(--index-button-text);
    color: #ffffff;
    display: flex;
    align-items: center;
    background: var(--primary-color);
    height: var(--index-button-h);
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.8, 0, 0.2, 1);
  }
  .common-button-modal .index-button > div {
    overflow: hidden;
  }
  .common-button-modal .index-button .arrow {
    width: var(--index-arrow-hover-w);
    height: var(--index-arrow-hover-h);
    border-radius: var(--index-arrow-r);
    background: rgba(253, 115, 51, 1);
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.8, 0, 0.2, 1);
    display: flex;
    transform: scale(0);
  }
  .common-button-modal .index-button svg {
    transform: translateX(calc(0px - var(--index-arrow-svg-w)));
    width: var(--index-arrow-svg-w);
    transition: all 0.4s cubic-bezier(0.8, 0, 0.2, 1);
  }

  .common-button-modal .index-button:hover {
    padding: var(--index-button-hover-p);
  }
  .common-button-modal .index-button:hover .common-button-modal .index-button > div {
    overflow: inherit;
  }
  .common-button-modal .index-button:hover .arrow {
    margin-left: var(--index-arrow-ml);
    transform: scale(1);
  }
  .common-button-modal .index-button:hover svg {
    transform: translateX(0);
  }
  .common-button-modal .index-button:active {
    background: #d25424;
  }

  @media screen and (max-width: 1440px) {
    .common-button-modal .index-button {
      --index-button-p: 0.694444444444444vw 0 0.694444444444444vw 2.22222222222222vw;
      --index-button-hover-p: 0.486111111111111vw 0.486111111111111vw 0.486111111111111vw 1.11111111111111vw;
      --index-button-r: 1.94444444444444vw;
      --index-button-text: 1.25vw;
      --index-button-h: 3.33333333333333vw;
      --index-arrow-w: 0;
      --index-arrow-h: 0;
      --index-arrow-r: 1.94444444444444vw;
      --index-arrow-ml: 0.625vw;
      --index-arrow-svg-l: 0.694444444444444;
      --index-arrow-svg-w: 0.972222222222222vw;
      --index-arrow-hover-w: 2.22222222222222vw;
      --index-arrow-hover-h: 2.22222222222222vw;
    }
  }
  @media screen and (max-width: 1023px) {
    .common-button-modal {
      width: 100%;
      padding-left: 5.33333333333333vw;
      padding-right: 5.33333333333333vw;
    }
    .common-button-modal .index-button {
      --index-button-p: 2.66666666666667vw 5.33333333333333vw;
      --index-button-hover-p: 2.66666666666667vw 5.33333333333333vw;
      --index-button-r: 5.33333333333333vw;
      --index-button-text: 3.73333333333333vw;
      --index-button-h: inherit;

      width: 100%;
    }
    .common-button-modal .index-button span {
      display: -webkit-box;
      text-overflow: ellipsis;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
      width: 100%;
    }
    .common-button-modal .index-button > div {
      display: none;
    }
  }

  .jky-modal-dialog .common-modal-content {
    display: none;
  }
  .common-modal.modal-container.modal .modal-content {
    width: 560px;
    border-radius: var(--theme-dialog-border-radius, 16px);
    overflow-y: unset;
    max-height: 90vh;
  }
  .common-modal.modal-container.modal .modal-content .moadal-header {
    border-bottom: unset;
    height: 0;
  }
  .common-modal .moadal-header .modal__close {
    top: 24px !important;
    right: 24px !important;
  }
  .common-modal .common-modal-content .modal-content-title {
    max-width: 450px;
    font-weight: 600;
    font-size: 32px;
    color: #363636;
    line-height: 40px;
    text-align: left;
    margin-bottom: 32px;
  }
  .common-modal .common-modal-content .modal-content-content {
    box-sizing: content-box;
    padding-right: 30px;
    overflow-y: auto;
    width: 486px;
    height: 422px;
    font-weight: 400;
    font-size: 18px;
    color: #666666;
    line-height: 26px;
    text-align: left;
  }
  .common-modal .common-modal-content .modal-content-content br:last-of-type {
    display: none;
  }

  .common-modal .common-modal-content .modal-content-content p {
    margin-bottom: 26px;
  }
  .common-modal .common-modal-content .modal-content-content p:last-of-type {
    margin-bottom: 0;
  }
  @media (max-width: 1024px) {
    .common-modal.modal-container.modal .modal-content {
      width: 82.93333333vw;
      border-radius: var(--theme-dialog-border-radius, 3.2vw);
    }
    .common-modal .moadal-header .modal__close {
      top: 5.33333333vw !important;
      right: 5.33333333vw !important;
    }
    .common-modal .common-modal-content .modal-content-title {
      max-width: 63.73333333vw;
      font-size: 5.33333333vw;
      line-height: 7.46666667vw;
      margin-bottom: 5.33333333vw;
    }
    .common-modal .common-modal-content .modal-content-content {
      padding-right: 5.06666667vw;
      width: 70.66666667vw;
      height: 75.73333333vw;
      font-size: 3.73333333vw;
      line-height: 5.33333333vw;
    }

    .common-modal .common-modal-content .modal-content-content p {
      margin-bottom: 5.33333333vw;
    }

    .common-modal .common-modal-content .modal-content-content::-webkit-scrollbar {
      height: auto;
    }
    .common-modal .common-modal-content .modal-content-content::-webkit-scrollbar-track {
      background-color: rgba(0, 0, 0, 0.05);
    }
    .common-modal .common-modal-content .modal-content-content::-webkit-scrollbar-thumb {
      background-color: rgba(144, 147, 153, 0.3);
      border-radius: 2px;
      box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.2);
    }
    .common-modal .common-modal-content .modal-content-content::-webkit-scrollbar-thumb:hover {
      background-color: #b6b7b9;
    }
  }
</style>

<script type="module">
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.common-button-modal').forEach(function (element) {
      let modalDom = element.querySelector('.common-modal-content');
      element
        .querySelector('.index-button')
        .addEventListener('click', function () {
          const popupHtml = modalDom;
          const uniqueId = `common-modal-id-${Math.random().toString(36).substring(2)}`;
          ZModle.getInstance(popupHtml, {
            id: uniqueId,
            class: 'common-modal',
          });
        });
    });
  });
</script>
