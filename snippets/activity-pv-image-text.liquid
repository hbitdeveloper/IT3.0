{% comment %} 光伏瓦页面-图文组件 {% endcomment %}
<style>
    .activity-block--pv-pic-text {
        background: rgb(249, 245, 239);
        padding: 85px 0;
    }

    .activity-block--pv-pic-text .container {
        width: 1312px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .activity-block--pv-pic-text .text-container {
        width: 800px;
        height: 450px;
        border-radius: 10px;
        padding: 80px 70px;
        background: rgb(255, 255, 255);
        display: flex;
        flex-direction: column;
        gap: 70px;
    }

    .activity-block--pv-pic-text .text-container .row {
        display: flex;
        flex-direction: column;
        text-align: left;
    }

    .activity-block--pv-pic-text .text-container .row .label {
        color: var(--jds-color-primary);
        font-size: 32px;
        font-weight: 600;
        line-height: 48px;
    }

    .activity-block--pv-pic-text .text-container .row .text {
        color: rgb(51, 51, 51);
        font-size: 25px;
        font-weight: 400;
        line-height: 42px;
    }

    .activity-block--pv-pic-text .text-container .row .buttons {
        margin-top: 20px;
        display: flex;
        justify-content: space-between;
    }

    .activity-block--pv-pic-text .text-container .row .buttons a {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 50px;
        border-radius: 100px;
        background: var(--jds-color-primary);
        color: rgb(255, 255, 255);
        font-size: 18px;
        font-weight: 500;
        line-height: 27px;
    }

    @media screen and (min-width: 1024px) {
        .activity-block--pv-pic-text .text-container .row .buttons a {
            min-width: 300px;
            padding-left: 12px;
            padding-right: 12px;
        }
    }

    @media screen and (max-width: 1023.98px) {

        .activity-block--pv-pic-text {
            padding: 65px 32px 70px;
        }


        .activity-block--pv-pic-text .container {
            width: 100%;
            flex-direction: column;
        }

        .activity-block--pv-pic-text .text-container {
            margin-top: calc(24 / 750 * 100vw);
            width: 100%;
            height: auto;
            border-radius: calc(15 / 750 * 100vw);
            padding: calc(40 / 750 * 100vw) calc(78 / 750 * 100vw);
            gap: calc(50 / 750 * 100vw);
        }

        .activity-block--pv-pic-text .text-container .row {
            text-align: center;
        }

        .activity-block--pv-pic-text .text-container .row .label {
            font-size: calc(32 / 750 * 100vw);
            line-height: calc(48 / 750 * 100vw);
        }

        .activity-block--pv-pic-text .text-container .row .text {
            font-size: calc(25 / 750 * 100vw);
            line-height: calc(42 / 750 * 100vw);
        }

        .activity-block--pv-pic-text .text-container .row .buttons {
            margin-top: 20px;
            flex-direction: column;
        }

        .activity-block--pv-pic-text .text-container .row .buttons a {
            margin-top: calc(28 / 750 * 100vw);
            width: calc(500 / 750 * 100vw);
            height: calc(80 / 750 * 100vw);
            border-radius: calc(100 / 750 * 100vw);
            font-size: calc(28 / 750 * 100vw);
            line-height: calc(42 / 750 * 100vw);
        }

    }
</style>

<div class="activity-block--pv-pic-text" {%if settings.anchor_id != blank%}anchor={{settings.anchor_id | escape}}{%endif%}>
    <div class="container">
        <div class="img-container">
            <picture>
                <source media="(max-width:1024px)" srcset="{{ settings.mb_img | image_url: width: 686 }}">
                <img class="blur-up" src="{{ settings.pc_img | image_url: width: 450 }}" loading="lazy" alt="{{ settings.pc_img.alt }}">
            </picture>
        </div>
        <div class="text-container">
            <div class="row">
                <div class="label">{{ settings.contact_info }}</div>
                <div class="text">{{ settings.email_text }}: {{ settings.email }}</div>
            </div>
            <div class="row">
                <div class="label">{{ settings.download_text }}</div>
                <div class="buttons">
                    <a href="{{ settings.manual_link }}">{{ settings.manual_link_text }}</a>
                    <a href="{{ settings.brochures_link }}">{{ settings.brochures_link_text }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
