{% comment %} 4.0商详页内容组件（Product Detail Page V4 Content） - 一行两组图文 {% endcomment %}
{{ 'pdp-two-text-img.min.css' | asset_url | stylesheet_tag }}

<div class="pdp-two-text-img pdp-container" data-play-video-by-order="{{ settings.play_by_order }}">
  {% assign brand_color = '<em style="color: var(--jds-color-primary)">' %}

  {% if settings.sectionTitle != blank %}
    <h2 class="section-title">
      {{ settings.sectionTitle | replace: '<em>', brand_color }}
    </h2>
  {% endif %}

  <div class="card-list">
    <div class="card-item">
      {% comment %} 视频展示 {% endcomment %}
      {% if settings.videoSrc != blank %}
        {%- assign autoplay = settings.autoplay -%}
        {%- assign loop = settings.loop -%}
        {%- if settings.play_by_order == true -%}
          {%- assign autoplay = false -%}
          {%- assign loop = false -%}
        {%- endif -%}

        {%- render 'jky-video',
          video_url: settings.videoSrc,
          poster: settings.poster,
          isHidePauseBtn: false,
          class: 'two-video-box pc-show',
          autoplay: autoplay,
          controls: settings.controls,
          loop: loop,
        -%}
      {% else %}
        <div class="pc-show">
          {% render 'pdp-picture-card',
            cardTitle: settings.title,
            pcEmptyShowBlank: true,
            pcImg: settings.partOnePCImg,
            pcWidth: 646,
            pcHeight: 480,
            mbEmptyShowBlank: false,
            mbImg: settings.partOneMBImg,
            mbWidth: 686,
            mbHeight: 644
          %}
        </div>
      {% endif %}

      {% if settings.videoSrcMB != blank %}
        {%- assign autoplay = settings.autoplay -%}
        {%- assign loop = settings.loop -%}
        {%- if settings.play_by_order == true -%}
          {%- assign autoplay = false -%}
          {%- assign loop = false -%}
        {%- endif -%}

        {%- render 'jky-video',
          video_url: settings.videoSrcMB,
          poster: settings.posterMB,
          isHidePauseBtn: false,
          class: 'two-video-box mb-show',
          autoplay: autoplay,
          controls: settings.controls,
          loop: loop,
        -%}
      {% else %}
        <div class="mb-show">
          {% render 'pdp-picture-card',
            cardTitle: settings.title,
            pcEmptyShowBlank: true,
            pcImg: settings.partOnePCImg,
            pcWidth: 646,
            pcHeight: 480,
            mbEmptyShowBlank: false,
            mbImg: settings.partOneMBImg,
            mbWidth: 686,
            mbHeight: 644
          %}
        </div>
      {% endif %}

      {% if settings.partOneTitle != blank %}
        <div class="title info-text">
          {{ settings.partOneTitle | replace: '<em>', brand_color }}
        </div>
      {% endif %}
      {% if settings.partOneSubtitle != blank %}
        <div class="subtitle info-text">
          {{ settings.partOneSubtitle | replace: '<em>', brand_color }}
        </div>
      {% endif %}
    </div>
    <div class="card-item">
      {% comment %} 视频展示 {% endcomment %}
      {% if settings.videoSrcTwo != blank %}
        {%- assign autoplayTwo = settings.autoplayTwo -%}
        {%- assign loopTwo = settings.loopTwo -%}
        {%- if settings.play_by_order == true -%}
          {%- assign autoplayTwo = false -%}
          {%- assign loopTwo = false -%}
        {%- endif -%}

        {%- render 'jky-video',
          video_url: settings.videoSrcTwo,
          poster: settings.posterTwo,
          isHidePauseBtn: false,
          class: 'two-video-box pc-show',
          autoplay: autoplayTwo,
          controls: settings.controlsTwo,
          loop: loopTwo
        -%}
      {% else %}
        <div class="pc-show">
          {% render 'pdp-picture-card',
            cardTitle: settings.title,
            pcEmptyShowBlank: true,
            pcImg: settings.partTwoPCImg,
            pcWidth: 646,
            pcHeight: 480,
            mbEmptyShowBlank: false,
            mbImg: settings.partTwoMBImg,
            mbWidth: 686,
            mbHeight: 644
          %}
        </div>
      {% endif %}

      {% if settings.videoSrcMBTwo != blank %}
        {%- assign autoplayTwo = settings.autoplayTwo -%}
        {%- assign loopTwo = settings.loopTwo -%}
        {%- if settings.play_by_order == true -%}
          {%- assign autoplayTwo = false -%}
          {%- assign loopTwo = false -%}
        {%- endif -%}

        {%- render 'jky-video',
          video_url: settings.videoSrcMBTwo,
          poster: settings.posterMBTwo,
          isHidePauseBtn: false,
          class: 'two-video-box mb-show',
          autoplay: autoplayTwo,
          controls: settings.controlsTwo,
          loop: loopTwo
        -%}
      {% else %}
        <div class="mb-show">
          {% render 'pdp-picture-card',
            cardTitle: settings.title,
            pcEmptyShowBlank: true,
            pcImg: settings.partTwoPCImg,
            pcWidth: 646,
            pcHeight: 480,
            mbEmptyShowBlank: false,
            mbImg: settings.partTwoMBImg,
            mbWidth: 686,
            mbHeight: 644
          %}
        </div>
      {% endif %}

      {% if settings.partTwoTitle != blank %}
        <div class="title info-text">
          {{ settings.partTwoTitle | replace: '<em>', brand_color }}
        </div>
      {% endif %}
      {% if settings.partTwoSubtitle != blank %}
        <div class="subtitle info-text">
          {{ settings.partTwoSubtitle | replace: '<em>', brand_color }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script defer src="{{ 'pdp-two-text-img.min.js' | asset_url }}"></script>
