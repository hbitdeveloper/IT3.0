<div class="newcomer-main-container newcomer-education-buttons newcomer-education-buttons-{{ index }}" anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', ''}}">
    {% if settings.left-text != blank %}
      <div class="left-btn">
        <a href="{{settings.left-link }}" target="{% if new_window %}_blank{% else %}_self{% endif %}">
            {{settings.left-text }}
        </a>
    </div>
    {% endif %}
   {% if settings.right-text != blank %}
    <div class="right-btn">
      <a href="{{settings.right-link }}" target="{% if new_window %}_blank{% else %}_self{% endif %}">
        {{settings.right-text }}
    </a>
    </div>
   {% endif %}
</div>

<style>
    .newcomer-education-buttons-{{ index }}{
        padding-top:{{ settings.pc_padding_top }}px;
        padding-bottom:{{ settings.pc_padding_bottom }}px;
    }
    @media screen and (min-width: 1024px) and (max-width: 1439.98px){
        .newcomer-education-buttons-{{ index }}{
            padding-top: calc( {{ settings.pc_padding_top }}  * 100vw / 1440 );
            padding-bottom: calc( {{ settings.pc_padding_bottom }}  * 100vw / 1440 );
        }
    }
    @media screen and (max-width: 1023.98px){
        .newcomer-education-buttons-{{ index }}{
            padding-top: calc( {{ settings.mb_padding_top }}  * 100vw / 750 );
            padding-bottom: calc( {{ settings.mb_padding_bottom }}  * 100vw / 750 );
        }
    }
</style>