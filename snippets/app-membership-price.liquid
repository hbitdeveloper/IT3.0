{% comment %}
    产品详情页 - 添加会员价

    Accepts: product
    Usage:
    {% render 'app-membership-price' %}
{% endcomment %}

{% comment %} 全局控制启用：open_membership_price {% endcomment %}
{%- if settings.open_membership_price == true -%}
  {% assign current_variant = product.selected_or_first_available_variant %}

  <div class="w-full product-membership-price-wrap hidden" style="display:none;" {{ block.shopify_attributes }}>
    <div
      id="app-membership-price"
      data-display-text="{{ product.metafields.my_fields.member_price_display_text }}"
      data-spu-id='{{ product.id }}'
      data-spu-title="{{ product.title }}"
      data-variant-id="{{ current_variant.id }}"
      data-variant-title="{{ current_variant.title }}"
      data-off-text="{{ 'membershipPrice.off' | t }}"
      data-rules-text="{{ 'membershipPrice.rules' | t }}"
      data-copy-text="{{ 'membershipPrice.copy' | t }}"
      data-copied-text="{{ 'membershipPrice.copied' | t }}"
      data-claim-text="{{ 'membershipPrice.claim' | t }}"
      data-get-text="{{ 'membershipPrice.get' | t }}"
      data-code-text="{{ 'membershipPrice.code' | t }}"
      data-login-to-apply-text="{{ 'membershipPrice.login_to_apply' | t }}"
      data-copy-to-apply-text="{{ 'membershipPrice.copy_to_apply' | t }}"
      data-click-to-apply-text="{{ 'membershipPrice.click_to_apply' | t }}"
      data-claim-code-success-tip-text="{{ 'membershipPrice.claim_code_success_tip' | t }}"
      data-copy-code-success-tip-text="{{ 'membershipPrice.copy_code_success_tip' | t }}"

      data-act-id="{{ product.metafields.custom.membership_price_act_id }}"
      data-ends-in-text="{{ 'membershipPrice.3600_plus.ends_in' | t }}"
      data-no-login-title="{{ 'membershipPrice.3600_plus.no_login_title' | t }}"
      data-no-login-btn-text="{{ 'membershipPrice.3600_plus.no_login_btn_text' | t }}"
      data-logged-and-claimed-with-auto-apply-title="{{ 'membershipPrice.3600_plus.logged_and_claimed_with_auto_apply_title' | t }}"
      data-logged-and-claimed-with-auto-apply-btn-text="{{ 'membershipPrice.3600_plus.logged_and_claimed_with_auto_apply_btn_text' | t }}"
      data-logged-and-claimed-with-no-auto-apply-title="{{ 'membershipPrice.3600_plus.logged_and_claimed_with_no_auto_apply_title' | t }}"
      data-logged-and-claimed-with-no-auto-apply-btn-text="{{ 'membershipPrice.3600_plus.logged_and_claimed_with_no_auto_apply_btn_text' | t }}"
      data-logged-and-unclaimed-title="{{ 'membershipPrice.3600_plus.logged_and_unclaimed_title' | t }}"
      data-logged-and-unclaimed-btn-text="{{ 'membershipPrice.3600_plus.logged_and_unclaimed_btn_text' | t }}"
    ></div>

    {% comment %} {{ 'plugin-app-membership-price.min.css' | asset_url | stylesheet_tag }} {% endcomment %}
    <script src="{{ 'plugin-app-membership-price.min.js' | asset_url }}" defer></script>
  </div>
{% endif %}
