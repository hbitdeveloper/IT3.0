<div class="five-kwh-pick" anchor="{{ pick.settings.anchor_id  | url_decode | strip | replace: ' ', ''}}" style="background: {{ pick.settings.bgColor }};">
  <div class="new-main-container five-main-container">
    <div class="benefits">
      <div class="module-title" style="text-align: {{ pick.settings.title-pos }};">
        {% assign titleColor = '<em style="color: ' | append: pick.settings.module_title_color | append: '">' %}
        <div class="title">
            {{ pick.settings.module_title | replace: '<em>', titleColor }}
        </div>

        {%- if pick.settings.button_text != blank -%}
          <a
            data-ga-event="home_page_exclusive_advantage4.0"
            data-ga-action="click"
            data-ga-params-module="{{ pick.settings.module_title | escape }}"
            data-ga-params-link="{{ pick.settings.url }}"
            data-ga-params-button_name="{{ pick.settings.button_text | escape}}"
            data-ga-params-type="Exclusive advantage"
            class="pc-block"
            target="{% if pick.settings.new_window %}_blank{% else %}_self{% endif %}"
            href="{{ pick.settings.url }}"
          >
            <button class="five-button">
              <span>{{ pick.settings.button_text | escape }}</span>
              <div>
                <div class="arrow">
                  <svg
                    class="line"
                    width="20"
                    height="15"
                    viewBox="0 0 20 15"
                    version="1.1"
                    xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                  >
                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                        <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                            <g transform="translate(672.000000, 286.000000)">
                                <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                            </g>
                        </g>
                    </g>
                  </svg>
                </div>
              </div>
            </button>
          </a>
        {%- endif -%}
      </div>

      {% assign subTitleColor = '<em style="color: ' | append: pick.settings.sub_title_color | append: '">' %}
      <div class="module-sub-title" style="text-align: {{ pick.settings.title-pos }};">
        {{ pick.settings.sub_title | replace: '<em>', subTitleColor }}
      </div>

      <div class="box">
        {% for i in (0..3) %}
          {% assign icon_index = 'icon_' | append: forloop.index %}
          {% assign gif_index = 'gif_' | append: forloop.index %}
          {% assign title_index = 'title_' | append: forloop.index %}
          {% assign sub_title_index = 'sub_title_' | append: forloop.index %}
          {%- if pick.settings[icon_index] -%}
            <div class="box-item">
              <div class="box-content">
                <img src="{{ pick.settings[icon_index] | image_url: width: 80}}" alt="{{ pick.settings[icon_index].alt }}" class="show-image" loading="lazy">
                {% if  pick.settings[gif_index] != blank %}
                  <img src="{{ pick.settings[gif_index] | image_url: width: 80}}" alt="{{ pick.settings[gif_index].alt }}" class="show-gif" loading="lazy">
                {% elsif pick.settings[icon_index] != blank %}
                  <img src="{{ pick.settings[icon_index] | image_url: width: 80}}" alt="{{ pick.settings[icon_index].alt }}" class="show-gif" loading="lazy">
                {% endif %}
                <div class="title line-clamp-2">{{ pick.settings[title_index] }}</div>
                <div class="sub-title line-clamp-2">{{ pick.settings[sub_title_index] }}</div>
              </div>
            </div>
          {%- endif -%}
        {% endfor %}

      </div>
      {%- if pick.settings.button_text != blank -%}
        <div class="view-more">
          <a
            data-ga-event="home_page_exclusive_advantage4.0"
            data-ga-action="click"
            data-ga-params-module="{{ pick.settings.module_title | escape }}"
            data-ga-params-link="{{ pick.settings.url }}"
            data-ga-params-button_name="{{ pick.settings.button_text }}"
            data-ga-params-type="Exclusive advantage"
            class="mobile-block"
            target="{% if new_window %}_blank{% else %}_self{% endif %}"
            href="{{ pick.settings.url }}"
          >
            <button class="five-button">
              <span>{{ pick.settings.button_text | escape }}</span>
            </button>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
