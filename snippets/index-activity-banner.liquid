{% comment %} 活动banner {% endcomment %}
<a target="{% if new_window %}_blank{% else %}_self{% endif %}" href="{{ activity.settings.link }}">
  <div class="activity-img-box">
    {%- assign image_priority = 'default' -%}
    {% if index == 1 %}
      {%- assign image_priority = 'lcp' -%}
    {% endif %}
    
    {% render 'diff-end-img',
      picture_class:'',
      class: 'activity-img',
      pc_img: activity.settings.pc_image,
      mb_img: activity.settings.mb_image,
      pc_img_width: 1920,
      mb_img_width: 750,
      placeholder_name: 'hero-apparel-1',
      alt: activity.settings.pc_image.alt | default: 'image alt',  
      load_scene: activity.settings.load_scene | default: image_priority,
    %}
  </div>
  <div class="absolute-box">
    <div class="title-box banner-{{ activity.settings.pc_position}} mb-{{ activity.settings.mb_position }}">
      <div class="mini-title activity-mini">
        <div class="activity-title regular-animate" style="color: {{ activity.settings.activity_title_color}};">
          {{ activity.settings.activity_title }}
        </div>

        {% assign titleColor = '<em style="color: ' | append: activity.settings.title_main_color | append: '">' %}
        <h2 class="pc-h2 regular-animate" style="color: {{ activity.settings.pc_main_color }}">
          {% if activity.settings.title != blank %}
            {{ activity.settings.title | replace: '<em>', titleColor }}
          {% elsif activity.settings['title-mb'] != blank %}
            {{ activity.settings['title-mb'] | replace: '<em>', titleColor }}
          {% endif %}
        </h2>

        <h2 class="mb-h2 regular-animate" style="color: {{ activity.settings.mb_main_color }}">
          {% if activity.settings['title-mb'] != blank %}
            {{ activity.settings['title-mb'] | replace: '<em>', titleColor }}
          {% elsif activity.settings.title != blank %}
            {{ activity.settings.title | replace: '<em>', titleColor }}
          {% endif %}
        </h2>

        {% assign subTitleColor = '<em style="color: '
          | append: activity.settings.sub_title_main_color
          | append: '">'
        %}
        <div class="sub-title regular-animate" style="color: {{ activity.settings.pc_sub_main_color }}">
            {% if activity.settings.sub_title != blank %}
                {{ activity.settings.sub_title | replace: '<em>', subTitleColor }}
            {% elsif activity.settings.mb_sub_title != blank %}
                {{ activity.settings.mb_sub_title | replace: '<em>', subTitleColor }}
            {% endif %}
        </div>
          <div class="mb-sub-title regular-animate" style="color: {{ activity.settings.mb_sub_main_color }}">
              {% if activity.settings.mb_sub_title != blank %}
                  {{ activity.settings.mb_sub_title | replace: '<em>', subTitleColor }}
              {% elsif activity.settings.sub_title != blank %}
                  {{ activity.settings.sub_title | replace: '<em>', subTitleColor }}
              {% endif %}
          </div>

        {% if activity.settings.button_front_text != blank and activity.settings.button_text != blank %}
          <div
            class="activity-btn regular-animate"
            style="background: {{ activity.settings.activity_button_color }} ;"
          >
            <div class="ellipsis">
              <div class="front-text ellipsis" style="color: {{ activity.settings.button_front_text_color }}">
                {{ activity.settings.button_front_text }}
              </div>
            </div>

            <div class="ellipsis">
              <button class="index-button ellipsis activity-btn-mini" style="background: {{ activity.settings.button_color }}">
                <span class="ellipsis ellipsis-mini">{{ activity.settings.button_text }}</span>
                <div>
                  <div class="arrow">
                    <svg
                      class="line"
                      width="20"
                      height="15"
                      viewBox="0 0 20 15"
                      version="1.1"
                      xmlns="http://www.w3.org/2000/svg"
                      xmlns:xlink="http://www.w3.org/1999/xlink"
                    >
                      <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                          <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                              <g transform="translate(672.000000, 286.000000)">
                                  <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                              </g>
                          </g>
                      </g>
                    </svg>
                  </div>
                </div>
              </button>
            </div>
          </div>
          {% elsif activity.settings.button_text != blank %}
            <div class="regular-animate">
              <button class="index-button ellipsis" style="background: {{ activity.settings.button_color }}">
                <span class="ellipsis">{{ activity.settings.button_text }}</span>
                <div>
                  <div class="arrow">
                    <svg
                      class="line"
                      width="20"
                      height="15"
                      viewBox="0 0 20 15"
                      version="1.1"
                      xmlns="http://www.w3.org/2000/svg"
                      xmlns:xlink="http://www.w3.org/1999/xlink"
                    >
                      <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                          <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                              <g transform="translate(672.000000, 286.000000)">
                                  <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                              </g>
                          </g>
                      </g>
                    </svg>
                  </div>
                </div>
              </button>
            </div>
        {% endif %}
      </div>
    </div>
  </div>
</a>
{% comment %} </div> {% endcomment %}

{% comment %} {{ 'index-activity-banner.bundle.css' | asset_url | stylesheet_tag }} {% endcomment %}