<section
  class="
    w-full flex flex-col flex-center bg-white mt-40 mb-30
    lg:j-px-0 lg:j-mt-32 lg:j-mb-50 xl:a-px-0 xl:a-mt-32 xl:a-mb-50
    balcony-scale-img-wrap
  "
>
  <h2 class="
    w-full text-left font-600 text-black text-48 leading-68
    lg:j-text-40 lg:j-leading-48 lg:j-pt-32 xl:a-text-40 xl:a-leading-48 xl:a-pt-32
  ">{{ settings.title | newline_to_br }}</h2>
  <p class="
    w-full text-left font-400 text-black text-36 leading-48 py-30
    lg:j-text-24 lg:j-leading-34 lg:j-py-18 xl:a-text-24 xl:a-leading-34 xl:a-py-18
  ">{{ settings.sub_title | newline_to_br }}</p>
  <div class="relative w-full h-auto flex-center flex-col lg:flex-row">
    {% comment %} image and video {% endcomment %}
      <div class="pc-block w-full h-auto">
          {%-
                  render 'jky-video',
                  video_url: settings.product_video_pc,
                  autoplay: settings.autoplay,
                  loop: true,
                  poster: settings.pc_img,
                  controls: settings.control_video
          -%}
      </div>
      <div class="mobile-block w-full h-auto">
          {%-
                  render 'jky-video',
                  video_url: settings.product_video_mb,
                  autoplay: settings.autoplay,
                  loop: true,
                  poster: settings.mb_img,
                  controls: settings.control_video
          -%}
      </div>
    {%- assign sizes = 0 -%}
    {%- for i in (0..3) -%}
        {% assign text_index = 'text_' | append: forloop.index %}
        {%- if settings[text_index] != blank -%}
            {%- assign sizes = sizes | plus: 1 -%}
        {%- endif -%}
    {%- endfor -%}

    {% if sizes > 0 %}
      <ul class="
        w-full flex flex-col lg:flex-row justify-center items-start lg:items-stretch text-#1A1A1A static pt-40
        lg:pt-0 lg:absolute lg:j-left-0 lg:j-bottom-0 lg:text-white lg:j-gap-40 xl:a-gap-40 lg:j-bottom-30 xl:a-bottom-30
      " style="z-index:4;">
        {%- for i in (0..3) -%}
            {% assign text_index = 'text_' | append: forloop.index %}
            {%- if settings[text_index] != blank -%}
              <li class="balcony-why-choose-item">
                <span class="
                  text-32 leading-48 pl-24 lg:line-clamp-3
                  lg:j-w-265 lg:j-text-20 lg:j-leading-26 lg:j-pl-0
                  xl:a-w-265 xl:a-text-20 xl:a-leading-26 xl:a-pl-0
                ">{{ settings[text_index] | newline_to_br }}</span>
              </li>
            {%- endif -%}
        {%- endfor -%}
      </ul>
    {% endif %}
  </div>
</section>
