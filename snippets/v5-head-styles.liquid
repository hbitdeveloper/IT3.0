{%- doc -%}
  Head中通用样式文件
{%- enddoc -%}

{% comment %} 字体图标+品牌字体 {% endcomment %}
{% render 'head-font' %}

{% comment %} V5.0主题样式 {% endcomment %}
{% if settings.jky_theme_version == 'v5' %}
  {{ 'common-theme-v5.min.css' | asset_url | stylesheet_tag: preload: true }}
  <link rel="stylesheet" href="{{ 'common-theme-v5.min.css' | asset_url }}">
{% elsif settings.jky_theme_version == 'v5-eu' %}
  {{ 'common-theme-v5-eu.min.css' | asset_url | stylesheet_tag: preload: true }}
  <link rel="stylesheet" href="{{ 'common-theme-v5-eu.min.css' | asset_url }}">
{% else %}
  {{ 'plugin-jds-theme-v1.min.css' | asset_url | stylesheet_tag: preload: true }}
  {{ 'common-theme.min.css' | asset_url | stylesheet_tag: preload: true }}
  <link rel="stylesheet" href="{{ 'plugin-jds-theme-v1.min.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'common-theme.min.css' | asset_url }}">
{% endif %}

{% comment %} 全局自定义封装组件样式 {% endcomment %}
 {{ 'global-components.min.css' | asset_url | stylesheet_tag: preload: true }}
<link rel="stylesheet" href="{{ 'global-components.min.css' | asset_url }}">

