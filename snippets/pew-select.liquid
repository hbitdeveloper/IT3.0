{% endcomment %}
{% if disabled == blank %}
  {% assign disabled = false %}
{% endif %}

{% if select_id != blank %}
  {% assign select_wrapper = select_id | append: '_wrapper' %}
  {% assign select_hidden = select_id %}
{% else %}
  {% assign select_wrapper = 'pew-select_wrapper' %}
  {% assign select_hidden = 'pew-select' %}
{% endif %}

<div class="pew-select" id="{{ select_wrapper }}" disabled="{{disabled}}">
  <div class="select-selected selected-box">
    <span class="selected-text" data-text="{{ select_placeholder }}">{{ select_placeholder }}</span>
    <span class="close-icon">
      {% render 'jky-icon-circle-close-normal', size: 16, color: '#666' %}
    </span>
    <span class="arrow">
      {% render 'icon-arrow-up' %}
    </span>
  </div>
  <ul class="select-items item-list">
    {% comment %} 数据项将被动态插入 {% endcomment %}
  </ul>

  {% comment %} 子下拉项 {% endcomment %}
  <div class="sub-wrapper">
    <div class="sub-selected selected-box">
      <span class="selected-text"></span>
      <span class="arrow">
        {% render 'icon-arrow-up' %}
      </span>
    </div>
    <ul class="sub-items item-list">
      {% comment %} 子数据项动态插入 {% endcomment %}
    </ul>
  </div>
</div>
