{% comment %} 日本站-cart 报价单 {% endcomment %}
{%- if cart.item_count > 0 -%}
      {%- if cart.items.size > 0-%}
      <style>
        .baojiadanForm input[type=checkbox],[type=radio] {margin-right: 10px;}
        .baojiadanForm input {border: 1px solid #e8e8e1;background-color: transparent; color: inherit;    max-width: 100%;padding: 8px 10px;border-radius: 0;font-weight: 400;font-size: 16px;box-sizing: border-box;line-height: 1.8;}
        .baojiadanForm select:active {border: 1px solid #e8e8e1;}
        .baojiadanForm input {border: 1px solid #e8e8e1;background-color: transparent; color: inherit;    max-width: 100%;padding: 8px 10px;border-radius: 0;font-weight: 400;font-size: 16px;box-sizing: border-box;line-height: 1.8;}
        .baojiadanForm select {border: 1px solid #e8e8e1;background-color: transparent;color: inherit;background-repeat: no-repeat;background-position: right 10px center;background-size: 11px;cursor: pointer;display: inline-block;vertical-align: middle;padding-right: 28px;text-indent: 0.01px;appearance: none;max-width: 100%;padding: 8px 10px;border-radius: 0;font-weight: 400;line-height: 1.8; background-image: url(https://www.jackery.jp/cdn/shop/t/492/assets/ico-select.svg);}


        #baojiadanForm1012 {width:100%; display:flex; flex-direction: column; align-items: center; margin-top: 60px; padding: var(--gap);}
        #baojiadanForm1012 .baojiadanForm_bigTitle {font-family: var(--jds-font-family); font-size: 18px; color: #000000; text-align: center; font-weight: 600;}
        #baojiadanForm1012 .baojiadanForm_formTd {
          width: 94%; max-width: 600px; min-height: 38px; margin-top: 18px; position: relative;
          display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
          --tips: "";
        }
        #baojiadanForm1012 .baojiadanForm_formTd::after {content: var(--tips); width: 100%; line-height: 24px; font-size: 12px; color: #ff0000;}
        #baojiadanForm1012 .baojiadanForm_input {flex-grow:1;}
        #baojiadanForm1012 .baojiadanForm_select {width:100px; flex-shrink: 0;}
        #baojiadanForm1012 .baojiadanForm_must {
          font-family: var(--jds-font-family); font-size: 14px; color: #333333; text-align: center; font-weight: 500;
          position: absolute; left: -10px;
        }
        #baojiadanForm1012 .baojiadanForm_formTd._checkbox {justify-content: flex-start;}
        ._checkbox p {font-size: 12px; flex: 90% 0 0;}
        ._checkbox a {text-decoration: underline;}
        #baojiadanForm1012 .baojiadanForm_submitButton {
          width:140px; height:38px; font-family: var(--jds-font-family); font-size: 14px; color: #333333; text-align: center; font-weight: 400; line-height: 38px;
          border: 1px solid #333333; border-radius: 2px; cursor: pointer; margin-top:18px;
        }
        @media only screen and (max-width: 768px) {
          #baojiadanForm1012 .baojiadanForm_input {width: calc(100% - 100px);}
        }
        .shake-bottom {
          animation: shake-bottom 0.8s cubic-bezier(0.455, 0.030, 0.515, 0.955) both;
        }
        @keyframes shake-bottom {
          0%, 100% {transform: rotate(0deg); transform-origin: 50% 100%;}
          10% {transform: rotate(2deg);}
          20%, 40%, 60% {transform: rotate(-4deg);}
          30%, 50%, 70% {transform: rotate(4deg);}
          80% {transform: rotate(-2deg);}
          90% {transform: rotate(2deg);}
        }
      </style>
      <div class="baojiadanForm" id="baojiadanForm1012">
        <div class="baojiadanForm_bigTitle">宛名入りのお見積書を出力できます。</div>
        <div class="baojiadanForm_formTd">
          <input class="baojiadanForm_input" placeholder="宛名※必須" id="username"/>
          <select class="baojiadanForm_select" id="sex">
            <option value="御中">御中</option>
            <option value="様">様</option>
            <option value="方">方</option>
          </select>
          <div class="baojiadanForm_must">*</div>
        </div>
        <div class="baojiadanForm_formTd">
        	<input class="baojiadanForm_input" placeholder="メールアドレス" id="email"/>
          <div class="baojiadanForm_must">*</div>
        </div>
        <div class="baojiadanForm_formTd">
        	<input class="baojiadanForm_input" placeholder="電話番号" id="phone"/>
        </div>
        <div class="baojiadanForm_formTd _checkbox">
        	<input type="checkbox" class="quotation_checkbox">
          <p>
            <a href="https://www.jackery.jp/pages/terms-of-service" title="利用規約">利用規約</a>や
            <a href="https://www.jackery.jp/pages/privacy" title="プライバシーポリシー">プライバシーポリシー</a>に同意の上、送信してください。
          </p>
          <div class="baojiadanForm_must">*</div>
        </div>
        <div class="baojiadanForm_submitButton">お見積りを表示</div>
      </div>
      <script src="{{ 'plugin-baojiadan.min.js' | asset_url }}" defer></script>
      {%- endif -%}
{%- endif -%}