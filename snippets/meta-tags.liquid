{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="template" content="{{ template }}">

{% if template contains 'page.earth-day' %}
  <meta name="keywords" content="{{ page.metafields.custom.keywords }}">
  <meta name="description" content="{{ og_description }}">
  {%- assign current_url = content_for_header | split:'"pageurl":"' | last | split:'"' | first | split:'?' -%}
  {%- assign params = current_url[1] | split:'\u0026' -%}
  {%- for param in params -%}
    {%- if param contains "email" -%}
      {%- assign user_email = param | split:'=' | last -%}
    {%- endif -%}
  {%- endfor -%}

  {% assign time = 'now' | date: '%s' %}

  {% comment %} facebook 多次携值重定的额外处理 {% endcomment %}
  {% if user_email != blank %}
    {% assign user_image = user_email | append: ".jpg?t=" | append: time %}
    {% assign user_image = user_image | replace: ".jpg.jpg", ".jpg" %}
  {% else %}
    {% assign user_image = nil %}
  {%- endif -%}

  {% if user_image %}
    {% assign curr_og_url = canonical_url | append: "?email=" | append: user_image %}
  {% else %}
    {% assign curr_og_url = canonical_url | append: "?t=" | append: time %}
  {%- endif -%}

  <meta property="og:site_name" content="Jackery" />
  <meta property="og:url" content="{{ curr_og_url }}" />
  <meta property="og:title" content="{{ page_title }}" />
  <meta property="og:description" content="{{ og_description }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:image:width" content="1920" />
  <meta property="og:image:height" content="1080" />

  {% if user_image %}
    <noscript>
      <img class="og-image" src="{{ 'https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay/' | append: user_image }}" alt="" loading="lazy">
    </noscript>
    <meta property="og:image" content="{{ 'https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay/' | append: user_image }}" />
  {% endif %}

  <meta property="og:image:alt" content="{{ og_description }}" />
  <meta name="twitter:site" content="Jackery" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ page_title }}" />
  <meta name="twitter:description" content="{{ og_description }}" />
  {% if user_image %}
    <meta property="twitter:image" content="{{ 'https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay/' | append: user_image }}" />
  {% endif %}

  {% if user_image %}
    <noscript>
      <img class="og-image" src="{{ 'https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay/' | append: user_image }}" alt="" loading="lazy">
    </noscript>
    <meta property="og:image" content="{{ 'https://s3.us-west-2.amazonaws.com/r.jackery.net/earthDay/' | append: user_image }}" />
  {% endif %}

{% elsif template == 'page.crossword' or template == 'page.crossword-puzzle' or template == 'page.crossword-new' %}
  <meta name="keywords" content="Jackery crossword, crossword with pictures">
  <meta name="description" content="{{ og_description }}">

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ og_url }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ og_description }}">
  <meta property="og:image" content="{{settings.social_share_pic}}">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:site" content="Jackery" />
  <meta property="twitter:domain" content="jackery.com">
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ og_description }}">
  <meta property="twitter:url" content="{{ og_url }}">
  <meta property="twitter:image" content="{{settings.social_share_pic}}">

{% else %}
  {% comment %} 特定页面 description meta标签配置 {% endcomment %}
  {%- liquid
    if request.path == '/collections/all'
      assign og_description = 'page_meta_description.page_collections_all' | t
    elsif request.path == '/policies/privacy-policy'
      assign og_description = 'page_meta_description.page_privacy-policy' | t
    elsif request.path == '/policies/terms-of-service'
      assign og_description = 'page_meta_description.page_terms-of-service' | t
    endif
  %}
  <meta name="description" content="{{ og_description }}">

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ og_url }}">
  <meta property="og:title" content="{{ og_title | escape }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:description" content="{{ og_description }}">

  {% if page.metafields.custom.facebook_share_image %}
    <meta property="og:image" content="https:{{ page.metafields.custom.facebook_share_image | image_url }}">
    <meta property="og:image:secure_url" content="https:{{ page.metafields.custom.facebook_share_image | image_url }}">
    <meta property="og:image:width" content="1920">
    <meta property="og:image:height" content="1080">
  {% else %}
    {%- if page_image -%}
      <meta property="og:image" content="https:{{ page_image | image_url }}">
      <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
      <meta property="og:image:width" content="{{ page_image.width }}">
      <meta property="og:image:height" content="{{ page_image.height }}">
    {%- endif -%}
  {%- endif -%}

  {%- if request.page_type == 'product' -%}
    <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
    <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {%- endif -%}

  {%- if settings.social_twitter_link != blank -%}
    <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title | escape }}">
  <meta name="twitter:description" content="{{ og_description }}">
  {%- if page.metafields.custom.twitter_share_image -%}
    <meta property="twitter:image" content="https:{{ page.metafields.custom.twitter_share_image | image_url }}">
    <meta name="twitter:image:src" content="https:{{ page.metafields.custom.twitter_share_image | image_url }}">
  {%- else -%}
    {%- if page_image -%}
      <meta property="twitter:image" content="https:{{ page_image | image_url }}">
      <meta name="twitter:image:src" content="https:{{ page_image | image_url }}">
    {%- endif -%}
  {%- endif -%}
{% endif %}
