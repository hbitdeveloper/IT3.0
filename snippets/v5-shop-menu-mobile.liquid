                                        class="w-full justify-center mb-3 flex"
                                        data-shop_collection_max="{{settings.shop_collection_max}}"
                                        data-default_nums_allblock="{{default_nums_allblock}}"
                                    >
                                            <svg class="w-10 h-10 rounded-full py-3 pl-2 pr-1 v5-shop-view_more" viewBox="0 0 1024 1024" width="16" height="16"><path d="M818.07039273 512L329.94971923 23.87932647l-111.86098796 101.69180708L604.51759771 512 218.08873127 898.42886645 329.94971923 1010.28985441z" fill="#1a1a1a"></path></svg>
                                    </div>
                                {%- endif -%}
                            </div>
                        </div>
                    </div>
                </drawer-dialog>
            {%- else -%}

            {%- endif -%}
        {%- endif -%}
    {%- endfor -%}
{%- endif  -%}
