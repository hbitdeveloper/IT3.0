{% comment %}
    Render icon prev (轮播图左箭头图标 - < )

    Accepts:
    - diameter: {Number} 圆直径
    - class: {String} 样式类名

    Usage:
    {% render 'jky-icon-prev', class: 'icon-prev-test', diameter: 48, color: 'white', bgColor: 'black' %}
{% endcomment %}

{% if class == blank %}
	{% assign class = 'jky-icon-prev' %}
{% endif %}

{% if diameter == blank %}
	{% assign diameter = 48 %}
{% endif %}

{% assign radius  = diameter | divided_by: 2 %}

{% if color == blank %}
	{% assign color = '#fff' %}
{% endif %}

{% if bgColor == blank %}
	{% assign bgColor = 'rgba(0,0,0,0.2)' %}
{% endif %}

<svg class="{{ class }}" width="{{ diameter }}" height="{{ diameter }}" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
	<circle cx="24" cy="24" r="24" fill="{{ bgColor }}"/>
	<path fill-rule="evenodd" clip-rule="evenodd"
				d="M18 24.0288C18 24.2459 18.0393 24.4462 18.1179 24.6296C18.1965 24.8131 18.3219 24.9871 18.4941 25.1519L27.1753 33.6533C27.4523 33.9303 27.7892 34.0688 28.186 34.0688C28.4556 34.0688 28.6989 34.0033 28.916 33.8723C29.1331 33.7413 29.3072 33.5691 29.4382 33.3557C29.5693 33.1423 29.6348 32.9009 29.6348 32.6313C29.6348 32.242 29.4813 31.8939 29.1743 31.5869L21.4141 24.0288L29.1743 16.4707C29.4813 16.1712 29.6348 15.8231 29.6348 15.4263C29.6348 15.1567 29.5693 14.9153 29.4382 14.7019C29.3072 14.4885 29.1331 14.3182 28.916 14.1909C28.6989 14.0636 28.4556 14 28.186 14C27.7892 14 27.4523 14.1348 27.1753 14.4043L18.4941 22.9058C18.3219 23.0705 18.1965 23.2445 18.1179 23.428C18.0393 23.6114 18 23.8117 18 24.0288Z"
				fill="{{ color }}"/>
</svg>
