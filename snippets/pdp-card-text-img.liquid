
<style>
    .pdp-card-text-img-{{index}}{
        margin: {{ settings.pc_margin_x }}px 0;
        background-color: {{ settings.bgColor }};
    }
    .pdp-card-text-img-{{index}} .pdp-card-content{
        justify-content: {{ settings.pc_type | replace: '_', '-'}};
        height: {{ settings.pc_height }}px;
    }
    .pdp-card-text-img-{{index}} img{
        height: {{ settings.pc_height }}px;
    }
    @media screen and (max-width: 1440px) {
        .pdp-card-text-img-{{index}}{
            margin: calc( {{ settings.pc_margin_x }}  * 100vw / 1440 )  0;
        }
        .pdp-card-text-img-{{index}} .pdp-card-content{
            height: calc( {{ settings.pc_height }}* 100vw / 1440 );
        }
        .pdp-card-text-img-{{index}} img{
            height: calc( {{ settings.pc_height }} * 100vw / 1440 );
        }
    }
    @media screen and (max-width: 1024px) {
        .pdp-card-text-img-{{index}}{
            margin: calc( {{ settings.mb_margin_x }}  * 100vw / 750 )  0;
        }
        .pdp-card-text-img-{{index}} .pdp-card-content{
            height: calc( {{ settings.mb_height }}* 100vw / 750 );
        }
        .pdp-card-text-img-{{index}} img{
            height: calc( {{ settings.mb_height }} * 100vw / 750 );
        }
    }
</style>
<div class="pdp-card-text-img pdp-card-text-img-{{ index }} pdp-container" anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', ''}}"  style="background:{{ settings.bgColor }};">
    <div class="pdp-card-content">
        {%- 
            render 'responsive-image', 
            image: settings.pc_image, 
            width: 1312, 
            mimage: settings.mb_image, 
            mwidth: 343, 
            image_class: 'pdp-card-image object-contain' 
        -%}
        <div class="pdp-card-text">
            {% assign brand_color = '<em style="color: var(--jds-color-primary)">' %}
            {% if settings.title != blank %}
                <h2 class="title" style="color: {{ settings.title_color }};">
                {{ settings.title | replace: '<em>', brand_color }}
                </h2>
            {% endif %}

            {% if settings.description != blank %}
                <div class="description" style="color: {{ settings.description_color }};">
                    {{ settings.description | replace: '<em>', brand_color }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
