{% comment %} 普通banner {% endcomment %}
<a target="{% if new_window %}_blank{% else %}_self{% endif %}" href="{{ general.settings.link }}">
  <div class="general-img-box">
    {%- assign image_priority = 'default' -%}
    {% if index == 1 %}
      {%- assign image_priority = 'lcp' -%}
    {% endif %}
    
    {% render 'diff-end-img',
      picture_class:'',
      class: 'general-img',
      pc_img: general.settings.pc_image,
      mb_img: general.settings.mb_image,
      pc_img_width: 1920,
      mb_img_width: 750,
      placeholder_name: 'hero-apparel-1',
      alt: general.settings.pc_image.alt | default: 'image alt',  
      load_scene: general.settings.load_scene | default: image_priority,
    %}
  </div>
  <div class="absolute-box">
    <div class="title-box banner-{{general.settings.pc_position}} mb-{{ general.settings.mb_position }}">
      <div class="mini-title">
        {% assign titleColor = '<em style="color: ' | append: general.settings.title_main_color | append: '">' %}
        <h2 class="pc-h2 regular-animate" style="color: {{ general.settings.pc_main_color }}">
          {% if general.settings.title != blank %}
            {{ general.settings.title | replace: '<em>', titleColor }}
          {% elsif general.settings['title-mb'] != blank %}
            {{ general.settings['title-mb'] | replace: '<em>', titleColor }}
          {% endif %}
        </h2>

        <h2 class="mb-h2 regular-animate" style="color: {{ general.settings.mb_main_color }}">
          {% if general.settings['title-mb'] != blank %}
            {{ general.settings['title-mb'] | replace: '<em>', titleColor }}
          {% elsif general.settings.title != blank %}
            {{ general.settings.title | replace: '<em>', titleColor }}
          {% endif %}
        </h2>

        {% assign subTitleColor = '<em style="color: ' | append: general.settings.sub_title_main_color | append: '">' %}
        <div class="sub-title regular-animate" style="color: {{ general.settings.pc_sub_main_color }}">
          {% if general.settings.sub_title != blank %}
            {{ general.settings.sub_title | replace: '<em>', subTitleColor }}
          {% elsif general.settings.mb_sub_title != blank %}
            {{ general.settings.mb_sub_title | replace: '<em>', subTitleColor }}
          {% endif %}
        </div>
        <div class="mb-sub-title regular-animate" style="color: {{ general.settings.mb_sub_main_color }}">
          {% if general.settings.mb_sub_title != blank %}
            {{ general.settings.mb_sub_title | replace: '<em>', subTitleColor }}
          {% elsif general.settings.sub_title != blank %}
            {{ general.settings.sub_title | replace: '<em>', subTitleColor }}
          {% endif %}
        </div>
        {%- if general.settings.button_text != blank -%}
          <div class="regular-animate">
            <button class="index-button" style="background: {{ general.settings.button_color }}">
              <span class="ellipsis">{{ general.settings.button_text }}</span>
              <div>
                <div class="arrow">
                  <svg
                    class="line"
                    width="20"
                    height="15"
                    viewBox="0 0 20 15"
                    version="1.1"
                    xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                  >
                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                        <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                            <g transform="translate(672.000000, 286.000000)">
                                <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                            </g>
                        </g>
                    </g>
                  </svg>
                </div>
              </div>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</a>
