{% comment %}
    @description: 批量购买 - 下载报价单弹窗
{% endcomment %}
<div
    {{ attributes }}
    class="download-price-list-modal"
    data-first_error="{{ 'bulk_program.price_list.first_name_error' | t }}"
    data-last_error="{{ 'bulk_program.price_list.last_name_error' | t }}"
    data-email_error="{{ 'bulk_program.price_list.email_error' | t }}"
    data-phone_error="{{ 'bulk_program.price_list.phone_number_error' | t }}"
    data-company_error="{{ 'bulk_program.price_list.company_error' | t }}"
    data-industry_error="{{ 'bulk_program.price_list.industry_error' | t }}"
    data-download_name="{{ 'bulk_program.price_list.download_name' | t }}"
    data-download_success="{{ 'bulk_program.price_list.download_success' | t }}"
>
    <div class="price-modal-wrapper">
        <div class="price-modal-content">
            <span class="close-modal">&times;</span>
            <div class="price-modal-body">
                <div class="list">
                    <div class="item">
                        <div class="item-label">{{ 'bulk_program.price_list.first_name' | t }}</div>
                        <input id="first" name="first" type="text" placeholder="{{ 'bulk_program.price_list.first_name_placeholder' | t }}">
                    </div>
                    <div class="item">
                        <div class="item-label">{{ 'bulk_program.price_list.last_name' | t }}</div>
                        <input id="last" name="last" type="text" placeholder="{{ 'bulk_program.price_list.last_name_placeholder' | t }}">
                    </div>
                </div>
                <div class="list">
                    <div class="item">
                        <div class="item-label">{{ 'bulk_program.price_list.email' | t }}</div>
                        <input id="email" name="email" type="email" placeholder="{{ 'bulk_program.price_list.email_placeholder' | t }}">
                    </div>
                    <div class="item">
                        <div class="item-label">{{ 'bulk_program.price_list.phone_number' | t }}</div>
                        <input id="phone" name="phone" type="text" placeholder="{{ 'bulk_program.price_list.phone_number_placeholder' | t }}">
                    </div>
                </div>
                <div class="list">
                    <div class="item">
                        <div class="item-label">{{ 'bulk_program.price_list.company' | t }}</div>
                        <input id="company" name="company" type="text" placeholder="{{ 'bulk_program.price_list.company_placeholder' | t }}">
                    </div>
                    <div class="item">
                        <div class="item-label">{{ 'bulk_program.price_list.industry' | t }}</div>
                        <input id="industry" name="industry" type="text" placeholder="{{ 'bulk_program.price_list.industry_placeholder' | t }}">
                    </div>
                </div>

                <div class="submit">
                    <button class="download">{{ 'bulk_program.price_list.submit_text' | t }}</button>
                </div>
            </div>
        </div>
    </div>
</div>
