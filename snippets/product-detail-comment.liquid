{%- assign sizes = 0 -%}
{%- for i in (0..11) -%}
    {% assign title_index = 'header_name_' | append: forloop.index %}
    {%- if settings[title_index] -%}
        {%- assign sizes = sizes | plus: 1 -%}
    {%- endif -%}
{%-endfor -%}
<section class="w-full flex-center bg-white px-40 {% if sizes < 2 %} pb-80 {% endif %} lg:px-0">
    <div class="w-full flex-center flex-col lg:j-w-1248 xl:a-w-1200 relative">
        <h2 class="w-full text-center font-600 text-#1A1A1A mb-60 text-48 leading-60 lg:text-#1A1A1A lg:j-px-40 xl:a-px-40 lg:j-text-40 lg:j-leading-48 lg:j-mb-30 xl:a-text-40 xl:a-leading-48 xl:a-mb-30">
            {{ settings.title | newline_to_br }}
        </h2>

        {% comment %} PC Swiper {% endcomment %}
        <div class="hidden lg:block swiper w-full h-full commentlist-pc-swiper lg:j-rounded-12 xl:a-rounded-12" data-size="{{ sizes }}">
            <div class="swiper-wrapper no-swiping {% if sizes <= 5%} flex-center lg:gap-x-[12px] {% endif %}">
                {%- for i in (0..11) -%}
                    {% assign poster_index = 'poster_' | append: forloop.index %}
                    {% assign header_img_index = 'header_img_' | append: forloop.index %}
                    {% assign header_name_index = 'header_name_' | append: forloop.index %}
                    {% assign auth_title_index = 'auth_title_' | append: forloop.index %}
                    {% assign issue_time_index = 'issue_time_' | append: forloop.index %}
                    {% assign description_index = 'description_' | append: forloop.index %}
                    {% assign comment_link_index = 'comment_link_' | append: forloop.index %}
                    {% assign header_img_one_index = 'header_img_one_' | append: forloop.index %}
                    {% assign header_img_two_index = 'header_img_two_' | append: forloop.index %}
                    {% assign header_img_three_index = 'header_img_three_' | append: forloop.index %}
                    {% assign header_img_four_index = 'header_img_four_' | append: forloop.index %}
                    {% assign header_img_five_index = 'header_img_five_' | append: forloop.index %}
                    {% assign header_img_six_index = 'header_img_six_' | append: forloop.index %}
                    {% assign likes_index = 'likes_' | append: forloop.index %}
                    {% assign comment_index = 'comment_' | append: forloop.index %}
                    {%- if settings[header_name_index] -%}
                        {%- assign sizes = sizes | plus: 1 -%}
                    {%- endif -%}
                    {%- if settings[poster_index] -%}
                        <div class="swiper-slide bg-#C4C4C4 !lg:j-w-240 lg:j-h-430 lg:j-rounded-12 !xl:a-w-230 xl:a-h-430 xl:a-rounded-12 overflow-hidden"
                             data-index="{{ sizes }}"
                             data-comment-profile="{{ settings[header_img_index] | image_url: width: 480 }}"
                             data-header-name="{{ settings[header_name_index] }}"
                             data-auth-title="{{ settings[auth_title_index] | newline_to_br }}"
                             data-issue-time="{{ settings[issue_time_index] }}"
                             data-see-more="{{ settings.see_more }}"
                             data-description="{{ settings[description_index] | escape }}"
                             data-comment-link="{{ settings[comment_link_index] }}"
                             data-likes="{{ settings[likes_index] }}"
                             data-comment="{{ settings[comment_index] }}"
                             data-image-one="{{ settings[header_img_one_index] | image_url: width: 480 }}"
                             data-image-two="{{ settings[header_img_two_index] | image_url: width: 480 }}"
                             data-image-three="{{ settings[header_img_three_index] | image_url: width: 480 }}"
                             data-image-four="{{ settings[header_img_four_index] | image_url: width: 480 }}"
                             data-image-five="{{ settings[header_img_five_index] | image_url: width: 480 }}"
                             data-image-six="{{ settings[header_img_six_index] | image_url: width: 480 }}">
                            {% render 'responsive-image',
                                    image: settings[poster_index],
                                    image_class: 'comment-list-image'
                            %}
                        </div>
                    {%- endif -%}
                {% endfor %}
            </div>
        </div>

        {% comment %} PC Navigation {% endcomment %}
        {% if sizes > 5 %}
            <div class="hidden lg:flex swiper-button-next swiper-commentlist-pc-button-next"></div>
            <div class="hidden lg:flex swiper-button-prev swiper-commentlist-pc-button-prev"></div>
        {% endif %}

        {% comment %} Mobile Swiper {% endcomment %}
        <div class="block lg:hidden swiper w-full h-full commentlist-mb-swiper rounded-24" data-size="{{ sizes }}">
            <div class="swiper-wrapper no-swiping {% if sizes < 2%} flex-center gap-x-[12px] {% endif %}">
                {%- for i in (0..11) -%}
                    {% assign poster_index = 'poster_' | append: forloop.index %}
                    {% assign header_img_index = 'header_img_' | append: forloop.index %}
                    {% assign header_name_index = 'header_name_' | append: forloop.index %}
                    {% assign auth_title_index = 'auth_title_' | append: forloop.index %}
                    {% assign issue_time_index = 'issue_time_' | append: forloop.index %}
                    {% assign description_index = 'description_' | append: forloop.index %}
                    {% assign comment_link_index = 'comment_link_' | append: forloop.index %}
                    {% assign header_img_one_index = 'header_img_one_' | append: forloop.index %}
                    {% assign header_img_two_index = 'header_img_two_' | append: forloop.index %}
                    {% assign header_img_three_index = 'header_img_three_' | append: forloop.index %}
                    {% assign header_img_four_index = 'header_img_four_' | append: forloop.index %}
                    {% assign header_img_five_index = 'header_img_five_' | append: forloop.index %}
                    {% assign header_img_six_index = 'header_img_six_' | append: forloop.index %}
                    {% assign likes_index = 'likes_' | append: forloop.index %}
                    {% assign comment_index = 'comment_' | append: forloop.index %}
                    {%- if settings[header_name_index] -%}
                        {%- assign sizes = sizes | plus: 1 -%}
                    {%- endif -%}
                    {%- if settings[poster_index] -%}
                        <div class="swiper-slide bg-#C4C4C4 w-480 h-860 rounded-24 overflow-hidden"
                             data-index="{{ sizes }}"
                             data-comment-profile="{{ settings[header_img_index] | image_url: width: 960 }}"
                             data-header-name="{{ settings[header_name_index] }}"
                             data-auth-title="{{ settings[auth_title_index] | newline_to_br }}"
                             data-issue-time="{{ settings[issue_time_index] }}"
                             data-see-more="{{ settings.see_more }}"
                             data-description="{{ settings[description_index] | escape }}"
                             data-comment-link="{{ settings[comment_link_index] }}"
                             data-likes="{{ settings[likes_index] }}"
                             data-comment="{{ settings[comment_index] }}"
                             data-image-one="{{ settings[header_img_one_index] | image_url: width: 960 }}"
                             data-image-two="{{ settings[header_img_two_index] | image_url: width: 960 }}"
                             data-image-three="{{ settings[header_img_three_index] | image_url: width: 960 }}"
                             data-image-four="{{ settings[header_img_four_index] | image_url: width: 960 }}"
                             data-image-five="{{ settings[header_img_five_index] | image_url: width: 960 }}"
                             data-image-six="{{ settings[header_img_six_index] | image_url: width: 960 }}">
                            {% render 'responsive-image',
                                    image: settings[poster_index],
                                    image_class: 'comment-list-image rounded-24'
                            %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        {% comment %} Mobile Navigation {% endcomment %}
        {% if sizes > 1 %}
            <div class="flex lg:hidden swiper-button-next swiper-commentlist-mb-button-next"></div>
            <div class="flex lg:hidden swiper-button-prev swiper-commentlist-mb-button-prev"></div>
        {% endif %}

    </div>
</section>
