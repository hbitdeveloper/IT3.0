{% comment %}
    Renders a set of links for paginated results. Must be used within paginate tags.

    Usage:
    {% paginate results by 2 %}
      {% render 'pagination', paginate: paginate, anchor: '#yourID' %}
    {% endpaginate %}

    Accepts:
    - paginate: {Object}
    - anchor: {String} (optional) This can be added so that on page reload it takes you to wherever you've placed your anchor tag.
{% endcomment %}

  {%- style -%}
    .pagination-wrapper {
      margin-top: 4rem;
      margin-bottom: 7rem;
    }

    @media screen and (min-width: 990px) {
      .pagination-wrapper {
        margin-top: 30px;
        margin-bottom: 50px;
      }
    }

    .pagination__list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .pagination__list > li {
      flex: 1 0 4.4rem;
      max-width: 16px;
    }

    .pagination__list > li:not(:last-child) {
      margin-right: 1rem;
    }

    .pagination__item {
      color: var(--text-main-color);
      display: inline-flex;
      justify-content: center;
      align-items: center;
      position: relative;
      height: 48px;
      width: 100%;
      padding: 0;
      text-decoration: none;
      transition: color .3s ease;
    }

    a.pagination__item:hover {
      color: var(--primary-color);
    }

    .pagination__item .icon-caret {
      height: 0.6rem;
    }
    .pagination__item--current.light {
      color: var(--primary-color);
    }
    .pagination__item--current::after {
      height: 0.1rem;
    }

    .pagination__item .icon {
      width: 26px;
      font-size: 26px;
      color: #B8B8B8;
    }
    .pagination__item--next .icon {
      margin-left: -60px;
      transform: rotate(180deg);
      transition: color .3s ease;
    }

    .pagination__item--next:hover .icon {
      color: var(--primary-color);
    }

    .pagination__item--prev .icon {
      margin-right: -60px;
    }

    .pagination__item--prev:hover .icon {
      color: var(--primary-color);
    }

    @media screen and (max-width: 768px) {
      .pagination-wrapper {
        margin-bottom: 0;
        margin-top: 30px;
        padding-bottom: 30px;
      }
    }
  {%- endstyle -%}

  <div class="pagination-wrapper">
    <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
      <ul class="pagination__list list-unstyled">
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}{{ anchor }}" class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce !break-keep" aria-label="{{ 'general.pagination.previous' | t }}">
            {% render 'icon-arrow-right-long', class: 'icon iconfont icon-arrow-right-long' %}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}{{ anchor }}" class="pagination__item link jky-text-lg font-400 !break-keep" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <a role="link" aria-disabled="true" class="pagination__item pagination__item--current light jky-text-lg font-400 break-keep" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
            {%- else -%}
              <span class="pagination__item">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}{{ anchor }}" class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce !break-keep" aria-label="{{ 'general.pagination.next' | t }}" >
            {% render 'icon-arrow-right-long', class: 'icon iconfont icon-arrow-right-long' %}
          </a>
        </li>
      {%- endif -%}
      </ul>
    </nav>
  </div>
