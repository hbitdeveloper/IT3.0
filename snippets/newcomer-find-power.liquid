<div {% if shopify_attributes != blank %}{{shopify_attributes}}{% endif %} class="newcomer-main-container newcomer-find-power newcomer-find-power-{{ index }}" anchor="{{ settings.anchor_id  | url_decode | strip | replace: ' ', ''}}">
    <div class="find-power-content">
        <div class="find-left">
            <div class="find-index">{{ settings.part_index }}</div>
            <h3 class="find-title">{{ settings.part_title | newline_to_br }}</h3>
            <div class="find-des">{{ settings.part_subtitle | newline_to_br }}</div>
            {% if settings.button_title != blank %}
            <div class="find-btn-pc higher-btn">
                <div class="btn-title">{{ settings.button_title }}</div>
                <div class="btn-icon"><jds-icon name="plus-line" class="icon"></jds-icon></div>
            </div>
            {% endif %}
        </div>
        <div class="find-right">
            <div class="find-video">
                {% comment %} 视频展示 {% endcomment %}
                {% if settings.videoSrc != blank or settings.poster != blank %}
                    {%- render 'jky-video',
                            video_url: settings.videoSrc,
                            poster: settings.poster,
                            isHidePauseBtn: false,
                            class: 'newcomer-video-box pc-block',
                            autoplay: settings.autoplay,
                            controls: settings.controls,
                            loop: true
                    -%}
                {% endif %}

                {% if settings.videoSrcMB != blank or settings.posterMB != blank %}
                    {%- render 'jky-video',
                            video_url: settings.videoSrcMB,
                            poster: settings.posterMB,
                            isHidePauseBtn: false,
                            class: 'newcomer-video-box mb-block',
                            autoplay: settings.autoplay,
                            controls: settings.controls,
                            loop: true
                    -%}
                {% endif %}
            </div>
        </div>
        {% if settings.button_title != blank %}
        <div class="find-btn-mb higher-btn">
            <div class="btn-title">{{ settings.button_title }}</div>
            <div class="btn-icon">
                <jds-icon name="plus-line" class="icon"></jds-icon>
            </div>
        </div>
        {% endif %}
    </div>
</div>
<div class="find-main-pop">
    <div class="higher-output-box">
        {% if settings.jky_theme_version == 'v4' %}
            <jds-icon name="close-fill" class="pop-close-icon"></jds-icon>
        {%- else -%}
            <jds-icon name="close" class="pop-close-icon"></jds-icon>  
        {% endif %}
        <div class="pop-title">{{ settings.table_title }}</div>
        {% if settings.table_description != blank %}
            <div class="pop-description">{{ settings.table_description }}</div>
        {% endif %}
        <div class="pop-content">
            {% render 'responsive-image',
                    image: settings.pop_image_pc,
                    mimage: settings.pop_image_mb,
                    image_class: 'find-pop-image'
            %}
        </div>
    </div>
</div>

<style>
    .newcomer-find-power-{{ index }}{
        padding-top:{{ settings.pc_padding_top }}px;
        padding-bottom:{{ settings.pc_padding_bottom }}px;
    }
    @media screen and (min-width: 1024px) and (max-width: 1439.98px){
        .newcomer-find-power-{{ index }}{
            padding-top: calc( {{ settings.pc_padding_top }}  * 100vw / 1440 );
            padding-bottom: calc( {{ settings.pc_padding_bottom }}  * 100vw / 1440 );
        }
    }
    @media screen and (max-width: 1023.98px){
        .newcomer-find-power-{{ index }}{
            padding-top: calc( {{ settings.mb_padding_top }}  * 100vw / 750 );
            padding-bottom: calc( {{ settings.mb_padding_bottom }}  * 100vw / 750 );
        }
    }
</style>
