<style>
    @media screen and (max-width:1023px) {
        .delivery_instructions_box{
            max-width: 91.4666666666667vw;
            width: 91.4666666666667vw;
            margin: 0 auto;
        }
    }
</style>
<div class="delivery_instructions_box flex justify-start items-center gap-y-1 lg:gap-y-2 text-sm lg:text-base mb-6 {% if settings.open_delivery_instructions == true %} cursor-pointer {% endif %}" data-product-title="{{ product.title | default: page_title | escape }}">
    <div class="delivery_instructions_box_item delivery_instructions_box_freight" data-delivery-tab="freight">{{ block.settings.freight_title }}&nbsp;/&nbsp;</div>
    <div class="delivery_instructions_box_item delivery_instructions_box_time" data-delivery-tab="time">{{ block.settings.time_sensitive_title }}&nbsp;/&nbsp;</div>
    <div class="delivery_instructions_box_item delivery_instructions_box_areas" data-delivery-tab="areas">{{ block.settings.delivery_areas_title }}</div>
</div>