{% doc %}
  @description 字号class换算，受历史数据原因 需要 换算字号class，返回设计系统JDS的字号class

  @param fs - 字号
  @param default_class - 默认class，默认：heading_2
{% enddoc %}

{% comment %} 还是建议将历史数据 修改为对应JDS的字号class {% endcomment %}
{%- liquid
  assign fs = fs | default: default_class | default: 'heading_2'
  case fs
    when 'heading_0'
      echo 'jds-display-1'
    when 'heading_1'
      echo 'jds-h1'
    when 'heading_2'
      echo 'jds-h2'
    when 'heading_3'
      echo 'jds-h3'
    when 'heading_4'
      echo 'jds-h4'
    when 'heading_5'
      echo 'jds-h5'
    when 'heading_6'
      echo 'jds-h6'
    when 'text_b1'
      echo 'jds-rte-b1'
    when 'text_b2'
      echo 'jds-rte-b2'
    when 'text_b3'
      echo 'jds-rte-b3'
    else
      echo fs
  endcase
-%}
