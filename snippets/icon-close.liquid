{% comment %}
    Renders icon close (关闭图标 - x)

    Accepts:
    - width: {Number} 宽度
    - height: {Number} 高度
    - color: {String} 填充颜色
    - class: {String} 样式类名

    Usage:
    {% render 'icon-close', class: 'iconfont header__section_search zzl-tt', width: 22, height: 22, color:  %}
{% endcomment %}

<svg class="{{class}}" xmlns="http://www.w3.org/2000/svg" fill="{{color}}" viewBox="0 0 24 24" stroke-width="{{ stroke_width | default: "1.5" }}" stroke="{{color}}" aria-hidden="true" width="{{width}}" height="{{height}}">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
</svg>
