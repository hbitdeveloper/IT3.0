{% comment %} 顶部通知栏 {% endcomment %}
<script type="application/ld+json" id="announcement-bar">
  [
    {% for block in announceList %}
      {
          "begin_time": "{{ block.settings.begin_time | escape }}",
          "end_time": "{{ block.settings.end_time | escape }}",
          "type": "{{ block.settings.background_type }}",
          "bg_color": "{{ block.settings.background_color }}",
          "bg_pc_image": "{{ block.settings.background_pc_image  | image_url: width: 1920  }}",
          "bg_mb_image": "{{ block.settings.background_mb_image  | image_url: width: 750  }}",
          "content_position": "{{ block.settings.content_position }}",
          "link": "{{ block.settings.link }}",
          "text": "{{ block.settings.text | escape }}",
          "text_mb": "{{ block.settings.text_mb | escape }}",
          "arrow_color": "{{ block.settings.arrow_color }}",
          "text_color": "{{ block.settings.text_color }}",
          "show_count_down": "{{ block.settings.show_count_down }}",
          "count_down_text_color": "{{ block.settings.count_down_text_color }}",
          "count_down_bg_color": "{{ block.settings.count_down_bg_color }}",
          "count_down_num_color": "{{ block.settings.count_down_num_color }}",
          "days": "{{ days }}",
          "hrs": "{{ hrs }}",
          "mins": "{{ mins }}",
          "secs": "{{ secs }}"
      }{% if forloop.last != true %},{% endif %}
    {% endfor %}
  ]
</script>

<jky-announment-bar class="hidden" data-speed={{speed}}>

  <div class="announce-bar">
        <div class="header-container">
            <div class="announce-bar--close"
              data-ga-event="top_tip_banner4.0"
              data-ga-action="click"
              data-ga-params-button_name="close"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="#888888" width="18" height="18" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>
        </div>
        <div class="swiper mySwiper announce-bar-swiper swiper-no-swiping">
            <div class="swiper-wrapper swiper-wrapper-container">
            </div>
        </div>
  </div>
</jky-announment-bar>
<script defer src="{{ 'plugin-announcement-bar-new.min.js' | asset_url }}"></script>
