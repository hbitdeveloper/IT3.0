<style>
  /* 商详页，智能选购 4.0 */
  .product-head-smart-recommend {
    margin-bottom: 3.2vw;
    padding: 0 4.26666666666667vw;
  }
  .product-head-smart-recommend .smart-recommend-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 4.26666666666667vw;
    color: #1a1a1a;
    padding: 3.2vw;
    font-weight: 500;
    cursor: pointer;
    border-radius: 2.66666666666667vw;
    background: #f7f9fa;
  }
  .product-head-smart-recommend .smart-recommend-button svg {
    flex-shrink: 0;
  }
  @media (min-width: 1024px) {
    .product-head-smart-recommend {
      margin-bottom: 1.11111111111111vw;
      padding: 0;
    }
    .product-head-smart-recommend .smart-recommend-button {
      font-size: 0.972222222222222vw;
      padding: 1.11111111111111vw;
      border-radius: 0.555555555555556vw;
    }
  }
  @media (min-width: 1440px) {
    .product-head-smart-recommend {
      margin-bottom: 16px;
    }
    .product-head-smart-recommend .smart-recommend-button {
      font-size: 14px;
      padding: 16px;
      border-radius: 8px;
    }
  }

  /* 弹窗样式 */
  .product-smart-recommend-modal.modal-container.modal .modal-content {
    width: 100%;
    max-height: calc(100vh - (48 * 0.13333333vw));
    border-radius: var(--theme-dialog-border-radius, 2.66666667vw 2.66666667vw 0px 0px);
    position: fixed;
    height: calc(100vh - (160 * 0.13333333vw));
    background-color: #F5F5F5;
    bottom: 0;
    padding-bottom: 0;
    scrollbar-width: none; /* Firefox */
  }
  .product-smart-recommend-modal.modal-container.modal .modal-content::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Edge */
  }
  .product-smart-recommend-modal.modal-container.modal .modal-content .moadal-header {
    background-color: #F5F5F5;
    height: 9.6vw;
    z-index: 3;
  }
  .product-smart-recommend-modal.modal-container.modal .modal-content .moadal-header .close svg {
    top: 1.33333333vw !important;
    right: 1.33333333vw !important;
    width: 3.73333333vw;
    height: 3.73333333vw;
  }
  .product-smart-recommend-modal.modal-container.modal .modal-content .modal-content-body {
    padding: 0;
    max-height: calc(100vh - (110 * 0.13333333vw));
    position: relative;
    z-index: 2;
  }
  @media (min-width: 1024px) {
    .product-smart-recommend-modal.modal-container.modal .modal-content {
      width: 83.3333333333333vw;
      border-radius: var(--theme-dialog-border-radius, 1.11111111111111vw);
      max-height: calc(100vh - 8.33333333333333vw);
      overflow: hidden;
      background-color: #F5F5F5;
      position: relative;
      height: auto;
    }
    .product-smart-recommend-modal.modal-container.modal .modal-content .moadal-header {
      height: 3.88888888888889vw;
      border-bottom: none;
      z-index: 2;
      position: static;
    }
    .product-smart-recommend-modal.modal-container.modal .modal-content .moadal-header .close svg {
      top: 0.555555555555556vw !important;
      right: 0.833333333333333vw !important;
      width: 1.38888888888889vw;
      height: 1.38888888888889vw;
      z-index: 3;
    }
    .product-smart-recommend-modal.modal-container.modal .modal-content .modal-content-body {
      padding: 0 3.33333333333333vw 1.66666666666667vw;
      overflow-y: auto;
      max-height: calc(100vh - 12.2222222222222vw);
      margin-top: -2.77777777777778vw;
    }
  }
  
  @media (min-width: 1440px) {
    .product-smart-recommend-modal.modal-container.modal .modal-content {
      width: 1200px;
      border-radius: var(--theme-dialog-border-radius, 16px);
      max-height: calc(100vh - 120px);
    }
    .product-smart-recommend-modal.modal-container.modal .modal-content .moadal-header {
      height: 56px;
      border-bottom: none;
    }
    .product-smart-recommend-modal.modal-container.modal .modal-content .moadal-header .close svg {
      top: 8px !important;
      right: 12px !important;
      width: 20px;
      height: 20px;
    }
    .product-smart-recommend-modal.modal-container.modal .modal-content .modal-content-body {
      padding: 0 48px 24px;
      overflow-y: auto;
      max-height: calc(100vh - 176px);
      margin-top: -40px;
    }
  }
  jky-smart-recommend {
    --bg-color: #F5F5F5;
    --padding-top: 0;
    --padding-bottom: 0;
    --min-height: 0;
    --zoom-pc: 0.92;
  }
  jky-smart-recommend .smart-recommend-loading {
    width: 100%;
    height: 30vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  jky-smart-recommend .smart-recommend-loading svg {
    width: 40px;
    height: 40px;
    animation: spin 2s linear infinite;
  }
</style>

{% comment %} 多语言 片段 {% endcomment %}
{% render 'smart-recommend-4-json' %}
{% render 'user-feedback-json' %}

<div class="product-head-smart-recommend">
  <div class="smart-recommend-button" data-compare-id="{{ compare_id }}" data-coupon-id="{{ coupon_id }}" data-open-auto-discount-price="{{settings.open_auto_discount_price}}">
    <span> {{ smart_recommend_text | escape}} </span>
    {% render 'icon-circle-plus', class: 'icon-circle-plus', width: 22, height: 22, color: 'var(--jds-color-primary)' %}
  </div>
</div>

<script src="{{ 'plugin-app-smart-recommend.min.js' | asset_url }}" defer></script>
