{% comment %}
    Renders jky-tooltip 文字提示小组件

    Accepts:
    - content: {String} 提示文案
    - class: {String} class类

    Usage:
    {%- render 'component-tooltip', content: section.settings.content, class: 'h-4 w-4' -%}
{% endcomment %}
{{ 'component-tooltip.css' | asset_url | stylesheet_tag }}
{%- render 'jky-tooltip' -%}

<jky-tooltip id="{{section.id}}-{{block.id}}">
    <template>
        <div>
            <div class="jds-rte text_b2">
                {{content | newline_to_br}}
            </div>
        </div>
    </template>
    <div class="group/tooltip jky-tooltips--component relative block h-5 w-5 {% if class != blank %}{{class}}{% endif %}">
        <div class="hidden lg:block jky-tooltip__content jds-rte jky-tooltip__inner--top text_b2 absolute tooltip__top rounded-md text-[#666666] py-4 px-6 duration-200 ease-in transition-all w-max shadow-md bg-white opacity-0 -z-1 group-hover/tooltip:z-50 pointer-events-none group-hover/tooltip:pointer-events-auto group-hover/tooltip:opacity-100 lg:max-w-md
        after:content-[''] after:border-[3px] after:border-solid after:border-white after:shadow-md after:absolute after:h-0 after:w-0 after:rotate-45
        "
        >{{content | newline_to_br}}</div>
        
        {%- assign svg_color = '#ffffff' -%}
        {%- if icon_color != blank -%}
            {%- assign svg_color = icon_color -%}
        {%- endif -%}
        {%- render 'jky-icon-circle-question-normal', class: "absolute jky-tooltip__trigger h-5 w-5", color: svg_color -%}
    </div> 
</jky-tooltip>

