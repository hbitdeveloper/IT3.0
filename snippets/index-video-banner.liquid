{% comment %} 视频banner {% endcomment %}
<div class="index-video-banner">
    <div class="new-main-container">
        <div class="video-banner">
            <div class="pc-block">
                {% assign controls = false %}
                {%- if video.settings.pc_video contains "youtube.com" -%}
                    {% assign controls = true %}
                {%- endif -%}
                <div class="video-container pc-video-container">
                    {%
                        render 'jky-video',
                        poster: video.settings.pc_poster,
                        video_url: video.settings.pc_video,
                        autoplay: true,
                        loop: true,
                        controls: controls,
                        isHidePauseBtn: true
                    %}
                    
                    <a  
                        data-ga-event="home_page_banner4.0" 
                        data-ga-action="click" 
                        data-ga-params-module="{{ video.settings.title_main | strip_html }}" 
                        data-ga-params-button_name="{{ video.settings.button_text }}"
                        data-ga-params-link="{{ video.settings.link }}"
                        data-ga-params-type="video_ban"
                        class="{%- if controls == true -%} youtube-video {%- endif -%}" target="{% if new_window %}_blank{% else %}_self{% endif %}" href="{{ video.settings.link }}">
                        <div class="content {{ video.settings.position }}">
                             {% assign titleColor = '<em style="color: ' | append: video.settings.title_main_color | append: '">' %}
                            <div class="title">{{ video.settings.title_main | replace: '<em>', titleColor }}</div>
                            {% assign subTitleColor = '<em style="color: ' | append: video.settings.sub_title_main_color | append: '">' %}
                            <div class="sub-title">{{ video.settings.sub_title | replace: '<em>', subTitleColor }}</div>

                            {%- if video.settings.button_text != blank -%}
                                <button class="index-button" style="background: {{ video.settings.button_color }}">
                                    <span>{{ video.settings.button_text | escape}}</span>
                                    <div>
                                        <div class="arrow">
                                            <svg class="line" width="20" height="15" viewBox="0 0 20 15" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                    <g transform="translate(-694.000000, -311.000000)" fill="#FFFFFF" fill-rule="nonzero">
                                                        <g transform="translate(672.000000, 286.000000)">
                                                            <polygon points="34.7083333 25 31.0625 25 37 31.0256733 22 31.0256733 22 33.4570853 37 33.4570853 31.0625 39.4827586 34.7083333 39.4827586 42 32.2942361"></polygon>
                                                        </g>
                                                    </g>
                                                </g>
                                            </svg>
                                        </div>
                                    </div>
                                </button>
                            {%- endif -%}
                        </div>
                    </a>
                    {%- if controls == false -%}
                        {% comment %} 开启/关闭声音 {% endcomment %}
                        <div>
                            <div class="icons-controls jky-video-muted jky-video-turnOn">
