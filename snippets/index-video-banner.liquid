                            </div>
                        </div>
                        {% comment %} 暂停/播放 {% endcomment %}
                        <div>
                            <div class="icons-controls jky-video-play">
                                <svg class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" width="200" height="200"><path d="M433.6 352H384c-17.6 0-32 14.4-32 32v256c0 17.6 14.4 32 32 32h49.6c17.6 0 32-14.4 32-32V384c0-17.6-14.4-32-32-32zM640 352h-49.6c-17.6 0-32 14.4-32 32v256c0 17.6 14.4 32 32 32H640c17.6 0 32-14.4 32-32V384c0-17.6-14.4-32-32-32z" fill="#ffffff"></path></svg>
                                
