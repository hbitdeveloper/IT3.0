                            <div class="icons-controls jky-video-pause">
                                <svg class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" width="200" height="200"><path d="M426.929231 335.556923l245.76 146.510769c7.876923 4.726154 12.603077 12.603077 12.603077 22.055385 0 9.452308-4.726154 17.329231-12.603077 22.055385l-245.76 144.935384c-9.452308 6.301538-18.904615 6.301538-26.781539 3.150769-9.452308-3.150769-12.603077-11.027692-12.603077-20.48V351.310769c0-9.452308 4.726154-15.753846 14.178462-20.48 9.452308-3.150769 18.904615-3.150769 26.781538 1.575385z" fill="#ffffff"></path></svg>
                            </div>
                        </div>
                    {%- endif -%}
                    
                </div>
            </div>

