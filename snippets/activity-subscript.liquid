{{ 'snippet-activity-subscript.min.css' | asset_url | stylesheet_tag }}
{{ 'snippet-z-modal-new.min.css' | asset_url | stylesheet_tag }}

{% comment %} 订阅 {% endcomment %}
{% assign font_vw = settings.font_mb | divided_by: 7.5 %}
{% assign sub_font_vw = settings.sub_font_mb | divided_by: 7.5 %}
{% assign des_font_vw = settings.des_font_mb | divided_by: 7.5 %}

<style>
    body .index-subscipt-banner .banner-big-box .banner-subscride-box .jky-checkbox-input{
        display: flex;
        align-items: center;
    }

    body .index-subscipt-banner .banner-big-box .banner-subscride-box {
        margin-top:32px;padding:20px;border-radius: 12px;
        background: {{settings.subcribe_bg_color}};
        backdrop-filter: blur(6px);-webkit-backdrop-filter: blur(6px);width:max-content;max-width: 454px;
    }
    .subscription-tip-container{font-size: 16px;line-height: 24px;max-height: 70vh;overflow-y: auto;}
    .winner-tip-container p strong{font-size: 18px;font-weight: 600;margin: 32px 0 6px;display: block;overflow: hidden;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 1;}
    .winner-tip-container p{font-size: 16px;font-weight: 400;overflow: hidden;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;}

    body .index-subscipt-banner .banner-big-box .banner-subscride-box .subscribe-text .title {flex:1;display:flex;}
    body .index-subscipt-banner .banner-big-box .banner-subscride-box .subscribe-text .title p{flex:1;-webkit-box-orient: vertical;
    display: -webkit-box;    -webkit-line-clamp: 2;
    overflow: hidden;}
    @media screen and (max-width: 1024px) {
        body .index-subscipt-banner .banner-big-box .banner-subscride-box {
            max-width: 100%;
        }
        body .index-subscipt-banner .banner-big-box .banner-subscride-box .subscribe-text {margin-bottom:0;}
        body .index-subscipt-banner .banner-big-box .banner-subscride-box .subscribe-text .title {flex:1;font-size: 14px;line-height: 1.2;margin-bottom: 2.6vw;display:flex;}
        body .index-subscipt-banner .banner-big-box .banner-subscride-box .subscribe-text .title p{flex:1;-webkit-box-orient: vertical;
    display: -webkit-box;    -webkit-line-clamp: 2;
    overflow: hidden;}
        body .index-subscipt-banner {height:160vw;}
        .index-subscipt-banner .banner-big-box .banner-subscride-box .newbee-form .form-row_check_box .jky-checkbox:not(.jky-checkbox-disabled):hover .jky-checkbox-inner{
            border-color: unset;
        }
        body .index-subscipt-banner .banner-big-box .banner-subscride-box .newbee-form .form-row_check_box {margin-bottom:2.4vw;}
        body .index-subscipt-banner .banner-big-box .banner-subscride-box .newbee-form .form-row {margin-bottom: 2.6vw;}
        body .index-subscipt-banner .banner-big-box .banner-subscride-box .newbee-form .form-row.eeeemail {margin-bottom: 5.2vw;}
        .subscription-tip-container{font-size: 3.6vw;line-height: 5.2vw;max-height: 61.333333vw;overflow-y: auto;}
        .winner-tip-container {max-height: 61.333333vw;overflow-y: auto;}
        .winner-tip-container p:first-of-type strong {margin-top: 0;}
        .winner-tip-container p strong{font-size: 4vw;line-height: 4vw;font-weight: 600;margin: 7.4666667vw 0 1.2vw 0;overflow: hidden;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 1;}
        .winner-tip-container p{font-size: 3.6vw;line-height: 5.2vw;font-weight: 400;overflow: hidden;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;}
        .landing-grid--2-col-desktop.p-cards_style_2 .landing-block--product-pmain--top {flex: 1;display: flex;flex-direction: column;justify-content: space-between;}
        .landing-grid--2-col-desktop.p-cards_style_2 .landing-block--product-pmain--bottom {gap: 2vw !important;}
        body .index-subscipt-banner .banner-big-box .banner-subscride-box {padding: 10px;position: relative;width: 90vw;margin: 0 auto;left: 50%;border-radius: 12px;transform: translateX(-50%);bottom:36px;}
    }
    {%- if settings.winner_btn == blank  -%}
        .index-subscipt-banner .banner-big-box .banner-subscride-box .newbee-form .privacy.form-row_check_box{
            margin-bottom: 0;
        }
    {%- endif -%}

    .index-subscipt-banner .banner-big-box .title-box .section-title{
        font-size: {{ settings.font }}px;
        line-height: 1.15;
    }
    .index-subscipt-banner .banner-big-box .title-box .section-sub{
        font-size: {{ settings.sub_font }}px;
        line-height: 1.15;
    }
    .index-subscipt-banner .banner-big-box .title-box .section-des{
        font-size: {{ settings.des_font }}px;
        line-height: 1.15;
    }
    .index-subscipt-banner .banner-big-box .banner-subscride-box .newbee-form .form-row .form-item .jky-checkbox-label .jky-agree p,
    .index-subscipt-banner .banner-big-box .banner-subscride-box .newbee-form .form-row .form-item .jky-checkbox-label .jky-agree p a{
        color: {{ settings.subsribe_icon }};
    }

    @media screen and (max-width: 1024px) {
        .index-subscipt-banner .banner-big-box .title-box .section-title{
            font-size: {{ font_vw }}vw;
            line-height: 1.3333;
        }
        .index-subscipt-banner .banner-big-box .title-box .section-sub{
            font-size: {{ sub_font_vw }}vw;
            line-height: 1.3333;
        }
        .index-subscipt-banner .banner-big-box .title-box .section-des{
            font-size: {{ des_font_vw }}vw;
            line-height: 1.5;
        }

        .index-subscipt-banner .banner-big-box .jky-checkbox-inner{
            border-color: {{ settings.subsribe_icon }};
        }
    }

    {% comment %} 产品要求包含1440px {% endcomment %}
    @media screen and (min-width: 1024px) and (max-width: 1440px) {
        .index-subscipt-banner .banner-big-box {
            width: 82.444444vw;
        }
    }

</style>
{% assign url_path = '' %}
{% if settings.subscript_tag != blank %}
    {% assign url_path = settings.subscript_tag %}
{% else %}
    {% assign url_path = request.path | split: '/' | last %}
{% endif %}
{% assign gaTitle = '' %}

{% if settings.title_main %}
    {% assign gaTitle = settings.sub_title | strip_html %}
{% elsif settings.sub_title %}
    {% assign gaTitle = settings.title_main | strip_html %}
{% elsif settings.des_title %}
    {% assign gaTitle = settings.des_title | strip_html %}
{% endif %}
<div class="index-subscipt-banner" {%if settings.anchor_id != blank%}anchor={{settings.anchor_id | escape}}{% endif %}>
    <div class="banner-big-box relative z-[1] {{ settings.pc_position }} {{ settings.mb_position }}">
        {% comment %} 订阅部分 {% endcomment %}
        <div class="banner-subscride-box" style="background: {{ settings.color_background }}">
            <div class="subscribe-text">
                <div class="title flex" style="color: {{ settings.subsribe_icon }}">{{ settings.subcribe_title }}
                    {%- if settings.subscription_header != blank or settings.subscription_tip != blank -%}
                    <svg
                        data-ga-event="activity_page_user_clicks"
                        data-ga-action="click"
                        data-ga-params-current_page="{{ window.location.href }}"
                        data-ga-params-module="Subscribe Banner"
                        data-ga-params-position="{{ gaTitle }}"
                        data-ga-params-button_name="Question Mask"
                        data-tipheader="{{ settings.subscription_header }}"
                        data-tiptext="{{ settings.subscription_tip }}" class="winner-icon" width="52" height="52" viewBox="0 0 52 52" fill="none">
                        <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M0 25.6978C0 39.8903 11.4828 51.3956 25.6476 51.3956C39.8124 51.3956 51.2952 39.8903 51.2952 25.6978C51.2952 11.5053 39.8124 0 25.6476 0C11.4828 0 0 11.5053 0 25.6978ZM47.7978 25.6978C47.7978 37.955 37.8808 47.8913 25.6476 47.8913C13.4144 47.8913 3.4974 37.955 3.4974 25.6978C3.4974 13.4406 13.4144 3.50424 25.6476 3.50424C37.8808 3.50424 47.7978 13.4406 47.7978 25.6978ZM25.6476 35.0424C24.36 35.0424 23.316 36.0885 23.316 37.3786C23.316 38.6688 24.36 39.7148 25.6476 39.7148C26.9352 39.7148 27.9792 38.6688 27.9792 37.3786C27.9792 36.0885 26.9352 35.0424 25.6476 35.0424ZM19.2357 21.5276C20.2015 21.5276 20.9844 20.7431 20.9844 19.7755C20.9844 16.8951 23.6379 14.7078 26.6046 15.2773C28.407 15.6239 29.8714 17.0723 30.2185 18.841C30.6504 21.0407 29.5038 23.1287 27.5114 23.9849C25.2981 24.9359 23.8992 27.171 23.8992 29.6031V30.9542C23.8992 31.9218 24.6821 32.7063 25.6479 32.7063C26.6137 32.7063 27.3966 31.9218 27.3966 30.9542V29.6031C27.3966 28.5423 27.9918 27.5913 28.8899 27.2055C32.3756 25.7075 34.4054 22.0111 33.6502 18.1647C33.0268 14.9886 30.461 12.4506 27.2632 11.8358C22.1436 10.8529 17.487 14.6913 17.487 19.7755C17.487 20.7431 18.2699 21.5276 19.2357 21.5276Z"
                            fill="{{ settings.subsribe_icon | default: '#999999' }}"/>
                    </svg>
                    {%- endif -%}
                </div>
            </div>

            <div class="subscribe-main">
                {% assign sub_url = '' %}
                {% if settings.klaviyo_id != blank %}
                    {% assign sub_url = "/osconsumerapi/v1/notice/klaviyoSubscribe" %}
                {% else %}
                    {% assign sub_url = "/osconsumerapi/v1/notice/subscribe" %}
                {% endif %}
                <jky-form
                        onsubmitcall="(e)=>toSubGA(e)"
                        jky-form-id="footer-email-subscribe"
                        class="subscribe-email footer-subscribe-box"
                >
                    <form data-action="{{ sub_url }}">
                        <div class="form-container newbee-form newbee-form_{{section.id}}">
                            {% comment %} 邮箱 {% endcomment %}
                            <div class="form-row flex  full eeeemail">
                                <div class="form-item required" data-field="input">
                                    <input
                                            type="email"
                                            id="email"
                                            name="email"
                                            placeholder="{{'newsletter.email_placeholder' | t}}"
                                            data-error="{{'newsletter.email_empty_info' | t}}"
                                            data-value="email"
                                            data-reg="email"
                                            data-regerror="{{'newsletter.email_error_info' | t}}"
                                    >
                                    <div class="required-box">
                                        <div class="required-star">*</div>
                                    </div>
                                </div>
                                <div class="newbee-form_submit flex full" data-loading="{{settings.loading_btn}}">
                                    <button class="form_sub_btn z-button-middle" data-subcribebtn="{{ settings.subcribe_btn }}" data-success="{{'newsletter.success' | t}}">
                                        {{ settings.subcribe_btn }}
                                    </button>
                                </div>
                            </div>
                            {% comment %} 隐私协议 {% endcomment %}
                            <div class="form-row privacy form-row_check_box flex full">
                                <div
                                        class="form-item required"
                                        data-field="check_box"
                                        data-error="{{'newsletter.policy_empty_info' | t}}"
                                >
                                    {% render 'jky-formField-checkbox',
                                            key: settings.privacy_policy,
                                            value: 'agree_recevie'
                                    %}
                                </div>
                            </div>
                            {%- if  settings.winner_btn != blank -%}
                                <div class="form-row winner-text"
                                    data-ga-event="activity_page_user_clicks"
                                    data-ga-action="click"
                                    data-ga-params-current_page=""
                                    data-ga-params-module="Subscribe Banner"
                                    data-ga-params-position="{{ gaTitle }}"
                                    data-ga-params-button_name="{{ settings.winner_btn }}"
                                    data-winnerheader="{{ settings.winner_header }}" data-winnerList='{{ settings.winner_list }}'>
                                   {{ settings.winner_btn }}
                               </div>
                            {%- endif -%}

                            {% if settings.klaviyo_id == blank %}
                                <div style="display: none;" class="form-row flex  full">
                                <div class="form-item form-item_const" data-field="input">
                                    <input
                                            type="text"
                                            id="tags"
                                            name="tags"
                                            data-error=""
                                            data-value="tags"
                                            data-reg=""
                                            value="{{ url_path  }}"
                                            data-regerror=""
                                    >
                                </div>
                            </div>
                            {% endif %}


                            {% if settings.klaviyo_id != blank %}
                                <div style="display: none;" class="form-row flex  full">
                                    <div class="form-item form-item_const" data-field="input">
                                        <input
                                                type="text"
                                                id="list_id"
                                                name="list_id"
                                                data-error=""
                                                data-value="list_id"
                                                data-reg=""
                                                value="{{ settings.klaviyo_id  }}"
                                                data-regerror=""
                                        >
                                    </div>
                                </div>
                            {% endif %}

                            {% if settings.klaviyo_id != blank %}
                                {%- assign CR = settings.shop_cr | default: localization.country.iso_code | default: 'US' -%}
                                <div style="display: none;" class="form-row flex  full">
                                    <div class="form-item form-item_const" data-field="input">
                                        <input
                                                type="text"
                                                id="cr"
                                                name="cr"
                                                data-error=""
                                                data-value="cr"
                                                data-reg=""
                                                value="{{ CR }}"
                                                data-regerror=""
                                        >
                                    </div>
                                </div>
                            {% endif %}

                            <div style="display: none;" class="form-row flex  full">
                                <div class="form-item form-item_const" data-field="input">
                                  <input
                                    type="text"
                                    id="componentName"
                                    name="componentName"
                                    data-value="componentName"
                                    value="订阅banner"
                                  >
                                </div>
                              </div>

                              <div style="display: none;" class="form-row flex full page-url">
                                <div class="form-item form-item_const" data-field="input">
                                  <input
                                    type="text"
                                    id="pageUrl"
                                    name="pageUrl"
                                    data-value="pageUrl"
                                    value=""
                                  >
                                </div>
                              </div>

                        </div>
                    </form>
                </jky-form>
            </div>
        </div>

        {% comment %} 组件标题 {% endcomment %}
        {% if settings.title_type == 'image' %}
            <div>
                <picture>
                    {%- assign pc_height = 'x' | append: settings.pc_title_image_height -%}
                    <source media="(max-width:1024px)" srcset="{{ settings.mb_title_image | image_url: width: 654 }}">
                    <img class="blur-up" src="{{ settings.pc_title_image | img_url: pc_height }}" loading="lazy" alt="{{ settings.pc_title_image.alt }}">
                </picture>
            </div>
        {% else %}
            <div class="title-box">
                {% if settings.title_main_italic %}
                    {% assign titleStyle = "italic" %}
                {% else %}
                    {% assign titleStyle = "normal" %}
                {% endif %}
                {% assign titleColor = '<em style="color: ' | append: settings.title_main_color | append: "; font-style: " | append: titleStyle | append: '">' %}
                <div class="section-title title-overflow-two pc-block"
                     data-title="{{ settings.title_main | strip_html }}"
                     style="color: {{ settings.title_main_color_pc }}">
                    {{ settings.title_main
                    | replace: '<em>', titleColor
                    | replace: '<p>', '<span>'
                    | replace: '</p>', '</span><br>'
                    }}
                </div>
                <div class="section-title title-overflow-two mobile-block" data-title="{{settings.title_main | strip_html}}"  style="color: {{ settings.title_main_color_mb }}">
                    {{ settings.title_main_mb | default: settings.title_main
                    | replace: '<em>', titleColor
                    | replace: '<p>', '<span>'
                    | replace: '</p>', '</span><br>'
                    }}
                </div>
                {% assign subTitleColor = '<em style="color: ' | append: settings.sub_title_main_color | append: '">' %}
                <div class="section-sub title-overflow-two pc-block" data-title="{{settings.sub_title | strip_html}}"  style="color: {{ settings.sub_title_main_color_pc }}">
                    {{ settings.sub_title
                    | replace: '<em>', subTitleColor
                    | replace: '<p>', '<span>'
                    | replace: '</p>', '</span><br>'
                    }}
                </div>
                <div class="section-sub title-overflow-two mobile-block" data-title="{{settings.sub_title | strip_html}}"  style="color: {{ settings.sub_title_main_color_mb }}">
                    {{ settings.sub_title_mb | default: settings.sub_title
                    | replace: '<em>', subTitleColor
                    | replace: '<p>', '<span>'
                    | replace: '</p>', '</span><br>'
                    }}
                </div>

                {% assign desTitleColor = '<em style="color: ' | append: settings.des_title_main_color | append: '">' %}
                <div class="section-des title-overflow-two pc-block" data-title="{{settings.des_title | strip_html}}"  style="color: {{ settings.des_title_main_color_pc }}">
                    {{ settings.des_title
                    | replace: '<em>', desTitleColor
                    | replace: '<p>', '<span>'
                    | replace: '</p>', '</span><br>'
                    }}
                </div>
                <div class="section-des title-overflow-two mobile-block" data-title="{{settings.des_title | strip_html}}"  style="color: {{ settings.des_title_main_color_mb }}">
                    {{ settings.des_title_mb | default: settings.des_title
                    | replace: '<em>', desTitleColor
                    | replace: '<p>', '<span>'
                    | replace: '</p>', '</span><br>'
                    }}
                </div>
            </div>
        {% endif %}
    </div>

    {%- render 'diff-end-img',
        picture_class:'absolute inset-0 top-0 left-0 z-0',
        class: 'w-full h-full object-cover',
        style: '',
        anchor: '',
        pc_img: settings.pc_image,
        mb_img: settings.mb_image,
        placeholder_name: 'hero-apparel-1',
        alt: settings.title_main | default: 'activity image',
        load_scene: settings.load_scene | default: 'default'
    -%}
</div>
<script defer src="{{ 'snippet-z-modal-new.min.js' | asset_url }}"></script>

<script defer>
    (function () {
        function onReady(fn) {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', fn, { once: true });
                return;
            }
            fn();
        }

        function ensureLoadingStyle(loadingBtnText) {
            var styleId = 'activity-subscript-loading-style';
            var styleEl = document.getElementById(styleId);
            if (!styleEl) {
                styleEl = document.createElement('style');
                styleEl.id = styleId;
                document.head.appendChild(styleEl);
            }
            styleEl.textContent = '.banner-subscride-box button.loading::after { content: ' + JSON.stringify(loadingBtnText) + '; }';
        }

        onReady(function () {
            var pageUrlInputs = document.querySelectorAll('.index-subscipt-banner .page-url input');
            pageUrlInputs.forEach(function (input) {
                input.value = window.location.href;
            });

            var loadingHolder = document.querySelector('.banner-subscride-box .newbee-form_submit');
            var loadingBtn = (loadingHolder && loadingHolder.getAttribute('data-loading')) || 'LOADING';
            ensureLoadingStyle(loadingBtn);

            var currentPage = window.location.href;
            document.querySelectorAll('.banner-subscride-box .winner-text, .banner-subscride-box .winner-icon').forEach(function (el) {
                el.setAttribute('data-ga-params-current_page', currentPage);
            });

            var subscriptionTipBtn = document.querySelector('.index-subscipt-banner .winner-icon');
            if (subscriptionTipBtn) {
                var subscriptionText = subscriptionTipBtn.getAttribute('data-tiptext') || '';
                var subscriptionTip = subscriptionTipBtn.getAttribute('data-tipheader') || '';
                var subscriptionDom = '<div class="subscription-tip-container">' + subscriptionText + '</div>';
                subscriptionTipBtn.addEventListener('click', function () {
                    if (typeof ZModleNew === 'undefined') return;
                    ZModleNew.getInstance(subscriptionDom, {
                        header: subscriptionTip,
                        id: "subscription-tip",
                        class: "subscription-tip-modal"
                    });
                });
            }

            var winnerTipBtn = document.querySelector('.index-subscipt-banner .winner-text');
            if (winnerTipBtn) {
                var winnerList = winnerTipBtn.getAttribute('data-winnerlist') || '';
                var winnerHeader = winnerTipBtn.getAttribute('data-winnerheader') || '';
                var winnerDom = '<div class="winner-tip-container">' + winnerList + '</div>';
                winnerTipBtn.addEventListener('click', function () {
                    if (typeof ZModleNew === 'undefined') return;
                    ZModleNew.getInstance(winnerDom, {
                        header: winnerHeader,
                        id: "winner-tip",
                        class: "winner-tip-modal",
                        activityClose: true
                    });
                });
            }
        });
    })();
    function toSubGA(data) {
        if (data.response && data.response.code === 200) {
            const btnEl = document.querySelector('.index-subscipt-banner .newbee-form_submit button');
            const msg = (btnEl && btnEl.getAttribute('data-success')) || data.response.message;
            pushSuccessMessage(msg);
            const buttonName = (btnEl && btnEl.getAttribute('data-subcribebtn')) || '';

            const subEl = document.querySelector('.index-subscipt-banner .title-box .section-sub');
            const titleEl = document.querySelector('.index-subscipt-banner .title-box .section-title');
            const desEl = document.querySelector('.index-subscipt-banner .title-box .section-des');
            const positionName =
                (subEl && subEl.getAttribute('data-title')) ||
                (titleEl && titleEl.getAttribute('data-title')) ||
                (desEl && desEl.getAttribute('data-title')) ||
                '';
            let params = {
                module: 'Subscribe Banner',
                position: positionName,
                button_name: buttonName,
            };
            gaPushDataLayer('activity_page_user_clicks', params);
        }
    }
</script>
