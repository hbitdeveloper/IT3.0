<jky-qty-select class="flex items-center">
    <button 
        class="jky_quantity__button no-js-hidden flex items-center justify-center" 
        name="minus" 
        type="button"
    >
        {% render 'icon-minus' class: 'w-7 h-7 p-2 align-middle',method: 'minus' %}
    </button>

    <input style="border: none!important;"
        class="jky_quantity__input" type="number" name="quantity" id="Quantity-template--14761079144545__main" 
        data-cart-quantity="0" 
        data-min="1" min="1" step="1" value="1" form="product-form-template--14761079144545__main" max="null"
    >

    <button 
        class="jky_quantity__button no-js-hidden flex items-center justify-center" 
        name="plus" type="button"
    >
        {% render 'icon-plus' class: 'w-7 h-7 p-2 align-middle',method: 'plus' %}
    </button>
</jky-qty-select>