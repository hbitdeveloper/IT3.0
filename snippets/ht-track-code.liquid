<script>
  (function () {
    function getParam(variable) {
      function nonstandard() {
        var v = location.href.split("&");
        v.splice(0, 1);
        return v
      }
      var query = window.location.search.substring(1), vars = query ? query.split("&") : nonstandard();
      for (var i = 0; i < vars.length; i++) {
        var pair = vars[i].split("=");
        if (pair[0] === variable) { return decodeURI(pair[1]) }
      }
      return false
    }
    const currentVariant = function () {
      let v = null, vid = getParam("variant");
      if (vid) {
        v = meta.product.variants.find(item => item.id === +vid)
      } else {
        v = meta.product.variants[0]
      }
      return v
    }
    const setup_init_code = function (ev) {
      window.removeEventListener('load', setup_init_code);
      // GTM GA4 Ecommerce [ view_item, add_to_cart, begin_checkout ]
      const CURRENCY = '{{shop.currency}}';
      // view product
      if (location.pathname.startsWith('/products/') === true || location.pathname.startsWith('/collections/') === true) {
        // Twitter product view
        twq('event', 'tw-oe8bu-oe8by', {
          value: parseInt('{{product.selected_or_first_available_variant.price}}'.replace(/[^0-9\.]+/g, '')) / 100, // use this to pass the value of the conversion (e.g. 5.00)
          currency: CURRENCY // use this to pass the currency of the conversion with an ISO 4217 code (e.g. ‘USD’)
        });
      }
      const cartItems_additional = [];
      // add to cart (product view)
      document.querySelectorAll('[name=add], #addtocart_button, .ProductForm__AddToCart, #sticky_addToCart, .lb-upsell-tot-btn').forEach(function (x) {
        x.addEventListener('click', function (e) {
          let _variant = currentVariant();

          let item = {
            item_id: "{{product.id}}",
            item_name: "{{product.title | escape}}",
            price: _variant.price / 100,
            quantity: document.querySelector('input[name=quantity]')?.value ?? 1,
            item_category: "{{product.selected_or_first_available_variant.sku | escape}}"
          };

          cartItems_additional.push(item);
          // Twitter add to cart
          twq('event', 'tw-oe8bu-oe8c1', {
            value: parseInt('{{product.price}}') / 100, // use this to pass the value of the conversion (e.g. 5.00)
            currency: CURRENCY // use this to pass the currency of the conversion with an ISO 4217 code (e.g. ‘USD’)
          });

          // TTD adsrvr
          var img = new Image();
          img.src = 'https://insight.adsrvr.org/track/pxl/?adv=bftsrg7&ct=0:bpj2s5z&fmt=3'
        });
      });
      // begin checkout
      function handle_begin_checkout(cartItems_additional = []) {
        const items = [
          {%- for line_item in cart.items %}
            {
              item_id: "{{line_item.product_id}}",
              item_name: "{{line_item.title | escape}}",
              price: parseInt('{{line_item.price}}') / 100,
              quantity: parseInt('{{line_item.quantity}}'),
              item_category: "{{line_item.sku | escape}}",
            },
          {% endfor %}
        ].concat(cartItems_additional);
        console.table(items);

        // Twitter begin checkout
        twq('event', 'tw-oe8bu-oe8qn', {
          value: Math.round(items.map(function (x) { return x.quantity * x.price }).reduce(function (p, x) { return p + x; }) * 100) / 100, // use this to pass the value of the conversion (e.g. 5.00)
          currency: CURRENCY // use this to pass the currency of the conversion with an ISO 4217 code (e.g. ‘USD’)
        });
      }
      document.addEventListener('click', function (e) {
        const Elem = e.target.closest('[name=checkout], .btn-checkout');
        if (Elem === null) return;
        handle_begin_checkout(cartItems_additional);
      });

      if (location.pathname.startsWith('/cart') === true) {
        handle_begin_checkout();
      }
      // begin_checkout (product view - direct purchase 1 item)
      document.addEventListener('click', function (e) {
        const Elem = e.target.closest('.shopify-payment-button__button, .shopify-payment-button__more-options');
        if (Elem === null) return;

        let _variant = currentVariant();

        // Twitter begin checkout
        twq('event', 'tw-oe8bu-oe8qn', {
          value: _variant.price / 100, // use this to pass the value of the conversion (e.g. 5.00)
          currency: CURRENCY // use this to pass the currency of the conversion with an ISO 4217 code (e.g. ‘USD’)
        })
      })
    };
    window.addEventListener('DOMContentLoaded', setup_init_code);
    window.addEventListener('load', setup_init_code);
  })();
</script>

