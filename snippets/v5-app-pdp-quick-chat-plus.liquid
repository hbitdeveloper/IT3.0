{%- capture style -%}
  {% render 'spacing-padding', settings: block.settings %}
{%- endcapture -%}

{%- liquid
  assign open_expert_chat = block.settings.open_expert_chat
  assign open_book_dialog = block.settings.open_book_dialog
-%}

{%- if open_expert_chat or open_book_dialog -%}
  <div {{ block.shopify_attributes }} class="w-full section-padding" style="{{ style }}">
    <ul class="w-full flex flex-col bg-[#F5F5F3] p-3.5 lg:px-6 lg:py-5">
      {%- if open_expert_chat -%}
        {%- if block.settings.chat_title_1 != blank or block.settings.chat_button_text_1 != blank -%}
          <li class="w-full flex items-center py-3.5 gap-x-4 border-0 border-b-[1px] border-solid border-[#E6E6E6] lg:py-5 first-of-type:pt-0 last-of-type:pb-0 last-of-type:border-b-0">
            <div class="w-10 h-10 lg:w-[3.75rem] lg:h-[3.75rem] shrink-0">
              {%- if block.settings.chat_icon_1 != blank -%}
                <img class="w-full h-full object-cover" src="{{ block.settings.chat_icon_1 | image_url: width: 120, height: 120 }}" alt="Chat Icon" loading="lazy">
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
              {%- endif -%}
            </div>
            {%- if block.settings.chat_title_1 != blank or block.settings.chat_button_text_1 != blank -%}
              <div class="flex-1 flex flex-col gap-y-1.5 lg:gap-y-2 overflow-hidden">
                {%- if block.settings.chat_title_1 != blank -%}
                  <p class="text-sm font-semibold lg:text-lg text-[#242F20]">{{ block.settings.chat_title_1 | escape }}</p>
                {%- endif -%}
                {%- if block.settings.chat_button_text_1 != blank -%}
                  <fw-agent-status action="startChat">
                    <button
                      class="w-fit flex items-center gap-2 max-w-full appearance-none bg-transparent text-primary font-medium text-sm lg:text-base whitespace-nowrap text-ellipsis overflow-hidden underline-offset-4 lg:hover:underline"
                      slot="available"
                      data-ga-event="5.0_products_details_page_user_clicks" 
                      data-ga-action="click"
                      data-ga-params-product_spu_name="{{ product.title | escape }}"
                      data-ga-params-module="Quick Access"
                      data-ga-params-position="{{ block.settings.chat_title_1 | escape }}"
                      data-ga-params-button_name="{{ block.settings.chat_button_text_1 | escape }}"
                    >
                      <span class="flex-1 line-clamp-1 whitespace-normal text-left">{{ block.settings.chat_button_text_1 | escape }}</span>
                      <svg class="shrink-0 w-[1.125rem] h-4 inline-table" width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16.373 8.25L9.55762 15.0654L8.42578 13.9336L13.3096 9.0498H2V7.4502H13.3115L8.42676 2.56543L9.55762 1.43457L16.373 8.25Z" fill="currentColor"/>
                      </svg>
                    </button>
                  </fw-agent-status>
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endif -%}
      {%- if open_book_dialog -%}
        {%- if block.settings.chat_title_2 != blank or block.settings.chat_button_text_2 != blank -%}
          <li class="w-full flex items-center py-3.5 gap-x-4 border-0 border-b-[1px] border-solid border-[#E6E6E6] lg:py-5 first-of-type:pt-0 last-of-type:pb-0 last-of-type:border-b-0">
            <div class="w-10 h-10 lg:w-[3.75rem] lg:h-[3.75rem] shrink-0">
              {%- if block.settings.chat_icon_2 != blank -%}
                <img class="w-full h-full object-cover" src="{{ block.settings.chat_icon_2 | image_url: width: 120, height: 120 }}" alt="Chat Icon" loading="lazy">
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
              {%- endif -%}
            </div>
            {%- if block.settings.chat_title_2 != blank or block.settings.chat_button_text_2 != blank -%}
              <div class="flex-1 flex flex-col gap-y-1.5 lg:gap-y-2 overflow-hidden">
                {%- if block.settings.chat_title_2 != blank -%}
                  <p class="text-sm font-semibold lg:text-lg text-[#242F20]">{{ block.settings.chat_title_2 | escape }}</p>
                {%- endif -%}
                {%- if block.settings.chat_button_text_2 != blank -%}
                  <button
                    class="w-fit flex items-center gap-2 max-w-full appearance-none bg-transparent text-primary font-medium text-sm lg:text-base whitespace-nowrap text-ellipsis overflow-hidden underline-offset-4 lg:hover:underline"
                    data-ga-event="5.0_products_details_page_user_clicks" 
                    data-ga-action="click"
                    data-ga-params-product_spu_name="{{ product.title | escape }}"
                    data-ga-params-module="Quick Access"
                    data-ga-params-position="{{ block.settings.chat_title_2 | escape }}"
                    data-ga-params-button_name="{{ block.settings.chat_button_text_2 | escape }}"
                    onclick="document.querySelector('.pif-dialog')?.setAttribute('open', true)"
                  >
                    <span class="flex-1 line-clamp-1 whitespace-normal text-left">{{ block.settings.chat_button_text_2 | escape }}</span>
                    <svg class="shrink-0 w-[1.125rem] h-4 inline-table" width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M16.373 8.25L9.55762 15.0654L8.42578 13.9336L13.3096 9.0498H2V7.4502H13.3115L8.42676 2.56543L9.55762 1.43457L16.373 8.25Z" fill="currentColor"/>
                    </svg>
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endif -%}
    </ul>
  </div>
{%- endif -%}
