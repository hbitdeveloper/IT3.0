<script>
    document.querySelectorAll(".christmas-item--button").forEach(btn => {
        btn.addEventListener("click", function () {
            const parent = this.closest(".christmas-item");
            const _step = parent?.getAttribute("data-step");
            const _active_day = "{{active_day}}";
            let _active_step = "{{active_step}}";

            if (_step == 6) {
                ZModle.getInstance(`
                    <div class="title" style="text-align:center;width: 100%;color: {{ schema_settings.step_6_content_color }};">
                    {{schema_settings.step_6_content}}
                    </div>
                `, {
                    id: `modal-christams__${_active_step}`,
                    class: `christams__modal__0${_active_step}`,
                });
                return;
            }

            if (_step !== _active_step) return;
            const templateEl = document.querySelector(`body template[id="step--${_active_step}"]`);
            const temp = templateEl?.innerHTML || "";
            ZModle.getInstance(temp, {
                id: `modal-christams__${_active_step}`,
                class: `christams__modal__0${_active_step}`,
                cb: (el) => {
                    el.querySelector("jky-form").beforeFb = (params) => {
                        return new Promise((resolve, reject) => {
                            fetch(`${pageInfo.api}/osconsumerapi/v1/notice/getUserSubscribe?shopifyShopId=${pageInfo.shopId}&email=${params.email}`, {headers: {
                                cr: window?.pageInfo?.cr,
                                lang: window?.pageInfo?.lang,
                            }})
                            .then((response) => response.json())
                            .then(res => {
                                if(res.code === 200 && res?.data?.tags) {
                                    if(res?.data?.tags.indexOf(`25MC-Unlock-${_active_step}`) !== -1) {
                                        pushErrorMessage("{{schema_settings.repeat_submit_txt}}")
                                        reject()
                                        setTimeout(() => {
                                            el.querySelector(".form_sub_btn").classList.remove("loading")
                                        }, 500)
                                    } else {
                                        resolve(res)
                                    }

                                    window.dataLayer?.push({
                                        event: "ga4Event",
                                        event_name: "Christmas_calendar_user_clicks",
                                        event_parameters: {
                                            "module": 'Unlock',
                                            'button_name': el.querySelector(".form_sub_btn").textContent.trim(),
                                            'position': el.querySelector(".title").textContent.trim(),
                                            'type': `Stage${_active_step}`,
                                        }
                                    });
                                } else {
                                    resolve(res)
                                }
                            })
                            .catch(e => {
                                console.error(e)
                                reject(e)
                            })
                        })
                    }

                    el.querySelector("jky-form").afterFb = (params) => {
                        const modal = document.querySelector(`.christams__modal__0${_active_step}`);
                        modal?.querySelector('.close')?.click();

                        {%- assign success_title = 'step_' | append: active_step | append: '_success_title' -%}
                        {%- assign success_subtitle = 'step_' | append: active_step | append: '_success_subtitle' -%}
                        {%- assign rule_title = 'step_' | append: active_step | append: '_rule_title' -%}
                        {%- assign rule_content = 'step_' | append: active_step | append: '_rule_content' -%}
                        {%- assign rule_btn = 'step_' | append: active_step | append: '_rule_btn' -%}
                        {%- assign buyurl = 'step_' | append: active_step | append: '_buyurl' -%}
                        {%- assign buy_btn = 'step_' | append: active_step | append: '_buy_btn' -%}
                        {%- assign success_title_color = 'step_' | append: active_step | append: '_success_title_color' -%}
                        {%- assign subtitle_color = 'step_' | append: active_step | append: '_success_subtitle_color' -%}
                        {%- assign rule_content_color = 'step_' | append: active_step | append: '_rule_content_color' -%}
                        {%- assign rule_bg_color = 'step_' | append: active_step | append: '_rule_bg_color' -%}
                        {%- assign rule_title_color = 'step_' | append: active_step | append: '_rule_title_color' -%}
                        {%- assign rule_btn_color = 'step_' | append: active_step | append: '_rule_btn_color' -%}

                        setTimeout(() => {
                            ZModle.getInstance(`
                                <div class="flex">
                                    <div class="success_content">
                                        <div class="success_title" style="color:{{schema_settings[success_title_color]}};">{{schema_settings[success_title]}}</div>
                                        <div class="success_subtitle" style="color:{{schema_settings[subtitle_color]}};">{{schema_settings[success_subtitle]}}</div>
                                    </div>

                                    <div class="success_actions">
                                        <div class="jky-tooltip app-wishlist-tooltip">
                                            <div class="jky-tooltip__inner jky-tooltip__inner--top">
                                            <span class="rule_title" style="color:{{schema_settings[rule_title_color]}};">{{schema_settings[rule_title]}}</span>
                                            <div class="rule_content" style="color: {{schema_settings[rule_content_color]}};background:{{schema_settings[rule_bg_color]}}">{{schema_settings[rule_content]}}</div></div>

                                            <span class="rule-btn" style="color:{{schema_settings[rule_btn_color]}};">{{schema_settings[rule_btn]}}</span>
                                        </div>

                                        <a href="{{schema_settings[buyurl]}}" class="shop-btn">{{schema_settings[buy_btn]}}</a>
                                    </div>
                                </div>
                            `, {
                                id: `modal-christams__cb_${_active_step}`,
                                class: `christams__modal__cb_0${_active_step}`,
                                cb: (el) => {
                                    // 埋点事件
                                    el.querySelector(".rule-btn").addEventListener("mouseover", function() {
                                        window.dataLayer?.push({
                                            event: "ga4Event",
                                            event_name: "Christmas_calendar_user_clicks",
                                            event_parameters: {
                                                "module": 'Unlock',
                                                'button_name': el.querySelector(".rule-btn").textContent.trim(),
                                                'position': el.querySelector(".success_title").textContent.trim(),
                                                'type': `Stage${_active_step}`,
                                            }
                                        });
                                    })


                                    el.querySelector(".shop-btn").addEventListener("click", function() {
                                        window.dataLayer?.push({
                                            event: "ga4Event",
                                            event_name: "Christmas_calendar_user_clicks",
                                            event_parameters: {
                                                "module": 'Unlock',
                                                'button_name': el.querySelector(".shop-btn").textContent.trim(),
                                                'position': el.querySelector(".success_title").textContent.trim(),
                                                'type': `Stage${_active_step}`,
                                            }
                                        });
                                    });
                                }
                            })
                        }, 2000)
                    }

                    el.querySelectorAll(".trigger-btn").forEach(btn => {
                        const newBtn = btn.cloneNode(true);
                        btn.replaceWith(newBtn);

                        newBtn.addEventListener("click", function () {
                            el.querySelector(".form_sub_btn")?.click();
                        });
                    });
                }
            })
        })
    })
</script>