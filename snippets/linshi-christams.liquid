{% comment %} 临时活动新增-圣诞活动 {% endcomment %}
{%- render 'jky-tooltip' -%}

<style>
    .christmas-main {background-color: {{schema_settings.pc_chris_bg_color}};}
    .christmas-main .christmas-container {padding-top: {{schema_settings.pc_padding_top}}px;padding-bottom: {{schema_settings.pc_padding_bottom}}px;width: 1440px;max-width: 100%;margin: 0 auto;}
    .christmas-main .christmas-container .christmas--title {color: {{schema_settings.title_color}};margin-bottom: {{schema_settings.pc_padding_content}}px;}
    .christmas-main .christmas-container .christmas--subtitle {margin-bottom: {{schema_settings.pc_padding_subcontent}}px;}
    .christmas-main .christmas-container .christmas-grid {margin: 0 auto;width: {{schema_settings.pc_grid_w}}px;display: grid;grid-template-columns: repeat(6, 1fr);grid-template-rows: repeat(4, 1fr);grid-column-gap: {{schema_settings.pc_grid_gap}}px;grid-row-gap: {{schema_settings.pc_grid_gap}}px;}
    .christmas-main .christmas-container .christmas-grid .christmas-item--lg {grid-area: 4 / 5 / 5 / 7;}
    .christmas-main .christmas-container .christmas-grid .christmas-item {height: 150px;border-radius: 12px;overflow: hidden;background: #fff;display: flex;align-items: flex-end;justify-content: center;position: relative;}
    .christmas-main .christmas-container .christmas-grid .christmas-item.lock::after {content: '';position: absolute;top: 0;bottom: 0;left: 0;right: 0;background: #ffffff;opacity: 0.8;}
    .christmas-main .christmas-container .christmas-grid .christmas-item--button {user-select: none;text-align: center;margin: 0 6px 6px 6px;width: 100%;height: 36px;border-radius: 8px;line-height: 36px;background: {{schema_settings.button_bg_color}};transition: all 0.24s ease;color: {{schema_settings.button_color}};cursor: pointer;font-weight: 600;font-size: 16px;}
    .christmas-main .christmas-container .christmas-grid .christmas-item--button:hover {background: {{schema_settings.button_bg_hover_color}};}
    .christmas-main .christmas-container .christmas-grid .christmas-item--button:active {background: {{schema_settings.button_bg_active_color}};}
    .christmas-main .christmas-container .christmas-grid .christmas-item {background-size: cover;background-repeat: no-repeat;}

    @media screen and (max-width: 1024px) {
        .christmas-main {background-color: {{schema_settings.mb_chris_bg_color}};}
        .christmas-main .christmas-container {padding-top: {{schema_settings.mb_padding_top}}px;padding-bottom: {{schema_settings.mb_padding_bottom}}px;width: 100%;}
        .christmas-main .christmas-container .christmas--title {font-size: 32px;line-height: 40px;margin-bottom: {{schema_settings.mb_padding_content}}px;}
        .christmas-main .christmas-container .christmas--subtitle {margin-bottom: {{schema_settings.mb_padding_subcontent}}px;}
        .christmas-main .christmas-container .christmas-grid {width: 91.4666vw;grid-template-columns: repeat(4, 1fr);grid-template-rows: repeat(6, 1fr);grid-column-gap: {{schema_settings.mb_grid_gap}}px;grid-row-gap: {{schema_settings.mb_grid_gap}}px;}
        .christmas-main .christmas-container .christmas-grid .christmas-item--lg {grid-area: 6 / 3 / 7 / 5;}
        .christmas-main .christmas-container .christmas-grid .christmas-item {height: 20vw;border-radius: 6px;}
        .christmas-main .christmas-container .christmas-grid .christmas-item--button {margin: 0 4px 4px 4px;height: 24px;border-radius: 4px;line-height: 24px;font-weight: 500;font-size: 12px;}
    }


    .christmas-modal .jky-checkbox .jky-checkbox-input {padding-top: 0;}
    .christmas-modal .jky-checkbox .jky-checkbox-label {line-height: 16px;}
</style>

{%- assign active_step = '' -%}
{%- assign active_day = 1 -%}
<div class="christmas-main" {%if schema_settings.anchor_id != blank%}anchor={{schema_settings.anchor_id | escape}}{%endif%}>
    <div class="christmas-container">
        <div class="christmas--title section-container font-semibold text-center lg:text-5xl">{{ schema_settings.title | newline_to_br}}</div>
        {%- if schema_settings.subtitle != blank -%}
            <div style="color: {{schema_settings.subtitle_color | default: '#FFFFFF'}};" class="christmas--subtitle section-container lg:text-lg text-sm font-semibold text-center">{{ schema_settings.subtitle | newline_to_br}}</div>
        {%- endif -%}

        {%- assign time_now = 'now' | date: '%s' | times: 1.00 -%}
        {%- assign time_start = schema_settings.begin_time | date: '%s' -%}
        <div class="christmas-grid" time_now="{{ time_now }}" time_start="{{ time_start }}">
            {%- assign oneday_s = 86400 -%}
            {%- assign all_s = 1987200 -%}
            {%- assign time_end = time_start | plus: all_s | plus: oneday_s -%}
            {%- assign active_step = '' -%}

            {% comment %} 阶段一活动时间 {% endcomment %}
            {%- assign step_1_start_num = schema_settings.step_1_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- assign step_1_end_num = schema_settings.step_2_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- if time_now > step_1_start_num and time_now <= step_1_end_num -%}
                {%- assign active_step = 1 -%}

                {%- assign d_1 = schema_settings.step_2_start | minus: 1  -%}
                {%- for i in (0..d_1) -%}
                    {%- assign i_temp = forloop.index | times:oneday_s | plus: time_start -%}
                    {%- if time_now < i_temp -%}
                        {%- assign active_day = forloop.index -%}
                        {% break %}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}

            {% comment %} 阶段二活动时间 {% endcomment %}
            {%- assign step_2_start_num = schema_settings.step_2_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- assign step_2_end_num = schema_settings.step_3_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- if time_now > step_2_start_num and time_now <= step_2_end_num -%}
                {%- assign active_step = 2 -%}

                {%- assign _d_2 = schema_settings.step_3_start | minus: schema_settings.step_2_start | minus: 1  -%}
                {%- for i in (0.._d_2) -%}
                    {%- assign i_temp = forloop.index | plus: schema_settings.step_2_start | minus: 1 | times:oneday_s | plus: time_start -%}
                    {%- if time_now < i_temp -%}
                        {%- assign active_day = forloop.index | plus: schema_settings.step_2_start | minus: 1 -%}
                        {% break %}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}

            {% comment %} 阶段三活动时间 {% endcomment %}
            {%- assign step_3_start_num = schema_settings.step_3_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- assign step_3_end_num = schema_settings.step_4_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- if time_now > step_3_start_num and time_now <= step_3_end_num -%}
                {%- assign active_step = 3 -%}

                {%- assign dd_3 = schema_settings.step_4_start | minus: schema_settings.step_3_start | minus: 1  -%}
                {%- for i in (0..dd_3) -%}
                    {%- assign i_temp = forloop.index | plus: schema_settings.step_3_start | minus: 1 | times:oneday_s | plus: time_start -%}
                    {%- if time_now < i_temp -%}
                        {%- assign active_day = forloop.index | plus: schema_settings.step_3_start | minus: 1 -%}
                        {% break %}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}

            {% comment %} 阶段四活动时间 {% endcomment %}
            {%- assign step_4_start_num = schema_settings.step_4_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- assign step_4_end_num = schema_settings.step_5_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- if time_now > step_4_start_num and time_now <= step_4_end_num -%}
                {%- assign active_step = 4 -%}

                {%- assign _d_4 = schema_settings.step_5_start | minus: schema_settings.step_4_start | minus: 1  -%}
                {%- for i in (0.._d_4) -%}
                    {%- assign i_temp = forloop.index | plus: schema_settings.step_4_start | minus: 1 | times:oneday_s | plus: time_start -%}
                    {%- if time_now < i_temp -%}
                        {%- assign active_day = forloop.index | plus: schema_settings.step_4_start | minus: 1 -%}
                        {% break %}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}

            {% comment %} 阶段五活动时间 {% endcomment %}
            {%- assign step_5_start_num = schema_settings.step_5_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- assign step_5_end_num = schema_settings.step_6_start | minus: 1 | times: oneday_s | plus: time_start  -%}
            {%- if time_now > step_5_start_num and time_now <= step_5_end_num -%}
                {%- assign active_step = 5 -%}

                {%- assign _d_5 = schema_settings.step_6_start | minus: schema_settings.step_5_start | minus: 1  -%}
                {%- for i in (0.._d_5) -%}
                    {%- assign i_temp = forloop.index | plus: schema_settings.step_5_start | minus: 1 | times:oneday_s | plus: time_start -%}
                    {%- if time_now < i_temp -%}
                        {%- assign active_day = forloop.index | plus: schema_settings.step_5_start | minus: 1 -%}
                        {% break %}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}

            {% comment %} 阶段六活动时间 {% endcomment %}
            {%- assign step_6_start_num = schema_settings.step_6_start | minus: 1 | times: oneday_s | plus: time_start | times: 1.00 -%}
            {%- assign step_6_end_num = time_end | times: 1.00 -%}
            {%- if time_now > step_6_start_num and time_now <= step_6_end_num -%}
                {%- assign active_step = 6 -%}
                {%- assign active_day = 23 -%}

                {%- assign _d_6 = 24 | minus: schema_settings.step_6_start | minus: 1  -%}
                {%- for i in (0.._d_6) -%}
                    {%- assign i_temp = forloop.index | plus: schema_settings.step_6_start | minus: 1 | times:oneday_s | plus: time_start -%}
                    {%- if time_now < i_temp -%}
                        {%- assign active_day = forloop.index | plus: schema_settings.step_6_start | minus: 1 -%}
                        {% break %}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}

            {%- for i in (0..22) -%}
                {%- assign index = forloop.index -%}
                {%- assign step_num = 1 -%}

                {%- if index >= schema_settings.step_2_start  -%}
                    {%- assign step_num = 2 -%}
                {%- endif -%}

                {%- if index >= schema_settings.step_3_start  -%}
                    {%- assign step_num = 3 -%}
                {%- endif -%}

                {%- if index >= schema_settings.step_4_start  -%}
                    {%- assign step_num = 4 -%}
                {%- endif -%}

                {%- if index >= schema_settings.step_5_start  -%}
                    {%- assign step_num = 5 -%}
                {%- endif -%}

                {%- if index >= schema_settings.step_6_start  -%}
                    {%- assign step_num = 6 -%}
                {%- endif -%}

                {% comment %} step_num != active_step or  {% endcomment %}
                {%- assign block_bg_index = 'block_bg_' | append: forloop.index -%}
                <div style="background-image: url({{schema_settings[block_bg_index] | image_url: width: 360}});" active_step="{{active_step}}" active_day="{{active_day}}" data-step="{{step_num}}" class="christmas-item {% if forloop.index == 23 %} christmas-item--lg{% endif %} {% if step_num != active_step or active_day != forloop.index %} lock{% endif %}">
                    <div
                        class="christmas-item--button text-overflow-1"
                        data-ga-event="Christmas_calendar_user_clicks"
                        data-ga-action="click"
                        data-ga-params-modul="ChristmasCalendar"
                        data-ga-params-position="{{index}}"
                        data-ga-params-button_name="{{schema_settings.button_label | escape}}"
                        data-ga-params-type="Stage {{step_num}}"
                    >{{schema_settings.button_label | escape}}</div>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% comment %} 阶段一 {% endcomment %}
<template id="step--1">
    <div class="flex flex-col christmas-modal">
        <div class="title" style="color: {{schema_settings.step_1_title_color}};">{{schema_settings.step_1_title | escape}}</div>
        <jky-form data-scroll="false" onsubmitcall="" jky-form-id="product-shaortage-form" class="">
            <form data-action="/osconsumerapi/v1/notice/subscribe">
                <div class="newbee-form newbee-form_shortage">
                    <div class="form-row flex full christmas--full">
                        <div class="form-item required christmas--field" data-field="input">
                            <input type="email" id="email" name="email" placeholder="{{schema_settings.email_label | escape}}" data-error="{{schema_settings.email_error_empty | escape}}" data-value="email" data-reg="email" data-regerror="{{schema_settings.email_error_reg}}">

                            <button class="form_sub_btn z-button-middle">{{schema_settings.submit_text | escape}}</button>
                        </div>
                    </div>

                    <div style="margin-top: 6px;" class="form-row form-row_check_box flex full">
                            <div class="form-item required" data-field="check_box" data-error="{{schema_settings.subs_policy_error}}">
                                <jky-checkbox class="jky-checkbox_shortage jky-checkbox">
                                    <label class="jky-checkbox">
                                        <span class="jky-checkbox-input">
                                            <input type="checkbox" class="jky-checkbox-original" data-value="agree_recevie_shortage">
                                            <span class="jky-checkbox-inner"></span>
                                        </span>

                                        <span class="jky-checkbox-label">
                                            <span class="jky-agree">{{schema_settings.subs_policy}}</span>
                                        </span>
                                    </label>
                                </jky-checkbox>
                            </div>
                    </div>

                    <div style="display: none;" class="form-row flex  full">
                        <div class="form-item form-item_const" data-field="input">
                            <input type="text" id="shopify_shop_id" name="shopify_shop_id" data-error="" data-value="shopify_shop_id" data-reg="" value="{{shop.id}}" data-regerror="">
                        </div>
                    </div>

                    <div style="display: none;" class="form-row flex  full">
                        <div class="form-item form-item_const" data-field="input">
                            <input type="text" id="chris_01_propertyName" name="propertyName" data-error="" data-value="propertyName" data-reg="" value="MC-ACT" data-regerror="">
                        </div>
                    </div>

                    <div style="display: none;" class="form-row flex  full">
                        <div class="form-item form-item_const" data-field="input">
                            <input type="text" id="chris_01_propertyValue" name="propertyValue" data-error="" data-value="propertyValue" data-reg="" value="MC-Unlock-1" data-regerror="">
                        </div>
                    </div>

                    <div style="display: none;" class="form-row flex  full">
                        <div class="form-item form-item_const" data-field="input">
                            <input type="text" id="chris_01_newUserTags" name="newUserTags" data-error="" data-value="newUserTags" data-reg="" value="25MC-Subscribe" data-regerror="">
                        </div>
                    </div>

                    <div style="display: none;" class="form-row flex  full">
                        <div class="form-item form-item_const" data-field="input">
                            <input type="text" id="chris_01_tag" name="tags" data-error="" data-value="tags" data-reg="" value="25MC-Unlock-1" data-regerror="">
                        </div>
                    </div>

                    <div class="flex" style="justify-content: flex-start;">
                        <div class="z-button-middle trigger-btn">{{schema_settings.submit_text | escape}}</div>
                    </div>
                </div>
            </form>
        </jky-form>
    </div>
</template>

