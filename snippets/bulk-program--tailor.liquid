{% comment %}
    Tailor
    params: settings
            bulk_program
{% endcomment %}

<script defer src="{{ 'collapsible-select.min.js' | asset_url }}"></script>

<div
    {{ attributes }}
    class="bulk-program--tailor"
    data-product="{{ settings.product | escape }}"
    data-quantity="{{ settings.quantity | escape }}"
    data-num={{ settings.num }}
    data-tip="{{ settings.tip | escape}}"
    data-quantity_tip="{{ settings.quantity_tip | escape}}"
>
    <div class="bulk-program--container">
        <div class="tailor-title">{{ settings.title | escape }}</div>
        <div class="tailor-description rte">{{ settings.description | replace: '<em>', '<em style="color: var(--jds-color-primary)">' }}</div>
        <div class="tailor-list">
            <div class="tailor-form">
                {%- for num in (1..settings.num) -%}
                    <div class="tailor-item">
                        <div class="tailor-form-item">
                            <div class="form-label">{{ settings.product | escape }}</div>
                            <div class="form-select">
                                <collapsible-select class="tailor-select" placeholder="{{ settings.tip | escape }}"></collapsible-select>
                            </div>
                        </div>
                        <div class="tailor-form-item form-quantity">
                            <div class="form-label">{{ settings.quantity | escape }}</div>
                            <quantity-input class="quantity tailor-quantity">
                                <button class="quantity__button no-js-hidden" name="minus" type="button">
                                    {% render 'icon-minus' %}
                                </button>
                                <input class="quantity__input w-full" type="number"  value="1" min="0" >
                                <button class="quantity__button no-js-hidden" name="plus" type="button">
                                    {% render 'icon-plus' %}
                                </button>
                            </quantity-input>
                        </div>
                    </div>
                {%- endfor -%}

            </div>
            <div class="buttons">
                <button class="add-product">{{ settings.add_product | escape }}</button>
                <button class="view-quote" data-module="{{ settings.title | escape }}">{{ settings.view_quote | escape }}</button>
            </div>
        </div>
    </div>
</div>
